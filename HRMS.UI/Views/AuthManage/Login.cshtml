@{
    Layout = null;
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRMS &mdash; Sign In</title>

    <!-- Dependencies (unchanged) -->
    <link rel="stylesheet" href="~/assets/plugins/notifications/css/lobibox.min.css" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/bootstrap-extended.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/css/app.css" rel="stylesheet">
    <link href="~/assets/css/icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/dark-theme.css" />
    <link rel="stylesheet" href="~/assets/css/semi-dark.css" />
    <link rel="stylesheet" href="~/assets/css/header-colors.css" />
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.common.css">
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.light.css">
    <link href="~/assets/css/company-modal.css" rel="stylesheet" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        /* ════════════════════════════════════════════════════════════════
           HRMS Login  —  Centered Glass Card / Steel-Blue Theme
           ════════════════════════════════════════════════════════════════ */

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { height: 100%; }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0a1929 0%, #0d2137 45%, #1e3a5f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            opacity: 0;
            transition: opacity .4s ease;
        }

        body.loaded { opacity: 1; }

        /* ── Background blobs ─────────────────────────────────────── */
        .bg-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 0;
            animation: blob-float 14s ease-in-out infinite;
        }

        .blob-1 {
            width: 460px; height: 460px;
            background: #2d7ab5;
            opacity: .45;
            top: -140px; left: -120px;
        }

        .blob-2 {
            width: 400px; height: 400px;
            background: #3e6a8c;
            opacity: .35;
            bottom: -150px; right: -100px;
            animation-delay: -5s;
        }

        .blob-3 {
            width: 320px; height: 320px;
            background: #4a90c4;
            opacity: .25;
            top: 35%; right: 8%;
            animation-delay: -9s;
        }

        @@keyframes blob-float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50%      { transform: translate(30px, -20px) scale(1.08); }
        }

        /* ── Mesh grid overlay ─────────────────────────────────────── */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
            background-size: 55px 55px;
            z-index: 0;
            pointer-events: none;
        }

        /* ── Particles ─────────────────────────────────────────────── */
        .particles { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }

        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.55);
            animation: particle-drift linear infinite;
            will-change: transform, opacity;
        }

        @@keyframes particle-drift {
            0%   { transform: translateY(0) translateX(0); opacity: .12; }
            25%  { opacity: .55; }
            75%  { opacity: .3; }
            100% { transform: translateY(-120px) translateX(var(--px, 20px)); opacity: 0; }
        }

        /* ── Login wrap ───────────────────────────────────────────── */
        .login-wrap {
            width: 420px;
            max-width: 92vw;
            padding: 0 16px;
            position: relative;
            z-index: 1;
            animation: card-enter .6s cubic-bezier(.16,1,.3,1) both;
        }

        @@keyframes card-enter {
            0%   { opacity: 0; transform: translateY(24px) scale(.97); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ── Login card ───────────────────────────────────────────── */
        .login-card {
            background: rgba(255,255,255,.1);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 20px;
            padding: 36px 32px;
            box-shadow: 0 20px 60px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.15);
            opacity: 0;
            transform: translateY(16px);
            transition: opacity .5s cubic-bezier(.22,.61,.36,1), transform .5s cubic-bezier(.22,.61,.36,1);
        }

        .login-card.visible { opacity: 1; transform: translateY(0); }

        .lc-header { margin-bottom: 8px; }

        .lc-title {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }

        .lc-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,.6);
            margin-bottom: 20px;
        }

        /* ── Form fields ──────────────────────────────────────────── */
        .form-group {
            margin-bottom: 18px;
            animation: field-enter .5s ease both;
        }

        .form-group:nth-of-type(1) { animation-delay: .08s; }
        .form-group:nth-of-type(2) { animation-delay: .16s; }

        @@keyframes field-enter {
            0%   { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,.85);
            margin-bottom: 6px;
        }

        .input-wrap { position: relative; }

        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,.5);
            font-size: 14px;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px 10px 36px;
            border: 1.5px solid rgba(255,255,255,.25);
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            color: #fff;
            background: rgba(255,255,255,.08);
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s, transform .2s;
            -webkit-appearance: none;
        }

        .form-control::placeholder {
            color: #ffffff !important;
            opacity: 1 !important;
        }

        .form-control::-webkit-input-placeholder {
            color: #ffffff !important;
            opacity: 1 !important;
        }

        .form-control::-moz-placeholder {
            color: #ffffff !important;
            opacity: 1 !important;
        }

        .form-control:-ms-input-placeholder {
            color: #ffffff !important;
            opacity: 1 !important;
        }

        .form-control:focus {
            border-color: #4a90c4;
            box-shadow: 0 0 0 3px rgba(74,144,196,.18);
            background: rgba(255,255,255,.14);
            transform: translateY(-1px);
        }

        .input-wrap:focus-within .input-icon { color: #4a90c4; }

        /* Password input has right padding for eye button */
        .input-wrap--pw .form-control { padding-right: 42px; }

        .pwd-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: rgba(255,255,255,.5);
            font-size: 14px;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pwd-toggle:hover { color: rgba(255,255,255,.85); }

        /* ── Options row ──────────────────────────────────────────── */
        .lc-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .lc-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 13px;
            color: rgba(255,255,255,.8);
            font-weight: 400;
            user-select: none;
        }

        .lc-remember input[type="checkbox"] { display: none; }

        .lc-chk {
            width: 16px; height: 16px;
            border: 1.5px solid rgba(255,255,255,.35);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all .18s ease;
            background: rgba(255,255,255,.08);
        }

        .lc-remember input:checked ~ .lc-chk {
            background: linear-gradient(135deg, #3e6a8c, #2d7ab5);
            border-color: #4a90c4;
        }

        .lc-remember input:checked ~ .lc-chk::after {
            content: '';
            width: 8px; height: 5px;
            border-left: 2px solid #fff;
            border-bottom: 2px solid #fff;
            transform: rotate(-45deg) translate(1px, -1px);
            display: block;
        }

        .lc-forgot {
            font-size: 13px;
            color: #8fc8e8;
            text-decoration: none;
            font-weight: 500;
            transition: color .18s ease;
        }

        .lc-forgot:hover { color: #fff; text-decoration: underline; }

        /* ── Login button ─────────────────────────────────────────── */
        .lc-btn {
            width: 100%;
            padding: 12px 20px;
            background: linear-gradient(135deg, #3e6a8c 0%, #2d7ab5 100%);
            color: #fff;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 10px;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            box-shadow: 0 8px 24px rgba(45,122,181,.38);
            transition: all .2s ease;
            position: relative;
            overflow: hidden;
            letter-spacing: .2px;
        }

        .lc-btn::after {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
            transform: skewX(-20deg);
            transition: left .5s ease;
        }

        .lc-btn:hover:not(:disabled) {
            opacity: .95;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(45,122,181,.48);
        }

        .lc-btn:hover::after { left: 140%; }

        .lc-btn:active:not(:disabled) { transform: scale(.99) translateY(0); }

        .lc-btn:disabled { opacity: .75; cursor: not-allowed; }

        /* Ripple wave */
        .ripple-wave {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.25);
            transform: scale(0);
            animation: ripple-expand .65s linear;
            pointer-events: none;
        }

        @@keyframes ripple-expand {
            to { transform: scale(4); opacity: 0; }
        }

        /* ── Loading button ───────────────────────────────────────── */
        .lc-btn-ld {
            width: 100%;
            padding: 12px 20px;
            background: linear-gradient(135deg, #3e6a8c 0%, #2d7ab5 100%);
            color: rgba(255,255,255,.85);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 10px;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: not-allowed;
            opacity: .82;
        }

        .btn-spinner {
            width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: btn-spin .7s linear infinite;
            flex-shrink: 0;
        }

        @@keyframes btn-spin { to { transform: rotate(360deg); } }

        /* ── Footer ───────────────────────────────────────────────── */
        .login-footer {
            text-align: center;
            margin-top: 24px;
            color: rgba(255,255,255,.4);
            font-size: 12px;
            animation: field-enter .6s ease .3s both;
        }

        /* ════════════════════════════════════════════════════════════════
           RESPONSIVE
           ════════════════════════════════════════════════════════════════ */
        @@media (max-width: 480px) {
            .login-card { padding: 28px 22px; }
            .lc-title { font-size: 19px; }
        }

        @@media (max-height: 600px) and (orientation: landscape) {
            .login-wrap { width: 380px; }
            .login-card { padding: 22px 24px; }
            .form-group { margin-bottom: 12px; }
            .lc-options { margin-bottom: 16px; }
        }
    </style>
</head>
<body>

    <!-- Background layers -->
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>
    <div class="bg-blob blob-3"></div>
    <div class="particles" id="particlesWrap"></div>

    <div class="login-wrap">

        <!-- Login card -->
        <div class="login-card" id="loginCard">

            <div class="lc-header">
                <h1 class="lc-title">Welcome Back</h1>
                <p class="lc-subtitle">Sign in to your HRMS account</p>
            </div>

            <!-- Form -->
            <form id="loginForm" autocomplete="on" onsubmit="return false;">

                <!-- Email -->
                <div class="form-group">
                    <label class="form-label" for="inputEmailAddress">Email Address</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="inputEmailAddress" class="form-control"
                               placeholder="Enter your email" autocomplete="email" required>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label class="form-label" for="inputChoosePassword">Password</label>
                    <div class="input-wrap input-wrap--pw">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" id="inputChoosePassword" class="form-control"
                               placeholder="Enter your password" autocomplete="current-password" required>
                        <button type="button" class="pwd-toggle" onclick="togglePassword()" aria-label="Toggle password visibility">
                            <i class="fas fa-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Options -->
                <div class="lc-options">
                    <label class="lc-remember">
                        <input type="checkbox" id="rememberMe">
                        <span class="lc-chk"></span>
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="lc-forgot">Forgot password?</a>
                </div>

                <!-- Login button -->
                <button type="button" class="lc-btn" id="btnLogin">
                    <span>Sign In</span>
                    <i class="fas fa-arrow-right"></i>
                </button>

                <!-- Loading button (shown during auth) -->
                <button type="button" class="lc-btn-ld" id="btnLogining" disabled style="display:none;">
                    <div class="btn-spinner"></div>
                    <span>Authenticating&hellip;</span>
                </button>

            </form>

        </div><!-- /login-card -->

        <div class="login-footer">
            &copy; 2026 HRMS &mdash; Skyline Web Solutions &bull; v3.0
        </div>

    </div><!-- /login-wrap -->

    <!-- Modals (unchanged) -->
    <div id="companyModalContainer"></div>
    <div id="sessionLogoutContainer"></div>

    <!-- Razor vars (unchanged) -->
    <script>
        var uiBaseUrlLayout = '@UIBaseUrl';
        var BaseUrlLayout   = '@baseUrl';
    </script>

    <!-- JS Dependencies (unchanged) -->
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/notifications/js/lobibox.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notifications.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notification-custom-script.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/21.1.5/js/dx.all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>
    <script src="~/assets/js/companymodalloader.js"></script>

    <script>
        /* ── Page entrance ────────────────────────────────────────── */
        document.body.classList.add('loaded');
        setTimeout(function () {
            document.getElementById('loginCard').classList.add('visible');
        }, 120);

        /* ── Floating particles ───────────────────────────────────── */
        (function () {
            var wrap = document.getElementById('particlesWrap');
            for (var i = 0; i < 36; i++) {
                var p = document.createElement('div');
                p.className = 'particle';
                var size = 2 + Math.random() * 4;
                p.style.cssText =
                    'left:' + (Math.random() * 100) + '%;' +
                    'top:'  + (Math.random() * 100) + '%;' +
                    'width:' + size + 'px;height:' + size + 'px;' +
                    '--px:' + ((Math.random() - 0.5) * 60) + 'px;' +
                    'animation-duration:' + (7 + Math.random() * 10) + 's;' +
                    'animation-delay:'    + (Math.random() * 8)       + 's;';
                wrap.appendChild(p);
            }
        })();

        /* ── Button ripple effect ─────────────────────────────────── */
        document.getElementById('btnLogin').addEventListener('mousedown', function (e) {
            var btn  = this;
            var r    = btn.getBoundingClientRect();
            var size = Math.max(r.width, r.height);
            var rip  = document.createElement('span');
            rip.className = 'ripple-wave';
            rip.style.cssText =
                'width:' + size + 'px;height:' + size + 'px;' +
                'left:'  + (e.clientX - r.left - size / 2) + 'px;' +
                'top:'   + (e.clientY - r.top  - size / 2) + 'px;';
            btn.appendChild(rip);
            setTimeout(function () { rip.remove(); }, 700);
        });

        /* ══ Auth functions (unchanged logic) ════════════════════════ */
        function togglePassword() {
            var inp  = document.getElementById('inputChoosePassword');
            var icon = document.getElementById('toggleIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                inp.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function showBtnLoder() {
            $('#btnLogin').hide();
            $('#btnLogining').show();
        }

        function hideBtnLoder() {
            $('#btnLogin').show();
            $('#btnLogining').hide();
        }

        $(document).ready(function () {
            localStorage.removeItem("PreviousPageUrl");
            localStorage.setItem("PreviousPageUrl", window.location.href);

            /* Enter key on inputs */
            $('#inputEmailAddress, #inputChoosePassword').keypress(function (e) {
                if (e.which === 13) { $('#btnLogin').click(); }
            });

            /* Login click */
            $('#btnLogin').click(function () {
                showBtnLoder();
                var email    = $('#inputEmailAddress').val().trim();
                var password = $('#inputChoosePassword').val();

                if (!email) {
                    round_error_noti("Please enter email!");
                    hideBtnLoder(); return false;
                }
                if (!password) {
                    round_error_noti("Please enter password!");
                    hideBtnLoder(); return false;
                }

                $.ajax({
                    url:         '@baseUrl/AuthenticationAPI/Login',
                    type:        'POST',
                    contentType: 'application/json',
                    data:        JSON.stringify({ Email: email, Password: password }),
                    success: function (response) {
                        if (response.isSuccess) {
                            var token       = response.data.token;
                            var decoded     = jwt_decode(token);
                            var CompanyList = JSON.parse(decoded.Company);
                            var firstCompany = CompanyList[0];

                            localStorage.setItem("authToken",       token);
                            localStorage.setItem("EmployeeId",      decoded.Id);
                            localStorage.setItem("EmployeeName",    decoded.FullName);
                            localStorage.setItem("EmployeeCode",    decoded.EmployeeCode);
                            localStorage.setItem("RoleSlug",        decoded.RoleSlug);
                            localStorage.removeItem('NotificationSummary');
                            localStorage.setItem('NotificationSummary', 'true');
                            localStorage.setItem('EscalationSummary',   'true');

                            if (decoded.RoleSlug === "super-admin") {
                                openCompanyModal('@UIBaseUrl', '@baseUrl', CompanyList, function (selectedCompany) {
                                    if (selectedCompany) {
                                        localStorage.setItem('selectedCompany', JSON.stringify(selectedCompany));
                                        window.location.href = '@UIBaseUrl/AdminPanel/Home/index';
                                    } else {
                                        window.location.href = '@UIBaseUrl/AuthManage/Login';
                                    }
                                });
                            } else if (decoded.RoleSlug == "admin") {
                                if (decoded.IsPasswordChange == "False" || !decoded.IsPasswordChange) {
                                    window.location.href = '@UIBaseUrl/AuthManage/ChangePassword';
                                } else {
                                    localStorage.removeItem('selectedCompany');
                                    localStorage.setItem('selectedCompany', JSON.stringify(firstCompany));
                                    window.location.href = '@UIBaseUrl/AdminPanel/Home/index';
                                }
                            } else if (decoded.RoleSlug === "ess") {
                                if (decoded.IsPasswordChange == "False" || !decoded.IsPasswordChange) {
                                    window.location.href = '@UIBaseUrl/AuthManage/ChangePassword';
                                } else {
                                    localStorage.removeItem('selectedCompany');
                                    localStorage.setItem('selectedCompany', JSON.stringify(firstCompany));
                                    window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
                                }
                            } else {
                                window.location.href = '@UIBaseUrl/AuthManage/Login';
                            }
                        } else {
                            round_error_noti(response.responseMessage);
                            hideBtnLoder();
                        }
                        hideBtnLoder();
                    },
                    error: function () {
                        round_error_noti("Invalid Login Credentials.");
                        hideBtnLoder();
                    }
                });
            });
        });

        /* Session-out modal (unchanged) */
        $(document).ready(async function () {
            if (sessionStorage.getItem("SessionOut") == "true") {
                $.ajax({
                    url:  uiBaseUrlLayout + '/AdminPanel/PartialView/LoadSessionLogoutModal',
                    type: 'GET',
                    success: function (html) {
                        $('#sessionLogoutContainer').html(html);
                        sessionStorage.removeItem("SessionOut");
                    },
                    error: function () {}
                });
            }
        });
    </script>
</body>
</html>
