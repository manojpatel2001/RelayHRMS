@{
    Layout = null;
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRMS &mdash; Sign In</title>

    <!-- Dependencies (unchanged) -->
    <link rel="stylesheet" href="~/assets/plugins/notifications/css/lobibox.min.css" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/bootstrap-extended.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/assets/css/app.css" rel="stylesheet">
    <link href="~/assets/css/icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/dark-theme.css" />
    <link rel="stylesheet" href="~/assets/css/semi-dark.css" />
    <link rel="stylesheet" href="~/assets/css/header-colors.css" />
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.common.css">
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.light.css">
    <link href="~/assets/css/company-modal.css" rel="stylesheet" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <style>
        /* ════════════════════════════════════════════════════════════════
           HRMS Premium Login  —  WMS Steel-Blue Enterprise Theme
           ════════════════════════════════════════════════════════════════ */

        /* ── Reset & base ─────────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --c-navy:       #0a1929;
            --c-dark:       #0d2137;
            --c-blue-deep:  #1e3a5f;
            --c-blue:       #3e6a8c;
            --c-blue-mid:   #2d7ab5;
            --c-blue-lt:    #628db6;
            --c-blue-glow:  #4a90c4;
            --c-text-white: #ffffff;
            --c-text-muted: rgba(255,255,255,.65);
            --c-text-faint: rgba(255,255,255,.38);
            --card-radius:  22px;
            --transition:   all .22s ease;
        }

        html, body {
            height: 100%;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        body {
            display: flex;
            min-height: 100vh;
            background: var(--c-navy);
            opacity: 0;
            transition: opacity .4s ease;
        }

        body.loaded { opacity: 1; }

        /* ════════════════════════════════════════════════════════════════
           LEFT PANEL
           ════════════════════════════════════════════════════════════════ */
        .lp {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100vh;
            overflow-x: hidden;
            background: linear-gradient(155deg,
                #060f1c 0%,
                #0d2137 20%,
                #1a3452 45%,
                #1e3a5f 65%,
                #16304f 85%,
                #0d2137 100%);
        }

        /* Mesh grid overlay */
        .lp::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px);
            background-size: 55px 55px;
            z-index: 0;
        }

        /* Radial glow from top-right */
        .lp::after {
            content: '';
            position: absolute;
            top: -120px;
            right: -80px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(45,122,181,.22) 0%, transparent 70%);
            z-index: 0;
        }

        /* ── Animated orbs ────────────────────────────────────────── */
        .lp-orbs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            will-change: transform;
        }
        .orb-1 {
            width: 360px; height: 360px;
            background: radial-gradient(circle, rgba(45,122,181,.28), transparent 70%);
            top: -80px; left: -80px;
            animation: orb-drift-1 14s ease-in-out infinite;
        }
        .orb-2 {
            width: 280px; height: 280px;
            background: radial-gradient(circle, rgba(62,106,140,.22), transparent 70%);
            bottom: 10%; right: -60px;
            animation: orb-drift-2 18s ease-in-out infinite;
        }
        .orb-3 {
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(74,144,196,.18), transparent 70%);
            top: 40%; left: 30%;
            animation: orb-drift-3 11s ease-in-out infinite;
        }
        .orb-4 {
            width: 150px; height: 150px;
            background: radial-gradient(circle, rgba(30,58,95,.35), transparent 70%);
            bottom: 20%; left: 10%;
            animation: orb-drift-2 16s ease-in-out infinite reverse;
        }
        .orb-5 {
            width: 100px; height: 100px;
            background: radial-gradient(circle, rgba(45,122,181,.15), transparent 70%);
            top: 60%; right: 15%;
            animation: orb-drift-1 9s ease-in-out infinite alternate;
        }

        @@keyframes orb-drift-1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33%       { transform: translate(40px, -30px) scale(1.1); }
            66%       { transform: translate(-20px, 40px) scale(0.9); }
        }
        @@keyframes orb-drift-2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            40%       { transform: translate(-50px, -40px) scale(1.15); }
            70%       { transform: translate(30px, 20px) scale(0.85); }
        }
        @@keyframes orb-drift-3 {
            0%, 100% { transform: translate(0, 0); }
            50%       { transform: translate(25px, -35px); }
        }

        /* ── Particles container ──────────────────────────────────── */
        .lp-particles { position: absolute; inset: 0; z-index: 1; pointer-events: none; }

        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.55);
            animation: particle-drift linear infinite;
            will-change: transform, opacity;
        }

        @@keyframes particle-drift {
            0%   { transform: translateY(0) translateX(0); opacity: .12; }
            25%  { opacity: .55; }
            75%  { opacity: .3; }
            100% { transform: translateY(-120px) translateX(var(--px, 20px)); opacity: 0; }
        }

        /* ── Main content ─────────────────────────────────────────── */
        .lp-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding: 26px 40px 24px;
            gap: 0;
        }

        /* ── Logo ─────────────────────────────────────────────────── */
        .lp-logo {
            display: flex;
            align-items: center;
            gap: 14px;
            animation: fade-up .6s ease both;
        }

        .lp-logo-badge {
            width: 52px; height: 52px;
            background: linear-gradient(135deg, rgba(255,255,255,.18), rgba(255,255,255,.06));
            border: 1.5px solid rgba(255,255,255,.28);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 4px 20px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.15);
            backdrop-filter: blur(8px);
        }

        .lp-logo-badge span {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .lp-brand-block { display: flex; flex-direction: column; }

        .lp-brand-name {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 1.5px;
            line-height: 1;
        }

        .lp-brand-tag {
            font-size: 10.5px;
            font-weight: 400;
            color: var(--c-text-muted);
            letter-spacing: 0.4px;
            margin-top: 3px;
        }

        /* ── Divider ──────────────────────────────────────────────── */
        .lp-divider {
            width: 40px;
            height: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,.45), transparent);
            border-radius: 2px;
            margin: 14px 0 10px;
        }

        /* ── Clock & Greeting ─────────────────────────────────────── */
        .lp-time-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            animation: fade-up .7s .15s ease both;
        }

        .lp-greeting {
            font-size: 13.5px;
            font-weight: 500;
            color: var(--c-text-muted);
            text-transform: uppercase;
            letter-spacing: 2.5px;
            margin-bottom: 6px;
        }

        .lp-clock {
            font-size: 44px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -2px;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .lp-clock .clock-colon {
            animation: blink-colon 1s steps(1) infinite;
            color: var(--c-blue-glow);
        }

        @@keyframes blink-colon {
            0%, 49%  { opacity: 1; }
            50%, 100% { opacity: 0.25; }
        }

        .lp-date {
            font-size: 13px;
            font-weight: 400;
            color: var(--c-text-muted);
            margin-top: 6px;
            letter-spacing: 0.2px;
        }

        /* ── Headline ─────────────────────────────────────────────── */
        .lp-headline {
            margin-top: 14px;
            margin-bottom: 0;
        }

        .lp-headline h2 {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.25;
            letter-spacing: -0.5px;
        }

        .lp-headline p {
            font-size: 13px;
            color: var(--c-text-muted);
            margin-top: 5px;
            line-height: 1.55;
            max-width: 340px;
        }

        /* ── Stat cards ───────────────────────────────────────────── */
        .lp-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 16px;
            animation: fade-up .7s .25s ease both;
        }

        .lp-stat {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 14px;
            padding: 12px 10px;
            backdrop-filter: blur(10px);
            transition: background .2s ease, transform .2s ease;
        }

        .lp-stat:hover {
            background: rgba(255,255,255,.11);
            transform: translateY(-2px);
        }

        .lp-stat-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, rgba(45,122,181,.35), rgba(62,106,140,.25));
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .lp-stat-icon i {
            font-size: 18px;
            color: #82bde0;
        }

        .lp-stat-num-wrap {
            display: flex;
            align-items: baseline;
            gap: 1px;
        }

        .lp-stat-num {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.5px;
        }

        .lp-stat-suf {
            font-size: 15px;
            font-weight: 600;
            color: var(--c-blue-glow);
        }

        .lp-stat-label {
            font-size: 11px;
            color: var(--c-text-muted);
            margin-top: 3px;
            font-weight: 400;
            white-space: nowrap;
        }

        /* ── Feature list ─────────────────────────────────────────── */
        .lp-features {
            list-style: none;
            margin-top: 14px;
            margin-bottom: 14px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            animation: fade-up .7s .35s ease both;
        }

        .lp-features li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            color: var(--c-text-muted);
            font-weight: 400;
            transition: color .18s ease;
        }

        .lp-features li:hover { color: rgba(255,255,255,.9); }

        .lp-features li i {
            font-size: 17px;
            color: #4aa8de;
            flex-shrink: 0;
        }

        /* ── Footer ───────────────────────────────────────────────── */
        .lp-foot {
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            animation: fade-up .7s .45s ease both;
        }

        .lp-foot-copy {
            font-size: 11.5px;
            color: var(--c-text-faint);
        }

        .lp-foot-version {
            font-size: 11px;
            color: var(--c-text-faint);
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            padding: 3px 10px;
            border-radius: 20px;
        }

        /* ════════════════════════════════════════════════════════════════
           RIGHT PANEL
           ════════════════════════════════════════════════════════════════ */
        .rp {
            width: 480px;
            min-width: 380px;
            min-height: 100vh;
            background: linear-gradient(160deg, #edf2f7 0%, #e4ecf4 40%, #eaf0f7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
            position: relative;
            overflow: hidden;
        }

        /* Subtle radial decoration on right panel */
        .rp::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 320px; height: 320px;
            background: radial-gradient(circle, rgba(45,122,181,.09), transparent 70%);
            pointer-events: none;
        }
        .rp::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -80px;
            width: 260px; height: 260px;
            background: radial-gradient(circle, rgba(30,58,95,.07), transparent 70%);
            pointer-events: none;
        }

        /* ── Login card ───────────────────────────────────────────── */
        .login-card {
            width: 100%;
            max-width: 400px;
            background: rgba(255,255,255,.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255,255,255,.85);
            border-radius: var(--card-radius);
            padding: 40px 36px 32px;
            box-shadow:
                0 32px 80px rgba(14,33,55,.16),
                0 8px 24px rgba(14,33,55,.08),
                0 0 0 1px rgba(62,106,140,.06);
            position: relative;
            z-index: 1;
            /* Entrance animation */
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .55s cubic-bezier(.22,.61,.36,1),
                        transform .55s cubic-bezier(.22,.61,.36,1);
        }

        .login-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Top shimmer line on card */
        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 20%; right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(45,122,181,.5), transparent);
            border-radius: 0 0 2px 2px;
        }

        /* ── Card header ──────────────────────────────────────────── */
        .lc-header { text-align: center; margin-bottom: 30px; }

        .lc-badge {
            width: 68px; height: 68px;
            background: linear-gradient(145deg, #1e3a5f 0%, #2d7ab5 100%);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 12px 32px rgba(30,58,95,.38), 0 2px 8px rgba(30,58,95,.2);
            animation: badge-pop .55s cubic-bezier(.175,.885,.32,1.275) .4s both;
        }

        .lc-badge span {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        @@keyframes badge-pop {
            from { transform: scale(.5) rotate(-8deg); opacity: 0; }
            to   { transform: scale(1) rotate(0deg); opacity: 1; }
        }

        .lc-title {
            font-size: 24px;
            font-weight: 700;
            color: #1e3a5f;
            letter-spacing: -0.4px;
            margin-bottom: 5px;
        }

        .lc-subtitle {
            font-size: 13.5px;
            color: #6a8099;
            font-weight: 400;
        }

        /* ── Floating-label form inputs ───────────────────────────── */
        .fi-group { margin-bottom: 22px; }

        .fi-wrap {
            position: relative;
        }

        .fi-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 18px;
            color: #a0b3c6;
            transition: color .2s ease;
            pointer-events: none;
            z-index: 1;
        }

        .fi-input {
            width: 100%;
            padding: 20px 16px 8px 48px;
            border: 1.5px solid #dbe4ed;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            color: #1e3a5f;
            background: #f7fafc;
            outline: none;
            font-family: inherit;
            transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
            -webkit-appearance: none;
        }

        .fi-input:focus {
            border-color: #2d7ab5;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(45,122,181,.12);
        }

        .fi-input:focus ~ .fi-icon,
        .fi-input:not(:placeholder-shown) ~ .fi-icon {
            color: #2d7ab5;
        }

        .fi-label {
            position: absolute;
            left: 48px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            font-weight: 400;
            color: #94a3b5;
            pointer-events: none;
            transition: all .18s cubic-bezier(.4,0,.2,1);
            background: transparent;
        }

        .fi-input:focus ~ .fi-label,
        .fi-input:not(:placeholder-shown) ~ .fi-label {
            top: 9px;
            transform: translateY(0);
            font-size: 10.5px;
            font-weight: 600;
            color: #2d7ab5;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        /* Password eye toggle */
        .fi-eye {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b5;
            font-size: 18px;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: color .18s ease, background .18s ease;
            z-index: 1;
        }

        .fi-eye:hover { color: #2d7ab5; background: rgba(45,122,181,.08); }

        /* Password input has right padding for eye button */
        .fi-wrap--pw .fi-input { padding-right: 46px; }

        /* ── Options row ──────────────────────────────────────────── */
        .lc-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        /* Custom checkbox */
        .lc-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: 13px;
            color: #5a7288;
            font-weight: 400;
            user-select: none;
        }

        .lc-remember input[type="checkbox"] { display: none; }

        .lc-chk {
            width: 17px; height: 17px;
            border: 1.5px solid #c8d6e2;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all .18s ease;
            background: #f7fafc;
        }

        .lc-remember input:checked ~ .lc-chk {
            background: linear-gradient(135deg, #3e6a8c, #2d7ab5);
            border-color: #2d7ab5;
        }

        .lc-remember input:checked ~ .lc-chk::after {
            content: '';
            width: 9px; height: 5px;
            border-left: 2px solid #fff;
            border-bottom: 2px solid #fff;
            transform: rotate(-45deg) translate(1px, -1px);
            display: block;
        }

        .lc-forgot {
            font-size: 13px;
            color: #2d7ab5;
            text-decoration: none;
            font-weight: 500;
            transition: color .18s ease;
        }

        .lc-forgot:hover { color: #1e3a5f; }

        /* ── Login button ─────────────────────────────────────────── */
        .lc-btn {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, #3e6a8c 0%, #2d7ab5 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            box-shadow: 0 6px 22px rgba(45,122,181,.38);
            transition: all .22s ease;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.2px;
        }

        .lc-btn::after {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
            transform: skewX(-20deg);
            transition: left .5s ease;
        }

        .lc-btn:hover:not(:disabled) {
            background: linear-gradient(135deg, #2d5a7c 0%, #236a9f 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(45,122,181,.48);
        }

        .lc-btn:hover::after { left: 140%; }

        .lc-btn:active:not(:disabled) { transform: translateY(0); }

        .lc-btn:disabled { opacity: .75; cursor: not-allowed; }

        .lc-btn i { font-size: 18px; }

        /* Ripple wave */
        .ripple-wave {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.25);
            transform: scale(0);
            animation: ripple-expand .65s linear;
            pointer-events: none;
        }

        @@keyframes ripple-expand {
            to { transform: scale(4); opacity: 0; }
        }

        /* ── Loading button ───────────────────────────────────────── */
        .lc-btn-ld {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, #3e6a8c 0%, #2d7ab5 100%);
            color: rgba(255,255,255,.85);
            border: none;
            border-radius: 12px;
            font-size: 14.5px;
            font-weight: 600;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: not-allowed;
            opacity: .82;
        }

        /* Mini ring spinner for button loading state */
        .btn-spinner {
            width: 18px; height: 18px;
            border: 2px solid rgba(255,255,255,.3);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: btn-spin .7s linear infinite;
            flex-shrink: 0;
        }

        @@keyframes btn-spin { to { transform: rotate(360deg); } }

        /* ── Security note ────────────────────────────────────────── */
        .lc-security {
            margin-top: 22px;
            padding-top: 16px;
            border-top: 1px solid #edf2f7;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 11.5px;
            color: #94a3b5;
        }

        .lc-security i { font-size: 14px; color: #3e6a8c; }

        /* ── Shared keyframes ─────────────────────────────────────── */
        @@keyframes fade-up {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ════════════════════════════════════════════════════════════════
           RESPONSIVE
           ════════════════════════════════════════════════════════════════ */
        @@media (max-width: 1280px) {
            .lp-clock { font-size: 44px; }
            .lp-content { padding: 30px 36px; }
            .rp { width: 440px; padding: 40px 32px; }
        }

        @@media (max-width: 1024px) {
            .lp-content { padding: 28px 30px; gap: 0; }
            .rp { width: 400px; min-width: 340px; padding: 36px 24px; }
            .lp-clock { font-size: 38px; }
            .lp-headline h2 { font-size: 24px; }
            .lp-stats { gap: 10px; margin-top: 22px; }
            .lp-stat { padding: 14px 12px; }
            .login-card { padding: 34px 28px 26px; }
        }

        @@media (max-width: 768px) {
            body { flex-direction: column; }

            .lp {
                min-height: auto;
                padding: 0;
            }

            .lp-content {
                min-height: auto;
                padding: 32px 24px 28px;
                gap: 0;
            }

            .lp-time-section { flex: 0; }
            .lp-clock { font-size: 34px; }
            .lp-headline { margin-top: 18px; }
            .lp-headline h2 { font-size: 22px; }
            .lp-headline p { font-size: 13px; }

            .lp-stats {
                margin-top: 18px;
                gap: 8px;
            }
            .lp-stat { padding: 12px 10px; }
            .lp-stat-num { font-size: 18px; }
            .lp-stat-label { font-size: 10px; }

            .lp-features { margin-top: 18px; gap: 8px; }
            .lp-features li { font-size: 12.5px; }

            .lp-foot { margin-top: 20px; }

            .rp {
                width: 100%;
                min-width: 0;
                padding: 32px 20px 40px;
            }

            .login-card {
                border-radius: 18px;
                padding: 30px 24px 24px;
            }

            .lc-badge { width: 58px; height: 58px; border-radius: 16px; }
            .lc-title { font-size: 21px; }

            .orb-1, .orb-2, .orb-3, .orb-4, .orb-5 { display: none; }
        }

        @@media (max-width: 480px) {
            .lp-content { padding: 28px 18px 22px; }
            .lp-clock { font-size: 30px; }
            .rp { padding: 24px 16px 36px; }
            .login-card { padding: 26px 20px 20px; }
            .lc-title { font-size: 19px; }
            .lp-stats { grid-template-columns: repeat(3,1fr); }
        }

        @@media (max-height: 600px) and (orientation: landscape) {
            body { flex-direction: row; }
            .lp { min-height: 100vh; }
            .lp-content { padding: 20px 28px; }
            .lp-clock { font-size: 30px; }
            .lp-headline { margin-top: 12px; }
            .lp-stats { margin-top: 14px; }
            .lp-features { margin-top: 14px; }
            .rp { width: 420px; min-height: 100vh; padding: 20px; }
            .login-card { padding: 24px 28px 20px; }
            .fi-group { margin-bottom: 14px; }
            .fi-input { padding-top: 16px; padding-bottom: 6px; }
            .lc-options { margin-bottom: 16px; }
        }
    </style>
</head>
<body>

    <!-- ══ LEFT PANEL ══════════════════════════════════════════════════ -->
    <div class="lp">
        <!-- Animated background layers -->
        <div class="lp-orbs">
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>
            <div class="orb orb-3"></div>
            <div class="orb orb-4"></div>
            <div class="orb orb-5"></div>
        </div>
        <div class="lp-particles" id="particlesWrap"></div>

        <!-- Main content -->
        <div class="lp-content">

            <!-- Logo row -->
            <div class="lp-logo">
                <div class="lp-logo-badge">
                    <span>HR</span>
                </div>
                <div class="lp-brand-block">
                    <span class="lp-brand-name">HRMS</span>
                    <span class="lp-brand-tag">Human Resource Management System</span>
                </div>
            </div>

            <div class="lp-divider"></div>

            <!-- Clock & greeting -->
            <div class="lp-time-section">
                <div class="lp-greeting" id="lpGreeting">Good Morning</div>
                <div class="lp-clock">
                    <span id="lpH">00</span><span class="clock-colon">:</span><span id="lpM">00</span><span class="clock-colon">:</span><span id="lpS">00</span>
                </div>
                <div class="lp-date" id="lpDate">Monday, June 15, 2026</div>

                <div class="lp-headline">
                    <h2>Manage Your Workforce<br>with Confidence</h2>
                    <p>Enterprise-grade HR automation — payroll, attendance, leave, and analytics in one unified platform.</p>
                </div>
            </div>

            <!-- Stats -->
            <div class="lp-stats">
                <div class="lp-stat">
                    <div class="lp-stat-icon"><i class='bx bx-user-check'></i></div>
                    <div class="lp-stat-num-wrap">
                        <span class="lp-stat-num" data-target="10000">0</span>
                        <span class="lp-stat-suf">+</span>
                    </div>
                    <div class="lp-stat-label">Active Employees</div>
                </div>
                <div class="lp-stat">
                    <div class="lp-stat-icon"><i class='bx bx-buildings'></i></div>
                    <div class="lp-stat-num-wrap">
                        <span class="lp-stat-num" data-target="250">0</span>
                        <span class="lp-stat-suf">+</span>
                    </div>
                    <div class="lp-stat-label">Companies</div>
                </div>
                <div class="lp-stat">
                    <div class="lp-stat-icon"><i class='bx bx-shield-check'></i></div>
                    <div class="lp-stat-num-wrap">
                        <span class="lp-stat-num" data-target="99">0</span>
                        <span class="lp-stat-suf">.9%</span>
                    </div>
                    <div class="lp-stat-label">Uptime SLA</div>
                </div>
            </div>

            <!-- Features -->
            <ul class="lp-features">
                <li><i class='bx bx-check-circle'></i> Employee & Attendance Management</li>
                <li><i class='bx bx-check-circle'></i> Payroll Processing & Salary Slips</li>
                <li><i class='bx bx-check-circle'></i> Leave, Holiday & Shift Management</li>
                <li><i class='bx bx-check-circle'></i> Performance Tracking & Reports</li>
            </ul>

            <!-- Footer -->
            <div class="lp-foot">
                <span class="lp-foot-copy">&copy; 2026 HRMS &mdash; Skyline Web Solutions</span>
                <span class="lp-foot-version">v3.0</span>
            </div>

        </div><!-- /lp-content -->
    </div><!-- /lp -->

    <!-- ══ RIGHT PANEL ═════════════════════════════════════════════════ -->
    <div class="rp">
        <div class="login-card" id="loginCard">

            <!-- Card header -->
            <div class="lc-header">
                <div class="lc-badge"><span>HR</span></div>
                <h1 class="lc-title">Welcome Back</h1>
                <p class="lc-subtitle">Sign in to your HRMS account</p>
            </div>

            <!-- Form -->
            <form id="loginForm" autocomplete="on" onsubmit="return false;">

                <!-- Email -->
                <div class="fi-group">
                    <div class="fi-wrap">
                        <input type="email" id="inputEmailAddress" class="fi-input"
                               placeholder=" " autocomplete="email" required>
                        <label for="inputEmailAddress" class="fi-label">Email Address</label>
                        <i class='bx bx-envelope fi-icon'></i>
                    </div>
                </div>

                <!-- Password -->
                <div class="fi-group">
                    <div class="fi-wrap fi-wrap--pw">
                        <input type="password" id="inputChoosePassword" class="fi-input"
                               placeholder=" " autocomplete="current-password" required>
                        <label for="inputChoosePassword" class="fi-label">Password</label>
                        <i class='bx bx-lock-alt fi-icon'></i>
                        <button type="button" class="fi-eye" onclick="togglePassword()" aria-label="Toggle password visibility">
                            <i class='bx bx-hide' id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Options -->
                <div class="lc-options">
                    <label class="lc-remember">
                        <input type="checkbox" id="rememberMe">
                        <span class="lc-chk"></span>
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="lc-forgot">Forgot password?</a>
                </div>

                <!-- Login button -->
                <button type="button" class="lc-btn" id="btnLogin">
                    <span>Sign In</span>
                    <i class='bx bx-right-arrow-alt'></i>
                </button>

                <!-- Loading button (shown during auth) -->
                <button type="button" class="lc-btn-ld" id="btnLogining" disabled style="display:none;">
                    <div class="btn-spinner"></div>
                    <span>Authenticating&hellip;</span>
                </button>

            </form>

            <!-- Security note -->
            <div class="lc-security">
                <i class='bx bx-lock-alt'></i>
                <span>256-bit SSL encrypted &bull; Enterprise secure</span>
            </div>

        </div><!-- /login-card -->
    </div><!-- /rp -->

    <!-- Modals (unchanged) -->
    <div id="companyModalContainer"></div>
    <div id="sessionLogoutContainer"></div>

    <!-- Razor vars (unchanged) -->
    <script>
        var uiBaseUrlLayout = '@UIBaseUrl';
        var BaseUrlLayout   = '@baseUrl';
    </script>

    <!-- JS Dependencies (unchanged) -->
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/notifications/js/lobibox.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notifications.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notification-custom-script.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/21.1.5/js/dx.all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>
    <script src="~/assets/js/companymodalloader.js"></script>

    <script>
        /* ── Page entrance ────────────────────────────────────────── */
        document.body.classList.add('loaded');
        setTimeout(function () {
            document.getElementById('loginCard').classList.add('visible');
        }, 120);

        /* ── Live clock & dynamic greeting ───────────────────────── */
        function pad(n) { return String(n).padStart(2, '0'); }

        function updateClock() {
            var now = new Date();
            var h = now.getHours();
            document.getElementById('lpH').textContent = pad(h);
            document.getElementById('lpM').textContent = pad(now.getMinutes());
            document.getElementById('lpS').textContent = pad(now.getSeconds());

            document.getElementById('lpGreeting').textContent =
                h < 12 ? 'Good Morning' : h < 17 ? 'Good Afternoon' : 'Good Evening';

            document.getElementById('lpDate').textContent =
                now.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
        }

        updateClock();
        setInterval(updateClock, 1000);

        /* ── Floating particles ───────────────────────────────────── */
        (function () {
            var wrap = document.getElementById('particlesWrap');
            for (var i = 0; i < 28; i++) {
                var p = document.createElement('div');
                p.className = 'particle';
                var size = 2 + Math.random() * 4;
                p.style.cssText =
                    'left:' + (Math.random() * 100) + '%;' +
                    'top:'  + (Math.random() * 100) + '%;' +
                    'width:' + size + 'px;height:' + size + 'px;' +
                    '--px:' + ((Math.random() - 0.5) * 60) + 'px;' +
                    'animation-duration:' + (7 + Math.random() * 10) + 's;' +
                    'animation-delay:'    + (Math.random() * 8)       + 's;';
                wrap.appendChild(p);
            }
        })();

        /* ── Counter animation (stat numbers) ────────────────────── */
        setTimeout(function () {
            document.querySelectorAll('.lp-stat-num[data-target]').forEach(function (el) {
                var target  = parseFloat(el.dataset.target);
                var current = 0;
                var step    = target / 60;
                var timer   = setInterval(function () {
                    current += step;
                    if (current >= target) { current = target; clearInterval(timer); }
                    el.textContent = target >= 1000
                        ? Math.floor(current).toLocaleString()
                        : Math.floor(current);
                }, 24);
            });
        }, 300);

        /* ── Button ripple effect ─────────────────────────────────── */
        document.getElementById('btnLogin').addEventListener('mousedown', function (e) {
            var btn  = this;
            var r    = btn.getBoundingClientRect();
            var size = Math.max(r.width, r.height);
            var rip  = document.createElement('span');
            rip.className = 'ripple-wave';
            rip.style.cssText =
                'width:' + size + 'px;height:' + size + 'px;' +
                'left:'  + (e.clientX - r.left - size / 2) + 'px;' +
                'top:'   + (e.clientY - r.top  - size / 2) + 'px;';
            btn.appendChild(rip);
            setTimeout(function () { rip.remove(); }, 700);
        });

        /* ══ Auth functions (unchanged logic) ════════════════════════ */
        function togglePassword() {
            var inp  = document.getElementById('inputChoosePassword');
            var icon = document.getElementById('toggleIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                icon.className = 'bx bx-show';
            } else {
                inp.type = 'password';
                icon.className = 'bx bx-hide';
            }
        }

        function showBtnLoder() {
            $('#btnLogin').hide();
            $('#btnLogining').show();
        }

        function hideBtnLoder() {
            $('#btnLogin').show();
            $('#btnLogining').hide();
        }

        $(document).ready(function () {
            localStorage.removeItem("PreviousPageUrl");
            localStorage.setItem("PreviousPageUrl", window.location.href);

            /* Enter key on inputs */
            $('#inputEmailAddress, #inputChoosePassword').keypress(function (e) {
                if (e.which === 13) { $('#btnLogin').click(); }
            });

            /* Login click */
            $('#btnLogin').click(function () {
                showBtnLoder();
                var email    = $('#inputEmailAddress').val().trim();
                var password = $('#inputChoosePassword').val();

                if (!email) {
                    round_error_noti("Please enter email!");
                    hideBtnLoder(); return false;
                }
                if (!password) {
                    round_error_noti("Please enter password!");
                    hideBtnLoder(); return false;
                }

                $.ajax({
                    url:         '@baseUrl/AuthenticationAPI/Login',
                    type:        'POST',
                    contentType: 'application/json',
                    data:        JSON.stringify({ Email: email, Password: password }),
                    success: function (response) {
                        if (response.isSuccess) {
                            var token       = response.data.token;
                            var decoded     = jwt_decode(token);
                            var CompanyList = JSON.parse(decoded.Company);
                            var firstCompany = CompanyList[0];

                            localStorage.setItem("authToken",       token);
                            localStorage.setItem("EmployeeId",      decoded.Id);
                            localStorage.setItem("EmployeeName",    decoded.FullName);
                            localStorage.setItem("EmployeeCode",    decoded.EmployeeCode);
                            localStorage.setItem("RoleSlug",        decoded.RoleSlug);
                            localStorage.removeItem('NotificationSummary');
                            localStorage.setItem('NotificationSummary', 'true');
                            localStorage.setItem('EscalationSummary',   'true');

                            if (decoded.RoleSlug === "super-admin") {
                                openCompanyModal('@UIBaseUrl', '@baseUrl', CompanyList, function (selectedCompany) {
                                    if (selectedCompany) {
                                        localStorage.setItem('selectedCompany', JSON.stringify(selectedCompany));
                                        window.location.href = '@UIBaseUrl/AdminPanel/Home/index';
                                    } else {
                                        window.location.href = '@UIBaseUrl/AuthManage/Login';
                                    }
                                });
                            } else if (decoded.RoleSlug == "admin") {
                                if (decoded.IsPasswordChange == "False" || !decoded.IsPasswordChange) {
                                    window.location.href = '@UIBaseUrl/AuthManage/ChangePassword';
                                } else {
                                    localStorage.removeItem('selectedCompany');
                                    localStorage.setItem('selectedCompany', JSON.stringify(firstCompany));
                                    window.location.href = '@UIBaseUrl/AdminPanel/Home/index';
                                }
                            } else if (decoded.RoleSlug === "ess") {
                                if (decoded.IsPasswordChange == "False" || !decoded.IsPasswordChange) {
                                    window.location.href = '@UIBaseUrl/AuthManage/ChangePassword';
                                } else {
                                    localStorage.removeItem('selectedCompany');
                                    localStorage.setItem('selectedCompany', JSON.stringify(firstCompany));
                                    window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
                                }
                            } else {
                                window.location.href = '@UIBaseUrl/AuthManage/Login';
                            }
                        } else {
                            round_error_noti(response.responseMessage);
                            hideBtnLoder();
                        }
                        hideBtnLoder();
                    },
                    error: function () {
                        round_error_noti("Invalid Login Credentials.");
                        hideBtnLoder();
                    }
                });
            });
        });

        /* Session-out modal (unchanged) */
        $(document).ready(async function () {
            if (sessionStorage.getItem("SessionOut") == "true") {
                $.ajax({
                    url:  uiBaseUrlLayout + '/AdminPanel/PartialView/LoadSessionLogoutModal',
                    type: 'GET',
                    success: function (html) {
                        $('#sessionLogoutContainer').html(html);
                        sessionStorage.removeItem("SessionOut");
                    },
                    error: function () {}
                });
            }
        });
    </script>
</body>
</html>
