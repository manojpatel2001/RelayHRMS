@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Transfer";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<!-- jsPDF + html2canvas (same as increment/promotion letter) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<div class="wms-form-page">

<div class="card">
    <div class="card-header bg-transparent ml-0 py-0">
        <div class="row">
            <div class="col-6">
                <h6 class="pt-2 mb-0">Manage Employee Transfer</h6>
            </div>
            <div class="col-6 d-flex justify-content-end align-items-center">
                <button id="addTransfer" type="button" class="btn mr-1 rounded-1"
                        style="background-color:#2395c6; color:white;">
                    Add
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="grid-wrapper" style="position:relative;">
                            <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column"
                                 style="display:none; inset:0; background:rgba(255,255,255,0.6); z-index:10;">
                                <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner"
                                     style="width:30px; height:30px; animation:spin 1s linear infinite;" />
                                <div class="grid-loading-text text-dark" style="font-size:16px;">Loading...</div>
                            </div>
                            <div id="gridTag">
                                <div class="rowCount" id="rowCount1"></div>
                                <div id="gridContainer"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ══ ADD / EDIT MODAL ══ -->
<div class="modal fade" id="addTransferModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title btn-heading-title" id="modalTitle">Add Employee Transfer</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-font" style="font-size:12px;">
                <form id="transferForm">
                    <input type="hidden" id="transferId" value="0">
                    <div class="row">

                        <!-- Application Date -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="applicationDate">Application Date</label>
                                <input type="date" id="applicationDate">
                            </div>
                            <span class="field-validation-error" id="spnapplicationDate" style="display:none;font-size:0.85em;">Please Select Application Date</span>
                        </div>

                        <!-- Current Branch -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="currentBranch">Current Branch</label>
                                <select id="currentBranch">
                                    <option value="" selected disabled>Current Branch</option>
                                </select>
                                <span id="spncurrentBranch" style="color:red;display:none;font-size:0.85em;">Please Select Current Branch</span>
                            </div>
                        </div>

                        <!-- Employee -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="employeeTransfer">Employee</label>
                                <select id="employeeTransfer">
                                    <option value="" selected disabled>Employee</option>
                                </select>
                                <span id="spnemployeeTransfer" style="color:red;display:none;font-size:0.85em;">Please Select Employee</span>
                            </div>
                        </div>

                        <!-- Current Reporting Person (Read-only) -->
                        <div class="col-md-6">
                            <div class="fg">
                                <label for="currentReportingPerson">Current Reporting Person</label>
                                <input type="text" id="currentReportingPerson"
                                       readonly style="background-color:#f5f5f5;">
                                <input type="hidden" id="currentReportingPersonId">
                            </div>
                        </div>

                        <!-- Transfer Branch -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="transferBranch">Transfer Branch</label>
                                <select id="transferBranch">
                                    <option value="" selected disabled>Transfer Branch</option>
                                </select>
                                <span id="spntransferBranch" style="color:red;display:none;font-size:0.85em;">Please Select Transfer Branch</span>
                            </div>
                        </div>

                        <!-- Transfer Reporting Person -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="transferReportingPerson">Transfer Reporting Person</label>
                                <select id="transferReportingPerson">
                                    <option value="" selected disabled>Transfer Reporting Person</option>
                                </select>
                                <span id="spntransferReportingPerson" style="color:red;display:none;font-size:0.85em;">Please Select Transfer Reporting Person</span>
                            </div>
                        </div>

                        <!-- Effective Date -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="effectiveDate">Effective Date</label>
                                <input type="date" id="effectiveDate">
                            </div>
                            <span class="field-validation-error" id="spneffectiveDate" style="display:none;font-size:0.85em;">Please Select Effective Date</span>
                        </div>

                        <!-- Reason -->
                        <div class="col-md-6">
                            <div class="fg fg-req">
                                <label for="reason">Reason</label>
                                <input type="text" id="reason">
                            </div>
                            <span class="field-validation-error" id="spnreason" style="display:none;font-size:0.85em;">Please Enter Reason</span>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-primary" id="btnSaveTransfer"
                        style="background-color:#2395c6;color:white;">
                    Save
                </button>
                <button type="button" class="btn btn-primary" id="btnSavingTransfer"
                        style="background-color:#2395c6;color:white;display:none;" disabled>
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span> Saving..
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- ══ PREVIEW MODAL ══ -->
<div class="modal fade" id="previewTransferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:950px;">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Transfer Letter Preview</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="previewContent"
                 style="padding:20px; overflow-y:auto; max-height:80vh;">
                <!-- Letter HTML injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnDownloadFromPreview"
                        style="background-color:#2395c6;color:white;">
                    Download PDF
                </button>
            </div>
        </div>
    </div>
</div>

</div>

<script src="~/assets/js/jquery.min.js"></script>
<script>
    /* ── Auth / Company ─────────────────────────────────────────────────── */
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId  = companyDetails?.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token      = localStorage.getItem('authToken');

    let _currentPreviewData = null;   // used by "Download PDF" inside preview modal

    /* ══════════════════════════════════════════════════════════════════════
       SHARED HELPERS
    ══════════════════════════════════════════════════════════════════════ */
    function formatDate(dateString) {
        if (!dateString) return '';
        const date       = new Date(dateString);
        const day        = String(date.getDate()).padStart(2, '0');
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun',
                            'Jul','Aug','Sep','Oct','Nov','Dec'];
        return `${day}-${monthNames[date.getMonth()]}-${date.getFullYear()}`;
    }

    function getTitle(gender) {
        const g = (gender || '').toString().trim().toLowerCase();
        if (g === 'male'   || g === 'm' || g === '1') return 'Mr.';
        if (g === 'female' || g === 'f' || g === '2') return 'Ms.';
        return 'Mr./Ms.';
    }

    /* ══════════════════════════════════════════════════════════════════════
       LETTER HTML BUILDER  (single source of truth for Preview + Export)
    ══════════════════════════════════════════════════════════════════════ */
    function buildTransferLetterHTML(data) {
        const effectiveDate  = formatDate(data.effectiveDate  || data.EffectiveDate);
        const currentDate    = formatDate(new Date());
        const logoUrl        = '/assets/images/relaylogo.jpeg';

        const refNo          = data.refNumber                     || data.RefNumber                     || '';
        const fullName       = data.fullName                      || data.FullName                      || '';
        const empCode        = data.employeeCode                  || data.EmployeeCode                  || '';
        const currentBranch  = data.currentBranchName             || data.CurrentBranchName             || '';
        const transferBranch = data.transferBranchName            || data.TransferBranchName            || '';
        const reportingName  = data.transferReportingPersonName   || data.TransferReportingPersonName   || 'Reporting Manager';
        const companyName    = data.companyName                   || companyDetails?.CompanyName         || 'Relay Express Pvt Ltd';
        const directorName   = data.directorName                  || 'Atri Patel';
        const companyAddress = data.companyAddress                ||
            'Head Office: 406, Kataria Arcade, Behind Adani CNG Pump, Off - S.G. Highway, Makarba, Ahmedabad - 380051, Gujarat, India';

        const title    = getTitle(data.gender || data.Gender);
        const lastName = fullName.trim().split(' ').pop();

        return `
        <div class="letter-container" style="
            width:100%; max-width:860px; margin:0 auto;
            padding:50px 70px; background:#fff;
            font-family:'Calibri','Arial',sans-serif;
            font-size:13.5px; color:#222;
            box-sizing:border-box; line-height:1.8;
            border:1px solid #ddd;
        ">
            <!-- Ref No | Logo -->
            <table style="width:100%; margin-bottom:6px; border-collapse:collapse;">
                <tr>
                    <td style="vertical-align:top; font-size:12px; color:#555; width:50%;">
                        <strong>Ref No:</strong> ${refNo}
                    </td>
                    <td style="text-align:right; vertical-align:top;">
                        <img src="${logoUrl}" alt="Company Logo"
                             style="max-width:200px; height:auto;"
                             onerror="this.style.display='none'" />
                    </td>
                </tr>
            </table>

            <!-- Date -->
            <p style="margin:0 0 20px 0; text-align:right; font-size:13px;">
                <strong>${currentDate}</strong>
            </p>

            <!-- To Block -->
            <p style="margin:0 0 2px 0;">To,</p>
            <p style="margin:4px 0;"><strong>Employee Name:</strong> ${fullName}</p>
            <p style="margin:4px 0;"><strong>Employee Code:</strong> ${empCode}</p>

            <!-- Subject -->
            <p style="margin:22px 0 0 0; text-align:center;">
                <strong><u>Subject: Transfer Letter</u></strong>
            </p>

            <!-- Salutation -->
            <p style="margin-top:20px;"><strong>Dear ${title} ${lastName},</strong></p>

            <!-- Body -->
            <p style="margin:10px 0; text-align:justify;">
                This is to inform you that as per our business requirement your services are being
                transferred from <strong style="color:#e74c3c;">${currentBranch}</strong> Branch
                to <strong style="color:#e74c3c;">${transferBranch}</strong> Branch effective from
                <strong style="color:#e74c3c;">${effectiveDate}</strong>.
            </p>

            <p style="margin:10px 0; text-align:justify;">
                As such, you will be reporting for duty &amp; further assignment of work, accordingly,
                to <strong>${reportingName}</strong>. All the rules &amp; regulations and terms &amp;
                conditions as applicable to your category / post at the place you are transferred
                shall be applicable to you, accordingly.
            </p>

            <p style="margin:10px 0; text-align:justify;">
                All other terms and conditions of your employment remain unchanged.
            </p>

            <p style="margin:10px 0; text-align:justify;">
                Kindly acknowledge the receipt of the same &amp; share the signed copy with the HRD.
            </p>

            <p style="margin:14px 0;"><strong>Good Luck!!</strong></p>

            <!-- Signature -->
            <div style="margin-top:40px;">
                <p style="margin:4px 0;"><strong>Sincerely,</strong></p>
                <p style="margin:4px 0;"><strong>${companyName}</strong></p>
                <br/><br/>
                <p style="margin:4px 0; color:#e74c3c;"><strong><u>Mr. ${directorName}</u></strong></p>
                <p style="margin:4px 0;"><strong>Director</strong></p>
            </div>

            <!-- Footer Note -->
            <div style="margin-top:30px; font-size:11px; text-align:center; color:#555;
                        border-top:1px solid #eee; padding-top:10px;">
                <p style="margin:2px 0;">
                    <strong>Note: This is a computer-generated statement hence no signature required.</strong>
                </p>
                <p style="margin:2px 0;"><strong>Personal &amp; Confidential</strong></p>
            </div>

            <!-- Company Address -->
            <div style="margin-top:8px; font-size:11px; text-align:center; color:#666;">
                <p style="margin:2px 0;"><strong>${companyAddress}</strong></p>
            </div>
        </div>`;
    }

    /* ══════════════════════════════════════════════════════════════════════
       PREVIEW
    ══════════════════════════════════════════════════════════════════════ */
    function PreviewTransferLetter(data) {
        _currentPreviewData = data;
        $('#previewContent').html(buildTransferLetterHTML(data));
        $('#previewTransferModal').modal('show');
    }

    /* Download PDF from inside Preview modal */
    $('#btnDownloadFromPreview').on('click', function () {
        if (_currentPreviewData) ExportTransferLetterToPDF(_currentPreviewData);
    });

    /* ══════════════════════════════════════════════════════════════════════
       EXPORT TO PDF  —  html2canvas + jsPDF (same as increment/promotion)
    ══════════════════════════════════════════════════════════════════════ */
    function ExportTransferLetterToPDF(data) {
        const fullName = data.fullName || data.FullName || 'Employee';

        /* Render in viewport (visible) so html2canvas captures correctly */
        const tempDiv = document.createElement('div');
        tempDiv.style.cssText = [
            'position:fixed',
            'top:0',
            'left:0',
            'width:900px',
            'background:#fff',
            'z-index:99999',
            'pointer-events:none'
        ].join(';');
        tempDiv.innerHTML = buildTransferLetterHTML(data);
        document.body.appendChild(tempDiv);

        const element = tempDiv.querySelector('.letter-container');

        /* Give DOM time to paint before capturing */
        setTimeout(function () {
            html2canvas(element, {
                scale: 2,
                useCORS: true,
                allowTaint: true,
                logging: false,
                backgroundColor: '#ffffff',
                width:  element.scrollWidth,
                height: element.scrollHeight
            }).then(function (canvas) {
                const imgData    = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                const pdf        = new jsPDF('p', 'mm', 'a4');
                const imgWidth   = 210;
                const pageHeight = 297;
                const imgHeight  = (canvas.height * imgWidth) / canvas.width;
                let heightLeft   = imgHeight;
                let position     = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft > 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save(`Transfer_Letter_${fullName}_${new Date().getTime()}.pdf`);
                document.body.removeChild(tempDiv);
                toastr.success('Transfer letter exported successfully!');
            }).catch(function (err) {
                document.body.removeChild(tempDiv);
                console.error('PDF error:', err);
                toastr.error('Failed to generate PDF.');
            });
        }, 400);
    }

    /* ══════════════════════════════════════════════════════════════════════
       ON READY
    ══════════════════════════════════════════════════════════════════════ */
    $(document).ready(function () {
        $('#applicationDate').val(new Date().toISOString().split('T')[0]);
        loadEmployeeTransfers(CompanyId);

        $('#employeeTransfer').on('change', function () {
            var val = $(this).val();
            if (val) loadCurrentReportingPerson(val);
        });

        BindBranchDropdownForTransfer();
        loadTransferReportingPersonDropdown();
    });

    /* ── Add button ─────────────────────────────────────────────────────── */
    $('#addTransfer').click(function () {
        resetTransferForm();
        $('#modalTitle').text('Add Employee Transfer');
        $('#addTransferModal').modal('show');
    });

    /* ── Loader helpers ─────────────────────────────────────────────────── */
    function showbtnLoder(isUpdate) {
        $('#btnSaveTransfer').hide();
        $('#btnSavingTransfer')
            .html(`<span class="spinner-border spinner-border-sm me-2" role="status"></span>
                   ${isUpdate ? 'Updating..' : 'Saving..'}`)
            .show();
    }
    function hidebtnLoder() {
        $('#btnSaveTransfer').show();
        $('#btnSavingTransfer').hide();
    }

    /* ── Current Reporting Person ───────────────────────────────────────── */
    function loadCurrentReportingPerson(employeeId) {
        $.ajax({
            url: `@baseUrl/LeaveApplication/GetReportingperson?Empid=${employeeId}`,
            method: 'POST',
            dataType: 'json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess && response.data) {
                    $('#currentReportingPerson').val(response.data.fullName);
                    $('#currentReportingPersonId').val(response.data.id);
                } else {
                    $('#currentReportingPerson').val('');
                    $('#currentReportingPersonId').val('');
                }
            },
            error: function () {
                $('#currentReportingPerson').val('');
                $('#currentReportingPersonId').val('');
            }
        });
    }

    /* ── Transfer Reporting Person Dropdown ─────────────────────────────── */
    function loadTransferReportingPersonDropdown() {
        $.ajax({
            url: `@baseUrl/EmployeeMasterAPI/GetReportingList`,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.data) {
                    var $sel = $('#transferReportingPerson');
                    $sel.empty().append('<option value="" selected disabled>Transfer Reporting Person</option>');
                    res.data.forEach(function (p) {
                        $sel.append($('<option>', { value: p.employeeId, text: p.employeeName }));
                    });
                }
            }
        });
    }

    /* ── Branch Dropdown ────────────────────────────────────────────────── */
    async function BindBranchDropdownForTransfer() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (data) {
                    if (data.isSuccess) {
                        var branches = data.data || [];
                        var $current = $('#currentBranch');
                        var $transfer = $('#transferBranch');
                        $current.empty().append('<option value="" selected disabled>Current Branch</option>');
                        $transfer.empty().append('<option value="" selected disabled>Transfer Branch</option>');
                        branches.forEach(function (b) {
                            $current.append($('<option>', { value: b.branchId, text: b.branchName }));
                            $transfer.append($('<option>', { value: b.branchId, text: b.branchName }));
                        });
                        $current.on('change', function () { BindEmployeeByBranchIdForTransfer(); });
                        resolve(data.data);
                    } else { reject('Failed to fetch branches'); }
                },
                error: function (e) { reject(e); }
            });
        });
    }

    /* ── Employee Dropdown by Branch ────────────────────────────────────── */
    async function BindEmployeeByBranchIdForTransfer() {
        const branchId = $('#currentBranch').val();
        if (!branchId) return;
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetEmployeeListByBranchId',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ BranchId: branchId, CompanyId: CompanyId }),
                success: function (data) {
                    if (data.isSuccess) {
                        var $sel = $('#employeeTransfer');
                        $sel.empty().append('<option value="" selected disabled>Employee</option>');
                        (data.data || []).forEach(function (e) {
                            $sel.append($('<option>', { value: e.employeeId, text: e.employeeName }));
                        });
                        resolve(data.data);
                    } else { reject('Failed to fetch employees'); }
                },
                error: function (e) { reject(e); }
            });
        });
    }

    /* ══════════════════════════════════════════════════════════════════════
       LOAD GRID
    ══════════════════════════════════════════════════════════════════════ */
    async function loadEmployeeTransfers(CompanyId) {
        $('#grid-loader').addClass('d-flex').show();
        return new Promise((resolve, reject) => {
            $.ajax({
                url: `@baseUrl/EmployeeTransferAPI/GetEmployeeTransfer/${CompanyId}`,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (!response.isSuccess) {
                        $('#grid-loader').removeClass('d-flex').hide();
                        toastr.error(response.responseMessage || 'Failed to load data');
                        reject(response.responseMessage);
                        return;
                    }

                    $('#gridContainer').dxDataGrid({
                        dataSource: response.data || [],
                        columns: [
                            {
                                dataField: 'effectiveDate',
                                caption: 'Effective Date',
                                dataType: 'date',
                                format: 'dd-MM-yyyy'
                            },
                            { dataField: 'currentBranchName',  caption: 'Current Branch'  },
                            { dataField: 'fullName',           caption: 'Employee Name'   },
                            { dataField: 'transferBranchName', caption: 'Transfer Branch' },
                            { dataField: 'reason',             caption: 'Reason'          },
                            { dataField: 'transferId',         caption: 'TransferId', visible: false },
                            {
                                caption: 'Edit', width: '70px', alignment: 'center',
                                cellTemplate: function (container, options) {
                                    $('<a href="javascript:;" title="Edit">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">' +
                                        '<path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>' +
                                        '<path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>' +
                                        '</svg></a>')
                                        .on('click', function () { UpdateTransferData(options.data); })
                                        .appendTo(container);
                                }
                            },
                            {
                                caption: 'Delete', width: '80px', alignment: 'center',
                                cellTemplate: function (container, options) {
                                    $('<a href="javascript:;" title="Delete">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">' +
                                        '<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>' +
                                        '<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>' +
                                        '</svg></a>')
                                        .on('click', function () { DeleteTransfer(options.data); })
                                        .appendTo(container);
                                }
                            },
                            {
                                caption: 'Preview', width: '80px', alignment: 'center',
                                cellTemplate: function (container, options) {
                                    $('<a href="javascript:;" title="Preview Letter">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">' +
                                        '<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>' +
                                        '<path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>' +
                                        '</svg></a>')
                                        .on('click', function () { PreviewTransferLetter(options.data); })
                                        .appendTo(container);
                                }
                            },
                            {
                                caption: 'Export', width: '80px', alignment: 'center',
                                cellTemplate: function (container, options) {
                                    $('<a href="javascript:;" title="Export PDF">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">' +
                                        '<path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>' +
                                        '<path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>' +
                                        '</svg></a>')
                                        .on('click', function () { ExportTransferLetterToPDF(options.data); })
                                        .appendTo(container);
                                }
                            }
                        ],
                        columnAutoWidth: true,
                        allowColumnResizing: true,
                        columnResizingMode: 'widget',
                        wordWrapEnabled: false,
                        showBorders: true,
                        scrolling: {
                            mode: 'standard', useNative: true,
                            scrollByContent: true, scrollByThumb: true, showScrollbar: 'always'
                        },
                        rowAlternationEnabled: false,
                        grouping: { autoExpandAll: false },
                        paging: { pageSize: 10 },
                        pager: { showPageSizeSelector: true, allowedPageSizes: [10, 25, 50, 100] },
                        headerFilter: { visible: false },
                        filterRow: { visible: false },
                        groupPanel: { visible: false },
                        searchPanel: { visible: true, width: 240, placeholder: 'Search...' },
                        allowColumnReordering: false,
                        onContentReady: function (e) {
                            $('.rowCount').html('Total Records: ' + e.component.totalCount());
                            e.component.updateDimensions();
                            $('#grid-loader').removeClass('d-flex').hide();
                        }
                    }).dxDataGrid('instance');

                    toastr.success(response.responseMessage || 'Data loaded successfully');
                    resolve(response.data);
                },
                error: function (xhr) {
                    $('#grid-loader').removeClass('d-flex').hide();
                    toastr.error((xhr.responseJSON && xhr.responseJSON.responseMessage) || 'Failed to load employee transfers');
                    reject(xhr);
                }
            });
        });
    }

    /* ══════════════════════════════════════════════════════════════════════
       SAVE / UPDATE
    ══════════════════════════════════════════════════════════════════════ */
    $('#btnSaveTransfer').click(function () {
        const transferId = $('#transferId').val();
        const isUpdate   = transferId > 0;
        showbtnLoder(isUpdate);

        const currentBranch            = $('#currentBranch').val();
        const employee                 = $('#employeeTransfer').val();
        const transferBranch           = $('#transferBranch').val();
        const currentReportingPersonId = $('#currentReportingPersonId').val();
        const transferReportingPerson  = $('#transferReportingPerson').val();
        const effectiveDate            = $('#effectiveDate').val();
        const reason                   = $('#reason').val();
        let isValid = true;

        if (!currentBranch)           { $('#spncurrentBranch').show();          isValid = false; } else { $('#spncurrentBranch').hide(); }
        if (!employee)                { $('#spnemployeeTransfer').show();        isValid = false; } else { $('#spnemployeeTransfer').hide(); }
        if (!transferBranch)          { $('#spntransferBranch').show();          isValid = false; } else { $('#spntransferBranch').hide(); }
        if (!transferReportingPerson) { $('#spntransferReportingPerson').show(); isValid = false; } else { $('#spntransferReportingPerson').hide(); }
        if (!effectiveDate)           { $('#spneffectiveDate').show();           isValid = false; } else { $('#spneffectiveDate').hide(); }
        if (!reason || !reason.trim()){ $('#spnreason').show();                  isValid = false; } else { $('#spnreason').hide(); }

        if (!isValid) { hidebtnLoder(); return; }

        const transferData = {
            TransferId:              parseInt(transferId),
            EmployeeId:              parseInt(employee),
            CurrentBranchId:         parseInt(currentBranch),
            TransferBranchId:        parseInt(transferBranch),
            CurrentReportingPerson:  parseInt(currentReportingPersonId) || 0,
            TransferReportingPerson: parseInt(transferReportingPerson),
            EffectiveDate:           effectiveDate,
            Reason:                  reason.trim(),
            IsEnabled:               true,
            IsDeleted:               false,
            CreatedBy:               parseInt(EmployeeId),
            UpdatedBy:               parseInt(EmployeeId)
        };

        const apiUrl = isUpdate
            ? '@baseUrl/EmployeeTransferAPI/UpdateEmployeeTransfer'
            : '@baseUrl/EmployeeTransferAPI/CreateEmployeeTransfer';

        $.ajax({
            url: apiUrl,
            type: isUpdate ? 'PUT' : 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(transferData),
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    $('#addTransferModal').modal('hide');
                    loadEmployeeTransfers(CompanyId);
                } else {
                    round_error_noti(response.responseMessage);
                }
                hidebtnLoder();
            },
            error: function (xhr) {
                hidebtnLoder();
                round_error_noti((xhr.responseJSON && xhr.responseJSON.responseMessage) || 'Unable to save employee transfer');
            }
        });
    });

    /* ══════════════════════════════════════════════════════════════════════
       RESET FORM
    ══════════════════════════════════════════════════════════════════════ */
    async function resetTransferForm() {
        $('#transferId').val('0');
        $('#applicationDate').val(new Date().toISOString().split('T')[0]);
        $('#effectiveDate').val('');
        $('#currentBranch').val('');
        $('#employeeTransfer').val('');
        $('#transferBranch').val('');
        $('#transferReportingPerson').val('');
        $('#currentReportingPerson').val('');
        $('#currentReportingPersonId').val('');
        $('#reason').val('');
        hidebtnLoder();
        $('#btnSaveTransfer').text('Save');
        $('#spnapplicationDate, #spncurrentBranch, #spnemployeeTransfer, #spntransferBranch, #spntransferReportingPerson, #spneffectiveDate, #spnreason').hide();
    }

    /* ══════════════════════════════════════════════════════════════════════
       UPDATE (EDIT)
    ══════════════════════════════════════════════════════════════════════ */
    async function UpdateTransferData(data) {
        await resetTransferForm();
        $('#modalTitle').text('Update Employee Transfer');
        $('#btnSaveTransfer').text('Update');

        $('#transferId').val(data.transferId || data.TransferId || 0);

        const currentBranchId = data.currentBranchId || data.CurrentBranchId;
        $('#currentBranch').val(currentBranchId);
        await BindEmployeeByBranchIdForTransfer();

        const employeeId = data.employeeId || data.EmployeeId;
        $('#employeeTransfer').val(employeeId);
        if (employeeId) await loadCurrentReportingPerson(employeeId);

        $('#transferBranch').val(data.transferBranchId || data.TransferBranchId);

        const trpId = data.transferReportingPerson || data.TransferReportingPerson;
        if (trpId) $('#transferReportingPerson').val(trpId);

        let effDateStr = data.effectiveDate || data.EffectiveDate || '';
        if (effDateStr) {
            effDateStr = effDateStr.includes('T') ? effDateStr.split('T')[0]
                       : effDateStr.includes(' ') ? effDateStr.split(' ')[0]
                       : effDateStr;
            $('#effectiveDate').val(effDateStr);
        }

        $('#reason').val(data.reason || data.Reason || '');
        $('#addTransferModal').modal('show');
    }

    /* ══════════════════════════════════════════════════════════════════════
       DELETE
    ══════════════════════════════════════════════════════════════════════ */
    function DeleteTransfer(data) {
        const transferId = data.transferId || data.TransferId;
        if (!confirm('Are you sure you want to delete this transfer?')) return;
        $.ajax({
            url: '@baseUrl/EmployeeTransferAPI/Delete',
            type: 'DELETE',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({ Id: parseInt(transferId), DeletedBy: EmployeeId.toString() }),
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    loadEmployeeTransfers(CompanyId);
                } else {
                    round_error_noti(response.responseMessage);
                }
            },
            error: function (xhr) {
                round_error_noti((xhr.responseJSON && xhr.responseJSON.responseMessage) || 'Unable to delete transfer');
            }
        });
    }
</script>
