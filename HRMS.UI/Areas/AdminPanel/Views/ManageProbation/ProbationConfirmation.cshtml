			// ── Helper: lastName fallback → firstName ──
	function getLastNameOrFirst(data) {
		const nameParts = (data.employeeName || "").trim().split(/\s+/);
		// employeeName format: "Mr. First Middle Last"
		// Skip initial (Mr./Mrs./Ms.) if present
		const skipInitials = /^(Mr\.|Mrs\.|Ms\.|Dr\.)$/i;
		const filtered = nameParts.filter(p => !skipInitials.test(p));
		if (filtered.length > 1) {
			return filtered[filtered.length - 1]; // last name
		}
		return filtered[0] || data.employeeName || ""; // fallback to first
	}

