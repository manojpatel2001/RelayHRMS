@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Probation Confirmation";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Probation Review &amp; Confirmation</h6>
		<button type="button" id="exportExcelButton" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1" onclick="downloadGridExcel()">
			<i class="bx bx-file-excel"></i>
			<span class="btn-spinner-icon"></span>
			<span class="btn-label-text">Export Excel</span>
		</button>
	</div>

	<div class="card-body">
		<div class="d-flex flex-wrap gap-3 mb-3">
			<div class="fg" style="min-width:200px;max-width:240px;flex:1 1 auto;">
				<label for="ddlStatus">Probation Status</label>
				<select id="ddlStatus">
					<option selected value="">All</option>
				</select>
			</div>
			<div class="fg" style="min-width:200px;max-width:240px;flex:1 1 auto;">
				<label for="ddlYear">Year</label>
				<select id="ddlYear">
					<option selected value="">All</option>
				</select>
			</div>
		</div>

		<div id="probationGrid"></div>
	</div>
</div>

<!-- Approval History Modal (replaces the old DevExtreme masterDetail row-expansion) -->
<div class="modal fade" id="approvalHistoryModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Approval History</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="approvalHistoryGrid"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmEmailChangeModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-warning text-dark">
				<h5 class="modal-title">Confirmation</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<p>Are you sure you want to proceed with sending the confirmation email to this employee?</p>
			</div>

			<div class="modal-footer">
				<button type="button" id="btnConfirmNo" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
				<button type="button" id="btnConfirmYes" class="btn btn-primary">Yes</button>
			</div>
		</div>
	</div>
</div>


<div class="modal fade"
	 id="emailModal"
	 tabindex="-1"
	 data-bs-backdrop="static"
	 data-bs-keyboard="false">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">

			<div class="modal-header bg-info text-white">
				<h5 class="modal-title">Update Employee Email</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<div class="col-md-12">
						<div class="fg fg-req">
							<label for="employeeEmail">Employee Email</label>
							<input type="text" id="employeeEmail" placeholder="Employee Email">
						</div>
						<span class="field-validation-error" id="spnEmployeeEmail" style="display:none;">Please Enter Employee Email</span>
					</div>

					<div class="col-md-12 mt-3">
						<input type="checkbox" id="reportingEmailCheck" checked>
						&nbsp;<label for="reportingEmailCheck"><i>Do you also want to send mail to reporting manager?</i></label>
					</div>
					<div class="col-md-12">
						<div class="fg">
							<label for="reportingEmail">Reporting Manager Email</label>
							<input type="text" id="reportingEmail" placeholder="Reporting Manager Email">
						</div>
						<span class="field-validation-error" id="spnReportingEmail" style="display:none;">Please Enter Reporting Email</span>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" id="btnEmailSend" class="btn btn-primary d-inline-flex align-items-center gap-1">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Send</span>
				</button>
			</div>

		</div>
	</div>
</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<script>
		const EmployeeId=localStorage.getItem('EmployeeId');
	var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
	const CompanyId=companyDetails.CompanyId;
		const Token=localStorage.getItem("authToken");

	let probationGrid = null;
	let probationRows = [];

	$(document).ready(() =>
	{
			bindYearDropdown();
			GetAllProbationStatus();
			PermGuard.onReady(() => { ProbationDataTable(); });
			PermGuard.applyActions('manageprobation-probationconfirmation', { export: '#exportExcelButton' });
	});


		function bindYearDropdown() {
			const ddlYear = $("#ddlYear");

			ddlYear.empty();
			ddlYear.append('<option value="">All</option>');

			const currentYear = new Date().getFullYear();

			// Previous, Current, Next year
			for (let y = currentYear - 1; y <= currentYear + 1; y++) {
				ddlYear.append(
					`<option value="${y}">${y}</option>`
				);
			}
		}
		$("#ddlStatus,#ddlYear").change(()=>{
		ProbationDataTable();
	});

	function GetAllProbationStatus() {
		$.ajax({
			url: '@baseUrl/ProbationPerformanceAPI/GetAllProbationStatus',
			method: 'GET',
			headers: {
				'Authorization': 'Bearer ' + Token
			},
			success: function (data) {
				if (data.isSuccess && data.data && data.data.length > 0) {

					var ddlProbationStatus = $("#ddlStatus");
					ddlProbationStatus.empty();
					ddlProbationStatus.append(
						$('<option>', { value: '', text: 'All' })
					);

					$.each(data.data, function (index, item) {
							if(item.ProbationStatusId!=6){
							ddlProbationStatus.append(
								$('<option>', {
									value: item.ProbationStatusId,
									text: item.ProbationStatusName
								})
							);
							}
					});
				}
			},
			error: function (error) {
				console.error('Error fetching probation status data:', error);
			}
		});
	}

	function fmtDate(v) {
		if (!v) return '-';
		var d = new Date(v);
		if (isNaN(d.getTime())) return '-';
		var day = String(d.getDate()).padStart(2, '0');
		var month = String(d.getMonth() + 1).padStart(2, '0');
		return day + '-' + month + '-' + d.getFullYear();
	}

	function escapeHtml(v) {
		return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
			return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
		});
	}

	function truncRender(v) {
		var text = (v === null || v === undefined || v === '') ? '-' : v;
		return '<span style="display:block;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + escapeHtml(text) + '">' + escapeHtml(text) + '</span>';
	}

	function statusPill(v) {
		var text = v || '-';
		var t = text.toLowerCase();
		var cls = 'wg-pill-pu';
		if (t.indexOf('approv') !== -1 || t.indexOf('confirm') !== -1) cls = 'wg-pill-green';
		else if (t.indexOf('reject') !== -1) cls = 'wg-pill-red';
		else if (t.indexOf('pend') !== -1) cls = 'wg-pill-amber';
		return '<span class="wg-pill ' + cls + '">' + escapeHtml(text) + '</span>';
	}

	function renderProbationGrid() {
		probationGrid = WMSGrid.create({
			container: 'probationGrid',
			title: 'Probation Records',
			icon: 'bx-id-card',
			perPage: 100000,
			data: probationRows,
			features: { pagination: false, perPage: false, paginationInfo: false },
			columns: [
				{ field: 'employeeCode', header: 'Code', width: '90px' },
				{ field: 'employeeName', header: 'Employee Name', width: '180px', render: truncRender },
				{ field: 'personalEmailId', header: 'Personal Email', width: '200px', render: truncRender },
				{ field: 'statusName', header: 'Status', width: '120px', align: 'center', render: function (v) { return statusPill(v); } },
				{ field: 'remarksOfApprover', header: 'Remarks Of Approver', width: '200px', render: truncRender },
				{ field: 'reportingManagerName', header: 'Reporting Manager', width: '180px', render: truncRender },
				{ field: 'reportingManagerEmail', header: 'Manager Email', width: '200px', render: truncRender },
				{ field: 'currentLevelNo', header: 'Current Level', width: '100px', align: 'center' },
				{ field: 'currentApprover', header: 'Current Approver', width: '180px', render: truncRender },
				{ field: 'probationEvaluationDays', header: 'Evaluation Days', width: '120px', align: 'center' },
				{ field: 'probationDueDate', header: 'Probation Due Date', width: '130px', align: 'center', render: function (v) { return fmtDate(v); } },
				{ field: 'probationEndDate', header: 'Probation End Date', width: '130px', align: 'center', render: function (v) { return fmtDate(v); } },
				{ field: 'dateOfJoining', header: 'Date Of Joining', width: '130px', align: 'center', render: function (v) { return fmtDate(v); } },
				{ field: 'actionDate', header: 'Action Date', width: '120px', align: 'center', render: function (v) { return v ? fmtDate(v) : 'No Action'; } },
				{
					header: 'Mail Sent Status', sortable: false, width: '120px', align: 'center',
					render: function (v, row) {
						return row.isMailSent
							? '<span class="wg-pill wg-pill-green">Yes</span>'
							: '<span class="wg-pill wg-pill-red">No</span>';
					}
				},
				{
					header: 'Approval History', sortable: false, width: '140px', align: 'center',
					render: function (v, row) {
						var n = (row.approvalHistory && row.approvalHistory.length) || 0;
						return '<button type="button" class="wg-btn wg-btn-outline" onclick="openApprovalHistory(' + row.approvalRequestId + ')"><i class="bx bx-history"></i> View (' + n + ')</button>';
					}
				},
				{
					header: 'Actions', sortable: false, stickyRight: true, width: '90px', align: 'center',
					render: function (v, row) {
						if (row.statusId !== 2) return '';
						var downloadBtn = PermGuard.has('export-manageprobation-probationconfirmation')
							? '<button type="button" class="wg-btn wg-btn-outline" title="Download PDF" onclick="downloadPDF(probationRows.find(function(r){return r.approvalRequestId===' + row.approvalRequestId + ';}))"><i class="bx bx-file-blank"></i></button>'
							: '';
						return '<button type="button" class="wg-btn wg-btn-outline" title="Send Mail" onclick="sendMail(probationRows.find(function(r){return r.approvalRequestId===' + row.approvalRequestId + ';}))"><i class="bx bx-envelope"></i></button> ' +
							   downloadBtn;
					}
				}
			]
		});
	}

	function openApprovalHistory(approvalRequestId) {
		var row = probationRows.find(function (r) { return r.approvalRequestId === approvalRequestId; });
		var history = (row && row.approvalHistory) || [];

		WMSGrid.create({
			container: 'approvalHistoryGrid',
			title: 'Approval History',
			icon: 'bx-history',
			perPage: 100000,
			data: history,
			emptyText: 'No approval history available',
			features: { pagination: false, perPage: false, paginationInfo: false, export: false },
			columns: [
				{ field: 'historyLevelNo', header: 'Level', width: '70px', align: 'center' },
				{ field: 'historyStatus', header: 'Status', width: '130px', align: 'center', render: function (v) { return statusPill(v); } },
				{ field: 'historyApproverName', header: 'Approver Name', width: '200px', render: truncRender },
				{ field: 'historyRemarksOfApprover', header: 'Remarks Of Approver', width: '220px', render: truncRender },
				{ field: 'historyAssignedOn', header: 'Assign Date', width: '120px', align: 'center', render: function (v) { return fmtDate(v); } },
				{ field: 'historyActionOn', header: 'Action On', width: '120px', align: 'center', render: function (v) { return fmtDate(v); } },
				{ field: 'historyEscalatedOn', header: 'Escalated Date', width: '120px', align: 'center', render: function (v) { return fmtDate(v); } }
			]
		});

		new bootstrap.Modal(document.getElementById('approvalHistoryModal')).show();
	}

	  async function ProbationDataTable() {
			try {
				if (probationGrid) probationGrid.showLoader();

				let statusId = $("#ddlStatus").val();
				let year = $("#ddlYear").val();
				if (!year) year = null;
				if (!statusId) statusId = null;

				const response = await $.ajax({
					url: '@baseUrl/ProbationPerformanceAPI/GetAllConfirmationProbationDetails',
					method: 'POST',
					contentType: 'application/json',
					headers: {
						'Authorization': 'Bearer ' + Token
					},
					data: JSON.stringify({
						CompanyId: CompanyId,
						StatusId: statusId,
						Year: year,
						ApprovalMasterId: 1
					})
				});

				probationRows = response.data || [];

				if (!probationGrid) {
					renderProbationGrid();
				} else {
					probationGrid.setData(probationRows);
					probationGrid.hideLoader();
				}
			} catch (error) {
				console.error("Error loading probation data:", error);
				if (probationGrid) probationGrid.hideLoader();
			}
		}

			let selectedEmployeeData = null;

		function sendMail(data) {
			// Store data globally so YES button can access
			selectedEmployeeData = data;
			// Open confirmation modal
			$("#confirmEmailChangeModal").modal("show");
		}


		$("#btnConfirmYes").on("click", function () {

			// Close confirmation modal
			$("#confirmEmailChangeModal").modal("hide");

			// (Optional) Fill data in email modal
			if (selectedEmployeeData) {
				$("#employeeEmail").val(selectedEmployeeData.personalEmailId);
				$("#reportingEmail").val(selectedEmployeeData.reportingManagerEmail);
			}

			// Open actual email modal
			$("#emailModal").modal("show");
		});


		$("#btnEmailSend").on("click", async function () {
			try {
				setBtnLoading('#btnEmailSend', 'Sending...');
				var email = $("#employeeEmail").val();
				var reportingEmail = $("#reportingEmail").val();

				if (!email) {
					round_error_noti("Please enter email.");
					setBtnNormal('#btnEmailSend', 'Send');
					return;
				}
					const isChecked = $("#reportingEmailCheck").is(':checked');
					if(isChecked){
						if (!reportingEmail)
						{
								round_error_noti("Please enter reporting email.");
							setBtnNormal('#btnEmailSend', 'Send');
							return;
						}
					}
					else{
							reportingEmail=null;
					}

				// Get the PDF as a Base64 string
				const pdfBase64 = await getPDFAsBase64(selectedEmployeeData);
				if(!pdfBase64){
					round_error_noti("Some thing went wrong.");
					return ;
				}
				var emailPayload = {
					EmployeeId: selectedEmployeeData.employeeId,
					EmployeeName: selectedEmployeeData.employeeName,
					EmployeeCode: selectedEmployeeData.employeeCode,
					CompanyName: selectedEmployeeData.companyName,
					ActionDate: selectedEmployeeData.actionDate,
					Location: selectedEmployeeData.location,
					PersonalEmailId: email,
						ReportingManagerEmail:reportingEmail,
					ApprovalRequestId:selectedEmployeeData.approvalRequestId,
					ConfirmationPdf: pdfBase64 // Send as Base64 string
				};


				const response = await $.ajax({
					url: '@baseUrl/ProbationPerformanceAPI/SendProbationConfirmationEmail',
					method: 'POST',
					contentType: 'application/json',
					headers: {
						'Authorization': 'Bearer ' + Token
					},
					data: JSON.stringify(emailPayload)
				});

				if (response.isSuccess) {
					round_success_noti(response.responseMessage);
					 ProbationDataTable();
					$("#emailModal").modal("hide");
				} else {
					round_error_noti(response.responseMessage);
				}
			} catch (error) {
				console.error("Error in sending email:", error);
				round_error_noti("An error occurred while sending the email. Please try again.");
			} finally {
				setBtnNormal('#btnEmailSend', 'Send');
			}
		});



		/* =====================================================================
		   PDF TEMPLATE  –  Updated to match Confirmation_Letter_Draft.pdf
		   Changes:
			 • Ref No: HR/CL/{referenceNo}  (top-left)  +  Date DD/MM/YYYY  (top-right, next to logo)
			 • Layout: To → Employee details → centred Subject → body → Signatory
