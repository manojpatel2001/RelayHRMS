	</div>`;

		/* ── Helper: format a date object as DD/MM/YYYY ── */
		function formatDateDMY(dateObj) {
			if (!dateObj) return "";
			return String(dateObj.getDate()).padStart(2, '0') + '/' +
				   String(dateObj.getMonth() + 1).padStart(2, '0') + '/' +
				   dateObj.getFullYear();
		}

		/* ── Helper: fill all dynamic fields from employee data ── */
			function fillPDFTemplate(data) {
		document.getElementById("pdf-ref-no").textContent      = data.referenceNo || "";
		document.getElementById("pdf-employee-name").textContent = data.employeeName || "";
		document.getElementById("pdf-employee-code").textContent = data.employeeCode || "";
		document.getElementById("pdf-branch").textContent        = data.branchName || "";
			document.getElementById("pdf-company-name").textContent        = data.companyName || "";

		const initial    = (data.initial || "").trim();
		const lastNamePart = getLastNameOrFirst(data);
		document.getElementById("pdf-salutation").textContent =
			(initial ? initial + " " : "") + lastNamePart;

		const confDate = data.probationEndDate ? new Date(data.probationEndDate) : null;
		document.getElementById("pdf-confirmation-date").textContent = formatDateDMY(confDate);

		const letterDate = data.actionDate ? new Date(data.actionDate) : new Date();
		document.getElementById("pdf-date").textContent = formatDateDMY(letterDate);
	}

		async function downloadPDF(data) {
			try {

				// Get the PDF as a Uint8Array (Byte[])
				const byteArray = await getPDFAsByteArray(data);

				// Create a Blob from the Uint8Array
				const blob = new Blob([byteArray], { type: 'application/pdf' });

				// Create a download link
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = `Confirmation_Letter_${data.employeeCode}.pdf`;

				// Append the element to the DOM (required for Firefox)
				document.body.appendChild(a);

				// Trigger the download
				a.click();

				// Clean up
				document.body.removeChild(a);
				URL.revokeObjectURL(url);

			} catch (error) {
				console.error("Error downloading PDF:", error);
				alert("Failed to download PDF. Please try again.");
			}
		}


		async function getPDFAsByteArray(data) {
    // Insert the template into the DOM
    document.body.insertAdjacentHTML('beforeend', pdfTemplateHTML);

    // Fill all dynamic fields
    fillPDFTemplate(data);

    // Show the template
    const template = document.getElementById("pdf-template");
    template.style.display = "block";

    // Adjust SVG dimensions to match container
    const svgElement = document.querySelector('#pdf-template svg');
    svgElement.setAttribute('width', '200');
    svgElement.setAttribute('height', '42');

    // Use html2canvas with options to ensure SVG is captured correctly
    const canvas = await html2canvas(template, {
        scale: 2, // Increase scale for better quality
        useCORS: true, // Enable CORS if loading external resources
        logging: true, // Enable logging for debugging
    });

    // Use jsPDF to generate the PDF
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF("p", "mm", "a4");
    const imgData = canvas.toDataURL("image/png");
    const imgWidth = 210; // A4 width in mm
    const imgHeight = (canvas.height * imgWidth) / canvas.width;

    // Add image to PDF with adjusted dimensions
    pdf.addImage(imgData, "PNG", 0, 0, imgWidth, imgHeight);

    // Remove the template from the DOM
    template.remove();

    // Return the PDF as a Uint8Array (Byte[])
    return pdf.output('arraybuffer');
}

		async function getPDFAsBase64(data) {
			// Insert the template into the DOM
			document.body.insertAdjacentHTML('beforeend', pdfTemplateHTML);

			// Fill all dynamic fields
			fillPDFTemplate(data);

			// Show the template
			const template = document.getElementById("pdf-template");
			template.style.display = "block";

			// Use html2canvas to capture the template
			const canvas = await html2canvas(template);

			// Use jsPDF to generate the PDF
			const { jsPDF } = window.jspdf;
			const pdf = new jsPDF("p", "mm", "a4");
			const imgData = canvas.toDataURL("image/png");
			const imgWidth = 210; // A4 width in mm
			const imgHeight = canvas.height * imgWidth / canvas.width;

			pdf.addImage(imgData, "PNG", 0, 0, imgWidth, imgHeight);

			// Remove the template from the DOM
			template.remove();

			// Return the PDF as a Base64 string
			return pdf.output('datauristring').split(',')[1]; // Extract the Base64 part
		}

			async function downloadGridExcel() {
		if (!probationRows.length) {
			round_error_noti("No data to export");
			return;
		}

		setBtnLoading('#exportExcelButton', 'Exporting...');

		try {
			const workbook = new ExcelJS.Workbook();
			const mainWorksheet = workbook.addWorksheet("Probation Data");

			const mainColumns = [
				{ header: 'Code', key: 'employeeCode', width: 14 },
				{ header: 'Employee Name', key: 'employeeName', width: 26 },
				{ header: 'Personal Email', key: 'personalEmailId', width: 28 },
				{ header: 'Status', key: 'statusName', width: 16 },
				{ header: 'Remarks Of Approver', key: 'remarksOfApprover', width: 28 },
				{ header: 'Reporting Manager', key: 'reportingManagerName', width: 24 },
				{ header: 'Manager Email', key: 'reportingManagerEmail', width: 28 },
				{ header: 'Current Level', key: 'currentLevelNo', width: 14 },
				{ header: 'Current Approver', key: 'currentApprover', width: 24 },
				{ header: 'Evaluation Days', key: 'probationEvaluationDays', width: 16 },
				{ header: 'Probation Due Date', key: 'probationDueDate', width: 18 },
				{ header: 'Probation End Date', key: 'probationEndDate', width: 18 },
				{ header: 'Date Of Joining', key: 'dateOfJoining', width: 18 },
				{ header: 'Action Date', key: 'actionDate', width: 16 },
				{ header: 'Mail Sent Status', key: 'isMailSentText', width: 16 }
			];
			mainWorksheet.columns = mainColumns;

			const usedWorksheetNames = new Set();
			usedWorksheetNames.add("Probation Data");

			probationRows.forEach(row => {
				mainWorksheet.addRow({
					employeeCode: row.employeeCode,
					employeeName: row.employeeName,
					personalEmailId: row.personalEmailId,
					statusName: row.statusName,
					remarksOfApprover: row.remarksOfApprover,
					reportingManagerName: row.reportingManagerName,
					reportingManagerEmail: row.reportingManagerEmail,
					currentLevelNo: row.currentLevelNo,
					currentApprover: row.currentApprover,
					probationEvaluationDays: row.probationEvaluationDays,
					probationDueDate: fmtDate(row.probationDueDate),
					probationEndDate: fmtDate(row.probationEndDate),
					dateOfJoining: fmtDate(row.dateOfJoining),
					actionDate: row.actionDate ? fmtDate(row.actionDate) : 'No Action',
					isMailSentText: row.isMailSent ? 'Yes' : 'No'
				});

				const approvalHistory = row.approvalHistory;
				if (approvalHistory && approvalHistory.length > 0) {
					// Generate a unique worksheet name
					let worksheetName = `History_${row.employeeCode}`;
					let counter = 1;

					while (usedWorksheetNames.has(worksheetName)) {
						worksheetName = `History_${row.employeeCode}_${counter}`;
						counter++;
					}
					usedWorksheetNames.add(worksheetName);

					const employeeHistoryWorksheet = workbook.addWorksheet(worksheetName);

					employeeHistoryWorksheet.columns = [
						{ header: "Level", key: "Level", width: 10 },
						{ header: "Status", key: "Status", width: 15 },
						{ header: "Approver", key: "Approver", width: 25 },
						{ header: "Remarks", key: "Remarks", width: 30 },
						{ header: "Assigned On", key: "AssignedOn", width: 15 },
						{ header: "Action On", key: "ActionOn", width: 15 },
						{ header: "Escalated On", key: "EscalatedOn", width: 15 },
					];

					const historyRows = approvalHistory.map(history => {
						const formatDate = (date) => {
							if (!date) return "";
							const utcDate = new Date(date);
							const day = String(utcDate.getUTCDate()).padStart(2, '0');
							const month = String(utcDate.getUTCMonth() + 1).padStart(2, '0');
							const year = String(utcDate.getUTCFullYear()).slice(-2);
							return `${day}-${month}-${year}`;
						};

						return {
							Level: history.historyLevelNo,
							Status: history.historyStatus,
							Approver: history.historyApproverName,
							Remarks: history.historyRemarksOfApprover,
							AssignedOn: formatDate(history.historyAssignedOn),
							ActionOn: formatDate(history.historyActionOn),
							EscalatedOn: formatDate(history.historyEscalatedOn),
						};
					});

					employeeHistoryWorksheet.addRows(historyRows);
				}
			});

			const buffer = await workbook.xlsx.writeBuffer();
			saveAs(new Blob([buffer]), "Probation_Data_With_History.xlsx");
		} catch (error) {
			console.error("Export error:", error);
			round_error_noti("Export failed. Check console for details.");
		} finally {
			setBtnNormal('#exportExcelButton', 'Export Excel');
		}
	}

</script>
