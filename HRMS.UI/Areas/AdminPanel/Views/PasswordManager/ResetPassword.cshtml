@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<style>
    .reset-pwd-card { max-width: 480px; margin: 0 auto; }
    /* Plain <input> elements don't auto-stretch to fill a flex parent the way
       .fg's direct children (input/select) do -- they need an explicit
       width:100% once wrapped in this position:relative icon container,
       otherwise they fall back to the browser's intrinsic ~20-character
       default width while the Employee dropdown (no wrapper) stretches full
       width, producing a visible width mismatch between fields. */
    .pwd-field-wrap { position: relative; width: 100%; }
    .pwd-field-wrap input { width: 100%; box-sizing: border-box; }
    .pwd-toggle { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #778899; cursor: pointer; }
    .pwd-toggle:hover { color: #2F6F8E; }
</style>

<div class="wms-form-page">
    <div class="card reset-pwd-card">
        <div class="card-header">
            <h6 class="mb-0">Reset Employee Password</h6>
        </div>
        <div class="card-body">

            <div class="fg fg-req">
                <label for="ddlEmployee">Employee</label>
                <select id="ddlEmployee" class="wms-no-dd" disabled>
                    <option value="">Loading employees...</option>
                </select>
                <span class="field-validation-error" id="spnEmployee" style="display:none;">Please select an employee.</span>
            </div>

            <div class="fg fg-req">
                <label for="newpassid">New Password</label>
                <div class="pwd-field-wrap">
                    <input type="password" id="newpassid" placeholder="Enter new password" value="Relay@123" autocomplete="off" style="padding-right:38px" />
                    <i class="bx bx-hide pwd-toggle" id="toggleNewPass"></i>
                </div>
                <span class="field-validation-error" id="spnNew" style="display:none;">Please enter new password.</span>
                <span class="field-validation-error" id="spnPattern" style="display:none;">Password must be at least 8 characters, include uppercase, lowercase, number and special character.</span>
            </div>

            <div class="fg fg-req">
                <label for="confirmpassid">Confirm Password</label>
                <div class="pwd-field-wrap">
                    <input type="password" id="confirmpassid" placeholder="Confirm new password" autocomplete="off" style="padding-right:38px" />
                    <i class="bx bx-hide pwd-toggle" id="toggleConfirmPass"></i>
                </div>
                <span class="field-validation-error" id="spnConfirm" style="display:none;">Please confirm password.</span>
                <span class="field-validation-error" id="spnMatch" style="display:none;">Passwords do not match.</span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2 pt-3" style="border-top:1px solid var(--hp-border,#e2e8f0)">
                <button type="button" id="btnResetPassword" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-reset"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Reset Password</span>
                </button>
            </div>

        </div>
    </div>
</div>

<script>

    const companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    function validatePasswordPattern(password) {
        const pattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
        return pattern.test(password);
    }

    function hideAllSpans() {
        $("#spnEmployee, #spnNew, #spnConfirm, #spnMatch, #spnPattern").hide();
    }

    $(document).ready(function () {
        bindEmployee();

        // Show/hide passwords
        $('#toggleNewPass, #toggleConfirmPass').on('click', function () {
            const input = $(this).siblings('input');
            const icon = $(this);

            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('bx-hide').addClass('bx-show');
            } else {
                input.attr('type', 'password');
                icon.removeClass('bx-show').addClass('bx-hide');
            }
        });

        $('#btnResetPassword').click(function () {
            hideAllSpans();
            const empId = $('#ddlEmployee').val();

            const newPassword = $('#newpassid').val();
            const confirmPassword = $('#confirmpassid').val();

            let isValid = true;

            if (!empId) {
                $("#spnEmployee").show();
                isValid = false;
            }

            if (!newPassword) {
                $("#spnNew").show();
                isValid = false;
            }

            if (!confirmPassword) {
                $("#spnConfirm").show();
                isValid = false;
            }

            if (newPassword && !validatePasswordPattern(newPassword)) {
                $("#spnPattern").show();
                isValid = false;
            }

            if (newPassword && confirmPassword && newPassword !== confirmPassword) {
                $("#spnMatch").show();
                isValid = false;
            }

            if (!isValid) return;

            setBtnLoading('#btnResetPassword', 'Resetting...');

            const payload = {
                UserId: EmployeeId,
                EmployeeId: empId,
                NewPassword: newPassword
            };

            $.ajax({
                url: '@baseUrl/PasswordHistoryAPI/ResetPassword',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage || 'Password reset successfully.', 'success');
                        ClearResetPassword();
                    } else {
                        showToast(response.responseMessage || 'Something went wrong.', 'error');
                    }
                    setBtnNormal('#btnResetPassword', 'Reset Password');
                },
                error: function () {
                    showToast('Something went wrong.', 'error');
                    setBtnNormal('#btnResetPassword', 'Reset Password');
                }
            });
        });
    });

    function ClearResetPassword() {
        const empEl = document.getElementById('ddlEmployee');
        if (empEl && empEl._wmsSetValue) { empEl._wmsSetValue(''); } else if (empEl) { empEl.value = ''; }

        $('#newpassid').val("Relay@123");
        $('#confirmpassid').val("");
        hideAllSpans();
    }

    // The WMS searchable-dropdown engine auto-builds its widget ~100ms after
    // DOMContentLoaded, independent of this page's own AJAX timing. If the
    // <select> were populated *after* that widget already exists, a later
    // option mutates the DOM tree -> the engine's MutationObserver wipes and
    // rebuilds the open panel's option list -> a click landing on an option
    // exactly then hits a destroyed node (the dropdown "blinks" and the
    // click never registers). Keeping #ddlEmployee opted out via the
    // "wms-no-dd" class + disabled until the employee list has fully loaded,
    // then building the widget once via the engine's manual entry point
    // (WmsSingleDropdown), removes that race entirely.
    function enableEmployeeDropdown() {
        var sel = document.getElementById('ddlEmployee');
        if (!sel) return;
        sel.disabled = false;
        sel.classList.remove('wms-no-dd');
        if (window.WmsSingleDropdown) WmsSingleDropdown(sel);
    }

    function bindEmployee() {
        $.ajax({
            url: '@baseUrl/EmployeeMasterAPI/GetAllEmployeeList/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var dropdown = $('#ddlEmployee');
                dropdown.empty();
                dropdown.append('<option value="">Select Employee</option>');
                if (response.isSuccess) {
                    $.each(response.data || [], function (index, emp) {
                        dropdown.append($('<option>', {
                            value: emp.EmployeeId,
                            text: emp.EmployeeName
                        }));
                    });
                }
                enableEmployeeDropdown();
            },
            error: function (error) {
                console.error('Error fetching employee data:', error);
                $('#ddlEmployee').empty().append('<option value="">Select Employee</option>');
                enableEmployeeDropdown();
            }
        });
    }

</script>
