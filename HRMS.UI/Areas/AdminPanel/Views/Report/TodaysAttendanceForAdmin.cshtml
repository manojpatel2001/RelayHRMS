@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Today's Attendance";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>Today's Attendance</title>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Today's Attendance</h6>
            <button type="button" class="btn btn-secondary btn-sm" onclick="goBack()">
                <i class="bx bx-arrow-back"></i> Back
            </button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 220px;min-width:200px;">
                    <label for="branchDropdown">Branch</label>
                    <select id="branchDropdown" multiple data-placeholder="--Select Branch--"></select>
                    <span id="spnbranch" class="field-validation-error" style="display:none;">Please Select Branch</span>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="shiftDropdown">Shift</label>
                    <select id="shiftDropdown">
                        <option value="">--Select Shift--</option>
                    </select>
                    <span id="spnshift" class="field-validation-error" style="display:none;">Please Select Shift</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerTodaysAttendance"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        const savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = JSON.parse(savedCompany);
        const CompanyId = companyDetails.CompanyId;
        const EmployeeId = localStorage.getItem('EmployeeId');
        const Token = localStorage.getItem("authToken");
        const baseUrl = '@baseUrl';
        const baseDomainUrl = '@baseDomainUrl';

        var grid = null;
        var isLoadingGo = false;

        function goBack() {
            window.location.href = '@Url.Action("Index", "Home", new { area = "AdminPanel" })';
        }
        window.goBack = goBack;

        $(document).ready(function () {
            BindBranchDropdown();
            BindShiftDropdown();

            $('#shiftDropdown').on('change', function () {
                $('#spnshift').hide();
                var selectedBranches = getSelectedBranchIds();
                if (selectedBranches && selectedBranches.length > 0) {
                    refreshAttendanceData();
                }
            });
        });

        function getSelectedBranchIds() {
            var val = $('#branchDropdown').val();
            if (!val) return [];
            return Array.isArray(val) ? val : [val];
        }

        function BindBranchDropdown() {
            $.ajax({
                url: baseUrl + '/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    if (response?.data?.length > 0) {
                        var $dd = $('#branchDropdown');
                        $dd.empty();
                        response.data.forEach(function (branch) {
                            $('<option>').val(branch.branchId).text(branch.branchName).appendTo($dd);
                        });
                    }
                },
                error: function () {
                    console.log("Error loading branches");
                }
            });
        }

        async function BindShiftDropdown() {
            try {
                const response = await fetchShiftData();
                if (response.isSuccess && response.data?.length > 0) {
                    var $dd = $('#shiftDropdown');
                    $dd.empty().append('<option value="">--Select Shift--</option>');
                    response.data.forEach(function (shift) {
                        $('<option>').val(shift.shiftID).text(shift.shiftName).appendTo($dd);
                    });
                }
            } catch (error) {
                console.log("Error loading shifts");
            }
        }

        async function fetchShiftData() {
            try {
                const response = await $.ajax({
                    type: "GET",
                    url: baseDomainUrl + '/api/ShiftMasterAPI/GetAllShifts',
                    headers: {
                        'Authorization': 'Bearer ' + Token
                    }
                });
                return response;
            } catch (error) {
                console.error("Error fetching shift data:", error);
                return { isSuccess: false, data: [] };
            }
        }

        async function fetchTodaysAttendance(branchIds, ShiftMasterId, CompanyId) {
            try {
                const branchIdsString = branchIds.join(',');

                const response = await $.ajax({
                    type: "GET",
                    url: `${baseDomainUrl}/api/EmpAttendanceAPI/GetTodaysAttendanceDashbord?BranchId=${branchIdsString}&ShiftMatserId=${ShiftMasterId}&CompanyId=${CompanyId}`,
                    headers: {
                        'Authorization': 'Bearer ' + Token
                    }
                });
                return response;
            } catch (error) {
                console.error("Error fetching attendance data:", error);
                return { isSuccess: false, ResponseMessage: "Error fetching data" };
            }
        }

        function renderGrid(data) {
            var columns = [
                { field: 'employeeCode', header: 'Code', width: '110px' },
                { field: 'fullName', header: 'Employee Name', width: '200px' },
                { field: 'branchName', header: 'Branch', width: '150px' },
                { field: 'shiftName', header: 'Shift', width: '130px' },
                { field: 'inTime', header: 'Check In', width: '120px' },
                { field: 'outTime', header: 'Check Out', width: '120px' },
                { field: 'attendanceStatus', header: 'Status', width: '130px' }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerTodaysAttendance',
                    title: "Today's Attendance",
                    icon: 'bx-calendar-check',
                    exportName: 'TodaysAttendance',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
            }
        }

        $('#btnGo').on('click', async function () {
            await refreshAttendanceData();
        });

        async function refreshAttendanceData() {
            if (isLoadingGo) return;

            var selectedBranches = getSelectedBranchIds();
            var selectedShift = $('#shiftDropdown').val();
            var isValid = true;

            // Branch is mandatory
            if (!selectedBranches || selectedBranches.length === 0) {
                $("#spnbranch").show();
                isValid = false;
            } else {
                $("#spnbranch").hide();
            }

            if (!isValid) {
                return;
            }

            isLoadingGo = true;
            setBtnLoading('#btnGo', 'Go');

            try {
                const branchIds = selectedBranches;
                const shiftId = selectedShift || 0;

                const response = await fetchTodaysAttendance(branchIds, shiftId, CompanyId);

                if (response.isSuccess && response.data) {
                    renderGrid(response.data);
                } else {
                    showToast(response.ResponseMessage || 'No attendance data found', 'info');
                    if (grid) { grid.setData([]); } else { renderGrid([]); }
                }
            } catch (error) {
                showToast('An error occurred while fetching data', 'error');
            } finally {
                isLoadingGo = false;
                setBtnNormal('#btnGo', 'Go');
            }
        }

        $("#btnClear").click(function () {
            $('#branchDropdown').val([]).trigger('change');
            $('#shiftDropdown').val('').trigger('change');

            if (grid) { grid.setData([]); }

            $("#spnbranch").hide();
            $("#spnshift").hide();
        });
    })();
</script>
