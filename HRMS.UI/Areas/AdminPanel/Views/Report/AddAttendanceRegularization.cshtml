     $('#btnSaveGridData').on('click', async function () {
         debugger;
        const gridInstance = $("#attendanceGrid").dxDataGrid("instance");
        gridInstance.saveEditData();
        const selectedRows = gridInstance.getSelectedRowsData();

        if (selectedRows.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select at least one row to save.'
            });
            return;
        }

        const empId = $('#employeeDropdown').val();
        if (!empId) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select an employee.'
            });
            return;
        }

        const validRows = [];
        const missingReasonRows = [];
        const missingDayTypeRows = [];
        const missingRemarkRows = [];
        const timeWindowErrorRows = [];
        const remarksRequiredReasons = ['client visit', 'travel on duty', 'official od', 'other' ,'forgot to punch/sign' ,'working from home' ,'declared customer holiday','training',
     'late coming','early leaving'];

        for (let row of selectedRows) {
            const reasonId = row.reasonId;
            const dayType = row.dayType?.trim();
            const dateStr = new Date(row.shiftDate).toLocaleDateString('en-GB');

            // Validate reason
            if (!reasonId) {
                missingReasonRows.push(dateStr);
                continue;
            }

            // Validate day type
            if (!dayType) {
                missingDayTypeRows.push(dateStr);
                continue;
            }

            const selectedReason = approvalReasons.find(r => r.reasonId === reasonId);

            // Validate remark for specific reasons
            if (selectedReason) {
                const reasonText = selectedReason.reason.toLowerCase();

                // Check if remark is required and missing
                if (remarksRequiredReasons.includes(reasonText)) {
                    if (!row.remark || row.remark.trim() === "") {
                        missingRemarkRows.push(dateStr);
                        continue;
                    }
                }

                // Check Travel on Duty time window for current date
                if (reasonText === "travel on duty") {
                    const recordDate = new Date(row.shiftDate);
                    const currentDate = new Date();
                    recordDate.setHours(0, 0, 0, 0);
                    currentDate.setHours(0, 0, 0, 0);

                    // If it's current date, validate time window
                    if (recordDate.getTime() === currentDate.getTime()) {
                        const now = new Date();
                        const currentTime = now.getHours() * 60 + now.getMinutes();

                        let shiftStartTime = null;
                        let shiftEndTime = null;

                        if (row.shiftTime) {
                            const shiftParts = row.shiftTime.split('-');
                            if (shiftParts.length === 2) {
                                // Parse start time
                                const startStr = shiftParts[0].trim();
                                const startMatch = startStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                                if (startMatch) {
                                    let hours = parseInt(startMatch[1]);
                                    const minutes = parseInt(startMatch[2]);
                                    const period = startMatch[3].toUpperCase();

                                    if (period === 'PM' && hours !== 12) hours += 12;
                                    if (period === 'AM' && hours === 12) hours = 0;

                                    shiftStartTime = hours * 60 + minutes;
                                }

                                // Parse end time
                                const endStr = shiftParts[1].trim();
                                const endMatch = endStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                                if (endMatch) {
                                    let hours = parseInt(endMatch[1]);
                                    const minutes = parseInt(endMatch[2]);
                                    const period = endMatch[3].toUpperCase();

                                    if (period === 'PM' && hours !== 12) hours += 12;
                                    if (period === 'AM' && hours === 12) hours = 0;

                                    shiftEndTime = hours * 60 + minutes;
                                }
                            }
                        }

                        if (shiftStartTime !== null && shiftEndTime !== null) {
                            const allowedStartTime = shiftStartTime - 15;
                            const allowedEndTime = shiftEndTime;

                            if (currentTime < allowedStartTime || currentTime > allowedEndTime) {
                                timeWindowErrorRows.push(dateStr);
                                continue;
                            }
                        }
                    }
                }
            }

            validRows.push({
                EmpId: empId,
                FullName: row.fullName || "",
                BranchName: row.branchName || "",
                ForDate: row.shiftDate,
                ShiftTime: row.shiftTime || "",
                InTime: (row.inTime && row.inTime !== "-") ? formatToISOString(row.inTime) : null,
                OutTime: (row.outTime && row.outTime !== "-") ? formatToISOString(row.outTime) : null,
                Day: dayType,
                Status: row.attendanceStatus || "",
                Reason: reasonId.toString(),
                Remark: row.remark || null,
                IsApproved: false,
                IsPending: true,
                IsRejected: false,
                IsLocked: false,
                CreatedBy: EmployeeId
            });
        }

        // Show validation errors
        if (missingReasonRows.length > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Reason Required',
                html: `Please select reason for:<br><strong>${missingReasonRows.join(', ')}</strong>`
            });
            return;
        }

        if (missingDayTypeRows.length > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Day Type Required',
                html: `Please select day type for:<br><strong>${missingDayTypeRows.join(', ')}</strong>`
            });
            return;
        }

        if (missingRemarkRows.length > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Remark Required',
                html: `Please enter remark for:<br><strong>${missingRemarkRows.join(', ')}</strong>`
            });
            return;
        }

        if (timeWindowErrorRows.length > 0) {
            Swal.fire({
                icon: 'error',
                title: 'Time Window Restriction',
                html: `Travel on Duty request for today can only be submitted from 15 minutes before shift start till shift end time.<br><br>Dates: <strong>${timeWindowErrorRows.join(', ')}</strong>`,
                confirmButtonText: 'OK'
            });
            return;
        }

        if (validRows.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please complete all required fields.'
            });
            return;
        }

        // Get month/year
        const monthYearData = await getYearMonth();
        if (!monthYearData) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: 'Please select a valid month and year.'
            });
            return;
        }

        const selectedMonth = monthYearData.month;
        const selectedYear = monthYearData.year;

        // Validate attendance request limit
        const isLimitValid = await validateAttendanceRequestLimit(
            empId,
            validRows,
            selectedMonth,
            selectedYear
        );

        if (!isLimitValid) {
            return;
        }

        showLoder();    

        // Save via AJAX
        $.ajax({
             url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/CreateAttendanceRegularization")',
            type: "POST",
            contentType: "application/json",
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            data: JSON.stringify(validRows),
            success: function (response) {
                hideLoder();
                if (response?.isSuccess) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.responseMessage || "Saved successfully.",
                        timer: 2000
                    });

                    // Refresh grid
                    const gridInstance = $("#attendanceGrid").dxDataGrid("instance");
                    const selectedRowsData = gridInstance.getSelectedRowsData();
                    let currentData = gridInstance.option("dataSource");
                    const updatedData = currentData.filter(item => {
                        return !selectedRowsData.some(sel =>
                            sel.empId === item.empId &&
                            new Date(sel.shiftDate).toISOString() === new Date(item.shiftDate).toISOString()
                        );
                    });
                    gridInstance.option("dataSource", updatedData);
                    gridInstance.refresh();
                    gridInstance.clearSelection();

                    $("#btnGo").trigger("click");
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Save Failed',
                        text: response?.responseMessage || "Unknown error"
                    });
                }
            },
            error: function (xhr) {
                hideLoder();
                Swal.fire({
                    icon: 'error',
                    title: 'Server Error',
                    text: xhr.status + " - " + xhr.statusText
                });
            }
        });
    });


        function LoadReasonConfiguration() {
        $.ajax({
             url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/GetAttendanceReasonsByLimitType")',
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess && response.data && response.data.length > 0) {

                    limitedReasonIds = response.data
                        .filter(r => r.reasonType === "Limited")
                        .map(r => r.reasonId.toString());

                    unlimitedReasonIds = response.data
                        .filter(r => r.reasonType === "Unlimited")
                        .map(r => r.reasonId.toString());


                } else {
                    console.warn("⚠️ No reason configuration found from API");
                    limitedReasonIds = [];
                    unlimitedReasonIds = [];
                }
            },
            error: function (error) {
                console.error('❌ Failed to load reason configuration:', error);
                limitedReasonIds = [];
                unlimitedReasonIds = [];
            }
        });
    }

       async function validateAttendanceRequestLimit(EmployeeId, selectedRows, selectedMonth, selectedYear) {
        try {
            // CRITICAL: Wait for reason configuration to load
            if (limitedReasonIds.length === 0 && unlimitedReasonIds.length === 0) {
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (limitedReasonIds.length === 0 && unlimitedReasonIds.length === 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Configuration Error',
                        text: 'Reason configuration not loaded. Please refresh the page and try again.'
                    });
                    return false;
                }
            }

            // Debug each row
            selectedRows.forEach((row, index) => {
                console.log(`Row ${index}:`, {
                    Reason: row.Reason,
                    reasonId: row.reasonId,
                    ForDate: row.ForDate,
                    availableFields: Object.keys(row)
                });
            });

            const limitedRowCount = selectedRows.filter(row => {
                const reasonStr = (row.Reason || row.reasonId)?.toString() || "";
