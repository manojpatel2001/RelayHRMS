@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Add Attendance Regularization";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>

    .flatpickr-time {
        font-size: 12px !important;
    }

        .flatpickr-time input {
            height: 24px !important;
            font-size: 12px !important;
        }

    /* Inline-editable cells inside the WMSGrid attendance grid */
    .att-cell-input, .att-cell-select {
        width: 100%;
        min-width: 110px;
        padding: 5px 6px;
        font-size: 12px;
        border: 1px solid #CBD5E1;
        border-radius: 5px;
        font-family: inherit;
        color: var(--wg-text, #1A1A1A);
        background: #fff;
    }

    .att-cell-input:disabled, .att-cell-select:disabled {
        background: #F1F5F9;
        color: #94A3B8;
        cursor: not-allowed;
    }

    .att-status-text {
        font-weight: 700;
        text-align: center;
        display: block;
    }

    .att-time-box {
        display: inline-block;
        text-align: center;
        border: 1px solid #ddd;
        padding: 5px 8px;
        border-radius: 4px;
        background: #f5f5f5;
        font-size: 12px;
    }

</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Employee Attendance Regularization Request</h6>
            <a href="@Url.Action("AttendanceRegularization", "Report")" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-arrow-back"></i> Back
            </a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>

            <div class="form-check mb-2">
                <input type="checkbox" class="form-check-input" id="chkBetween" />
                <label class="form-check-label" for="chkBetween">Between Date Range</label>
            </div>

            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" id="yearField" style="flex:1 1 130px;min-width:120px;">
                    <label for="year">Year</label>
                    <select id="year"></select>
                    <span class="field-validation-error" id="yearError" style="display:none;">Please select Year.</span>
                </div>

                <div class="fg fg-req" id="monthField" style="flex:1 1 150px;min-width:140px;">
                    <label for="month">Month</label>
                    <select id="month">
                        <option value="">--Select--</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                    <span class="field-validation-error" id="monthError" style="display:none;">Please select Month.</span>
                </div>

                <div class="fg fg-req d-none" id="startDateField" style="flex:1 1 150px;min-width:140px;">
                    <label for="startDate">Start Date</label>
                    <input type="text" id="startDate" placeholder="Select Date" />
                    <span class="field-validation-error" id="startDateError" style="display:none;">Please select Start Date.</span>
                </div>

                <div class="fg fg-req d-none" id="endDateField" style="flex:1 1 150px;min-width:140px;">
                    <label for="endDate">End Date</label>
                    <input type="text" id="endDate" placeholder="Select Date" />
                    <span class="field-validation-error" id="endDateError" style="display:none;">Please select End Date.</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 170px;min-width:160px;">
                    <label for="branch">Branch</label>
                    <select id="branch">
                        <option value="" selected disabled>Select Branch</option>
                    </select>
                    <span class="field-validation-error" id="branchError" style="display:none;">Please select Branch.</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 190px;min-width:170px;">
                    <label for="employeeDropdown">Employee</label>
                    <select id="employeeDropdown">
                        <option value="" selected disabled>Select Employee</option>
                    </select>
                    <span class="field-validation-error" id="employeeError" style="display:none;">Please select Employee.</span>
                </div>

                <div class="fg" style="flex:1 1 150px;min-width:140px;">
                    <label for="recordtype">Record Type</label>
                    <select id="recordtype">
                        <option value="All">All</option>
                        <option value="P">Present</option>
                        <option value="A">Absent</option>
                    </select>
                    <span class="field-validation-error" id="recordTypeError" style="display:none;">Please select Record Type.</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <span class="btn-spinner-icon"></span>
                        <i class="bx bx-search"></i>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div id="attendanceSummary" class="d-flex flex-wrap gap-2" style="margin-top:14px;"></div>

    <div class="card" id="attendanceSection" style="margin-top:14px; display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Attendance Details</h6>
            <div id="saveButtonContainer" style="display:none;">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveGridData">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="attendanceGridContainer"></div>
        </div>
    </div>

</div>

<script>

    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");
    var approvalReasons = [];
    var limitedReasonIds = [];
    var unlimitedReasonIds = [];

    var attendanceGrid = null;
    var selectedShiftDates = {};
    var isGoLoading = false;
    var isSavingGrid = false;

    function fillSelect(id, data, valueKey, textKey, placeholder) {
        var el = document.getElementById(id);
        if (!el) return;
        el.innerHTML = '';
        var ph = document.createElement('option');
        ph.value = '';
        ph.textContent = placeholder || 'Select';
        ph.disabled = true;
        ph.selected = true;
        el.appendChild(ph);
        (data || []).forEach(function (d) {
            var o = document.createElement('option');
            o.value = d[valueKey];
            o.textContent = d[textKey] || '';
            el.appendChild(o);
        });
    }

    $(document).ready(function () {
        BindBranchDropdown();
        populateYearDropdown();
        initializeDatePickers();
        LoadReasonConfiguration();
        setupDateRangeToggle();
        LoadApprovalReasons();
        LoadReasonConfiguration();

        $("#attendanceSummary").hide();

        // Set default values
        const currentYear = new Date().getFullYear();
        const currentMonth = new Date().getMonth() + 1;
        $('#year').val(currentYear);
        $('#month').val(currentMonth);

        // Remove future months
        removeFutureMonths();
    });

    function LoadApprovalReasons() {
        $.ajax({
            url: '@(baseDomainUrl + "/api/CommonReasonsAPI/GetcancellationReasons")',
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess && response.data) {
                    approvalReasons = response.data;
                } else {
                    approvalReasons = [];
                }
            },
            error: function (error) {
                console.error('Failed to load approval reasons:', error);
                approvalReasons = [];
            }
        });
    }

    function LoadReasonConfiguration() {
        $.ajax({
            url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/GetAttendanceReasonsByLimitType")',
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess && response.data && response.data.length > 0) {

                    limitedReasonIds = response.data
                        .filter(r => r.reasonType === "Limited")
                        .map(r => r.reasonId.toString());

                    unlimitedReasonIds = response.data
                        .filter(r => r.reasonType === "Unlimited")
                        .map(r => r.reasonId.toString());

                } else {
                    console.warn("No reason configuration found from API");
                    limitedReasonIds = [];
                    unlimitedReasonIds = [];
                }
            },
            error: function (error) {
                console.error('Failed to load reason configuration:', error);
                limitedReasonIds = [];
                unlimitedReasonIds = [];
            }
        });
    }

    function initializeDatePickers() {
        flatpickr("#startDate", {
            dateFormat: "d/m/Y",
            maxDate: "today"
        });

        flatpickr("#endDate", {
            dateFormat: "d/m/Y",
            maxDate: "today"
        });
    }

    function setupDateRangeToggle() {
        $('#chkBetween').on('change', function () {
            if ($(this).is(':checked')) {
                // Hide Month/Year, Show Date Range
                $('#monthField, #yearField').addClass('d-none');
                $('#startDateField, #endDateField').removeClass('d-none');

                // Clear Month/Year errors
                $('#monthError, #yearError').hide();
            } else {
                // Hide Date Range, Show Month/Year
                $('#startDateField, #endDateField').addClass('d-none');
                $('#monthField, #yearField').removeClass('d-none');

                // Clear Date Range errors
                $('#startDateError, #endDateError').hide();
            }
        });
    }

    function removeFutureMonths() {
        const currentMonth = new Date().getMonth() + 1; // 1 for January
        const currentYear = new Date().getFullYear();
        const selectedYear = parseInt($('#year').val());

        $('#month option').each(function () {
            const monthValue = parseInt($(this).val());

            // Skip the default "--Select--" option
            if ($(this).val() === "") {
                return;
            }

            // If selected year is current year
            if (selectedYear === currentYear) {
                // Remove months greater than current month
                if (monthValue > currentMonth) {
                    $(this).remove();
                }
            }
            // If selected year is previous year, keep all months
        });
    }

    // Handle year change to refresh month options
    $('#year').on('change', function() {
        const currentYear = new Date().getFullYear();
        const selectedYear = parseInt($(this).val());

        // Reset month dropdown to show all months
        $('#month').html(`
            <option value="">--Select--</option>
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        `);

        // If current year is selected, remove future months
        if (selectedYear === currentYear) {
            removeFutureMonths();
        }
        // If previous year is selected, all months remain visible
    });

    async function BindBranchDropdown() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@(baseDomainUrl + "/api/BranchAPI/GetAllBranchesListByCompanyId/")' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (data) {
                    if (data.isSuccess) {
                        fillSelect('branch', data.data, 'branchId', 'branchName', 'Select Branch');
                        resolve(data.data);
                    } else {
                        console.error('Branch API returned error:', data);
                        reject('Failed to fetch branches');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Branch API Error:', xhr.status, xhr.responseText);
                    reject(error);
                }
            });
        });
    }

    $('#branch').on('change', function () {
        GetEmployeeByBranchId(this.value);
    });

    async function GetEmployeeByBranchId(branchId) {
        if(!branchId) {
            fillSelect('employeeDropdown', [], 'employeeId', 'employeeName', 'Select Employee');
            return Promise.resolve([]);
        }
        var payLoad = {
            BranchId: branchId,
            CompanyId: CompanyId
        }
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@(baseDomainUrl + "/api/EmployeeMasterAPI/GetEmployeeListByBranchId")',
                method: 'POST',
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                data: JSON.stringify(payLoad),
                success: function (data) {
                    if (data.isSuccess) {
                        fillSelect('employeeDropdown', data.data, 'employeeId', 'employeeName', 'Select Employee');
                        resolve(data.data);
                    } else {
                        console.error('Employee API returned error:', data);
                        reject('Failed to fetch employees');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Employee API Error:', xhr.status, xhr.responseText);
                    reject(error);
                }
            });
        });
    }

    function populateYearDropdown() {
        const startYear = 2024;
        const currentYear = new Date().getFullYear();
        const yearDropdown = $("#year");
        yearDropdown.empty();
        yearDropdown.append('<option value="">--Select--</option>');
        for (let year = currentYear; year >= startYear; year--) {
            yearDropdown.append(`<option value="${year}">${year}</option>`);
        }
    }

    function GetEmployeeById() {
        var empId = $("#employeeDropdown").val();
        return $.ajax({
            type: "GET",
            url: '@baseDomainUrl/api/EmployeeMasterAPI/GetEmployeeById/' + empId,
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (data) {
                if (data.isSuccess && data.data) {
                    // Employee data loaded
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX Error: " + status + " - " + error);
            }
        });
    }

    function clearValidationErrors() {
        $('.field-validation-error').hide();
    }

    function getDateRange() {
        const isDateRange = $('#chkBetween').is(':checked');

        if (isDateRange) {
            // Use Start Date and End Date
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            if (startDate && endDate) {
                // Convert dd/mm/yyyy to yyyy-mm-dd
                const startParts = startDate.split('/');
                const endParts = endDate.split('/');

                return {
                    startDate: `${startParts[2]}-${startParts[1].padStart(2, '0')}-${startParts[0].padStart(2, '0')}`,
                    endDate: `${endParts[2]}-${endParts[1].padStart(2, '0')}-${endParts[0].padStart(2, '0')}`
                };
            }
        } else {
            // Use Month and Year
            const month = $('#month').val();
            const year = $('#year').val();

            if (month && year) {
                const monthStr = month.padStart(2, '0');
                const startDate = `${year}-${monthStr}-01`;
                const lastDay = new Date(year, month, 0).getDate();
                const endDate = `${year}-${monthStr}-${lastDay.toString().padStart(2, '0')}`;

                return { startDate, endDate };
            }
        }

        return null;
    }

    function validateForm() {
        clearValidationErrors();
        let hasError = false;

        const branch = $('#branch').val();
        const emp = $('#employeeDropdown').val();
        const record = $('#recordtype').val();
        const isDateRange = $('#chkBetween').is(':checked');

        if (!branch) {
            $('#branchError').text("Please select Branch.").show();
            hasError = true;
        }
        // Employee validation
        if (!emp) {
            $('#employeeError').text("Please select Employee.").show();
            hasError = true;
        }

        // Record type validation
        if (!record) {
            $('#recordTypeError').text("Please select Record Type.").show();
            hasError = true;
        }

        if (isDateRange) {
            // Date range validation
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            if (!startDate) {
                $('#startDateError').text("Please select Start Date.").show();
                hasError = true;
            }
            if (!endDate) {
                $('#endDateError').text("Please select End Date.").show();
                hasError = true;
            }

            if (startDate && endDate) {
                const start = new Date(startDate.split('/').reverse().join('-'));
                const end = new Date(endDate.split('/').reverse().join('-'));

                if (start > end) {
                    $('#endDateError').text("End Date must be greater than or equal to Start Date.").show();
                    hasError = true;
                }
            }
        } else {
            // Month/Year validation
            const year = $('#year').val();
            const month = $('#month').val();

            if (!year) {
                $('#yearError').text("Please select Year.").show();
                hasError = true;
            }
            if (!month) {
                $('#monthError').text("Please select Month.").show();
                hasError = true;
            }
        }

        return !hasError;
    }

    // Go Button Click Event
    $('#btnGo').on('click', function () {
        if (isGoLoading) return;

        if (!validateForm()) {
            return;
        }
        const emp = $('#employeeDropdown').val();
        const record = $('#recordtype').val();
        const dateRange = getDateRange();

        if (!dateRange) {
            showToast("Please provide a valid date range.", "warn");
            return;
        }

        isGoLoading = true;
        setBtnLoading('#btnGo', 'Go');

        // Check joining date before proceeding
        GetEmployeeById().done(function (data) {
            if (data.isSuccess && data.data) {
                let joiningDate = new Date(data.data.dateOfJoining);
                let selectedStartDate = new Date(dateRange.startDate);
                let formattedJoiningDate = joiningDate.toLocaleDateString('en-GB');

                if (selectedStartDate < joiningDate) {
                    isGoLoading = false;
                    setBtnNormal('#btnGo', 'Go');
                    showToast(`Attendance Regularisation is only allowed from ${formattedJoiningDate}.`, "warn");
                    return;
                }

                // Proceed with AJAX
                const formData = new FormData();
                formData.append("EmpId", emp);
                formData.append("StartDate", dateRange.startDate);
                formData.append("EndDate", dateRange.endDate);
                formData.append("RecordType", record);

                $.ajax({
                    url: '@(baseDomainUrl + "/api/EmployeeInOut/GetEmployeeInOutReport")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response?.isSuccess) {
                            if (response.data && response.data.length > 0) {
                                $("#attendanceSummary").show();
                                showAttendanceSummary(response.data);
                                // #attendanceGridContainer lives inside #attendanceSection,
                                // which starts display:none — .show() it BEFORE building the
                                // grid, not after. WMSGrid.create() measures the container's
                                // width while building (for column sizing), and a hidden
                                // ancestor makes that measurement 0, silently rendering no
                                // rows even though real data was passed in; showing the
                                // section afterward doesn't retroactively fix it.
                                $("#saveButtonContainer").show();
                                $("#attendanceSection").show();
                                LoadAttendanceGrid(response.data);
                            } else {
                                var emptyData = [];
                                LoadAttendanceGrid(emptyData);
                                $("#attendanceSummary").hide();
                                $("#saveButtonContainer").hide();
                                $("#attendanceSection").hide();
                            }
                        } else {
                            showToast(response.responseMessage || "No data found.", "info");
                            $("#attendanceSummary").hide();
                            $("#saveButtonContainer").hide();
                            $("#attendanceSection").hide();
                        }
                    },
                    error: function (xhr, status, error) {
                        showToast("Something went wrong while fetching data. Error: " + error, "error");
                    },
                    complete: function () {
                        isGoLoading = false;
                        setBtnNormal('#btnGo', 'Go');
                    }
                });
            } else {
                isGoLoading = false;
                setBtnNormal('#btnGo', 'Go');
            }
        }).fail(function () {
            isGoLoading = false;
            setBtnNormal('#btnGo', 'Go');
        });
    });

    // Clear Button Click Event
    $('#btnClear').on('click', function () {
        // Reset form fields
        $('#month').val('');
        $('#year').val('');
        $('#startDate').val('');
        $('#endDate').val('');
        $('#recordtype').val('All');
        fillSelect('branch', [], 'branchId', 'branchName', 'Select Branch');
        fillSelect('employeeDropdown', [], 'employeeId', 'employeeName', 'Select Employee');
        BindBranchDropdown();
        $('#chkBetween').prop('checked', false);

        // Reset visibility
        $('#startDateField, #endDateField').addClass('d-none');
        $('#monthField, #yearField').removeClass('d-none');

        clearValidationErrors();

        $("#saveButtonContainer").hide();
        $("#attendanceSection").hide();
        $("#attendanceSummary").hide();

        selectedShiftDates = {};
        if (attendanceGrid) {
            attendanceGrid.setData([]);
        }
    });

    function showAttendanceSummary(data) {
        let counts = {
            P: 0, // Present
            A: 0, // Absent
            W: 0, // Week-off
            H: 0   // Holiday
        };

        data.forEach(row => {
            const status = row.attendanceStatus?.trim().toUpperCase();
            if (status === "P") counts.P++;
            else if (status === "A") counts.A++;
            else if (status === "W") counts.W++;
            else if (status === "H") counts.H++;

            if (row.lateDeductionDays && row.lateDeductionDays > 0) {
                counts.Late += row.lateDeductionDays;
            }
        });

        const total = data.length;

        $("#attendanceSummary").html(`
            <span class="wg-pill wg-pill-green">Present : ${counts.P}</span>
            <span class="wg-pill wg-pill-red">Absent : ${counts.A}</span>
            <span class="wg-pill wg-pill-pu">Week-off : ${counts.W}</span>
            <span class="wg-pill wg-pill-blue">Holiday : ${counts.H}</span>
            <span class="wg-pill wg-pill-amber">Total : ${total}</span>
        `);
    }

    function formatToISOString(dateStr) {
        const date = new Date(dateStr);
        return !isNaN(date) ? date.toISOString() : null;
    }

    async function getYearMonth() {
        const isDateRange = $('#chkBetween').is(':checked');

        if (isDateRange) {
            const startDate = $('#startDate').val();
            if (startDate) {
                const startParts = startDate.split('/');
                return {
                    year: startParts[2],
                    month: startParts[1].padStart(2, '0')
                };
            }
        } else {
            const month = $('#month').val();
            const year = $('#year').val();
            if (month && year) {
                return {
                    year: year,
                    month: month.padStart(2, '0')
                };
            }
        }
        return null;
    }

    async function validateAttendanceRequestLimit(EmployeeId, selectedRows, selectedMonth, selectedYear) {
        try {
            // CRITICAL: Wait for reason configuration to load
            if (limitedReasonIds.length === 0 && unlimitedReasonIds.length === 0) {
                await new Promise(resolve => setTimeout(resolve, 1500));

                if (limitedReasonIds.length === 0 && unlimitedReasonIds.length === 0) {
                    showToast('Reason configuration not loaded. Please refresh the page and try again.', 'error');
                    return false;
                }
            }

            const limitedRowCount = selectedRows.filter(row => {
                const reasonStr = (row.Reason || row.reasonId)?.toString() || "";
                const isLimited = limitedReasonIds.includes(reasonStr);
                return isLimited;
            }).length;

            const unlimitedRowCount = selectedRows.filter(row => {
                const reasonStr = (row.Reason || row.reasonId)?.toString() || "";
                const isUnlimited = unlimitedReasonIds.includes(reasonStr);
                return isUnlimited;
            }).length;

            // Calculate unmatched (reasons not in either array)
            const unmatchedCount = selectedRows.length - (limitedRowCount + unlimitedRowCount);

            // If there are unmatched reasons, show error
            if (unmatchedCount > 0) {
                const unmatchedReasons = selectedRows.filter(row => {
                    const reasonStr = (row.Reason || row.reasonId)?.toString() || "";
                    return !limitedReasonIds.includes(reasonStr) && !unlimitedReasonIds.includes(reasonStr);
                }).map(row => {
                    const reasonStr = (row.Reason || row.reasonId)?.toString() || "";
                    const reasonName = approvalReasons.find(r => r.reasonId.toString() === reasonStr);
                    return reasonName ? reasonName.reason : `Unknown (ID: ${reasonStr})`;
                });

                showToast('Some selected reasons are not properly configured: ' + [...new Set(unmatchedReasons)].join(', '), 'error');
                return false;
            }

            // If all selected rows have unlimited reasons, bypass limit check
            if (limitedRowCount === 0 && unlimitedRowCount > 0) {
                return true;
            }

            // If no valid reasons selected
            if (limitedRowCount === 0 && unlimitedRowCount === 0) {
                showToast('Please select valid reasons for all selected rows.', 'warn');
                return false;
            }

            // Only proceed with limit check if there are LIMITED reasons
            if (limitedRowCount > 0) {
                // Get employee monthly limit
                const employeeDetails = await $.ajax({
                    type: "GET",
                    url:   "@baseDomainUrl/api/AttendanceRegularizationAPI/GetEmployeeDetails?EmpId=" + EmployeeId,
                    headers: {
                        'Authorization': 'Bearer ' + Token
                    }
                });

                // Get request count for the selected month/year
                const currentMonthCount = await $.ajax({
                    type: "GET",
                    url:  "@baseDomainUrl/api/AttendanceRegularizationAPI/GetEmployeeAttendanceRequestsCountForCurrentMonth?" +
                         `EmpId=${EmployeeId}&month=${selectedMonth}&year=${selectedYear}`,
                    headers: {
                        'Authorization': 'Bearer ' + Token
                    }
                });

                if (!employeeDetails?.isSuccess || !currentMonthCount?.isSuccess) {
                    showToast('Unable to fetch employee request limit details.', 'error');
                    return false;
                }

                const monthlyLimit = employeeDetails.data?.[0]?.attendanceLimit || 0;

                const currentLimitedRequests = currentMonthCount.data?.[0]?.limitedRequestsCount || 0;
                const currentUnlimitedRequests = currentMonthCount.data?.[0]?.unlimitedRequestsCount || 0;

                const totalLimitedRequests = currentLimitedRequests + limitedRowCount;

                // If no limit is set, block submission for limited reasons
                if (monthlyLimit === 0) {
                    showToast('No monthly limit is set for your account. Please contact HR to configure your attendance limit.', 'error');
                    return false;
                }

                // Check if limit exceeded (only for limited reasons)
                if (totalLimitedRequests > monthlyLimit) {
                    const exceededBy = totalLimitedRequests - monthlyLimit;
                    const remainingLimit = Math.max(0, monthlyLimit - currentLimitedRequests);

                    showToast(
                        `Monthly limit exceeded by ${exceededBy} request(s). Limit: ${monthlyLimit}, Already submitted: ${currentLimitedRequests}, Attempting: ${limitedRowCount}, Remaining: ${remainingLimit}.`,
                        'error'
                    );
                    return false;
                }
            }

            return true;

        } catch (error) {
            console.error("Error validating request limit:", error);
            showToast('An error occurred: ' + error.message, 'error');
            return false;
        }
    }

    $('#btnSaveGridData').on('click', async function () {
        if (isSavingGrid) return;

        const selectedRows = attendanceGrid ? attendanceGrid.getData().filter(function (r) {
            return !!selectedShiftDates[r.shiftDate];
        }) : [];

        if (selectedRows.length === 0) {
            showToast('Please select at least one row to save.', 'warn');
            return;
        }

        const empId = $('#employeeDropdown').val();
        if (!empId) {
            showToast('Please select an employee.', 'warn');
            return;
        }

        const validRows = [];
        const missingReasonRows = [];
        const missingDayTypeRows = [];
        const missingRemarkRows = [];
        const timeWindowErrorRows = [];
        const remarksRequiredReasons = ['client visit', 'travel on duty', 'official od', 'other' ,'forgot to punch/sign' ,'working from home' ,'declared customer holiday','training',
     'late coming','early leaving'];

        for (let row of selectedRows) {
            const reasonId = row.reasonId;
            const dayType = row.dayType?.trim();
            const dateStr = new Date(row.shiftDate).toLocaleDateString('en-GB');

            // Validate reason
            if (!reasonId) {
                missingReasonRows.push(dateStr);
                continue;
            }

            // Validate day type
            if (!dayType) {
                missingDayTypeRows.push(dateStr);
                continue;
            }

            const selectedReason = approvalReasons.find(r => r.reasonId === reasonId);

            // Validate remark for specific reasons
            if (selectedReason) {
                const reasonText = selectedReason.reason.toLowerCase();

                // Check if remark is required and missing
                if (remarksRequiredReasons.includes(reasonText)) {
                    if (!row.remark || row.remark.trim() === "") {
                        missingRemarkRows.push(dateStr);
                        continue;
                    }
                }

                // Check Travel on Duty time window for current date
                if (reasonText === "travel on duty") {
                    const recordDate = new Date(row.shiftDate);
                    const currentDate = new Date();
                    recordDate.setHours(0, 0, 0, 0);
                    currentDate.setHours(0, 0, 0, 0);

                    // If it's current date, validate time window
                    if (recordDate.getTime() === currentDate.getTime()) {
                        const now = new Date();
                        const currentTime = now.getHours() * 60 + now.getMinutes();

                        let shiftStartTime = null;
                        let shiftEndTime = null;

                        if (row.shiftTime) {
                            const shiftParts = row.shiftTime.split('-');
                            if (shiftParts.length === 2) {
                                // Parse start time
                                const startStr = shiftParts[0].trim();
                                const startMatch = startStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                                if (startMatch) {
                                    let hours = parseInt(startMatch[1]);
                                    const minutes = parseInt(startMatch[2]);
                                    const period = startMatch[3].toUpperCase();

                                    if (period === 'PM' && hours !== 12) hours += 12;
                                    if (period === 'AM' && hours === 12) hours = 0;

                                    shiftStartTime = hours * 60 + minutes;
                                }

                                // Parse end time
                                const endStr = shiftParts[1].trim();
                                const endMatch = endStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                                if (endMatch) {
                                    let hours = parseInt(endMatch[1]);
                                    const minutes = parseInt(endMatch[2]);
                                    const period = endMatch[3].toUpperCase();

                                    if (period === 'PM' && hours !== 12) hours += 12;
                                    if (period === 'AM' && hours === 12) hours = 0;

                                    shiftEndTime = hours * 60 + minutes;
                                }
                            }
                        }

                        if (shiftStartTime !== null && shiftEndTime !== null) {
                            const allowedStartTime = shiftStartTime - 15;
                            const allowedEndTime = shiftEndTime;

                            if (currentTime < allowedStartTime || currentTime > allowedEndTime) {
                                timeWindowErrorRows.push(dateStr);
                                continue;
                            }
                        }
                    }
                }
            }

            validRows.push({
                EmpId: empId,
                FullName: row.fullName || "",
                BranchName: row.branchName || "",
                ForDate: row.shiftDate,
                ShiftTime: row.shiftTime || "",
                InTime: (row.inTime && row.inTime !== "-") ? formatToISOString(row.inTime) : null,
                OutTime: (row.outTime && row.outTime !== "-") ? formatToISOString(row.outTime) : null,
                Day: dayType,
                Status: row.attendanceStatus || "",
                Reason: reasonId.toString(),
                Remark: row.remark || null,
                IsApproved: false,
                IsPending: true,
                IsRejected: false,
                IsLocked: false,
                CreatedBy: EmployeeId
            });
        }

        // Show validation errors
        if (missingReasonRows.length > 0) {
            showToast('Please select reason for: ' + missingReasonRows.join(', '), 'warn');
            return;
        }

        if (missingDayTypeRows.length > 0) {
            showToast('Please select day type for: ' + missingDayTypeRows.join(', '), 'warn');
            return;
        }

        if (missingRemarkRows.length > 0) {
            showToast('Please enter remark for: ' + missingRemarkRows.join(', '), 'warn');
            return;
        }

        if (timeWindowErrorRows.length > 0) {
            showToast('Travel on Duty request for today can only be submitted from 15 minutes before shift start till shift end time. Dates: ' + timeWindowErrorRows.join(', '), 'error');
            return;
        }

        if (validRows.length === 0) {
            showToast('Please complete all required fields.', 'warn');
            return;
        }

        // Get month/year
        const monthYearData = await getYearMonth();
        if (!monthYearData) {
            showToast('Please select a valid month and year.', 'warn');
            return;
        }

        const selectedMonth = monthYearData.month;
        const selectedYear = monthYearData.year;

        isSavingGrid = true;
        setBtnLoading('#btnSaveGridData', 'Save');

        // Validate attendance request limit
        const isLimitValid = await validateAttendanceRequestLimit(
            empId,
            validRows,
            selectedMonth,
            selectedYear
        );

        if (!isLimitValid) {
            isSavingGrid = false;
            setBtnNormal('#btnSaveGridData', 'Save');
            return;
        }

        // Save via AJAX
        $.ajax({
             url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/CreateAttendanceRegularization")',
            type: "POST",
            contentType: "application/json",
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            data: JSON.stringify(validRows),
            success: function (response) {
                if (response?.isSuccess) {
                    showToast(response.responseMessage || "Saved successfully.", "success");

                    // Refresh grid - remove saved rows from current dataset
                    const currentData = attendanceGrid.getData();
                    const updatedData = currentData.filter(item => {
                        return !selectedRows.some(sel =>
                            sel.empId === item.empId &&
                            new Date(sel.shiftDate).toISOString() === new Date(item.shiftDate).toISOString()
                        );
                    });
                    selectedShiftDates = {};
                    attendanceGrid.setData(updatedData);

                    $("#btnGo").trigger("click");
                } else {
                    showToast(response?.responseMessage || "Unknown error", "error");
                }
            },
            error: function (xhr) {
                showToast(xhr.status + " - " + xhr.statusText, "error");
            },
            complete: function () {
                isSavingGrid = false;
                setBtnNormal('#btnSaveGridData', 'Save');
            }
        });
    });

    // ── Helpers for time-window / editability checks used by grid column renderers ──

    function isTravelOnDutyReason(reasonId) {
        const selectedReason = approvalReasons.find(r => r.reasonId === reasonId);
        return !!(selectedReason && selectedReason.reason.toLowerCase() === "travel on duty");
    }

    function isCurrentShiftDate(shiftDate) {
        const recordDate = new Date(shiftDate);
        const currentDate = new Date();
        recordDate.setHours(0, 0, 0, 0);
        currentDate.setHours(0, 0, 0, 0);
        return recordDate.getTime() === currentDate.getTime();
    }

    function isWithinTravelOnDutyWindow(shiftTime) {
        const now = new Date();
        const currentTime = now.getHours() * 60 + now.getMinutes();

        let shiftStartTime = null;
        let shiftEndTime = null;

        if (shiftTime) {
            const shiftParts = shiftTime.split('-');
            if (shiftParts.length === 2) {
                const startStr = shiftParts[0].trim();
                const startMatch = startStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                if (startMatch) {
                    let hours = parseInt(startMatch[1]);
                    const minutes = parseInt(startMatch[2]);
                    const period = startMatch[3].toUpperCase();
                    if (period === 'PM' && hours !== 12) hours += 12;
                    if (period === 'AM' && hours === 12) hours = 0;
                    shiftStartTime = hours * 60 + minutes;
                }

                const endStr = shiftParts[1].trim();
                const endMatch = endStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                if (endMatch) {
                    let hours = parseInt(endMatch[1]);
                    const minutes = parseInt(endMatch[2]);
                    const period = endMatch[3].toUpperCase();
                    if (period === 'PM' && hours !== 12) hours += 12;
                    if (period === 'AM' && hours === 12) hours = 0;
                    shiftEndTime = hours * 60 + minutes;
                }
            }
        }

        if (shiftStartTime === null || shiftEndTime === null) return true;

        const allowedStartTime = shiftStartTime - 15;
        const allowedEndTime = shiftEndTime;
        return !(currentTime < allowedStartTime || currentTime > allowedEndTime);
    }

    // Row checkbox toggle
    window._toggleAttendanceRow = function (shiftDate, checked) {
        if (checked) selectedShiftDates[shiftDate] = true;
        else delete selectedShiftDates[shiftDate];
    };

    // Reason dropdown change (mirrors dxDataGrid setCellValue behaviour)
    window._onReasonChange = function (shiftDate, selectEl) {
        if (!attendanceGrid) return;
        var value = selectEl.value;
        var rows = attendanceGrid.getData();
        var row = rows.find(function (r) { return r.shiftDate === shiftDate; });
        if (!row) return;

        row.reasonId = value ? parseInt(value) : null;

        const selectedReason = approvalReasons.find(r => r.reasonId === row.reasonId);
        if (selectedReason && selectedReason.reason.toLowerCase() === "travel on duty") {
            // Auto-set Day Type to Full Day when Travel on Duty is selected
            row.dayType = "Full Day";
        }

        attendanceGrid.refresh();
    };

    // Day Type dropdown change
    window._onDayTypeChange = function (shiftDate, selectEl) {
        if (!attendanceGrid) return;
        var value = selectEl.value;
        var rows = attendanceGrid.getData();
        var row = rows.find(function (r) { return r.shiftDate === shiftDate; });
        if (!row) return;
        row.dayType = value || null;
    };

    // Remark input change
    window._onRemarkChange = function (shiftDate, inputEl) {
        if (!attendanceGrid) return;
        var rows = attendanceGrid.getData();
        var row = rows.find(function (r) { return r.shiftDate === shiftDate; });
        if (!row) return;
        row.remark = inputEl.value;
    };

    function fmtTime(v) {
        return (v && v !== "-")
            ? new Date(v).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
            : "--";
    }

    function remarkPlaceholderFor(reasonId) {
        const selectedReason = approvalReasons.find(r => r.reasonId === reasonId);
        if (!selectedReason) return "Enter remark...";

        const reasonText = selectedReason.reason.toLowerCase();
        if (reasonText === "client visit") return "Mention the Client Name";
        if (reasonText === "travel on duty") return "Mention the Travel Location";
        if (reasonText === "official od") return "Mention the On Duty Purpose (Local)";
        if (reasonText === "other") return "Mention the Proper Reason";
        if (reasonText === "training") return "Mention the Training Name";
        if (reasonText === "working from home") return "Mention the Approver Name";
        if (reasonText === "late coming") return "Mention the Approver Name";
        if (reasonText === "early leaving") return "Mention the Approver Name";
        if (reasonText === "declared customer holiday") return "Mention the Customer Name";
        return "Enter remark...";
    }

    // Determines whether the Reason cell should be editable for a row, mirroring
    // the original onEditingStart business rule: P / W / H records cannot be edited at all;
    // for current-date rows only the Reason column may be touched.
    function reasonEditable(row) {
        const status = row.attendanceStatus?.trim().toUpperCase();
        if (status === "P" || status === "W" || status === "H") return false;
        return true;
    }

    // Determines whether Remark / non-reason columns are editable for a row.
    function otherFieldsEditable(row) {
        const status = row.attendanceStatus?.trim().toUpperCase();
        if (status === "P" || status === "W" || status === "H") return false;

        if (isCurrentShiftDate(row.shiftDate)) {
            const isTravelOnDuty = isTravelOnDutyReason(row.reasonId);
            if (!isTravelOnDuty) return false;
            return isWithinTravelOnDutyWindow(row.shiftTime);
        }

        return true;
    }

    // Determines whether Day Type is editable for a row.
    function dayTypeEditable(row) {
        const status = row.attendanceStatus?.trim().toUpperCase();
        if (status === "P" || status === "W" || status === "H") return false;

        const isTravelOnDuty = isTravelOnDutyReason(row.reasonId);
        if (isTravelOnDuty) return false; // auto-set to Full Day, not editable

        if (isCurrentShiftDate(row.shiftDate)) return false; // current date editing not allowed for Day Type

        const st = status?.toLowerCase();
        return st === "a" || st === "hf";
    }

    function LoadAttendanceGrid(data) {
        const filteredData = data.filter(item => item.attendanceStatus !== "-");
        selectedShiftDates = {};

        const columns = [
            {
                header: '', sortable: false, width: '40px',
                render: function (v, row) {
                    var checked = selectedShiftDates[row.shiftDate] ? ' checked' : '';
                    return '<input type="checkbox" class="form-check-input"' + checked +
                        ' onclick="_toggleAttendanceRow(\'' + row.shiftDate + '\', this.checked)">';
                }
            },
            {
                field: 'shiftDate', header: 'Date', sortable: false, width: '100px',
                render: function (v) {
                    if (!v) return '-';
                    var d = new Date(v);
                    if (isNaN(d.getTime())) return '-';
                    var day = String(d.getDate()).padStart(2, '0');
                    var month = String(d.getMonth() + 1).padStart(2, '0');
                    return day + '/' + month + '/' + d.getFullYear();
                }
            },
            { field: 'monthDay', header: 'Day', width: '60px' },
            { field: 'fullName', header: 'Employee', width: '140px' },
            { field: 'branchName', header: 'Branch', width: '120px' },
            { field: 'shiftTime', header: 'Shift Time', width: '130px' },
            {
                header: 'In Time', sortable: false, width: '90px',
                render: function (v, row) { return '<span class="att-time-box">' + fmtTime(row.inTime) + '</span>'; }
            },
            {
                header: 'Out Time', sortable: false, width: '90px',
                render: function (v, row) { return '<span class="att-time-box">' + fmtTime(row.outTime) + '</span>'; }
            },
            {
                header: 'Present Day', sortable: false, width: '100px',
                render: function (v, row) {
                    const status = row.attendanceStatus?.trim();
                    let color, text;
                    if (status === "P") { color = "green"; text = "P"; }
                    else if (status === "HF") { color = "orange"; text = "HF"; }
                    else if (status === "A") { color = "red"; text = "A"; }
                    else if (status === "H") { color = "blue"; text = "H"; }
                    else if (status === "W") { color = "purple"; text = "W"; }
                    else { color = "gray"; text = status; }
                    return '<span class="att-status-text" style="color:' + color + '">' + (text || '') + '</span>';
                }
            },
            {
                header: 'Reason', sortable: false, width: '190px',
                render: function (v, row) {
                    if (!reasonEditable(row)) {
                        const foundReason = approvalReasons.find(r => r.reasonId === row.reasonId);
                        return '<span>' + (foundReason ? foundReason.reason : '--') + '</span>';
                    }
                    var options = '<option value="">--Select--</option>';
                    approvalReasons.forEach(function (r) {
                        var sel = (row.reasonId === r.reasonId) ? ' selected' : '';
                        options += '<option value="' + r.reasonId + '"' + sel + '>' + r.reason + '</option>';
                    });
                    return '<select class="att-cell-select" onchange="_onReasonChange(\'' + row.shiftDate + '\', this)">' + options + '</select>';
                }
            },
            {
                header: 'Remark', sortable: false, width: '230px',
                render: function (v, row) {
                    if (!otherFieldsEditable(row)) {
                        return row.remark
                            ? '<span title="' + row.remark + '">' + row.remark + '</span>'
                            : '<span style="color:#999">--</span>';
                    }
                    var placeholder = remarkPlaceholderFor(row.reasonId);
                    return '<input type="text" class="att-cell-input" placeholder="' + placeholder + '" value="' +
                        (row.remark ? row.remark.replace(/"/g, '&quot;') : '') + '" onchange="_onRemarkChange(\'' + row.shiftDate + '\', this)">';
                }
            },
            { field: 'workingHours', header: 'Working Hours', width: '110px' },
            {
                header: 'Day Type', sortable: false, width: '140px',
                render: function (v, row) {
                    if (!dayTypeEditable(row)) {
                        return '<span>' + (row.dayType || '--Select--') + '</span>';
                    }
                    var opts = ['Full Day', 'First Half', 'Second Half'];
                    var html = '<select class="att-cell-select" onchange="_onDayTypeChange(\'' + row.shiftDate + '\', this)"><option value="">--Select--</option>';
                    opts.forEach(function (o) {
                        var sel = (row.dayType === o) ? ' selected' : '';
                        html += '<option value="' + o + '"' + sel + '>' + o + '</option>';
                    });
                    html += '</select>';
                    return html;
                }
            }
        ];

        if (!attendanceGrid) {
            attendanceGrid = WMSGrid.create({
                container: 'attendanceGridContainer',
                title: 'Attendance Records',
                icon: 'bx-calendar-check',
                data: filteredData,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false, export: false }
            });
        } else {
            attendanceGrid.getColumns().length = 0;
            columns.forEach(function (c) { attendanceGrid.getColumns().push(c); });
            attendanceGrid.setData(filteredData);
        }
    }

</script>
