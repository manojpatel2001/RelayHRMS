                            <div style="background: #fffbeb; padding: 10px; border-radius: 6px; margin-bottom: 10px;">
                                <strong style="color: #92400e;">📋 Counted Requests:</strong>
                                <ul style="margin: 8px 0; padding-left: 20px; color: #78350f;">
                                    ${limitedReasonNames.map(name => `<li style="margin: 3px 0;">${name}</li>`).join('')}
                                </ul>
                            </div>
                            ` : ''}

                            ${unlimitedReasonNames.length > 0 ? `
                            <div style="background: #f0f9ff; padding: 10px; border-radius: 6px; margin-bottom: 10px;">
                                <strong style="color: #0c4a6e;">✓ Not Counted (Unlimited):</strong>
                                <p style="margin: 5px 0; color: #0c4a6e;">${[...new Set(unlimitedReasonNames)].join(', ')}</p>
                            </div>
                            ` : ''}
                        </div>
                    `;

                    Swal.fire({
                        icon: 'error',
                        title: 'Cannot Submit Request',
                        html: message,
                        confirmButtonText: 'OK',
                        width: '650px'
                    });
                    return false;
                }

                const remainingRequests = monthlyLimit - totalLimitedRequests;
                console.log('✅ Validation Passed! Remaining LIMITED requests:', remainingRequests);
            }

            return true;

        } catch (error) {
            console.error("❌ Error validating request limit:", error);
            Swal.fire({
                icon: 'error',
                title: 'Validation Error',
                text: 'An error occurred: ' + error.message
            });
            return false;
        }
    }
    function LoadAttendanceGrid(data) {
        const filteredData = data.filter(item => item.attendanceStatus !== "-");

        $("#attendanceGrid").dxDataGrid({
            dataSource: filteredData,
            showBorders: true,
            keyExpr: "shiftDate",
            width: "100%",
            columnAutoWidth: true,
            allowColumnResizing: true,
            paging: { enabled: false },
            height: 200,
            autoHeight: false,
            scrolling: {
                mode: "standard",
                useNative: true,
                showScrollbar: "always"
            },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always"
            },
            editing: {
                mode: "cell",
                allowUpdating: true
            },
            onContentReady: function (e) {
                e.component.option("width", "100%");
            },
            onCellPrepared: function (e) {
                if (e.rowType === "data") {
                    e.cellElement.css({
                        'padding-top': '2px',
                        'padding-bottom': '2px',
                        'font-size': '12px',
                        'line-height': '16px'
                    });
                }
            },
            onEditingStart: function (e) {
                const status = e.data.attendanceStatus?.trim().toUpperCase();

                // Check attendance status (P, W, H not allowed)
                if (status === "P" || status === "W" || status === "H") {
                    e.cancel = true;
                    let msg =
                        status === "P" ? "Editing not allowed for Present records." :
                        status === "W" ? "Editing not allowed for Week Off records." :
                        "Editing not allowed for Holiday records.";
                    DevExpress.ui.notify(msg, "warning", 2000);
                    return;
                }

                const recordDate = new Date(e.data.shiftDate);
                const currentDate = new Date();
                recordDate.setHours(0, 0, 0, 0);
                currentDate.setHours(0, 0, 0, 0);

                // Check if it's Travel on Duty reason
                const selectedReason = approvalReasons.find(r => r.reasonId === e.data.reasonId);
                const isTravelOnDuty = selectedReason && selectedReason.reason.toLowerCase() === "travel on duty";

                // For current date: Allow editing ONLY for reason column OR if Travel on Duty is already selected
                if (recordDate.getTime() === currentDate.getTime()) {
                    // Allow editing reason column for current date
                    if (e.column.dataField === "reasonId") {
                        return; // Allow reason selection
                    }

                    // For other columns, check if Travel on Duty is selected
                    if (!isTravelOnDuty) {
                        e.cancel = true;
                        DevExpress.ui.notify("For current date, please select 'Travel on Duty' reason first.", "warning", 3000);
                        return;
                    }

                    // For Travel on Duty on current date, check time constraints
                    const now = new Date();
                    const currentTime = now.getHours() * 60 + now.getMinutes();

                    let shiftStartTime = null;
                    let shiftEndTime = null;

                    if (e.data.shiftTime) {
                        const shiftParts = e.data.shiftTime.split('-');
                        if (shiftParts.length === 2) {
                            const startStr = shiftParts[0].trim();
                            const startMatch = startStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                            if (startMatch) {
                                let hours = parseInt(startMatch[1]);
                                const minutes = parseInt(startMatch[2]);
                                const period = startMatch[3].toUpperCase();

                                if (period === 'PM' && hours !== 12) hours += 12;
                                if (period === 'AM' && hours === 12) hours = 0;

                                shiftStartTime = hours * 60 + minutes;
                            }

                            const endStr = shiftParts[1].trim();
                            const endMatch = endStr.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
                            if (endMatch) {
                                let hours = parseInt(endMatch[1]);
                                const minutes = parseInt(endMatch[2]);
                                const period = endMatch[3].toUpperCase();

                                if (period === 'PM' && hours !== 12) hours += 12;
                                if (period === 'AM' && hours === 12) hours = 0;

                                shiftEndTime = hours * 60 + minutes;
                            }
                        }
                    }

                    if (shiftStartTime !== null && shiftEndTime !== null) {
                        const allowedStartTime = shiftStartTime - 15;
                        const allowedEndTime = shiftEndTime;

                        if (currentTime < allowedStartTime || currentTime > allowedEndTime) {
                            e.cancel = true;
                            DevExpress.ui.notify(
                                "Travel on Duty request for today can only be submitted from 15 minutes before shift start till shift end time.",
                                "warning",
                                4000
                            );
                            return;
                        }
                    }
                }
            },
            columns: [
                {
                    dataField: "shiftDate",
                    caption: "Date",
                    dataType: "date",
                    format: "dd/MM/yyyy",
                    width: 100,
                    minWidth: 100
                },
                {
                    dataField: "monthDay",
                    caption: "Day",
                    allowEditing: false,
                    width: 50
                },
                {
                    dataField: "fullName",
                    caption: "Employee",
                    allowEditing: false,
                    minWidth: 120
                },
                {
                    dataField: "branchName",
                    caption: "Branch",
                    allowEditing: false,
                    minWidth: 100
                },
                {
                    dataField: "shiftTime",
                    caption: "Shift Time",
                    allowEditing: false,
                    minWidth: 120
                },
                {
                    dataField: "inTime",
                    caption: "In Time",
                    minWidth: 80,
                    allowEditing: false,
                    cellTemplate: function (container, options) {
                        const value = options.data.inTime && options.data.inTime !== "-"
                            ? new Date(options.data.inTime).toLocaleTimeString('en-GB', {
                                hour: '2-digit',
                                minute: '2-digit'
                            })
                            : "--";
                        $("<div>")
                            .text(value)
                            .css({
                                textAlign: "center",
                                border: "1px solid #ddd",
                                padding: "6px",
                                borderRadius: "4px",
                                backgroundColor: "#f5f5f5",
                                fontSize: "12px"
                            })
                            .appendTo(container);
                    }
                },
                {
                    dataField: "outTime",
                    caption: "Out Time",
                    minWidth: 80,
                    allowEditing: false,
                    cellTemplate: function (container, options) {
                        const value = options.data.outTime && options.data.outTime !== "-"
                            ? new Date(options.data.outTime).toLocaleTimeString('en-GB', {
                                hour: '2-digit',
                                minute: '2-digit'
                            })
                            : "--";
                        $("<div>")
                            .text(value)
                            .css({
                                textAlign: "center",
                                border: "1px solid #ddd",
                                padding: "6px",
                                borderRadius: "4px",
                                backgroundColor: "#f5f5f5",
                                fontSize: "12px"
                            })
                            .appendTo(container);
                    }
                },
                {
                    dataField: "attendanceStatus",
                    caption: "Present Day",
                    width: 100,
                    minWidth: 100,
                    allowEditing: false,
                    cellTemplate: function (container, options) {
                        const status = options.data.attendanceStatus?.trim();
                        let color, text;

                        if (status === "P") { color = "green"; text = "P"; }
                        else if (status === "HF") { color = "orange"; text = "HF"; }
                        else if (status === "A") { color = "red"; text = "A"; }
                        else if (status === "H") { color = "blue"; text = "H"; }
                        else if (status === "W") { color = "purple"; text = "W"; }
                        else { color = "gray"; text = status; }

                        $("<div>")
                            .text(text)
                            .css({
                                color: color,
                                fontWeight: "bold",
                                textAlign: "center"
                            })
                            .appendTo(container);
                    }
                },
                {
                    dataField: "reasonId",
                    caption: "Reason",
                    width: 180,
                    minWidth: 180,
                    lookup: {
                        dataSource: approvalReasons,
                        valueExpr: "reasonId",
                        displayExpr: "reason"
                    },
                    calculateDisplayValue: function (rowData) {
                        if (rowData.reasonId) {
                            const foundReason = approvalReasons.find(r => r.reasonId === rowData.reasonId);
                            return foundReason ? foundReason.reason : "--Select--";
                        }
                        return "--Select--";
                    },
                    setCellValue: function(rowData, value) {
                        rowData.reasonId = value;
                        const selectedReason = approvalReasons.find(r => r.reasonId === value);

                        if (selectedReason) {
                            const reasonText = selectedReason.reason.toLowerCase();

                            // If Travel on Duty is selected, auto-set Day Type to Full Day
                            if (reasonText === "travel on duty") {
                                rowData.dayType = "Full Day";
                            }
                        }
                    }
                },
                {
                    dataField: "remark",
                    caption: "Remark",
                    width: 250,
                    minWidth: 250,
                    visible: true,
                    allowEditing: true, // Hamesha editable rakha hai

                    editCellTemplate: function(container, options) {
                        const selectedReason = approvalReasons.find(r => r.reasonId === options.data.reasonId);
                        let placeholder = "Enter remark...";

                        if (selectedReason) {
                            const reasonText = selectedReason.reason.toLowerCase();

                            // Placeholder set karen reason ke hisab se
                            if (reasonText === "client visit") {
                                placeholder = "Mention the Client Name";
                            } else if (reasonText === "travel on duty") {
                                placeholder = "Mention the Travel Location";
                            } else if (reasonText === "official od") {
                                placeholder = "Mention the On Duty Purpose (Local)";
                            } else if (reasonText === "other") {
                                placeholder = "Mention the Proper Reason";
                            } else if (reasonText === "training") {
                                placeholder = "Mention the Training Name";
                            } else if (reasonText === "working from Home") {
                                placeholder = "Mention the Approver Name";
                            }  else if (reasonText === "late coming") {
                                placeholder = "Mention the Approver Name";
                            }  else if (reasonText === "early leaving") {
                                placeholder = "Mention the Approver Name";
                            } else if (reasonText === "declared customer holiday") {
                                placeholder = "Mention the Customer Name";
                            }
                        }

                        // Input field create karen
                        const wrapper = $("<div>").css({
                            display: "flex",
                            flexDirection: "column",
                            gap: "4px"
                        });

                        $("<input>")
                            .addClass("dx-texteditor-input")
                            .attr("placeholder", placeholder)
                            .val(options.value || "")
                            .css({
                                width: "100%",
                                padding: "6px",
                                fontSize: "12px"
                            })
                            .on("change", function(e) {
                                options.setValue(e.target.value);
                            })
                            .appendTo(wrapper);

                        wrapper.appendTo(container);
                    },

                    cellTemplate: function(container, options) {
                        if (options.data.remark) {
                            $("<div>")
                                .text(options.data.remark)
                                .css({
                                    padding: "6px",
                                    fontSize: "12px"
                                })
                                .appendTo(container);
                        } else {
                            $("<div>")
                                .text("--")
                                .css({
                                    textAlign: "center",
                                    color: "#999",
                                    padding: "6px"
                                })
                                .appendTo(container);
                        }
                    }
                },
                {
                    dataField: "workingHours",
                    caption: "Working Hours",
                    allowEditing: false,
                    minWidth: 120
                },
                {
                    dataField: "dayType",
                    caption: "Day Type",
                    width: 140,
                    minWidth: 140,
                    lookup: {
                        dataSource: [
                            { id: "Full Day", name: "Full Day" },
                            { id: "First Half", name: "First Half" },
                            { id: "Second Half", name: "Second Half" }
                        ],
                        valueExpr: "id",
                        displayExpr: "name"
                    },
                    calculateDisplayValue: function (rowData) {
                        return rowData.dayType || "--Select--";
                    },
                    allowEditing: function (options) {
                        const recordDate = new Date(options.data.shiftDate);
                        const currentDate = new Date();
                        recordDate.setHours(0, 0, 0, 0);
                        currentDate.setHours(0, 0, 0, 0);

                        const selectedReason = approvalReasons.find(r => r.reasonId === options.data.reasonId);
                        const isTravelOnDuty = selectedReason && selectedReason.reason.toLowerCase() === "travel on duty";

                        // For Travel on Duty, Day Type is not editable (auto-set to Full Day)
                        if (isTravelOnDuty) {
                            return false;
                        }

                        // Current date editing not allowed for Day Type
                        if (recordDate.getTime() === currentDate.getTime()) {
                            return false;
                        }

                        const status = options.data.attendanceStatus?.trim().toLowerCase();
                        return status === "a" || status === "hf";
                    },
                    editorOptions: function (options) {
                        const recordDate = new Date(options.data.shiftDate);
                        const currentDate = new Date();
                        recordDate.setHours(0, 0, 0, 0);
                        currentDate.setHours(0, 0, 0, 0);

                        const selectedReason = approvalReasons.find(r => r.reasonId === options.data.reasonId);
                        const isTravelOnDuty = selectedReason && selectedReason.reason.toLowerCase() === "travel on duty";

                        const isCurrentDate = recordDate.getTime() === currentDate.getTime();
                        const status = options.data.attendanceStatus?.trim().toLowerCase();
                        const isEditable = status === "a" || status === "hf";

                        return {
                            showClearButton: true,
                            disabled: isTravelOnDuty || isCurrentDate || !isEditable
                        };
                    },
                    editing: {
                        allowUpdating: true
                    }
                }
            ]
        });
    }

</script>