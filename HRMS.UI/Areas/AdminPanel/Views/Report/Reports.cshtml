                            <a href="@baseUrl/EmployeePanel/MyReports/Compoffavailbalance">• Comp-Off Avail Balance</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/LeaveCard">• Leave Card</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/LeaveEncashSlip">• Leave Encash Slip</a> *@
                        @*     <a href="@baseUrl/EmployeePanel/MyReports/leaveapplicationreport">• Leave Application Report</a> *@
                        </div>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        function showLinks(section) {
            $('.favourite-links, .attendance-links, .leave-links').hide(); // hide all first

            if (section === 'favourite') {
                $('.favourite-links').slideDown();
            } else if (section === 'attendance') {
                $('.attendance-links').slideDown();
            } else if (section === 'leave') {
                $('.leave-links').slideDown();
            }
        }

        // Show initial
        showLinks('favourite');

        // Click Events
        $('#favourite-tab').click(function () {
            $('.nav-link').removeClass('active');
            $(this).addClass('active');
            showLinks('favourite');
        });

        $('#attendance-tab').click(function () {
            $('.nav-link').removeClass('active');
            $(this).addClass('active');
            showLinks('attendance');
        });

        $('#leave-tab').click(function () {
            $('.nav-link').removeClass('active');
            $(this).addClass('active');
            showLinks('leave');
        });
    });
</script>
