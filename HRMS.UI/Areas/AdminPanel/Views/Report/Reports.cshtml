@{
    ViewData["Title"] = "Report";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<style>
    .vertical-tab-menu {
        border-right: 1px solid #ccc;
        border-radius: 8px 0 0 8px;
        height: 100%;
    }

    .nav-link {
        font-weight: 500;
    }

    #favourite-tab {
        background-color: #d0e7ff !important;
        color: #007bff;
    }

    #attendance-tab {
        background-color: #c0ddff !important;
        color: #003e7f;
        padding: 10px;
        margin-bottom: 2px;
    }

    #leave-tab {
        background-color: #a5caff !important;
        color: #000;
        padding: 10px;
    }

    .nav-link:hover {
        background-color: #b0d4ff;
        color: #0056b3;
    }

    .favourite-links,
    .attendance-links,
    .leave-links {
        display: none;
        padding: 10px 20px;
    }

        .favourite-links a,
        .attendance-links a,
        .leave-links a {
            display: block;
            text-decoration: none;
            color: #007bff;
            font-size: 14px;
            padding: 4px 0;
        }

            .favourite-links a:hover,
            .attendance-links a:hover,
            .leave-links a:hover {
                text-decoration: underline;
            }
</style>

<div class="card">
    <div class="card-header bg-transparent py-2">
        <div class="row">
            <div class="col-6">
                <h4 class="mb-0">Report Dashboard</h4>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-12 p-0">
                <div class="vertical-tab-menu h-100">
                    <ul class="nav flex-column nav-tabs p-3" id="reportTabs" role="tablist">
                        @*  <li class="nav-item">
                            <a class="nav-link active" id="favourite-tab" data-toggle="tab" href="#">Favourite Reports</a>
                        </li>
                        <div class="favourite-links">
                            <a href="@baseUrl/EmployeePanel/MyReports/EmployeeInOutPresent">• Employee Inout Present</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/LateEarlySummary">• Late/Early Mark Summary</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/MobileInOutSummary">• Mobile Inout Summary</a>
                        </div> *@

                        <li class="nav-item">
                            <a class="nav-link" id="attendance-tab" data-toggle="tab" href="#">Reports</a>
                        </li>
                        <div class="attendance-links">

                            <a href="@baseUrl/AdminPanel/Report/AttendanceRegisterAdmin" class="dropdown-item">•Attendance Register</a>
                            <a href="@baseUrl/AdminPanel/Report/SalaryRegisterAdmin" class="dropdown-item">•Salary Register</a>
                            <a href="@baseUrl/AdminPanel/DashboardReport/EmpInOutReportForAdmin" class="dropdown-item ">•Employee In Out Report</a>
                            <a href="@baseUrl/AdminPanel/Report/LeaveBalanceAdmin" class="dropdown-item ">•Leave Balance Report</a>
                            @*                     <a href="@baseUrl/AdminPanel/Report/TodaysAttendanceForAdmin" class="dropdown-item ">Today's Attendance Report</a> *@
                            <a href="@baseUrl/AdminPanel/Report/ActiveInActiveUsers" class="dropdown-item ">•Active Inactive Users</a>
                            <a href="@baseUrl/AdminPanel/Report/ActiveInActiveMobileUsers" class="dropdown-item ">•Active InActive Mobile Users</a>
                            <a href="@baseUrl/AdminPanel/Report/WhosOffReport" class="dropdown-item ">•Whos Off Report</a>
                            @*                     <a href="@baseUrl/AdminPanel/Report/LeaveYearlySummary" class="dropdown-item ">Yearly Leave</a> *@
                            <a href="@baseUrl/AdminPanel/Report/YearlyLeaveBalanceAdminReports" class="dropdown-item">•Leave Balance Admin Report</a>
                            <a href="@baseUrl/AdminPanel/Report/BranchWiseJoiningCount" class="dropdown-item">•Branch Wise Joining Count</a>
                            <a href="@baseUrl/AdminPanel/Report/LateEarlyMarkReport" class="dropdown-item">•Late Early Mark Report</a>
                        </div>
                        <li class="nav-item">
                            <a class="nav-link" id="leave-tab" data-toggle="tab" href="#">Letter</a>
                        </li>
                        <div class="leave-links">
                            <a href="@baseUrl/AdminPanel/Letter/ExperienceLetter">•Experience Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/RelievingLetter">•Relieving Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/OfferLetter">•Offer Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/AppointmentLetter">•Appointment Letter</a>
                        @*     <a href="@baseUrl/EmployeePanel/MyReports/LeaveBalance">• Leave Balance</a> *@
                            @*                <a href="@baseUrl/EmployeePanel/MyReports/YearlyLeave">• Yearly Leave Transaction</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/Getpass">• GatePass InOut</a>
