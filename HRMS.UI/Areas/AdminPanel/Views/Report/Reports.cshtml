@{
    ViewData["Title"] = "Report";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Report Dashboard</h6>
    </div>
    <div class="card-body">
        <div class="accordion" id="reportAccordion">

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseReports">
                        <i class="bx bx-bar-chart-alt-2 me-2"></i> Reports
                    </button>
                </h2>
                <div id="collapseReports" class="accordion-collapse collapse show" data-bs-parent="#reportAccordion">
                    <div class="accordion-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="@baseUrl/AdminPanel/Report/AttendanceRegisterAdmin" class="list-group-item list-group-item-action">Attendance Register</a>
                            <a href="@baseUrl/AdminPanel/Report/SalaryRegisterAdmin" class="list-group-item list-group-item-action">Salary Register</a>
                            <a href="@baseUrl/AdminPanel/DashboardReport/EmpInOutReportForAdmin" class="list-group-item list-group-item-action">Employee In Out Report</a>
                            <a href="@baseUrl/AdminPanel/Report/LeaveBalanceAdmin" class="list-group-item list-group-item-action">Leave Balance Report</a>
                            <a href="@baseUrl/AdminPanel/Report/ActiveInActiveUsers" class="list-group-item list-group-item-action">Active Inactive Users</a>
                            <a href="@baseUrl/AdminPanel/Report/ActiveInActiveMobileUsers" class="list-group-item list-group-item-action">Active InActive Mobile Users</a>
                            <a href="@baseUrl/AdminPanel/Report/WhosOffReport" class="list-group-item list-group-item-action">Whos Off Report</a>
                            <a href="@baseUrl/AdminPanel/Report/YearlyLeaveBalanceAdminReports" class="list-group-item list-group-item-action">Leave Balance Admin Report</a>
                            <a href="@baseUrl/AdminPanel/Report/BranchWiseJoiningCount" class="list-group-item list-group-item-action">Branch Wise Joining Count</a>
                            <a href="@baseUrl/AdminPanel/Report/LateEarlyMarkReport" class="list-group-item list-group-item-action">Late Early Mark Report</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLetter">
                        <i class="bx bx-envelope me-2"></i> Letter
                    </button>
                </h2>
                <div id="collapseLetter" class="accordion-collapse collapse" data-bs-parent="#reportAccordion">
                    <div class="accordion-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="@baseUrl/AdminPanel/Letter/ExperienceLetter" class="list-group-item list-group-item-action">Experience Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/RelievingLetter" class="list-group-item list-group-item-action">Relieving Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/OfferLetter" class="list-group-item list-group-item-action">Offer Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/AppointmentLetter" class="list-group-item list-group-item-action">Appointment Letter</a>
                            <a href="@baseUrl/AdminPanel/Letter/Promotionincrementletter" class="list-group-item list-group-item-action">Promotion And Increment Letter</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

</div>
