@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Late Early Mark Report";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn3.devexpress.com/jslib/23.1.3/css/dx.light.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background-color: white !important;
        margin: 0;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .inout-box {
        background-color: white !important;
        border: 1px solid #ccc;
        padding: 12px;
        border-radius: 5px;
    }

    .inout-header {
        background-color: #3e4b6d;
        color: white;
        font-weight: bold;
        padding: 8px 15px;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }

    .form-label {
        width: 130px;
        margin-bottom: 0;
        font-weight: 500;
    }

    .form-group-row {
        margin-bottom: 12px;
    }

    .form-select-sm, .form-control-sm {
        width: 180px;
    }

    .btn-go {
        background-color: #3e4b6d;
        color: white;
        border: none;
        padding: 4px 12px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 4px;
    }

        .btn-go:hover, .btn-go:focus, .btn-go:active {
            background-color: #3e4b6d;
            color: white;
            outline: none;
            box-shadow: none;
        }

    .small-dropdown {
        width: 180px !important;
    }

    .dx-datagrid-headers .dx-header-row > td,
    .dx-datagrid-headers .dx-header-row > th {
        background-color: #3e4b6d !important;
        color: white !important;
        font-weight: bold !important;
        border-color: #2a3447 !important;
    }

    .dx-datagrid .dx-datagrid-headers .dx-datagrid-table .dx-row > td {
        background-color: #3e4b6d !important;
        color: white !important;
        border-color: #2a3447 !important;
    }

    #inoutGridContainer {
        margin-bottom: 20px !important;
        height: 400px !important;
        overflow: auto !important;
    }

    #grid-loader {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(255,255,255,0.6);
        backdrop-filter: blur(3px);
        z-index: 9999;
    }

    .grid-logo-spinner {
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .grid-loading-text {
        font-size: 16px;
        color: #333;
    }

    /* Status badges */
    .badge-late {
        background-color: #dc3545;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-ontime {
        background-color: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-earlyleave {
        background-color: #fd7e14;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-fullshift {
        background-color: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-nopunch {
        background-color: #6c757d;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .badge-remarks-late-early {
        background-color: #dc3545;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-remarks-regular {
        background-color: #28a745;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-remarks-other {
        background-color: #fd7e14;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
    }
</style>

<div class="inout-box">
    <div class="inout-header">Late / Early Mark Report</div>

    <div class="row justify-content-center mt-3">
        <div class="col-lg-10">
            <div class="row">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="form-group-row d-flex align-items-center">
                        <label class="form-label">Start Date<span class="text-danger">*</span> :</label>
                        <input type="date" class="form-control form-control-sm" id="startDate">
                    </div>
                    <div class="form-group-row d-flex align-items-center">
                        <label class="form-label">Branch<span class="text-danger">*</span> :</label>
                        <div id="branchDropdown" class="small-dropdown"></div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="form-group-row d-flex align-items-center">
                        <label class="form-label">End Date<span class="text-danger">*</span> :</label>
                        <input type="date" class="form-control form-control-sm" id="endDate">
                    </div>
                    <div class="form-group-row d-flex align-items-center">
                        <label class="form-label">Employee<span class="text-danger">*</span> :</label>
                        <div id="employeeDropdown" class="small-dropdown"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 text-center mt-3">
        <button class="btn-go" id="btnFetch">Go</button>
        <button class="btn-go" id="btnClear">Clear</button>
        <button onclick="goBack()" class="btn-go">Back</button>
    </div>
</div>

<!-- Loader -->
<div id="grid-loader" class="justify-content-center align-items-center flex-column">
    <img src="@baseDomainUrl/loders/loder.png" class="grid-logo-spinner" />
    <div class="grid-loading-text">Loading...</div>
</div>

<!-- Grid -->
<div id="inoutGridContainer" style="display:none" class="mt-4"></div>

<script>
    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    const CompanyId = companyDetails.CompanyId;
    const Token = localStorage.getItem("authToken");

    $(document).ready(function () {
        setDefaultDates();
        BindBranchDropdown();
        BindEmployeeDropdownByBranch([0]);
    });

    function goBack() { window.history.back(); }

    function setDefaultDates() {
        const today = new Date().toISOString().split('T')[0];
        $('#startDate').val(today);
        $('#endDate').val(today);
    }

    function showLoder() { $('#grid-loader').addClass('d-flex').show(); }
    function hideLoder() { $('#grid-loader').removeClass('d-flex').hide(); }

    // ── Branch Dropdown ──────────────────────────────────────────────
    function BindBranchDropdown() {
        $.ajax({
            url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response?.data?.length > 0) {
                    $("#branchDropdown").dxTagBox({
                        items: response.data,
                        displayExpr: "branchName",
                        valueExpr: "branchId",
                        placeholder: "--Select Branch--",
                        showSelectionControls: true,
                        searchEnabled: true,
                        showClearButton: true,
                        maxDisplayedTags: 3,
                        applyValueMode: "instantly",
                        multiline: false,
                        width: "100%",
                        onValueChanged: function (e) {
                            let ids = e.value.length > 0 ? e.value : [0];
                            BindEmployeeDropdownByBranch(ids);
                        }
                    });
                }
            }
        });
    }

    // ── Employee Dropdown ────────────────────────────────────────────
    function BindEmployeeDropdownByBranch(selectedBranchIds) {
        const branchParam = selectedBranchIds.join(",");
        $.ajax({
            type: "GET",
            url: '@(baseDomainUrl + "/api/EmployeeMasterAPI/GetAllEmployeeByBranchId")?BranchIds=' + branchParam + '&CompanyId=' + CompanyId,
            success: function (response) {
                const $emp = $("#employeeDropdown");
                const items = (response?.data?.length > 0)
                    ? response.data.map(e => ({ employeeCode: e.employeeCode, displayName: `${e.fullName} - ${e.employeeCode}` }))
                    : [];

                if ($emp.data('dxTagBox')) { $emp.dxTagBox('dispose'); }

                $emp.dxTagBox({
                    items: items,
                    displayExpr: "displayName",
                    valueExpr: "employeeCode",
                    placeholder: items.length > 0 ? "--Select Employee--" : "No Employees Found",
                    showSelectionControls: items.length > 0,
                    searchEnabled: true,
                    showClearButton: true,
                    maxDisplayedTags: 3,
                    applyValueMode: "instantly",
                    multiline: false,
                    width: "300%"
                });
            }
        });
    }

    // ── Go Button ────────────────────────────────────────────────────
    $('#btnFetch').on('click', function () {
        const startDate = $('#startDate').val();
        const endDate   = $('#endDate').val();

        if (!startDate) { Swal.fire("Please select Start Date"); return; }
        if (!endDate)   { Swal.fire("Please select End Date");   return; }

        const branchIds   = $("#branchDropdown").dxTagBox("instance").option("value");
        const employeeCodes = $("#employeeDropdown").dxTagBox("instance").option("value");

        if (!branchIds || branchIds.length === 0)     { Swal.fire("Please select Branch");               return; }
        if (!employeeCodes || employeeCodes.length === 0) { Swal.fire("Please select at least one Employee"); return; }

        showLoder();

        $.ajax({
            url: '@baseDomainUrl/api/ReportAPI/LateEarlyMarkReport',
            type: 'GET',
            data: {
                StartDate:  startDate,
                EndDate:    endDate,
                BranchId:   branchIds.join(","),
                EmpId:      employeeCodes.join(","),
                CompanyId:  CompanyId
            },
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                console.log('response' ,response);
                hideLoder();
                if (response.isSuccess && response.data?.length > 0) {
                    RenderGrid(response.data);
                    // Disable filters after search
                    $('#startDate, #endDate').prop('disabled', true);
                    $("#branchDropdown").dxTagBox("instance").option("disabled", true);
                    $("#employeeDropdown").dxTagBox("instance").option("disabled", true);
                } else if (response.isSuccess) {
                    Swal.fire({ icon: 'info', title: 'No Data Found', text: 'No records found for selected criteria.' });
                } else {
                    Swal.fire(response.responseMessage || "Error fetching data");
                }
            },
            error: function () {
                hideLoder();
                Swal.fire("Error occurred while fetching data");
            }
        });
    });

    // ── Render Grid ──────────────────────────────────────────────────
    function RenderGrid(data) {
        if ($("#inoutGridContainer").data('dxDataGrid')) {
            $("#inoutGridContainer").dxDataGrid('dispose');
        }

        $("#inoutGridContainer").dxDataGrid({
            dataSource: data,
            showBorders: true,
            columnAutoWidth: false,
            height: 420,
            paging: { enabled: false },
            scrolling: { mode: "standard" },
            searchPanel: { visible: true, width: 200 },
            export: {
                enabled: true,
                allowExportSelectedData: false,
                formats: ['xlsx'],
                texts: { exportAll: "Export to Excel" }
            },
            onExporting: function (e) {
                e.fileName = `LateEarlyMark_${$('#startDate').val()}_to_${$('#endDate').val()}`;
            },
            columns: [
                { dataField: "employeeCode",     caption: "Code",         width: 100, alignment: "center" },
                { dataField: "employeeName",      caption: "Name",         width: 160 },
                {
                    dataField: "shiftDate", caption: "Date", width: 110,
                    dataType: "date", format: "dd/MM/yyyy", alignment: "center"
                },
                { dataField: "shiftName",         caption: "Shift",        width: 110, alignment: "center" },
                { dataField: "shiftStartTime",    caption: "Shift In",     width: 90,  alignment: "center" },
                { dataField: "shiftEndTime",      caption: "Shift Out",    width: 90,  alignment: "center" },
                { dataField: "actualInTime",      caption: "Actual In",    width: 90,  alignment: "center",
                    customizeText: c => (!c.value ? '-' : c.value) },
                { dataField: "actualOutTime",     caption: "Actual Out",   width: 90,  alignment: "center",
                    customizeText: c => (!c.value ? '-' : c.value) },
                {
                    dataField: "lateStatus", caption: "Late Status", width: 100, alignment: "center",
                    cellTemplate: function (container, options) {
                        const v = options.value || '';
                        const cls = v === 'Late' ? 'badge-late' : v === 'On Time' ? 'badge-ontime' : 'badge-nopunch';
                        $('<span>').addClass(cls).text(v || '-').appendTo(container);
                    }
                },
                {
                    dataField: "lateByMinutes", caption: "Late (min)", width: 90, alignment: "center",
                    customizeText: c => (c.value > 0 ? c.value + ' min' : '-')
                },
                {
                    dataField: "earlyLeaveStatus", caption: "Early Leave", width: 110, alignment: "center",
                    cellTemplate: function (container, options) {
                        const v = options.value || '';
                        const cls = v === 'Early Leave' ? 'badge-earlyleave' : v === 'Full Shift' ? 'badge-fullshift' : 'badge-nopunch';
                        $('<span>').addClass(cls).text(v || '-').appendTo(container);
                    }
                },
                {
                    dataField: "earlyByMinutes", caption: "Early (min)", width: 90, alignment: "center",
                    customizeText: c => (c.value > 0 ? c.value + ' min' : '-')
                },
                {
                    dataField: "remarks", caption: "Remarks", width: 160, alignment: "center",
                    cellTemplate: function (container, options) {
                        const v = options.value || '';
                        let cls = 'badge-remarks-other';
                        if (v === 'Regular')           cls = 'badge-remarks-regular';
                        else if (v.includes('Late') || v.includes('Early')) cls = 'badge-remarks-late-early';
                        $('<span>').addClass(cls).text(v || '-').appendTo(container);
                    }
                },
                { dataField: "attendanceStatus", caption: "Status",       width: 70,  alignment: "center",
                    customizeText: c => (c.value || '-') },
                { dataField: "workingHours",      caption: "Working Hrs",  width: 100, alignment: "center",
                    customizeText: c => (c.value || '-') }
            ]
        });

        $("#inoutGridContainer").show();
    }

    // ── Clear Button ─────────────────────────────────────────────────
    $('#btnClear').on('click', function () {
        $('#startDate, #endDate').prop('disabled', false);
        setDefaultDates();

        try { $("#branchDropdown").dxTagBox("instance").option({ value: [], disabled: false }); }
        catch (e) {}

        try { $("#employeeDropdown").dxTagBox("instance").option({ value: [], disabled: false }); }
        catch (e) {}

        $("#inoutGridContainer").hide();
        try {
            const g = $("#inoutGridContainer").dxDataGrid("instance");
            if (g) { g.option("dataSource", []); }
        } catch (e) {}

        BindEmployeeDropdownByBranch([0]);
    });
</script>