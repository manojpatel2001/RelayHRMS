@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Attendance Regularization";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Attendance Regularization</h6>
            <a href="@Url.Action("AddAttendanceRegularization", "Report")" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add
            </a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="form-grid-3">
                <div class="fg">
                    <label for="searchby">Search By</label>
                    <select id="searchby">
                        <option value="1">Emp Name</option>
                        <option value="2">Emp Code</option>
                        <option value="3">Reason</option>
                        <option value="4">Manager Name</option>
                    </select>
                </div>

                <div class="fg">
                    <label for="searchfor">Search For</label>
                    <input type="text" id="searchfor" placeholder="Enter search text" />
                </div>

                <div class="fg">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate" />
                </div>

                <div class="fg">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate" />
                </div>
            </div>

            <div class="mb-2">
                <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;">Status</span>
                <div class="d-flex gap-3 mt-1">
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="type" id="r2" checked>
                        <label class="form-check-label" for="r2">Pending</label>
                    </div>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="type" id="r3">
                        <label class="form-check-label" for="r3">Approved</label>
                    </div>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="type" id="r4">
                        <label class="form-check-label" for="r4">Rejected</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-primary btn-sm" id="btnGo"><i class="bx bx-search"></i> GO</button>
                <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                <button type="button" class="btn btn-secondary btn-sm" id="btnBack"><i class="bx bx-arrow-back"></i> Back</button>
            </div>

            <div class="divider"></div>

            <div id="actionButtons" class="d-flex justify-content-end gap-2 mb-3" style="display:none">
                <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnExport">
                    <i class="bx bx-download"></i> Export to Excel
                </button>
                <button type="button" class="btn btn-outline btn-sm" id="btnDelete" style="color:#C62828;border-color:#EF9A9A">
                    <i class="bx bx-trash"></i> Delete
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="btnApprove">
                    <i class="bx bx-check"></i> Approve
                </button>
                <button type="button" class="btn btn-secondary btn-sm" id="btnReject">
                    <i class="bx bx-x"></i> Reject
                </button>
            </div>

            <div id="gridContainerAttendanceReg"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
        const CompanyId = companyDetails ? companyDetails.CompanyId : null;
        const EmployeeId = localStorage.getItem('EmployeeId');
        const Token = localStorage.getItem('authToken');

        var selectedIds = {};

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear();
        }

        function fmtDateTime(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var hh = String(d.getHours()).padStart(2, '0');
            var mm = String(d.getMinutes()).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear() + ' ' + hh + ':' + mm;
        }

        function statusOf(row) {
            if (row.isApproved === true) return 'Approved';
            if (row.isRejected === true) return 'Rejected';
            if (row.isPending === true) return 'Pending';
            return '';
        }

        function statusPill(status) {
            if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return '';
        }

        function getStatus() {
            if ($('#r2').is(':checked')) return 'Pending';
            if ($('#r3').is(':checked')) return 'Approved';
            if ($('#r4').is(':checked')) return 'Rejected';
            return null;
        }

        function getSearchByText(value) {
            switch (value) {
                case '1': return 'EmpName';
                case '2': return 'EmpCode';
                case '3': return 'Reason';
                case '4': return 'ManagerName';
                default: return null;
            }
        }

        var grid = WMSGrid.create({
            container: 'gridContainerAttendanceReg',
            title: 'Employee Regularization',
            icon: 'bx-calendar-check',
            perPage: 10,
            columns: [
                {
                    header: 'Select', sortable: false, width: '60px',
                    render: function (v, row) {
                        var checked = selectedIds[row.attendanceRegularizationId] ? ' checked' : '';
                        return '<input type="checkbox" class="att-row-chk"' + checked + ' onclick="_toggleAttRow(' + row.attendanceRegularizationId + ', this.checked)">';
                    }
                },
                { field: 'employeeCode', header: 'Code', width: '90px' },
                { field: 'fullName', header: 'Name', width: '170px' },
                { field: 'branchName', header: 'Branch Name', width: '150px' },
                { header: 'Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.forDate); } },
                { header: 'App Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.createdDate); } },
                { header: 'In Time', sortable: false, width: '140px', render: function (v, row) { return fmtDateTime(row.inTime); } },
                { header: 'Out Time', sortable: false, width: '140px', render: function (v, row) { return fmtDateTime(row.outTime); } },
                { field: 'duration', header: 'Duration', width: '90px' },
                { field: 'day', header: 'Day', width: '80px' },
                { field: 'reason', header: 'Reason', width: '150px' },
                { field: 'remark', header: 'Remark', width: '170px', render: function (v) { return '<span title="' + (v || '') + '">' + (v || '') + '</span>'; } },
                { field: 'reportingManager', header: 'Reporting Manager', width: '160px' },
                { header: 'Status', sortable: false, width: '100px', render: function (v, row) { return statusPill(statusOf(row)); } },
                { field: 'updatedBy', header: 'Approved By', width: '120px', render: function (v) { return v || '-'; } },
                { header: 'Approved Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.updatedDate); } }
            ],
            features: { export: true },
            extraButtons: [
                {
                    id: 'btnSelectAllAtt', label: 'Select All', icon: 'bx-check-square', cls: 'wg-btn-outline',
                    onClick: function (e, data) {
                        var allSelected = data.length > 0 && data.every(function (r) { return !!selectedIds[r.attendanceRegularizationId]; });
                        selectedIds = {};
                        if (!allSelected) { data.forEach(function (r) { selectedIds[r.attendanceRegularizationId] = true; }); }
                        grid.refresh();
                    }
                }
            ]
        });

        window._toggleAttRow = function (id, checked) {
            if (checked) selectedIds[id] = true;
            else delete selectedIds[id];
        };

        function getSelectedRows() {
            return grid.getData().filter(function (r) { return !!selectedIds[r.attendanceRegularizationId]; });
        }

        function loadDataFromServer() {
            grid.showLoader();
            selectedIds = {};

            var model = {
                SearchBy: getSearchByText($('#searchby').val()),
                SearchValue: $('#searchfor').val(),
                FromDate: $('#fromdate').val() || null,
                ToDate: $('#todate').val() || null,
                Status: getStatus(),
                CompanyId: CompanyId,
                EmployeeId: EmployeeId,
                PageNumber: 1,
                PageSize: 1000
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/GetAttendanceRegularizationForAdmin")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                _silentLoader: true,
                success: function (res) {
                    grid.hideLoader();
                    var rows = (res.isSuccess && res.data && res.data.items) ? res.data.items : [];
                    grid.setData(rows);
                    $('#actionButtons').css('display', rows.length ? 'flex' : 'none');
                },
                error: function () {
                    grid.hideLoader();
                    showToast('Error occurred while fetching data.', 'error');
                }
            });
        }

        $(document).ready(function () { loadDataFromServer(); });

        $('#btnGo').click(function () { loadDataFromServer(); });

        $('#btnClear').click(function () {
            $('#searchby').val('1');
            $('#searchfor').val('');
            $('#fromdate').val('');
            $('#todate').val('');
            $('#r2').prop('checked', true);
            grid.setData([]);
            $('#actionButtons').hide();
        });

        $('#btnBack').click(function () { window.history.back(); });

        $('#btnExport').click(function () {
            var rows = getSelectedRows();
            if (rows.length === 0) {
                showToast('Please select at least one row to export.', 'warn');
                return;
            }

            grid.showLoader();

            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('Attendance Regularization');

            worksheet.columns = [
                { header: 'Code', key: 'employeeCode', width: 12 },
                { header: 'Name', key: 'fullName', width: 30 },
                { header: 'Branch Name', key: 'branchName', width: 30 },
                { header: 'Date', key: 'forDate', width: 15 },
                { header: 'App Date', key: 'createdDate', width: 15 },
                { header: 'In Time', key: 'inTime', width: 20 },
                { header: 'Out Time', key: 'outTime', width: 20 },
                { header: 'Duration', key: 'duration', width: 12 },
                { header: 'Day', key: 'day', width: 12 },
                { header: 'Reason', key: 'reason', width: 25 },
                { header: 'Remark', key: 'remark', width: 25 },
                { header: 'Reporting Manager', key: 'reportingManager', width: 25 },
                { header: 'Status', key: 'status', width: 12 },
                { header: 'Approved By', key: 'updatedBy', width: 20 },
                { header: 'Approved Date', key: 'updatedDate', width: 15 }
            ];

            var headerRow = worksheet.getRow(1);
            headerRow.eachCell(function (cell) {
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF2F6F8E' } };
                cell.alignment = { vertical: 'middle', horizontal: 'center' };
            });
            headerRow.height = 25;

            rows.forEach(function (rowData) {
                worksheet.addRow({
                    employeeCode: rowData.employeeCode || '',
                    fullName: rowData.fullName || '',
                    branchName: rowData.branchName || '',
                    forDate: fmtDate(rowData.forDate),
                    createdDate: fmtDate(rowData.createdDate),
                    inTime: fmtDateTime(rowData.inTime),
                    outTime: fmtDateTime(rowData.outTime),
                    duration: rowData.duration || '',
                    day: rowData.day || '',
                    reason: rowData.reason || '',
                    remark: rowData.remark || '',
                    reportingManager: rowData.reportingManager || '',
                    status: statusOf(rowData),
                    updatedBy: rowData.updatedBy || '-',
                    updatedDate: fmtDate(rowData.updatedDate)
                });
            });

            var fileName = 'Attendance_Regularization_' + new Date().getTime() + '.xlsx';

            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
                grid.hideLoader();
                showToast('Excel file downloaded successfully.', 'success');
            }).catch(function (error) {
                grid.hideLoader();
                console.error('Excel export error:', error);
                showToast('Error exporting to Excel.', 'error');
            });
        });

        $('#btnDelete').click(function () {
            var rows = getSelectedRows();
            if (rows.length === 0) {
                showToast('Please select at least one record.', 'warn');
                return;
            }

            wmsConfirm('Are you sure you want to delete the selected record(s)?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                grid.showLoader();
                var deletePayload = {
                    Id: rows.map(function (r) { return r.attendanceRegularizationId; }),
                    DeletedBy: EmployeeId
                };

                $.ajax({
                    url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/Delete")',
                    type: 'DELETE',
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + Token },
                    data: JSON.stringify(deletePayload),
                    success: function (res) {
                        grid.hideLoader();
                        showToast(res.responseMessage || (res.isSuccess ? 'Deleted successfully.' : 'Deletion failed.'), res.isSuccess ? 'success' : 'error');
                        if (res.isSuccess) loadDataFromServer();
                    },
                    error: function () {
                        grid.hideLoader();
                        showToast('Something went wrong during deletion.', 'error');
                    }
                });
            });
        });

        function updateAttendanceStatus(status) {
            var rows = getSelectedRows();
            if (rows.length === 0) {
                showToast('Please select at least one record.', 'warn');
                return;
            }

            if (status === 'Rejected' && rows.some(function (r) { return r.isApproved; })) {
                showToast('Approved records cannot be rejected.', 'error');
                return;
            }
            if (status === 'Approved' && rows.some(function (r) { return r.isApproved; })) {
                showToast('Already Approved.', 'error');
                return;
            }

            rows.forEach(function (row) {
                row.status = status;
                row.createdBy = EmployeeId;
            });

            grid.showLoader();
            $.ajax({
                url: '@(baseDomainUrl + "/api/AttendanceRegularizationAPI/UpdateAttendanceRegularization")',
                type: 'PUT',
                data: JSON.stringify(rows),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    grid.hideLoader();
                    showToast(response.responseMessage || (response.isSuccess ? 'Status updated successfully.' : 'Update failed.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) loadDataFromServer();
                },
                error: function () {
                    grid.hideLoader();
                    showToast('Something went wrong during update.', 'error');
                }
            });
        }

        $('#btnApprove').click(function () { updateAttendanceStatus('Approved'); });
        $('#btnReject').click(function () { updateAttendanceStatus('Rejected'); });
    })();
</script>
