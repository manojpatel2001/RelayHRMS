@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Left Employee";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Left Employee Details</h6>
            <div class="d-flex gap-2">
                <button id="exportToExcel" type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-download"></i> Export to Excel
                </button>
                <button id="addLeftEmployee" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-plus"></i> Add Left Employee
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="gridContainerLeftEmployee"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="addEmployeeLeftModal" tabindex="-1" aria-labelledby="addEmployeeLeftLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="addEmployeeLeftLabel">Add Left Employee</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="wms-form-page">
                    <form id="leftEmployeeForm">
                        <div class="mb-2">
                            <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;">Reason Type</span>
                            <div class="d-flex gap-3 flex-wrap mt-1">
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input reasonType" type="checkbox" id="resignation" value="Resignation">
                                    <label class="form-check-label" for="resignation">Resignation</label>
                                </div>
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input reasonType" type="checkbox" id="retirement" value="Retirement">
                                    <label class="form-check-label" for="retirement">Retirement</label>
                                </div>
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input reasonType" type="checkbox" id="terminated" value="Terminated">
                                    <label class="form-check-label" for="terminated">Terminated</label>
                                </div>
                                <div class="form-check form-check-inline m-0">
                                    <input class="form-check-input reasonType" type="checkbox" id="death" value="Death">
                                    <label class="form-check-label" for="death">Death</label>
                                </div>
                            </div>
                            <span id="spnReasonType" class="field-validation-error" style="display:none;">Please select a Reason Type</span>
                        </div>

                        <div class="divider"></div>

                        <div class="form-grid-3">
                            <div class="fg fg-req">
                                <label for="branchemps">Employee</label>
                                <select id="branchemps">
                                    <option value="" selected disabled>Select Employee</option>
                                </select>
                                <span id="spnemp" class="field-validation-error" style="display:none;">Please Select Employee</span>
                            </div>

                            <div class="fg">
                                <label for="joinDate">Join Date</label>
                                <input type="date" id="joinDate" readonly>
                            </div>

                            <div class="fg fg-req">
                                <label for="leftDate" id="leftDateLabel">Left Date</label>
                                <input type="date" id="leftDate">
                                <span class="field-validation-error" id="spnleftdate" style="display:none;">Please Enter Left Date</span>
                                <span class="field-validation-error" id="spnleftdategreter" style="display:none;">Date must be greater than joining date</span>
                            </div>

                            <div class="fg resignation-fields" style="display:none;">
                                <label for="resignationDate">Resignation Date</label>
                                <input type="date" id="resignationDate">
                            </div>

                            <div class="fg fg-req resignation-fields" style="display:none;">
                                <label for="resignationAcceptedDate">Resignation Accepted Date</label>
                                <input type="date" id="resignationAcceptedDate">
                                <span class="field-validation-error" id="spnresignationAcceptedDate" style="display:none;">Please Enter Resignation Accepted Date</span>
                                <span class="field-validation-error" id="spnresignationAcceptedDategreter" style="display:none;">Must be greater than the joining date</span>
                                <span class="field-validation-error" id="spnleftdateafterresignation" style="display:none;">Left date must be on or after this date</span>
                            </div>

                            <div class="fg">
                                <label for="reason">Reason</label>
                                <select id="reason">
                                    <option value="" selected disabled>Select Reason</option>
                                </select>
                            </div>

                            <div class="fg">
                                <label for="otherReason">Other Reason</label>
                                <textarea id="otherReason" rows="1" placeholder="Other Reason"></textarea>
                            </div>

                            <div class="fg resignation-fields terminated-fields" style="display:none;">
                                <label for="uniformReturn">Uniform Return</label>
                                <select id="uniformReturn">
                                    <option value="" selected disabled>Select</option>
                                </select>
                            </div>

                            <div class="fg resignation-fields terminated-fields" style="display:none;">
                                <label for="exitInterview">Exit Interview</label>
                                <select id="exitInterview">
                                    <option value="" selected disabled>Select</option>
                                </select>
                            </div>

                            <div class="fg resignation-fields terminated-fields" style="display:none;">
                                <label for="noticePeriod">Notice Period</label>
                                <select id="noticePeriod">
                                    <option value="" selected disabled>Select</option>
                                </select>
                            </div>

                            <div class="fg">
                                <label for="replaceManager">Replace Reporting Manager</label>
                                <select id="replaceManager">
                                    <option value="" selected disabled>Select Reporting Manager</option>
                                </select>
                            </div>

                            <div class="fg">
                                <label for="leftReasonPf">Left Reason (PF)</label>
                                <select id="leftReasonPf">
                                    <option value="" selected disabled>Select Left Reason</option>
                                </select>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveLeftEmployee">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
        const CompanyId = companyDetails ? companyDetails.CompanyId : null;
        const EmployeeId = localStorage.getItem('EmployeeId');
        const Token = localStorage.getItem('authToken');
        let leftempid = 0;
        let _leftEmpCache = {};

        function fmtDate(v) {
            if (!v) return '';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear();
        }

        var grid = WMSGrid.create({
            container: 'gridContainerLeftEmployee',
            title: 'Left Employees',
            icon: 'bx-user-x',
            perPage: 10,
            columns: [
                { field: 'employeeCode', header: 'Employee Code', width: '140px' },
                { field: 'fullName', header: 'Employee Name', width: '200px' },
                { header: 'Joining Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.dateOfJoining); } },
                { header: 'Leaving Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.leftDate); } },
                { field: 'reasonType', header: 'Reason Type', width: '140px' },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '110px',
                    render: function (v, row) {
                        var editBtn = PermGuard.has('edit-leftemployee-leftemployeedetails')
                            ? '<button class="wg-btn wg-btn-primary" title="Update" onclick="_editLeftEmployee(' + row.leftID + ')"><i class="bx bx-edit"></i></button> '
                            : '';
                        var deleteBtn = PermGuard.has('delete-leftemployee-leftemployeedetails')
                            ? '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteLeftEmployee(' + row.leftID + ')"><i class="bx bx-trash"></i></button>'
                            : '';
                        return editBtn + deleteBtn;
                    }
                }
            ],
            features: { export: true }
        });

        function loadDataTable() {
            grid.showLoader();
            $.ajax({
                type: 'GET',
                url: '@baseUrl/LeftEmployeeAPI/GetAllLeftEmp',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: { CompanyId: CompanyId },
                contentType: 'application/json',
                _silentLoader: true,
                success: function (response) {
                    var rows = response.isSuccess ? (response.data || []) : [];
                    _leftEmpCache = {};
                    rows.forEach(function (r) { _leftEmpCache[r.leftID] = r; });
                    grid.setData(rows);
                    grid.hideLoader();
                },
                error: function () {
                    grid.hideLoader();
                    showToast('Unable to load left employee data.', 'error');
                }
            });
        }

        $(document).ready(function () {
            PermGuard.onReady(function () { loadDataTable(); });
            PermGuard.applyActions('leftemployee-leftemployeedetails', { create: '#addLeftEmployee', export: '#exportToExcel, #gridContainerLeftEmployee_exportBtn' });
            BindEmployeeByBranchId();
            bindReporting();

            $('#branchemps').on('change', function () { GetJoinDateById(); });

            function fillStaticOptions(selId, values) {
                var $sel = $(selId);
                $sel.append(values.map(function (v) { return $('<option>', { value: v, text: v }); }));
            }

            fillStaticOptions('#reason', ['Resign']);
            fillStaticOptions('#uniformReturn', ['Yes', 'No', 'N/A']);
            fillStaticOptions('#exitInterview', ['Yes', 'No', 'N/A']);
            fillStaticOptions('#noticePeriod', ['Yes', 'No', 'N/A']);
            fillStaticOptions('#leftReasonPf', [
                'Retirement', 'Death in Service', 'Superannuation',
                'Permanent Disablement', 'Cessation (Short Service)', 'Death away from service'
            ]);
        });

        $('#addLeftEmployee').click(function () {
            resetLeftEmployee();
            $('#addEmployeeLeftModal').modal('show');
        });

        $(document).on('change', '.reasonType', function () {
            if ($(this).is(':checked')) {
                $('.reasonType').not(this).prop('checked', false);
            }

            $('.resignation-fields, .terminated-fields').hide();
            $('#leftDateLabel').text('Left Date');

            if ($('#resignation').is(':checked')) {
                $('.resignation-fields').show();
                $('#leftDateLabel').text('Left Date');
            } else if ($('#retirement').is(':checked')) {
                $('#leftDateLabel').text('Retirement Date');
            } else if ($('#terminated').is(':checked')) {
                $('.terminated-fields').show();
                $('#leftDateLabel').text('Terminated Date');
            } else if ($('#death').is(':checked')) {
                $('#leftDateLabel').text('Death Date');
            }
        });

        function BindEmployeeByBranchId() {
            var payload = { BranchId: null, CompanyId: CompanyId };
            return $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetEmployeeListByBranchIdForLeft',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(payload),
                success: function (data) {
                    if (data.isSuccess) {
                        var $empSel = $('#branchemps');
                        $empSel.empty().append('<option value="" selected disabled>Select Employee</option>');
                        (data.data || []).forEach(function (e) {
                            $empSel.append($('<option>', { value: e.employeeId, text: e.employeeName }));
                        });
                    }
                },
                error: function () { console.error('Failed to fetch employees.'); }
            });
        }

        function GetJoinDateById() {
            var id = $('#branchemps').val();
            $('#joinDate').val('');
            if (!id) return;

            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetEmplyeeDetailsById/' + id,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (data) {
                    if (data.isSuccess && data.data.DateOfJoining) {
                        $('#joinDate').val(data.data.DateOfJoining.split('T')[0]);
                    }
                },
                error: function () { console.error('Failed to fetch employee join date.'); }
            });
        }

        function bindReporting() {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetReportingList',
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (data) {
                    if (data.isSuccess) {
                        var $mgrSel = $('#replaceManager');
                        $mgrSel.empty().append('<option value="" selected disabled>Select Reporting Manager</option>');
                        (data.data || []).forEach(function (m) {
                            $mgrSel.append($('<option>', { value: m.employeeId, text: m.employeeName }));
                        });
                    }
                },
                error: function () { console.error('Failed to fetch reporting managers.'); }
            });
        }

        function validateLeftEmployeeForm(reasonTypes, leftDate, joiningDate, resignationAcceptDate) {
            let isValid = true;

            $('#spnReasonType, #spnemp, #spnleftdate, #spnleftdategreter, #spnresignationAcceptedDate, #spnresignationAcceptedDategreter, #spnleftdateafterresignation').hide();

            if (reasonTypes.length === 0) {
                $('#spnReasonType').show();
                isValid = false;
            }

            if (!$('#branchemps').val()) {
                $('#spnemp').show();
                isValid = false;
            }

            if (!$('#leftDate').val()) {
                $('#spnleftdate').show();
                isValid = false;
            } else if (leftDate && joiningDate && leftDate <= joiningDate) {
                $('#spnleftdategreter').show();
                isValid = false;
            }

            if (reasonTypes.includes('Resignation')) {
                if (!$('#resignationAcceptedDate').val()) {
                    $('#spnresignationAcceptedDate').show();
                    isValid = false;
                } else if (resignationAcceptDate && joiningDate && resignationAcceptDate <= joiningDate) {
                    $('#spnresignationAcceptedDategreter').show();
                    isValid = false;
                } else if (leftDate && resignationAcceptDate && leftDate < resignationAcceptDate) {
                    $('#spnleftdateafterresignation').show();
                    isValid = false;
                }
            }

            return isValid;
        }

        $('#btnSaveLeftEmployee').click(function () {
            var leftDateStr = $('#leftDate').val();
            var joiningDateStr = $('#joinDate').val();
            var resignationAcceptedDateStr = $('#resignationAcceptedDate').val();

            var leftDate = leftDateStr ? new Date(leftDateStr) : null;
            var joiningDate = joiningDateStr ? new Date(joiningDateStr) : null;
            var resignationAcceptDate = resignationAcceptedDateStr ? new Date(resignationAcceptedDateStr) : null;

            var reasonTypes = [];
            $('.reasonType:checked').each(function () { reasonTypes.push($(this).val()); });

            if (!validateLeftEmployeeForm(reasonTypes, leftDate, joiningDate, resignationAcceptDate)) {
                return;
            }

            setBtnLoading('#btnSaveLeftEmployee', leftempid > 0 ? 'Updating...' : 'Saving...');

            var employee = $('#branchemps').val();
            var resignationDate = $('#resignationDate').val();
            var resignationAcceptedDate = $('#resignationAcceptedDate').val();
            var reason = $('#reason').val();
            var otherReason = $('#otherReason').val();
            var uniformReturn = $('#uniformReturn').val();
            var exitInterview = $('#exitInterview').val();
            var noticePeriod = $('#noticePeriod').val();
            var replaceManager = $('#replaceManager').val();
            var leftReasonPf = $('#leftReasonPf').val();

            var employeeLeftData = {
                LeftID: leftempid,
                CmpID: CompanyId,
                EmpID: parseInt(employee),
                BranchId: null,
                LeftDate: leftDateStr ? new Date(leftDateStr).toISOString() : null,
                LeftReason: reason,
                RegAcceptDate: resignationAcceptedDate ? new Date(resignationAcceptedDate).toISOString() : null,
                IsTerminate: reasonTypes.includes('Terminated'),
                UniformReturn: (uniformReturn === 'Yes'),
                ExitInterview: (exitInterview === 'Yes'),
                NoticePeriod: noticePeriod,
                IsDeath: reasonTypes.includes('Death'),
                RegDate: resignationDate ? new Date(resignationDate).toISOString() : null,
                IsFnFApplicable: reasonTypes.includes('Resignation'),
                RptManagerID: replaceManager ? replaceManager : null,
                IsRetire: reasonTypes.includes('Retirement'),
                LeftReasonValue: leftReasonPf,
                LeftReasonText: otherReason,
                IsDeleted: false,
                IsEnabled: true,
                IsLeft: true,
                Remark: reasonTypes.join(', '),
                CreatedBy: EmployeeId,
                UpdatedBy: EmployeeId
            };

            var apiUrl = (leftempid && leftempid > 0)
                ? '@baseUrl/LeftEmployeeAPI/UpdateLeftEmployee'
                : '@baseUrl/LeftEmployeeAPI/CreateLeftEmp';
            var methodType = (leftempid && leftempid > 0) ? 'PUT' : 'POST';

            $.ajax({
                url: apiUrl,
                type: methodType,
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(employeeLeftData),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        loadDataTable();
                        resetLeftEmployee();
                        $('#addEmployeeLeftModal').modal('hide');
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveLeftEmployee', leftempid > 0 ? 'Update' : 'Save');
                },
                error: function (xhr) {
                    console.error('Error:', xhr);
                    showToast('Unable to save details.', 'error');
                    setBtnNormal('#btnSaveLeftEmployee', leftempid > 0 ? 'Update' : 'Save');
                }
            });
        });

        function resetLeftEmployee() {
            leftempid = 0;
            $('#leftDate, #resignationDate, #resignationAcceptedDate, #joinDate').val('');
            $('#otherReason').val('');
            $('#branchemps').val('');
            $('#reason').val('');
            $('#uniformReturn').val('');
            $('#exitInterview').val('');
            $('#noticePeriod').val('');
            $('#replaceManager').val('');
            $('#leftReasonPf').val('');

            $('.reasonType').prop('checked', false).prop('disabled', false);
            $('.resignation-fields, .terminated-fields').hide();
            $('#spnReasonType, #spnemp, #spnleftdate, #spnleftdategreter, #spnresignationAcceptedDate, #spnresignationAcceptedDategreter, #spnleftdateafterresignation').hide();
            $('#leftDateLabel').text('Left Date');
            $('#addEmployeeLeftLabel').text('Add Left Employee');
            setBtnNormal('#btnSaveLeftEmployee', 'Save');
        }

        function normalizeYesNo(val) {
            if (val === true || val === 'true' || val === 1 || String(val).toLowerCase() === 'yes') return 'Yes';
            if (val === false || val === 'false' || val === 0 || String(val).toLowerCase() === 'no') return 'No';
            return 'N/A';
        }

        window._editLeftEmployee = async function (id) {
            const data = _leftEmpCache[id];
            if (!data) return;

            resetLeftEmployee();
            leftempid = data.leftID;
            $('#branchemps').val(data.empID);
            await GetJoinDateById();
            $('#leftDate').val(data.leftDate ? data.leftDate.split('T')[0] : '');
            $('#resignationDate').val(data.regDate ? data.regDate.split('T')[0] : '');
            $('#resignationAcceptedDate').val(data.regAcceptDate ? data.regAcceptDate.split('T')[0] : '');
            $('#reason').val(data.leftReason || '');
            $('#otherReason').val(data.leftReasonText || '');
            $('#uniformReturn').val(normalizeYesNo(data.uniformReturn));
            $('#exitInterview').val(normalizeYesNo(data.exitInterview));
            $('#noticePeriod').val(normalizeYesNo(data.noticePeriod));
            $('#replaceManager').val(data.rptManagerID || '');
            $('#leftReasonPf').val(data.leftReasonValue || '');

            $('.reasonType').prop('checked', false).prop('disabled', true);

            if (data.isTerminate === true || data.isTerminate === 'True' || data.isTerminate === 1) {
                $('#terminated').prop('checked', true);
            } else if (data.isDeath === true || data.isDeath === 'True' || data.isDeath === 1) {
                $('#death').prop('checked', true);
            } else if (data.isRetire === true || data.isRetire === 'True' || data.isRetire === 1) {
                $('#retirement').prop('checked', true);
            } else if (data.isFnFApplicable === true || data.isFnFApplicable === 'True' || data.isFnFApplicable === 1) {
                $('#resignation').prop('checked', true);
            }

            $('.reasonType').change();
            setBtnNormal('#btnSaveLeftEmployee', 'Update');
            $('#addEmployeeLeftLabel').text('Update Left Employee');
            $('#addEmployeeLeftModal').modal('show');
        };

        window._deleteLeftEmployee = function (id) {
            wmsConfirm('Are you sure you want to delete this left employee record?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { id: id, deletedBy: EmployeeId };
                $.ajax({
                    url: '@baseUrl/LeftEmployeeAPI/Delete',
                    type: 'DELETE',
                    data: JSON.stringify(deleteObj),
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + Token },
                    success: function (response) {
                        showToast(response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadDataTable();
                    },
                    error: function () { showToast('An error occurred while deleting the record. Please try again.', 'error'); }
                });
            });
        };

        $('#exportToExcel').click(function () {
            var rows = Object.values(_leftEmpCache);
            if (!rows.length) {
                showToast('No data available to export.', 'warn');
                return;
            }

            var exportData = rows.map(function (item) {
                return {
                    'Employee Code': item.employeeCode || '',
                    'Employee Name': item.fullName || '',
                    'Joining Date': fmtDate(item.dateOfJoining),
                    'Leaving Date': fmtDate(item.leftDate),
                    'Reason Type': item.reasonType || ''
                };
            });

            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.json_to_sheet(exportData);
            ws['!cols'] = [{ wch: 15 }, { wch: 25 }, { wch: 15 }, { wch: 15 }, { wch: 20 }];
            XLSX.utils.book_append_sheet(wb, ws, 'Left Employees');

            var today = new Date();
            var filename = 'LeftEmployees_' + today.getFullYear() +
                ('0' + (today.getMonth() + 1)).slice(-2) +
                ('0' + today.getDate()).slice(-2) + '.xlsx';
            XLSX.writeFile(wb, filename);

            showToast('Excel file exported successfully.', 'success');
        });
    })();
</script>
