@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Shift Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Shift Master</h6>
        <button id="addShift" type="button" class="btn btn-primary btn-sm">Add Shift</button>
    </div>
    <div class="card-body">
        <div id="shiftGrid"></div>
    </div>
</div>

<div class="modal fade" id="addShiftModel" tabindex="-1" aria-labelledby="shiftModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shiftModalLabel"><span id="formType">Add</span> Shift</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Shift Name" id="txtShiftName" />
                            <label class="floating-label" for="txtShiftName">Shift Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnShiftName" style="color:red; display:none;">Please Enter Shift Name</span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="Start Time" id="txtStartTime" />
                            <label class="floating-label" for="txtStartTime">Start Time <span class="required-star">*</span></label>
                        </div>
                        <span id="spnStartTime" style="color:red; display:none;">Please Enter Start Time</span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="End Time" id="txtEndTime" />
                            <label class="floating-label" for="txtEndTime">End Time <span class="required-star">*</span></label>
                        </div>
                        <span id="spnEndTime" style="color:red; display:none;">Please Enter End Time</span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Duration" id="txtDuration" disabled />
                            <label class="floating-label" for="txtDuration">Duration</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <label><strong>First Break</strong></label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="Start Time" id="txtStartTimeB1" />
                            <label class="floating-label" for="txtStartTimeB1">Start Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="End Time" id="txtEndTimeB1" />
                            <label class="floating-label" for="txtEndTimeB1">End Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Duration" id="txtDurationB1" disabled />
                            <label class="floating-label" for="txtDurationB1">Duration</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <label><strong>Second Break</strong></label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="Start Time" id="txtStartTimeB2" />
                            <label class="floating-label" for="txtStartTimeB2">Start Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="End Time" id="txtEndTimeB2" />
                            <label class="floating-label" for="txtEndTimeB2">End Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Duration" id="txtDurationB2" disabled />
                            <label class="floating-label" for="txtDurationB2">Duration</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <label><strong>Third Break</strong></label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="Start Time" id="txtStartTimeB3" />
                            <label class="floating-label" for="txtStartTimeB3">Start Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="time" class="form-control floating-input" placeholder="End Time" id="txtEndTimeB3" />
                            <label class="floating-label" for="txtEndTimeB3">End Time</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Duration" id="txtDurationB3" disabled />
                            <label class="floating-label" for="txtDurationB3">Duration</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateShift">
                    <span class="btn-spinner-icon" id="btnShiftSpinner"></span>
                    <span class="btn-label-text" id="btnShiftText">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Token = localStorage.getItem("authToken");
    var shiftIdUpdate = 0;
    var _shiftCache = {};

    var grid = WMSGrid.create({
        container: 'shiftGrid',
        title: 'All Shifts',
        icon: 'bx-time',
        perPage: 10,
        columns: [
            { field: 'shiftName', header: 'Shift Name', width: '180px' },
            { field: 'startTime', header: 'Start Time', width: '120px' },
            { field: 'endTime', header: 'End Time', width: '120px' },
            { field: 'duration', header: 'Duration', width: '120px' },
            {
                header: 'Status', width: '90px',
                render: function (v, row) {
                    return row.isEnabled
                        ? '<span class="wg-pill wg-pill-green">Active</span>'
                        : '<span class="wg-pill wg-pill-red">Inactive</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="editShift(' + row.shiftID + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteShift(' + row.shiftID + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    $(document).ready(function () {
        loadDataTable();
        setupDurationCalculation('#txtStartTime', '#txtEndTime', '#txtDuration');
        setupDurationCalculation('#txtStartTimeB1', '#txtEndTimeB1', '#txtDurationB1');
        setupDurationCalculation('#txtStartTimeB2', '#txtEndTimeB2', '#txtDurationB2');
        setupDurationCalculation('#txtStartTimeB3', '#txtEndTimeB3', '#txtDurationB3');
    });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET',
            url: '@baseUrl/ShiftMasterAPI/GetAllShifts',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = response.data || [];
                _shiftCache = {};
                rows.forEach(function (r) { _shiftCache[r.shiftID] = r; });
                grid.setData(rows);
                grid.hideLoader();
            },
            error: function () {
                grid.hideLoader();
                showToast('Failed to load shifts. Please try again.', 'error');
            }
        });
    }

    $('#addShift').click(function () {
        resetShiftForm();
        $('#addShiftModel').modal('show');
    });

    $('#btnCreateShift').click(function () {
        var shiftName = $('#txtShiftName').val().trim();
        var startTime = $('#txtStartTime').val();
        var endTime = $('#txtEndTime').val();

        var isValid = true;
        if (!shiftName) { $('#spnShiftName').show(); $('#txtShiftName').addClass('is-invalid'); isValid = false; } else { $('#spnShiftName').hide(); $('#txtShiftName').removeClass('is-invalid'); }
        if (!startTime) { $('#spnStartTime').show(); $('#txtStartTime').addClass('is-invalid'); isValid = false; } else { $('#spnStartTime').hide(); $('#txtStartTime').removeClass('is-invalid'); }
        if (!endTime) { $('#spnEndTime').show(); $('#txtEndTime').addClass('is-invalid'); isValid = false; } else { $('#spnEndTime').hide(); $('#txtEndTime').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateShift', 'Saving...');

        var duration = calculateDuration(startTime, endTime);
        $('#txtDuration').val(duration);

        var shiftDetails = {
            ShiftID: shiftIdUpdate,
            ShiftName: shiftName,
            StartTime: toTimeSpanFormat(startTime),
            EndTime: toTimeSpanFormat(endTime),
            Duration: duration
        };

        $.ajax({
            url: parseInt(shiftIdUpdate) > 0 ? '@baseUrl/ShiftMasterAPI/UpdateShift' : '@baseUrl/ShiftMasterAPI/CreateShift',
            type: 'POST',
            data: JSON.stringify(shiftDetails),
            contentType: 'application/json',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (shiftIdUpdate > 0 ? 'Shift updated successfully.' : 'Shift created successfully.'), 'success');
                    $('#addShiftModel').modal('hide');
                    loadDataTable();
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateShift', shiftIdUpdate > 0 ? 'Update' : 'Save');
                }
            },
            error: function () {
                showToast('An error occurred. Please try again.', 'error');
                setBtnNormal('#btnCreateShift', shiftIdUpdate > 0 ? 'Update' : 'Save');
            }
        });
    });

    function editShift(id) {
        var data = _shiftCache[id];
        if (!data) return;
        resetShiftForm();
        shiftIdUpdate = data.shiftID;
        $('#txtShiftName').val(data.shiftName);
        $('#txtStartTime').val(data.startTime.substring(0, 5));
        $('#txtEndTime').val(data.endTime.substring(0, 5));
        $('#txtDuration').val(data.duration);
        $('#formType').text('Update');
        setBtnNormal('#btnCreateShift', 'Update');
        $('#addShiftModel').modal('show');
    }

    function deleteShift(id) {
        wmsConfirm('Are you sure you want to delete this shift?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/ShiftMasterAPI/Delete',
                type: 'DELETE',
                data: JSON.stringify({ Id: id, DeletedBy: '' }),
                contentType: 'application/json',
                _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess !== false) {
                        showToast('Shift deleted successfully.', 'success');
                        loadDataTable();
                    } else {
                        showToast(response.responseMessage || 'Something went wrong.', 'error');
                    }
                },
                error: function () {
                    showToast('An error occurred while deleting. Please try again.', 'error');
                }
            });
        });
    }

    function resetShiftForm() {
        shiftIdUpdate = 0;
        $('#txtShiftName, #txtStartTime, #txtEndTime, #txtDuration').val('').removeClass('is-invalid');
        $('#txtStartTimeB1, #txtEndTimeB1, #txtDurationB1').val('');
        $('#txtStartTimeB2, #txtEndTimeB2, #txtDurationB2').val('');
        $('#txtStartTimeB3, #txtEndTimeB3, #txtDurationB3').val('');
        $('#spnShiftName, #spnStartTime, #spnEndTime').hide();
        $('#formType').text('Add');
        setBtnNormal('#btnCreateShift', 'Save');
    }

    function toTimeSpanFormat(time) {
        return time.length === 5 ? time + ':00' : time;
    }

    function calculateDuration(start, end) {
        var sh = parseInt(start.split(':')[0]), sm = parseInt(start.split(':')[1]);
        var eh = parseInt(end.split(':')[0]), em = parseInt(end.split(':')[1]);
        var startDate = new Date(2000, 0, 1, sh, sm);
        var endDate = new Date(2000, 0, 1, eh, em);
        var diffMs = endDate - startDate;
        if (diffMs < 0) diffMs += 24 * 60 * 60 * 1000;
        var hrs = Math.floor(diffMs / (1000 * 60 * 60));
        var mins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
        var secs = Math.floor((diffMs % (1000 * 60)) / 1000);
        return String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
    }

    function setupDurationCalculation(startSel, endSel, durationSel) {
        $(startSel + ', ' + endSel).on('change', function () {
            var s = $(startSel).val(), e = $(endSel).val();
            if (s && e) $(durationSel).val(calculateDuration(s, e));
        });
    }
</script>
