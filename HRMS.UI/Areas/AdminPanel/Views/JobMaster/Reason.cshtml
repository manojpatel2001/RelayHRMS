@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Reason";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Reason</h6>
        <button id="addReason" type="button" class="btn btn-primary btn-sm">Add Reason</button>
    </div>
    <div class="card-body">
        <div id="reasonGrid"></div>
    </div>
</div>

<div class="modal fade" id="addReasonModel" tabindex="-1" aria-labelledby="reasonModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reasonModalLabel"><span class="formType">Add</span> Reason</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="form-grid-2">
                    <div class="fg fg-req">
                        <label for="txtReasonName">Reason Name</label>
                        <input type="text" placeholder="Reason Name" id="txtReasonName" />
                        <span class="field-validation-error" id="spnReasonName" style="display:none;">Please Enter Reason Name</span>
                    </div>
                    <div class="fg">
                        <label for="dropdownReasonType">Reason Type</label>
                        <select id="dropdownReasonType">
                            <option value="" selected disabled>Reason Type</option>
                            <option value="AR">Attendance Regularization</option>
                            <option value="OT">OT</option>
                            <option value="GatePass">Gate Pass</option>
                            <option value="Advance">Advance</option>
                            <option value="Increment">Increment</option>
                            <option value="Appraisal">Appraisal</option>
                            <option value="MA">Mobile Attendance</option>
                            <option value="HD">Help Desk</option>
                            <option value="Exit">Exit</option>
                            <option value="Left">Left</option>
                        </select>
                    </div>
                </div>
                <div class="form-grid-3" id="tagPassType" style="display:none;">
                    <div class="fg">
                        <b>Gate Pass Type:</b>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="radio" name="gate" checked id="rdPersonal" style="width:auto;min-height:0" />
                        <label for="rdPersonal" style="margin:0">Personal</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="radio" name="gate" id="rdOfficial" style="width:auto;min-height:0" />
                        <label for="rdOfficial" style="margin:0">Official</label>
                    </div>
                </div>
                <div class="form-grid-2">
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="chkIsActive" style="width:auto;min-height:0" />
                        <label for="chkIsActive" style="margin:0">Is Active</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px" id="TagCommentMandatory">
                        <input type="checkbox" id="chkIsCommentMandatory" style="width:auto;min-height:0" />
                        <label for="chkIsCommentMandatory" style="margin:0">Is Comment Mandatory</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateReason">
                    <span class="btn-spinner-icon" id="btnReasonSpinner"></span>
                    <span class="btn-label-text" id="btnReasonText">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    let ReasonId = 0;
    var _reasonCache = {};

    var grid = WMSGrid.create({
        container: 'reasonGrid',
        title: 'All Reasons',
        icon: 'bx-list-ul',
        perPage: 10,
        columns: [
            { field: 'reasonName', header: 'Reason Name', width: '200px' },
            { field: 'reasonType', header: 'Reason Type', width: '160px' },
            {
                header: 'Active', width: '80px',
                render: function (v, row) {
                    return row.isActive
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Comment Mandatory', width: '140px',
                render: function (v, row) {
                    return row.isCommentMandatory
                        ? '<span class="wg-pill wg-pill-teal">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateReason(' + row.reasonId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteReason(' + row.reasonId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    $(() => {
        $('#dropdownReasonType').change(function () {
            var val = $(this).val();
            $('#TagCommentMandatory').toggle(val === 'AR');
            $('#tagPassType').toggle(val === 'GatePass');
        });
        loadDataTable();
    });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET',
            url: '@baseUrl/ReasonAPI/GetAllReasons',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : [];
                _reasonCache = {};
                rows.forEach(function (r) { _reasonCache[r.reasonId] = r; });
                grid.setData(rows);
                grid.hideLoader();
            },
            error: function () {
                grid.hideLoader();
                showToast('Failed to load reasons. Please try again.', 'error');
            }
        });
    }

    $('#addReason').click(() => {
        resetReasonForm();
        $('#addReasonModel').modal('show');
    });

    $('#btnCreateReason').click(function () {
        var reasonName = $('#txtReasonName').val()?.trim();
        if (!reasonName) { $('#spnReasonName').show(); $('#txtReasonName').addClass('is-invalid'); return; }
        $('#spnReasonName').hide(); $('#txtReasonName').removeClass('is-invalid');

        setBtnLoading('#btnCreateReason', (ReasonId || 0) == 0 ? 'Saving...' : 'Updating...');

        var reasonType = $('#dropdownReasonType').val();
        var gatePassType = null;
        if (reasonType === 'GatePass') {
            gatePassType = $('#rdPersonal').is(':checked') ? 'Personal' : 'Official';
        }

        var model = {
            ReasonId: ReasonId || 0,
            ReasonName: reasonName,
            ReasonType: reasonType,
            GatePassType: gatePassType,
            IsActive: $('#chkIsActive').is(':checked'),
            IsCommentMandatory: $('#chkIsCommentMandatory').is(':checked'),
            CreatedBy: null,
            UpdatedBy: null
        };

        $.ajax({
            url: ReasonId == 0 ? '@baseUrl/ReasonAPI/CreateReason' : '@baseUrl/ReasonAPI/UpdateReason',
            type: ReasonId == 0 ? 'POST' : 'PUT',
            contentType: 'application/json',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(model),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (ReasonId == 0 ? 'Reason created successfully.' : 'Reason updated successfully.'), 'success');
                    loadDataTable();
                    $('#addReasonModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateReason', ReasonId == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Unable to save reason. Please try again.', 'error');
                setBtnNormal('#btnCreateReason', ReasonId == 0 ? 'Save' : 'Update');
            }
        });
    });

    function updateReason(id) {
        var data = _reasonCache[id];
        if (!data) return;
        resetReasonForm();
        ReasonId = data.reasonId || 0;
        $('#txtReasonName').val(data.reasonName || '');
        $('#dropdownReasonType').val(data.reasonType || '');
        $('#TagCommentMandatory').toggle(data.reasonType === 'AR');
        if (data.reasonType === 'GatePass') {
            $('#tagPassType').show();
            if (data.gatePassType === 'Personal') $('#rdPersonal').prop('checked', true);
            else if (data.gatePassType === 'Official') $('#rdOfficial').prop('checked', true);
        } else {
            $('#tagPassType').hide();
        }
        $('#chkIsActive').prop('checked', data.isActive || false);
        $('#chkIsCommentMandatory').prop('checked', data.isCommentMandatory || false);
        $('.formType').text('Update');
        setBtnNormal('#btnCreateReason', 'Update');
        $('#addReasonModel').modal('show');
    }

    function deleteReason(id) {
        wmsConfirm('Are you sure you want to delete this reason?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/ReasonAPI/DeleteReason',
                type: 'DELETE',
                contentType: 'application/json',
                _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: null }),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage || 'Reason deleted successfully.', 'success');
                    } else {
                        showToast(response.responseMessage || 'Something went wrong.', 'error');
                    }
                    loadDataTable();
                },
                error: function () {
                    showToast('An error occurred while deleting. Please try again.', 'error');
                }
            });
        });
    }

    function resetReasonForm() {
        ReasonId = 0;
        $('#txtReasonName').val('').removeClass('is-invalid');
        $('#dropdownReasonType').val('AR');
        $('#spnReasonName').hide();
        $('#tagPassType').hide();
        $('#rdPersonal').prop('checked', true);
        $('#chkIsActive').prop('checked', false);
        $('#chkIsCommentMandatory').prop('checked', false);
        $('#TagCommentMandatory').hide();
        $('.formType').text('Add');
        setBtnNormal('#btnCreateReason', 'Save');
    }
</script>
