@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Manage Department";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage Department</h6>
        <button id="addDepartment" type="button" class="btn btn-primary btn-sm">Add Department</button>
    </div>
    <div class="card-body">
        <div id="departmentGrid"></div>
    </div>
</div>

<div class="modal fade" id="addDepartmentModel" tabindex="-1" aria-labelledby="deptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deptModalLabel"><span id="formType">Add</span> Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" data-trim-input class="form-control floating-input" placeholder="Department Name" id="txtDepartmentName" />
                            <label class="floating-label" for="txtDepartmentName">Department Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnDepartmentName" style="color:red; display:none;">Please Enter Department Name</span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" data-trim-input class="form-control floating-input" placeholder="Department Code" id="txtDepartmentCode" />
                            <label class="floating-label" for="txtDepartmentCode">Department Code <span class="required-star">*</span></label>
                        </div>
                        <span id="spnDepartmentCode" style="color:red; display:none;">Please Enter Department Code</span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group mt-3 d-flex align-items-center gap-2">
                            <label for="txtActive" class="mb-0">IsActive</label>
                            <input type="checkbox" checked id="txtActive" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateDepartment">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    const Token = localStorage.getItem("authToken");
    const userId = localStorage.getItem("EmployeeId");
    let departmentId = 0;
    var _deptCache = {};

    var grid = WMSGrid.create({
        container: 'departmentGrid', title: 'All Departments', icon: 'bx-sitemap', perPage: 10,
        columns: [
            { field: 'departmentName', header: 'Department Name', width: '220px' },
            { field: 'departmentCode', header: 'Department Code', width: '150px' },
            {
                header: 'Active', width: '80px', sortable: false,
                render: function (v, row) {
                    return row.isActive
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="openUpdateDepartment(' + row.departmentId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="openDeleteDepartment(' + row.departmentId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    $(() => { loadDataTable(); });

    $('#addDepartment').click(function () { resetDepartment(); $('#addDepartmentModel').modal('show'); });
    $('#addDepartmentModel').on('hidden.bs.modal', function () { resetDepartment(); });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/DepartmentAPI/GetAllDepartments', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = response.isSuccess ? (response.data || []) : [];
                _deptCache = {};
                rows.forEach(function (r) { _deptCache[r.departmentId] = r; });
                grid.setData(rows); grid.hideLoader();
            },
            error: function () { grid.hideLoader(); showToast('Unable to load departments.', 'error'); }
        });
    }

    $('#btnCreateDepartment').click(function () {
        var deptName = $('#txtDepartmentName').val();
        var deptCode = $('#txtDepartmentCode').val();
        var isActive = $('#txtActive').prop('checked');
        var isValid = true;
        if (!deptName) { $('#spnDepartmentName').show(); $('#txtDepartmentName').addClass('is-invalid'); isValid = false; } else { $('#spnDepartmentName').hide(); $('#txtDepartmentName').removeClass('is-invalid'); }
        if (!deptCode) { $('#spnDepartmentCode').show(); $('#txtDepartmentCode').addClass('is-invalid'); isValid = false; } else { $('#spnDepartmentCode').hide(); $('#txtDepartmentCode').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateDepartment', 'Saving...');
        var createdBy = departmentId == 0 ? userId : null;
        var updatedBy = departmentId == 0 ? null : userId;
        var department = {
            DepartmentId: departmentId, CompanyId: CompanyId,
            DepartmentName: deptName, DepartmentCode: deptCode,
            IsActive: isActive, CreatedBy: createdBy, UpdatedBy: updatedBy
        };

        $.ajax({
            url: departmentId == 0 ? '@baseUrl/DepartmentAPI/CreateDepartment' : '@baseUrl/DepartmentAPI/UpdateDepartment',
            type: departmentId == 0 ? 'POST' : 'PUT',
            data: JSON.stringify(department), contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    showToast(departmentId === 0 ? 'Record created successfully.' : 'Record updated successfully.', 'success');
                    loadDataTable(); resetDepartment(); $('#addDepartmentModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateDepartment', departmentId === 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Unable to save details.', 'error');
                setBtnNormal('#btnCreateDepartment', departmentId === 0 ? 'Save' : 'Update');
            }
        });
    });

    function openUpdateDepartment(id) {
        var data = _deptCache[id];
        if (!data) return;
        resetDepartment();
        $('#txtDepartmentName').val(data.departmentName || '');
        $('#txtDepartmentCode').val(data.departmentCode || '');
        $('#txtActive').prop('checked', data.isActive || false);
        departmentId = data.departmentId;
        setBtnNormal('#btnCreateDepartment', 'Update');
        $('#formType').text('Update');
        $('#addDepartmentModel').modal('show');
    }

    function openDeleteDepartment(id) {
        wmsConfirm('Are you sure you want to delete this department?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/DepartmentAPI/DeleteDepartment', type: 'DELETE',
                data: JSON.stringify({ Id: id, DeletedBy: userId }),
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) { showToast('Record deleted successfully.', 'success'); loadDataTable(); }
                    else { showToast(response.responseMessage || 'Something went wrong.', 'error'); }
                },
                error: function () { showToast('An error occurred while deleting.', 'error'); }
            });
        });
    }

    function resetDepartment() {
        departmentId = 0;
        $('#txtDepartmentName, #txtDepartmentCode').val('').removeClass('is-invalid');
        $('#txtActive').prop('checked', true);
        $('#spnDepartmentName, #spnDepartmentCode').hide();
        $('#formType').text('Add');
        setBtnNormal('#btnCreateDepartment', 'Save');
    }
</script>
