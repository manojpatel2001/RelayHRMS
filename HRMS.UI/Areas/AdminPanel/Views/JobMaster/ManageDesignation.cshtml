@inject IConfiguration Configuration
@{
    ViewData["Title"] = "ManageDesignation";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage Designation</h6>
        <button id="addDesignation" type="button" class="btn btn-primary btn-sm">Add Designation</button>
    </div>
    <div class="card-body">
        <div id="designationGrid"></div>
    </div>
</div>

<div class="modal fade" id="addDesignationModel" tabindex="-1" aria-labelledby="designationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="designationModalLabel"><span id="formType">Add</span> Designation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="form-grid-3">
                    <div class="fg fg-req">
                        <label for="txtDesignationName">Designation Name</label>
                        <input type="text" placeholder="Designation Name" id="txtDesignationName" />
                        <span class="field-validation-error" id="spnDesignationName" style="display:none;">Please Enter Designation Name</span>
                    </div>
                    <div class="fg fg-req">
                        <label for="txtDesignationCode">Designation Code</label>
                        <input type="text" placeholder="Designation Code" id="txtDesignationCode" />
                        <span class="field-validation-error" id="spnDesignationCode" style="display:none;">Please Enter Designation Code</span>
                    </div>
                    <div class="fg">
                        <label for="txtSortingNo">Sorting No</label>
                        <input type="number" value="0" placeholder="Sorting No" id="txtSortingNo" />
                    </div>
                </div>
                <div class="form-grid">
                    <div class="fg">
                        <label for="txtAllow_ReimEligibilityAmount">Allow/Reim Eligibility Amount</label>
                        <input type="text" placeholder="Allow/Reim Eligibility Amount" id="txtAllow_ReimEligibilityAmount" />
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtManagerialPost" style="width:auto;min-height:0" />
                        <label for="txtManagerialPost" style="margin:0">Managerial Post</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtIsMain" style="width:auto;min-height:0" />
                        <label for="txtIsMain" style="margin:0">Is Main</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtActive" style="width:auto;min-height:0" />
                        <label for="txtActive" style="margin:0">Active</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtAbscondingReminderEmail" style="width:auto;min-height:0" />
                        <label for="txtAbscondingReminderEmail" style="margin:0">Absconding Reminder Email</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateDesignation">
                    <span class="btn-spinner-icon" id="btnDesignationSpinner"></span>
                    <span class="btn-label-text" id="btnDesignationText">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    const Token = localStorage.getItem("authToken");
    const userId = localStorage.getItem("EmployeeId");
    var designationIdUpdate = 0;
    var _desgCache = {};

    var grid = WMSGrid.create({
        container: 'designationGrid',
        title: 'All Designations',
        icon: 'bx-briefcase',
        perPage: 10,
        columns: [
            { field: 'designationName', header: 'Designation Name', width: '200px' },
            { field: 'designationCode', header: 'Designation Code', width: '160px' },
            {
                header: 'Main', width: '80px',
                render: function (v, row) {
                    return row.isMain
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            { field: 'sortingNo', header: 'Sort No', width: '80px' },
            {
                header: 'Manager', width: '90px',
                render: function (v, row) {
                    return row.managerialPost
                        ? '<span class="wg-pill wg-pill-teal">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Status', width: '90px',
                render: function (v, row) {
                    return row.isEnabled
                        ? '<span class="wg-pill wg-pill-green">Active</span>'
                        : '<span class="wg-pill wg-pill-red">Inactive</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    var html = '';
                    if (PermGuard.has('edit-jobmaster-managedesignation')) {
                        html += '<button class="wg-btn wg-btn-primary" onclick="updateDesignation(' + row.designationId + ')"><i class="bx bx-edit"></i> Edit</button> ';
                    }
                    if (PermGuard.has('delete-jobmaster-managedesignation')) {
                        html += '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteDesignation(' + row.designationId + ')"><i class="bx bx-trash"></i></button>';
                    }
                    return html;
                }
            }
        ],
        features: { export: true }
    });

    $(() => {
        PermGuard.onReady(function () { loadDataTable(); });
        PermGuard.applyActions('jobmaster-managedesignation', { create: '#addDesignation' });
    });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET',
            url: '@baseUrl/DesignationAPI/GetAllDesignation',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : [];
                _desgCache = {};
                rows.forEach(function (r) { _desgCache[r.designationId] = r; });
                grid.setData(rows);
                grid.hideLoader();
            },
            error: function () {
                grid.hideLoader();
                showToast('Failed to load designations. Please try again.', 'error');
            }
        });
    }

    $('#addDesignation').click(() => {
        resetDesignation();
        $('#addDesignationModel').modal('show');
    });

    $('#btnCreateDesignation').click(() => {
        var txtDesignationName = $('#txtDesignationName').val();
        var txtDesignationCode = $('#txtDesignationCode').val();
        var isValid = true;

        if (!txtDesignationName) { $('#spnDesignationName').show(); $('#txtDesignationName').addClass('is-invalid'); isValid = false; } else { $('#spnDesignationName').hide(); $('#txtDesignationName').removeClass('is-invalid'); }
        if (!txtDesignationCode) { $('#spnDesignationCode').show(); $('#txtDesignationCode').addClass('is-invalid'); isValid = false; } else { $('#spnDesignationCode').hide(); $('#txtDesignationCode').removeClass('is-invalid'); }

        if (!isValid) return;

        setBtnLoading('#btnCreateDesignation', designationIdUpdate == 0 ? 'Saving...' : 'Updating...');

        var designation = {
            DesignationId: designationIdUpdate,
            CompanyId: CompanyId,
            DesignationName: txtDesignationName,
            DesignationCode: txtDesignationCode,
            SortingNo: $('#txtSortingNo').val() || 0,
            ManagerialPost: $('#txtManagerialPost').prop('checked'),
            IsMain: $('#txtIsMain').prop('checked'),
            IsEnabled: $('#txtActive').prop('checked'),
            Allow_ReimEligibilityAmount: $('#txtAllow_ReimEligibilityAmount').val(),
            AbscondingReminderEmail: $('#txtAbscondingReminderEmail').prop('checked')
        };

        $.ajax({
            url: '@baseUrl/DesignationAPI/CreateDesignation',
            type: 'POST',
            data: JSON.stringify(designation),
            contentType: 'application/json',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    showToast(designationIdUpdate === 0 ? 'Designation created successfully.' : 'Designation updated successfully.', 'success');
                    loadDataTable();
                    resetDesignation();
                    $('#addDesignationModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong. Please try again.', 'error');
                    setBtnNormal('#btnCreateDesignation', designationIdUpdate === 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Unable to save details. Please try again.', 'error');
                setBtnNormal('#btnCreateDesignation', designationIdUpdate === 0 ? 'Save' : 'Update');
            }
        });
    });

    function resetDesignation() {
        designationIdUpdate = 0;
        $('#txtDesignationName').val('').removeClass('is-invalid');
        $('#txtDesignationCode').val('').removeClass('is-invalid');
        $('#txtSortingNo').val('0');
        $('#txtAllow_ReimEligibilityAmount').val('');
        $('#txtManagerialPost').prop('checked', false);
        $('#txtIsMain').prop('checked', false);
        $('#txtActive').prop('checked', false);
        $('#txtAbscondingReminderEmail').prop('checked', false);
        $('#spnDesignationName').hide();
        $('#spnDesignationCode').hide();
        $('#formType').text('Add');
        setBtnNormal('#btnCreateDesignation', 'Save');
    }

    function updateDesignation(id) {
        var data = _desgCache[id];
        if (!data) return;
        resetDesignation();
        designationIdUpdate = data.designationId;
        $('#txtDesignationName').val(data.designationName);
        $('#txtDesignationCode').val(data.designationCode);
        $('#txtSortingNo').val(data.sortingNo);
        $('#txtAllow_ReimEligibilityAmount').val(data.allow_ReimEligibilityAmount);
        $('#txtManagerialPost').prop('checked', !!data.managerialPost);
        $('#txtIsMain').prop('checked', !!data.isMain);
        $('#txtActive').prop('checked', !!data.isEnabled);
        $('#txtAbscondingReminderEmail').prop('checked', !!data.abscondingReminderEmail);
        $('#formType').text('Update');
        setBtnNormal('#btnCreateDesignation', 'Update');
        $('#addDesignationModel').modal('show');
    }

    function deleteDesignation(id) {
        wmsConfirm('Are you sure you want to delete this designation?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/DesignationAPI/Delete',
                type: 'DELETE',
                data: JSON.stringify({ Id: id, DeletedBy: userId || '' }),
                contentType: 'application/json',
                _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        showToast('Designation deleted successfully.', 'success');
                        loadDataTable();
                    } else {
                        showToast(response.responseMessage || 'Something went wrong. Please try again.', 'error');
                    }
                },
                error: function () {
                    showToast('An error occurred while deleting. Please try again.', 'error');
                }
            });
        });
    }
</script>
