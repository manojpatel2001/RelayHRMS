@inject IConfiguration Configuration
@{
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage Branch</h6>
        <button id="addBranch" type="button" class="btn btn-primary btn-sm">Add Branch</button>
    </div>
    <div class="card-body">
        <div id="branchGrid"></div>
    </div>
</div>

<div class="modal fade" id="addBranchModel" tabindex="-1" aria-labelledby="branchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="branchModalLabel"><span id="formType">Add</span> Branch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" data-trim-input class="form-control floating-input" placeholder="Branch Name" id="txtBranchName" />
                            <label class="floating-label" for="txtBranchName">Branch Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnBranchName" style="color:red; display:none;">Please Enter Branch Name</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" data-trim-input class="form-control floating-input" placeholder="Branch Code" id="txtBranchCode" />
                            <label class="floating-label" for="txtBranchCode">Branch Code <span class="required-star">*</span></label>
                        </div>
                        <span id="spnBranchCode" style="color:red; display:none;">Please Enter Branch Code</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpStatenew" class="form-control floating-input">
                                <option selected value="">Select</option>
                            </select>
                            <label class="floating-label" for="drpStatenew">State <span class="required-star">*</span></label>
                        </div>
                        <span id="spnStatenew" style="color:red; display:none;">Please Select State</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpCity" class="form-control floating-input">
                                <option selected value="">Select</option>
                            </select>
                            <label class="floating-label" for="drpCity">City <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCity" style="color:red; display:none;">Please Enter City</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpCountry" class="form-control floating-input">
                                <option value="India">India</option>
                            </select>
                            <label class="floating-label" for="drpCountry">Country <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCountry" style="color:red; display:none;">Please Select Country</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" data-trim-input class="form-control floating-input" placeholder="GSTIN No" id="txtGSTINNo" />
                            <label class="floating-label" for="txtGSTINNo">GSTIN No</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <textarea data-trim-input class="form-control floating-input" placeholder="Address" id="txtAddress"></textarea>
                            <label class="floating-label" for="txtAddress">Address</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-4 d-flex align-items-center gap-2">
                            <label for="IsActive" class="mb-0">IsActive</label>
                            <input type="checkbox" checked id="IsActive" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateBranch">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Token = localStorage.getItem("authToken");
    const userId = localStorage.getItem("EmployeeId");
    let branchId = 0;
    var _branchCache = {};

    var grid = WMSGrid.create({
        container: 'branchGrid', title: 'All Branches', icon: 'bx-buildings', perPage: 10,
        columns: [
            { field: 'branchName', header: 'Branch Name', width: '150px' },
            { field: 'branchCode', header: 'Branch Code', width: '110px' },
            { field: 'cityName', header: 'City', width: '110px' },
            { field: 'stateName', header: 'State', width: '120px' },
            { field: 'countryName', header: 'Country', width: '100px' },
            { field: 'address', header: 'Address', width: '160px' },
            { field: 'gstiN_No', header: 'GSTIN No', width: '120px' },
            {
                header: 'Active', width: '80px', sortable: false,
                render: function (v, row) {
                    return row.isActive
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="openUpdateBranch(' + row.branchId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="openDeleteBranch(' + row.branchId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    $(() => { loadDataTable(); BindState(); });

    $('#drpCity').on('focus', function () {
        if ($(this).find('option').length <= 1) { showToast('Please select state first.', 'warn'); }
    });

    function BindState() {
        $.ajax({
            type: 'GET', url: '@baseUrl/StateAPI/GetAllState', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                if (data.isSuccess) {
                    var dd = $('#drpStatenew');
                    dd.empty().append('<option disabled selected value="">Select</option>');
                    $.each(data.data, function (i, s) { dd.append('<option value="' + s.stateId + '">' + s.stateName + '</option>'); });
                }
            }
        });
    }

    function BindCity() {
        var stateId = $('#drpStatenew').val();
        if (!stateId) return $.when();
        return $.ajax({
            type: 'GET', url: '@baseUrl/BranchAPI/GetAllCityByStateId/' + stateId, _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                if (data.isSuccess) {
                    var dd = $('#drpCity');
                    dd.empty().append('<option disabled selected value="">Select</option>');
                    $.each(data.data, function (i, c) { dd.append('<option value="' + c.cityId + '">' + c.cityName + '</option>'); });
                } else { showToast('No city available for this state.', 'warn'); }
            }
        });
    }

    $('#drpStatenew').change(function () { BindCity(); });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/BranchAPI/GetAllBranches', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = response.isSuccess ? (response.data || []) : [];
                _branchCache = {};
                rows.forEach(function (r) { _branchCache[r.branchId] = r; });
                grid.setData(rows); grid.hideLoader();
            },
            error: function () { grid.hideLoader(); showToast('Unable to load branches.', 'error'); }
        });
    }

    $('#addBranch').click(function () { resetBranch(); $('#addBranchModel').modal('show'); });
    $('#addBranchModel').on('hidden.bs.modal', function () { resetBranch(); });

    $('#btnCreateBranch').click(function () {
        var txtBranchName = $('#txtBranchName').val();
        var txtBranchCode = $('#txtBranchCode').val();
        var txtAddress = $('#txtAddress').val() || null;
        var txtCity = $('#drpCity').val();
        var drpStatenew = $('#drpStatenew').val();
        var drpCountry = $('#drpCountry').val();
        var GSTINNo = $('#txtGSTINNo').val() || null;
        var isActive = $('#IsActive').is(':checked');

        var isValid = true;
        if (!txtBranchName) { $('#spnBranchName').show(); $('#txtBranchName').addClass('is-invalid'); isValid = false; } else { $('#spnBranchName').hide(); $('#txtBranchName').removeClass('is-invalid'); }
        if (!txtBranchCode) { $('#spnBranchCode').show(); $('#txtBranchCode').addClass('is-invalid'); isValid = false; } else { $('#spnBranchCode').hide(); $('#txtBranchCode').removeClass('is-invalid'); }
        if (!txtCity) { $('#spnCity').show(); $('#drpCity').addClass('is-invalid'); isValid = false; } else { $('#spnCity').hide(); $('#drpCity').removeClass('is-invalid'); }
        if (!drpStatenew) { $('#spnStatenew').show(); $('#drpStatenew').addClass('is-invalid'); isValid = false; } else { $('#spnStatenew').hide(); $('#drpStatenew').removeClass('is-invalid'); }
        if (!drpCountry) { $('#spnCountry').show(); $('#drpCountry').addClass('is-invalid'); isValid = false; } else { $('#spnCountry').hide(); $('#drpCountry').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateBranch', 'Saving...');
        var createdBy = branchId == 0 ? userId : null;
        var updatedBy = branchId == 0 ? null : userId;
        var branch = {
            BranchId: branchId, BranchName: txtBranchName, BranchCode: txtBranchCode,
            Address: txtAddress, CityId: txtCity, StateId: drpStatenew, CountryName: drpCountry,
            GSTIN_No: GSTINNo, IsActive: isActive, CreatedBy: createdBy, UpdatedBy: updatedBy
        };

        $.ajax({
            url: branchId == 0 ? '@baseUrl/BranchAPI/CreateBranch' : '@baseUrl/BranchAPI/UpdateBranch',
            type: branchId == 0 ? 'POST' : 'PUT',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(branch),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(branchId === 0 ? 'Record created successfully.' : 'Record updated successfully.', 'success');
                    loadDataTable(); resetBranch(); $('#addBranchModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateBranch', branchId === 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Unable to save details.', 'error');
                setBtnNormal('#btnCreateBranch', branchId === 0 ? 'Save' : 'Update');
            }
        });
    });

    function openUpdateBranch(id) {
        var data = _branchCache[id];
        if (!data) return;
        resetBranch();
        $('#txtBranchName').val(data.branchName || '');
        $('#txtBranchCode').val(data.branchCode || '');
        $('#txtAddress').val(data.address || '');
        $('#drpCountry').val(data.countryName || 'India');
        $('#txtGSTINNo').val(data.gstiN_No || '');
        $('#IsActive').prop('checked', data.isActive || false);
        branchId = data.branchId;
        $('#drpStatenew').val(data.stateId || '');
        setBtnNormal('#btnCreateBranch', 'Update');
        $('#formType').text('Update');
        BindCity().done(function () { $('#drpCity').val(data.cityId || ''); });
        $('#addBranchModel').modal('show');
    }

    function openDeleteBranch(id) {
        wmsConfirm('Are you sure you want to delete this branch?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/BranchAPI/DeleteBranch', type: 'DELETE',
                data: JSON.stringify({ id: id, deletedBy: userId }),
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) { showToast('Record deleted successfully.', 'success'); loadDataTable(); }
                    else { showToast(response.responseMessage || 'Something went wrong.', 'error'); }
                },
                error: function () { showToast('An error occurred while deleting.', 'error'); }
            });
        });
    }

    function resetBranch() {
        branchId = 0;
        $('#txtBranchName, #txtBranchCode, #txtAddress, #txtGSTINNo').val('');
        $('#txtBranchName, #txtBranchCode').removeClass('is-invalid');
        $('#drpCity').empty().append('<option selected value="">Select</option>');
        $('#drpCity').removeClass('is-invalid');
        $('#drpStatenew').val('').removeClass('is-invalid');
        $('#drpCountry').val('India').removeClass('is-invalid');
        $('#IsActive').prop('checked', true);
        $('#spnBranchName, #spnBranchCode, #spnCity, #spnCountry, #spnStatenew').hide();
        $('#formType').text('Add');
        setBtnNormal('#btnCreateBranch', 'Save');
    }
</script>
