@inject IConfiguration Configuration
@{
    ViewData["Title"] = "ManageGrade";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage Grade</h6>
        <button id="addDesignation" type="button" class="btn btn-primary btn-sm">Add Grade</button>
    </div>
    <div class="card-body">
        <div id="gradeGrid"></div>
    </div>
</div>

<div class="modal fade" id="addGradeModel" tabindex="-1" aria-labelledby="gradeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gradeModalLabel"><span id="formType">Add</span> Grade</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="form-grid-3">
                    <div class="fg fg-req">
                        <label for="txtGradeName">Grade Name</label>
                        <input type="text" placeholder="Grade Name" id="txtGradeName" />
                        <span class="field-validation-error" id="spnGradeName" style="display:none;">Please Enter Grade Name</span>
                    </div>
                    <div class="fg">
                        <label for="txtDescription">Description</label>
                        <input type="text" placeholder="Description" id="txtDescription" />
                    </div>
                    <div class="fg">
                        <label for="txtBasicSalary">Basic Salary</label>
                        <input type="text" placeholder="Basic Salary" id="txtBasicSalary" />
                    </div>
                </div>
                <div class="form-grid-3">
                    <div class="fg">
                        <label for="txtGovtMinimumBasics">Govt. Minimum Basics</label>
                        <input type="text" placeholder="Govt. Minimum Basics" id="txtGovtMinimumBasics" />
                    </div>
                    <div class="fg">
                        <label for="txtSortingNo">Sorting No</label>
                        <input type="number" placeholder="Sorting No" id="txtSortingNo" />
                    </div>
                    <div class="fg">
                        <label for="txtNoticePeriodDays">Notice Period Days</label>
                        <input type="text" placeholder="Notice Period Days" id="txtNoticePeriodDays" />
                    </div>
                </div>
                <div class="form-grid-3">
                    <div class="fg">
                        <label for="txtNoticePeriodWorkingDays">Notice Period Working Days</label>
                        <input type="text" placeholder="Notice Period Working Days" id="txtNoticePeriodWorkingDays" />
                    </div>
                    <div class="fg">
                        <label for="txtSalaryRange">Salary Range</label>
                        <input type="text" placeholder="Salary Range" id="txtSalaryRange" />
                    </div>
                    <div class="fg">
                        <label for="txtEligibilityAmount">Eligibility Amount</label>
                        <input type="text" placeholder="Eligibility Amount" id="txtEligibilityAmount" />
                    </div>
                </div>
                <div class="form-grid-3">
                    <div class="fg">
                        <label for="drpWagesType">Wages Type</label>
                        <select id="drpWagesType">
                            <option selected="selected" value="0">Select Wages Type</option>
                            <option value="1">Monthly</option>
                            <option value="2">Weekly</option>
                            <option value="3">Daily</option>
                        </select>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtOverTimeApplicable" style="width:auto;min-height:0" />
                        <label for="txtOverTimeApplicable" style="margin:0">OverTime Applicable</label>
                    </div>
                    <div class="fg" style="flex-direction:row;align-items:center;gap:8px">
                        <input type="checkbox" id="txtActive" style="width:auto;min-height:0" />
                        <label for="txtActive" style="margin:0">Active</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateGrade">
                    <span class="btn-spinner-icon" id="btnGradeSpinner"></span>
                    <span class="btn-label-text" id="btnGradeText">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const userId = localStorage.getItem("EmployeeId");
    const Token = localStorage.getItem("authToken");
    var gradeIdUpdate = 0;
    var _gradeCache = {};

    var grid = WMSGrid.create({
        container: 'gradeGrid',
        title: 'All Grades',
        icon: 'bx-layer',
        perPage: 10,
        columns: [
            { field: 'gradeName', header: 'Grade', width: '180px' },
            { field: 'description', header: 'Description', width: '200px' },
            { field: 'eligibilityAmount', header: 'Eligibility Amount', width: '160px' },
            { field: 'sorting_No', header: 'Sort No', width: '80px' },
            {
                header: 'Status', width: '90px',
                render: function (v, row) {
                    return row.isEnabled
                        ? '<span class="wg-pill wg-pill-green">Active</span>'
                        : '<span class="wg-pill wg-pill-red">Inactive</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateGrade(' + row.gradeId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteGrade(' + row.gradeId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    $(() => { loadDataTable(); });

    function loadDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET',
            url: '@baseUrl/GradeAPI/GetAllGrade',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : (data.data || []);
                _gradeCache = {};
                rows.forEach(function (r) { _gradeCache[r.gradeId] = r; });
                grid.setData(rows);
                grid.hideLoader();
            },
            error: function () {
                grid.hideLoader();
                showToast('Failed to load grades. Please try again.', 'error');
            }
        });
    }

    $('#addDesignation').click(() => {
        clearGradeForm();
        $('#addGradeModel').modal('show');
    });

    $('#btnCreateGrade').click(() => {
        var txtGradeName = $('#txtGradeName').val();
        if (!txtGradeName) { $('#spnGradeName').show(); $('#txtGradeName').addClass('is-invalid'); return; }
        $('#spnGradeName').hide(); $('#txtGradeName').removeClass('is-invalid');

        setBtnLoading('#btnCreateGrade', gradeIdUpdate == 0 ? 'Saving...' : 'Updating...');

        var Grade = {
            GradeId: gradeIdUpdate,
            GradeName: txtGradeName,
            Description: $('#txtDescription').val(),
            BasicSalary: $('#txtBasicSalary').val(),
            Govt_MinimumBasics: $('#txtGovtMinimumBasics').val(),
            NoticePeriodDays: $('#txtNoticePeriodDays').val(),
            NoticePeriodWorkingDays: $('#txtNoticePeriodWorkingDays').val(),
            SalaryRange: $('#txtSalaryRange').val(),
            IsEnabled: $('#txtActive').prop('checked'),
            EligibilityAmount: $('#txtEligibilityAmount').val(),
            WagesType: $('#drpWagesType option:selected').text(),
            OverTimeApplicable: $('#txtOverTimeApplicable').prop('checked'),
            Sorting_No: $('#txtSortingNo').val() || 0,
            CreatedBy: gradeIdUpdate == 0 ? userId : null,
            UpdatedBy: gradeIdUpdate != 0 ? userId : null
        };

        $.ajax({
            url: gradeIdUpdate == 0 ? '@baseUrl/GradeAPI/CreateGrade' : '@baseUrl/GradeAPI/UpdateGrade',
            type: gradeIdUpdate == 0 ? 'POST' : 'PUT',
            data: JSON.stringify(Grade),
            contentType: 'application/json',
            _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess !== false) {
                    showToast(gradeIdUpdate == 0 ? 'Grade created successfully.' : 'Grade updated successfully.', 'success');
                    loadDataTable();
                    clearGradeForm();
                    $('#addGradeModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateGrade', gradeIdUpdate == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast(gradeIdUpdate == 0 ? 'Unable to create grade.' : 'Unable to update grade.', 'error');
                setBtnNormal('#btnCreateGrade', gradeIdUpdate == 0 ? 'Save' : 'Update');
            }
        });
    });

    function updateGrade(id) {
        var data = _gradeCache[id];
        if (!data) return;
        clearGradeForm();
        gradeIdUpdate = data.gradeId;
        $('#txtGradeName').val(data.gradeName);
        $('#txtDescription').val(data.description);
        $('#txtBasicSalary').val(data.basicSalary);
        $('#txtGovtMinimumBasics').val(data.govt_MinimumBasics);
        $('#txtSortingNo').val(data.sorting_No);
        $('#txtNoticePeriodDays').val(data.noticePeriodDays);
        $('#txtNoticePeriodWorkingDays').val(data.noticePeriodWorkingDays);
        $('#txtSalaryRange').val(data.salaryRange);
        $('#txtEligibilityAmount').val(data.eligibilityAmount);
        if (data.wagesType) {
            $('#drpWagesType option').each(function () { if ($(this).text() === data.wagesType) $(this).prop('selected', true); });
        } else {
            $('#drpWagesType').val('0');
        }
        $('#txtOverTimeApplicable').prop('checked', !!data.overTimeApplicable);
        $('#txtActive').prop('checked', !!data.isEnabled);
        $('#formType').text('Update');
        setBtnNormal('#btnCreateGrade', 'Update');
        $('#addGradeModel').modal('show');
    }

    function deleteGrade(id) {
        wmsConfirm('Are you sure you want to delete this grade?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/GradeAPI/Delete',
                type: 'DELETE',
                data: JSON.stringify({ Id: id, DeletedBy: userId }),
                contentType: 'application/json',
                _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess !== false) {
                        showToast('Grade deleted successfully.', 'success');
                        loadDataTable();
                    } else {
                        showToast(response.responseMessage || 'Something went wrong.', 'error');
                    }
                },
                error: function () {
                    showToast('An error occurred while deleting. Please try again.', 'error');
                }
            });
        });
    }

    function clearGradeForm() {
        gradeIdUpdate = 0;
        $('#txtGradeName').val('').removeClass('is-invalid');
        $('#txtDescription').val('');
        $('#txtBasicSalary').val('');
        $('#txtGovtMinimumBasics').val('');
        $('#txtSortingNo').val('0');
        $('#txtNoticePeriodDays').val('');
        $('#txtNoticePeriodWorkingDays').val('');
        $('#txtSalaryRange').val('');
        $('#txtEligibilityAmount').val('');
        $('#drpWagesType').val('0');
        $('#txtOverTimeApplicable').prop('checked', false);
        $('#txtActive').prop('checked', false);
        $('#spnGradeName').hide();
        $('#formType').text('Add');
        setBtnNormal('#btnCreateGrade', 'Save');
    }
</script>
