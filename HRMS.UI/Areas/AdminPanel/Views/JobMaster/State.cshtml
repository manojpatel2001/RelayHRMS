@inject IConfiguration Configuration
@{
    ViewData["Title"] = "ManageState";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}
<style>
    .nav-tabs { border-bottom: none !important; }
    .nav-tabs .nav-link { color: #333; background-color: #f1f1f1; border: 1px solid transparent; }
    .nav-tabs .nav-link.active { color: white !important; background-color: #2395c6 !important; border-color: #2395c6 #2395c6 #fff; }
</style>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage State</h6>
        <div class="d-flex gap-2">
            <button id="addState" type="button" class="btn btn-primary btn-sm">Add State</button>
            <button id="addCity" type="button" class="btn btn-primary btn-sm d-none">Add City</button>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 mt-3 ms-3">
        <ul class="nav nav-tabs" id="manageSateTabs" role="tablist">
            <li class="nav-item me-2" role="presentation">
                <button class="nav-link active py-2" data-bs-toggle="tab" data-bs-target="#typeTab" type="button" role="tab" data-tabname="Manage State">Manage State</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#priorityTab" type="button" role="tab" data-tabname="Manage City">Manage City</button>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <div id="StateGrid" class="grid-section">
            <div id="stateWmsGrid"></div>
        </div>
        <div id="CityGrid" class="grid-section d-none">
            <div id="cityWmsGrid"></div>
        </div>
    </div>
</div>

<!-- State Modal -->
<div class="modal fade" id="addStateModel" tabindex="-1" aria-labelledby="stateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stateModalLabel"><span class="FormType">Add</span> State</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="State Name" id="txtStatetName" />
                            <label class="floating-label" for="txtStatetName">State Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnStateName" style="color:red; display:none;">Please Enter State Name</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpCountry" class="form-select floating-input">
                                <option selected disabled value="">Select</option>
                                <option value="India">India</option>
                            </select>
                            <label class="floating-label" for="drpCountry">Country Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCountry" style="color:red; display:none;">Please Select Country.</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpDeduction" class="form-select floating-input">
                                <option selected disabled value="">Select</option>
                                <option value="Monthly">Monthly</option>
                                <option value="Quaterly">Quaterly</option>
                                <option value="Half Yearly">Half Yearly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                            <label class="floating-label" for="drpDeduction">Deduction Type</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="PT Deduction Month" id="txtMonth" />
                            <label class="floating-label" for="txtMonth">PT Deduction Month</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Enrollment Certificate No" id="txtCertificateno" />
                            <label class="floating-label" for="txtCertificateno">Enrollment Certificate No</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="ESIC State Code" id="txtesicStatecode" />
                            <label class="floating-label" for="txtesicStatecode">ESIC State Code</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="ESIC Registered Office Address" id="txtAddress" />
                            <label class="floating-label" for="txtAddress">ESIC Registered Office Address</label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group mt-3 position-relative">
                            <label>Applicable PT Setting For Male/Female</label>
                            <input type="checkbox" class="form-control-input" id="txtActive" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateState">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- City Modal -->
<div class="modal fade" id="addCityModel" tabindex="-1" aria-labelledby="cityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cityModalLabel"><span class="formType">Add</span> City</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="City Name" id="txtCityName" />
                            <label class="floating-label" for="txtCityName">City Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCityName" style="color:red; display:none;">Please Enter City Name</span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mt-3 position-relative">
                            <select id="dropdownState" class="form-select floating-input">
                                <option value="" selected disabled>Select</option>
                            </select>
                            <label class="floating-label" for="dropdownState">State <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCityState" style="color:red; display:none;">Please Select State</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mt-3 position-relative">
                            <select id="drpCityCountry" class="form-select floating-input">
                                <option selected disabled value="">Select</option>
                                <option value="India">India</option>
                            </select>
                            <label class="floating-label" for="drpCityCountry">Country Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnCityCountry" style="color:red; display:none;">Please Select Country.</span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mt-3 position-relative">
                            <textarea class="form-control floating-input" placeholder="Remarks" id="txtRemarks"></textarea>
                            <label class="floating-label" for="txtRemarks">Remarks</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateCity">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Token = localStorage.getItem("authToken");
    const user = localStorage.getItem('EmployeeId');
    var stateId = 0;
    var CityID = 0;
    var _stateCache = {};
    var _cityCache = {};

    var stateGrid = WMSGrid.create({
        container: 'stateWmsGrid',
        title: 'All States',
        icon: 'bx-map',
        perPage: 10,
        columns: [
            { field: 'stateName', header: 'State Name', width: '160px' },
            { field: 'countryName', header: 'Country', width: '120px' },
            { field: 'ptDeductionType', header: 'PT Deduction Type', width: '140px' },
            { field: 'ptDeductionPeriod', header: 'PT Month', width: '100px' },
            { field: 'enrollmentCertificateNo', header: 'Cert. No', width: '120px' },
            { field: 'esicStateCode', header: 'ESIC Code', width: '100px' },
            {
                header: 'PT Male/Female', width: '130px',
                render: function (v, row) {
                    return row.applicablePTSettingForMale_Female
                        ? '<span class="wg-pill wg-pill-green">Active</span>'
                        : '<span class="wg-pill wg-pill-red">Inactive</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateState(' + row.stateId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteState(' + row.stateId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    var cityGrid = WMSGrid.create({
        container: 'cityWmsGrid',
        title: 'All Cities',
        icon: 'bx-buildings',
        perPage: 10,
        columns: [
            { field: 'cityName', header: 'City Name', width: '160px' },
            { field: 'stateName', header: 'State', width: '140px' },
            { field: 'country', header: 'Country', width: '120px' },
            { field: 'remarks', header: 'Remarks', width: '160px' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateCity(' + row.cityID + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteCity(' + row.cityID + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    $(document).ready(function () {
        loadStateData();
        loadCityData();
        bindStates();

        $('#manageSateTabs .nav-link').on('click', function () {
            var tabName = $(this).data('tabname');
            $('#manageSateTabs .nav-link').removeClass('active');
            $(this).addClass('active');
            if (tabName === 'Manage State') {
                $('#addState').removeClass('d-none'); $('#addCity').addClass('d-none');
                $('#StateGrid').removeClass('d-none'); $('#CityGrid').addClass('d-none');
            } else {
                $('#addState').addClass('d-none'); $('#addCity').removeClass('d-none');
                $('#StateGrid').addClass('d-none'); $('#CityGrid').removeClass('d-none');
            }
        });
    });

    function loadStateData() {
        stateGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/StateAPI/GetAllState', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.data || [];
                _stateCache = {};
                rows.forEach(function (r) { _stateCache[r.stateId] = r; });
                stateGrid.setData(rows); stateGrid.hideLoader();
            },
            error: function () { stateGrid.hideLoader(); showToast('Failed to load states.', 'error'); }
        });
    }

    function loadCityData() {
        cityGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/CityAPI/GetAllCity', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : [];
                _cityCache = {};
                rows.forEach(function (r) { _cityCache[r.cityID] = r; });
                cityGrid.setData(rows); cityGrid.hideLoader();
            },
            error: function () { cityGrid.hideLoader(); showToast('Failed to load cities.', 'error'); }
        });
    }

    function bindStates() {
        $.ajax({
            type: 'GET', url: '@baseUrl/StateAPI/GetAllState', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    var dd = $('#dropdownState').empty().append('<option value="" disabled selected>Select</option>');
                    $.each(response.data, function (i, s) { dd.append('<option value="' + s.stateId + '">' + s.stateName + '</option>'); });
                }
            }
        });
    }

    $('#addState').click(function () { resetStateForm(); $('#addStateModel').modal('show'); });
    $('#addCity').click(function () { resetCityFormFields(); $('#addCityModel').modal('show'); });

    $('#btnCreateState').click(function () {
        var name = $('#txtStatetName').val().trim(), country = $('#drpCountry').val();
        var isValid = true;
        if (!name) { $('#spnStateName').show(); $('#txtStatetName').addClass('is-invalid'); isValid = false; } else { $('#spnStateName').hide(); $('#txtStatetName').removeClass('is-invalid'); }
        if (!country) { $('#spnCountry').show(); $('#drpCountry').addClass('is-invalid'); isValid = false; } else { $('#spnCountry').hide(); $('#drpCountry').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateState', 'Saving...');
        var state = {
            StateId: stateId, StateName: name, CountryName: country,
            PTDeductionType: $('#drpDeduction').val() || null,
            EnrollmentCertificateNo: $('#txtCertificateno').val().trim() || null,
            ESICStateCode: $('#txtesicStatecode').val().trim() || null,
            PTDeductionPeriod: $('#txtMonth').val().trim() || null,
            ESICRegisteredOfficeAddress: $('#txtAddress').val().trim() || null,
            ApplicablePTSettingForMale_Female: $('#txtActive').prop('checked'),
            CreatedBy: stateId == 0 ? user : null,
            UpdatedBy: stateId == 0 ? null : user
        };
        $.ajax({
            url: stateId == 0 ? '@baseUrl/StateAPI/CreateState' : '@baseUrl/StateAPI/UpdateState',
            type: stateId == 0 ? 'POST' : 'PUT',
            data: JSON.stringify(state), contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (stateId == 0 ? 'State created.' : 'State updated.'), 'success');
                    loadStateData(); $('#addStateModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateState', stateId == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Something went wrong. Please try again.', 'error');
                setBtnNormal('#btnCreateState', stateId == 0 ? 'Save' : 'Update');
            }
        });
    });

    function resetStateForm() {
        stateId = 0;
        $('#txtStatetName, #txtCertificateno, #txtesicStatecode, #txtAddress, #txtMonth').val('');
        $('#txtStatetName').removeClass('is-invalid');
        $('#drpCountry, #drpDeduction').val('');
        $('#drpCountry').removeClass('is-invalid');
        $('#txtActive').prop('checked', false);
        $('#spnStateName, #spnCountry').hide();
        $('.FormType').text('Add');
        setBtnNormal('#btnCreateState', 'Save');
    }

    function updateState(id) {
        var data = _stateCache[id];
        if (!data) return;
        resetStateForm();
        stateId = data.stateId;
        $('#txtStatetName').val(data.stateName || '');
        $('#drpCountry').val(data.countryName || '');
        $('#drpDeduction').val(data.ptDeductionType || '');
        $('#txtMonth').val(data.ptDeductionPeriod || '');
        $('#txtCertificateno').val(data.enrollmentCertificateNo || '');
        $('#txtesicStatecode').val(data.esicStateCode || '');
        $('#txtAddress').val(data.esicRegisteredOfficeAddress || '');
        $('#txtActive').prop('checked', !!data.applicablePTSettingForMale_Female);
        $('.FormType').text('Update');
        setBtnNormal('#btnCreateState', 'Update');
        $('#addStateModel').modal('show');
    }

    function deleteState(id) {
        wmsConfirm('Are you sure you want to delete this state?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/StateAPI/DeleteState', type: 'DELETE',
                data: JSON.stringify({ Id: id, DeletedBy: user }), contentType: 'application/json',
                _silentLoader: true, headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    showToast(response.responseMessage || (response.isSuccess ? 'State deleted.' : 'Something went wrong.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) loadStateData();
                },
                error: function () { showToast('An error occurred while deleting.', 'error'); }
            });
        });
    }

    $('#btnCreateCity').click(function () {
        var cityName = $('#txtCityName').val().trim();
        var stateVal = $('#dropdownState').val();
        var country = $('#drpCityCountry').val();
        var isValid = true;
        if (!cityName) { $('#spnCityName').show(); $('#txtCityName').addClass('is-invalid'); isValid = false; } else { $('#spnCityName').hide(); $('#txtCityName').removeClass('is-invalid'); }
        if (!stateVal) { $('#spnCityState').show(); $('#dropdownState').addClass('is-invalid'); isValid = false; } else { $('#spnCityState').hide(); $('#dropdownState').removeClass('is-invalid'); }
        if (!country) { $('#spnCityCountry').show(); $('#drpCityCountry').addClass('is-invalid'); isValid = false; } else { $('#spnCityCountry').hide(); $('#drpCityCountry').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateCity', 'Saving...');
        var data = {
            CityID: CityID, CityName: cityName, StateId: stateVal, Country: country,
            Remarks: $('#txtRemarks').val(),
            CreatedBy: CityID == 0 ? user : null, UpdatedBy: CityID == 0 ? null : user
        };
        $.ajax({
            url: '@baseUrl/CityAPI/CreateCity', type: 'POST',
            data: JSON.stringify(data), contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (CityID == 0 ? 'City created.' : 'City updated.'), 'success');
                    loadCityData(); resetCityFormFields(); $('#addCityModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateCity', CityID == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Something went wrong.', 'error');
                setBtnNormal('#btnCreateCity', CityID == 0 ? 'Save' : 'Update');
            }
        });
    });

    function updateCity(id) {
        var data = _cityCache[id];
        if (!data) return;
        resetCityFormFields();
        CityID = data.cityID || 0;
        $('#txtCityName').val(data.cityName || '');
        $('#drpCityCountry').val(data.country || '');
        $('#dropdownState').val(data.stateId || '');
        $('#txtRemarks').val(data.remarks || '');
        $('.formType').text('Update');
        setBtnNormal('#btnCreateCity', 'Update');
        $('#addCityModel').modal('show');
    }

    function deleteCity(id) {
        wmsConfirm('Are you sure you want to delete this city?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/CityAPI/DeleteCity', type: 'DELETE',
                data: JSON.stringify({ id: id, deletedBy: user }), contentType: 'application/json',
                _silentLoader: true, headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'City deleted.') : (response.responseMessage || 'Something went wrong.'), response.isSuccess ? 'success' : 'error');
                    loadCityData();
                },
                error: function () { showToast('An error occurred while deleting.', 'error'); }
            });
        });
    }

    function resetCityFormFields() {
        CityID = 0;
        $('#txtCityName, #txtRemarks').val('');
        $('#txtCityName').removeClass('is-invalid');
        $('#dropdownState, #drpCityCountry').val('');
        $('#dropdownState, #drpCityCountry').removeClass('is-invalid');
        $('#spnCityState, #spnCityName, #spnCityCountry').hide();
        $('.formType').text('Add');
        setBtnNormal('#btnCreateCity', 'Save');
    }
</script>
