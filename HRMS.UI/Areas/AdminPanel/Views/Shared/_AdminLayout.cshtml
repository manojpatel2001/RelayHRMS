@inject IConfiguration Configuration
@{
    string baseUrlLayout   = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri                = new Uri(baseUrlLayout);
    string baseDomainUrl   = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — HRMS" : "Admin Panel — HRMS")</title>
    <link rel="icon" href="~/assets/images/relayfevicon.jpeg" type="image/png" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

    <!-- WMS Core CSS (layout, palette, theme) -->
    <link rel="stylesheet" href="~/assets/css/wms-site.css" />
    <link rel="stylesheet" href="~/assets/css/app-shell.css" />
    <link rel="stylesheet" href="~/assets/css/wms-theme.css" />
    <!-- HRMS UI enhancements (stat cards, notification, modals) -->
    <link rel="stylesheet" href="~/assets/css/hrms-ui.css" />

    <!-- Bootstrap (modals, forms, grid used inside page content) -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />

    <!-- HRMS Plugin / App CSS -->
    <link href="~/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/plugins/notifications/css/lobibox.min.css" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/css/export-data.css" rel="stylesheet" />
    <link href="~/assets/css/company-modal.css" rel="stylesheet" />
    <link href="~/assets/css/compoffleavemodal.css" rel="stylesheet" />

    <!-- DevExpress -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.common.css" />
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.light.css" />
    <!-- HRMS Premium UI — must be last to override Bootstrap + DevExtreme -->
    <link rel="stylesheet" href="~/assets/css/hrms-premium.css" />

    <!-- Theme must run before first paint to avoid palette flash -->
    <script src="~/assets/js/wms-theme.js"></script>

    <style>
        /* ── Notification: #notificationCount hidden, synced to dot by hrms-shell.js ── */
        #notificationCount { display:none; }
        .hrms-notif-wrap { position: relative; }
        /* notification-dropdown + notification-item styles → hrms-ui.css */

        /* ── Company name in top nav (slim) ── */
        .hrms-company-name {
            font-size: 11px; color: rgba(255,255,255,.75);
            max-width: 200px; overflow: hidden;
            white-space: nowrap; text-overflow: ellipsis;
        }
        .companyNameLayout {
            max-width: 200px; overflow-x: auto; white-space: nowrap;
            scrollbar-width: none;
        }
        .companyNameLayout::-webkit-scrollbar { display: none; }

        /* ── Tooltip on company name ── */
        .custom-tooltip { display:inline-block; cursor:grab; position:relative; }
        .custom-tooltip::after {
            content: attr(data-tooltip);
            position: absolute; bottom:150%; left:0;
            background: rgba(0,0,0,.85); color:#fff;
            padding: 6px 10px; border-radius:5px;
            white-space: normal; max-width:400px;
            opacity:0; pointer-events:none;
            transition: opacity .3s;
            z-index: 1000;
        }
        .custom-tooltip:hover::after { opacity:1; }

        /* ── Sidebar sub-group (nested within a group body) ── */
        .sb-subgroup { margin: 3px 6px 3px 6px; border-radius:6px; overflow:hidden; }
        .sb-subgroup .sb-group-hdr {
            font-size: 11.5px !important;
            padding: 5px 10px !important;
            background: linear-gradient(to bottom, #6b8fa8, #5a7e99) !important;
        }
        .sb-link-indent { padding-left: 28px !important; font-size: 11.5px !important; }

        /* ── DX grid td padding ── */
        .dx-datagrid .dx-row > td { padding: 2px; }
        .dx-row > td, .dx-row > tr > td { border: 1px solid #ced4da; }
        .dx-widget { font-size: 12px; }

        /* ── Bootstrap dropdown submenu (kept for page content) ── */
        .dropdown-submenu { position: relative; }
        .dropdown-submenu .sub-menu {
            display: none; position: absolute;
            top:0; left:100%;
            background:#fff; border:1px solid #ccc;
            border-radius:4px; box-shadow:0 0 10px rgba(0,0,0,.1);
            min-width:160px; padding:0; z-index:999;
        }
        .dropdown-submenu:hover .sub-menu { display: block; }

        /* ── readonly menu items ── */
        .readonly { pointer-events:none; color:gray; opacity:.3; cursor:not-allowed; }

        /* ══════════════════════════════════════════════════════════════
           UI REFINEMENTS  (WMS-native sizing, minimal overrides)
           ══════════════════════════════════════════════════════════════ */

        /* ── HRMS brand text (replaces logo image) ── */
        .hrms-brand-text {
            font-size: 15px;
            font-weight: 900;
            letter-spacing: 3.5px;
            color: #ffffff;
            text-transform: uppercase;
            font-family: 'Inter', sans-serif;
            padding: 0 2px;
        }
        .as-top-nav-brand { text-decoration: none !important; }

        /* ── Company name + page subtitle in gradient project header ── */
        .hrms-proj-header-brand {
            display: flex;
            align-items: baseline;
            gap: 10px;
            min-width: 0;
            overflow: hidden;
        }
        .hrms-company-headline {
            font-size: 17px;
            font-weight: 800;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-family: 'Inter', sans-serif;
            white-space: nowrap;
            flex-shrink: 0;
            text-shadow: 0 1px 6px rgba(0,0,0,.25);
        }
        .hrms-proj-separator {
            color: rgba(255,255,255,.35);
            font-size: 17px;
            font-weight: 200;
            flex-shrink: 0;
        }
        .hrms-page-subtitle {
            font-size: 12px;
            color: rgba(255,255,255,.70);
            font-weight: 400;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-top: 2px;
        }

        /* ── Sidebar: hide left icon, add right › arrow only ── */
        .sidebar .sb-link { position: relative !important; padding-right: 26px !important; }
        .sidebar .sb-link .sb-ic { display: none !important; }
        .sidebar .sb-link::after {
            content: '›';
            font-size: 18px;
            line-height: 1;
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            opacity: .30;
            transition: opacity .15s, transform .15s;
        }
        .sidebar .sb-link:hover::after     { opacity: .80; transform: translateY(-50%) translateX(2px); }
        .sidebar .sb-link.is-active::after { opacity: 1;   transform: translateY(-50%) translateX(2px); }

        /* ── Dashboard link right arrow ── */
        .sidebar .sb-dash-link { position: relative !important; padding-right: 26px !important; }
        .sidebar .sb-dash-link::after {
            content: '›';
            font-size: 18px;
            line-height: 1;
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            opacity: .30;
            transition: opacity .15s;
        }
        .sidebar .sb-dash-link:hover::after     { opacity: .80; }
        .sidebar .sb-dash-link.is-active::after { opacity: 1; }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ Page Loader — WMS premium dot spinner ══ -->
    <div id="loader" class="wg-page-loader" style="display:none">
        <div class="wg-dot-spinner">
            <div></div><div></div><div></div><div></div><div></div><div></div>
            <div></div><div></div><div></div><div></div><div></div><div></div>
        </div>
        <p class="hrms-loader-text">Please wait<span class="hrms-loader-dots"></span></p>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         APP SHELL WRAP
         ══════════════════════════════════════════════════════════════ -->
    <div id="app-shell-wrap">
        <div class="app-shell">

            <!-- ══ SLIM TOP NAV (28 px) ══════════════════════════════════ -->
            <header class="as-top-nav">
                <div class="as-top-nav-left">
                    <a class="as-top-nav-brand" href="@UIBaseUrlLayout/AdminPanel/Home/index">
                        <span class="hrms-brand-text">HRMS</span>
                    </a>
                </div>
                <div class="as-top-nav-right">
                    <!-- Company name -->
                    <span class="hrms-company-name companyNameLayout">
                        <span class="custom-tooltip"></span>
                    </span>
                    <span class="as-top-nav-sep">|</span>
                    <span class="as-top-nav-loggedas">Logged in as <strong id="as-userName" class="user-name">User</strong></span>
                    <span class="as-top-nav-sep">|</span>
                    <!-- My Account dropdown -->
                    <div id="as-user-dd-wrap" class="as-user-dd-wrap">
                        <button type="button" class="as-top-nav-link" id="as-myAccountBtn"
                                onclick="AppShell.toggleUserDd();return false;" title="My Account">
                            My Account <i class="bx bx-chevron-down" style="font-size:11px;margin-left:2px;opacity:.85"></i>
                        </button>
                        <div id="as-user-dd" class="as-user-dd">
                            <div id="dropdown-user-info" style="padding:12px 16px;border-bottom:1px solid #F1F5F9;background:#F8FAFC">
                                <div style="font-size:13px;font-weight:700;color:#1e3a5f" id="dropdown-name"></div>
                                <div style="font-size:11px;color:#64748B" id="dropdown-role">Admin Panel</div>
                            </div>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Employee/MyProfile" class="as-user-dd-item">
                                <i class="bx bx-user"></i> My Profile
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Home/index" class="as-user-dd-item" id="dropdownESSSwitch" style="display:none;">
                                <i class="bx bx-transfer"></i> Switch to ESS
                            </a>
                            <a href="javascript:;" class="as-user-dd-item" id="companyDrop">
                                <i class="bx bx-building"></i> Change Company
                            </a>
                            <a href="@UIBaseUrlLayout/AuthManage/ChangePassword" class="as-user-dd-item" id="changePassword">
                                <i class="bx bx-key"></i> Change Password
                            </a>
                            <div style="border-top:1px solid #F1F5F9;margin:4px 0"></div>
                            <a href="#" class="as-user-dd-item as-user-dd-signout" id="btnLogout">
                                <i class="bx bx-log-out"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- ══ PROJECT HEADER (40 px) ════════════════════════════════ -->
            <header class="as-project-header">
                <div class="as-project-header-left">
                    <button class="as-top-nav-link" id="mob-menu-btn"
                            onclick="hrmsToggleMobSidebar()" title="Toggle navigation"
                            style="padding:3px 8px;background:rgba(255,255,255,.12)">
                        <i class="bx bx-menu"></i>
                    </button>
                    <div class="hrms-proj-header-brand">
                        <span class="hrms-company-headline" id="hrms-company-header">HRMS</span>
                        <span class="hrms-proj-separator">|</span>
                        <span class="hrms-page-subtitle" id="topbar-page-title">@(ViewData["Title"]?.ToString() ?? "Admin Panel")</span>
                    </div>
                </div>
                <div class="as-project-header-right">
                    <!-- HRMS Notification Bell -->
                    <div class="hrms-notif-wrap" id="bellIcon">
                        <button type="button" class="as-notif-btn" id="notif-bell-btn"
                                title="Notifications"
                                onclick="document.getElementById('notificationDropdown').classList.toggle('show');event.stopPropagation();">
                            <i class="bx bx-bell"></i>
                            <span class="as-notif-dot" id="notif-dot-topbar">0</span>
                        </button>
                        <!-- Populated by notification-remainder.js -->
                        <div class="notification-dropdown" id="notificationDropdown">
                            <div class="notification-header">
                                <h6><i class="bx bx-bell"></i> Notifications</h6>
                                <button class="notif-mark-all-btn" type="button"
                                        onclick="if(typeof readNotification==='function') readNotification('All'); loadAllUnreadNotification(); return false;">
                                    Mark all read
                                </button>
                            </div>
                            <div class="notification-list" id="notificationList"></div>
                            <div class="notification-footer">
                                <a href="#" class="notif-view-all" onclick="return false;">
                                    View all notifications <i class="bx bx-right-arrow-alt"></i>
                                </a>
                            </div>
                        </div>
                        <!-- Hidden HRMS badge element (kept for JS compat) -->
                        <span id="notificationCount" style="display:none">0</span>
                    </div>

                    <!-- Search pages (reads from #sidebar-link via app-shell.js) -->
                    <div class="as-quick-search-wrap">
                        <span class="as-quick-search-icon"><i class="bx bx-search"></i></span>
                        <input type="text" id="as-globalSearch" class="as-quick-search-input"
                               placeholder="Search pages…"
                               autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" />
                        <div id="as-globalSearch-dd" class="as-quick-search-dd"></div>
                    </div>

                    <!-- Jump to page -->
                    <select id="as-jumpToPage" class="as-jump-select" title="Jump to a page" aria-label="Jump to a page">
                        <option value="">Jump to a page…</option>
                    </select>
                </div>
            </header>

            <!-- ══ MODULE TABS (38 px) ═══════════════════════════════════ -->
            <nav class="as-tab-nav" id="as-tab-nav" role="tablist" aria-label="Module tabs">
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/Home/index"
                   data-tab-ctrl="home"><i class="bx bx-home-circle"></i><span>Dashboard</span></a>
                <a class="as-tab-nav-item adminControlPanelMenu" href="@UIBaseUrlLayout/AdminPanel/ManageRole/ManageRole"
                   data-tab-ctrl="managerolepermission"><i class="bx bx-cog"></i><span>Control Panel</span></a>
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/JobMaster/State"
                   data-tab-ctrl="jobmaster"><i class="bx bx-briefcase"></i><span>Job Master</span></a>
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/OtherMaster/OrganizationPolicy"
                   data-tab-ctrl="othermaster"><i class="bx bx-list-ul"></i><span>Other Master</span></a>
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/CompanyStructure/BankMaster"
                   data-tab-ctrl="companystructure"><i class="bx bx-building-house"></i><span>Company Structure</span></a>
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/EmployeeMaster/EmployeeMaster"
                   data-tab-ctrl="employeemaster"><i class="bx bx-user"></i><span>Employee</span></a>
                <a class="as-tab-nav-item" href="@UIBaseUrlLayout/AdminPanel/SalaryDetails/Index"
                   data-tab-ctrl="salarydetails"><i class="bx bx-wallet"></i><span>Salary Details</span></a>
                <a class="as-tab-nav-item adminLeaveMenu" href="@UIBaseUrlLayout/EmployeePanel/Leave/AdminLeaveApproval"
                   data-tab-ctrl="leave"><i class="bx bx-calendar"></i><span>Leave</span></a>
                <a class="as-tab-nav-item adminLetterMenu" href="@UIBaseUrlLayout/AdminPanel/Report/Reports"
                   data-tab-ctrl="report"><i class="bx bx-bar-chart-alt-2"></i><span>Reports</span></a>
            </nav>

            <!-- ══ SIDEBAR ════════════════════════════════════════════════ -->
            <aside class="sidebar" id="sidebar">
                <!-- Profile block — populated by logindetails.js -->
                <div class="sb-user" id="sb-profile-block">
                    <div class="sb-user-av" id="sb-user-av">
                        <img src="@baseDomainUrl/default-image/avatar-2.png"
                             alt="Profile" id="sb-user-avatar-img" class="profileImage"
                             style="width:100%;height:100%;object-fit:cover;border-radius:50%" />
                    </div>
                    <div class="sb-user-info" id="sb-user-info">
                        <div class="sb-user-name user-name" id="sb-user-name">Loading…</div>
                        <div class="sb-user-role designation" id="sb-user-role">Admin Panel</div>
                    </div>
                </div>

                <!-- ══ Nav Links ══ -->
                <div id="sidebar-link">

                    <!-- Dashboard -->
                    <a href="@UIBaseUrlLayout/AdminPanel/Home/index" class="sb-dash-link">
                        <span class="sb-ic"><i class="bx bx-home-circle"></i></span>
                        <span class="sb-label">Dashboard</span>
                    </a>

                    <!-- ── Control Panel ── -->
                    <div class="sb-group collapsed adminControlPanelMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-cog"></i></span>
                            <span class="sb-group-hdr-txt">Control Panel</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <!-- Company Info sub-group (hidden until permission shows it) -->
                            <div class="sb-subgroup sb-group collapsed" id="sidebarCompanyInfo" style="display:none;">
                                <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)" style="font-size:11.5px;padding:5px 10px;">
                                    <span class="sb-group-hdr-ic"><i class="bx bx-building"></i></span>
                                    <span class="sb-group-hdr-txt">Company Info</span>
                                    <i class="bx bx-chevron-down sb-group-chevron"></i>
                                </div>
                                <div class="sb-group-body">
                                    <a href="@UIBaseUrlLayout/AdminPanel/CompanyInformation/CompanyDetails" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Company Details</span>
                                    </a>
                                </div>
                            </div>
                            <!-- Role & Permission sub-group -->
                            <div class="sb-subgroup sb-group collapsed">
                                <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)" style="font-size:11.5px;padding:5px 10px;">
                                    <span class="sb-group-hdr-ic"><i class="bx bx-shield"></i></span>
                                    <span class="sb-group-hdr-txt">Role &amp; Permission</span>
                                    <i class="bx bx-chevron-down sb-group-chevron"></i>
                                </div>
                                <div class="sb-group-body">
                                    <a href="@UIBaseUrlLayout/AdminPanel/ManageRole/ManageRole" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Manage Role</span>
                                    </a>
                                    <a href="@UIBaseUrlLayout/AdminPanel/PermissionMaster/PermissionMaster" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Manage Permission</span>
                                    </a>
                                </div>
                            </div>
                            <a href="@UIBaseUrlLayout/AdminPanel/ImportData/Index" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-import"></i></span>
                                <span class="sb-label">Import Data</span>
                            </a>
                            <!-- Assign Permission sub-group -->
                            <div class="sb-subgroup sb-group collapsed">
                                <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)" style="font-size:11.5px;padding:5px 10px;">
                                    <span class="sb-group-hdr-ic"><i class="bx bx-key"></i></span>
                                    <span class="sb-group-hdr-txt">Assign Permission</span>
                                    <i class="bx bx-chevron-down sb-group-chevron"></i>
                                </div>
                                <div class="sb-group-body">
                                    <a href="@UIBaseUrlLayout/AdminPanel/ManageRolePermission/RolePermission" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Assign Role</span>
                                    </a>
                                    <a href="@UIBaseUrlLayout/AdminPanel/ManageUserPermission/UserPermission" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Assign User</span>
                                    </a>
                                </div>
                            </div>
                            <!-- Approvals sub-group -->
                            <div class="sb-subgroup sb-group collapsed">
                                <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)" style="font-size:11.5px;padding:5px 10px;">
                                    <span class="sb-group-hdr-ic"><i class="bx bx-check-circle"></i></span>
                                    <span class="sb-group-hdr-txt">Approvals</span>
                                    <i class="bx bx-chevron-down sb-group-chevron"></i>
                                </div>
                                <div class="sb-group-body">
                                    <a href="@UIBaseUrlLayout/AdminPanel/ManageApproval/ApprovalMaster" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Approval Master</span>
                                    </a>
                                    <a href="@UIBaseUrlLayout/AdminPanel/ManageApproval/ApprovalManagement" class="sb-link sb-link-indent">
                                        <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                        <span class="sb-label">Approval Management</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Job Master ── -->
                    <div class="sb-group collapsed">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-briefcase"></i></span>
                            <span class="sb-group-hdr-txt">Job Master</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/State" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">State Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/ManageBranch" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Branch Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/ManageDepartment" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Department Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/ManageDesignation" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Designation Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/ManageGrade" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Grade Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/Reason" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Reason Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/ManageShifts" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Shift Master</span>
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/JobMaster/NewsAnnouncement" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
