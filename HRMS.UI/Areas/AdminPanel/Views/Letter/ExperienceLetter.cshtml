@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Experience Letter";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<meta charset="UTF-8">
<title>Experience Letter</title>

<!-- DevExtreme -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devextreme@23.2.3/dist/css/dx.light.css">

<style>
    #branchDropdown {
        min-width: 220px;
    }

    #employeeGrid {
        height: calc(100vh - 420px);
        min-height: 350px;
    }

    .no-data-message {
        text-align: center;
        padding: 40px;
        color: #6c757d;
        font-style: italic;
        font-size: 14px;
    }

    .custom-modal-width {
        max-width: 95% !important;
        width: 95% !important;
    }

    #experienceLetterBody {
        overflow-y: auto;
        max-height: 75vh;
    }

    /* ── Experience Letter Styles ── */
    .experience-letter-container {
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
        padding: 60px 70px;
        background: #fff;
        border: 1px solid #ddd;
        font-family: 'Calibri', 'Arial', sans-serif;
        font-size: 15px;
        line-height: 1.6;
        box-sizing: border-box;
        color: #222;
    }

    .el-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 28px;
    }

    .el-ref {
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .el-date {
        font-size: 14px;
        font-weight: 700;
        color: #222;
    }

    .el-logo {
        text-align: right;
        margin-bottom: 20px;
    }

        .el-logo img {
            max-width: 220px;
            height: auto;
        }

    .el-to-block {
        margin-bottom: 28px;
        font-size: 15px;
    }

        .el-to-block p {
            margin: 3px 0;
        }

    .el-emp-name {
        color: #c0392b;
        font-weight: 700;
        text-decoration: underline;
    }

    .el-title {
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        text-decoration: underline;
        margin: 28px 0 22px;
        color: #222;
    }

    .el-dear {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .el-dear-name {
        color: #c0392b;
    }

    .el-body p {
        text-align: justify;
        line-height: 2;
        margin-bottom: 18px;
        font-size: 15px;
    }

    .el-highlight {
        color: #c0392b;
        font-weight: 700;
    }

    .el-highlight-ul {
        color: #c0392b;
        font-weight: 700;
        text-decoration: underline;
    }

    .el-signoff {
        margin-top: 40px;
        font-size: 15px;
    }

        .el-signoff p {
            margin: 3px 0;
        }

    .el-divider {
        border: none;
        border-top: 2px solid #3f4d6b;
        margin: 40px 0 10px;
    }

    .el-footer {
        text-align: center;
        font-size: 12px;
        color: #555;
    }

        .el-footer p {
            margin: 4px 0;
        }

    /* grid loader */
    .grid-loader {
        position: absolute;
        display: none;
        inset: 0;
        background: rgba(255, 255, 255, 0.6);
        z-index: 10;
    }

        .grid-loader.d-flex {
            display: flex !important;
        }

    .grid-logo-spinner {
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Experience Letter Generation</h6>
            <button type="button" class="btn btn-secondary btn-sm" onclick="goBack()">Back</button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 220px;min-width:200px;">
                    <label for="branchDropdown">Branch</label>
                    <div id="branchDropdown"></div>
                </div>

                <div class="fg" style="flex:0 1 130px;min-width:120px;">
                    <label for="yearSelect">Year</label>
                    <select id="yearSelect"></select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnfind" onclick="onFind()">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Find</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="onClear()">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="recordCount" class="mb-2" style="display:none;font-weight:600;"></div>

            <div class="d-flex flex-wrap align-items-end gap-3 mb-3" id="searchViewContainer" style="display:none;">
                <div class="fg" style="flex:1 1 260px;min-width:220px;">
                    <label for="employeeSearch">Search Employees</label>
                    <input type="text" id="employeeSearch" placeholder="Search employees..." />
                </div>
            </div>

            <div id="actionButtonsContainer" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm" id="btnView">View</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnDownloadMultiple">Download PDF</button>
                </div>
            </div>

            <div class="grid-wrapper" style="position: relative;" id="gridTag">
                <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column">
                    <img src="@baseDomainUrl/loders/loder.png" class="grid-logo-spinner" />
                    <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                </div>

                <div class="no-data-message" id="noDataMessage">
                    No data to display. Please select a branch and click Find to load employee data.
                </div>

                <div id="employeeGrid"></div>
            </div>
        </div>
    </div>

</div>

<!-- Experience Letter Modal -->
<div class="modal fade" id="experienceLetterModal" tabindex="-1" aria-labelledby="experienceLetterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl custom-modal-width">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Experience Letter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="experienceLetterBody">
                <!-- Experience letter injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnDownloadPDF">Download PDF</button>
            </div>
        </div>
    </div>
</div>

<!-- PDF Generation Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    const Empid      = parseInt(localStorage.getItem("EmployeeId"));
    const Role       = localStorage.getItem("RoleSlug");
    const Token      = localStorage.getItem("authToken");
    const savedCompany   = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compname   = companyDetails.CompanyName;
    const CompanyId  = companyDetails.CompanyId;

    let originalEmployeeData = [];
    let currentEmployeeData  = null;
    let hrManagerData        = null;

    /* ── Init ── */
    $(document).ready(function () {
        populateYearDropdown();
        BindBranchDropdown();
        fetchLetterInformation();
        hideDataElements();
    });

    $('#yearSelect').on('change', function () {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];
        if (selectedBranchIds && selectedBranchIds.length > 0) {
            onFind();
        }
    });

    /* ── UI helpers ── */
    function hideDataElements() {
        $('#recordCount').hide();
        $('#searchViewContainer').hide();
        $('#actionButtonsContainer').hide();
        $('#noDataMessage').show();
        $('#employeeGrid').hide();
    }

    function showDataElements() {
        $('#recordCount').show();
        $('#searchViewContainer').show();
        $('#actionButtonsContainer').show();
        $('#noDataMessage').hide();
        $('#employeeGrid').show();
    }

    function goBack() { window.history.back(); }

    /* ── Year dropdown ── */
    function populateYearDropdown() {
        const startYear   = 2025;
        const currentYear = new Date().getFullYear();
        const yearDropdown = $("#yearSelect");
        yearDropdown.empty();
        for (let year = currentYear; year >= startYear; year--) {
            yearDropdown.append(`<option value="${year}">${year}</option>`);
        }
        yearDropdown.val(currentYear);
    }

    /* ── Branch dropdown ── */
    function BindBranchDropdown() {
        $.ajax({
            url: '@baseDomainUrl/api/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response?.data?.length > 0) {
                    $("#branchDropdown").dxTagBox({
                        items: response.data,
                        displayExpr: "branchName",
                        valueExpr: "branchId",
                        placeholder: "--Select Branch--",
                        showSelectionControls: true,
                        searchEnabled: true,
                        showClearButton: true,
                        maxDisplayedTags: 3,
                        applyValueMode: "instantly",
                        multiline: false,
                        minSearchLength: 0,
                        width: "100%"
                    });
                }
            },
            error: function () {
                console.error('Failed to load branches');
                showToast('Failed to load branches.', 'error');
            }
        });
    }

    /* ── Fetch HR / signatory info ── */
    function fetchLetterInformation() {
        $.ajax({
            url: '@baseDomainUrl/api/ReportAPI/GetLetterInformation',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response && response.isSuccess && response.data) {
                    if (Array.isArray(response.data) && response.data.length > 0) {
                        hrManagerData = response.data[0];
                    } else {
                        hrManagerData = { fullName: 'HR Manager', designation: 'Director' };
                    }
                } else {
                    hrManagerData = { fullName: 'HR Manager', designation: 'Director' };
                }
            },
            error: function () {
                hrManagerData = { fullName: 'HR Manager', designation: 'Director' };
            }
        });
    }

    /* ── Record count ── */
    function updateRecordCount() {
        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) {
            const filteredCount = grid.getVisibleRows().length;
            $('#recordCount').text(`${filteredCount} Records found.`);
            $('#recordCount').css('color', filteredCount > 0 ? '#28a745' : '#dc3545');
        }
    }

    /* ── Find ── */
    function onFind() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];

        if (!selectedBranchIds || selectedBranchIds.length === 0) {
            showToast('Please select at least one branch.', 'warn');
            return;
        }

        const selectedYear   = $('#yearSelect').val();
        const branchIdsParam = selectedBranchIds.join(',');
        const letterType     = 'EXL';

        $('#grid-loader').addClass('d-flex').show();
        hideDataElements();

        $.ajax({
            url: `@baseDomainUrl/api/ReportAPI/GetAllLeftEmployee/${CompanyId}?BranchId=${branchIdsParam}&Year=${selectedYear}&LetterType=${letterType}`,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                const employeeData = response.data || response;
                originalEmployeeData = employeeData;

                if (employeeData && employeeData.length > 0) {
                    showDataElements();

                    const grid = $("#employeeGrid").dxDataGrid({
                        dataSource: employeeData,
                        keyExpr: "id",
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        showBorders: true,
                        columnAutoWidth: true,
                        paging: { enabled: false },
                        scrolling: { mode: "standard", useNative: true, showScrollbar: "always" },
                        searchPanel: { visible: false },
                        height: 500,
                        columns: [
                            { dataField: "employeeCode", caption: "Employee Code", width: 150 },
                            { dataField: "id", caption: "EmployeeId", visible: false },
                            { dataField: "fullName", caption: "Employee Name" },
                            { dataField: "branchName", caption: "Branch", width: 150 }
                        ],
                        onContentReady: function () { updateRecordCount(); }
                    }).dxDataGrid("instance");

                    $('#employeeSearch').off('input').on('input', function () {
                        const searchValue = $(this).val();
                        if (searchValue) {
                            grid.filter([
                                ['fullName', 'contains', searchValue],
                                'or',
                                ['employeeCode', 'contains', searchValue],
                                'or',
                                ['branchName', 'contains', searchValue]
                            ]);
                        } else {
                            grid.clearFilter();
                        }
                        setTimeout(updateRecordCount, 100);
                    });

                    $('#recordCount').text(`${employeeData.length} Records found.`).css('color', '#28a745');
                } else {
                    hideDataElements();
                    $('#noDataMessage').text('No employees found for the selected branch(es).').show();
                }

                $('#grid-loader').removeClass('d-flex').hide();
            },
            error: function () {
                $('#grid-loader').removeClass('d-flex').hide();
                hideDataElements();
                $('#noDataMessage').text('Failed to load employees. Please try again.').show();
                showToast('Failed to load employees.', 'error');
            }
        });
    }

    /* ── Clear ── */
    function onClear() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        if (branchTagBox) branchTagBox.option("value", []);
        $('#yearSelect').val(new Date().getFullYear());

        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) grid.option("dataSource", []);

        hideDataElements();
        $('#noDataMessage').text('No data to display. Please select a branch and click Find to load employee data.');
        $('#employeeSearch').val('');
        originalEmployeeData = [];
    }

    /* ── View (single employee) ── */
    $('#btnView').on('click', function () {
        const grid    = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }
        if (selected.length > 1) {
            showToast('Please select only one employee to view.', 'warn');
            return;
        }

        const employeeId = selected[0].id;
        const letterType = 'EXL';
        const $btnView   = $(this);
        $btnView.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...');

        $.ajax({
            url: `@baseDomainUrl/api/ReportAPI/GetEmployeeDetailsForLetter?EmployeeId=${employeeId}&LetterType=${letterType}`,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                if (response && response.isSuccess) {
                    let employeeData = response.data || response.Data;
                    if (Array.isArray(employeeData)) {
                        if (employeeData.length === 0) {
                            showToast('No employee data found.', 'error');
                            return;
                        }
                        employeeData = employeeData[0];
                    }
                    currentEmployeeData = employeeData;
                    renderExperienceLetter(employeeData);
                    new bootstrap.Modal(document.getElementById('experienceLetterModal')).show();
                } else {
                    showToast(response.responseMessage || response.ResponseMessage || 'Failed to fetch employee details.', 'error');
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching employee details:", error);
                showToast(`Failed to fetch employee details: ${error}`, 'error');
            },
            complete: function () {
                $btnView.prop('disabled', false).html('View');
            }
        });
    });

    /* ── Download Multiple PDFs ── */
    $('#btnDownloadMultiple').on('click', function () {
        const grid    = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }

        const $btn       = $(this);
        const letterType = 'EXL';
        setBtnLoading($btn, 'Generating...');

        let completedCount = 0;
        const totalCount   = selected.length;

        selected.forEach((employee) => {
            $.ajax({
                url: `@baseDomainUrl/api/ReportAPI/GetEmployeeDetailsForLetter?EmployeeId=${employee.id}&LetterType=${letterType}`,
                type: "GET",
                headers: { 'Authorization': 'Bearer ' + Token },
                dataType: "json",
                success: function (response) {
                    if (response && response.isSuccess) {
                        let employeeData = response.data || response.Data;
                        if (Array.isArray(employeeData)) {
                            if (employeeData.length > 0) {
                                employeeData = employeeData[0];
                            } else {
                                finalize();
                                return;
                            }
                        }
                        generatePDFForEmployee(employeeData, finalize);
                    } else {
                        finalize();
                    }
                },
                error: function () { finalize(); }
            });
        });

        function finalize() {
            completedCount++;
            if (completedCount === totalCount) {
                setBtnNormal($btn, 'Download PDF');
                showToast(`${totalCount} PDF(s) generated successfully!`, 'success');
            }
        }
    });

    /* ── Generate PDF for one employee ── */
    function generatePDFForEmployee(data, callback) {
        const tempContainer = $('<div>').css({
            position: 'absolute', left: '-9999px', top: '0'
        }).appendTo('body');

        tempContainer.html(generateLetterHTML(data));
        const element = tempContainer.find('.experience-letter-container')[0];

        html2canvas(element, { scale: 2, logging: false, useCORS: true }).then(canvas => {
            const imgData = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');

            const imgWidth  = 210;
            const pageHeight = 297;
            const imgHeight = (canvas.height * imgWidth) / canvas.width;
            let heightLeft  = imgHeight;
            let position    = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            pdf.save(`Experience_Letter_${data.employeeCode}_${new Date().getTime()}.pdf`);
            tempContainer.remove();
            if (callback) callback();
        }).catch(error => {
            console.error('PDF generation error:', error);
            tempContainer.remove();
            if (callback) callback();
        });
    }

    /* ══════════════════════════════════════════════
       generateLetterHTML  –  UPDATED FORMAT (docx)
    ══════════════════════════════════════════════ */
    function generateLetterHTML(data) {

        /* date helper */
        const formatDate = (dateStr) => {
            if (!dateStr) return 'N/A';
            const d = new Date(dateStr);
            return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
        };

        const today         = formatDate(new Date().toISOString());
        const currentYear   = new Date().getFullYear();
        const logoUrl       = '/assets/images/relaylogo.jpeg';

        /* HR / signatory details */


        /* Gender-based prefix & pronouns */
        let titlePrefix = 'Mr./Ms.';
        if      (data.gender === 'Male')   titlePrefix = 'Mr.';
        else if (data.gender === 'Female') titlePrefix = 'Ms.';
        else if (data.fullName?.startsWith('Mr.'))              titlePrefix = 'Mr.';
        else if (data.fullName?.startsWith('Mrs.') || data.fullName?.startsWith('Ms.')) titlePrefix = 'Ms.';

        const pronoun   = data.gender === 'Male'   ? 'his'
                        : data.gender === 'Female' ? 'her'
                        : 'his/her';

        /* Clean name & last name */
        let cleanName = (data.fullName || '[Name]').replace(/^(Mr\.|Mrs\.|Ms\.)\s*/i, '').trim();
        const lastName = cleanName.split(' ').pop();

        /* Job details */
        const designation  = data.designationName  || data.designation  || '[Designation]';
        const department   = data.departmentName   || data.department   || '[Department]';
        const branch       = data.branchName       || '[Branch]';
        const joiningDate  = formatDate(data.joiningDate   || data.dateOfJoining);
        const relievingDate= formatDate(data.lastDate      || data.relievingDate);
        const empCode      = data.employeeCode || 'N/A';
        const refNo        = data.refNumber;
        const companyAddress = data.companyAddress ||
            '406, Kataria Arcade, Behind Adani CNG Pump, Off - S.G. Highway, Makarba, Ahmedabad - 380051, Gujarat, India';
        const signatoryName  = data.directorName || 'Mr. Atri Patel';
        const signatoryDesig =  'Director';

        return `
        <div class="experience-letter-container">

            <!-- ① Top bar: Ref No  |  Date -->
            <div class="el-topbar">
                <span class="el-ref">Ref No: ${refNo}</span>
                <span class="el-date">Date: ${today}</span>
            </div>

            <!-- ② Logo (right-aligned) -->
            <div class="el-logo">
                <img src="${logoUrl}" alt="Company Logo" onerror="this.style.display='none'" />
            </div>

            <!-- ③ To block -->
            <div class="el-to-block">
                <p>To,</p>
                <p>
                    <strong>Employee Name:</strong>
                    ${titlePrefix}
                    <span class="el-emp-name">${cleanName}</span>
                </p>
                <p><strong>Employee Code:</strong> ${empCode}</p>
                <p><strong>Branch:</strong> ${branch}</p>
            </div>

            <!-- ④ Subject -->
            <div class="el-title">To Whomsoever It May Concern</div>

            <!-- ⑤ Dear line -->
            <p class="el-dear">
                Dear ${titlePrefix} <span class="el-dear-name">${lastName}</span>,
            </p>

            <!-- ⑥ Body -->
            <div class="el-body">
                <p>
                    This is to certify that
                    <span class="el-highlight-ul">${titlePrefix} ${cleanName}</span>
                    has worked in our organization as
                    <span class="el-highlight">&ldquo;${designation} - ${department}&rdquo;</span>
                    for
                    <span class="el-highlight">&ldquo;${branch}&rdquo;</span>
                    branch from <strong>${joiningDate}</strong> to <strong>${relievingDate}</strong>.
                </p>

                <p>
                    During ${pronoun} tenure of service, we found ${pronoun} character and
                    conduct are to be satisfactory.
                </p>

                <p>
                    We wish ${pronoun} all the best in ${pronoun} future endeavors.
                </p>
            </div>

            <!-- ⑦ Sign-off -->
            <div class="el-signoff">
                <p><strong>Best Regards,</strong></p>
                <p>Sincerely,</p>
                <br>
                <p class="el-highlight"><strong>${Compname}</strong></p>
                <p class="el-highlight-ul"><strong>${signatoryName}</strong></p>
                <p><strong>${signatoryDesig}</strong></p>
            </div>

            <!-- ⑧ Divider -->
            <hr class="el-divider" />

            <!-- ⑨ Footer -->
            <div class="el-footer">
                <p><strong>${companyAddress}</strong></p>
                <p>Note: This is a computer-generated statement hence no signature required.</p>
            </div>

        </div>`;
    }

    /* ── Render in modal ── */
    function renderExperienceLetter(data) {
        $('#experienceLetterBody').html(generateLetterHTML(data));
    }

    /* ── Download PDF from modal ── */
    $('#btnDownloadPDF').on('click', function () {
        const $btn = $(this);
        $btn.prop('disabled', true).addClass('btn-loading');

        const element = document.getElementById('experienceLetterBody')
                                .querySelector('.experience-letter-container');

        html2canvas(element, { scale: 2, logging: false, useCORS: true }).then(canvas => {
            const imgData = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');

            const imgWidth   = 210;
            const pageHeight = 297;
            const imgHeight  = (canvas.height * imgWidth) / canvas.width;
            let heightLeft   = imgHeight;
            let position     = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            pdf.save(`Experience_Letter_${currentEmployeeData.employeeCode}_${new Date().getTime()}.pdf`);
            $btn.prop('disabled', false).removeClass('btn-loading');
        }).catch(error => {
            console.error('PDF generation error:', error);
            showToast('Failed to generate PDF.', 'error');
            $btn.prop('disabled', false).removeClass('btn-loading');
        });
    });

    /* ── Clear selection on modal close ── */
    $('#experienceLetterModal').on('hidden.bs.modal', function () {
        const grid = $('#employeeGrid').dxDataGrid("instance");
        if (grid) grid.clearSelection();
    });
</script>
