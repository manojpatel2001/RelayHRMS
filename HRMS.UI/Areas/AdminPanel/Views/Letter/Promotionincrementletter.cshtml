@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Promotion / Increment Letter";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<meta charset="UTF-8">
<title>Promotion / Increment Letter</title>

<!-- DevExtreme -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devextreme@23.2.3/dist/css/dx.light.css">

<style>
    #branchDropdown {
        min-width: 220px;
    }

    #employeeGrid {
        height: calc(100vh - 420px);
        min-height: 350px;
    }

    .no-data-message {
        text-align: center;
        padding: 40px;
        color: #6c757d;
        font-style: italic;
        font-size: 14px;
    }

    .custom-modal-width {
        max-width: 95% !important;
        width: 95% !important;
    }

    #letterBody {
        overflow-y: auto;
        max-height: 75vh;
    }

    .grid-loader {
        position: absolute;
        display: none;
        inset: 0;
        background: rgba(255, 255, 255, 0.6);
        z-index: 10;
    }

        .grid-loader.d-flex {
            display: flex !important;
        }

    .grid-logo-spinner {
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Letter type badge in header */
    .letter-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 12px;
        margin-left: 10px;
    }

        .letter-badge.increment {
            background-color: #27ae60;
            color: white;
        }

        .letter-badge.promotion {
            background-color: #e67e22;
            color: white;
        }

    /* Letter type indicator strip */
    .letter-type-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

        .letter-type-indicator.increment {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #27ae60;
        }

        .letter-type-indicator.promotion {
            background-color: #fde8d8;
            color: #7b3f00;
            border-left: 4px solid #e67e22;
        }

        .letter-type-indicator .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .letter-type-indicator.increment .dot {
            background-color: #27ae60;
        }

        .letter-type-indicator.promotion .dot {
            background-color: #e67e22;
        }

    /* Dynamic action-button color based on letter type */
    .increment-btn {
        background-color: #27ae60 !important;
        border-color: #27ae60 !important;
    }

    .promotion-btn {
        background-color: #e67e22 !important;
        border-color: #e67e22 !important;
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0" id="pageHeader">
                <span id="headerTitle">LETTER GENERATION</span>
                <span class="letter-badge increment" id="headerBadge">INCREMENT</span>
            </h6>
            <button type="button" class="btn btn-secondary btn-sm" onclick="goBack()">Back</button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                <div class="fg fg-req" style="flex:1 1 220px;min-width:200px;">
                    <label for="branchDropdown">Branch</label>
                    <div id="branchDropdown"></div>
                </div>

                <div class="fg" style="flex:0 1 130px;min-width:120px;">
                    <label for="yearSelect">Year</label>
                    <select id="yearSelect"></select>
                </div>

                <div class="fg" style="flex:0 1 160px;min-width:140px;">
                    <label for="letterTypeSelect">Letter Type</label>
                    <select id="letterTypeSelect">
                        <option value="increment">Increment</option>
                        <option value="promotion">Promotion</option>
                    </select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnfind" onclick="onFind()">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Find</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="onClear()">Clear</button>
                </div>
            </div>

            <!-- Indicator strip below filters -->
            <div class="letter-type-indicator increment mb-3" id="letterTypeIndicator">
                <span class="dot"></span>
                <span id="indicatorText">Showing Increment letter employees</span>
            </div>

            <div class="divider"></div>

            <div id="recordCount" class="mb-2" style="display:none;font-weight:600;"></div>

            <div class="d-flex flex-wrap align-items-end gap-3 mb-3" id="searchViewContainer" style="display:none;">
                <div class="fg" style="flex:1 1 260px;min-width:220px;">
                    <label for="employeeSearch">Search Employees</label>
                    <input type="text" id="employeeSearch" placeholder="Search employees..." />
                </div>
            </div>

            <div id="actionButtonsContainer" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm increment-btn" id="btnView">View</button>
                    <button type="button" class="btn btn-primary btn-sm increment-btn" id="btnDownloadMultiple">Download PDF</button>
                </div>
            </div>

            <div class="grid-wrapper" style="position: relative;" id="gridTag">
                <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column">
                    <img src="@baseDomainUrl/loders/loder.png" class="grid-logo-spinner" />
                    <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                </div>

                <div class="no-data-message" id="noDataMessage">
                    No data to display. Please select a branch and click Find to load employee data.
                </div>

                <div id="employeeGrid"></div>
            </div>
        </div>
    </div>

</div>

<!-- ══ LETTER MODAL ══ -->
<div class="modal fade" id="letterModal" tabindex="-1" aria-labelledby="letterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl custom-modal-width">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Letter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="letterBody">
                <!-- Letter HTML will be injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnDownloadPDF">Download PDF</button>
            </div>
        </div>
    </div>
</div>

<!-- PDF Generation Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    const Empid        = parseInt(localStorage.getItem("EmployeeId"));
    const Role         = localStorage.getItem("RoleSlug");
    const Token        = localStorage.getItem("authToken");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compname     = companyDetails.CompanyName;
    const CompanyId    = companyDetails.CompanyId;

    let originalEmployeeData = [];
    let currentEmployeeData  = null;
    let hrManagerData        = null;
    let currentLetterType    = 'increment'; // 'increment' | 'promotion'

    // ── On Ready ──────────────────────────────────────────────────────────────
    $(document).ready(function () {
        populateYearDropdown();
        BindBranchDropdown();
        fetchLetterInformation();
        hideDataElements();
        updateLetterTypeUI('increment');

        // Letter type change handler
        $('#letterTypeSelect').on('change', function () {
            currentLetterType = $(this).val();
            updateLetterTypeUI(currentLetterType);

            // Auto re-find if branch already selected
            const branchTagBox = $("#branchDropdown").dxTagBox("instance");
            const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];
            if (selectedBranchIds && selectedBranchIds.length > 0) {
                onFind();
            } else {
                hideDataElements();
                resetNoDataMessage();
            }
        });

        $('#yearSelect').on('change', function () {
            const branchTagBox = $("#branchDropdown").dxTagBox("instance");
            const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];
            if (selectedBranchIds && selectedBranchIds.length > 0) {
                onFind();
            }
        });
    });

    // ── UI: Update everything when letter type changes ─────────────────────────
    function updateLetterTypeUI(type) {
        const isIncrement = (type === 'increment');
        const label       = isIncrement ? 'INCREMENT' : 'PROMOTION';
        const labelLower  = isIncrement ? 'Increment' : 'Promotion';
        const colorClass  = isIncrement ? 'increment' : 'promotion';
        const antiClass   = isIncrement ? 'promotion' : 'increment';

        // Header badge
        $('#headerBadge').text(label).removeClass(antiClass).addClass(colorClass);
        $('#headerTitle').text(labelLower.toUpperCase() + ' LETTER GENERATION');

        // Indicator strip
        $('#letterTypeIndicator').removeClass(antiClass).addClass(colorClass);
        $('#indicatorText').text(`Showing ${labelLower} letter employees`);

        // Action buttons color
        $('#btnView, #btnDownloadMultiple').removeClass('increment-btn promotion-btn').addClass(colorClass + '-btn');

        // Modal title
        $('#modalTitle').text(labelLower + ' Letter');
    }

    // ── Helper: Reset no-data message ─────────────────────────────────────────
    function resetNoDataMessage() {
        $('#noDataMessage').text('No data to display. Please select a branch and click Find to load employee data.').show();
    }

    function hideDataElements() {
        $('#recordCount').hide();
        $('#searchViewContainer').hide();
        $('#actionButtonsContainer').hide();
        $('#noDataMessage').show();
        $('#employeeGrid').hide();
    }

    function showDataElements() {
        $('#recordCount').show();
        $('#searchViewContainer').show();
        $('#actionButtonsContainer').show();
        $('#noDataMessage').hide();
        $('#employeeGrid').show();
    }

    function goBack() { window.history.back(); }

    function populateYearDropdown() {
        const startYear   = 2025;
        const currentYear = new Date().getFullYear();
        const yearDropdown = $("#yearSelect");
        yearDropdown.empty();
        for (let year = currentYear; year >= startYear; year--) {
            yearDropdown.append(`<option value="${year}">${year}</option>`);
        }
        yearDropdown.val(currentYear);
    }

    function BindBranchDropdown() {
        $.ajax({
            url: '@baseDomainUrl/api/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response?.data?.length > 0) {
                    $("#branchDropdown").dxTagBox({
                        items: response.data,
                        displayExpr: "branchName",
                        valueExpr: "branchId",
                        placeholder: "--Select Branch--",
                        showSelectionControls: true,
                        searchEnabled: true,
                        showClearButton: true,
                        maxDisplayedTags: 3,
                        applyValueMode: "instantly",
                        multiline: false,
                        minSearchLength: 0,
                        width: "100%",
                        onOpened: function () {
                            $(".dx-overlay-content").css("max-width", "150px");
                        }
                    });
                }
            },
            error: function () {
                showToast('Failed to load branches.', 'error');
            }
        });
    }

    function fetchLetterInformation() {
        $.ajax({
            url: '@baseDomainUrl/api/ReportAPI/GetLetterInformation',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response && response.isSuccess && response.data) {
                    hrManagerData = Array.isArray(response.data) && response.data.length > 0
                        ? response.data[0]
                        : { fullName: 'HR Manager', isHrManager: true, employeeId: null };
                } else {
                    hrManagerData = { fullName: 'HR Manager', isHrManager: true, employeeId: null };
                }
            },
            error: function () {
                hrManagerData = { fullName: 'HR Manager', isHrManager: true, employeeId: null };
            }
        });
    }

    function updateRecordCount() {
        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) {
            const filteredCount = grid.getVisibleRows().length;
            $('#recordCount').text(`${filteredCount} Records found.`);
            $('#recordCount').css('color', filteredCount > 0 ? '#28a745' : '#dc3545');
        }
    }

    // ── Find ──────────────────────────────────────────────────────────────────
    function onFind() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];

        if (!selectedBranchIds || selectedBranchIds.length === 0) {
            showToast('Please select at least one branch.', 'warn');
            return;
        }

        const selectedYear    = $('#yearSelect').val();
        const branchIdsParam  = selectedBranchIds.join(',');

        const letterTypeParam = currentLetterType === 'increment' ? 'Increment' : 'Promotion';
        const apiUrl = `@baseDomainUrl/api/ReportAPI/GetEmployeeforPromotionincrementletter/${CompanyId}?BranchId=${branchIdsParam}&Year=${selectedYear}&LetterType=${letterTypeParam}`;

        $('#grid-loader').addClass('d-flex').show();
        hideDataElements();

        $.ajax({
            url: apiUrl,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                const employeeData = response.data || response;
                originalEmployeeData = employeeData;

                if (employeeData && employeeData.length > 0) {
                    showDataElements();
                    const columns = [
                        { dataField: "employeeCode", caption: "Employee Code", width: 150 },
                        { dataField: "id", caption: "EmployeeId", visible: false },
                        { dataField: "fullName", caption: "Employee Name" },
                        { dataField: "branchName", caption: "Branch", width: 150 }
                    ];

                    if (currentLetterType === 'promotion') {
                        columns.splice(3, 0, { dataField: "designationName", caption: "New Designation", width: 160 });
                    }

                    $("#employeeGrid").dxDataGrid({
                        dataSource: employeeData,
                        keyExpr: "id",
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        showBorders: true,
                        columnAutoWidth: true,
                        paging: { enabled: false },
                        scrolling: { mode: "standard", useNative: true, showScrollbar: "always" },
                        searchPanel: { visible: false },
                        height: 500,
                        columns: columns,
                        onContentReady: function () { updateRecordCount(); }
                    });

                    const grid = $("#employeeGrid").dxDataGrid("instance");

                    $('#employeeSearch').off('input').on('input', function () {
                        const searchValue = $(this).val();
                        if (searchValue) {
                            grid.filter([
                                ['fullName', 'contains', searchValue],
                                'or',
                                ['employeeCode', 'contains', searchValue],
                                'or',
                                ['branchName', 'contains', searchValue]
                            ]);
                        } else {
                            grid.clearFilter();
                        }
                        setTimeout(updateRecordCount, 100);
                    });

                    $('#recordCount').text(`${employeeData.length} Records found.`).css('color', '#28a745');
                } else {
                    hideDataElements();
                    const typeLabel = currentLetterType === 'increment' ? 'Increment' : 'Promotion';
                    $('#noDataMessage').text(`No employees found for ${typeLabel} letter in the selected branch(es).`).show();
                }

                $('#grid-loader').removeClass('d-flex').hide();
            },
            error: function () {
                $('#grid-loader').removeClass('d-flex').hide();
                hideDataElements();
                $('#noDataMessage').text('Failed to load employees. Please try again.').show();
                showToast('Failed to load employees.', 'error');
            }
        });
    }

    function onClear() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        if (branchTagBox) branchTagBox.option("value", []);
        $('#yearSelect').val(new Date().getFullYear());
        $('#letterTypeSelect').val('increment').trigger('change');

        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) grid.option("dataSource", []);

        hideDataElements();
        resetNoDataMessage();
        $('#employeeSearch').val('');
        originalEmployeeData = [];
    }

     $('#btnView').on('click', function () {
        const grid     = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }
        if (selected.length > 1) {
            showToast('Please select only one employee to view.', 'warn');
            return;
        }

        const employeeId      = selected[0].id;
        const letterTypeParam = currentLetterType === 'increment' ? 'Increment' : 'Promotion';
        const $btn = $(this);
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Loading...');

        // ← LetterType parameter add karo
        const detailUrl = `@baseDomainUrl/api/ReportAPI/GetEmployeeDetailsForPromotionincrementletter?EmployeeId=${employeeId}&LetterType=${letterTypeParam}`;

        $.ajax({
            url: detailUrl,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                if (response && response.isSuccess) {
                    let data = response.data || response.Data;
                    if (Array.isArray(data)) {
                        if (data.length === 0) { showToast('No employee data found.', 'error'); return; }
                        data = data[0];
                    }



                    currentEmployeeData = data;
                    const html = currentLetterType === 'increment'
                        ? generateIncrementLetterHTML(data)
                        : generatePromotionLetterHTML(data);
                    $('#letterBody').html(html);
                    const modal = new bootstrap.Modal(document.getElementById('letterModal'));
                    modal.show();
                } else {
                    showToast(response.responseMessage || 'Failed to fetch employee details.', 'error');
                }
            },
            error: function (xhr, status, error) {
                showToast(`Failed to fetch employee details: ${error}`, 'error');
            },
            complete: function () {
                $btn.prop('disabled', false).html('View');
            }
        });
    });

    $('#btnDownloadMultiple').on('click', function () {
        const grid     = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }

        const $btn = $(this);
        setBtnLoading($btn, 'Generating...');

        let completedCount = 0;
        const totalCount   = selected.length;
        const letterType   = currentLetterType;
        const letterTypeParam = letterType === 'increment' ? 'Increment' : 'Promotion';

        selected.forEach((employee) => {
            const refNumber  = employee.refNumber;  // ← grid se refNumber lo

            // ← LetterType parameter add karo
            const detailUrl = `@baseDomainUrl/api/ReportAPI/GetEmployeeDetailsForPromotionincrementletter?EmployeeId=${employee.id}&LetterType=${letterTypeParam}`;

            $.ajax({
                url: detailUrl,
                type: "GET",
                headers: { 'Authorization': 'Bearer ' + Token },
                dataType: "json",
                success: function (response) {
                    console.log('response' ,response);
                    if (response && response.isSuccess) {
                        let data = response.data || response.Data;
                        if (Array.isArray(data)) {
                            if (data.length === 0) { finalize(); return; }
                            data = data[0];
                        }


                        const html = letterType === 'increment'
                            ? generateIncrementLetterHTML(data)
                            : generatePromotionLetterHTML(data);
                        generatePDFFromHTML(html, data.employeeCode, letterType, finalize);
                    } else { finalize(); }
                },
                error: function () { finalize(); }
            });
        });

        function finalize() {
            completedCount++;
            if (completedCount === totalCount) {
                setBtnNormal($btn, 'Download PDF');
                showToast(`${totalCount} PDF(s) generated successfully!`, 'success');
            }
        }
    });

    // ── PDF Generation ────────────────────────────────────────────────────────
    function generatePDFFromHTML(html, employeeCode, letterType, callback) {
        const tempContainer = $('<div>').css({ position: 'absolute', left: '-9999px', top: '0' }).appendTo('body');
        tempContainer.html(html);
        const element = tempContainer.find('.letter-container')[0];

        html2canvas(element, { scale: 2, logging: false, useCORS: true }).then(canvas => {
            const imgData    = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf        = new jsPDF('p', 'mm', 'a4');
            const imgWidth   = 210;
            const pageHeight = 297;
            const imgHeight  = (canvas.height * imgWidth) / canvas.width;
            let heightLeft   = imgHeight;
            let position     = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;

            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            const prefix   = letterType === 'increment' ? 'Increment' : 'Promotion';
            const fileName = `${prefix}_Letter_${employeeCode || 'EMPLOYEE'}_${new Date().getTime()}.pdf`;
            pdf.save(fileName);
            tempContainer.remove();
            if (callback) callback();
        }).catch(error => {
            console.error('PDF generation error:', error);
            tempContainer.remove();
            if (callback) callback();
        });
    }

    // ── Shared helpers ─────────────────────────────────────────────────────────
    const formatDate = (dateStr) => {
        if (!dateStr) return 'N/A';
        const d     = new Date(dateStr);
        const day   = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year  = d.getFullYear();
        return `${day}/${month}/${year}`;
    };



    function getTitlePrefix(gender) {
        if (!gender) return '';
        const g = gender.toString().trim().toLowerCase();
        if (g === 'male'   || g === 'm' || g === '1') return 'Mr.';
        if (g === 'female' || g === 'f' || g === '2') return 'Ms.';
        return '';
    }

    function cleanEmployeeName(fullName) {
        return (fullName || '[Employee Name]').replace(/^(Mr\.|Mrs\.|Ms\.)\s*/i, '').trim();
    }

    function letterWrapper(content, refNo, companyName, companyAddress,logoUrl) {
        const today = formatDate(new Date().toISOString());
        return `
        <div class="letter-container" style="
            width:100%; max-width:900px; margin:0 auto;
            padding:50px 70px; background:white;
            font-family:'Calibri','Arial',sans-serif;
            font-size:13.5px; color:#222; box-sizing:border-box;
            border:1px solid #ddd; line-height:1.8;
        ">
            <!-- HEADER -->
            <table style="width:100%; margin-bottom:10px;">
                <tr>
                    <td style="vertical-align:top; font-size:12px; color:#555;">
                        <strong>Ref No:</strong> ${refNo || ''}
                    </td>
                    <td style="text-align:right; vertical-align:top;">
                        <img src="${logoUrl}" alt="Company Logo"
                             style="max-width:220px; height:auto;"
                             onerror="this.style.display='none'" />
                    </td>
                </tr>
            </table>

            <!-- DATE -->
            <p style="margin:0 0 18px 0; font-size:13px; text-align:right;">
                <strong>${today}</strong>
            </p>

            ${content}

            <!-- FOOTER NOTE -->
            <div style="margin-top:30px; font-size:11px; text-align:center; color:#555;">
                <p style="margin:2px 0;"><strong>Note: This is a Computer generated statement hence no signature required.</strong></p>
                <p style="margin:2px 0;"><strong>Personal &amp; Confidential</strong></p>
            </div>

            <!-- COMPANY ADDRESS -->
            <div style="margin-top:10px; font-size:11px; text-align:center; color:#666;">
                <p><strong>${companyAddress || ''}</strong></p>
            </div>
        </div>`;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ── INCREMENT LETTER HTML ─────────────────────────────────────────────────
    // ══════════════════════════════════════════════════════════════════════════
    function generateIncrementLetterHTML(data) {
        const titlePrefix   = getTitlePrefix(data.gender);
        const cleanName     = cleanEmployeeName(data.fullName);
        const displayName   = titlePrefix ? `${titlePrefix} ${cleanName}` : cleanName;
        const employeeCode  = data.employeeCode  || '';
        const branchName    = data.branchName    || '';
