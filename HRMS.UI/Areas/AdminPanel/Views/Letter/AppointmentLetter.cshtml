@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Appointment Letter";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<meta charset="UTF-8">
<title>Appointment Letter</title>

<!-- DevExtreme -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devextreme@23.2.3/dist/css/dx.light.css">

<style>
    #branchDropdown {
        min-width: 220px;
    }

    #employeeGrid {
        height: calc(100vh - 420px);
        min-height: 350px;
    }

    .no-data-message {
        text-align: center;
        padding: 40px;
        color: #6c757d;
        font-style: italic;
        font-size: 14px;
    }

    .custom-modal-width {
        max-width: 95% !important;
        width: 95% !important;
    }

    #appointmentLetterBody {
        overflow-y: auto;
        max-height: 75vh;
    }

    .grid-loader {
        position: absolute;
        display: none;
        inset: 0;
        background: rgba(255,255,255,0.6);
        z-index: 10;
    }

        .grid-loader.d-flex {
            display: flex !important;
        }

    .grid-logo-spinner {
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Appointment Letter Generation</h6>
            <button type="button" class="btn btn-secondary btn-sm" onclick="goBack()">Back</button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 220px;min-width:200px;">
                    <label for="branchDropdown">Branch</label>
                    <div id="branchDropdown"></div>
                </div>

                <div class="fg" style="flex:0 1 130px;min-width:120px;">
                    <label for="yearSelect">Year</label>
                    <select id="yearSelect"></select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnfind" onclick="onFind()">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Find</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="onClear()">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="recordCount" class="mb-2" style="display:none;font-weight:600;"></div>

            <div class="d-flex flex-wrap align-items-end gap-3 mb-3" id="searchViewContainer" style="display:none;">
                <div class="fg" style="flex:1 1 260px;min-width:220px;">
                    <label for="employeeSearch">Search Employees</label>
                    <input type="text" id="employeeSearch" placeholder="Search employees..." />
                </div>
            </div>

            <div id="actionButtonsContainer" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-primary btn-sm" id="btnView">View</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnDownloadMultiple">Download PDF</button>
                </div>
            </div>

            <div class="grid-wrapper" style="position:relative;" id="gridTag">
                <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column">
                    <img src="@baseDomainUrl/loders/loder.png" class="grid-logo-spinner" />
                    <div class="grid-loading-text text-dark" style="font-size:16px;">Loading...</div>
                </div>
                <div class="no-data-message" id="noDataMessage">
                    No data to display. Please select a branch and click Find to load employee data.
                </div>
                <div id="employeeGrid"></div>
            </div>
        </div>
    </div>

</div>

<!-- Appointment Letter Modal -->
<div class="modal fade" id="appointmentLetterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl custom-modal-width">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Appointment Letter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="appointmentLetterBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnDownloadPDF">Download PDF</button>
            </div>
        </div>
    </div>
</div>

<!-- PDF Generation Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    const Empid        = parseInt(localStorage.getItem("EmployeeId"));
    const Role         = localStorage.getItem("RoleSlug");
    const Token        = localStorage.getItem("authToken");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compname     = companyDetails.CompanyName;
    const CompanyId    = companyDetails.CompanyId;

    let originalEmployeeData = [];
    let currentEmployeeData  = null;
    let hrManagerData        = null;

    // ── Gender & Name Helpers ─────────────────────────────────────────────────
    function getTitlePrefix(gender) {
        if (!gender) return '';
        const g = gender.toString().trim().toLowerCase();
        if (g === 'male'   || g === 'm' || g === '1') return 'Mr.';
        if (g === 'female' || g === 'f' || g === '2') return 'Ms.';
        return '';
    }

    function cleanEmployeeName(fullName) {
        return (fullName || '').replace(/^(Mr\.|Mrs\.|Ms\.|Mr\/Ms\.)\s*/i, '').trim();
    }

    // displayName = "Mr. Ramesh Shah" or "Ms. Priya" or just name if no gender
    function getDisplayName(fullName, gender) {
        const prefix = getTitlePrefix(gender);
        const name   = cleanEmployeeName(fullName);
        return prefix ? `${prefix} ${name}` : name;
    }

    // ── On Ready ──────────────────────────────────────────────────────────────
    $(document).ready(function () {
        populateYearDropdown();
        BindBranchDropdown();
        fetchLetterInformation();
        hideDataElements();
    });

    $('#yearSelect').on('change', function () {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];
        if (selectedBranchIds && selectedBranchIds.length > 0) onFind();
    });

    function hideDataElements() {
        $('#recordCount').hide();
        $('#searchViewContainer').hide();
        $('#actionButtonsContainer').hide();
        $('#noDataMessage').show();
        $('#employeeGrid').hide();
    }

    function showDataElements() {
        $('#recordCount').show();
        $('#searchViewContainer').show();
        $('#actionButtonsContainer').show();
        $('#noDataMessage').hide();
        $('#employeeGrid').show();
    }

    function goBack() { window.history.back(); }

    function populateYearDropdown() {
        const startYear   = 2025;
        const currentYear = new Date().getFullYear();
        const yearDropdown = $("#yearSelect");
        yearDropdown.empty();
        for (let year = currentYear; year >= startYear; year--) {
            yearDropdown.append(`<option value="${year}">${year}</option>`);
        }
        yearDropdown.val(currentYear);
    }

    function BindBranchDropdown() {
        $.ajax({
            url: '@baseDomainUrl/api/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response?.data?.length > 0) {
                    $("#branchDropdown").dxTagBox({
                        items: response.data,
                        displayExpr: "branchName",
                        valueExpr: "branchId",
                        placeholder: "--Select Branch--",
                        showSelectionControls: true,
                        searchEnabled: true,
                        showClearButton: true,
                        maxDisplayedTags: 3,
                        applyValueMode: "instantly",
                        multiline: false,
                        minSearchLength: 0,
                        width: "100%",
                        onOpened: function () { $(".dx-overlay-content").css("max-width", "150px"); }
                    });
                }
            },
            error: function () { showToast('Failed to load branches.', 'error'); }
        });
    }

    function fetchLetterInformation() {
        $.ajax({
            url: '@baseDomainUrl/api/ReportAPI/GetLetterInformation',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response && response.isSuccess && response.data) {
                    hrManagerData = Array.isArray(response.data) && response.data.length > 0
                        ? response.data[0]
                        : { fullName: 'HR Manager', isHrManager: true, employeeId: null };
                } else {
                    hrManagerData = { fullName: 'HR Manager', isHrManager: true, employeeId: null };
                }
            },
            error: function () {
                hrManagerData = { fullName: 'HR Manager', isHrManager: true, employeeId: null };
            }
        });
    }

    function updateRecordCount() {
        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) {
            const filteredCount = grid.getVisibleRows().length;
            $('#recordCount').text(`${filteredCount} Records found.`);
            $('#recordCount').css('color', filteredCount > 0 ? '#28a745' : '#dc3545');
        }
    }

    function onFind() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        const selectedBranchIds = branchTagBox ? branchTagBox.option("value") : [];

        if (!selectedBranchIds || selectedBranchIds.length === 0) {
            showToast('Please select at least one branch.', 'warn');
            return;
        }

        const selectedYear   = $('#yearSelect').val();
        const branchIdsParam = selectedBranchIds.join(',');
           const letterType      = 'APT';
        $('#grid-loader').addClass('d-flex').show();
        hideDataElements();

        $.ajax({
            url: `@baseDomainUrl/api/ReportAPI/GetAllEmployeeforletter/${CompanyId}?BranchId=${branchIdsParam}&Year=${selectedYear}&LetterType=${letterType}`,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                const employeeData = response.data || response;
                originalEmployeeData = employeeData;

                if (employeeData && employeeData.length > 0) {
                    showDataElements();

                    const grid = $("#employeeGrid").dxDataGrid({
                        dataSource: employeeData,
                        keyExpr: "id",
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        showBorders: true,
                        columnAutoWidth: true,
                        paging: { enabled: false },
                        scrolling: { mode: "standard", useNative: true, showScrollbar: "always" },
                        searchPanel: { visible: false },
                        height: 500,
                        columns: [
                            { dataField: "employeeCode", caption: "Employee Code", width: 150 },
                            { dataField: "id",           caption: "EmployeeId",    visible: false },
                            { dataField: "fullName",     caption: "Employee Name" },
                            { dataField: "branchName",   caption: "Branch",        width: 150 }
                        ],
                        onContentReady: function () { updateRecordCount(); }
                    }).dxDataGrid("instance");

                    $('#employeeSearch').off('input').on('input', function () {
                        const searchValue = $(this).val();
                        if (searchValue) {
                            grid.filter([
                                ['fullName',     'contains', searchValue], 'or',
                                ['employeeCode', 'contains', searchValue], 'or',
                                ['branchName',   'contains', searchValue]
                            ]);
                        } else {
                            grid.clearFilter();
                        }
                        setTimeout(updateRecordCount, 100);
                    });

                    $('#recordCount').text(`${employeeData.length} Records found.`).css('color', '#28a745');
                } else {
                    hideDataElements();
                    $('#noDataMessage').text('No employees found for the selected branch(es).').show();
                }

                $('#grid-loader').removeClass('d-flex').hide();
            },
            error: function () {
                $('#grid-loader').removeClass('d-flex').hide();
                hideDataElements();
                $('#noDataMessage').text('Failed to load employees. Please try again.').show();
                showToast('Failed to load employees.', 'error');
            }
        });
    }

    function onClear() {
        const branchTagBox = $("#branchDropdown").dxTagBox("instance");
        if (branchTagBox) branchTagBox.option("value", []);
        $('#yearSelect').val(new Date().getFullYear());

        const grid = $("#employeeGrid").dxDataGrid("instance");
        if (grid) grid.option("dataSource", []);

        hideDataElements();
        $('#noDataMessage').text('No data to display. Please select a branch and click Find to load employee data.');
        $('#employeeSearch').val('');
        originalEmployeeData = [];
    }

    // ── View button ───────────────────────────────────────────────────────────
    $('#btnView').on('click', function () {
        const grid    = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }
        if (selected.length > 1) {
            showToast('Please select only one employee to view.', 'warn');
            return;
        }

        const employeeId = selected[0].id;
           const letterType      = 'APT';
        const $btn = $(this);
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...');

        $.ajax({
            url: `@baseDomainUrl/api/ReportAPI/GetActiveEmployeeDetailsForLetter?EmployeeId=${employeeId}&LetterType=${letterType}`,
            type: "GET",
            headers: { 'Authorization': 'Bearer ' + Token },
            dataType: "json",
            success: function (response) {
                if (response && response.isSuccess) {
                    let data = response.data || response.Data;
                    if (Array.isArray(data)) {
                        if (data.length === 0) { showToast('No employee data found.', 'error'); return; }
                        data = data[0];
                    }
                    currentEmployeeData = data;
                    $('#appointmentLetterBody').html(generateAppointmentLetterHTML(data));
                    const modal = new bootstrap.Modal(document.getElementById('appointmentLetterModal'));
                    modal.show();
                } else {
                    showToast(response.responseMessage || 'Failed to fetch employee details.', 'error');
                }
            },
            error: function (xhr, status, error) {
                showToast(`Failed to fetch employee details: ${error}`, 'error');
            },
            complete: function () {
                $btn.prop('disabled', false).html('View');
            }
        });
    });

    // ── Download Multiple button ───────────────────────────────────────────────
    $('#btnDownloadMultiple').on('click', function () {
        const grid    = $('#employeeGrid').dxDataGrid("instance");
        const selected = grid.getSelectedRowsData();

        if (!selected.length) {
            showToast('Please select at least one employee.', 'warn');
            return;
        }

        const $btn = $(this);
        setBtnLoading($btn, 'Generating...');

        let completedCount = 0;
        const totalCount   = selected.length;
             const letterType      = 'APT';
        selected.forEach((employee) => {
            $.ajax({
                url: `@baseDomainUrl/api/ReportAPI/GetActiveEmployeeDetailsForLetter?EmployeeId=${employee.id}&LetterType=${letterType}`,
                type: "GET",
                headers: { 'Authorization': 'Bearer ' + Token },
                dataType: "json",
                success: function (response) {
                    if (response && response.isSuccess) {
                        let data = response.data || response.Data;
                        if (Array.isArray(data)) {
                            if (data.length === 0) { finalize(); return; }
                            data = data[0];
                        }
                        generatePDFFromHTML(generateAppointmentLetterHTML(data), data.employeeCode || 'EMPLOYEE', finalize);
                    } else { finalize(); }
                },
                error: function () { finalize(); }
            });
        });

        function finalize() {
            completedCount++;
            if (completedCount === totalCount) {
                setBtnNormal($btn, 'Download PDF');
                showToast(`${totalCount} PDF(s) generated successfully!`, 'success');
            }
        }
    });

    // ── Shared PDF generator ──────────────────────────────────────────────────
    function generatePDFFromHTML(html, code, callback) {
        const tempContainer = $('<div>').css({ position: 'absolute', left: '-9999px', top: '0' }).appendTo('body');
        tempContainer.html(html);
        const element = tempContainer.find('.appointment-letter-container')[0];

        html2canvas(element, { scale: 2, logging: false, useCORS: true }).then(canvas => {
            const imgData    = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf        = new jsPDF('p', 'mm', 'a4');
            const imgWidth   = 210;
            const pageHeight = 297;
            const imgHeight  = (canvas.height * imgWidth) / canvas.width;
            let heightLeft   = imgHeight;
            let position     = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;

            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            pdf.save(`Appointment_Letter_${code}_${new Date().getTime()}.pdf`);
            tempContainer.remove();
            if (callback) callback();
        }).catch(error => {
            console.error('PDF generation error:', error);
            tempContainer.remove();
            if (callback) callback();
        });
    }

    // ── Appointment Letter HTML ───────────────────────────────────────────────
    function generateAppointmentLetterHTML(data) {

        const formatDate = (dateStr) => {
            if (!dateStr) return 'N/A';
            const d     = new Date(dateStr);
            const day   = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year  = d.getFullYear();
            return `${day}/${month}/${year}`;
        };

        const today      = formatDate(new Date().toISOString());
        // const logoUrl    = '/assets/images/relaylogo.jpeg';

        // ── FIX: correct gender handling — no double prefix ──
        const titlePrefix  = getTitlePrefix(data.gender);
        const cleanName    = cleanEmployeeName(data.fullName || '[Employee Name]');
        const displayName  = titlePrefix ? `${titlePrefix} ${cleanName}` : cleanName;

        const employeeCode   = data.employeeCode  || '';
        const address        = data.address        || data.presentAddress || '';
        const statePincode   = data.statePincode   || data.state          || '';
        const designation    = data.designationName|| data.designation    || '[Designation]';
        const department     = data.departmentName || data.department     || '[Department]';
        const grade          = data.gradeName      || data.employeeGrade  || '';
        const branchLocation = data.branchName     || data.branchLocation || '[Branch Name]';
        const joiningDate    = formatDate(data.joiningDate || data.dateOfJoining);
        const annualCtc      = data.annualCtc      || data.ctc            || '';
        const ctcInWords     = data.ctcInWords     || data.salaryInWords  || '';
        const companyAddress = data.companyAddress || '406, Kataria Arcade, Behind Adani CNG Pump, Off - S.G. Highway, Makarba, Ahmedabad - 380051 Gujarat, India';
        const directorName   = data.directorName   || 'Atri Patel';
        const logoUrl      =  '/assets/images/relaylogo.jpeg';
        const companyName  = data.companyName     || Compname      || '';
        const refNo        = data.refNumber
        const sectionHead = (title) => `
            <p style="margin:18px 0 4px 0; font-size:14px; font-weight:bold; text-decoration:underline; color:#222;">${title}</p>`;

        const para   = (text) => `<p style="margin:6px 0; text-align:justify;">${text}</p>`;
        const bullet = (text) => `<p style="margin:4px 0 4px 20px;">&#8226; ${text}</p>`;

        return `
        <div class="appointment-letter-container" style="
            width:100%; max-width:900px; margin:0 auto;
            padding:50px 70px; background:white;
            font-family:'Calibri','Arial',sans-serif;
            font-size:13.5px; color:#222; box-sizing:border-box;
            border:1px solid #ddd; line-height:1.8;">

            <!-- HEADER -->
            <table style="width:100%; margin-bottom:20px;">
                <tr>
                    <td style="vertical-align:top;">
                        <p style="margin:0; font-size:13px;">
                            <strong>Ref No :</strong> ${refNo}
                        </p>
                    </td>
                    <td style="text-align:right; vertical-align:top;">
                        <img src="${logoUrl}" alt="Company Logo"
                             style="max-width:220px; height:auto;"
                             onerror="this.style.display='none'" />
                    </td>
                </tr>
            </table>

            <!-- DATE -->
            <p style="margin:0 0 18px 0; font-size:13px; text-align:right;">
                <strong>${today}</strong>
            </p>

            <!-- TO BLOCK — sirf displayName, no double prefix -->
            <p style="margin:0;">To,</p>
            <p style="margin:4px 0;">
                <strong><u style="color:#e74c3c;">${displayName}</u></strong>
            </p>
            ${employeeCode ? `<p style="margin:4px 0;"><strong>Employee Code:</strong> ${employeeCode}</p>` : ''}
            ${address      ? `<p style="margin:4px 0;"><strong>Address :</strong> ${address}</p>`           : ''}
            ${statePincode ? `<p style="margin:4px 0;">${statePincode}</p>`                                 : ''}

            <!-- TITLE -->
            <p style="text-align:center; font-size:16px; font-weight:bold;
                      text-decoration:underline; margin:28px 0 20px 0; color:#3f4d6b;">
                Appointment Letter
            </p>

            <!-- SALUTATION — sirf displayName -->
            <p><strong>Dear ${displayName},</strong></p>

            <!-- OPENING PARA -->
            ${para(`With reference to your application, subsequent interviews and our discussions, we are pleased to appoint you to the position of <strong style="color:#e74c3c;">"${designation} - ${department}"</strong> at Grade <strong style="color:#e74c3c;">${grade}</strong> w.e.f. <strong style="color:#e74c3c;">"${joiningDate}"</strong> with <strong>Relay Express Pvt. Ltd.</strong> on the following terms and conditions:`)}

            ${sectionHead('References:')}
            ${para('Your appointment is subject to the verification of your educational certificates, qualifications and the submission of a copy of relevant documentation on your date of joining. Your employment is subject to references and background checks being obtained to the satisfaction of the organization if, any declaration given or information furnished by you to the organisation proves to be false or if you are found to have willfully suppressed any material information, you are liable to be terminated from the services of the Organization without any notice.')}
            ${para('The appointment and its continuance are subject to your being found and remaining medically (physically &amp; mentally) fit. The organization reserves the right to ask you to undergo medical examination if and when considered necessary.')}

            ${sectionHead('Compensation:')}
            ${para(`Your Annual Fixed Remuneration will be <strong>INR. ${annualCtc} /-</strong> ${ctcInWords ? `<strong>(Rupees ${ctcInWords})</strong>` : ''} subject to the deduction of applicable statutory taxes. The details of the Annual CTC as applicable to your grade is enclosed in <strong>Annexure – I</strong>.`)}
            ${para('The variable pay component, if any included in your compensation, is directly dependent on:')}
            ${bullet('You establishing and effecting a desirable and satisfactory performance in all parameters in respect of your key result areas.')}
            ${bullet('Your department/team establishing and effecting a desirable and satisfactory performance in all parameters in respect of their key result areas.')}
            ${bullet('The performance of the organisation.')}
            ${para('At its sole discretion of Management, the Salary structure or components of the organisation may be altered/modified at any time without prior notice, and your remuneration package may accordingly be altered, modified from time to time. Further, salary, allowances and all other payments/benefits will be governed by the organisation rules as well as statutory provisions in force from time to time and subject to deductions of appropriate taxes at source.')}
            ${para('The subject of compensation is confidential in nature and strictly between you and the organization and should not be discussed with anyone.')}

            ${sectionHead('Place/Transfer:')}
            ${para(`Your initial posting will be in <strong style="color:#e74c3c;">"${branchLocation}"</strong>, India. Your services are transferable to any of the organisation's establishment, client, worksites, sister concerns in India, which are in existence presently or which may be formed in future. In such an event you shall be governed by the service conditions, rules and regulations, which are applicable at the place of transfer from time to time.`)}

            ${sectionHead('Probation:')}
            ${para('You will be on a probation for a period of <strong>6 Months</strong> from your date of joining and the period of probation can be extended further if, your performance is not found satisfactory.')}
            ${para('On successful completion of the probation period, if your performance is found to be satisfactory in all aspects, you will be confirmed and the organization will provide you a confirmation letter. Unless confirmed in writing, you will be deemed to be on probation.')}
            ${para('During the probation period your employment can be terminated with <strong>fifteen (15) days</strong> notice on either side without any reason whatsoever.')}
            ${para('After confirmation, either party will be at liberty to terminate this appointment by giving <strong>30 days</strong> notice or pay in lieu of notice.')}
            ${para('Absence for a continuous period of <strong>7 days</strong> without prior approval of your superior (including overstay on leave/training) would result in you losing your lien on the employment and the same shall automatically come to an end without any notice or intimation.')}

            ${sectionHead('Separation:')}
            ${para('After the confirmation of services, either party will be at liberty to terminate this appointment by giving <strong>Thirty Days (30 days)</strong> notice or the short fall of notice period can be adjusted by giving payment of Basic Salary in lieu of number of days of shortfall of notice period.')}
            ${para('The employment can also be terminated without any notice or pay in lieu thereof provided:')}
            ${bullet('If, any information provided by you in your application or during the subsequent interviews and discussions or thereafter, is found to be false or misleading.')}
