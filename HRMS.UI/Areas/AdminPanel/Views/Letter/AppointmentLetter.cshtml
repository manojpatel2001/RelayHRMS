    // ── Download from modal ────────────────────────────────────────────────────
    $('#btnDownloadPDF').on('click', function () {
        const $btn    = $(this);
        $btn.prop('disabled', true).addClass('btn-loading');

        const element = document.getElementById('appointmentLetterBody').querySelector('.appointment-letter-container');

        html2canvas(element, { scale: 2, logging: false, useCORS: true }).then(canvas => {
            const imgData    = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf        = new jsPDF('p', 'mm', 'a4');
            const imgWidth   = 210;
            const pageHeight = 297;
            const imgHeight  = (canvas.height * imgWidth) / canvas.width;
            let heightLeft   = imgHeight;
            let position     = 0;

            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;

            while (heightLeft >= 0) {
                position = heightLeft - imgHeight;
                pdf.addPage();
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;
            }

            const code = currentEmployeeData?.employeeCode || 'EMPLOYEE';
            pdf.save(`Appointment_Letter_${code}_${new Date().getTime()}.pdf`);
            $btn.prop('disabled', false).removeClass('btn-loading');
        }).catch(error => {
            console.error('PDF generation error:', error);
            showToast('Failed to generate PDF.', 'error');
            $btn.prop('disabled', false).removeClass('btn-loading');
        });
    });

    $('#appointmentLetterModal').on('hidden.bs.modal', function () {
        const grid = $('#employeeGrid').dxDataGrid("instance");
        if (grid) grid.clearSelection();
    });
