    // ─────────────────────────────────────────────────────────────────────
    // Grids — common HRMS WMSGrid: no pagination, internal scroll + sticky
    // header, checkbox column wired to the lockSelectedIds/salarySelectedIds
    // bulk-selection arrays (re-rendered on every grid refresh/sort/search).
    // ─────────────────────────────────────────────────────────────────────
    function syncSelectAllState(idsArr, totalCount, checkboxSel) {
        const $chk = $(checkboxSel);
        if (idsArr.length === 0) { $chk.prop('checked', false).prop('indeterminate', false); }
        else if (idsArr.length === totalCount) { $chk.prop('checked', true).prop('indeterminate', false); }
        else { $chk.prop('checked', false).prop('indeterminate', true); }
    }

    function renderLockGrid(data) {
        const columns = [
            {
                header: '', sortable: false, width: '40px',
                render: function (v, row) {
                    const checked = lockSelectedIds.includes(row.employeeId) ? 'checked' : '';
                    return '<input type="checkbox" class="form-check-input" ' + checked + ' onclick="_toggleLockRow(' + row.employeeId + ', this.checked)">';
                }
            },
            { field: 'employeeCode', header: 'Employee Code', width: '130px' },
            { field: 'fullName', header: 'Employee Name', width: '180px' },
            { field: 'designationName', header: 'Designation', width: '170px' },
            { field: 'month', header: 'Month', width: '90px' },
            { field: 'year', header: 'Year', width: '90px' },
            {
                field: 'status', header: 'Status', width: '110px',
                render: function (v) {
                    return '<span class="wg-pill ' + (v === 'Locked' ? 'wg-pill-red' : 'wg-pill-green') + '">' + v + '</span>';
                }
            }
        ];

        if (!lockGrid) {
            lockGrid = WMSGrid.create({
                container: 'lockGridContainer',
                title: 'Attendance Lock Records',
                icon: 'bx-lock-alt',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false, export: true }
            });
        } else {
            const cols = lockGrid.getColumns();
            cols.length = 0;
            columns.forEach(c => cols.push(c));
            lockGrid.reset();
            lockGrid.setData(data);
        }
        syncSelectAllState(lockSelectedIds, currentGridData.length, '#lockSelectAllChk');
    }

    function renderSalaryGrid(data) {
        const columns = [
            {
                header: '', sortable: false, width: '40px',
                render: function (v, row) {
                    const checked = salarySelectedIds.includes(row.employeeId) ? 'checked' : '';
                    return '<input type="checkbox" class="form-check-input" ' + checked + ' onclick="_toggleSalaryRow(' + row.employeeId + ', this.checked)">';
                }
            },
            { field: 'employeeCode', header: 'Employee Code', width: '130px' },
            { field: 'fullName', header: 'Employee Name', width: '180px' },
            { field: 'designationName', header: 'Designation', width: '170px' },
            { field: 'month', header: 'Month', width: '90px' },
            { field: 'year', header: 'Year', width: '90px' },
            {
                field: 'status', header: 'Status', width: '110px',
                render: function (v) {
                    return '<span class="wg-pill ' + (v === 'Published' ? 'wg-pill-red' : 'wg-pill-green') + '">' + v + '</span>';
                }
            }
        ];

        if (!salaryGrid) {
            salaryGrid = WMSGrid.create({
                container: 'salaryGridContainer',
                title: 'Salary Publish Records',
                icon: 'bx-money',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false, export: true }
            });
        } else {
            const cols = salaryGrid.getColumns();
            cols.length = 0;
            columns.forEach(c => cols.push(c));
            salaryGrid.reset();
            salaryGrid.setData(data);
        }
        syncSelectAllState(salarySelectedIds, currentSalaryGridData.length, '#salarySelectAllChk');
    }

    window._toggleLockRow = function (employeeId, checked) {
        const idx = lockSelectedIds.indexOf(employeeId);
        if (checked && idx === -1) lockSelectedIds.push(employeeId);
        if (!checked && idx > -1) lockSelectedIds.splice(idx, 1);
        syncSelectAllState(lockSelectedIds, currentGridData.length, '#lockSelectAllChk');
    };

    window._toggleSalaryRow = function (employeeId, checked) {
        const idx = salarySelectedIds.indexOf(employeeId);
        if (checked && idx === -1) salarySelectedIds.push(employeeId);
        if (!checked && idx > -1) salarySelectedIds.splice(idx, 1);
        syncSelectAllState(salarySelectedIds, currentSalaryGridData.length, '#salarySelectAllChk');
    };

    // ─────────────────────────────────────────────────────────────────────
    // Lock / Unlock Attendance
    // ─────────────────────────────────────────────────────────────────────
    $('#btnLockAttendance').click(function () {
        const selectedRows = currentGridData.filter(r => lockSelectedIds.includes(r.employeeId));

        if (selectedRows.length === 0) {
            Swal.fire('Warning', 'Please select at least one employee to lock attendance.', 'warning');
            return;
        }

        const alreadyLocked = selectedRows.filter(row => row.status === 'Locked');
        if (alreadyLocked.length > 0) {
            const employeeNames = alreadyLocked.map(row => row.fullName).join(', ');
            Swal.fire({
                icon: 'warning',
                title: 'Already Locked',
                html: `The following employee(s) are already locked:<br><b>${employeeNames}</b><br><br>Please deselect them and try again.`,
            });
            return;
        }

        Swal.fire({
            title: 'Confirm Lock',
            text: `Are you sure you want to lock attendance for ${selectedRows.length} employee(s)?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Lock It!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                manageAttendanceLock(selectedRows, true);
            }
        });
    });

    $('#btnUnlockAttendance').click(function () {
        const selectedRows = currentGridData.filter(r => lockSelectedIds.includes(r.employeeId));

        if (selectedRows.length === 0) {
            Swal.fire('Warning', 'Please select at least one employee to unlock attendance.', 'warning');
            return;
        }

        const alreadyUnlocked = selectedRows.filter(row => row.status === 'UnLocked');
        if (alreadyUnlocked.length > 0) {
            const employeeNames = alreadyUnlocked.map(row => row.fullName).join(', ');
            Swal.fire({
                icon: 'warning',
                title: 'Already Unlocked',
                html: `The following employee(s) are already unlocked:<br><b>${employeeNames}</b><br><br>Please deselect them and try again.`,
            });
            return;
        }

        Swal.fire({
            title: 'Confirm Unlock',
            text: `Are you sure you want to unlock attendance for ${selectedRows.length} employee(s)?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Unlock It!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                manageAttendanceLock(selectedRows, false);
            }
        });
    });

    function manageAttendanceLock(selectedRows, isLocking) {
        const btnId = isLocking ? '#btnLockAttendance' : '#btnUnlockAttendance';
        setBtnLoading(btnId, isLocking ? 'Locking...' : 'Unlocking...');

        const recordsToCreate = [];
        const recordsToUpdate = [];

        selectedRows.forEach(row => {
            const attendanceLockId = row.attendanceLockId;

            if (!attendanceLockId || attendanceLockId === 0) {
                recordsToCreate.push({
                    EmpId: row.employeeId,
                    Month: currentFilters.month,
                    Year: currentFilters.year,
                    IsLocked: isLocking,
                    IsEnabled: true,
                    IsDeleted: false,
                    CreatedBy: Empid
                });
            } else {
                recordsToUpdate.push({
                    EmpId: row.employeeId,
                    AttendanceLockId: attendanceLockId,
                    Month: currentFilters.month,
                    Year: currentFilters.year,
                    IsLocked: isLocking,
                    IsEnabled: true,
                    IsDeleted: false,
                    UpdatedBy: Empid
                });
            }
        });

        let createPromise = Promise.resolve({ isSuccess: true });
        let updatePromise = Promise.resolve({ isSuccess: true });

        if (recordsToCreate.length > 0) {
            createPromise = $.ajax({
                url: '@(baseDomainUrl + "/api/AttendanceLockAPI/CreateAttendanceLockEmp")',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(recordsToCreate)
            });
        }

        if (recordsToUpdate.length > 0) {
            updatePromise = $.ajax({
                url: '@(baseDomainUrl + "/api/AttendanceLockAPI/UpdateAttendanceLock")',
                method: 'PUT',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(recordsToUpdate)
            });
        }

        Promise.all([createPromise, updatePromise])
            .then(([createResponse, updateResponse]) => {
                setBtnNormal(btnId, isLocking ? 'Lock Attendance' : 'Unlock Attendance');

                const createSuccess = !recordsToCreate.length || createResponse?.isSuccess;
                const updateSuccess = !recordsToUpdate.length || updateResponse?.isSuccess;

                if (createSuccess && updateSuccess) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: `Attendance ${isLocking ? 'locked' : 'unlocked'} successfully for ${selectedRows.length} employee(s).`,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => { location.reload(); });
                } else {
                    const errorMsg = !createSuccess ? createResponse?.responseMessage : updateResponse?.responseMessage;
                    Swal.fire('Error', errorMsg || `Failed to ${isLocking ? 'lock' : 'unlock'} attendance.`, 'error');
                }
            })
            .catch((error) => {
                setBtnNormal(btnId, isLocking ? 'Lock Attendance' : 'Unlock Attendance');
                console.error('Error locking/unlocking attendance:', error);
                Swal.fire('Error', `Failed to ${isLocking ? 'lock' : 'unlock'} attendance. Please try again.`, 'error');
            });
    }

