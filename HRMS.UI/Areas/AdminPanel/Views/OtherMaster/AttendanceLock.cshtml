@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Month Lock";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* Status pills reuse the shared WMSGrid palette (wg-pill-*) so grid badges
       look identical to every other grid in the app. */

    /* Searchable multi-select (Branch/Employee) -- recolored to the WMS palette
       and given a fixed height + internal scroll so it never grows past one
       row of wrapped tags. */
    .searchable-select-wrapper { position: relative; width: 100%; }

    .searchable-select-input {
        height: clamp(30px, 2.0vw, 40px);
        max-height: clamp(30px, 2.0vw, 40px);
        overflow-y: auto;
        border: 1px solid #B8C4CC;
        border-radius: var(--r-sm);
        padding: 4px 35px 4px 8px;
        cursor: pointer;
        background-color: #fff;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 4px;
        box-sizing: border-box;
        transition: border-color .15s, box-shadow .15s;
    }
        .searchable-select-input::-webkit-scrollbar { width: 5px; }
        .searchable-select-input::-webkit-scrollbar-thumb { background: #b0c4d0; border-radius: 3px; }
        .searchable-select-input:hover { border-color: #4E8FAD; }

    .searchable-select-wrapper.active .searchable-select-input {
        border-color: #2F6F8E;
        box-shadow: 0 0 0 3px rgba(47,111,142,.15);
    }

    .selected-tags { display: flex; flex-wrap: wrap; gap: 4px; width: 100%; }
    .selected-tags-placeholder { color: #94A3B8; font-size: var(--fs-md); }

    .selected-tag {
        background-color: #2F6F8E;
        border: 1px solid #235A75;
        border-radius: 3px;
        padding: 2px 8px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #fff;
        flex-shrink: 0;
    }
        .selected-tag .remove-tag { cursor: pointer; font-weight: bold; color: #fff; }
        .selected-tag .remove-tag:hover { color: #DDE9F0; }

    .searchable-select-arrow {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        width: 12px; height: 12px; pointer-events: none; transition: transform .2s;
    }
    .searchable-select-wrapper.active .searchable-select-arrow { transform: translateY(-50%) rotate(180deg); }
    .searchable-select-arrow svg { width: 100%; height: 100%; fill: #778899; }

    .searchable-select-dropdown {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        background: #fff; border: 1.5px solid #B8C4CC; border-radius: var(--r-md);
        margin-top: 2px; max-height: 300px; overflow: hidden; z-index: 1000;
        box-shadow: 0 10px 36px rgba(0,0,0,.18);
    }
    .searchable-select-wrapper.active .searchable-select-dropdown { display: flex; flex-direction: column; }

    .searchable-select-search { padding: 7px; border-bottom: 1px solid #EEF2F5; background: #fff; flex-shrink: 0; }
    .searchable-select-search input {
        width: 100%; padding: 6px 10px; border: 1.5px solid #D0D8DC; border-radius: var(--r-sm);
        font-size: var(--fs-sm); font-family: inherit; outline: none; box-sizing: border-box;
    }
    .searchable-select-search input:focus { border-color: #4E8FAD; box-shadow: 0 0 0 2px rgba(78,143,173,.12); }

    .multi-select-actions { padding: 7px; border-bottom: 1px solid #EEF2F5; display: flex; gap: 8px; background: #fff; flex-shrink: 0; }
    .multi-select-btn {
        flex: 1; padding: 5px 10px; font-size: 11.5px; font-weight: 600; border: 1px solid #B8C4CC;
        border-radius: 6px; background: #F0F5F8; color: #2F6F8E; cursor: pointer; transition: background .15s;
    }
    .multi-select-btn:hover { background: #DDE9F0; }

    .searchable-select-options { overflow-y: auto; flex: 1; padding: 3px 0; }
    .searchable-select-option { padding: 7px 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: var(--fs-sm); color: #2C3E50; transition: background .1s; }
    .searchable-select-option:hover { background-color: #EBF5FF; }
    .searchable-select-option.selected { background-color: #E3F2FD; color: #1565C0; font-weight: 500; }
    .searchable-select-option input[type="checkbox"] { cursor: pointer; }

    .no-results { padding: 12px; text-align: center; color: #94A3B8; font-size: var(--fs-sm); }

    /* Bulk action toolbar above each grid */
    .lock-grid-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; flex-wrap: wrap; gap: 10px; }
</style>

