@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Ticket Type";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}
<style>
    .nav-tabs { border-bottom: none !important; }
    .nav-tabs .nav-link { color: #333; background-color: #f1f1f1; border: 1px solid transparent; }
    .nav-tabs .nav-link.active { color: white !important; background-color: #2395c6 !important; border-color: #2395c6 #2395c6 #fff; }
</style>

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Ticket Master</h6>
        <div class="d-flex gap-2">
            <button id="addTypeBtn" type="button" class="btn btn-primary btn-sm">Add Type</button>
            <button id="addPriorityBtn" type="button" class="btn btn-primary btn-sm d-none">Add Priority</button>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3 mt-3 ms-3" id="ticketTabs" role="tablist">
        <li class="nav-item me-2" role="presentation">
            <button class="nav-link active py-2" data-bs-toggle="tab" data-bs-target="#typeTab" type="button" role="tab" data-tabname="Type Master">Type Master</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link py-2" data-bs-toggle="tab" data-bs-target="#priorityTab" type="button" role="tab" data-tabname="Priority Master">Priority Master</button>
        </li>
    </ul>

    <div class="card-body">
        <div id="typeGrid" class="grid-section">
            <div id="typeWmsGrid"></div>
        </div>
        <div id="priorityGrid" class="grid-section d-none">
            <div id="priorityWmsGrid"></div>
        </div>
    </div>
</div>

<!-- Ticket Type Modal -->
<div class="modal fade" id="addTicketTypeModel" tabindex="-1" aria-labelledby="ticketTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ticketTypeModalLabel"><span class="formType">Add</span> Ticket Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="fg fg-req">
                    <label for="txtTicketType">Ticket Type</label>
                    <input type="text" placeholder="Ticket Type" data-trim-input id="txtTicketType" />
                    <span class="field-validation-error" id="spnTicketType" style="display:none;">Please Enter Ticket Type</span>
                </div>
                <div class="fg fg-req">
                    <label for="dropdownDepartment">Department Name</label>
                    <select id="dropdownDepartment">
                        <option value="" selected disabled>Select Department</option>
                    </select>
                    <span class="field-validation-error" id="spnDepartment" style="display:none;">Please Select Department Name</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateTicketType">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Ticket Priority Modal -->
<div class="modal fade" id="addTicketPriorityModel" tabindex="-1" aria-labelledby="ticketPriorityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ticketPriorityModalLabel"><span class="priorityFormType">Add</span> Ticket Priority</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="fg fg-req">
                    <label for="txtTicketPriority">Ticket Priority</label>
                    <input type="text" placeholder="Ticket Priority" data-trim-input id="txtTicketPriority" />
                    <span class="field-validation-error" id="spnTicketPriority" style="display:none;">Please Enter Ticket Priority</span>
                </div>
                <div class="fg fg-req">
                    <label for="txtEscalationHours">Escalation Hours</label>
                    <input type="text" placeholder="Escalation Hours" id="txtEscalationHours" />
                    <span class="field-validation-error" id="spnEscalationHours" style="display:none;">Please Enter Escalation Hours</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateTicketPriority">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const EmployeeId = localStorage.getItem("EmployeeId");
    const Token = localStorage.getItem("authToken");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const companyId = parseInt(companyDetails.CompanyId);
    var TicketTypeId = 0, TicketPriorityId = 0;
    var _typeCache = {}, _priorityCache = {};

    var typeGrid = WMSGrid.create({
        container: 'typeWmsGrid', title: 'Ticket Types', icon: 'bx-category', perPage: 10,
        columns: [
            { field: 'ticketTypeName', header: 'Ticket Type Name', width: '200px' },
            { field: 'departmentName', header: 'Department Name', width: '180px' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    var editBtn = PermGuard.has('edit-othermaster-tickettype')
                        ? '<button class="wg-btn wg-btn-primary" onclick="updateTicketType(' + row.ticketTypeId + ')"><i class="bx bx-edit"></i> Edit</button> '
                        : '';
                    var deleteBtn = PermGuard.has('delete-othermaster-tickettype')
                        ? '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteTicketType(' + row.ticketTypeId + ')"><i class="bx bx-trash"></i></button>'
                        : '';
                    return editBtn + deleteBtn;
                }
            }
        ], features: { export: true }
    });

    var priorityGrid = WMSGrid.create({
        container: 'priorityWmsGrid', title: 'Ticket Priorities', icon: 'bx-flag', perPage: 10,
        columns: [
            { field: 'ticketPriorityName', header: 'Priority Name', width: '200px' },
            { field: 'escalationHours', header: 'Escalation Hours', width: '140px' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateTicketPriority(' + row.ticketPriorityId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteTicketPriority(' + row.ticketPriorityId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    $(document).ready(function () {
        BindDepartment();
        PermGuard.onReady(function () { TicketTypeDataTable(); });
        // Base slug "othermaster-tickettype" covers only the Type Master tab
        // in this batch; Priority Master's Add/Edit/Delete belong to a
        // different feature/permission and are left ungated here.
        PermGuard.applyActions('othermaster-tickettype', { create: '#addTypeBtn', export: '#typeWmsGrid_exportBtn' });
        TicketPriorityDataTable();

        $('#ticketTabs .nav-link').on('click', function () {
            var tab = $(this).data('tabname');
            $('#ticketTabs .nav-link').removeClass('active');
            $(this).addClass('active');
            if (tab === 'Type Master') {
                $('#addTypeBtn').removeClass('d-none'); $('#addPriorityBtn').addClass('d-none');
                $('#typeGrid').removeClass('d-none'); $('#priorityGrid').addClass('d-none');
            } else {
                $('#addPriorityBtn').removeClass('d-none'); $('#addTypeBtn').addClass('d-none');
                $('#priorityGrid').removeClass('d-none'); $('#typeGrid').addClass('d-none');
            }
        });

        $('#addTicketTypeModel').on('hidden.bs.modal', function () { clearTicketTypeForm(); });
        $('#addTicketPriorityModel').on('hidden.bs.modal', function () { clearTicketPriorityForm(); });
    });

    function BindDepartment() {
        $.ajax({
            type: 'GET', url: '@baseUrl/DepartmentAPI/GetAllDepartments', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess && response.data && response.data.length > 0) {
                    var dd = $('#dropdownDepartment').empty().append('<option value="" selected disabled>Select</option>');
                    $.each(response.data, function (i, d) { dd.append('<option value="' + d.departmentId + '">' + d.departmentName + '</option>'); });
                }
            }
        });
    }

    function TicketTypeDataTable() {
        typeGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/TicketTypeAPI/GetAllTicketTypes/' + companyId, _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : [];
                _typeCache = {};
                rows.forEach(function (r) { _typeCache[r.ticketTypeId] = r; });
                typeGrid.setData(rows); typeGrid.hideLoader();
            },
            error: function () { typeGrid.hideLoader(); showToast('Failed to load ticket types.', 'error'); }
        });
    }

    function TicketPriorityDataTable() {
        priorityGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/TicketPriorityAPI/GetAllTicketPriority/' + companyId, _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? data.data : [];
                _priorityCache = {};
                rows.forEach(function (r) { _priorityCache[r.ticketPriorityId] = r; });
                priorityGrid.setData(rows); priorityGrid.hideLoader();
            },
            error: function () { priorityGrid.hideLoader(); showToast('Failed to load priorities.', 'error'); }
        });
    }

    $('#addTypeBtn').click(function () { clearTicketTypeForm(); $('#addTicketTypeModel').modal('show'); });
    $('#addPriorityBtn').click(function () { clearTicketPriorityForm(); $('#addTicketPriorityModel').modal('show'); });

    $('#btnCreateTicketType').click(function () {
        var ticketType = $('#txtTicketType').val(), deptId = $('#dropdownDepartment').val();
        var isValid = true;
        if (!ticketType) { $('#spnTicketType').show(); $('#txtTicketType').addClass('is-invalid'); isValid = false; } else { $('#spnTicketType').hide(); $('#txtTicketType').removeClass('is-invalid'); }
        if (!deptId) { $('#spnDepartment').show(); $('#dropdownDepartment').addClass('is-invalid'); isValid = false; } else { $('#spnDepartment').hide(); $('#dropdownDepartment').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateTicketType', TicketTypeId == 0 ? 'Saving...' : 'Updating...');
        var data = {
            ticketTypeId: TicketTypeId == 0 ? 0 : TicketTypeId, ticketTypeName: ticketType,
            departmentId: deptId, CompanyId: companyId,
            createdBy: TicketTypeId == 0 ? EmployeeId : null, updatedBy: TicketTypeId == 0 ? null : EmployeeId
        };
        $.ajax({
            url: TicketTypeId == 0 ? '@baseUrl/TicketTypeAPI/CreateTicketType' : '@baseUrl/TicketTypeAPI/UpdateTicketType',
            type: TicketTypeId == 0 ? 'POST' : 'PUT',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(data),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (TicketTypeId == 0 ? 'Ticket type created.' : 'Ticket type updated.'), 'success');
                    $('#addTicketTypeModel').modal('hide'); TicketTypeDataTable();
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateTicketType', TicketTypeId == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Error while saving ticket type.', 'error');
                setBtnNormal('#btnCreateTicketType', TicketTypeId == 0 ? 'Save' : 'Update');
            }
        });
    });

    function updateTicketType(id) {
        var data = _typeCache[id];
        if (!data) return;
        clearTicketTypeForm();
        TicketTypeId = data.ticketTypeId;
        $('#txtTicketType').val(data.ticketTypeName || '');
        $('#dropdownDepartment').val(data.departmentId || '');
        $('.formType').text('Update');
        setBtnNormal('#btnCreateTicketType', 'Update');
        $('#addTicketTypeModel').modal('show');
    }

    function deleteTicketType(id) {
        wmsConfirm('Are you sure you want to delete this ticket type?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/TicketTypeAPI/DeleteTicketType', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: EmployeeId }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    TicketTypeDataTable();
                },
                error: function () { showToast('Error deleting ticket type.', 'error'); }
            });
        });
    }

    function clearTicketTypeForm() {
        TicketTypeId = 0;
        $('#txtTicketType').val('').removeClass('is-invalid'); $('#dropdownDepartment').val('').removeClass('is-invalid');
        $('#spnTicketType, #spnDepartment').hide();
        $('.formType').text('Add'); setBtnNormal('#btnCreateTicketType', 'Save');
    }

    $('#btnCreateTicketPriority').click(function () {
        var priority = $('#txtTicketPriority').val(), hours = $('#txtEscalationHours').val();
        var isValid = true;
        if (!priority) { $('#spnTicketPriority').show(); $('#txtTicketPriority').addClass('is-invalid'); isValid = false; } else { $('#spnTicketPriority').hide(); $('#txtTicketPriority').removeClass('is-invalid'); }
        if (!hours) { $('#spnEscalationHours').show(); $('#txtEscalationHours').addClass('is-invalid'); isValid = false; } else { $('#spnEscalationHours').hide(); $('#txtEscalationHours').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateTicketPriority', TicketPriorityId == 0 ? 'Saving...' : 'Updating...');
        var data = {
            ticketPriorityId: TicketPriorityId == 0 ? 0 : TicketPriorityId, ticketPriorityName: priority,
            escalationHours: hours, CompanyId: companyId,
            createdBy: TicketPriorityId == 0 ? EmployeeId : null, updatedBy: TicketPriorityId == 0 ? null : EmployeeId
        };
        $.ajax({
            url: TicketPriorityId == 0 ? '@baseUrl/TicketPriorityAPI/CreateTicketPriority' : '@baseUrl/TicketPriorityAPI/UpdateTicketPriority',
            type: TicketPriorityId == 0 ? 'POST' : 'PUT',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(data),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (TicketPriorityId == 0 ? 'Priority created.' : 'Priority updated.'), 'success');
                    $('#addTicketPriorityModel').modal('hide'); TicketPriorityDataTable();
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateTicketPriority', TicketPriorityId == 0 ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Error while saving priority.', 'error');
                setBtnNormal('#btnCreateTicketPriority', TicketPriorityId == 0 ? 'Save' : 'Update');
            }
        });
    });

    function updateTicketPriority(id) {
        var data = _priorityCache[id];
        if (!data) return;
        clearTicketPriorityForm();
        TicketPriorityId = data.ticketPriorityId;
        $('#txtTicketPriority').val(data.ticketPriorityName);
        $('#txtEscalationHours').val(data.escalationHours);
        $('.priorityFormType').text('Update');
        setBtnNormal('#btnCreateTicketPriority', 'Update');
        $('#addTicketPriorityModel').modal('show');
    }

    function deleteTicketPriority(id) {
        wmsConfirm('Are you sure you want to delete this priority?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/TicketPriorityAPI/DeleteTicketPriority', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: EmployeeId }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    TicketPriorityDataTable();
                },
                error: function () { showToast('Error deleting priority.', 'error'); }
            });
        });
    }

    function clearTicketPriorityForm() {
        TicketPriorityId = 0;
        $('#txtTicketPriority, #txtEscalationHours').val('').removeClass('is-invalid');
        $('#spnTicketPriority, #spnEscalationHours').hide();
        $('.priorityFormType').text('Add'); setBtnNormal('#btnCreateTicketPriority', 'Save');
    }
</script>
