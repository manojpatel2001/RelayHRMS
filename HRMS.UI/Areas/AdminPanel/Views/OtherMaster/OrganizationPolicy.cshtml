@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Organization Policy";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Organization Policy</h6>
		<button id="addOrganizationPolicy" type="button" class="btn btn-primary btn-sm">Add Policy</button>
	</div>
	<div class="card-body">
		<div id="policyGrid"></div>
	</div>
</div>

<div class="modal fade" id="addOrganizationPolicyModel" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title"><span class="formType">Add</span> Organization Policy</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row">
					<div class="col-md-4">
						<div class="fg fg-req">
							<label for="txtTitle">Title</label>
							<input type="text" placeholder="Title" id="txtTitle" autocomplete="off" />
							<span class="field-validation-error" id="spnTitle" style="display:none;">Please Enter Policy Title</span>
						</div>
					</div>
					<div class="col-md-4">
						<div class="fg fg-req">
							<label for="txtToolTip">Tool Tip</label>
							<input type="text" placeholder="Tool Tip" id="txtToolTip" autocomplete="off" />
							<span class="field-validation-error" id="spnToolTip" style="display:none;">Please Enter Tool Tip</span>
						</div>
					</div>
					<div class="col-md-4">
						<div class="fg">
							<label for="txtFromDate">From Date</label>
							<input type="date" id="txtFromDate" />
						</div>
					</div>
					<div class="col-md-4">
						<div class="fg">
							<label for="txtToDate">To Date</label>
							<input type="date" id="txtToDate" />
						</div>
					</div>
					<div class="col-md-4">
						<div class="fg">
							<label for="txtSorting">Sorting</label>
							<input type="number" placeholder="Sorting" id="txtSorting" step="1" min="0" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
						</div>
					</div>
					<div class="col-md-4">
						<div class="fg">
							<label for="txtUploadDocument">Upload Document</label>
							<input type="file" id="txtUploadDocument" />
						</div>
						<div class="d-flex align-items-center gap-2 mt-1">
							<button type="button" class="btn btn-primary btn-sm" id="btnUpload">Upload</button>
							<button type="button" class="btn btn-danger btn-sm d-none" id="btnRemove">Remove</button>
							<small id="uploadMessage" class="text-muted"></small>
						</div>
					</div>
				</div>
				<div class="row mt-2">
					<div class="col-12">
						<label class="fw-semibold me-3" style="font-size:13px;">Grouping:</label>
						<div class="d-inline-flex flex-wrap gap-3">
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="txtAll" />
								<label class="form-check-label" for="txtAll">All</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="txtEmployee" />
								<label class="form-check-label" for="txtEmployee">Employee</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="txtNewJoinig" />
								<label class="form-check-label" for="txtNewJoinig">New Joining</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="txtDepartment" />
								<label class="form-check-label" for="txtDepartment">Department</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="txtRecruitmentDocs" />
								<label class="form-check-label" for="txtRecruitmentDocs">Recruitment Docs</label>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreatePolicy">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Save</span>
				</button>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var OrganizationPolicyId = 0;
	var DocumentUrl = null;
	var uploadedDocument = null;
	var _policyCache = {};

	var grid = WMSGrid.create({
		container: 'policyGrid',
		title: 'All Organization Policies',
		icon: 'bx-file',
		perPage: 10,
		columns: [
			{ field: 'organizationPolicyName', header: 'Policy Name', width: '180px' },
			{ field: 'toolTip',                header: 'Tooltip',     width: '160px' },
			{ field: 'fromDate',               header: 'From Date',   width: '110px',
				render: function (v) { return v ? new Date(v).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'; }
			},
			{ field: 'toDate',                 header: 'To Date',     width: '110px',
				render: function (v) { return v ? new Date(v).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'; }
			},
			{ field: 'sorting',                header: 'Sorting',     width: '80px' },
			{ field: 'grouping',               header: 'Grouping',    width: '160px' },
			{ field: 'documentUrl',            header: 'Document',    width: '100px',
				render: function (v) { return v ? '<a href="' + v + '" target="_blank" class="wg-btn wg-btn-ghost" style="font-size:11px;padding:3px 8px;"><i class="bx bx-file"></i> View</a>' : '<span style="color:#CBD5E1">—</span>'; }
			},
			{ field: 'isEnabled',              header: 'Status',      width: '90px',
				render: function (v) { return v ? '<span class="wg-pill wg-pill-green">Active</span>' : '<span class="wg-pill wg-pill-amber">Inactive</span>'; }
			},
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '130px',
				render: function (v, row) {
					return '<button class="wg-btn wg-btn-primary" onclick="_editPolicy(' + row.organizationPolicyId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
					       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deletePolicy(' + row.organizationPolicyId + ',\'' + (row.organizationPolicyName || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
				}
			}
		],
		features: { export: true }
	});

	function loadTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/OrganizationPolicyAPI/GetAllOrganizationPolicy', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_policyCache = {};
				rows.forEach(function (r) { _policyCache[r.organizationPolicyId] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) showToast(data.responseMessage || 'No records found.', 'info');
			},
			error: function () { grid.hideLoader(); showToast('Failed to load policies.', 'error'); }
		});
	}

	// File upload helpers
	$('#btnUpload').on('click', function () {
		var file = $('#txtUploadDocument')[0].files[0];
		var allowed = ['.pdf', '.doc', '.docx', '.txt'];
		if (!file) { $('#uploadMessage').text('Please select a document.').removeClass('text-success text-muted').addClass('text-danger'); return; }
		var ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
		if (allowed.indexOf(ext) === -1) { $('#uploadMessage').text('Only PDF, DOC, DOCX, TXT allowed.').removeClass('text-success text-muted').addClass('text-danger'); return; }
		uploadedDocument = file;
		$('#uploadMessage').text('Uploaded: ' + file.name).removeClass('text-danger text-muted').addClass('text-success');
		$('#btnUpload').addClass('d-none');
		$('#btnRemove').removeClass('d-none');
	});

	$('#btnRemove').on('click', removeFile);
	function removeFile() {
		uploadedDocument = null;
		$('#txtUploadDocument').val('');
		$('#uploadMessage').text('').removeClass('text-success text-danger').addClass('text-muted');
		$('#btnUpload').removeClass('d-none');
		$('#btnRemove').addClass('d-none');
	}

	// Checkbox mutual-exclusion
	$('#txtAll').on('change', function () {
		if ($(this).is(':checked')) $('#txtEmployee, #txtNewJoinig, #txtDepartment, #txtRecruitmentDocs').prop('checked', false);
	});
	$('#txtEmployee, #txtNewJoinig, #txtDepartment, #txtRecruitmentDocs').on('change', function () {
		if ($(this).is(':checked')) $('#txtAll').prop('checked', false);
	});

	$('#addOrganizationPolicy').on('click', function () { resetForm(); $('#addOrganizationPolicyModel').modal('show'); });
	$('#addOrganizationPolicyModel').on('hidden.bs.modal', function () { resetForm(); });

	$('#btnCreatePolicy').on('click', function () {
		var title   = $('#txtTitle').val().trim();
		var tooltip = $('#txtToolTip').val().trim();

		var isValid = true;
		if (!title)   { $('#spnTitle').show();   $('#txtTitle').addClass('is-invalid');   isValid = false; } else { $('#spnTitle').hide();   $('#txtTitle').removeClass('is-invalid'); }
		if (!tooltip) { $('#spnToolTip').show(); $('#txtToolTip').addClass('is-invalid'); isValid = false; } else { $('#spnToolTip').hide(); $('#txtToolTip').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnCreatePolicy', OrganizationPolicyId ? 'Updating...' : 'Saving...');

		var groupingParts = [];
		if ($('#txtAll').is(':checked'))            groupingParts.push('All');
		if ($('#txtEmployee').is(':checked'))       groupingParts.push('Employee');
		if ($('#txtNewJoinig').is(':checked'))      groupingParts.push('New Joining');
		if ($('#txtDepartment').is(':checked'))     groupingParts.push('Department');
		if ($('#txtRecruitmentDocs').is(':checked')) groupingParts.push('Recruitment Docs');

		var formData = new FormData();
		formData.append('OrganizationPolicyId', OrganizationPolicyId);
		formData.append('organizationPolicyName', title);
		formData.append('tooltip', tooltip);
		formData.append('fromDate', $('#txtFromDate').val());
		formData.append('toDate',   $('#txtToDate').val());
		formData.append('sorting',  $('#txtSorting').val());
		formData.append('grouping', groupingParts.join(','));
		formData.append('documentUrl', OrganizationPolicyId ? (DocumentUrl || '') : '');
		if (uploadedDocument) formData.append('documentFile', uploadedDocument);

		$.ajax({
			url: '@baseUrl/OrganizationPolicyAPI/CreateOrganizationPolicy',
			type: 'POST', processData: false, contentType: false, _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			data: formData,
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (OrganizationPolicyId ? 'Policy updated.' : 'Policy created.'), 'success');
					$('#addOrganizationPolicyModel').modal('hide');
					loadTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnCreatePolicy', OrganizationPolicyId ? 'Update' : 'Save');
				}
			},
			error: function () {
				showToast('Unable to save policy.', 'error');
				setBtnNormal('#btnCreatePolicy', OrganizationPolicyId ? 'Update' : 'Save');
			}
		});
	});

	function resetForm() {
		OrganizationPolicyId = 0;
		DocumentUrl = null;
		$('#txtTitle, #txtToolTip, #txtFromDate, #txtToDate, #txtSorting').val('').removeClass('is-invalid');
		$('#txtAll, #txtEmployee, #txtNewJoinig, #txtDepartment, #txtRecruitmentDocs').prop('checked', false);
		$('#spnTitle, #spnToolTip').hide();
		removeFile();
		$('.formType').text('Add');
		setBtnNormal('#btnCreatePolicy', 'Save');
	}

	function formatDate(d) {
		if (!d) return '';
		var dt = new Date(d);
		return dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0');
	}

	window._editPolicy = function (id) {
		var data = _policyCache[id];
		if (!data) return;
		resetForm();
		OrganizationPolicyId = data.organizationPolicyId;
		DocumentUrl = data.documentUrl;
		$('#txtTitle').val(data.organizationPolicyName || '');
		$('#txtToolTip').val(data.toolTip || '');
		$('#txtFromDate').val(formatDate(data.fromDate));
		$('#txtToDate').val(formatDate(data.toDate));
		$('#txtSorting').val(data.sorting || '');
		if (data.grouping) {
			var g = data.grouping.split(',');
			g.forEach(function (item) {
				switch (item.trim()) {
					case 'All':             $('#txtAll').prop('checked', true); break;
					case 'Employee':        $('#txtEmployee').prop('checked', true); break;
					case 'New Joining':     $('#txtNewJoinig').prop('checked', true); break;
					case 'Department':      $('#txtDepartment').prop('checked', true); break;
					case 'Recruitment Docs': $('#txtRecruitmentDocs').prop('checked', true); break;
				}
			});
		}
		if (data.documentUrl) {
			$('#uploadMessage').text('Existing: ' + data.documentUrl.split('/').pop()).removeClass('text-danger text-muted').addClass('text-success');
		}
		$('.formType').text('Update');
		setBtnNormal('#btnCreatePolicy', 'Update');
		$('#addOrganizationPolicyModel').modal('show');
	};

	window._deletePolicy = function (id, name) {
		wmsConfirm('Are you sure you want to delete policy <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/OrganizationPolicyAPI/DeleteOrganizationPolicy', type: 'DELETE',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify({ id: id, deletedBy: null }),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Policy deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () { loadTable(); });
})();
</script>
