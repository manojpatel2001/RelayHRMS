@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Candidate Document Types";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Candidate Document Types</h6>
        <button id="btnAddType" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bx bx-plus"></i> Add Document Type
        </button>
    </div>
    <div class="card-body">
        <div id="docTypeGridContainer"></div>
    </div>
</div>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal fade" id="docTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="formType">Add</span> Document Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="mb-2">
                    <label class="fg-req">Document Name</label>
                    <input type="text" id="txtDocumentName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Sort Order</label>
                    <input type="number" min="0" id="txtSortOrder" class="form-control" value="0" />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkIsMandatory">
                    <label class="form-check-label" for="chkIsMandatory">Mandatory</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitType" class="btn btn-primary btn-sm">Save</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    const EmployeeId = localStorage.getItem("EmployeeId");
    let docTypeId = 0;

    $(document).ready(function () {
        PermGuard.onReady(function () { loadDocTypes(); });
        PermGuard.applyActions('recruitment-candidatedocumenttypemaster', { create: '#btnAddType' });
    });

    var docTypeGrid = WMSGrid.create({
        container: 'docTypeGridContainer',
        title: 'Document Types',
        icon: 'bx-file-blank',
        columns: [
            { field: 'documentName', header: 'Document Name', width: '220px' },
            { field: 'isMandatory', header: 'Mandatory', width: '100px', align: 'center', render: function (v) { return v ? '<span class="badge bg-danger">Mandatory</span>' : '<span class="badge bg-secondary">Optional</span>'; } },
            { field: 'sortOrder', header: 'Sort Order', width: '100px', align: 'center' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    var editBtn = PermGuard.has('edit-recruitment-candidatedocumenttypemaster')
                        ? '<button class="wg-btn wg-btn-primary" title="Edit" onclick="_editType(' + row.candidateDocumentTypeId + ')"><i class="bx bx-edit"></i></button> '
                        : '';
                    var deleteBtn = PermGuard.has('delete-recruitment-candidatedocumenttypemaster')
                        ? '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteType(' + row.candidateDocumentTypeId + ')"><i class="bx bx-trash"></i></button>'
                        : '';
                    return editBtn + deleteBtn;
                }
            }
        ]
    });

    function loadDocTypes() {
        docTypeGrid.showLoader();
        $.ajax({
            url: '@baseUrl/CandidateDocumentAPI/GetAllDocumentTypes',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) { docTypeGrid.setData(res.data || []); docTypeGrid.hideLoader(); },
            error: function () { docTypeGrid.hideLoader(); showToast('Failed to load document types.', 'error'); }
        });
    }

    $('#btnAddType').click(function () {
        docTypeId = 0;
        $('#txtDocumentName').val(''); $('#txtSortOrder').val(0); $('#chkIsMandatory').prop('checked', false);
        $('.formType').text('Add');
        $('#docTypeModal').modal('show');
    });

    $('#btnSubmitType').click(function () {
        if (!$('#txtDocumentName').val()) { showToast('Document name is required.', 'error'); return; }

        var payload = {
            CandidateDocumentTypeId: docTypeId,
            DocumentName: $('#txtDocumentName').val(),
            SortOrder: parseInt($('#txtSortOrder').val()) || 0,
            IsMandatory: $('#chkIsMandatory').is(':checked'),
            CreatedBy: EmployeeId,
            UpdatedBy: EmployeeId
        };

        var url = docTypeId > 0 ? '@baseUrl/CandidateDocumentAPI/UpdateDocumentType' : '@baseUrl/CandidateDocumentAPI/CreateDocumentType';
        $.ajax({
            type: 'POST', url: url, data: JSON.stringify(payload), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('Saved successfully.', 'success'); $('#docTypeModal').modal('hide'); loadDocTypes(); }
                else showToast(res.responseMessage || 'Save failed.', 'error');
            }
        });
    });

    window._editType = function (id) {
        var row = (docTypeGrid.getData ? docTypeGrid.getData() : []).find(function (r) { return r.candidateDocumentTypeId === id; });
        if (!row) return;
        docTypeId = id;
        $('#txtDocumentName').val(row.documentName);
        $('#txtSortOrder').val(row.sortOrder);
        $('#chkIsMandatory').prop('checked', row.isMandatory);
        $('.formType').text('Edit');
        $('#docTypeModal').modal('show');
    };

    window._deleteType = function (id) {
        if (!confirm('Remove this document type?')) return;
        $.ajax({
            type: 'DELETE', url: '@baseUrl/CandidateDocumentAPI/DeleteDocumentType',
            data: JSON.stringify({ Id: id, DeletedBy: EmployeeId }), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('Removed successfully.', 'success'); loadDocTypes(); }
                else showToast(res.responseMessage || 'Delete failed.', 'error');
            }
        });
    };
</script>
