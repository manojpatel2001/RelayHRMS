@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Job Position Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Job Position Master</h6>
        <div class="d-flex align-items-center gap-2">
            <button id="btnAddJobPosition" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add Job Position
            </button>
        </div>
    </div>
    <div class="card-body">
        <div id="jobPositionGridContainer"></div>
    </div>
</div>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal fade" id="jobPositionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="formType">Add</span> Job Position</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="fg-req">Manpower Requisition (Approved)</label>
                        <select id="ddlManpowerRequisition" class="form-select">
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="fg-req">Position Title</label>
                        <input type="text" id="txtPositionTitle" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label>Department</label>
                        <select id="ddlDepartment" class="form-select"><option value="">Select</option></select>
                    </div>
                    <div class="col-md-3">
                        <label>Designation</label>
                        <select id="ddlDesignation" class="form-select"><option value="">Select</option></select>
                    </div>
                    <div class="col-md-3">
                        <label>Branch</label>
                        <select id="ddlBranch" class="form-select"><option value="">Select</option></select>
                    </div>
                    <div class="col-md-3">
                        <label>Grade</label>
                        <select id="ddlGrade" class="form-select"><option value="">Select</option></select>
                    </div>

                    <div class="col-md-3">
                        <label>Employment Type</label>
                        <select id="ddlEmploymentType" class="form-select">
                            <option value="">Select</option>
                            <option>Permanent</option>
                            <option>Contract</option>
                            <option>Temporary</option>
                            <option>Intern</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="fg-req">Vacancy Count</label>
                        <input type="number" min="1" id="txtVacancyCount" class="form-control" value="1" />
                    </div>
                    <div class="col-md-3">
                        <label>Priority</label>
                        <select id="ddlPriority" class="form-select">
                            <option value="">Select</option>
                            <option>High</option>
                            <option>Medium</option>
                            <option>Low</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Target Closure Date</label>
                        <input type="date" id="txtTargetClosureDate" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label>Min Experience (Yrs)</label>
                        <input type="number" step="0.5" min="0" id="txtMinExperience" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>Max Experience (Yrs)</label>
                        <input type="number" step="0.5" min="0" id="txtMaxExperience" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label>Min Education Level</label>
                        <select id="ddlMinEducationLevel" class="form-select">
                            <option value="">Select</option>
                            <option>12th</option>
                            <option>Diploma</option>
                            <option>Graduate</option>
                            <option>Post Graduate</option>
                            <option>Doctorate</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Status</label>
                        <select id="ddlStatus" class="form-select">
                            <option>Open</option>
                            <option>OnHold</option>
                            <option>Closed</option>
                            <option>Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Required Skills (comma separated)</label>
                        <textarea id="txtRequiredSkills" class="form-control" rows="2" placeholder="e.g. C#, SQL Server, ASP.NET Core"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label>Preferred Skills (comma separated)</label>
                        <textarea id="txtPreferredSkills" class="form-control" rows="2" placeholder="e.g. Azure, Docker"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label>Min Budget</label>
                        <input type="number" step="0.01" id="txtMinBudget" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label>Max Budget</label>
                        <input type="number" step="0.01" id="txtMaxBudget" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label>Owner Recruiter</label>
                        <select id="ddlOwnerRecruiter" class="form-select"><option value="">Select</option></select>
                    </div>

                    <div class="col-md-12">
                        <label>Job Description</label>
                        <textarea id="txtJobDescription" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitJobPosition" class="btn btn-primary btn-sm">Save</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails ? companyDetails.CompanyId : null;
    const EmployeeId = localStorage.getItem("EmployeeId");
    let jobPositionId = 0;

    $(document).ready(function () {
        PermGuard.onReady(function () { loadJobPositions(); });
        loadApprovedRequisitions();
        loadOrgDropdowns();
        loadOwnerRecruiterDropdown();
        PermGuard.applyActions('recruitment-jobpositionmaster', { create: '#btnAddJobPosition' });
    });

    function fmtDate(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + d.getFullYear();
    }

    function statusBadge(status) {
        var colors = { Open: 'success', OnHold: 'warning', Closed: 'secondary', Cancelled: 'danger' };
        var c = colors[status] || 'secondary';
        return '<span class="badge bg-' + c + '">' + (status || '') + '</span>';
    }

    var jobPositionGrid = WMSGrid.create({
        container: 'jobPositionGridContainer',
        title: 'Job Positions',
        icon: 'bx-briefcase',
        columns: [
            { field: 'positionTitle', header: 'Position Title', width: '200px' },
            { field: 'departmentName', header: 'Department', width: '140px' },
            { field: 'designationName', header: 'Designation', width: '140px' },
            { field: 'branchName', header: 'Branch', width: '120px' },
            { field: 'employmentType', header: 'Employment Type', width: '130px' },
            { field: 'vacancyCount', header: 'Vacancy', width: '80px', align: 'center' },
            { field: 'filledCount', header: 'Filled', width: '80px', align: 'center' },
            { field: 'priority', header: 'Priority', width: '90px' },
            { field: 'status', header: 'Status', width: '100px', render: function (v) { return statusBadge(v); } },
            { field: 'targetClosureDate', header: 'Target Closure', width: '120px', render: function (v) { return fmtDate(v); } },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '150px',
                render: function (v, row) {
                    var editBtn = PermGuard.has('edit-recruitment-jobpositionmaster')
                        ? '<button class="wg-btn wg-btn-primary" title="Edit" onclick="_editJobPosition(' + row.jobPositionId + ')"><i class="bx bx-edit"></i></button> '
                        : '';
                    var deleteBtn = PermGuard.has('delete-recruitment-jobpositionmaster')
                        ? '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteJobPosition(' + row.jobPositionId + ')"><i class="bx bx-trash"></i></button>'
                        : '';
                    return '<a class="wg-btn wg-btn-outline" title="Candidates" href="@Url.Action("CandidatePipeline", "Recruitment")?jobPositionId=' + row.jobPositionId + '"><i class="bx bx-group"></i></a> ' +
                           editBtn + deleteBtn;
                }
            }
        ],
        features: { export: true }
    });

    function loadJobPositions() {
        jobPositionGrid.showLoader();
        $.ajax({
            type: 'POST',
            url: '@baseUrl/JobPositionAPI/GetAllJobPositions',
            data: JSON.stringify({ CompanyId: CompanyId }),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                jobPositionGrid.setData(res.data || []);
                jobPositionGrid.hideLoader();
            },
            error: function () {
                jobPositionGrid.hideLoader();
                showToast('Failed to load job positions.', 'error');
            }
        });
    }

    function loadApprovedRequisitions() {
        $.ajax({
            type: 'POST',
            url: '@baseUrl/ManpowerRequisitionAPI/GetAllManpowerRequisitionsAdmin',
            data: JSON.stringify({ CompanyId: CompanyId }),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                var $sel = $('#ddlManpowerRequisition').empty().append('<option value="">Select</option>');
                (res.data || []).forEach(function (r) {
                    $sel.append($('<option>', { value: r.ManpowerRequisitionId, text: (r.SerialNo || r.ManpowerRequisitionId) + ' - ' + (r.DesignationName || '') + ' (' + (r.DepartmentName || '') + ')' }));
                });
            }
        });
    }

    function loadOrgDropdowns() {
        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/GetDropDownForManpower/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (!response.isSuccess) return;
                fillSelect('#ddlDepartment', response.data.departments, 'departmentId', 'departmentName');
                fillSelect('#ddlDesignation', response.data.designations, 'designationId', 'designationName');
            }
        });
        $.ajax({
            url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) { fillSelect('#ddlBranch', response.data, 'branchId', 'branchName'); }
        });
        $.ajax({
            url: '@baseUrl/GradeAPI/GetAllGrade',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) { fillSelect('#ddlGrade', response.data, 'gradeId', 'gradeName'); },
            error: function () { /* non-fatal */ }
        });
    }

    function loadOwnerRecruiterDropdown() {
        $.ajax({
            url: '@baseUrl/EmployeeMasterAPI/GetAllEmployee_DropDown/' + CompanyId + '?BranchId=&Month=0&Year=0',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) { fillSelect('#ddlOwnerRecruiter', response.data, 'employeeId', 'fullName'); },
            error: function () { /* non-fatal */ }
        });
    }

    function fillSelect(selector, data, valueKey, textKey) {
        var $sel = $(selector);
        var current = $sel.val();
        $sel.empty().append('<option value="">Select</option>');
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item[valueKey], text: item[textKey] }));
        });
        if (current) $sel.val(current);
    }

    $('#btnAddJobPosition').click(function () {
        resetForm();
        $('.formType').text('Add');
        $('#jobPositionModal').modal('show');
    });

    function resetForm() {
        jobPositionId = 0;
        $('#jobPositionModal .form-control, #jobPositionModal .form-select').val('');
        $('#txtVacancyCount').val(1);
        $('#ddlStatus').val('Open');
    }

    function collectForm() {
        return {
            JobPositionId: jobPositionId,
            ManpowerRequisitionId: parseInt($('#ddlManpowerRequisition').val()) || 0,
            PositionTitle: $('#txtPositionTitle').val(),
            DepartmentId: $('#ddlDepartment').val() || null,
            DesignationId: $('#ddlDesignation').val() || null,
            BranchId: $('#ddlBranch').val() || null,
            CompanyId: CompanyId,
            GradeId: $('#ddlGrade').val() || null,
            EmploymentType: $('#ddlEmploymentType').val(),
            VacancyCount: parseInt($('#txtVacancyCount').val()) || 1,
            MinExperienceYears: $('#txtMinExperience').val() || null,
            MaxExperienceYears: $('#txtMaxExperience').val() || null,
            MinEducationLevel: $('#ddlMinEducationLevel').val(),
            RequiredSkills: $('#txtRequiredSkills').val(),
            PreferredSkills: $('#txtPreferredSkills').val(),
            JobDescription: $('#txtJobDescription').val(),
            MinBudget: $('#txtMinBudget').val() || null,
            MaxBudget: $('#txtMaxBudget').val() || null,
            Priority: $('#ddlPriority').val(),
            OwnerRecruiterId: $('#ddlOwnerRecruiter').val() || null,
            Status: $('#ddlStatus').val(),
            TargetClosureDate: $('#txtTargetClosureDate').val() || null,
            CreatedBy: EmployeeId,
            UpdatedBy: EmployeeId
        };
    }

    $('#btnSubmitJobPosition').click(function () {
        if (!$('#ddlManpowerRequisition').val() || !$('#txtPositionTitle').val()) {
            showToast('Manpower Requisition and Position Title are required.', 'error');
            return;
        }
        var payload = collectForm();
        var url = jobPositionId > 0 ? '@baseUrl/JobPositionAPI/UpdateJobPosition' : '@baseUrl/JobPositionAPI/CreateJobPosition';
        $.ajax({
            type: 'POST',
            url: url,
            data: JSON.stringify(payload),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) {
                    showToast(res.responseMessage || 'Saved successfully.', 'success');
                    $('#jobPositionModal').modal('hide');
                    loadJobPositions();
                } else {
                    showToast(res.responseMessage || 'Save failed.', 'error');
                }
            },
            error: function () { showToast('Save failed. Please try again later.', 'error'); }
        });
    });

    window._editJobPosition = function (id) {
        $.ajax({
            url: '@baseUrl/JobPositionAPI/GetJobPositionById/' + id,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (!res.isSuccess || !res.data) return;
                var d = res.data;
                resetForm();
                jobPositionId = d.jobPositionId;
                $('#ddlManpowerRequisition').val(d.manpowerRequisitionId);
                $('#txtPositionTitle').val(d.positionTitle);
                $('#ddlDepartment').val(d.departmentId);
                $('#ddlDesignation').val(d.designationId);
                $('#ddlBranch').val(d.branchId);
                $('#ddlGrade').val(d.gradeId);
                $('#ddlEmploymentType').val(d.employmentType);
                $('#txtVacancyCount').val(d.vacancyCount);
                $('#txtMinExperience').val(d.minExperienceYears);
                $('#txtMaxExperience').val(d.maxExperienceYears);
                $('#ddlMinEducationLevel').val(d.minEducationLevel);
                $('#txtRequiredSkills').val(d.requiredSkills);
                $('#txtPreferredSkills').val(d.preferredSkills);
                $('#txtJobDescription').val(d.jobDescription);
                $('#txtMinBudget').val(d.minBudget);
                $('#txtMaxBudget').val(d.maxBudget);
                $('#ddlPriority').val(d.priority);
                $('#ddlOwnerRecruiter').val(d.ownerRecruiterId);
                $('#ddlStatus').val(d.status);
                $('#txtTargetClosureDate').val(d.targetClosureDate ? d.targetClosureDate.substring(0, 10) : '');
                $('.formType').text('Edit');
                $('#jobPositionModal').modal('show');
            }
        });
    };

    window._deleteJobPosition = function (id) {
        if (!confirm('Delete this job position?')) return;
        $.ajax({
            type: 'DELETE',
            url: '@baseUrl/JobPositionAPI/DeleteJobPosition',
            data: JSON.stringify({ Id: id, DeletedBy: EmployeeId }),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('Deleted successfully.', 'success'); loadJobPositions(); }
                else showToast(res.responseMessage || 'Delete failed.', 'error');
            }
        });
    };
</script>
