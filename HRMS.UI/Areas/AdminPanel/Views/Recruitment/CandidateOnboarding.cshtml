@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Candidate Onboarding";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Candidate Onboarding</h6>
        <select id="ddlCandidateApplication" class="form-select form-select-sm" style="width:320px">
            <option value="">Select Candidate Application</option>
        </select>
    </div>
</div>

<div id="onboardingWorkspace" style="display:none;">

    <!-- ===== Document Collection ===== -->
    <div class="card mb-3">
        <div class="card-header py-2"><h6 class="mb-0">Document Collection</h6></div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label>Document Type</label>
                    <select id="ddlDocumentType" class="form-select"></select>
                </div>
                <div class="col-md-5">
                    <label>File</label>
                    <input type="file" id="fileDocument" class="form-control" />
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnUploadDocument" class="btn btn-primary btn-sm w-100"><i class="bx bx-upload"></i> Upload</button>
                </div>
            </div>
            <table class="table table-sm" id="tblDocuments">
                <thead><tr><th>Document Type</th><th>File</th><th>Status</th><th>Uploaded On</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ===== Background Verification ===== -->
    <div class="card mb-3">
        <div class="card-header py-2"><h6 class="mb-0">Background Verification</h6></div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label>Check Type</label>
                    <select id="ddlCheckType" class="form-select">
                        <option value="PAN">PAN</option>
                        <option value="Aadhaar">Aadhaar</option>
                        <option value="Passport">Passport</option>
                        <option value="DrivingLicense">Driving License</option>
                        <option value="Education">Education</option>
                        <option value="Employment">Employment</option>
                        <option value="Reference">Reference</option>
                        <option value="Police">Police</option>
                        <option value="Criminal">Criminal</option>
                        <option value="Address">Address</option>
                        <option value="Medical">Medical (Optional)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Vendor Name</label>
                    <input type="text" id="txtVendorName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label>Vendor Contact</label>
                    <input type="text" id="txtVendorContact" class="form-control" />
                </div>
                <div class="col-md-3">
                    <button type="button" id="btnAddBGVCheck" class="btn btn-primary btn-sm w-100"><i class="bx bx-plus"></i> Add Check</button>
                </div>
            </div>
            <table class="table table-sm" id="tblBGVChecks">
                <thead><tr><th>Check Type</th><th>Vendor</th><th>Status</th><th>Completed On</th><th>Action</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ===== HR Approval Checklist + Joining Confirmation ===== -->
    <div class="card mb-3">
        <div class="card-header py-2"><h6 class="mb-0">HR Approval Checklist &amp; Joining Confirmation</h6></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkOfferAccepted"><label class="form-check-label" for="chkOfferAccepted">Offer Accepted</label></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkDocumentsComplete"><label class="form-check-label" for="chkDocumentsComplete">Documents Complete</label> <small id="hintDocuments" class="text-muted d-block"></small></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkBGVComplete"><label class="form-check-label" for="chkBGVComplete">BGV Complete</label> <small id="hintBGV" class="text-muted d-block"></small></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkMedicalComplete"><label class="form-check-label" for="chkMedicalComplete">Medical Complete (Optional)</label></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkSalaryApproved"><label class="form-check-label" for="chkSalaryApproved">Salary Approved</label></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkJoiningApproved"><label class="form-check-label" for="chkJoiningApproved">Joining Approved</label></div>
                <div class="col-md-3 form-check"><input class="form-check-input" type="checkbox" id="chkEmployeeCreationApproved"><label class="form-check-label" for="chkEmployeeCreationApproved">Employee Creation Approved</label></div>

                <div class="col-md-4">
                    <label>Joining Status</label>
                    <select id="ddlJoiningStatus" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Postponed">Postponed</option>
                        <option value="NoShow">No Show</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label>Actual Joining Date</label>
                    <input type="date" id="txtActualJoiningDate" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label>Final Remarks</label>
                    <textarea id="txtFinalRemarks" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3 d-flex justify-content-between align-items-center">
                <button type="button" id="btnSaveChecklist" class="btn btn-outline-primary btn-sm">Save Checklist</button>
                <button type="button" id="btnConvertToEmployee" class="btn btn-success" disabled>
                    <i class="bx bx-user-check"></i> Convert to Employee
                </button>
            </div>
            <div id="conversionResult" class="alert alert-success mt-3" style="display:none;"></div>
        </div>
    </div>

</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails ? companyDetails.CompanyId : null;
    const EmployeeId = localStorage.getItem("EmployeeId");
    var currentApplicationId = 0;
    var documentTypesCache = [];

    $(document).ready(function () {
        loadCandidateApplicationDropdown();
        loadDocumentTypes();
    });

    function fmtDate(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + d.getFullYear();
    }

    function loadCandidateApplicationDropdown() {
        $.ajax({
            url: '@baseUrl/CandidateApplicationAPI/GetAllCandidateApplications',
            method: 'POST', data: JSON.stringify({}), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                var $sel = $('#ddlCandidateApplication');
                (res.data || []).forEach(function (item) {
                    $sel.append($('<option>', { value: item.candidateApplicationId, text: item.fullName + ' - ' + (item.positionTitle || '') }));
                });
            }
        });
    }

    $('#ddlCandidateApplication').on('change', function () {
        currentApplicationId = parseInt($(this).val()) || 0;
        if (!currentApplicationId) { $('#onboardingWorkspace').hide(); return; }
        $('#onboardingWorkspace').show();
        loadDocuments();
        loadBGVChecks();
        loadChecklist();
    });

    // ===== Document Collection =====
    function loadDocumentTypes() {
        $.ajax({
            url: '@baseUrl/CandidateDocumentAPI/GetAllDocumentTypes',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                documentTypesCache = res.data || [];
                var $sel = $('#ddlDocumentType').empty();
                documentTypesCache.forEach(function (t) {
                    $sel.append($('<option>', { value: t.candidateDocumentTypeId, text: t.documentName + (t.isMandatory ? ' *' : '') }));
                });
            }
        });
    }

    function loadDocuments() {
        $.ajax({
            url: '@baseUrl/CandidateDocumentAPI/GetDocumentsByApplicationId/' + currentApplicationId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                var rows = res.data || [];
                var $tbody = $('#tblDocuments tbody').empty();
                rows.forEach(function (r) {
                    $tbody.append('<tr><td>' + r.documentName + (r.isMandatory ? ' <span class="badge bg-danger">Mandatory</span>' : '') + '</td>' +
                        '<td>' + (r.documentUrl ? '<a href="' + r.documentUrl + '" target="_blank">View</a>' : '-') + '</td>' +
                        '<td>' + (r.verifiedStatus || 'Pending') + '</td>' +
                        '<td>' + fmtDate(r.createdDate) + '</td></tr>');
                });
                var mandatoryCount = documentTypesCache.filter(function (t) { return t.isMandatory; }).length;
                var uploadedMandatory = rows.filter(function (r) { return r.isMandatory; }).length;
                $('#hintDocuments').text(uploadedMandatory + ' of ' + mandatoryCount + ' mandatory documents uploaded');
            }
        });
    }

    $('#btnUploadDocument').click(function () {
        var typeId = $('#ddlDocumentType').val();
        var file = $('#fileDocument')[0].files[0];
        if (!typeId || !file) { showToast('Select a document type and choose a file.', 'error'); return; }

        var formData = new FormData();
        formData.append('CandidateApplicationId', currentApplicationId);
        formData.append('CandidateDocumentTypeId', typeId);
        formData.append('CreatedBy', EmployeeId);
        formData.append('documentFile', file);

        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateDocumentAPI/UploadDocument',
            data: formData, processData: false, contentType: false,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('Document uploaded successfully.', 'success'); $('#fileDocument').val(''); loadDocuments(); }
                else showToast(res.responseMessage || 'Upload failed.', 'error');
            },
            error: function () { showToast('Upload failed.', 'error'); }
        });
    });

    // ===== Background Verification =====
    function loadBGVChecks() {
        $.ajax({
            url: '@baseUrl/CandidateBGVAPI/GetChecksByApplicationId/' + currentApplicationId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                var rows = res.data || [];
                var $tbody = $('#tblBGVChecks tbody').empty();
                rows.forEach(function (r) {
                    $tbody.append('<tr><td>' + r.checkType + '</td><td>' + (r.vendorName || '-') + '</td>' +
                        '<td><select class="form-select form-select-sm bgv-status" data-id="' + r.candidateBGVCheckId + '">' +
                        ['Pending', 'InProgress', 'Completed', 'Rejected'].map(function (s) { return '<option value="' + s + '"' + (r.status === s ? ' selected' : '') + '>' + s + '</option>'; }).join('') +
                        '</select></td>' +
                        '<td>' + fmtDate(r.completedDate) + '</td>' +
                        '<td><button type="button" class="btn btn-sm btn-outline-primary bgv-save" data-id="' + r.candidateBGVCheckId + '">Save</button></td></tr>');
                });
                var total = rows.length;
                var completed = rows.filter(function (r) { return r.status === 'Completed' || (r.checkType === 'Medical'); }).length;
                $('#hintBGV').text(total ? (rows.filter(function (r) { return r.status === 'Completed'; }).length + ' of ' + total + ' checks completed') : 'No checks added yet');
            }
        });
    }

    $('#btnAddBGVCheck').click(function () {
        var payload = {
            CandidateApplicationId: currentApplicationId,
            CheckType: $('#ddlCheckType').val(),
            VendorName: $('#txtVendorName').val(),
            VendorContact: $('#txtVendorContact').val(),
            CreatedBy: EmployeeId
        };
        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateBGVAPI/CreateCheck',
            data: JSON.stringify(payload), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('BGV check added.', 'success'); $('#txtVendorName,#txtVendorContact').val(''); loadBGVChecks(); }
                else showToast(res.responseMessage || 'Failed to add check.', 'error');
            }
        });
    });

    $(document).on('click', '.bgv-save', function () {
        var id = $(this).data('id');
        var status = $('.bgv-status[data-id="' + id + '"]').val();
        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateBGVAPI/UpdateCheck',
            data: JSON.stringify({ CandidateBGVCheckId: id, Status: status, UpdatedBy: EmployeeId }), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('BGV check updated.', 'success'); loadBGVChecks(); }
                else showToast(res.responseMessage || 'Update failed.', 'error');
            }
        });
    });

    // ===== HR Approval Checklist + Joining Confirmation =====
    function loadChecklist() {
        $.ajax({
            url: '@baseUrl/CandidateOnboardingChecklistAPI/GetByCandidateApplicationId/' + currentApplicationId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                $('#chkOfferAccepted,#chkDocumentsComplete,#chkBGVComplete,#chkMedicalComplete,#chkSalaryApproved,#chkJoiningApproved,#chkEmployeeCreationApproved').prop('checked', false);
                $('#ddlJoiningStatus').val('Pending');
                $('#txtActualJoiningDate,#txtFinalRemarks').val('');

                if (res.isSuccess && res.data) {
                    var d = res.data;
                    $('#chkOfferAccepted').prop('checked', d.offerAcceptedConfirmed);
                    $('#chkDocumentsComplete').prop('checked', d.documentsComplete);
                    $('#chkBGVComplete').prop('checked', d.bgvComplete);
                    $('#chkMedicalComplete').prop('checked', d.medicalComplete);
                    $('#chkSalaryApproved').prop('checked', d.salaryApproved);
                    $('#chkJoiningApproved').prop('checked', d.joiningApproved);
                    $('#chkEmployeeCreationApproved').prop('checked', d.employeeCreationApproved);
                    $('#ddlJoiningStatus').val(d.joiningStatus || 'Pending');
                    $('#txtActualJoiningDate').val(d.actualJoiningDate ? d.actualJoiningDate.substring(0, 10) : '');
                    $('#txtFinalRemarks').val(d.finalRemarks);
                }
                updateConvertButtonState();
            }
        });
    }

    function updateConvertButtonState() {
        var allChecked = $('#chkOfferAccepted').is(':checked') && $('#chkDocumentsComplete').is(':checked') &&
            $('#chkBGVComplete').is(':checked') && $('#chkSalaryApproved').is(':checked') &&
            $('#chkJoiningApproved').is(':checked') && $('#chkEmployeeCreationApproved').is(':checked');
        $('#btnConvertToEmployee').prop('disabled', !allChecked);
    }

    $(document).on('change', '#onboardingWorkspace input[type=checkbox]', updateConvertButtonState);

    $('#btnSaveChecklist').click(function () {
        var payload = {
            CandidateApplicationId: currentApplicationId,
            OfferAcceptedConfirmed: $('#chkOfferAccepted').is(':checked'),
            DocumentsComplete: $('#chkDocumentsComplete').is(':checked'),
            BGVComplete: $('#chkBGVComplete').is(':checked'),
            MedicalComplete: $('#chkMedicalComplete').is(':checked'),
            SalaryApproved: $('#chkSalaryApproved').is(':checked'),
            JoiningApproved: $('#chkJoiningApproved').is(':checked'),
            EmployeeCreationApproved: $('#chkEmployeeCreationApproved').is(':checked'),
            FinalRemarks: $('#txtFinalRemarks').val(),
            FinalApprovedBy: EmployeeId,
            JoiningStatus: $('#ddlJoiningStatus').val(),
            ActualJoiningDate: $('#txtActualJoiningDate').val() || null,
            CreatedBy: EmployeeId,
            UpdatedBy: EmployeeId
        };

        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateOnboardingChecklistAPI/SaveChecklist',
            data: JSON.stringify(payload), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) { showToast('Checklist saved.', 'success'); updateConvertButtonState(); }
                else showToast(res.responseMessage || 'Save failed.', 'error');
            }
        });
    });

    $('#btnConvertToEmployee').click(function () {
        if (!confirm('Convert this candidate to an employee? This cannot be undone.')) return;
        var $btn = $(this).prop('disabled', true).text('Converting...');

        $.ajax({
            type: 'POST', url: '@baseUrl/EmployeeConversionAPI/ConvertToEmployee',
            data: JSON.stringify({ CandidateApplicationId: currentApplicationId, ActionBy: parseInt(EmployeeId) }),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                $btn.html('<i class="bx bx-user-check"></i> Convert to Employee');
                if (res.isSuccess) {
                    $('#conversionResult').removeClass('alert-danger').addClass('alert-success').show()
                        .text('Employee created successfully! Employee Code: ' + res.data);
                } else {
                    $btn.prop('disabled', false);
                    $('#conversionResult').removeClass('alert-success').addClass('alert-danger').show().text(res.responseMessage || 'Conversion failed.');
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="bx bx-user-check"></i> Convert to Employee');
                showToast('Conversion failed.', 'error');
            }
        });
    });
</script>
