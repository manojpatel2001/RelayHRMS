@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Add Candidate Application";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<link rel="stylesheet" href="~/assets/plugins/smart-wizard/css/smart_wizard_all.min.css" />

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Add Candidate Application</h6>
        <a href="@Url.Action("CandidateApplication", "Recruitment")" class="btn btn-outline-secondary btn-sm">
            <i class="bx bx-arrow-back"></i> Back to List
        </a>
    </div>
    <div class="card-body">
        <div id="candidateWizard">
            <ul class="nav">
                <li><a class="nav-link" href="#step-1">Personal Info</a></li>
                <li><a class="nav-link" href="#step-2">Professional &amp; Resume</a></li>
                <li><a class="nav-link" href="#step-3">Education &amp; Experience</a></li>
                <li><a class="nav-link" href="#step-4">Skills, Certifications &amp; Projects</a></li>
                <li><a class="nav-link" href="#step-5">Job Application &amp; Review</a></li>
            </ul>

            <div>
                <!-- Step 1: Personal Info -->
                <div id="step-1" class="wizard-step">
                    <div class="row g-3">
                        <div class="col-md-4"><label class="fg-req">First Name</label><input type="text" id="txtFirstName" class="form-control" /></div>
                        <div class="col-md-4"><label>Middle Name</label><input type="text" id="txtMiddleName" class="form-control" /></div>
                        <div class="col-md-4"><label>Last Name</label><input type="text" id="txtLastName" class="form-control" /></div>
                        <div class="col-md-4"><label class="fg-req">Email</label><input type="email" id="txtEmail" class="form-control" /></div>
                        <div class="col-md-4"><label class="fg-req">Phone</label><input type="text" id="txtPhone" class="form-control" /></div>
                        <div class="col-md-4"><label>Alternate Phone</label><input type="text" id="txtAlternatePhone" class="form-control" /></div>
                        <div class="col-md-3"><label>Date of Birth</label><input type="date" id="txtDateOfBirth" class="form-control" /></div>
                        <div class="col-md-3">
                            <label>Gender</label>
                            <select id="ddlGender" class="form-select"><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select>
                        </div>
                        <div class="col-md-3"><label>Current City</label><input type="text" id="txtCurrentCity" class="form-control" /></div>
                        <div class="col-md-3"><label>Preferred Location</label><input type="text" id="txtPreferredLocation" class="form-control" /></div>
                        <div class="col-md-12"><label>Current Address</label><textarea id="txtCurrentAddress" class="form-control" rows="2"></textarea></div>
                        <div class="col-md-4"><label>LinkedIn URL</label><input type="text" id="txtLinkedInUrl" class="form-control" /></div>
                        <div class="col-md-4"><label>GitHub URL</label><input type="text" id="txtGitHubUrl" class="form-control" /></div>
                        <div class="col-md-4"><label>Portfolio URL</label><input type="text" id="txtPortfolioUrl" class="form-control" /></div>
                    </div>
                </div>

                <!-- Step 2: Professional Info & Resume -->
                <div id="step-2" class="wizard-step">
                    <div class="row g-3">
                        <div class="col-md-4"><label>Current Employer</label><input type="text" id="txtCurrentEmployer" class="form-control" /></div>
                        <div class="col-md-4"><label>Current Designation</label><input type="text" id="txtCurrentDesignation" class="form-control" /></div>
                        <div class="col-md-4"><label>Source of Application</label>
                            <select id="ddlSource" class="form-select">
                                <option value="">Select</option>
                                <option>Career Portal</option>
                                <option>LinkedIn</option>
                                <option>Naukri</option>
                                <option>Indeed</option>
                                <option>Referral</option>
                                <option>Walk-in</option>
                                <option>Internal</option>
                            </select>
                        </div>
                        <div class="col-md-3"><label>Total Experience (Yrs)</label><input type="number" step="0.5" min="0" id="txtTotalExperienceYears" class="form-control" /></div>
                        <div class="col-md-3"><label>Relevant Experience (Yrs)</label><input type="number" step="0.5" min="0" id="txtRelevantExperienceYears" class="form-control" /></div>
                        <div class="col-md-3"><label>Current CTC</label><input type="number" step="0.01" id="txtCurrentCTC" class="form-control" /></div>
                        <div class="col-md-3"><label>Expected CTC</label><input type="number" step="0.01" id="txtExpectedCTC" class="form-control" /></div>
                        <div class="col-md-3"><label>Notice Period (Days)</label><input type="number" min="0" id="txtNoticePeriodDays" class="form-control" /></div>
                        <div class="col-md-9"><label class="fg-req">Resume (PDF/DOC)</label><input type="file" id="fileResume" class="form-control" accept=".pdf,.doc,.docx" /></div>
                        <div class="col-md-12"><label>Summary</label><textarea id="txtSummary" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>

                <!-- Step 3: Education & Experience -->
                <div id="step-3" class="wizard-step">
                    <h6>Education</h6>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-2"><input type="text" id="eduDegree" class="form-control form-control-sm" placeholder="Degree" /></div>
                        <div class="col-md-2"><input type="text" id="eduSpecialization" class="form-control form-control-sm" placeholder="Specialization" /></div>
                        <div class="col-md-2"><input type="text" id="eduInstitution" class="form-control form-control-sm" placeholder="Institution" /></div>
                        <div class="col-md-2"><input type="number" id="eduYearOfPassing" class="form-control form-control-sm" placeholder="Year" /></div>
                        <div class="col-md-2">
                            <select id="eduLevel" class="form-select form-select-sm">
                                <option value="">Level</option>
                                <option>12th</option><option>Diploma</option><option>Graduate</option><option>Post Graduate</option><option>Doctorate</option>
                            </select>
                        </div>
                        <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" onclick="addEducationRow()">Add</button></div>
                    </div>
                    <table class="table table-sm" id="tblEducation"><thead><tr><th>Degree</th><th>Specialization</th><th>Institution</th><th>Year</th><th>Level</th><th></th></tr></thead><tbody></tbody></table>

                    <hr />
                    <h6>Experience</h6>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-3"><input type="text" id="expCompanyName" class="form-control form-control-sm" placeholder="Company" /></div>
                        <div class="col-md-2"><input type="text" id="expDesignation" class="form-control form-control-sm" placeholder="Designation" /></div>
                        <div class="col-md-2"><input type="date" id="expStartDate" class="form-control form-control-sm" /></div>
                        <div class="col-md-2"><input type="date" id="expEndDate" class="form-control form-control-sm" /></div>
                        <div class="col-md-1 form-check"><input type="checkbox" class="form-check-input" id="expIsCurrent" /><label class="form-check-label" style="font-size:11px">Current</label></div>
                        <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" onclick="addExperienceRow()">Add</button></div>
                    </div>
                    <table class="table table-sm" id="tblExperience"><thead><tr><th>Company</th><th>Designation</th><th>Start</th><th>End</th><th>Current</th><th></th></tr></thead><tbody></tbody></table>
                </div>

                <!-- Step 4: Skills, Certifications & Projects -->
                <div id="step-4" class="wizard-step">
                    <h6>Skills</h6>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-4"><input type="text" id="skillName" class="form-control form-control-sm" placeholder="Skill Name" /></div>
                        <div class="col-md-3">
                            <select id="skillLevel" class="form-select form-select-sm">
                                <option value="">Proficiency</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option><option>Expert</option>
                            </select>
                        </div>
                        <div class="col-md-3"><input type="number" step="0.5" id="skillYears" class="form-control form-control-sm" placeholder="Years" /></div>
                        <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" onclick="addSkillRow()">Add</button></div>
                    </div>
                    <table class="table table-sm" id="tblSkills"><thead><tr><th>Skill</th><th>Proficiency</th><th>Years</th><th></th></tr></thead><tbody></tbody></table>

                    <hr />
                    <h6>Certifications</h6>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-4"><input type="text" id="certName" class="form-control form-control-sm" placeholder="Certification Name" /></div>
                        <div class="col-md-4"><input type="text" id="certBody" class="form-control form-control-sm" placeholder="Issuing Body" /></div>
                        <div class="col-md-2"><input type="date" id="certIssueDate" class="form-control form-control-sm" /></div>
                        <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" onclick="addCertificationRow()">Add</button></div>
                    </div>
                    <table class="table table-sm" id="tblCertifications"><thead><tr><th>Name</th><th>Issuing Body</th><th>Issue Date</th><th></th></tr></thead><tbody></tbody></table>

                    <hr />
                    <h6>Projects</h6>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-4"><input type="text" id="projName" class="form-control form-control-sm" placeholder="Project Name" /></div>
                        <div class="col-md-4"><input type="text" id="projTech" class="form-control form-control-sm" placeholder="Technologies Used" /></div>
                        <div class="col-md-2"><input type="text" id="projRole" class="form-control form-control-sm" placeholder="Role" /></div>
                        <div class="col-md-2"><button type="button" class="btn btn-sm btn-primary w-100" onclick="addProjectRow()">Add</button></div>
                    </div>
                    <table class="table table-sm" id="tblProjects"><thead><tr><th>Project</th><th>Technologies</th><th>Role</th><th></th></tr></thead><tbody></tbody></table>
                </div>

                <!-- Step 5: Job Application & Review -->
                <div id="step-5" class="wizard-step">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fg-req">Apply for Job Position</label>
                            <select id="ddlJobPosition" class="form-select"><option value="">Select</option></select>
                        </div>
                        <div class="col-md-6">
                            <label>Cover Letter</label>
                            <textarea id="txtCoverLetter" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 text-end">
                        <button type="button" id="btnSubmitApplication" class="btn btn-success">
                            <i class="bx bx-check"></i> Submit Application
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

<script src="~/assets/plugins/smart-wizard/js/jquery.smartWizard.min.js"></script>
<script>
    const Token = localStorage.getItem("authToken");
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails ? companyDetails.CompanyId : null;
    const EmployeeId = localStorage.getItem("EmployeeId");

    var educationRows = [], experienceRows = [], skillRows = [], certificationRows = [], projectRows = [];

    $(document).ready(function () {
        try {
            $('#candidateWizard').smartWizard({
                selected: 0,
                theme: 'dots',
                transition: { animation: 'none' },
                toolbarSettings: { toolbarPosition: 'bottom', toolbarButtonPosition: 'end' }
            });
        } catch (e) {
            // Fallback: if the plugin fails to init for any reason, just show all steps stacked.
            $('.wizard-step').show();
        }
        loadJobPositionDropdown();
    });

    function loadJobPositionDropdown() {
        $.ajax({
            url: '@baseUrl/JobPositionAPI/GetJobPositionDropdown/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var $sel = $('#ddlJobPosition').empty().append('<option value="">Select</option>');
                // Dynamic Dapper rows preserve the SQL column-alias casing (PascalCase).
                (response.data || []).forEach(function (item) {
                    $sel.append($('<option>', { value: item.JobPositionId, text: item.PositionTitle }));
                });
            }
        });
    }

    // ===== Repeatable row helpers =====
    function addEducationRow() {
        if (!$('#eduDegree').val()) { showToast('Degree is required.', 'error'); return; }
        educationRows.push({
            Degree: $('#eduDegree').val(), Specialization: $('#eduSpecialization').val(), Institution: $('#eduInstitution').val(),
            YearOfPassing: $('#eduYearOfPassing').val() || null, EducationLevel: $('#eduLevel').val()
        });
        renderEducationTable();
        $('#eduDegree,#eduSpecialization,#eduInstitution,#eduYearOfPassing').val('');
        $('#eduLevel').val('');
    }
    function renderEducationTable() {
        var $tbody = $('#tblEducation tbody').empty();
        educationRows.forEach(function (r, i) {
            $tbody.append('<tr><td>' + r.Degree + '</td><td>' + (r.Specialization || '') + '</td><td>' + (r.Institution || '') + '</td><td>' + (r.YearOfPassing || '') + '</td><td>' + (r.EducationLevel || '') + '</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(educationRows,' + i + ',renderEducationTable)"><i class="bx bx-x"></i></button></td></tr>');
        });
    }

    function addExperienceRow() {
        if (!$('#expCompanyName').val()) { showToast('Company name is required.', 'error'); return; }
        experienceRows.push({
            CompanyName: $('#expCompanyName').val(), Designation: $('#expDesignation').val(),
            StartDate: $('#expStartDate').val() || null, EndDate: $('#expEndDate').val() || null, IsCurrentEmployer: $('#expIsCurrent').is(':checked')
        });
        renderExperienceTable();
        $('#expCompanyName,#expDesignation,#expStartDate,#expEndDate').val('');
        $('#expIsCurrent').prop('checked', false);
    }
    function renderExperienceTable() {
        var $tbody = $('#tblExperience tbody').empty();
        experienceRows.forEach(function (r, i) {
            $tbody.append('<tr><td>' + r.CompanyName + '</td><td>' + (r.Designation || '') + '</td><td>' + (r.StartDate || '') + '</td><td>' + (r.EndDate || '') + '</td><td>' + (r.IsCurrentEmployer ? 'Yes' : 'No') + '</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(experienceRows,' + i + ',renderExperienceTable)"><i class="bx bx-x"></i></button></td></tr>');
        });
    }

    function addSkillRow() {
        if (!$('#skillName').val()) { showToast('Skill name is required.', 'error'); return; }
        skillRows.push({ SkillName: $('#skillName').val(), ProficiencyLevel: $('#skillLevel').val(), ExperienceYears: $('#skillYears').val() || null });
        renderSkillsTable();
        $('#skillName,#skillYears').val(''); $('#skillLevel').val('');
    }
    function renderSkillsTable() {
        var $tbody = $('#tblSkills tbody').empty();
        skillRows.forEach(function (r, i) {
            $tbody.append('<tr><td>' + r.SkillName + '</td><td>' + (r.ProficiencyLevel || '') + '</td><td>' + (r.ExperienceYears || '') + '</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(skillRows,' + i + ',renderSkillsTable)"><i class="bx bx-x"></i></button></td></tr>');
        });
    }

    function addCertificationRow() {
        if (!$('#certName').val()) { showToast('Certification name is required.', 'error'); return; }
        certificationRows.push({ CertificationName: $('#certName').val(), IssuingBody: $('#certBody').val(), IssueDate: $('#certIssueDate').val() || null });
        renderCertificationsTable();
        $('#certName,#certBody,#certIssueDate').val('');
    }
    function renderCertificationsTable() {
        var $tbody = $('#tblCertifications tbody').empty();
        certificationRows.forEach(function (r, i) {
            $tbody.append('<tr><td>' + r.CertificationName + '</td><td>' + (r.IssuingBody || '') + '</td><td>' + (r.IssueDate || '') + '</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(certificationRows,' + i + ',renderCertificationsTable)"><i class="bx bx-x"></i></button></td></tr>');
        });
    }

    function addProjectRow() {
        if (!$('#projName').val()) { showToast('Project name is required.', 'error'); return; }
        projectRows.push({ ProjectName: $('#projName').val(), TechnologiesUsed: $('#projTech').val(), RoleInProject: $('#projRole').val() });
        renderProjectsTable();
        $('#projName,#projTech,#projRole').val('');
    }
    function renderProjectsTable() {
        var $tbody = $('#tblProjects tbody').empty();
        projectRows.forEach(function (r, i) {
            $tbody.append('<tr><td>' + r.ProjectName + '</td><td>' + (r.TechnologiesUsed || '') + '</td><td>' + (r.RoleInProject || '') + '</td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(projectRows,' + i + ',renderProjectsTable)"><i class="bx bx-x"></i></button></td></tr>');
        });
    }

    window.removeRow = function (arr, index, renderFn) { arr.splice(index, 1); renderFn(); };

    // ===== Final submit: create candidate (with resume) -> add profile children -> create application =====
    $('#btnSubmitApplication').click(function () {
        if (!$('#txtFirstName').val() || !$('#txtEmail').val() || !$('#txtPhone').val()) {
            showToast('First Name, Email and Phone are required (Step 1).', 'error');
            return;
        }
        if (!$('#fileResume')[0].files.length) {
            showToast('Resume file is required (Step 2).', 'error');
            return;
        }
        if (!$('#ddlJobPosition').val()) {
            showToast('Please select a Job Position to apply for (Step 5).', 'error');
            return;
        }

        var $btn = $(this).prop('disabled', true).text('Submitting...');

        var candidateForm = new FormData();
        candidateForm.append('FirstName', $('#txtFirstName').val());
        candidateForm.append('MiddleName', $('#txtMiddleName').val());
        candidateForm.append('LastName', $('#txtLastName').val());
        candidateForm.append('Email', $('#txtEmail').val());
        candidateForm.append('Phone', $('#txtPhone').val());
        candidateForm.append('AlternatePhone', $('#txtAlternatePhone').val());
        candidateForm.append('DateOfBirth', $('#txtDateOfBirth').val());
        candidateForm.append('Gender', $('#ddlGender').val());
        candidateForm.append('CurrentAddress', $('#txtCurrentAddress').val());
        candidateForm.append('CurrentCity', $('#txtCurrentCity').val());
        candidateForm.append('PreferredLocation', $('#txtPreferredLocation').val());
        candidateForm.append('CurrentEmployer', $('#txtCurrentEmployer').val());
        candidateForm.append('CurrentDesignation', $('#txtCurrentDesignation').val());
        candidateForm.append('TotalExperienceYears', $('#txtTotalExperienceYears').val());
        candidateForm.append('RelevantExperienceYears', $('#txtRelevantExperienceYears').val());
        candidateForm.append('CurrentCTC', $('#txtCurrentCTC').val());
        candidateForm.append('ExpectedCTC', $('#txtExpectedCTC').val());
        candidateForm.append('NoticePeriodDays', $('#txtNoticePeriodDays').val());
        candidateForm.append('LinkedInUrl', $('#txtLinkedInUrl').val());
        candidateForm.append('GitHubUrl', $('#txtGitHubUrl').val());
        candidateForm.append('PortfolioUrl', $('#txtPortfolioUrl').val());
        candidateForm.append('Source', $('#ddlSource').val());
        candidateForm.append('Summary', $('#txtSummary').val());
        candidateForm.append('CreatedBy', EmployeeId);
        candidateForm.append('resumeFile', $('#fileResume')[0].files[0]);

        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateAPI/CreateCandidate',
            data: candidateForm, processData: false, contentType: false,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (!res.isSuccess) { showToast(res.responseMessage || 'Failed to create candidate.', 'error'); $btn.prop('disabled', false).text('Submit Application'); return; }
                var candidateId = res.data;
                saveProfileChildren(candidateId, function () {
                    submitApplication(candidateId, $btn);
                });
            },
            error: function () { showToast('Failed to create candidate.', 'error'); $btn.prop('disabled', false).text('Submit Application'); }
        });
    });

    function saveProfileChildren(candidateId, done) {
        var calls = [];
        educationRows.forEach(function (r) { calls.push(postChild('Education', Object.assign({ CandidateId: candidateId, CreatedBy: EmployeeId }, r))); });
        experienceRows.forEach(function (r) { calls.push(postChild('Experience', Object.assign({ CandidateId: candidateId, CreatedBy: EmployeeId }, r))); });
        skillRows.forEach(function (r) { calls.push(postChild('Skill', Object.assign({ CandidateId: candidateId, CreatedBy: EmployeeId }, r))); });
        certificationRows.forEach(function (r) { calls.push(postChild('Certification', Object.assign({ CandidateId: candidateId, CreatedBy: EmployeeId }, r))); });
        projectRows.forEach(function (r) { calls.push(postChild('Project', Object.assign({ CandidateId: candidateId, CreatedBy: EmployeeId }, r))); });

        if (calls.length === 0) { done(); return; }
        $.when.apply($, calls).always(done);
    }

    function postChild(subResource, payload) {
        return $.ajax({
            type: 'POST', url: '@baseUrl/CandidateProfileAPI/' + subResource + '/Create',
            data: JSON.stringify(payload), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token }
        });
    }

    function submitApplication(candidateId, $btn) {
        var appForm = new FormData();
        appForm.append('CandidateId', candidateId);
        appForm.append('JobPositionId', $('#ddlJobPosition').val());
        appForm.append('ApplicationSource', $('#ddlSource').val());
        appForm.append('CoverLetter', $('#txtCoverLetter').val());
        appForm.append('CreatedBy', EmployeeId);

        $.ajax({
            type: 'POST', url: '@baseUrl/CandidateApplicationAPI/CreateCandidateApplication',
            data: appForm, processData: false, contentType: false,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                $btn.prop('disabled', false).text('Submit Application');
                if (res.isSuccess) {
                    showToast('Candidate application submitted successfully.', 'success');
                    window.location.href = '@Url.Action("CandidateApplication", "Recruitment")';
                } else {
                    showToast(res.responseMessage || 'Failed to submit application.', 'error');
                }
            },
            error: function () { $btn.prop('disabled', false).text('Submit Application'); showToast('Failed to submit application.', 'error'); }
        });
    }
</script>
