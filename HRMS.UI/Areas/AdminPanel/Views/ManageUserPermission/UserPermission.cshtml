@inject IConfiguration Configuration
@{
	ViewData["Title"] = "User Permissions";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
	.up-layout {
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.up-user-panel {
		flex: 0 0 280px;
		border: 1px solid #E2E8F0;
		border-radius: 8px;
		overflow: hidden;
	}

	.up-user-panel-hdr {
		padding: 10px 14px;
		background: #F8FAFC;
		border-bottom: 1px solid #E2E8F0;
		font-weight: 700;
		font-size: 12.5px;
		color: #1E293B;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.up-user-search {
		padding: 10px;
		border-bottom: 1px solid #E2E8F0;
	}

		.up-user-search input {
			width: 100%;
			padding: 7px 10px;
			border: 1px solid #E2E8F0;
			border-radius: 6px;
			font-size: 13px;
		}

	.up-user-list {
		max-height: 640px;
		overflow-y: auto;
	}

	.up-user-item {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		cursor: pointer;
		border-bottom: 1px solid #F1F5F9;
	}

		.up-user-item:hover {
			background: #F8FAFC;
		}

		.up-user-item.active {
			background: #EFF6FF;
			border-left: 3px solid #3E6A8C;
		}

	.up-avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: #3E6A8C;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 12.5px;
		flex-shrink: 0;
	}

	.up-user-item .up-user-name {
		font-size: 13px;
		font-weight: 600;
		color: #1E293B;
	}

	.up-user-item .up-user-code {
		font-size: 11.5px;
		color: #94A3B8;
	}

	.up-content {
		flex: 1 1 auto;
		min-width: 0;
	}

	.up-emp-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px;
		padding: 14px 16px;
		border: 1px solid #E2E8F0;
		border-radius: 8px;
		margin-bottom: 14px;
	}

	.up-emp-identity {
		display: flex;
		align-items: center;
		gap: 12px;
	}

		.up-emp-identity .up-avatar {
			width: 44px;
			height: 44px;
			font-size: 15px;
		}

	.up-emp-name {
		font-size: 15px;
		font-weight: 700;
		color: #1E293B;
	}

	.up-emp-code {
		font-size: 12.5px;
		color: #64748B;
	}

	.up-role-badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 20px;
		background: #EFF6FF;
		border: 1px solid #BFDBFE;
		font-size: 12px;
		font-weight: 700;
		color: #1E3A5F;
	}

	.up-override-badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 20px;
		background: #FFF3E0;
		border: 1px solid #FFCC80;
		font-size: 12px;
		font-weight: 700;
		color: #E65100;
	}

	.up-info-banner {
		display: flex;
		align-items: center;
		gap: 8px;
		background: #EFF6FF;
		border: 1px solid #BFDBFE;
		border-radius: 8px;
		padding: 10px 16px;
		font-size: 13px;
		color: #1E3A5F;
		margin-bottom: 14px;
	}

	.up-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		font-size: 12px;
		color: #64748B;
		margin-bottom: 14px;
	}

		.up-legend span {
			display: inline-flex;
			align-items: center;
			gap: 6px;
		}

		.up-legend i {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			display: inline-block;
		}

	.up-legend-override-on i { background: #F97316; }
	.up-legend-override-off i { background: #CBD5E1; }

	.up-empty-state {
		text-align: center;
		color: #94A3B8;
		padding: 60px 20px;
		border: 1px solid #E2E8F0;
		border-radius: 8px;
	}

	.up-toolbar {
		display: flex;
		justify-content: flex-end;
		background: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-bottom: none;
		border-radius: 8px 8px 0 0;
		padding: 10px 14px;
	}

	.up-table-wrap {
		border: 1px solid #E2E8F0;
		border-radius: 0 0 8px 8px;
		padding: 14px;
	}

	.up-table {
		width: 100%;
		border-collapse: collapse;
	}

		.up-table thead th {
			text-align: center;
			font-size: 11.5px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: .4px;
			color: #64748B;
			padding: 10px 14px;
			border-bottom: 2px solid #E2E8F0;
		}

			.up-table thead th:first-child {
				text-align: left;
			}

			.up-col-master-wrap.form-check.form-switch {
				display: flex;
				justify-content: center;
				margin-top: 4px;
				padding-left: 2.2em;
			}

		.up-table td {
			padding: 9px 14px;
			border-bottom: 1px solid #F1F5F9;
			vertical-align: middle;
			text-align: center;
		}

			.up-table td:first-child {
				text-align: left;
			}

	.up-row-panel td {
		background: #E9F0F7;
		font-weight: 700;
		font-size: 13px;
		color: #16324A;
		border-top: 1px solid #BFDBFE;
		border-bottom: 1px solid #BFDBFE;
		cursor: pointer;
	}

		.up-row-panel td:first-child {
			border-left: 3px solid #3E6A8C;
		}

		.up-row-panel .up-panel-name {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.up-row-panel .up-panel-count {
			font-size: 11px;
			font-weight: 500;
			color: #64748B;
			margin-left: 6px;
			text-transform: none;
		}

	.up-row-group {
		cursor: pointer;
	}

		.up-row-group td {
			background: #F8FAFC;
			font-weight: 700;
			font-size: 12.5px;
			color: #1E293B;
			border-top: 1px solid #E2E8F0;
			border-bottom: 1px solid #E2E8F0;
		}

			.up-row-group td:first-child {
				border-left: 3px solid #8C5E3E;
				padding-left: 34px;
			}

			.up-row-group .up-group-name {
				display: flex;
				align-items: center;
				gap: 8px;
			}

	.up-caret {
		font-size: 16px;
		color: #64748B;
		transition: transform .1s ease-in-out;
	}

	.up-row-item .up-item-name {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-left: 22px;
		font-size: 13px;
		color: #374151;
	}

		.up-row-item .up-item-name i {
			font-size: 15px;
			color: #94A3B8;
		}

	.up-toggle.form-check.form-switch {
		margin: 0;
		padding-left: 2.5em;
		display: inline-block;
	}

		.up-toggle.form-check.form-switch .form-check-input {
			width: 2.2em;
			height: 1.2em;
			min-height: 0;
			padding: 0;
			cursor: pointer;
			margin-left: -2.5em;
			margin-top: 0;
		}

		/* Orange when the effective value differs from the employee's role default. */
		.up-toggle.form-check.form-switch .form-check-input.up-override-active:checked {
			background-color: #F97316;
			border-color: #F97316;
		}

		.up-toggle.form-check.form-switch .form-check-input.up-override-active:not(:checked) {
			background-color: #FED7AA;
			border-color: #FED7AA;
		}
</style>

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">User Permissions</h6>
	</div>
	<div class="card-body">
		<div class="up-layout">
			<div class="up-user-panel">
				<div class="up-user-panel-hdr">
					<span><i class='bx bx-group'></i> Users</span>
					<span id="upUserCount">0 users</span>
				</div>
				<div class="up-user-search">
					<input type="text" id="upUserSearch" placeholder="Search user..." autocomplete="off" />
				</div>
				<div class="up-user-list" id="upUserList"></div>
			</div>

			<div class="up-content">
				<div id="upEmptyState" class="up-empty-state">
					<i class='bx bx-user-circle' style="font-size:32px;"></i>
					<div>Select a user from the list to configure their permission overrides.</div>
				</div>

				<div id="upBody" style="display:none;">
					<div class="up-emp-header">
						<div class="up-emp-identity">
							<div class="up-avatar" id="upEmpAvatar">-</div>
							<div>
								<div class="up-emp-name" id="upEmpName">-</div>
								<div class="up-emp-code" id="upEmpCode">-</div>
							</div>
						</div>
						<div class="d-flex align-items-center gap-2">
							<span class="up-role-badge" id="upRoleBadge">-</span>
							<span class="up-override-badge" id="upOverrideBadge">0 overrides</span>
							<button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="btnResetOverrides">
								<i class="bx bx-reset"></i> Reset Overrides
							</button>
						</div>
					</div>

					<div class="up-info-banner">
						<i class='bx bx-info-circle'></i>
						<span>This user's role is <strong id="upRoleName">-</strong>. Toggles below grant a personal page override for this user only, in addition to their role. Orange = override active.</span>
					</div>

					<div class="up-legend">
						<span class="up-legend-override-on"><i></i> Override active (granted to this user)</span>
						<span class="up-legend-override-off"><i></i> No override (not granted personally)</span>
					</div>

					<div class="up-toolbar">
						<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveOverrides">
							<span class="btn-spinner-icon"></span>
							<i class="bx bx-save"></i>
							<span class="btn-label-text">Save Overrides</span>
						</button>
					</div>
					<div class="up-table-wrap">
						<div class="sec-lbl">Page &amp; Menu Visibility Access</div>
						<table class="up-table">
							<thead>
								<tr>
									<th>Menu / Page</th>
									<th>All<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="All"></div></th>
									<th>View<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="View"></div></th>
									<th>Create<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="Create"></div></th>
									<th>Edit<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="Edit"></div></th>
									<th>Delete<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="Delete"></div></th>
									<th>Export<div class="form-check form-switch up-toggle up-col-master-wrap"><input type="checkbox" class="form-check-input up-col-master" data-action="Export"></div></th>
								</tr>
							</thead>
							<tbody id="upTableBody"></tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var ACTIONS = ['View', 'Create', 'Edit', 'Delete', 'Export'];
	var ALL_COLUMNS = ['All'].concat(ACTIONS);

	var Token = localStorage.getItem('authToken');
	var companyDetails = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
	var companyId = companyDetails.CompanyId;

	var employees = [];
	var currentEmployeeId = 0;
	var menuCatalog = null;
	var menuIdSet = {};
	var originalOverrides = {};  // permissionId -> true/false, as currently persisted
	var currentChecked = {};     // effective on-screen state (role default + overrides applied)

	function authHeaders() { return { 'Authorization': 'Bearer ' + Token }; }

	function initials(name) {
		var parts = (name || '').trim().split(/\s+/);
		if (!parts.length || !parts[0]) return '?';
		return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
	}

	function loadEmployees() {
		$.ajax({
			url: '@baseUrl/UserPermissionAPI/GetAllEmployeeListByCompanyId/' + companyId, type: 'GET', cache: false,
			headers: authHeaders(),
			success: function (res) {
				employees = res.isSuccess ? (res.data || []) : [];
				renderEmployeeList(employees);
			},
			error: function () { showToast('Failed to load users.', 'error'); }
		});
	}

	function renderEmployeeList(list) {
		var $list = $('#upUserList').empty();
		$('#upUserCount').text(list.length + ' users');
		list.forEach(function (e) {
			var $item = $(
				'<div class="up-user-item" data-employee-id="' + e.employeeId + '">' +
					'<div class="up-avatar">' + initials(e.fullName) + '</div>' +
					'<div><div class="up-user-name">' + (e.fullName || '-') + '</div><div class="up-user-code">' + (e.employeeCode || '') + '</div></div>' +
				'</div>'
			);
			$item.toggleClass('active', e.employeeId === currentEmployeeId);
			$list.append($item);
		});
	}

	$('#upUserSearch').on('input', function () {
		var q = $(this).val().toLowerCase().trim();
		if (!q) { renderEmployeeList(employees); return; }
		renderEmployeeList(employees.filter(function (e) {
			return (e.fullName || '').toLowerCase().indexOf(q) !== -1 || (e.employeeCode || '').toLowerCase().indexOf(q) !== -1;
		}));
	});

	$('#upUserList').on('click', '.up-user-item', function () {
		var id = parseInt($(this).data('employee-id'));
		selectEmployee(id);
	});

	function fetchMenuCatalogOnce() {
		if (menuCatalog) return $.Deferred().resolve().promise();
		return $.ajax({
			url: '@baseUrl/PermissionAPI/GetAllGroupPermissions/Menu', type: 'GET', cache: false,
			headers: authHeaders()
		}).then(function (res) {
			menuCatalog = pivotIntoPages(res.isSuccess ? (res.data || []) : []);
			menuIdSet = buildIdSet(menuCatalog);
		}, function () { menuCatalog = []; menuIdSet = {}; });
	}

	function pivotIntoPages(catalog) {
		return (catalog || []).map(function (group) {
			var pageMap = {};
			var pageOrder = [];
			(group.permissions || []).forEach(function (p) {
				var sp = p.permissionName.indexOf(' ');
				var action = sp > 0 ? p.permissionName.substring(0, sp) : p.permissionName;
				var pageName = sp > 0 ? p.permissionName.substring(sp + 1) : p.permissionName;
				if (ACTIONS.indexOf(action) === -1) { action = 'View'; pageName = p.permissionName; }
				if (!pageMap[pageName]) { pageMap[pageName] = { pageName: pageName, actions: {} }; pageOrder.push(pageName); }
				pageMap[pageName].actions[action] = p.permissionId;
			});
			return { panel: group.panel || 'Admin', groupName: group.groupName, pages: pageOrder.map(function (n) { return pageMap[n]; }) };
		});
	}

	function bucketByPanel(catalog) {
		var order = ['Admin', 'ESS'];
		var labels = { Admin: 'Admin Panel', ESS: 'ESS Panel' };
		return order
			.map(function (key) { return { panelKey: key, panelLabel: labels[key], groups: (catalog || []).filter(function (g) { return g.panel === key; }) }; })
			.filter(function (p) { return p.groups.length > 0; });
	}

	function buildIdSet(catalog) {
		var set = {};
		(catalog || []).forEach(function (g) {
			(g.pages || []).forEach(function (pg) {
				ACTIONS.forEach(function (a) { if (pg.actions[a]) set[pg.actions[a]] = true; });
			});
		});
		return set;
	}

	function fetchEmployeeRole(employeeId) {
		return $.ajax({
			url: '@baseUrl/UserPermissionAPI/GetEmployeeRole/' + employeeId + '/' + companyId, type: 'GET', cache: false,
			headers: authHeaders()
		}).then(function (res) { return res.isSuccess ? res.data : null; }, function () { return null; });
	}

	function fetchUserOverrides(employeeId) {
		return $.ajax({
			url: '@baseUrl/UserPermissionAPI/GetUserPermissionOverrides', type: 'POST',
			contentType: 'application/json', headers: authHeaders(),
			data: JSON.stringify({ EmployeeId: employeeId, CompanyId: companyId })
		}).then(function (res) { return res.isSuccess ? (res.data || []) : []; }, function () { return []; });
	}

	function selectEmployee(employeeId) {
		currentEmployeeId = employeeId;
		var emp = employees.find(function (e) { return e.employeeId === employeeId; });
		if (!emp) return;

		$('#upUserList .up-user-item').removeClass('active');
		$('#upUserList .up-user-item[data-employee-id="' + employeeId + '"]').addClass('active');

		$('#upEmpAvatar').text(initials(emp.fullName));
		$('#upEmpName').text(emp.fullName || '-');
		$('#upEmpCode').text(emp.employeeCode || '-');
		$('#upEmptyState').hide();

		fetchEmployeeRole(employeeId).done(function (role) {
			if (!role || !role.roleId) {
				$('#upRoleBadge').text('No role assigned');
				$('#upRoleName').text('No role');
				$('#upBody').show();
				$('#upTableBody').empty().append('<tr><td colspan="7" class="up-empty-state">This employee has no role assigned, so there is no default permission set to override.</td></tr>');
				$('#upOverrideBadge').text('0 overrides');
				return;
			}

			$('#upRoleBadge').text(role.roleName || ('Role #' + role.roleId));
			$('#upRoleName').text(role.roleName || ('Role #' + role.roleId));

			$.when(fetchMenuCatalogOnce(), fetchUserOverrides(employeeId)).done(
				function (_, overrides) {
					// The checkbox reflects ONLY whether this specific employee has an
					// explicit personal override for that page — never the role's own
					// default. A checked box always means "overridden ON for this user".
					originalOverrides = {};
					(overrides || []).forEach(function (o) {
						if (o.permissionId) originalOverrides[o.permissionId] = !!o.isGranted;
					});

					currentChecked = {};
					Object.keys(originalOverrides).forEach(function (id) {
						id = parseInt(id);
						if (originalOverrides[id]) currentChecked[id] = true;
					});

					renderTable($('#upTableBody'), menuCatalog, currentChecked);
					wireColumnMasters($('#upTableBody'));
					updateOverrideBadge();

					$('#upBody').show();
				}
			);
		});
	}

	function updateOverrideBadge() {
		var count = Object.keys(currentChecked).length;
		$('#upOverrideBadge').text(count + (count === 1 ? ' override' : ' overrides'));
	}

	function markOverrideStyling($input) {
		$input.toggleClass('up-override-active', $input.is(':checked'));
	}

	var masterCellHtml = function (scopeType, scopeId, action) {
		return '<td><div class="form-check form-switch up-toggle"><input type="checkbox" class="form-check-input up-scope-master" data-scope-type="' + scopeType + '" data-scope-id="' + scopeId + '" data-action="' + action + '"></div></td>';
	};

	function renderTable(tbody, catalog, checkedSet) {
		tbody.empty();
		tbody.off('click change');
		if (!catalog || catalog.length === 0) {
			tbody.append('<tr><td colspan="7" class="up-empty-state">No page/menu permissions available.</td></tr>');
			return;
		}

		var panels = bucketByPanel(catalog);

		panels.forEach(function (panel, pi) {
			var panelId = 'panel-' + pi;
			var pageCount = panel.groups.reduce(function (n, g) { return n + (g.pages || []).length; }, 0);

			var panelHtml = '<tr class="up-row-panel" data-panel-id="' + panelId + '">' +
				'<td><span class="up-panel-name"><i class="bx bx-chevron-down up-caret"></i><i class="bx bx-layer"></i>' + panel.panelLabel.toUpperCase() + '<span class="up-panel-count">' + pageCount + ' pages</span></span></td>';
			ALL_COLUMNS.forEach(function (action) { panelHtml += masterCellHtml('panel', panelId, action); });
			panelHtml += '</tr>';
			tbody.append(panelHtml);

			panel.groups.forEach(function (group, gi) {
				var groupId = panelId + '-group-' + gi;

				var groupHtml = '<tr class="up-row-group" data-panel-id="' + panelId + '" data-group-id="' + groupId + '">' +
					'<td><span class="up-group-name"><i class="bx bx-chevron-down up-caret"></i><i class="bx bx-folder"></i>' + group.groupName.toUpperCase() + '</span></td>';
				ALL_COLUMNS.forEach(function (action) { groupHtml += masterCellHtml('group', groupId, action); });
				groupHtml += '</tr>';
				tbody.append(groupHtml);

				(group.pages || []).forEach(function (pg) {
					var $row = $('<tr class="up-row-item" data-panel-id="' + panelId + '" data-group-id="' + groupId + '"><td><span class="up-item-name"><i class="bx bx-chevron-right"></i>' + pg.pageName + '</span></td></tr>');

					var anyAction = ACTIONS.some(function (a) { return !!pg.actions[a]; });
					var $allTd = $('<td></td>');
					if (anyAction) {
						$allTd.html('<div class="form-check form-switch up-toggle"><input type="checkbox" class="form-check-input up-row-all-toggle"></div>');
					} else {
						$allTd.html('&mdash;');
					}
					$row.append($allTd);

					ACTIONS.forEach(function (action) {
						var permId = pg.actions[action];
						var $td = $('<td></td>');
						if (permId) {
							var isChecked = !!checkedSet[permId];
							$td.html('<div class="form-check form-switch up-toggle"><input type="checkbox" class="form-check-input up-item-toggle" data-id="' + permId + '" data-action="' + action + '" ' + (isChecked ? 'checked' : '') + '></div>');
						} else {
							$td.html('&mdash;');
						}
						$row.append($td);
					});
					tbody.append($row);
					syncRowAllToggle($row);
					$row.find('.up-item-toggle').each(function () { markOverrideStyling($(this)); });
				});
			});
		});

		refreshColumnMasters(tbody);
		refreshScopedMasters(tbody);

		tbody.on('click', '.up-row-panel', function () {
			var panelId = $(this).data('panel-id');
			var collapsed = $(this).toggleClass('collapsed').hasClass('collapsed');
			$(this).find('.up-caret').toggleClass('bx-chevron-down bx-chevron-right');
			tbody.find('[data-panel-id="' + panelId + '"]').not(this).toggle(!collapsed);
		});

		tbody.on('click', '.up-row-group', function (e) {
			e.stopPropagation();
			var groupId = $(this).data('group-id');
			var collapsed = $(this).toggleClass('collapsed').hasClass('collapsed');
			$(this).find('.up-caret').toggleClass('bx-chevron-down bx-chevron-right');
			tbody.find('.up-row-item[data-group-id="' + groupId + '"]').toggle(!collapsed);
		});

		tbody.on('click', '.up-toggle', function (e) { e.stopPropagation(); });

		tbody.on('change', '.up-item-toggle', function () {
			var id = parseInt($(this).data('id'));
			if ($(this).is(':checked')) currentChecked[id] = true; else delete currentChecked[id];
			markOverrideStyling($(this));
			syncRowAllToggle($(this).closest('tr'));
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateOverrideBadge();
		});

		tbody.on('change', '.up-row-all-toggle', function () {
			var on = $(this).is(':checked');
			$(this).closest('tr').find('.up-item-toggle').prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) currentChecked[id] = true; else delete currentChecked[id];
				markOverrideStyling($(this));
			});
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateOverrideBadge();
		});

		tbody.on('change', '.up-scope-master', function () {
			var scopeType = $(this).data('scope-type');
			var scopeId = $(this).data('scope-id');
			var action = $(this).data('action');
			var on = $(this).is(':checked');
			var attr = scopeType === 'panel' ? 'data-panel-id' : 'data-group-id';
			var $rows = tbody.find('.up-row-item[' + attr + '="' + scopeId + '"]');
			var $targets = action === 'All' ? $rows.find('.up-item-toggle') : $rows.find('.up-item-toggle[data-action="' + action + '"]');
			$targets.prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) currentChecked[id] = true; else delete currentChecked[id];
				markOverrideStyling($(this));
			});
			$rows.each(function () { syncRowAllToggle($(this)); });
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateOverrideBadge();
		});
	}

	function syncRowAllToggle($row) {
		var $itemToggles = $row.find('.up-item-toggle');
		var $allToggle = $row.find('.up-row-all-toggle');
		if (!$allToggle.length || !$itemToggles.length) return;
		var checkedCount = $itemToggles.filter(':checked').length;
		$allToggle.prop('checked', checkedCount === $itemToggles.length);
		$allToggle.prop('indeterminate', checkedCount > 0 && checkedCount < $itemToggles.length);
	}

	function wireColumnMasters(tbody) {
		$('.up-col-master').off('change').on('change', function () {
			var action = $(this).data('action');
			var on = $(this).is(':checked');
			var $targets = action === 'All' ? tbody.find('.up-item-toggle') : tbody.find('.up-item-toggle[data-action="' + action + '"]');
			$targets.prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) currentChecked[id] = true; else delete currentChecked[id];
				markOverrideStyling($(this));
			});
			tbody.find('.up-row-item').each(function () { syncRowAllToggle($(this)); });
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateOverrideBadge();
		});
	}

	function refreshScopedMasters(tbody) {
		tbody.find('.up-scope-master').each(function () {
			var $m = $(this);
			var scopeType = $m.data('scope-type');
			var scopeId = $m.data('scope-id');
			var action = $m.data('action');
			var attr = scopeType === 'panel' ? 'data-panel-id' : 'data-group-id';
			var $rows = tbody.find('.up-row-item[' + attr + '="' + scopeId + '"]');
			var $targets = action === 'All' ? $rows.find('.up-item-toggle') : $rows.find('.up-item-toggle[data-action="' + action + '"]');
			if (!$targets.length) { $m.prop('checked', false).prop('indeterminate', false); return; }
			var checkedCount = $targets.filter(':checked').length;
			$m.prop('checked', checkedCount === $targets.length);
			$m.prop('indeterminate', checkedCount > 0 && checkedCount < $targets.length);
		});
	}

	function refreshColumnMasters(tbody) {
		ALL_COLUMNS.forEach(function (action) {
			var $col = $('.up-col-master[data-action="' + action + '"]');
			var $targets = action === 'All' ? tbody.find('.up-item-toggle') : tbody.find('.up-item-toggle[data-action="' + action + '"]');
			if (!$targets.length) { $col.prop('checked', false).prop('indeterminate', false); return; }
			var checkedCount = $targets.filter(':checked').length;
			$col.prop('checked', checkedCount === $targets.length);
			$col.prop('indeterminate', checkedCount > 0 && checkedCount < $targets.length);
		});
	}

	function callIfNeeded(ids, url, extra) {
		if (!ids.length) return $.Deferred().resolve().promise();
		var payload = Object.assign({ EmployeeId: currentEmployeeId, PermissionIds: ids.join(','), CompanyId: companyId }, extra || {});
		return $.ajax({ url: url, type: 'POST', contentType: 'application/json', headers: authHeaders(), data: JSON.stringify(payload) });
	}

	$('#btnSaveOverrides').on('click', function () {
		if (!currentEmployeeId) return;
		setBtnLoading('#btnSaveOverrides', 'Saving...');

		// Checked = grant a personal override for this page; unchecked = no override
		// (clear one if it previously existed). There is no "explicit deny" state.
		var toGrant = [], toClear = [];
		Object.keys(menuIdSet).forEach(function (idStr) {
			var id = parseInt(idStr);
			var isChecked = !!currentChecked[id];
			var hadOverride = Object.prototype.hasOwnProperty.call(originalOverrides, id);
			if (isChecked && !hadOverride) toGrant.push(id);
			else if (!isChecked && hadOverride) toClear.push(id);
		});

		$.when(
			callIfNeeded(toGrant, '@baseUrl/UserPermissionAPI/CreateUserPermissionOverride', { IsGranted: true }),
			callIfNeeded(toClear, '@baseUrl/UserPermissionAPI/RemoveUserPermissionOverride')
		).done(function () {
			showToast('Overrides saved successfully.', 'success');
			toGrant.forEach(function (id) { originalOverrides[id] = true; });
			toClear.forEach(function (id) { delete originalOverrides[id]; });
			setBtnNormal('#btnSaveOverrides', 'Save Overrides');
		}).fail(function () {
			showToast('Something went wrong while saving overrides.', 'error');
			setBtnNormal('#btnSaveOverrides', 'Save Overrides');
		});
	});

	$('#btnResetOverrides').on('click', function () {
		if (!currentEmployeeId) return;
		wmsConfirm('Reset all permission overrides for this user back to their role defaults?<br><small style="color:#E53E3E;display:block;margin-top:4px">This cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/UserPermissionAPI/ResetUserPermissionOverrides', type: 'POST',
				contentType: 'application/json', headers: authHeaders(),
				data: JSON.stringify({ EmployeeId: currentEmployeeId, CompanyId: companyId })
			}).done(function (res) {
				showToast(res.isSuccess ? 'Overrides reset successfully.' : (res.responseMessage || 'Something went wrong.'), res.isSuccess ? 'success' : 'error');
				if (res.isSuccess) selectEmployee(currentEmployeeId);
			}).fail(function () {
				showToast('Something went wrong while resetting overrides.', 'error');
			});
		});
	});

	$(document).ready(function () { loadEmployees(); });
})();
</script>
