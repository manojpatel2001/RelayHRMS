@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Approval Master";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Approval Master</h6>
		<button id="addApprovalMaster" type="button" class="btn btn-primary btn-sm">Add Approval</button>
	</div>
	<div class="card-body">
		<div id="approvalGrid"></div>
	</div>
</div>

<div class="modal fade" id="addApprovalMasterModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title"><span class="formType">Add</span> Approval Master</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row">
					<div class="col-12">
						<div class="fg fg-req">
							<label for="ddlApprovalType">Approval Type</label>
							<select id="ddlApprovalType">
								<option selected disabled value="">Select</option>
							</select>
							<span class="field-validation-error" id="spnApprovalType" style="display:none;">Please Select Approval Type</span>
						</div>
					</div>
					<div class="col-12">
						<div class="fg fg-req">
							<label for="txtApprovalName">Approval Name</label>
							<input type="text" placeholder="Approval Name" data-trim-input id="txtApprovalName" autocomplete="off" />
							<span class="field-validation-error" id="spnApprovalName" style="display:none;">Please Enter Approval Name</span>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateApproval">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Save</span>
				</button>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var EmployeeId = localStorage.getItem('EmployeeId');
	var approvalMasterId = null;
	var _approvalCache = {};

	var grid = WMSGrid.create({
		container: 'approvalGrid',
		title: 'All Approval Masters',
		icon: 'bx-check-shield',
		perPage: 10,
		columns: [
			{ field: 'ApprovalName',     header: 'Approval Name', width: '220px' },
			{ field: 'ApprovalTypeName', header: 'Approval Type', width: '220px' },
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '130px',
				render: function (v, row) {
					return '<button class="wg-btn wg-btn-primary" onclick="_editApproval(' + row.ApprovalMasterId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
					       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteApproval(' + row.ApprovalMasterId + ',\'' + (row.ApprovalName || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
				}
			}
		],
		features: { export: true }
	});

	function loadTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/ApprovalMasterAPI/GetAllApprovalMasters', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_approvalCache = {};
				rows.forEach(function (r) { _approvalCache[r.ApprovalMasterId] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) showToast(data.responseMessage || 'No records found.', 'info');
			},
			error: function () { grid.hideLoader(); showToast('Failed to load approval masters.', 'error'); }
		});
	}

	function bindApprovalType() {
		$.ajax({
			url: '@baseUrl/ApprovalMasterAPI/GetAllApprovalMasterType', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				if (data.isSuccess) {
					var dd = $('#ddlApprovalType');
					dd.empty().append('<option disabled selected value="">Select</option>');
					$.each(data.data, function (i, t) {
						dd.append('<option value="' + t.ApprovalTypeId + '">' + t.ApprovalTypeName + '</option>');
					});
				}
			}
		});
	}

	$('#addApprovalMaster').on('click', function () { resetForm(); $('#addApprovalMasterModal').modal('show'); });
	$('#addApprovalMasterModal').on('hidden.bs.modal', function () { resetForm(); });

	$('#btnCreateApproval').on('click', function () {
		var approvalTypeId = $('#ddlApprovalType').val();
		var approvalName   = $('#txtApprovalName').val().trim();

		var isValid = true;
		if (!approvalTypeId) { $('#spnApprovalType').show(); $('#ddlApprovalType').addClass('is-invalid'); isValid = false; } else { $('#spnApprovalType').hide(); $('#ddlApprovalType').removeClass('is-invalid'); }
		if (!approvalName)   { $('#spnApprovalName').show(); $('#txtApprovalName').addClass('is-invalid'); isValid = false; } else { $('#spnApprovalName').hide(); $('#txtApprovalName').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnCreateApproval', approvalMasterId ? 'Updating...' : 'Saving...');

		var model = {
			Action:           approvalMasterId ? 'UPDATE' : 'INSERT',
			ApprovalMasterId: approvalMasterId,
			ApprovalName:     approvalName,
			ApprovalTypeId:   approvalTypeId,
			CreatedBy:        EmployeeId,
			UpdatedBy:        EmployeeId
		};

		$.ajax({
			url: '@baseUrl/ApprovalMasterAPI/ManageApprovalMaster', type: 'POST',
			contentType: 'application/json', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			data: JSON.stringify(model),
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (approvalMasterId ? 'Approval updated.' : 'Approval created.'), 'success');
					$('#addApprovalMasterModal').modal('hide');
					loadTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnCreateApproval', approvalMasterId ? 'Update' : 'Save');
				}
			},
			error: function () {
				showToast('Something went wrong. Please try again.', 'error');
				setBtnNormal('#btnCreateApproval', approvalMasterId ? 'Update' : 'Save');
			}
		});
	});

	function resetForm() {
		approvalMasterId = null;
		$('#ddlApprovalType').val('').removeClass('is-invalid');
		$('#txtApprovalName').val('').removeClass('is-invalid');
		$('#spnApprovalType, #spnApprovalName').hide();
		$('.formType').text('Add');
		setBtnNormal('#btnCreateApproval', 'Save');
	}

	window._editApproval = function (id) {
		var data = _approvalCache[id];
		if (!data) return;
		resetForm();
		approvalMasterId = data.ApprovalMasterId;
		$('#ddlApprovalType').val(data.ApprovalTypeId || '');
		$('#txtApprovalName').val(data.ApprovalName || '');
		$('.formType').text('Update');
		setBtnNormal('#btnCreateApproval', 'Update');
		$('#addApprovalMasterModal').modal('show');
	};

	window._deleteApproval = function (id, name) {
		wmsConfirm('Are you sure you want to delete approval <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			var model = { ApprovalMasterId: id, deletedBy: EmployeeId, Action: 'DELETE' };
			$.ajax({
				url: '@baseUrl/ApprovalMasterAPI/ManageApprovalMaster', type: 'POST',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify(model),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Approval deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () { loadTable(); bindApprovalType(); });
})();
</script>
