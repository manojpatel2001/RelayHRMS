    $('.form-control, .form-select').on('input change', function () {
        $(this).removeClass('is-invalid');
        const errorId = 'error' + this.id.charAt(0).toUpperCase() + this.id.slice(1);
        $('#' + errorId).text('');
    });

    $('input[name="gender"]').change(function () { $('#errorGender').text(''); });

    async function updateManpower(data) {
        await resetFormAndValidation();
        manpowerRequisitionId = data.ManpowerRequisitionId;
        await loadDropDownForManpower();
        $('#ddlDepartment').val(data.DepartmentId);
        $('#ddlRequirementType option').filter(function () { return $(this).text() === data.RequirementType; }).prop('selected', true);
        $('#ddlDesignation').val(data.DesignationId);
        $('#ddlEducationalQualification option').filter(function () { return $(this).text() === data.EducationalQualification; }).prop('selected', true);
        $('#ddlCategoryOfEmployment').val(data.CategoryOfEmployment);
        $('#ddlReportingTo').val(data.ReportingToId);
        $('#txtEmployeeName').val(data.EmployeeName);
        $('#txtPersonalEmail').val(data.PersonalEmail);
        $('#txtContactNumber').val(data.ContactNumber);
        $('#ddlClosureBy').val(data.ClosureBy);
        $('#ddlJobCategory').val(data.JobCategory);
        $('#txtExperienceRange').val(data.ExperienceRange);
        $('#txtComputerSkills').val(data.ComputerSkills);
        $('#txtJobResponsibility').val(data.JobResponsibility);
        $('#txtTakeHomeSalary').val(data.TakeHomeSalary);
        $('#txtOtherBenefitsRemark').val(data.OtherBenefits || '');
        $('#txtOtherBenefitsAmount').val(data.Amount || '');
        if (data.DateOfBirth) {
            var dobStr = data.DateOfBirth.split('T')[0];
            $('#txtDateOfBirth').val(dobStr);
            var today = new Date();
            var birthDate = new Date(dobStr);
            var age = today.getFullYear() - birthDate.getFullYear();
            var monthDiff = today.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) age--;
            if (age >= 18 && age <= 100) { $('#txtAge').val(age); $('#errorDateOfBirth').text(''); $('#txtDateOfBirth').removeClass('is-invalid'); }
            else { $('#txtAge').val(''); }
        }
        if (data.DateOfJoining) $('#txtDateOfJoining').val(data.DateOfJoining.split('T')[0]);
        if (data.Gender) $(`input[name="gender"][value="${data.Gender}"]`).prop('checked', true);
        $('#chkSystemRequire').prop('checked', data.SystemRequire === "Yes");
        $('#chkEmailIdRequire').prop('checked', data.EmailIdRequire === "Yes");
        $('#chkSIMRequire').prop('checked', data.Simrequire === "Yes");
        $('#chkErpId').prop('checked', data.ErpId === 'Yes');
        $('#txtNumberPosition').val(data.NumberOfPosition || '');
        $("#btnSubmitManpower").text("Update");
        $(".formType").text("Update");
        $("#addManpowerModal").modal('show');
    }

    function resetFormAndValidation() {
        manpowerRequisitionId = 0;
        $('.error-message').text('');
        $('.form-control, .form-select').removeClass('is-invalid');
        $('#ddlDepartment').val(null).trigger('change');
        $('#ddlRequirementType').val(null).trigger('change');
        $('#ddlDesignation').val(null).trigger('change');
        $('#ddlEducationalQualification').val(null).trigger('change');
        $('#ddlReportingTo').val(null).trigger('change');
        $('#ddlCategoryOfEmployment').val(null).trigger('change');
        $('#txtEmployeeName, #txtPersonalEmail, #txtContactNumber').val('');
        $('#ddlClosureBy').val(null).trigger('change');
        $('#ddlJobCategory').val('').trigger('change');
        $('#errorJobCategory').text('');
        $('#txtExperienceRange, #txtComputerSkills, #txtJobResponsibility, #txtTakeHomeSalary').val('');
        $('#txtOtherBenefitsRemark, #txtOtherBenefitsAmount, #txtDateOfBirth, #txtAge, #txtDateOfJoining').val('');
        $('input[name="gender"]').prop('checked', false);
        $('#chkSystemRequire, #chkEmailIdRequire, #chkSIMRequire').prop('checked', false);
        $('#chkErpId').prop('checked', false);
        $('#txtNumberPosition').val('');
        $("#btnSubmitManpower").prop('disabled', false).text("Save");
        $(".formType").text("Add");
    }

    function deleteManpower(data) {
        if (!confirm("Are you sure you want to delete this?")) return;
        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/DeleteManpowerRequisition',
            type: 'DELETE',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({ id: data.ManpowerRequisitionId, deletedBy: EmployeeId }),
            success: function (response) {
                if (response.isSuccess) { round_success_noti(response.responseMessage); manpowerDataTable(); }
                else { round_error_noti(response.responseMessage); }
            },
            error: function (error) { console.log(error); }
        });
    }

