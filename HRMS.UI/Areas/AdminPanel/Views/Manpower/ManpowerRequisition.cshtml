@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Ticket Status";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}
<style>
    .error-message {
        font-size: 0.875em;
        display: block;
        margin-top: 0.25rem;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .responsive-logo {
        max-width: 100%;
        transition: max-width 0.3s ease;
    }

    @@media (min-width: 768px) {
        .responsive-logo {
            max-width: 170%;
        }
    }

    #GridContainer .dx-toolbar .dx-button.dx-button-default {
        display: none !important;
    }

    .approval-table td {
        vertical-align: top;
        padding: 8px;
    }

    .approval-table .approval-label {
        font-weight: bold;
        font-size: 12px;
        color: #555;
        margin-bottom: 2px;
    }

    .approval-table .approval-value {
        font-size: 13px;
        min-height: 18px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 3px;
        margin-bottom: 8px;
    }

    /* ===== CUSTOM SEARCHABLE SELECT ===== */
    .css-wrapper {
        position: relative;
        width: 100%;
    }
        /* css-selected-box uses .floating-input class from site CSS for exact match.
           Only extra styles needed: cursor + arrow background */
        .css-wrapper .css-selected-box {
            cursor: pointer !important;
            user-select: none;
            /* dropdown arrow — same as form-select */
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 0.75rem center !important;
            background-size: 16px 12px !important;
            padding-right: 2.25rem !important;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

            .css-wrapper .css-selected-box.is-invalid-box {
                border-color: #dc3545 !important;
            }

        .css-wrapper .css-placeholder {
            color: #6c757d;
        }

        .css-wrapper .css-arrow {
            display: none; /* arrow handled by background-image */
        }
        /* Dropdown panel */
        .css-wrapper .css-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 2px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            z-index: 99999;
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

            .css-wrapper .css-dropdown.css-open {
                display: block;
            }

        .css-wrapper .css-search-box {
            padding: 8px;
            border-bottom: 1px solid #eee;
        }

            .css-wrapper .css-search-box input {
                width: 100%;
                border: 1px solid #ced4da;
                border-radius: 0.375rem;
                padding: 6px 10px;
                font-size: 13px;
                outline: none;
                box-sizing: border-box;
                color: #212529;
            }

        .css-wrapper .css-options-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .css-wrapper .css-option {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 14px;
            color: #212529;
        }

            .css-wrapper .css-option:hover {
                background: #e8f4fd;
                color: #2395c6;
            }

            .css-wrapper .css-option.css-selected {
                background: #d0eaf8;
                color: #1a7bb0;
                font-weight: 500;
            }

        .css-wrapper .css-no-result {
            padding: 8px 12px;
            font-size: 13px;
            color: #999;
            font-style: italic;
        }
</style>

<div class="card">
    <div class="card-header bg-transparent ml-0 py-0">
        <div class="row">
            <div class="col-6">
                <h6 class="pt-2 mb-0">Manpower Details</h6>
            </div>
            <div class="col-6 d-flex justify-content-end align-items-center gap-2">
                <button id="btnExportExcel" type="button" class="btn rounded-1"
                        style="background-color:#28a745; color:white; border-color:#28a745;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-file-earmark-excel me-1" viewBox="0 0 16 16">
                        <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z" />
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z" />
                    </svg>
                    Export to Excel
                </button>
                <button id="addManpower" type="button" class="btn rounded-1"
                        style="background-color:#2395c6; color:white;">
                    Add Manpower
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="grid-wrapper" style="position: relative;" id="gridTag">
                    <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column"
                         style="display:none; inset:0; background:rgba(255,255,255,0.6); z-index:10;">
                        <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner"
                             style="width:30px;height:30px;animation:spin 1s linear infinite;" />
                        <div class="grid-loading-text text-dark" style="font-size:16px;">Loading...</div>
                    </div>
                    <div class="row">
                        <div id="rowCount1"></div>
                        <div id="GridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal fade" id="addManpowerModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="exampleModalLabel">
                    <span class="formType">Add</span> Manpower Requisition
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">

                    <!-- ✅ Branch — Custom Searchable -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <div class="css-wrapper">
                                <div class="css-selected-box floating-input" id="cssBranch_box">
                                    <span id="cssBranch_text" class="css-placeholder">Select</span>
                                </div>
                                <label class="floating-label">Branch <span class="text-danger">*</span></label>
                                <div class="css-dropdown" id="cssBranch_dropdown">
                                    <div class="css-search-box">
                                        <input type="text" id="cssBranch_search" placeholder="Search branch..." />
                                    </div>
                                    <div class="css-options-list" id="cssbranch_options"></div>
                                </div>
                            </div>
                            <input type="hidden" id="hdnBranchId" />
                        </div>
                        <span class="text-danger error-message" id="errorBranch"></span>
                    </div>

                    <!-- Department -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlDepartment">
                                <option value="">Select</option>
                            </select>
                            <label class="floating-label">Department<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDepartment"></span>
                    </div>

                    <!-- Requirement Type -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlRequirementType">
                                <option selected disabled value="">Select</option>
                                <option>New Position</option>
                                <option>Replacement</option>
                            </select>
                            <label class="floating-label">Requirement Type<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorRequirementType"></span>
                    </div>

                    <!-- Employee Name -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input
                                   id="txtEmployeeName" placeholder="Name as per Aadhaar" />
                            <label class="floating-label">Name of Employee (As per Aadhaar)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorEmployeeName"></span>
                    </div>

                    <!-- Personal Email -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="email" class="form-control floating-input" data-trim-input
                                   placeholder="Personal Email Id" id="txtPersonalEmail" />
                            <label class="floating-label">Personal Email Id<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorPersonalEmail"></span>
                    </div>

                    <!-- Contact Number -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-integer-only
                                   placeholder="Personal Contact Number" id="txtContactNumber" />
                            <label class="floating-label">Personal Contact Number<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorContactNumber"></span>
                    </div>

                    <!-- Closure By -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlClosureBy">
                                <option selected disabled value="">Select</option>
                                <option>Branch</option>
                                <option>HR</option>
                            </select>
                            <label class="floating-label">Closure by<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorClosureBy"></span>
                    </div>

                    <!-- Designation -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlDesignation">
                                <option value="">Select</option>
                            </select>
                            <label class="floating-label">Designation<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDesignation"></span>
                    </div>

                    <!-- Experience -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtExperienceRange"
                                   placeholder="e.g. 3" oninput="this.value=this.value.replace(/[^0-9.]/g,'')" />
                            <label class="floating-label">Experience (Years)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorExperienceRange"></span>
                    </div>

                    <!-- Educational Qualification -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlEducationalQualification">
                                <option selected disabled value="">Select</option>
                                <option>Post Graduate</option>
                                <option>Graduate</option>
                                <option>Diploma</option>
                                <option>12th Passed</option>
                                <option>10th Passed</option>
                                <option>Below 10th</option>
                            </select>
                            <label class="floating-label">Highest Qualification<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorEducationalQualification"></span>
                    </div>

                    <!-- Computer Skills -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input
                                   id="txtComputerSkills" placeholder="Specific Computer Skills/Technology" />
                            <label class="floating-label">Specific Computer Skills/Technology<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorComputerSkills"></span>
                    </div>

                    <!-- Job Responsibility -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <textarea class="form-control floating-input" id="txtJobResponsibility"
                                      placeholder="Job Responsibility (in Brief)"></textarea>
                            <label class="floating-label">Job Responsibility (in Brief)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorJobResponsibility"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" id="txtDateOfBirth" />
                            <label class="floating-label">Date of Birth<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDateOfBirth"></span>
                    </div>

                    <!-- Age -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtAge"
                                   placeholder="Age" readonly style="background-color:#e9ecef;cursor:not-allowed;" />
                            <label class="floating-label">Age (Auto Calculated)</label>
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <label><b>Gender<span class="text-danger">*</span>:&nbsp;&nbsp;</b></label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="maleGender" value="Male">
                                <label class="form-check-label" for="maleGender">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="femaleGender" value="Female">
                                <label class="form-check-label" for="femaleGender">Female</label>
                            </div>
                        </div>
                        <span class="text-danger error-message" id="errorGender"></span>
                    </div>

                    <!-- Other Benefits Remark -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input
                                   id="txtOtherBenefitsRemark" placeholder="Other Benefits Remark" />
                            <label class="floating-label">Other Benefits Remark</label>
                        </div>
                    </div>

                    <!-- Other Benefits Amount -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtOtherBenefitsAmount"
                                   placeholder="Other Benefits Amount"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <label class="floating-label">Other Benefits Amount</label>
                        </div>
                    </div>

                    <!-- Checkboxes -->
                    <div class="col-12 mt-3">
                        <div class="d-flex flex-wrap gap-4 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSystemRequire">
                                <label class="form-check-label" for="chkSystemRequire">System Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkEmailIdRequire">
                                <label class="form-check-label" for="chkEmailIdRequire">Email Id Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSIMRequire">
                                <label class="form-check-label" for="chkSIMRequire">SIM Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkErpId">
                                <label class="form-check-label" for="chkErpId">ERP ID</label>
                            </div>
                        </div>
                    </div>

                    <!-- Number of Position -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtNumberPosition"
                                   placeholder="Number of Position"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <label class="floating-label">Number of Position<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorNumberPosition"></span>
                    </div>

                    <!-- Job Category -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlJobCategory">
                                <option selected disabled value="">Select</option>
                            </select>
                            <label class="floating-label">Job Category<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorJobCategory"></span>
                    </div>

                    <!-- ✅ Customer Name — only visible for specific job categories -->
                    <div class="col-md-4" id="customerNameWrapper" style="display:none;">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input
                                   id="txtCustomerName" placeholder="Customer Name" />
                            <label class="floating-label">Customer Name<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorCustomerName"></span>
                    </div>

                    <!-- ✅ Reporting To — Custom Searchable -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <div class="css-wrapper">
                                <div class="css-selected-box floating-input" id="cssReporting_box">
                                    <span id="cssReporting_text" class="css-placeholder">Select</span>
                                </div>
                                <label class="floating-label">Reporting To <span class="text-danger">*</span></label>
                                <div class="css-dropdown" id="cssReporting_dropdown">
                                    <div class="css-search-box">
                                        <input type="text" id="cssReporting_search" placeholder="Search employee..." />
                                    </div>
                                    <div class="css-options-list" id="cssReporting_options"></div>
                                </div>
                            </div>
                            <input type="hidden" id="hdnReportingToId" />
                        </div>
                        <span class="text-danger error-message" id="errorReportingTo"></span>
                    </div>

                    <!-- Date of Joining -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" id="txtDateOfJoining" />
                            <label class="floating-label">Date of Joining<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDateOfJoining"></span>
                    </div>

                    <!-- Category of Employment -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlCategoryOfEmployment">
                                <option value="">Select</option>
                                <option>On Roll</option>
                                <option>Off Roll</option>
                            </select>
                            <label class="floating-label">Category of Employment<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorCategoryOfEmployment"></span>
                    </div>

                    <!-- Take Home Salary -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-decimal
                                   id="txtTakeHomeSalary" placeholder="Take Home Salary" />
                            <label class="floating-label">Take Home Salary<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorTakeHomeSalary"></span>
                    </div>

                </div>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-primary" id="btnSubmitManpower"
                        style="background-color:#2395c6;color:white;">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== View Modal ===== -->
<div class="modal fade" id="showMawnpowerDetailsModal" tabindex="-1" aria-labelledby="viewManpowerLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="viewManpowerLabel">Manpower Requisition Form</h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-info me-2" id="downloadPDF">Download as PDF</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body modal-body-font" id="pdfContent">
                <div class="row mb-3 align-items-center">
                    <div class="col-md-3">
                        <img id="adminCompanyLogoImg" src="@baseAPIDomainUrl/default-image/relaylogo.jpeg"
                             alt="Relay Express Logo" class="responsive-logo" crossorigin="anonymous"
                             style="max-height:70px;object-fit:contain;">
                    </div>
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-0">Manpower Requisition Form</h5>
                    </div>
                    <div class="col-md-3 text-end">
                        <p class="mb-1"><strong>Sr. No.:</strong> <span id="serialNo"></span></p>
                        <p class="mb-0"><strong>Date:</strong> <span id="date"></span></p>
                    </div>
                </div>
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td><strong>Location (Branch):</strong></td>
                            <td id="location"></td>
                            <td><strong>Department:</strong></td>
                            <td id="departmentName"></td>
                        </tr>
                        <tr>
                            <td><strong>Requirement:</strong></td>
                            <td id="requirementType"></td>
                            <td><strong>Name of Employee:</strong></td>
                            <td id="employeeName"></td>
                        </tr>
                        <tr>
                            <td><strong>Personal Email:</strong></td>
                            <td id="personalEmail"></td>
                            <td><strong>Personal Contact No:</strong></td>
                            <td id="contactNumber"></td>
                        </tr>
                        <tr>
                            <td><strong>Closure by:</strong></td>
                            <td id="closureBy"></td>
                            <td><strong>Designation:</strong></td>
                            <td id="designationName"></td>
                        </tr>
                        <tr>
                            <td><strong>Job Category:</strong></td>
                            <td id="viewJobCategory"></td>
                            <td><strong>Customer Name:</strong></td>
                            <td id="viewCustomerName"></td>
                        </tr>
                        <tr>
                            <td><strong>Experience (Years):</strong></td>
                            <td id="experienceRange"></td>
                            <td><strong>Highest Qualification:</strong></td>
                            <td id="educationalQualensification"></td>
                        </tr>
                        <tr>
                            <td><strong>Specific Computer Skills:</strong></td>
                            <td id="computerSkills"></td>
                            <td><strong>Job Responsibility:</strong></td>
                            <td id="jobResponsibility"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Birth:</strong></td>
                            <td id="viewDateOfBirth"></td>
                            <td><strong>Age:</strong></td>
                            <td id="age"></td>
                        </tr>
                        <tr>
                            <td><strong>Gender:</strong></td>
                            <td id="gender"></td>
                            <td><strong>Other Benefits Remark:</strong></td>
                            <td id="otherBenefits"></td>
                        </tr>
                        <tr>
                            <td><strong>Other Benefits Amount:</strong></td>
                            <td id="viewOtherBenefitsAmount"></td>
                            <td><strong>Reporting To:</strong></td>
                            <td id="reportingName"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Joining:</strong></td>
                            <td id="dateOfJoining"></td>
