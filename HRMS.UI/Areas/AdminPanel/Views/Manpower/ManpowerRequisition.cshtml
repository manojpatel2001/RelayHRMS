    function fmtDate(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + d.getFullYear();
    }

    function fmtMoney(v) {
        if (v === null || v === undefined || v === '') return '';
        var n = parseFloat(v);
        return isNaN(n) ? '' : n.toFixed(2);
    }

    function escAttr(v) {
        return (v == null ? '' : String(v)).replace(/'/g, "\\'");
    }

