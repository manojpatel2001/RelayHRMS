            { header: 'Received By Date',          key: 'ReceivedByDate' }
        ];

        // ✅ Set columns with width
        worksheet.columns = columns.map(function (col) {
            return { header: col.header, key: col.key, width: 22 };
        });

        // ✅ Style header row
        var headerRow = worksheet.getRow(1);
        headerRow.eachCell(function (cell) {
            cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF28A745' } };
