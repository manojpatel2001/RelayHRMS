    // ================================================================
    // DOB → Age
    // ================================================================
    $(document).on('change', '#txtDateOfBirth', function () {
        var dob = $(this).val();
        if (!dob) { $('#txtAge').val(''); return; }
        var today = new Date(), birth = new Date(dob);
        if (birth >= today) {
            $('#errorDateOfBirth').text('Date of Birth cannot be a future date');
            $('#txtDateOfBirth').addClass('is-invalid'); $('#txtAge').val(''); return;
        }
        var age = today.getFullYear() - birth.getFullYear();
        var m = today.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
        if (age < 18 || age > 100) {
            $('#errorDateOfBirth').text('Age must be between 18 and 100');
            $('#txtDateOfBirth').addClass('is-invalid'); $('#txtAge').val(''); return;
        }
        $('#txtAge').val(age);
        $('#errorDateOfBirth').text(''); $('#txtDateOfBirth').removeClass('is-invalid');
    });

    // ================================================================
    // VALIDATE
    // ================================================================
    async function validateForm() {
        let isValid = true;
        $('.error-message').text('');
        $('.form-control, .form-select').removeClass('is-invalid');
        $('.css-selected-box').removeClass('is-invalid-box');

        if (!$('#hdnBranchId').val()) {
            $('#errorBranch').text('Branch is required');
            $('#cssBranch_box').addClass('is-invalid-box'); isValid = false;
        }
        if (!$('#ddlDepartment').val()) { $('#errorDepartment').text('Department is required'); $('#ddlDepartment').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlRequirementType').val()) { $('#errorRequirementType').text('Requirement Type is required'); $('#ddlRequirementType').addClass('is-invalid'); isValid = false; }
        if (!$('#txtEmployeeName').val()) { $('#errorEmployeeName').text('Employee Name is required'); $('#txtEmployeeName').addClass('is-invalid'); isValid = false; }
        if (!$('#txtPersonalEmail').val()) { $('#errorPersonalEmail').text('Personal Email is required'); $('#txtPersonalEmail').addClass('is-invalid'); isValid = false; }
        if (!$('#txtContactNumber').val()) { $('#errorContactNumber').text('Contact Number is required'); $('#txtContactNumber').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlClosureBy').val()) { $('#errorClosureBy').text('Closure By is required'); $('#ddlClosureBy').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlDesignation').val()) { $('#errorDesignation').text('Designation is required'); $('#ddlDesignation').addClass('is-invalid'); isValid = false; }
        if (!$('#txtExperienceRange').val()) { $('#errorExperienceRange').text('Experience is required'); $('#txtExperienceRange').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlEducationalQualification').val()) { $('#errorEducationalQualification').text('Qualification is required'); $('#ddlEducationalQualification').addClass('is-invalid'); isValid = false; }
        if (!$('#txtComputerSkills').val()) { $('#errorComputerSkills').text('Computer Skills are required'); $('#txtComputerSkills').addClass('is-invalid'); isValid = false; }
        if (!$('#txtJobResponsibility').val()) { $('#errorJobResponsibility').text('Job Responsibility is required'); $('#txtJobResponsibility').addClass('is-invalid'); isValid = false; }
        if (!$('#txtDateOfBirth').val()) {
            $('#errorDateOfBirth').text('Date of Birth is required'); $('#txtDateOfBirth').addClass('is-invalid'); isValid = false;
        } else if (!$('#txtAge').val()) {
            $('#errorDateOfBirth').text('Valid Date of Birth required (Age 18-100)'); $('#txtDateOfBirth').addClass('is-invalid'); isValid = false;
        }
        if (!$('input[name="gender"]:checked').length) { $('#errorGender').text('Gender is required'); isValid = false; }
        if (!$('#hdnReportingToId').val()) {
            $('#errorReportingTo').text('Reporting To is required');
            $('#cssReporting_box').addClass('is-invalid-box'); isValid = false;
        }
        if (!$('#txtDateOfJoining').val()) { $('#errorDateOfJoining').text('Date of Joining is required'); $('#txtDateOfJoining').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlCategoryOfEmployment').val()) { $('#errorCategoryOfEmployment').text('Category of Employment is required'); $('#ddlCategoryOfEmployment').addClass('is-invalid'); isValid = false; }
        if (!$('#txtTakeHomeSalary').val()) { $('#errorTakeHomeSalary').text('Take Home Salary is required'); $('#txtTakeHomeSalary').addClass('is-invalid'); isValid = false; }
        if (!$('#txtNumberPosition').val()) { $('#errorNumberPosition').text('Number of Position is required'); $('#txtNumberPosition').addClass('is-invalid'); isValid = false; }
        if (!$('#ddlJobCategory').val()) { $('#errorJobCategory').text('Job Category is required'); $('#ddlJobCategory').addClass('is-invalid'); isValid = false; }

        // ✅ Customer Name — only if visible
        if ($('#customerNameWrapper').is(':visible') && !$('#txtCustomerName').val().trim()) {  // ✅ only validate when visible
            $('#errorCustomerName').text('Customer Name is required');
            $('#txtCustomerName').addClass('is-invalid'); isValid = false;
        }

        return isValid;
    }

    // ================================================================
    // COLLECT FORM DATA
    // ================================================================
    async function collectFormData(reqId) {
        return {
            ManpowerRequisitionId: reqId,
            BranchId: $('#hdnBranchId').val() ? parseInt($('#hdnBranchId').val()) : null,
            DepartmentId: getValueOrNull($('#ddlDepartment').val()),
            RequirementType: getValueOrNull($('#ddlRequirementType option:selected').text()),
            EmployeeName: getValueOrNull($('#txtEmployeeName').val()),
            PersonalEmail: getValueOrNull($('#txtPersonalEmail').val()),
            ContactNumber: getValueOrNull($('#txtContactNumber').val()),
            ClosureBy: getValueOrNull($('#ddlClosureBy').val()),
            DesignationId: getValueOrNull($('#ddlDesignation').val()),
            ExperienceRange: getValueOrNull($('#txtExperienceRange').val()),
            EducationalQualification: getValueOrNull($('#ddlEducationalQualification option:selected').text()),
            ComputerSkills: getValueOrNull($('#txtComputerSkills').val()),
