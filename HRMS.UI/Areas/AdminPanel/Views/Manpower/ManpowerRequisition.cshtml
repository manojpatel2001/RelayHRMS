    </div>
</div>


<script src="~/assets/js/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<script>
    const EmployeeId = localStorage.getItem("EmployeeId");
    var Token = localStorage.getItem("authToken");
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    let manpowerRequisitionId = 0;

    $("#addManpower").click(async () => {
        resetFormAndValidation();
        await loadDropDownForManpower();
        $("#addManpowerModal").modal('show');
    });

    $(document).ready(function () {
        manpowerDataTable();
        loadEmployeeRecords();
    });

    async function loadEmployeeRecords() {
        $.ajax({
            url: '@baseUrl/EmployeeMasterAPI/GetRecordsForAdd/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                console.log('response',response);
                if (response.isSuccess) {
                    bindCategory(response.data.categories);
                }
            },
            error: function (error) {
                console.error('Error fetching data:', error);
            }
        });
    }

    function bindCategory(data) {
        var dropdown = $('#ddlJobCategory');
        var currentVal = dropdown.val();
        dropdown.empty();
        dropdown.append('<option disabled selected value="">Select</option>');
        $.each(data || [], function (index, item) {
            dropdown.append($('<option>', { value: item.categoryId, text: item.categoryName }));
        });
        if (currentVal) dropdown.val(currentVal);
    }

    // ✅ Export to Excel Button Click - Grid ke Upar Green Button
    $('#btnExportExcel').on('click', function () {
        var gridInstance = null;
        try {
            gridInstance = $("#GridContainer").dxDataGrid('instance');
        } catch (ex) {
            alert('Grid abhi load nahi hua hai. Thodi der baad try karein.');
            return;
        }

        if (!gridInstance) {
            alert('Grid abhi load nahi hua hai. Thodi der baad try karein.');
            return;
        }

        var selectedRows = gridInstance.getSelectedRowsData();

        if (selectedRows.length === 0) {
            alert('Please select at least one row to export.');
            return;
        }

        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet('Manpower');

        DevExpress.excelExporter.exportDataGrid({
            component: gridInstance,
            worksheet: worksheet,
            selectedRowsOnly: true,
            autoFilterEnabled: true,
            customizeCell: function (options) {
                var excelCell = options.excelCell;
                // ✅ Header row styling - Green background, white bold text
                if (excelCell.row === 1) {
                    excelCell.font = { bold: true, color: { argb: 'FFFFFFFF' } };
                    excelCell.fill = {
                        type: 'pattern',
                        pattern: 'solid',
                        fgColor: { argb: 'FF28A745' } // Green color
                    };
                }
                // ✅ All cells border
                excelCell.border = {
                    top: { style: 'thin' },
                    left: { style: 'thin' },
                    bottom: { style: 'thin' },
                    right: { style: 'thin' }
                };
                excelCell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
            }
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(
                    new Blob([buffer], { type: 'application/octet-stream' }),
                    'ManpowerData.xlsx'
                );
            });
        });
    });

    $(document).on('change', '#txtDateOfBirth', function () {
        var dob = $(this).val();
        if (dob) {
            var today = new Date();
            var birthDate = new Date(dob);
            if (birthDate >= today) {
                $('#errorDateOfBirth').text('Date of Birth cannot be a future date');
                $('#txtDateOfBirth').addClass('is-invalid');
                $('#txtAge').val('');
                return;
            }
            var age = today.getFullYear() - birthDate.getFullYear();
            var monthDiff = today.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) age--;
            if (age < 18 || age > 100) {
                $('#errorDateOfBirth').text('Age must be between 18 and 100');
                $('#txtDateOfBirth').addClass('is-invalid');
                $('#txtAge').val('');
                return;
            }
            $('#txtAge').val(age);
            $('#errorDateOfBirth').text('');
            $('#txtDateOfBirth').removeClass('is-invalid');
        } else {
            $('#txtAge').val('');
        }
    });

