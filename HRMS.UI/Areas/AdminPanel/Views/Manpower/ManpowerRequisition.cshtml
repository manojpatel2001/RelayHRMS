    // ================================================================
    // DOB → Age
    // ================================================================
    $(document).on('change', '#txtDateOfBirth', function () {
        var dob = $(this).val();
        if (!dob) { $('#txtAge').val(''); return; }
        var today = new Date(), birth = new Date(dob);
        if (birth >= today) {
            $('#errorDateOfBirth').text('Date of Birth cannot be a future date');
            $('#txtDateOfBirth').addClass('is-invalid'); $('#txtAge').val(''); return;
        }
        var age = today.getFullYear() - birth.getFullYear();
        var m = today.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
        if (age < 18 || age > 100) {
            $('#errorDateOfBirth').text('Age must be between 18 and 100');
            $('#txtDateOfBirth').addClass('is-invalid'); $('#txtAge').val(''); return;
        }
        $('#txtAge').val(age);
        $('#errorDateOfBirth').text(''); $('#txtDateOfBirth').removeClass('is-invalid');
    });

    // ================================================================
    // Take Home Salary → Auto-fill Designation from API
    // ================================================================
    $(document).on('blur', '#txtTakeHomeSalary', function () {
        var salary = $(this).val();

        // Clear designation when salary is empty
        if (!salary || salary.trim() === '') {
            $('#txtDesignationDisplay').val('');
            $('#hdnDesignationId').val('');
            $('#errorDesignation').text('');
            return;
        }

        var salaryInt = parseInt(salary);
        if (isNaN(salaryInt) || salaryInt <= 0) return;

        // Show loading indicator
        $('#designationLoader').show();
        $('#txtDesignationDisplay').val('');
        $('#hdnDesignationId').val('');
        $('#errorDesignation').text('');
        $('#txtDesignationDisplay').removeClass('is-invalid');

        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/GetGradeByTakeHomeSalary/' + salaryInt + '/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                $('#designationLoader').hide();
                if (response.isSuccess && response.data) {
                    var item = Array.isArray(response.data) ? response.data[0] : response.data;
                    if (item && (item.Description || item.description)) {
                        // Description  → shown in read-only designation box
                        // DesignationId → stored in hidden field, sent on Save/Update
                        $('#txtDesignationDisplay').val(item.Description || item.description);
                        $('#hdnDesignationId').val(item.DesignationId || item.designationId || '');
                        $('#errorDesignation').text('');
                        $('#txtDesignationDisplay').removeClass('is-invalid');
                    } else {
                        $('#txtDesignationDisplay').val('');
                        $('#hdnDesignationId').val('');
                        $('#errorDesignation').text('No designation found for this salary range.');
                    }
                } else {
                    $('#txtDesignationDisplay').val('');
                    $('#hdnDesignationId').val('');
                    $('#errorDesignation').text(response.responseMessage || 'No designation found for this salary range.');
                }
            },
            error: function () {
                $('#designationLoader').hide();
                $('#txtDesignationDisplay').val('');
                $('#hdnDesignationId').val('');
                $('#errorDesignation').text('Failed to fetch designation. Please try again.');
            }
        });
    });

