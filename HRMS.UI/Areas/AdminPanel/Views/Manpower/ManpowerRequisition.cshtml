    // ================================================================
    // ✅ SIMPLE SEARCHABLE SELECT — Reusable
    // Usage: buildSearchableSelect('cssBranch', data, valueKey, textKey, onSelectCallback)
    // ================================================================
    function buildSearchableSelect(prefix, data, valueKey, textKey, onSelectFn) {
        // Support both 'Branch' -> cssbranch_options and 'Reporting' -> cssReporting_options
        var optId     = prefix === 'Branch' ? '#cssbranch_options' : '#css' + prefix + '_options';
        var $optList  = $(optId);
        var $box      = $('#css' + prefix + '_box');
        var $dropdown = $('#css' + prefix + '_dropdown');
        var $search   = $('#css' + prefix + '_search');
        // ✅ FIX: Reporting prefix => hdnReportingToId (not hdnReportingId)
        var hiddenId  = prefix === 'Reporting' ? '#hdnReportingToId' : '#hdn' + prefix + 'Id';
        var $hidden   = $(hiddenId);
        var $text     = $('#css' + prefix + '_text');

        // ---- Rebuild option list ----
        $optList.empty();
        if (!data || data.length === 0) {
            $optList.html('<div class="css-no-result">No data found</div>');
        } else {
            $.each(data, function (i, item) {
                var val = item[valueKey];
                var lbl = item[textKey];
                $('<div class="css-option"></div>')
                    .text(lbl)
                    .attr('data-val', val)
                    .appendTo($optList);
            });
        }

        // ---- Toggle open/close on box click ----
        $box.off('click.css').on('click.css', function (e) {
            e.stopPropagation();
            var isOpen = $dropdown.hasClass('css-open');
            $('.css-dropdown.css-open').removeClass('css-open');
            if (!isOpen) {
                $dropdown.addClass('css-open');
                $search.val('').focus();
                $optList.find('.css-option').show();
                $optList.find('.css-no-result').remove();
            }
        });

        // ---- Search filter ----
        $search.off('input.css').on('input.css', function () {
            var q = $(this).val().toLowerCase().trim();
            var anyVisible = false;
            $optList.find('.css-option').each(function () {
                var match = $(this).text().toLowerCase().indexOf(q) > -1;
                $(this).toggle(match);
                if (match) anyVisible = true;
            });
            $optList.find('.css-no-result').remove();
            if (!anyVisible) {
                $optList.append('<div class="css-no-result">No results found</div>');
            }
        });

        // ---- Option click ----
        $optList.off('click.css').on('click.css', '.css-option', function () {
            var val = $(this).attr('data-val');
            var lbl = $(this).text();
            $hidden.val(val);
            $text.text(lbl).removeClass('css-placeholder');
            $box.removeClass('is-invalid-box');
            $optList.find('.css-option').removeClass('css-selected');
            $(this).addClass('css-selected');
            $dropdown.removeClass('css-open');
            var errId = prefix === 'Reporting' ? '#errorReportingTo' : '#error' + prefix;
            $(errId).text('');
            if (typeof onSelectFn === 'function') onSelectFn(val, lbl);
        });
    }

    // ✅ Helper: get correct hidden field ID
    function getCssHiddenId(prefix) {
        return prefix === 'Reporting' ? '#hdnReportingToId' : '#hdn' + prefix + 'Id';
    }

    // Set value programmatically (for edit)
    function setCssSelectValue(prefix, val, label) {
        var optId    = prefix === 'Branch' ? '#cssbranch_options' : '#css' + prefix + '_options';
        var hiddenId = getCssHiddenId(prefix);
        $(hiddenId).val(val || '');
        var $text = $('#css' + prefix + '_text');
        if (val && label) {
            $text.text(label).removeClass('css-placeholder');
            $(optId).find('.css-option').removeClass('css-selected')
                .filter(function () { return $(this).attr('data-val') == val; })
                .addClass('css-selected');
        } else {
            $text.text('Select').addClass('css-placeholder');
        }
    }

    // Reset
    function resetCssSelect(prefix) {
        var optId    = prefix === 'Branch' ? '#cssbranch_options' : '#css' + prefix + '_options';
        var hiddenId = getCssHiddenId(prefix);
        $(hiddenId).val('');
        $('#css' + prefix + '_text').text('Select').addClass('css-placeholder');
        $(optId).find('.css-option').removeClass('css-selected').show();
        $('#css' + prefix + '_box').removeClass('is-invalid-box');
