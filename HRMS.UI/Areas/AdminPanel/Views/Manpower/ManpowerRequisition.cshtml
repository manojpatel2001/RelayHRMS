                Gender:                   data.Gender || '',
                OtherBenefits:            data.OtherBenefits || '',
                Amount:                   data.Amount || '',
                ReportingName:            data.ReportingName || '',
                DateOfJoining:            formatDate(data.DateOfJoining),
                CategoryOfEmployment:     data.CategoryOfEmployment || '',
                TakeHomeSalary:           data.TakeHomeSalary || '',
                SystemRequire:            data.SystemRequire || '',
                EmailIdRequire:           data.EmailIdRequire || '',
                Simrequire:               data.Simrequire || data.SIMRequire || '',
                ERP_ID:                   data.ERP_ID || data.ErpId || '',
                NumberOfPosition:         data.NumberOfPosition || '',
                Status:                   data.Status || '',
                RequestedBy:              data.RequestedBy || '',
                ReqDesignation:           data.DesignationName || '',
                ReqDate:                  formatDate(data.CreatedDate),
