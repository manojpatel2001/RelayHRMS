    function loadAdminLogoAsBase64(url, callback) {
        var img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = function () {
            var canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth; canvas.height = img.naturalHeight;
            canvas.getContext('2d').drawImage(img, 0, 0);
            try {
                adminLogoBase64 = canvas.toDataURL('image/jpeg');
                var el = document.getElementById('adminCompanyLogoImg');
                if (el) el.src = adminLogoBase64;
            } catch (e) { }
            if (callback) callback();
        };
        img.onerror = function () { if (callback) callback(); };
        img.src = url + '?t=' + new Date().getTime();
    }

