    // ================================================================
    // COLLECT FORM DATA
    // ================================================================
    async function collectFormData(reqId) {
        return {
            ManpowerRequisitionId: reqId,
            BranchId: $('#ddlBranch').val() ? parseInt($('#ddlBranch').val()) : null,
            DepartmentId: getValueOrNull($('#ddlDepartment').val()),
            RequirementType: getValueOrNull($('#ddlRequirementType option:selected').text()),
            EmployeeName: getValueOrNull($('#txtEmployeeName').val()),
            PersonalEmail: getValueOrNull($('#txtPersonalEmail').val()),
            ContactNumber: getValueOrNull($('#txtContactNumber').val()),
            ClosureBy: getValueOrNull($('#ddlClosureBy').val()),
            // Designation now comes from hidden field auto-filled by salary API
            DesignationId: getValueOrNull($('#hdnDesignationId').val()),
            ExperienceRange: getValueOrNull($('#txtExperienceRange').val()),
            EducationalQualification: getValueOrNull($('#ddlEducationalQualification option:selected').text()),
            ComputerSkills: getValueOrNull($('#txtComputerSkills').val()),
            JobResponsibility: getValueOrNull($('#txtJobResponsibility').val()),
            DateOfBirth: $('#txtDateOfBirth').val() ? new Date($('#txtDateOfBirth').val()).toISOString() : null,
            Age: $('#txtAge').val() ? parseInt($('#txtAge').val()) : null,
            Gender: getValueOrNull($('input[name="gender"]:checked').val()),
            OtherBenefits: getValueOrNull($('#txtOtherBenefitsRemark').val()),
            Amount: $('#txtOtherBenefitsAmount').val() ? parseFloat($('#txtOtherBenefitsAmount').val()) : null,
            SystemRequire: $('#chkSystemRequire').is(':checked') ? "Yes" : "No",
            EmailIdRequire: $('#chkEmailIdRequire').is(':checked') ? "Yes" : "No",
            Simrequire: $('#chkSIMRequire').is(':checked') ? "Yes" : "No",
            ErpId: $('#chkErpId').is(':checked') ? "Yes" : "No",
            NumberOfPosition: 0,
            JobCategory: $('#ddlJobCategory').val() ? parseInt($('#ddlJobCategory').val()) : null,
            CustomerName: $('#customerNameWrapper').is(':visible') ? getValueOrNull($('#txtCustomerName').val()) : null,
            ReportingToId: getValueOrNull($('#ddlReportingTo').val()),
            DateOfJoining: $('#txtDateOfJoining').val() ? new Date($('#txtDateOfJoining').val()).toISOString() : null,
            CategoryOfEmployment: getValueOrNull($('#ddlCategoryOfEmployment').val()),
            TakeHomeSalary: $('#txtTakeHomeSalary').val() ? parseFloat($('#txtTakeHomeSalary').val()) : null,
            CreatedBy: EmployeeId,
            UpdatedBy: EmployeeId,
            CompanyId: CompanyId
        };
    }

    function getValueOrNull(v) {
        return (v === "" || v === undefined || v === null) ? null : v;
    }

    // Clear validation on input
    $('.form-control, .form-select').on('input change', function () {
        $(this).removeClass('is-invalid');
        var errorId = 'error' + this.id.charAt(0).toUpperCase() + this.id.slice(1);
        $('#' + errorId).text('');
    });
    $('input[name="gender"]').change(function () { $('#errorGender').text(''); });

    // ================================================================
    // SUBMIT
    // ================================================================
    $('#btnSubmitManpower').click(async function () {
        var $btn = $(this);
        if ($btn.prop('disabled')) return;
        var valid = await validateForm();
        if (!valid) return;
        var formData = await collectFormData(manpowerRequisitionId);
        var isNew = manpowerRequisitionId == 0;
        $btn.prop('disabled', true).text('Saving...');
        $.ajax({
            url: isNew
                ? '@baseUrl/ManpowerRequisitionAPI/CreateManpowerRequisition'
                : '@baseUrl/ManpowerRequisitionAPI/UpdateManpowerRequisition',
            type: 'POST',
            data: JSON.stringify(formData),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) {
                    showToast(res.responseMessage || (isNew ? 'Manpower requisition created.' : 'Manpower requisition updated.'), 'success');
                    $('#addManpowerModal').modal('hide');
                    loadManpowerData();
                } else {
                    showToast(res.responseMessage || 'Something went wrong.', 'error');
                    $btn.prop('disabled', false).text(isNew ? 'Save' : 'Update');
                }
            },
            error: function () {
                showToast('Something went wrong. Please try again.', 'error');
                $btn.prop('disabled', false).text(isNew ? 'Save' : 'Update');
            }
        });
    });

    window._editManpower = function (id) {
        var data = _manpowerCache[id];
        if (!data) return;
        updateManpower(data);
    };

    async function updateManpower(data) {
        resetFormAndValidation();
        manpowerRequisitionId = data.ManpowerRequisitionId;
        await loadDropDownForManpower();

        // Basic dropdowns
        $('#ddlDepartment').val(data.DepartmentId);
        $('#ddlRequirementType option').filter(function () { return $(this).text() === data.RequirementType; }).prop('selected', true);
        $('#ddlEducationalQualification option').filter(function () { return $(this).text() === data.EducationalQualification; }).prop('selected', true);
        $('#ddlCategoryOfEmployment').val(data.CategoryOfEmployment);
        $('#ddlClosureBy').val(data.ClosureBy);

        // Job Category
        $('#ddlJobCategory').val(data.JobCategory);

        // Customer Name — check selected text and show/hide wrapper
        var selectedCatText = $('#ddlJobCategory option:selected').text().trim();
        if (isCustomerCategory(selectedCatText)) {
            $('#customerNameWrapper').show();
            $('#txtCustomerName').val(data.CustomerName || '');
        } else if (data.CustomerName) {
            $('#customerNameWrapper').show();
            $('#txtCustomerName').val(data.CustomerName);
        } else {
            $('#customerNameWrapper').hide();
            $('#txtCustomerName').val('');
        }

        // Reporting To
        setCssSelectValue('Reporting', data.ReportingToId, data.ReportingName);

        // Text inputs
        $('#txtEmployeeName').val(data.EmployeeName);
        $('#txtPersonalEmail').val(data.PersonalEmail);
        $('#txtContactNumber').val(data.ContactNumber);
        $('#txtExperienceRange').val(data.ExperienceRange);
        $('#txtComputerSkills').val(data.ComputerSkills);
        $('#txtJobResponsibility').val(data.JobResponsibility);
        $('#txtOtherBenefitsRemark').val(data.OtherBenefits || '');
        $('#txtOtherBenefitsAmount').val(data.Amount || '');

        // Take Home Salary
        $('#txtTakeHomeSalary').val(data.TakeHomeSalary);

        // Designation — restored from saved record
        $('#txtDesignationDisplay').val(data.DesignationName || '');
        $('#hdnDesignationId').val(data.DesignationId || '');

        // Date of Birth
        if (data.DateOfBirth) {
            var dob = data.DateOfBirth.split('T')[0];
            $('#txtDateOfBirth').val(dob);
            var today = new Date();
            var birth = new Date(dob);
            var age = today.getFullYear() - birth.getFullYear();
            var m = today.getMonth() - birth.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
            if (age >= 18 && age <= 100) {
                $('#txtAge').val(age);
                $('#errorDateOfBirth').text('');
                $('#txtDateOfBirth').removeClass('is-invalid');
            }
        }

        // Date of Joining
        if (data.DateOfJoining) $('#txtDateOfJoining').val(data.DateOfJoining.split('T')[0]);

        // Gender
        if (data.Gender) $('input[name="gender"][value="' + data.Gender + '"]').prop('checked', true);

        // Checkboxes
        $('#chkSystemRequire').prop('checked', data.SystemRequire === "Yes" || data.systemRequire === "Yes");
        $('#chkEmailIdRequire').prop('checked', data.EmailIdRequire === "Yes" || data.emailIdRequire === "Yes");
        var simVal = data.SIMRequire || data.Simrequire || data.simRequire || data.SimRequire || '';
        $('#chkSIMRequire').prop('checked', simVal === "Yes");
        var erpVal = data.ERP_ID || data.ErpId || data.erpId || '';
        $('#chkErpId').prop('checked', erpVal === "Yes");

        $(".formType").text("Update");
        $("#btnSubmitManpower").prop('disabled', false).text("Update");

        // ================================================================
        // BRANCH — Force reload every time to guarantee options are present,
        // then match by both Id and Name as fallback
        // ================================================================
        var branchId   = (data.BranchId !== null && data.BranchId !== undefined) ? data.BranchId.toString().trim() : '';
        var branchName = (data.BranchName || '').trim();

        loadBranchList(function () {
            // Small defer to ensure DOM is fully painted after buildSearchableSelect
            setTimeout(function () {
                var $ddlBranch = $('#ddlBranch');
                var matched = false;

                // Try match by Id first
                if (branchId && $ddlBranch.find('option[value="' + branchId + '"]').length) {
                    $ddlBranch.val(branchId);
                    matched = true;
                }

                // Fallback — match by Name if Id match failed
                if (!matched && branchName) {
                    var $matchByName = $ddlBranch.find('option').filter(function () {
                        return $(this).text().trim().toLowerCase() === branchName.toLowerCase();
                    });
                    if ($matchByName.length) {
                        $ddlBranch.val($matchByName.first().val());
                        matched = true;
                    }
                }

                if (!matched) {
                    $ddlBranch.val('');
                }

                $ddlBranch.removeClass('is-invalid');
                $("#addManpowerModal").modal('show');
            }, 50);
        });
    }

    // ================================================================
    // RESET FORM
    // ================================================================
    function resetFormAndValidation() {
        manpowerRequisitionId = 0;
        $('.error-message').text('');
