@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Ticket Status";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}
<style>
    .error-message {
        font-size: 0.875em;
        display: block;
        margin-top: 0.25rem;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .responsive-logo {
        max-width: 100%;
        transition: max-width 0.3s ease;
    }

    @@media (min-width: 768px) {
        .responsive-logo {
            max-width: 170%;
        }
    }

    .approval-table td {
        vertical-align: top;
        padding: 8px;
    }

    .approval-table .approval-label {
        font-weight: bold;
        font-size: 12px;
        color: #555;
        margin-bottom: 2px;
    }

    .approval-table .approval-value {
        font-size: 13px;
        min-height: 18px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 3px;
        margin-bottom: 8px;
    }

    /* Designation auto-fill spinner */
    .designation-loading {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 12px;
        color: #2395c6;
        display: none;
    }
</style>

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manpower Requisitions</h6>
        <div class="d-flex align-items-center gap-2">
            <button id="btnExportExcel" type="button" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-download"></i> Export to Excel
            </button>
            <button id="addManpower" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add Manpower
            </button>
        </div>
    </div>
    <div class="card-body">
        <div id="manpowerGridContainer"></div>
    </div>
</div>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal fade" id="addManpowerModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="exampleModalLabel">
                    <span class="formType">Add</span> Manpower Requisition
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">

                    <!-- Branch -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlBranch">Branch</label>
                            <select id="ddlBranch">
                                <option value="">Select</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorBranch"></span>
                    </div>

                    <!-- Department -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlDepartment">Department</label>
                            <select id="ddlDepartment">
                                <option value="">Select</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorDepartment"></span>
                    </div>

                    <!-- Requirement Type -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlRequirementType">Requirement Type</label>
                            <select id="ddlRequirementType">
                                <option selected disabled value="">Select</option>
                                <option>New Position</option>
                                <option>Replacement</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorRequirementType"></span>
                    </div>

                    <!-- Employee Name -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtEmployeeName">Name of Employee (As per Aadhaar)</label>
                            <input type="text" data-trim-input
                                   id="txtEmployeeName" placeholder="Name as per Aadhaar" />
                        </div>
                        <span class="field-validation-error error-message" id="errorEmployeeName"></span>
                    </div>

                    <!-- Personal Email -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtPersonalEmail">Personal Email Id</label>
                            <input type="email" data-trim-input
                                   placeholder="Personal Email Id" id="txtPersonalEmail" />
                        </div>
                        <span class="field-validation-error error-message" id="errorPersonalEmail"></span>
                    </div>

                    <!-- Contact Number -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtContactNumber">Personal Contact Number</label>
                            <input type="text" data-integer-only
                                   placeholder="Personal Contact Number" id="txtContactNumber" />
                        </div>
                        <span class="field-validation-error error-message" id="errorContactNumber"></span>
                    </div>

                    <!-- Closure By -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlClosureBy">Closure by</label>
                            <select id="ddlClosureBy">
                                <option selected disabled value="">Select</option>
                                <option>Branch</option>
                                <option>HR</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorClosureBy"></span>
                    </div>

                    <!-- Take Home Salary — moved BEFORE Designation so salary triggers designation auto-fill -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtTakeHomeSalary">Take Home Salary</label>
                            <input type="text" data-decimal
                                   id="txtTakeHomeSalary" placeholder="Take Home Salary" />
                        </div>
                        <span class="field-validation-error error-message" id="errorTakeHomeSalary"></span>
                    </div>

                    <!-- Designation — Auto-filled from Take Home Salary (read-only) -->
                    <div class="col-md-4">
                        <div class="fg fg-req" style="position:relative;">
                            <label for="txtDesignationDisplay">Designation</label>
                            <input type="text" id="txtDesignationDisplay"
                                   readonly placeholder="Auto-filled from salary"
                                   style="background-color:#e9ecef; cursor:not-allowed;" />
                            <span class="designation-loading" id="designationLoader">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16" style="animation:spin 1s linear infinite;">
                                    <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41zm-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9z" />
                                    <path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5.002 5.002 0 0 0 8 3zM3.1 9a5.002 5.002 0 0 0 7.757 2.997a.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9H3.1z" />
                                </svg>
                                Fetching...
                            </span>
                            <input type="hidden" id="hdnDesignationId" />
                        </div>
                        <span class="field-validation-error error-message" id="errorDesignation"></span>
                    </div>

                    <!-- Experience -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtExperienceRange">Experience (Years)</label>
                            <input type="text" id="txtExperienceRange"
                                   placeholder="e.g. 3" oninput="this.value=this.value.replace(/[^0-9.]/g,'')" />
                        </div>
                        <span class="field-validation-error error-message" id="errorExperienceRange"></span>
                    </div>

                    <!-- Educational Qualification -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlEducationalQualification">Highest Qualification</label>
                            <select id="ddlEducationalQualification">
                                <option selected disabled value="">Select</option>
                                <option>Post Graduate</option>
                                <option>Graduate</option>
                                <option>Diploma</option>
                                <option>12th Passed</option>
                                <option>10th Passed</option>
                                <option>Below 10th</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorEducationalQualification"></span>
                    </div>

                    <!-- Computer Skills -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtComputerSkills">Specific Computer Skills/Technology</label>
                            <input type="text" data-trim-input
                                   id="txtComputerSkills" placeholder="Specific Computer Skills/Technology" />
                        </div>
                        <span class="field-validation-error error-message" id="errorComputerSkills"></span>
                    </div>

                    <!-- Job Responsibility -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtJobResponsibility">Job Responsibility (in Brief)</label>
                            <textarea id="txtJobResponsibility"
                                      placeholder="Job Responsibility (in Brief)"></textarea>
                        </div>
                        <span class="field-validation-error error-message" id="errorJobResponsibility"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtDateOfBirth">Date of Birth</label>
                            <input type="date" id="txtDateOfBirth" />
                        </div>
                        <span class="field-validation-error error-message" id="errorDateOfBirth"></span>
                    </div>

                    <!-- Age -->
                    <div class="col-md-4">
                        <div class="fg">
                            <label for="txtAge">Age (Auto Calculated)</label>
                            <input type="text" id="txtAge"
                                   placeholder="Age" readonly style="background-color:#e9ecef;cursor:not-allowed;" />
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <label><b>Gender<span class="text-danger">*</span>:&nbsp;&nbsp;</b></label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="maleGender" value="Male">
                                <label class="form-check-label" for="maleGender">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="femaleGender" value="Female">
                                <label class="form-check-label" for="femaleGender">Female</label>
                            </div>
                        </div>
                        <span class="text-danger error-message" id="errorGender"></span>
                    </div>

                    <!-- Other Benefits Remark -->
                    <div class="col-md-4">
                        <div class="fg">
                            <label for="txtOtherBenefitsRemark">Other Benefits Remark</label>
                            <input type="text" data-trim-input
                                   id="txtOtherBenefitsRemark" placeholder="Other Benefits Remark" />
                        </div>
                    </div>

                    <!-- Other Benefits Amount -->
                    <div class="col-md-4">
                        <div class="fg">
                            <label for="txtOtherBenefitsAmount">Other Benefits Amount</label>
                            <input type="text" id="txtOtherBenefitsAmount"
                                   placeholder="Other Benefits Amount"
                                   oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                        </div>
                    </div>

                    <!-- Checkboxes -->
                    <div class="col-12 mt-3">
                        <div class="d-flex flex-wrap gap-4 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSystemRequire">
                                <label class="form-check-label" for="chkSystemRequire">System Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkEmailIdRequire">
                                <label class="form-check-label" for="chkEmailIdRequire">Email Id Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSIMRequire">
                                <label class="form-check-label" for="chkSIMRequire">SIM Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkErpId">
                                <label class="form-check-label" for="chkErpId">ERP ID</label>
                            </div>
                        </div>
                    </div>

                    <!-- Job Category -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlJobCategory">Job Category</label>
                            <select id="ddlJobCategory">
                                <option selected disabled value="">Select</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorJobCategory"></span>
                    </div>

                    <!-- Customer Name — only visible for specific job categories -->
                    <div class="col-md-4" id="customerNameWrapper" style="display:none;">
                        <div class="fg fg-req">
                            <label for="txtCustomerName">Customer Name</label>
                            <input type="text" data-trim-input
                                   id="txtCustomerName" placeholder="Customer Name" />
                        </div>
                        <span class="field-validation-error error-message" id="errorCustomerName"></span>
                    </div>

                    <!-- Reporting To -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlReportingTo">Reporting To</label>
                            <select id="ddlReportingTo">
                                <option value="">Select</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorReportingTo"></span>
                    </div>

                    <!-- Date of Joining -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="txtDateOfJoining">Date of Joining</label>
                            <input type="date" id="txtDateOfJoining" />
                        </div>
                        <span class="field-validation-error error-message" id="errorDateOfJoining"></span>
                    </div>

                    <!-- Category of Employment -->
                    <div class="col-md-4">
                        <div class="fg fg-req">
                            <label for="ddlCategoryOfEmployment">Category of Employment</label>
                            <select id="ddlCategoryOfEmployment">
                                <option value="">Select</option>
                                <option>On Roll</option>
                                <option>Off Roll</option>
                            </select>
                        </div>
                        <span class="field-validation-error error-message" id="errorCategoryOfEmployment"></span>
                    </div>

                </div>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-primary" id="btnSubmitManpower"
                        style="background-color:#2395c6;color:white;">
                    Save
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== View Modal ===== -->
<div class="modal fade" id="showMawnpowerDetailsModal" tabindex="-1" aria-labelledby="viewManpowerLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="viewManpowerLabel">Manpower Requisition Form</h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-info me-2" id="downloadPDF">Download as PDF</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body modal-body-font" id="pdfContent">
                <div class="row mb-3 align-items-center">
                    <div class="col-md-3">
                        <img id="adminCompanyLogoImg" src="@baseAPIDomainUrl/default-image/relaylogo.jpeg"
                             alt="Relay Express Logo" class="responsive-logo" crossorigin="anonymous"
                             style="max-height:70px;object-fit:contain;">
                    </div>
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-0">Manpower Requisition Form</h5>
                    </div>
                    <div class="col-md-3 text-end">
                        <p class="mb-1"><strong>Sr. No.:</strong> <span id="serialNo"></span></p>
                        <p class="mb-0"><strong>Date:</strong> <span id="date"></span></p>
                    </div>
                </div>
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td><strong>Location (Branch):</strong></td>
                            <td id="location"></td>
                            <td><strong>Department:</strong></td>
                            <td id="departmentName"></td>
                        </tr>
                        <tr>
                            <td><strong>Requirement:</strong></td>
                            <td id="requirementType"></td>
                            <td><strong>Name of Employee:</strong></td>
                            <td id="employeeName"></td>
                        </tr>
                        <tr>
                            <td><strong>Personal Email:</strong></td>
                            <td id="personalEmail"></td>
                            <td><strong>Personal Contact No:</strong></td>
                            <td id="contactNumber"></td>
                        </tr>
                        <tr>
                            <td><strong>Closure by:</strong></td>
                            <td id="closureBy"></td>
                            <td><strong>Designation:</strong></td>
                            <td id="designationName"></td>
                        </tr>
                        <tr>
                            <td><strong>Job Category:</strong></td>
                            <td id="viewJobCategory"></td>
                            <td><strong>Customer Name:</strong></td>
                            <td id="viewCustomerName"></td>
                        </tr>
                        <tr>
                            <td><strong>Experience (Years):</strong></td>
                            <td id="experienceRange"></td>
                            <td><strong>Highest Qualification:</strong></td>
                            <td id="educationalQualensification"></td>
                        </tr>
                        <tr>
                            <td><strong>Specific Computer Skills:</strong></td>
                            <td id="computerSkills"></td>
                            <td><strong>Job Responsibility:</strong></td>
                            <td id="jobResponsibility"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Birth:</strong></td>
                            <td id="viewDateOfBirth"></td>
                            <td><strong>Age:</strong></td>
                            <td id="age"></td>
                        </tr>
                        <tr>
                            <td><strong>Gender:</strong></td>
                            <td id="gender"></td>
                            <td><strong>Other Benefits Remark:</strong></td>
                            <td id="otherBenefits"></td>
                        </tr>
                        <tr>
                            <td><strong>Other Benefits Amount:</strong></td>
                            <td id="viewOtherBenefitsAmount"></td>
                            <td><strong>Reporting To:</strong></td>
                            <td id="reportingName"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Joining:</strong></td>
                            <td id="dateOfJoining"></td>
                            <td><strong>Category of Employment:</strong></td>
                            <td id="categoryOfEmployment"></td>
                        </tr>
                        <tr>
                            <td><strong>Take Home Salary:</strong></td>
                            <td id="takeHomeSalary"></td>
                            <td><strong>System Require:</strong></td>
                            <td id="systemRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>Email ID Require:</strong></td>
                            <td id="emailIdRequire"></td>
                            <td><strong>SIM Require:</strong></td>
                            <td id="simRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>ERP ID:</strong></td>
                            <td id="viewErpId"></td>
                            <td><strong>Number of Position:</strong></td>
                            <td id="viewNumberPosition"></td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-bordered approval-table">
                    <thead>
                        <tr>
                            <th>Requested By</th>
                            <th>Approved By</th>
                            <th>Received By (HRD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="requestedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="requestedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="requestedByDate"></span></div>
                            </td>
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="approvedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="approvedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="approvedByDate"></span></div>
                            </td>
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="receivedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value">&nbsp;</div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="receivedByDate"></span></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<script>
    const EmployeeId = localStorage.getItem("EmployeeId");
    var Token = localStorage.getItem("authToken");
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    let manpowerRequisitionId = 0;
    var adminLogoBase64 = null;
    var manpowerSelectedIds = [];
    var _manpowerCache = {};

    // ================================================================
    // SIMPLE SEARCHABLE SELECT — now backed by plain <select> elements
    // (Branch → #ddlBranch, Reporting → #ddlReportingTo)
    // ================================================================
    function getCssSelId(prefix) {
        return prefix === 'Branch' ? '#ddlBranch' : '#ddlReportingTo';
    }

    function buildSearchableSelect(prefix, data, valueKey, textKey, onSelectFn) {
        var $sel = $(getCssSelId(prefix));
        var currentVal = $sel.val();
        $sel.empty().append('<option value="">Select</option>');
        $.each(data || [], function (i, item) {
            $sel.append($('<option>', { value: item[valueKey], text: item[textKey] }));
        });
        if (currentVal) $sel.val(currentVal);

        $sel.off('change.css').on('change.css', function () {
            var val = $(this).val();
            var lbl = $(this).find('option:selected').text();
            $sel.removeClass('is-invalid');
            var errId = prefix === 'Reporting' ? '#errorReportingTo' : '#error' + prefix;
            $(errId).text('');
            if (typeof onSelectFn === 'function') onSelectFn(val, lbl);
        });
    }

    function getCssHiddenId(prefix) {
        return getCssSelId(prefix);
    }

    function setCssSelectValue(prefix, val, label) {
        var valStr = (val !== null && val !== undefined && val !== '') ? val.toString() : '';
        $(getCssSelId(prefix)).val(valStr);
    }

    function resetCssSelect(prefix) {
        $(getCssSelId(prefix)).val('').removeClass('is-invalid');
    }

    // ================================================================
    // Job Category → Show/Hide Customer Name
    // ================================================================
    function isCustomerCategory(text) {
        var t = text.toUpperCase();
        return (t.indexOf('OPERATOR') > -1 || t.indexOf('OPERATED') > -1 || t.indexOf('PICKUP') > -1);
    }

    $(document).on('change', '#ddlJobCategory', function () {
        var selectedText = $(this).find('option:selected').text().trim();
        if (isCustomerCategory(selectedText)) {
            $('#customerNameWrapper').show();
        } else {
            $('#customerNameWrapper').hide();
            $('#txtCustomerName').val('');
            $('#errorCustomerName').text('');
            $('#txtCustomerName').removeClass('is-invalid');
        }
    });

    // ================================================================
    // PAGE READY
    // ================================================================
    $(document).ready(function () {
        loadAdminLogoAsBase64('@baseAPIDomainUrl/default-image/relaylogo.jpeg');
        loadManpowerData();
        loadEmployeeRecords();
        loadBranchList();
    });

    // ================================================================
    // LOAD BRANCH LIST
    // ================================================================

    function loadBranchList(callback) {
        $.ajax({
            url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var data = response?.data || [];
