        }
        if (!$('#txtTakeHomeSalary').val()) {
            $('#errorTakeHomeSalary').text('Take Home Salary is required');
            $('#txtTakeHomeSalary').addClass('is-invalid'); isValid = false;
        }
        // Designation validation — must be auto-filled from salary
        if (!$('#hdnDesignationId').val() && !$('#txtDesignationDisplay').val().trim()) {
            $('#errorDesignation').text('Designation is required. Please enter Take Home Salary first.');
