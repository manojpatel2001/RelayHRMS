    $(document).on('change', '#txtDateOfBirth', function () {
        var dob = $(this).val();
        if (dob) {
            var today = new Date();
            var birthDate = new Date(dob);
            if (birthDate >= today) {
                $('#errorDateOfBirth').text('Date of Birth cannot be a future date');
                $('#txtDateOfBirth').addClass('is-invalid');
                $('#txtAge').val('');
                return;
            }
            var age = today.getFullYear() - birthDate.getFullYear();
            var monthDiff = today.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) age--;
            if (age < 18 || age > 100) {
                $('#errorDateOfBirth').text('Age must be between 18 and 100');
                $('#txtDateOfBirth').addClass('is-invalid');
                $('#txtAge').val('');
                return;
            }
            $('#txtAge').val(age);
            $('#errorDateOfBirth').text('');
            $('#txtDateOfBirth').removeClass('is-invalid');
        } else {
            $('#txtAge').val('');
        }
    });

