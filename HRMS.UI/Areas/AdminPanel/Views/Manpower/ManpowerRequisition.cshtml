    // ✅ Load Approved By / Received By from usp_GetManpowerRequisitionApprovalStatus
    function loadApprovalStatus(manpowerRequisitionId) {
        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/GetApprovalStatus',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({
                ApprovalMasterId: 3,
                ManpowerRequisitionId: manpowerRequisitionId
            }),
            success: function (res) {
                if (!res || !res.isSuccess) return;

                // Result Set 2 — Level wise data from usp_GetManpowerRequisitionApprovalStatus
                // Columns available: LevelNo, ApproverType, ApproverName, ActionByName,
                //                    StatusId, LevelStatus, ActionOn, AssignedOn
                var levels = res.data && res.data.levels ? res.data.levels : [];

                console.log('Approval Levels:', levels); // debug — remove after testing

                // ================================================================
                // APPROVED BY:
                // LevelNo = 1 → Reporting Manager (first approver)
                // ActionByName = person who actually clicked Approve
                // ApproverName = person who was assigned to approve
                // Use ActionByName if StatusId=11, else ApproverName
                // ================================================================
                var approvedLevel = null;
                for (var i = 0; i < levels.length; i++) {
                    var l = levels[i];
                    // LevelNo 1 or 2 — non-HR approver levels
                    if (l.LevelNo == 1 || l.LevelNo == 2) {
                        if (l.StatusId == 11) {
                            // Approved — use ActionByName (who actually approved)
                            approvedLevel = l;
                            break;
                        } else if (!approvedLevel && (l.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)')) {
                            approvedLevel = l;
                            break;
                        }
                    }
                }

                // ================================================================
                // RECEIVED BY (HRD):
                // ApproverType = 'HR' OR last level (highest LevelNo)
                // ActionByName = HR person who received/approved
                // ================================================================
                var hrLevel = null;
                var maxLevelNo = 0;

                for (var j = 0; j < levels.length; j++) {
                    var lv = levels[j];
                    var lvType = (lv.ApproverType || '').toUpperCase();

                    // Priority 1: Explicitly HR type
                    if (lvType.indexOf('HR') > -1) {
                        hrLevel = lv;
                        break;
                    }
                    // Priority 2: Highest LevelNo (last level = HRD)
                    if (lv.LevelNo > maxLevelNo) {
                        maxLevelNo = lv.LevelNo;
                        hrLevel = lv;
                    }
                }

                // ================================================================
                // POPULATE — Approved By
                // ================================================================
                if (approvedLevel) {
                    // ActionByName = actual approver name from ActionBy column in SP
                    var approvedName = approvedLevel.ActionByName || approvedLevel.ApproverName || '';
                    var approvedDesig = approvedLevel.ApproverType || '';
                    var approvedDate  = approvedLevel.ActionOn
                        ? new Date(approvedLevel.ActionOn).toLocaleDateString('en-GB') : '';

                    // Auto approved case
                    if (approvedLevel.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)') {
                        approvedName  = approvedLevel.ApproverName || '';
                        approvedDate  = approvedLevel.AssignedOn
                            ? new Date(approvedLevel.AssignedOn).toLocaleDateString('en-GB') : '';
                    }

                    $('#approvedBy').text(approvedName);
                    $('#approvedByDesignation').text(approvedDesig);
                    $('#approvedByDate').text(approvedDate);
                }

                // ================================================================
                // POPULATE — Received By (HRD)
                // ================================================================
                if (hrLevel) {
                    var receivedName = hrLevel.ActionByName || hrLevel.ApproverName || '';
                    var receivedDate = hrLevel.ActionOn
                        ? new Date(hrLevel.ActionOn).toLocaleDateString('en-GB') : '';

                    // Auto approved case
                    if (hrLevel.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)') {
                        receivedName = hrLevel.ApproverName || '';
                        receivedDate = hrLevel.AssignedOn
                            ? new Date(hrLevel.AssignedOn).toLocaleDateString('en-GB') : '';
                    }

                    $('#receivedBy').text(receivedName);
                    $('#receivedByDate').text(receivedDate);
                }
            },
            error: function (err) {
                console.error('Approval status load failed:', err);
            }
        });
    }

    // ================================================================
    // EXPORT EXCEL
    // ================================================================
    $('#btnExportExcel').on('click', function () {
        var gridInstance;
        try { gridInstance = $("#GridContainer").dxDataGrid('instance'); } catch (e) { alert('Grid not loaded.'); return; }
        var selectedRows = gridInstance.getSelectedRowsData();
        if (!selectedRows.length) { alert('Please select at least one row.'); return; }

        var wb = new ExcelJS.Workbook();
        var ws = wb.addWorksheet('Manpower');
        var cols = [
            { header: 'Sr. No.', key: 'SerialNo' }, { header: 'Date', key: 'CreatedDate' },
            { header: 'Branch', key: 'BranchName' }, { header: 'Department', key: 'DepartmentName' },
            { header: 'Requirement Type', key: 'RequirementType' }, { header: 'Employee Name', key: 'EmployeeName' },
            { header: 'Personal Email', key: 'PersonalEmail' }, { header: 'Contact No', key: 'ContactNumber' },
            { header: 'Closure By', key: 'ClosureBy' }, { header: 'Designation', key: 'DesignationName' },
            { header: 'Job Category', key: 'CategoryName' }, { header: 'Customer Name', key: 'CustomerName' },
            { header: 'Experience (Yrs)', key: 'ExperienceRange' }, { header: 'Qualification', key: 'EducationalQualification' },
            { header: 'Computer Skills', key: 'ComputerSkills' }, { header: 'Job Responsibility', key: 'JobResponsibility' },
            { header: 'Date of Birth', key: 'DateOfBirth' }, { header: 'Age', key: 'Age' },
            { header: 'Gender', key: 'Gender' }, { header: 'Other Benefits Remark', key: 'OtherBenefits' },
            { header: 'Other Benefits Amount', key: 'Amount' }, { header: 'Reporting To', key: 'ReportingName' },
            { header: 'Date of Joining', key: 'DateOfJoining' }, { header: 'Category of Employment', key: 'CategoryOfEmployment' },
            { header: 'Take Home Salary', key: 'TakeHomeSalary' }, { header: 'System Require', key: 'SystemRequire' },
            { header: 'Email ID Require', key: 'EmailIdRequire' }, { header: 'SIM Require', key: 'Simrequire' },
            { header: 'ERP ID', key: 'ERP_ID' }, { header: 'Number of Position', key: 'NumberOfPosition' },
            { header: 'Status', key: 'Status' }, { header: 'Requested By', key: 'RequestedBy' },
            { header: 'Approved By', key: 'ApprovedBy' }, { header: 'Approved Date', key: 'ApprovedDate' },
            { header: 'Received By (HRD)', key: 'ReceivedBy' }, { header: 'Received By Date', key: 'ReceivedByDate' }
        ];
        ws.columns = cols.map(function (c) { return { header: c.header, key: c.key, width: 22 }; });
        ws.getRow(1).eachCell(function (cell) {
            cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF28A745' } };
            cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
            cell.border = { top: { style: 'thin' }, left: { style: 'thin' }, bottom: { style: 'thin' }, right: { style: 'thin' } };
        });
        ws.getRow(1).height = 30;

        function fd(v) {
            if (!v) return '';
            var d = new Date(v); if (isNaN(d)) return v;
            return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
        }

        selectedRows.forEach(function (d) {
            var row = ws.addRow({
                SerialNo: d.SerialNo || '', CreatedDate: fd(d.CreatedDate), BranchName: d.BranchName || '',
                DepartmentName: d.DepartmentName || '', RequirementType: d.RequirementType || '',
                EmployeeName: d.EmployeeName || '', PersonalEmail: d.PersonalEmail || '',
                ContactNumber: d.ContactNumber || '', ClosureBy: d.ClosureBy || '',
                DesignationName: d.DesignationName || '', CategoryName: d.CategoryName || '',
                CustomerName: d.CustomerName || '', ExperienceRange: d.ExperienceRange || '',
                EducationalQualification: d.EducationalQualification || '', ComputerSkills: d.ComputerSkills || '',
                JobResponsibility: d.JobResponsibility || '', DateOfBirth: fd(d.DateOfBirth),
                Age: d.Age || '', Gender: d.Gender || '', OtherBenefits: d.OtherBenefits || '',
                Amount: d.Amount || '', ReportingName: d.ReportingName || '',
                DateOfJoining: fd(d.DateOfJoining), CategoryOfEmployment: d.CategoryOfEmployment || '',
                TakeHomeSalary: d.TakeHomeSalary || '', SystemRequire: d.SystemRequire || '',
                EmailIdRequire: d.EmailIdRequire || '', Simrequire: d.Simrequire || d.SIMRequire || '',
                ERP_ID: d.ERP_ID || d.ErpId || '', NumberOfPosition: d.NumberOfPosition || '',
                Status: d.Status || '', RequestedBy: d.RequestedBy || '',
                ApprovedBy: d.ApprovedBy || '', ApprovedDate: fd(d.ApprovedDate),
                ReceivedBy: d.ReceivedBy || '', ReceivedByDate: fd(d.ReceivedByDate)
            });
            row.eachCell(function (cell) {
                cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
                cell.border = { top: { style: 'thin' }, left: { style: 'thin' }, bottom: { style: 'thin' }, right: { style: 'thin' } };
            });
            row.height = 20;
        });

        wb.xlsx.writeBuffer().then(function (buf) {
            saveAs(new Blob([buf], { type: 'application/octet-stream' }), 'ManpowerData.xlsx');
        });
    });

    // ================================================================
    // DOWNLOAD PDF
    // ================================================================
    document.getElementById('downloadPDF').addEventListener('click', function () {
        function generatePDF() {
            const { jsPDF } = window.jspdf;
            html2canvas(document.getElementById('pdfContent'), { scale: 2, useCORS: true, allowTaint: false }).then(function (canvas) {
                var imgData = canvas.toDataURL('image/png');
                var pdf = new jsPDF('p', 'mm', 'a4');
                var w = 210, ph = 295, ih = canvas.height * w / canvas.width;
                var pos = 0, left = ih;
                pdf.addImage(imgData, 'PNG', 0, pos, w, ih); left -= ph;
                while (left >= 0) { pos = left - ih; pdf.addPage(); pdf.addImage(imgData, 'PNG', 0, pos, w, ih); left -= ph; }
                pdf.save('Manpower_Requisition_Form.pdf');
            });
        }
        if (!adminLogoBase64) {
            loadAdminLogoAsBase64('@baseAPIDomainUrl/default-image/relaylogo.jpeg', function () { setTimeout(generatePDF, 300); });
        } else { generatePDF(); }
    });
