@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Ticket Status";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}
<style>
    .error-message {
        font-size: 0.875em;
        display: block;
        margin-top: 0.25rem;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .dx-selectbox-arrow {
        display: block !important;
        opacity: 1 !important;
    }

    .responsive-logo {
        max-width: 100%;
        transition: max-width 0.3s ease;
    }

    @@media (min-width: 768px) {
        .responsive-logo {
            max-width: 170%;
        }
    }

    /* ✅ Hide DevExtreme built-in export button from toolbar */
    #GridContainer .dx-toolbar .dx-button.dx-button-default {
        display: none !important;
    }
</style>

<div class="card ">
    <div class="card-header bg-transparent ml-0 py-0">
        <div class="row">
            <div class="col-6">
                <h6 class="pt-2 mb-0">
                    Manpower Details
                </h6>
            </div>

            <div class="col-6 d-flex justify-content-end align-items-center gap-2">
                <!-- ✅ Export to Excel Button - Green, Grid ke Upar -->
                <button id="btnExportExcel"
                        type="button"
                        class="btn rounded-1"
                        style="background-color:#28a745; color:white; border-color:#28a745;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-file-earmark-excel me-1" viewBox="0 0 16 16">
                        <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z" />
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z" />
                    </svg>
                    Export to Excel
                </button>

                <button id="addManpower"
                        type="button"
                        class="btn rounded-1"
                        style="background-color:#2395c6; color:white;">
                    Add Manpower
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="grid-wrapper " style="position: relative; " id="gridTag">
                    <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column "
                         style="display: none;  inset: 0; background: rgba(255,255,255,0.6); z-index: 10; ">
                        <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner" style="width: 30px; height: 30px; animation: spin 1s linear infinite;" />
                        <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                    </div>
                    <div class="row">
                        <div id="rowCount1"></div>
                        <div id="GridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add / Edit Manpower Modal -->
<div class="modal fade" id="addManpowerModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="exampleModalLabel"><span class="formType">Add</span> Manpower Requisition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">

                    <!-- Department -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlDepartment">
                                <option value="">Select</option>
                            </select>
                            <label class="floating-label">Department<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDepartment"></span>
                    </div>

                    <!-- Requirement Type -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlRequirementType">
                                <option selected disabled value="">Select</option>
                                <option>New Position</option>
                                <option>Replacement</option>
                            </select>
                            <label class="floating-label">Requirement Type<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorRequirementType"></span>
                    </div>

                    <!-- Employee Name (as per Aadhaar) -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input id="txtEmployeeName" placeholder="Name as per Aadhaar" />
                            <label class="floating-label">Name of Employee (As per Aadhaar)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorEmployeeName"></span>
                    </div>

                    <!-- Personal Email -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="email" class="form-control floating-input" data-trim-input placeholder="Personal Email Id" id="txtPersonalEmail" />
                            <label class="floating-label">Personal Email Id<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorPersonalEmail"></span>
                    </div>

                    <!-- Contact Number -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-integer-only placeholder="Personal Contact Number" id="txtContactNumber" />
                            <label class="floating-label">Personal Contact Number<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorContactNumber"></span>
                    </div>

                    <!-- Closure By - Dropdown -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlClosureBy">
                                <option selected disabled value="">Select</option>
                                <option>Branch</option>
                                <option>HR</option>
                           @*      <option>Reference</option>
                                <option>Recommendation</option> *@
                            </select>
                            <label class="floating-label">Closure by<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorClosureBy"></span>
                    </div>

                    <!-- Designation -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlDesignation">
                                <option value="">Select</option>
                            </select>
                            <label class="floating-label">Designation<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDesignation"></span>
                    </div>

                    <!-- Experience (Years) - Single value -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtExperienceRange" placeholder="e.g. 3" oninput="this.value=this.value.replace(/[^0-9.]/g,'')" />
                            <label class="floating-label">Experience (Years)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorExperienceRange"></span>
                    </div>

                    <!-- Higher Qualification (was Educational Qualification) -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlEducationalQualification">
                                <option selected disabled value="">Select</option>
                                <option>Post Graduate</option>
                                <option>Graduate</option>
                                <option>Diploma</option>
                                <option>12th Passed</option>
                                <option>10th Passed</option>
                                <option>Below 10th</option>
                            </select>
                            <label class="floating-label">Highest  Qualification<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorEducationalQualification"></span>
                    </div>

                    <!-- Computer Skills -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input id="txtComputerSkills" placeholder="Specific Computer Skills/Technology" />
                            <label class="floating-label">Specific Computer Skills/Technology<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorComputerSkills"></span>
                    </div>

                    <!-- Job Responsibility -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <textarea class="form-control floating-input" id="txtJobResponsibility" placeholder="Job Responsibility (in Brief)"></textarea>
                            <label class="floating-label">Job Responsibility (in Brief)<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorJobResponsibility"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" id="txtDateOfBirth" />
                            <label class="floating-label">Date of Birth<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDateOfBirth"></span>
                    </div>

                    <!-- Age (Auto Calculated - Readonly) -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtAge" placeholder="Age" readonly style="background-color:#e9ecef; cursor:not-allowed;" />
                            <label class="floating-label">Age (Auto Calculated)</label>
                        </div>
                        <span class="text-danger error-message" id="errorAge"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-4">
                        <div class="form-group mt-3">
                            <label><b>Gender<span class="text-danger">*</span>:&nbsp;&nbsp;</b></label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="maleGender" value="Male">
                                <label class="form-check-label" for="maleGender">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="femaleGender" value="Female">
                                <label class="form-check-label" for="femaleGender">Female</label>
                            </div>
                        </div>
                        <span class="text-danger error-message" id="errorGender"></span>
                    </div>

                    <!-- Other Benefits Remark (Optional) -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-trim-input id="txtOtherBenefitsRemark" placeholder="Other Benefits Remark" />
                            <label class="floating-label">Other Benefits Remark</label>
                        </div>
                    </div>

                    <!-- Other Benefits Amount (Optional, Numbers Only) -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtOtherBenefitsAmount" placeholder="Other Benefits Amount" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <label class="floating-label">Other Benefits Amount</label>
                        </div>
                    </div>

                    <!-- Row: Checkboxes - System, Email, SIM, ERP ID -->
                    <div class="col-12 mt-3">
                        <div class="d-flex flex-wrap gap-4 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSystemRequire">
                                <label class="form-check-label" for="chkSystemRequire">System Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkEmailIdRequire">
                                <label class="form-check-label" for="chkEmailIdRequire">Email Id Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSIMRequire">
                                <label class="form-check-label" for="chkSIMRequire">SIM Require</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkErpId">
                                <label class="form-check-label" for="chkErpId">ERP ID</label>
                            </div>
                        </div>
                    </div>

                    <!-- Number of Position - Mandatory -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" id="txtNumberPosition" placeholder="Number of Position" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <label class="floating-label">Number of Position<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorNumberPosition"></span>
                    </div>

                    <!-- Job Category - Simple Select Dropdown -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlJobCategory">
                                <option selected disabled value="">Select</option>
                            </select>
                            <label class="floating-label">Job Category<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorJobCategory"></span>
                    </div>

                    <!-- Reporting To -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlReportingTo">
                                <option selected value="">Select</option>
                            </select>
                            <label class="floating-label">Reporting To<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorReportingTo"></span>
                    </div>

                    <!-- Date of Joining -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" id="txtDateOfJoining" />
                            <label class="floating-label">Date of Joining<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorDateOfJoining"></span>
                    </div>

                    <!-- Category of Employment -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select class="form-select floating-input" id="ddlCategoryOfEmployment">
                                <option value="">Select</option>
                                <option>On Roll</option>
                                <option>Off Roll</option>
                            </select>
                            <label class="floating-label">Category of Employment<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorCategoryOfEmployment"></span>
                    </div>

                    <!-- Take Home Salary -->
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" data-decimal id="txtTakeHomeSalary" placeholder="Take Home Salary" />
                            <label class="floating-label">Take Home Salary<span class="text-danger">*</span></label>
                        </div>
                        <span class="text-danger error-message" id="errorTakeHomeSalary"></span>
                    </div>

                </div>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-primary" id="btnSubmitManpower" style="background-color:#2395c6; color:white;">Save</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- View Manpower Details Modal -->
