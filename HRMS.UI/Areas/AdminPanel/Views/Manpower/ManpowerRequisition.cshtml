    // ================================================================
    // LOAD DROPDOWNS (Designation, Department, Reporting)
    // ================================================================
    async function loadDropDownForManpower() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/ManpowerRequisitionAPI/GetDropDownForManpower/' + CompanyId,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        bindDesignation(response.data.designations);
                        bindDepartment(response.data.departments);
                        // ✅ Reporting To searchable
                        var reportingData = (response.data.reportingEmployees || []).map(function (e) {
                            return { id: e.employeeId, name: e.fullName + ' - ' + e.employeeCode };
                        });
                        buildSearchableSelect('Reporting', reportingData, 'id', 'name', null);
                        resolve();
                    } else {
                        round_error_noti(response.responseMessage);
                        reject();
                    }
                },
                error: function (err) { reject(err); }
            });
        });
    }

    function bindDepartment(data) {
