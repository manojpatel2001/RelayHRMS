    // ================================================================
    window._deleteManpower = function (id, name) {
        wmsConfirm('Are you sure you want to delete the requisition for <strong>"' + (name || 'this employee') + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                type: 'DELETE',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: EmployeeId }),
                success: function (res) {
                    showToast(res.isSuccess ? (res.responseMessage || 'Deleted successfully.') : (res.responseMessage || 'Something went wrong.'), res.isSuccess ? 'success' : 'error');
                    if (res.isSuccess) loadManpowerData();
                },
                error: function () { showToast('Something went wrong. Please try again.', 'error'); }
            });
        });
    };

