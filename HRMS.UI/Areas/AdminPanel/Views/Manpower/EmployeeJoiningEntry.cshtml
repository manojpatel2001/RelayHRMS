    $("#btnEmployeeInfo").click(async () => {
        $(".btn-save").prop("disabled", true);
        let isValid = true;
        $('.error-message').hide();

        const referenceNo = ($('#referenceNo').data('searchableSelect') && $('#referenceNo').data('searchableSelect').getValue())
            || _updateManpowerRequisitionId;

        if (!referenceNo) {
            $('#errorReference').show();
            round_error_noti("Please select reference no");
            isValid = false;
        }
        if (!isValid) {
            $(".btn-save").prop("disabled", false);
            return;
        }
        const formData = await getFormData();
        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/UpdateJoinningDetails',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(formData),
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    employeeJoiningDataTable();
                    loadManpowerDetails(referenceNo);
                } else {
                    round_error_noti(response.responseMessage);
                }
                $(".btn-save").prop("disabled", false);
            },
            error: function (xhr, status, error) {
                $(".btn-save").prop("disabled", false);
                round_error_noti('Error saving data: ' + error);
            }
        });
    });

