    // Load Reference - autoSelectId support ke sath
    function loadRefrence(autoSelectId) {
        return new Promise((resolve, reject) => {
            $.ajax({
                type: 'POST',
                url: '@baseUrl/ManpowerRequisitionAPI/GetAllSerialNo',
                data: JSON.stringify({ CompanyId: CompanyId, EmployeeId: EmployeeId }),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        // autoSelectId pass karo bindSerial mein
                        bindSerial(response.data, autoSelectId || null);
                        resolve(response.data);
                    } else {
                        reject();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    reject(error);
                }
            });
        });
    }

        function updateEmployeeJoining(data) {
        resetAllForms();

        _updateManpowerRequisitionId = data.ManpowerRequisitionId;

        $(".formType").text("Update");
        $("#btnEmployeeInfo").text("Update");
        $("#btnJoiningDetails").text("Update");
        $("#btnSalary").text("Update");

        $("#employeeJoiningModal").modal('show');

        // Step 1: Seedha API se data lo
        $.ajax({
            type: 'GET',
            url: '@baseUrl/ManpowerRequisitionAPI/GetManpowerRequisitionByManpowerRequisitionId/' + data.ManpowerRequisitionId,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    var apiData = response.data;

                    // Step 2: Reference field mein SerialNo directly set karo
                    $('#referenceNo').val(apiData.SerialNo || data.SerialNo || '');

                    // Step 3: Sabhi form fields fill karo
                    $('#operationType').val(apiData.OperationType || '');
                    $('#employeeName').val(apiData.EmployeeName || '');
                    $('#employeeEmail').val(apiData.PersonalEmail || '');
                    $('#presentAddress').val(apiData.PresentAddress || '');
                    $('#permanentAddress').val(apiData.PermanentAddress || '');
                    $('#lastEducation').val(apiData.EducationalQualification || '');
                    $('#maritalStatus').val(apiData.MaritalStatus || '');

                    if (apiData.DateOfBirth) {
                        $('#dateOfBirth').val(new Date(apiData.DateOfBirth).toISOString().split('T')[0]);
                    }

                    $('#totalExperience').val(apiData.ExperienceRange || '');
                    $('#mobileNo').val(apiData.ContactNumber || '');
                    $('#bloodGroup').val(apiData.BloodGroup || '');
                    $('#branchName').val(apiData.BranchName || '');
                    $('#reportingTo').val(apiData.ReportingName || '');
                    $('#department').val(apiData.DepartmentName || '');
                    $('#designation').val(apiData.DesignationName || '');

                    if (apiData.DateOfJoining) {
                        $('#dateOfJoining').val(new Date(apiData.DateOfJoining).toISOString().split('T')[0]);
                    }

                    $('#interviewedBy').val(apiData.InterviewedBy || '');

                    if (apiData.InterviewDate) {
                        $('#interviewDate').val(new Date(apiData.InterviewDate).toISOString().split('T')[0]);
                    }

                    $('#interviewPlace').val(apiData.InterviewPlace || '');
                    $('#clientName').val(apiData.ClientName || '');
                    $('#erpCode').val(apiData.ErpCode || '');
                    $('#previousCompanyUAN').val(apiData.PreviousCompanyUAN || '');
                    $('#previousCompanyESIC').val(apiData.PreviousCompanyESIC || '');
                    $('#grossSalary').val(apiData.GrossSalary || '');
                    $('#netSalary').val(apiData.TakeHomeSalary || '');
                    $('#esicNo').val(apiData.EsicNo || '');
                    $('#pfUAN').val(apiData.PFUAN || '');
                    $('#pan').val(apiData.Pan || '');
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading data:", error);
                round_error_noti("Data load karne mein error aaya");
            }
        });

        // Step 4: Dropdowns aur grids load karo
        Promise.all([
            loadRefrence(data.ManpowerRequisitionId),
            loadDocumentType(),
            loadBindRelationShiptOption()
        ]).then(function () {
            setTimeout(function () {
                ManpowerRelationDataTable();
                ManpowerDocumentDataTable();
            }, 500);
        });
    }

