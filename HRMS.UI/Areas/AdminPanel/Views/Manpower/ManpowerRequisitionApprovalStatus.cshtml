@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Manpower Requisition Approval Status";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<style>
    /* ── Expand Panel ── */
    .expand-panel {
        background: #F0F5F8;
        border-left: 4px solid #2F6F8E;
        padding: 16px 20px;
        margin-top: 14px;
        border-radius: 0 var(--r-md) var(--r-md) 0;
        display: none;
        width: 100%;
    }

        .expand-panel.open {
            display: block;
        }

    .panel-cols {
        display: flex;
        gap: 28px;
        flex-wrap: wrap;
    }

    .panel-col {
        flex: 1;
        min-width: 280px;
    }

    .col-heading {
        font-size: 11px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .7px;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #e0e0e0;
    }

    /* Timeline */
    .level-timeline {
        display: flex;
        flex-direction: column;
    }

    .level-item {
        display: grid;
        grid-template-columns: 32px 1fr auto;
        gap: 0 12px;
        position: relative;
    }

        .level-item:not(:last-child) .lv-line::after {
            content: '';
            position: absolute;
            left: 15px;
            top: 32px;
            width: 2px;
            height: calc(100% - 8px);
            background: #e0e0e0;
        }

    .lv-line {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .lv-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        border: 2px solid #ccc;
        background: #f3f4f6;
        position: relative;
        z-index: 1;
        flex-shrink: 0;
    }

        .lv-icon.approved {
            border-color: #2E7D32;
            background: #E8F5E9;
            color: #2E7D32;
        }

        .lv-icon.pending {
            border-color: #E65100;
            background: #FFF3E0;
            color: #E65100;
            animation: pls 1.4s infinite;
        }

        .lv-icon.auto {
            border-color: #2F6F8E;
            background: #E3F2FD;
            color: #1565C0;
        }

        .lv-icon.notyet {
            border-color: #B8C4CC;
            background: #F0F2F4;
            color: #778899;
        }

    @@keyframes pls {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(230,81,0,.4);
        }

        50% {
            box-shadow: 0 0 0 5px rgba(230,81,0,0);
        }
    }

    .lv-content {
        padding: 5px 0 18px;
    }

    .lv-top {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 3px;
    }

    .lv-num {
        font-size: 10px;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
    }

    .lv-type {
        font-size: 12px;
        font-weight: 600;
        color: #235A75;
    }

    .lv-active {
        font-size: 9px;
        font-weight: 700;
        background: #FFF3E0;
        color: #E65100;
        border: 1px solid #FFCC80;
        padding: 1px 6px;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .lv-overdue {
        font-size: 9px;
        font-weight: 700;
        background: #FFEBEE;
        color: #C62828;
        border: 1px solid #EF9A9A;
        padding: 1px 6px;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .lv-sub {
        font-size: 11px;
        color: #6b7280;
        margin-bottom: 2px;
    }

        .lv-sub span {
            color: #374151;
            font-weight: 500;
        }

    .lv-status-col {
        padding: 5px 0 18px;
    }

    /* Status pills reuse the shared WMSGrid palette (wg-pill-*), injected
       globally the first time WMSGrid.create() runs on this page -- this is
       what keeps these badges visually identical to every other grid. */

    /* History table */
    .hist-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .hist-table th {
            background: var(--wg-hdr-bg, #EBF0F4);
            padding: 6px 8px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            color: #3B5068;
            text-transform: uppercase;
            letter-spacing: .4px;
            border-bottom: 2px solid var(--wg-border2, #C9D4DC);
        }

        .hist-table td {
            padding: 7px 8px;
            border-bottom: 1px solid #D8E2E8;
            color: #374151;
            vertical-align: top;
        }

        .hist-table tr:last-child td {
            border-bottom: none;
        }

        .hist-table tr:hover td {
            background: var(--wg-row-hover, #EAF2F8);
        }

    .admin-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 999px;
        background: #E3F2FD;
        border: 1px solid #90CAF9;
        color: #1565C0;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .remark-cell {
        color: #6b7280;
        max-width: 250px;
        line-height: 1.5;
        white-space: normal;
        word-break: break-word;
    }

    /* Expand header */
    .expand-head {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e0e0e0;
    }

        .expand-head strong {
            font-size: 13px;
            color: #235A75;
        }

    .expand-meta {
        font-size: 12px;
        color: #888;
    }
</style>

<div class="wms-form-page">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Manpower Requisition — Approval Status</h6>
            <button id="btnExportExcel" type="button" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-download"></i> Export to Excel
            </button>
        </div>
        <div class="card-body">
            <div id="manpowerGridContainer"></div>

            <!-- Expand Panel -->
            <div id="expandPanel" class="expand-panel">
                <div id="expandContent"></div>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Globals ──────────────────────────────────────────────────────────────
    const savedCompany   = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany);
    const CompanyId      = companyDetails.CompanyId;
    const Token          = localStorage.getItem("authToken");
    const ApprovalMasterId = 3;

    var allData       = [];
    var expandedReqId = null;
    var _manpowerApprovalCache = {};

    function fmtReqDate(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
    }

    // ── Grid — standard HRMS WMSGrid, no pagination, full-dataset scroll ──────
    var manpowerApprovalGrid = WMSGrid.create({
        container: 'manpowerGridContainer',
        title: 'Manpower Requisition Approvals',
        icon: 'bx-list-check',
        columns: [
            { field: 'manpowerRequisitionId', header: 'Req ID', width: '90px', align: 'center' },
            { field: 'employeeName', header: 'Employee Name', width: '170px' },
            { field: 'requirementType', header: 'Req Type', width: '130px' },
            { field: 'numberOfPosition', header: 'Positions', width: '90px', align: 'center' },
            { field: 'closureBy', header: 'Closure By', width: '110px' },
            { field: 'requisitionDate', header: 'Req Date', width: '120px', render: function (v) { return fmtReqDate(v); } },
            {
                field: 'requisitionStatus', header: 'Status', width: '110px',
                render: function (v) { return v ? '<span class="wg-pill wg-pill-pu">' + v + '</span>' : '—'; }
            },
            {
                field: 'overallApprovalStatus', header: 'Approval Status', width: '170px',
                render: function (v, row) {
                    var status = v || '';
                    var lvNo = row.currentLevelNo || '';
                    if (row.isAutoApprovedByAdminHR) {
                        return '<span class="wg-pill wg-pill-blue">Auto Approved</span>';
                    } else if (status === 'Approved') {
                        return '<span class="wg-pill wg-pill-green">Approved</span>';
                    } else if (status === 'Pending') {
                        return '<span class="wg-pill wg-pill-amber">Pending (L' + lvNo + ')</span>';
                    }
                    return status ? '<span class="wg-pill wg-pill-pu">' + status + '</span>' : '—';
                }
            },
            {
                header: 'Details', sortable: false, width: '100px', align: 'center',
                render: function (v, row) {
                    var isOpen = expandedReqId === row.manpowerRequisitionId;
                    return '<button class="wg-btn ' + (isOpen ? 'wg-btn-primary' : 'wg-btn-outline') + '" onclick="_toggleManpowerApprovalView(' + row.manpowerRequisitionId + ')">' + (isOpen ? 'Close' : 'View') + '</button>';
                }
            }
        ],
        perPage: 100000,
        features: { pagination: false, perPage: false, paginationInfo: false, export: false }
    });

    // ── On Load ──────────────────────────────────────────────────────────────
    $(document).ready(function () {
        PermGuard.onReady(function () { loadData(); });
        PermGuard.applyActions('manpower-manpowerrequisitionapprovalstatus', { export: '#btnExportExcel' });
    });

    // ── Fetch ────────────────────────────────────────────────────────────────
    function loadData() {
        manpowerApprovalGrid.showLoader();
        $.ajax({
            url: '@baseDomainUrl/api/ManpowerRequisitionAPI/GetManpowerRequisitionApprovalStatus',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({
                approvalMasterId:      ApprovalMasterId,
                manpowerRequisitionId: null,
                companyId:             CompanyId
            }),
            success: function (res) {
                manpowerApprovalGrid.hideLoader();
                if (res.isSuccess && res.data && res.data.length > 0) {
                    allData = res.data;
                    _manpowerApprovalCache = {};
                    allData.forEach(function (r) { _manpowerApprovalCache[r.manpowerRequisitionId] = r; });
                    manpowerApprovalGrid.setData(allData);
                } else {
                    manpowerApprovalGrid.setData([]);
                    showToast(res.responseMessage || "No records found.", 'info');
                }
            },
            error: function () {
                manpowerApprovalGrid.hideLoader();
                showToast("Failed to load data.", 'error');
            }
        });
    }

    // ── Toggle Expand ────────────────────────────────────────────────────────
    window._toggleManpowerApprovalView = function (reqId) {
        var rowData = _manpowerApprovalCache[reqId];
        if (!rowData) return;

        if (expandedReqId === reqId) {
            $('#expandPanel').removeClass('open');
            expandedReqId = null;
            manpowerApprovalGrid.refresh();
            return;
        }

        expandedReqId = reqId;
        manpowerApprovalGrid.refresh();

        buildExpandPanel(rowData);
        $('#expandPanel').addClass('open');

        setTimeout(function() {
            document.getElementById('expandPanel')
                .scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 150);
    };

    // ── Build Expand Panel ───────────────────────────────────────────────────
    function buildExpandPanel(d) {
        // ✅ ALL camelCase — matches API response exactly
        var isAdmin = d.isAutoApprovedByAdminHR;
        var levels  = d.levels  || [];   // ✅ camelCase
        var history = d.history || [];   // ✅ camelCase

        // Header
        var hdr = `
            <div class="expand-head">
                <strong>ReqId: ${d.manpowerRequisitionId} — ${d.employeeName || ''}</strong>
                ${isAdmin ? '<span class="admin-tag">⚡ Admin · ClosureBy HR · All Levels Auto Approved</span>' : ''}
                <span class="expand-meta">
                    Approval ID: #${d.approvalRequestId || 'N/A'}
                    &nbsp;|&nbsp; Requester: ${d.requesterName || '—'}
                    &nbsp;|&nbsp; Current Level: <strong>${d.currentLevelNo || '—'}</strong>
                </span>
            </div>`;

        // ── Levels ──
        var lvHtml = '<div class="level-timeline">';
        if (!levels.length) {
            lvHtml += '<p style="color:#aaa;font-size:12px;margin:0">No levels found.</p>';
        }

        levels.forEach(function(lv) {
            // ✅ camelCase: lv.levelStatus, lv.levelNo, lv.approverType etc.
            var st      = lv.levelStatus || '';
            var isAuto  = st.indexOf('Auto') !== -1;
            var iconCls, bCls, bTxt, icon;

            if (isAuto) {
                iconCls='auto';     bCls='wg-pill-blue';
                bTxt='Auto Approved (Admin - ClosureBy HR)'; icon='⚡';
            } else if (st === 'Approved') {
                iconCls='approved'; bCls='wg-pill-green';
                bTxt='Approved'; icon='✓';
            } else if (st === 'Pending') {
                iconCls='pending';
                bCls = lv.isOverdue ? 'wg-pill-red' : 'wg-pill-amber';  // ✅ camelCase
                bTxt = lv.isOverdue ? 'Pending (Overdue)' : 'Pending';
                icon = '⏳';
            } else {
                iconCls='notyet';   bCls='wg-pill-pu';
                bTxt='Not Yet Reached'; icon='○';
            }

            // ✅ camelCase: lv.assignedOn, lv.actionOn, lv.escalationDueOn, lv.actionRemarks, lv.daysPendingAtLevel
            var dateInfo = '';
            if (lv.actionOn) {
                dateInfo = `<div class="lv-sub">
                    Remarks: <span>${lv.actionRemarks || '—'}</span>
                    &nbsp;|&nbsp; On: <span>${fmtDate(lv.actionOn)}</span>
                </div>`;
            } else if (lv.assignedOn) {
                dateInfo = `<div class="lv-sub">
                    Assigned: <span>${fmtDate(lv.assignedOn)}</span>
                    &nbsp;|&nbsp; Due: <span>${fmtDate(lv.escalationDueOn)}</span>
                    ${lv.daysPendingAtLevel != null
                        ? `&nbsp;|&nbsp; Days Pending: <span style="color:#b45309;font-weight:700">${lv.daysPendingAtLevel}</span>`
                        : ''}
                </div>`;
            } else {
                dateInfo = '<div class="lv-sub" style="font-style:italic;color:#aaa">Waiting for previous level</div>';
            }

            lvHtml += `
                <div class="level-item">
                    <div class="lv-line">
                        <div class="lv-icon ${iconCls}">${icon}</div>
                    </div>
                    <div class="lv-content">
                        <div class="lv-top">
                            <span class="lv-num">Level ${lv.levelNo}</span>
                            <span class="lv-type">${lv.approverType || ''}</span>
                            ${lv.isCurrentActiveLevel ? '<span class="lv-active">● Active</span>' : ''}
                            ${lv.isOverdue            ? '<span class="lv-overdue">⚠ Overdue</span>' : ''}
                        </div>
                        <div class="lv-sub">Approver: <span>${lv.approverName || 'Not assigned'}</span></div>
                        ${dateInfo}
                    </div>
                    <div class="lv-status-col">
                        <span class="wg-pill ${bCls}">${bTxt}</span>
                    </div>
                </div>`;
        });
        lvHtml += '</div>';

        // ── History ──
        var histHtml = `
            <table class="hist-table">
                <thead>
                    <tr><th>#</th><th>Action</th><th>By</th><th>Remarks</th><th>Status</th><th>Date</th></tr>
                </thead>
                <tbody>`;

        if (!history.length) {
            histHtml += '<tr><td colspan="6" style="text-align:center;color:#aaa;padding:14px">No history found.</td></tr>';
        }

        history.forEach(function(h, i) {
            // ✅ camelCase: h.actionType, h.actionByName, h.remarks, h.newStatus, h.actionDate
            var at = (h.actionType || '').toLowerCase();
            var chipCls = 'wg-pill-blue';
            if (at === 'approved')     chipCls = 'wg-pill-green';
            if (at === 'autoapproved') chipCls = 'wg-pill-blue';
            if (at === 'assigned')     chipCls = 'wg-pill-amber';
            if (at === 'rejected')     chipCls = 'wg-pill-red';

            var ns = h.newStatus || '';
            var sBadge = ns === 'Approved'
                ? '<span class="wg-pill wg-pill-green" style="font-size:10px;padding:2px 8px">Approved</span>'
                : ns === 'Pending'
                    ? '<span class="wg-pill wg-pill-amber" style="font-size:10px;padding:2px 8px">Pending</span>'
                    : `<span style="font-size:11px">${ns}</span>`;

            histHtml += `
                <tr>
                    <td style="color:#aaa;width:28px">${i+1}</td>
                    <td><span class="wg-pill ${chipCls}">${h.actionType || ''}</span></td>
                    <td style="white-space:nowrap">${h.actionByName || ''}</td>
                    <td class="remark-cell">${h.remarks || ''}</td>
                    <td>${sBadge}</td>
                    <td style="white-space:nowrap;color:#9ca3af">${fmtDate(h.actionDate)}</td>
                </tr>`;
        });
        histHtml += '</tbody></table>';

        // ── Render ──
        $('#expandContent').html(`
            ${hdr}
            <div class="panel-cols">
                <div class="panel-col">
                    <div class="col-heading">Level-wise Approval</div>
                    ${lvHtml}
                </div>
                <div class="panel-col">
                    <div class="col-heading">Approval History</div>
                    ${histHtml}
                </div>
            </div>`);
    }

    // ── Export Excel ─────────────────────────────────────────────────────────
    $('#btnExportExcel').on('click', function() {
        if (!allData.length) { showToast("No data to export.", 'error'); return; }

        var rows = allData.map(function(r) {
            return {
                "Req ID":           r.manpowerRequisitionId,
                "Employee Name":    r.employeeName           || '',
                "Req Type":         r.requirementType        || '',
                "Positions":        r.numberOfPosition       || '',
                "Closure By":       r.closureBy              || '',
                "Req Date":         r.requisitionDate
                                        ? new Date(r.requisitionDate).toLocaleDateString('en-IN') : '',
                "Status":           r.requisitionStatus      || '',
                "Approval Status":  r.isAutoApprovedByAdminHR
                                        ? 'Auto Approved (Admin-HR)'
                                        : (r.overallApprovalStatus || ''),
                "Current Level":    r.currentLevelNo         || '',
                "Requester":        r.requesterName          || '',
                "Current Approver": r.currentApproverName    || ''
            };
        });

        var ws = XLSX.utils.json_to_sheet(rows);
        ws['!cols'] = Object.keys(rows[0]).map(function(k) {
            return { wch: Math.max(...rows.map(r => String(r[k]??'').length), k.length) + 2 };
        });
        var wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Manpower Approval");
        XLSX.writeFile(wb, "ManpowerRequisitionApproval.xlsx");
    });

    // ── Date Helper ──────────────────────────────────────────────────────────
    function fmtDate(d) {
        if (!d) return '—';
        try {
            return new Date(d).toLocaleDateString('en-IN',
                { day:'2-digit', month:'short', year:'numeric' });
        } catch(e) { return d; }
    }
</script>
