@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Employee Master";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
	string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
}

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Employee Master</h6>
		<button id="addEmployee" type="button" class="btn btn-primary btn-sm">Add Employee</button>
	</div>
	<div class="card-body">
		<div class="mb-3">
			<div class="btn-group btn-group-sm" role="group">
				<input type="radio" class="btn-check" name="employeeFilter" id="rdCurrentEmployee" value="CurrentEmployee" autocomplete="off" checked>
				<label class="btn btn-outline-primary" for="rdCurrentEmployee">Current Employee</label>
				<input type="radio" class="btn-check" name="employeeFilter" id="rdAllEmployee" value="AllEmployee" autocomplete="off">
				<label class="btn btn-outline-primary" for="rdAllEmployee">All Employee</label>
				<input type="radio" class="btn-check" name="employeeFilter" id="rdLeftEmployee" value="LeftEmployee" autocomplete="off">
				<label class="btn btn-outline-primary" for="rdLeftEmployee">Left Employee</label>
			</div>
		</div>
		<div id="employeeGrid"></div>
	</div>
</div>

