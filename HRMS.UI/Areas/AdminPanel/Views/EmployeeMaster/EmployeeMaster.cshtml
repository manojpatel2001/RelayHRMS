<script>
(function () {
	'use strict';

	var Token         = localStorage.getItem('authToken');
	var companyDetails = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
	var CompanyId     = companyDetails.CompanyId;
	var EmployeeId    = localStorage.getItem('EmployeeId');

	// export-data.js's openExportModal()/loadEmployeeMasterData() read a
	// bare global CompanyId — expose it since this page's own CompanyId is
	// scoped inside this IIFE.
	window.CompanyId = CompanyId;

	var grid = WMSGrid.create({
		container: 'employeeGrid',
		title: 'Employee Master',
		icon: 'bx-group',
		perPage: 10,
		columns: [
			{ field: 'alfaEmployeeCode', header: 'Emp Code',     width: '120px' },
			{ field: 'fullName',         header: 'Full Name',    width: '200px' },
			{ field: 'branchName',       header: 'Branch',       width: '130px' },
			{ field: 'gradeName',        header: 'Grade',        width: '100px' },
			{ field: 'departmentName',   header: 'Department',   width: '150px' },
			{ field: 'designationName',  header: 'Designation',  width: '150px' },
			{ field: 'dateOfJoining',    header: 'Joining Date', width: '120px',
				render: function (v) { return v ? new Date(v).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'; }
			},
			{ field: 'loginAlias',  header: 'Login Alias', width: '140px' },
			{ field: 'isLeft',      header: 'Status',      width: '90px',
				render: function (v) { return v === 'Yes' ? '<span class="wg-pill wg-pill-red">Left</span>' : '<span class="wg-pill wg-pill-green">Active</span>'; }
			},
			{ field: 'leftDate',    header: 'Left Date',   width: '110px',
				render: function (v) { return v ? new Date(v).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'; }
			},
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '120px',
				render: function (v, row) {
					return '<button class="wg-btn wg-btn-primary" title="Edit" onclick="_editEmployee(' + row.id + ')"><i class="bx bx-edit"></i></button> ' +
					       '<button class="wg-btn wg-btn-outline" title="View History" onclick="_viewEmployeeHistory(' + row.id + ')"><i class="bx bx-history"></i></button> ' +
					       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteEmployee(' + row.id + ',\'' + (row.fullName || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
				}
			}
		],
		features: { export: true }
	});

	function loadTable(url) {
		grid.showLoader();
		$.ajax({
			type: 'GET',
			url: url + '?companyId=' + CompanyId,
			_silentLoader: true,
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) showToast('No records found.', 'info');
			},
			error: function () {
				grid.hideLoader();
				showToast('Failed to load employees.', 'error');
			}
		});
	}

	$('input[name="employeeFilter"]').on('change', function () {
		var val = $(this).val();
		if (val === 'AllEmployee') {
			loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployee');
		} else if (val === 'LeftEmployee') {
			loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployeeActiveOrLeft/true');
		} else {
			loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployeeActiveOrLeft/false');
		}
	});

	window._editEmployee = function (id) {
		localStorage.removeItem('CurrentEmployeeId');
		localStorage.setItem('CurrentEmployeeId', id);
		window.location.href = '@UIBaseUrlLayout/AdminPanel/EmployeeMaster/AdditionalInformation';
	};

	window._viewEmployeeHistory = function (id) {
		localStorage.removeItem('CurrentEmployeeId');
		localStorage.setItem('CurrentEmployeeId', id);
		window.location.href = '@UIBaseUrlLayout/AdminPanel/EmployeeMaster/EmployeeHistory';
	};

	window._deleteEmployee = function (id, name) {
		wmsConfirm('Are you sure you want to delete <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/EmployeeMasterAPI/DeleteEmployee',
				type: 'DELETE',
				contentType: 'application/json',
				_silentLoader: true,
				data: JSON.stringify({ Id: id, deletedBy: EmployeeId }),
				success: function (response) {
					showToast(response.isSuccess ? (response.responseMessage || 'Deleted successfully.') : (response.responseMessage || 'Something went wrong.'), response.isSuccess ? 'success' : 'error');
					if (response.isSuccess) loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployeeActiveOrLeft/false');
				},
				error: function () { showToast('Error deleting employee.', 'error'); }
			});
		});
	};

	function probationChange() {
		var selectedValue = $('#ddlEmpType').val();
		if (selectedValue === '2') {
			$('#probation').prop('checked', true);
		} else {
			$('#probation').prop('checked', false);
		}
	}

	window.openAddEmployeeModal  = function () { document.getElementById('addEmployeeModal').classList.add('open'); };
	window.closeAddEmployeeModal = function () { document.getElementById('addEmployeeModal').classList.remove('open'); resetEmployeeMasterField(); };

	$('#ddlEmpType').on('change', function () { probationChange(); });
	$('#ddlBranch').on('change', function () { LoadWeekOffMaster(); });

	$('#addEmployee').on('click', function () {
		resetEmployeeMasterField();
		$('#pt').prop('checked', true);
		$('#isPFApplicable').prop('checked', true);
		$('#gtl').prop('checked', true);
		$('#gmp').prop('checked', false);
		$('#btnCreateEmployee').prop('disabled', false);
		openAddEmployeeModal();
	});

	$('#closeBtnSalary').on('click', function () { document.getElementById('SalaryAllowanceModal').classList.remove('open'); });

	$('#txtAttendanceLimit').on('input', function () {
		var value = parseInt(this.value);
		if (value > 31) { this.value = 31; } else if (value < 0) { this.value = 0; }
	});

	$('#txtLoginAlias').on('input', function () {
		var inputVal = $(this).val();
		var domain   = $('#txtDomainName').text().trim();
		if (inputVal.includes('@@')) {
			showToast('The domain "' + domain + '" is already added.', 'warning');
			$(this).val(inputVal.replace('@@', ''));
		}
	});

	$('#togglePassword').on('click', function () {
		var pw = $('#txtPassword');
		pw.attr('type', pw.attr('type') === 'password' ? 'text' : 'password');
		$(this).toggleClass('bx-show bx-hide');
	});

	$('#txtNumberEmpCode').on('blur', async function () { await GetExistEmployeeCode(); });

	$('#txtGrossSalary, #txtBasicSalary').on('blur', async function () {
		await GetGradeBySalaryRange();
		await loadSalaryAllowance();
	});

	$(document).on('click', '.allowanceIcon', async function () {
		var grossSalary = $('#txtGrossSalary').val();
		if (!grossSalary) { showToast('Please enter gross salary', 'warning'); return; }
		await GetGradeBySalaryRange();
		await loadSalaryAllowance();
		document.getElementById('SalaryAllowanceModal').classList.add('open');
	});

	$('#btnCreateEmployee').on('click', async function () {
		var grossSalaryCheck = $('#txtGrossSalary').val().trim();
		if (grossSalaryCheck) await GetGradeBySalaryRange();

		var initial            = $('#ddlInitial').val();
		var firstName          = $('#txtFirstName').val().trim();
		var middleName         = $('#txtMiddleName').val().trim();
		var lastName           = $('#txtLastName').val().trim();
		var employeeStringCode = $('#txtEmpCode').val();
		var employeeNumberCode = $('#txtNumberEmpCode').val();
		var dateOfJoining      = $('#doj').val();
		var branch             = $('#ddlBranch').val();
		var grade              = $('#ddlGrade').val();
		var shift              = $('#ddlShift').val();
		var designation        = $('#ddlDesignation').val();
		var grossSalary        = $('#txtGrossSalary').val().trim();
		var category           = $('#ddlCategory').val();
		var basicSalary        = $('#txtBasicSalary').val();
		var department         = $('#ddlDepartment').val();
		var employeeType       = $('#ddlEmpType').val();
		var dateOfBirth        = $('#dob').val();
		var RoleId             = $('#ddlRole').val();
		var loginAlias         = $('#txtLoginAlias').val().trim();
		var password           = $('#txtPassword').val().trim();
		var domainName         = $('#txtDomainName').text().trim();
		var weekOfAssignId     = $('#ddlWeekOfAssign').val();
		var attendanceLimit    = $('#txtAttendanceLimit').val().trim();
		var remark             = $('#txtRemark').val().trim();
		var pt                 = $('#pt').is(':checked');
		var checkInOut         = $('#checkInOut').is(':checked');
		var reportingManager   = $('#drpReporting').val();
		var isPFApplicable     = $('#isPFApplicable').is(':checked');
		var probation          = $('#probation').is(':checked');
		var gtl                = $('#gtl').is(':checked');
		var gmp                = $('#gmp').is(':checked');
		var patternPassword    = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;

		var isValid = true;
		if (!initial)            { $('#spnInitial').show();          isValid = false; } else { $('#spnInitial').hide(); }
		if (!firstName)          { $('#spnFirstName').show();        isValid = false; } else { $('#spnFirstName').hide(); }
		if (!employeeNumberCode) { $('#spnNumberCode').show();       isValid = false; } else { $('#spnNumberCode').hide(); }
		if (!dateOfJoining)      { $('#spnDoj').show();              isValid = false; } else { $('#spnDoj').hide(); }
		if (!branch)             { $('#spnBranch').show();           isValid = false; } else { $('#spnBranch').hide(); }
		if (!grade)              { $('#spnGrade').show();            isValid = false; } else { $('#spnGrade').hide(); }
		if (!shift)              { $('#spnShift').show();            isValid = false; } else { $('#spnShift').hide(); }
		if (!designation)        { $('#spnDesignation').show();      isValid = false; } else { $('#spnDesignation').hide(); }
		if (!grossSalary)        { $('#spnGrossSalary').show();      isValid = false; } else { $('#spnGrossSalary').hide(); }
		if (!basicSalary)        { $('#spnBasicSalary').show();      isValid = false; } else { $('#spnBasicSalary').hide(); }
		if (!category)           { $('#spnCategory').show();         isValid = false; } else { $('#spnCategory').hide(); }
		if (!department)         { $('#spnDepartment').show();       isValid = false; } else { $('#spnDepartment').hide(); }
		if (!employeeType)       { $('#spnEmployeeType').show();     isValid = false; } else { $('#spnEmployeeType').hide(); }
		if (!dateOfBirth)        { $('#spnBirth').show();            isValid = false; } else { $('#spnBirth').hide(); }
		if (!RoleId)             { $('#spnRole').show();             isValid = false; } else { $('#spnRole').hide(); }
		if (!loginAlias)         { $('#spnLoginAlias').show();       isValid = false; } else { $('#spnLoginAlias').hide(); }
		if (!password) {
			$('#spnPasswordError').hide(); $('#spnPassword').show(); isValid = false;
		} else {
			$('#spnPassword').hide();
			if (patternPassword.test(password)) { $('#spnPasswordError').hide(); } else { $('#spnPasswordError').show(); isValid = false; }
		}
		if (!weekOfAssignId)     { $('#spnWeekOff').show();          isValid = false; } else { $('#spnWeekOff').hide(); }
		if (!reportingManager)   { $('#spnReporting').show();        isValid = false; } else { $('#spnReporting').hide(); }
		if (!attendanceLimit)    { $('#spnAttendanceLimit').show();   isValid = false; } else { $('#spnAttendanceLimit').hide(); }
		if (!isValid) return;

		setBtnLoading('#btnCreateEmployee', 'Saving...');

		var employeeData = {
			Id:                     null,
			CompanyId:              CompanyId || null,
			Initial:                initial || null,
			FirstName:              firstName || null,
			MiddleName:             middleName || null,
			LastName:               lastName || null,
			FullName:               (initial + ' ' + firstName + ' ' + middleName + ' ' + lastName).trim(),
			EmployeeCode:           (employeeNumberCode + '').trim(),
			AlfaCode:               employeeStringCode || null,
			AlfaEmployeeCode:       (employeeStringCode + '' + employeeNumberCode).trim(),
			DateOfJoining:          dateOfJoining || null,
			BranchId:               branch || null,
			GradeId:                grade || null,
			ShiftMasterId:          shift || null,
			DesignationId:          designation || null,
			GrossSalary:            grossSalary || null,
			CategoryId:             category || null,
			BasicSalary:            basicSalary || null,
			DepartmentId:           department || null,
			EmployeeTypeId:         employeeType || null,
			DateOfBirth:            dateOfBirth || null,
			RoleId:                 RoleId || 0,
			LoginAlias:             loginAlias ? (loginAlias + domainName) : null,
			Password:               password,
			ReportingManagerId:     reportingManager || null,
			AttendanceLimit:        attendanceLimit ? parseInt(attendanceLimit) : null,
			Pt:                     pt,
			IsPFApplicable:         isPFApplicable,
			Probation:              probation,
			IsGTL:                  gtl,
			IsGMP:                  gmp,
			CreatedBy:              EmployeeId,
			UpdatedBy:              null,
			EmployeeProfileUrl:     null,
			EmployeeSignatureUrl:   null,
			WeekOffDetailsId:       weekOfAssignId || null,
			IsPermissionPunchInOut: checkInOut,
			Remark:                 remark || null
		};

		$.ajax({
			url: '@baseUrl/EmployeeMasterAPI/CreateEmployee',
			type: 'POST',
			contentType: 'application/json',
			_silentLoader: true,
			data: JSON.stringify(employeeData),
			success: function (response) {
				if (response.isSuccess) {
					showToast(response.responseMessage || 'Employee created successfully.', 'success');
					loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployeeActiveOrLeft/false');
					GetNextEmployeeCode();
					document.getElementById('addEmployeeModal').classList.remove('open');
				} else {
					showToast(response.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnCreateEmployee', 'Save');
				}
			},
			error: function () {
				showToast('Unable to save employee.', 'error');
				setBtnNormal('#btnCreateEmployee', 'Save');
			}
		});
	});

	function resetEmployeeMasterField() {
		$('#txtFirstName, #txtMiddleName, #txtLastName, #txtGrossSalary, #txtBasicSalary, #txtLoginAlias, #txtRemark').val('');
		$('#doj, #dob').val('');

		['#ddlInitial', '#ddlDepartment', '#ddlBranch', '#ddlGrade', '#ddlShift',
		 '#ddlDesignation', '#ddlCategory', '#ddlEmpType', '#ddlRole', '#drpReporting', '#ddlWeekOfAssign'].forEach(function (sel) {
			var el = document.querySelector(sel);
			if (el && el._wmsSetValue) { el._wmsSetValue(''); } else if (el) { el.value = ''; }
		});

		$('#pt').prop('checked', true);
		$('#checkInOut').prop('checked', false);
		$('#isPFApplicable').prop('checked', true);
		$('#probation').prop('checked', false);
		$('#gtl').prop('checked', true);
		$('#gmp').prop('checked', false);

		$('[id^="spn"]').hide();
		$('#txtPassword').val('Relay@@123');
		setBtnNormal('#btnCreateEmployee', 'Save');
	}

	function loadEmployeeRecords() {
		$.ajax({
			url: '@baseUrl/EmployeeMasterAPI/GetRecordsForAdd/' + CompanyId,
			method: 'GET',
			_silentLoader: true,
			success: function (response) {
				if (response.isSuccess) {
					bindBranch(response.data.branches);
					bindCategory(response.data.categories);
					bindDesignation(response.data.designations);
					bindReporting(response.data.reportingEmployees);
					bindDepartment(response.data.departments);
					bindGrade(response.data.grades);
					bindRole(response.data.roles);
					bindEmployeeType(response.data.employeeTypes);
					bindShift(response.data.shifts);
				}
			}
		});
	}

	// Fills a native <select> with <option> tags; the WMS dropdown engine (hrms-wms-dropdown.js)
	// watches the select for childList changes and rebuilds its custom UI automatically.
	function fillSelect(id, data, valueKey, textKey, placeholder) {
		var el = document.getElementById(id);
		if (!el) return;
		el.innerHTML = '';
		var ph = document.createElement('option');
		ph.value = '';
		ph.textContent = placeholder || 'Select';
		el.appendChild(ph);
		(data || []).forEach(function (d) {
			var o = document.createElement('option');
			o.value = d[valueKey];
			o.textContent = d[textKey] || '';
			el.appendChild(o);
		});
	}

	function bindInitial() {
		var data = [{ initial: 'Mr.' }, { initial: 'Mrs.' }, { initial: 'Ms.' }];
		fillSelect('ddlInitial', data, 'initial', 'initial', 'Initial');
	}

	function bindBranch(data) {
		fillSelect('ddlBranch', data, 'branchId', 'branchName', 'Branch');
	}

	function bindDesignation(data) {
		fillSelect('ddlDesignation', data, 'designationId', 'designationName', 'Designation');
	}

	function bindCategory(data) {
		fillSelect('ddlCategory', data, 'categoryId', 'categoryName', 'Category');
	}

	function bindReporting(data) {
		fillSelect('drpReporting', data, 'employeeId', 'employeeName', 'Reporting Manager');
	}

	function bindDepartment(data) {
		fillSelect('ddlDepartment', data, 'departmentId', 'departmentName', 'Department');
	}

	function bindGrade(data) {
		fillSelect('ddlGrade', data, 'gradeId', 'gradeName', 'Grade');
	}

	function bindRole(data) {
		fillSelect('ddlRole', data, 'roleId', 'roleName', 'Role');
	}

	function bindEmployeeType(data) {
		fillSelect('ddlEmpType', data, 'employeeTypeId', 'employeeTypeName', 'EmployeeType');
	}

	function bindShift(data) {
		fillSelect('ddlShift', data, 'shiftId', 'shiftName', 'Shift');
	}

	function bindWeekOff() {
		fillSelect('ddlWeekOfAssign', [], 'weekOffDetailsId', 'weekOffName', 'WeekOff Name');
	}

	function LoadWeekOffMaster() {
		var branchId = $('#ddlBranch').val();
		if (!branchId) { showToast('Please select branch first!', 'warning'); return; }
		$.ajax({
			url: '@baseUrl/WeekOffMasterAPI/GetAllWeekOffDetails',
			type: 'POST',
			contentType: 'application/json',
			_silentLoader: true,
			data: JSON.stringify({ branchId: branchId, CompanyId: CompanyId }),
			success: function (res) {
				fillSelect('ddlWeekOfAssign', res.data, 'weekOffDetailsId', 'weekOffName', 'WeekOff Name');
			},
			error: function () { showToast('Failed to fetch week off data.', 'error'); }
		});
	}

	function GetNextEmployeeCode() {
		if (!CompanyId) return;
		$.ajax({
			url: '@baseUrl/EmployeeMasterAPI/GetNextEmployeeCode/' + CompanyId,
			method: 'GET',
			_silentLoader: true,
			success: function (data) {
				if (data.isSuccess) {
					var formatted = Number(data.data.nextEmployeeCode).toString().padStart(data.data.digitsForEmployeeCode, '0');
					$('#txtNumberEmpCode').val(formatted);
					if (data.data.companyCode) { $('#txtEmpCode').show().val(data.data.companyCode); }
					$('#txtDomainName').text(data.data.domainName).attr('title', data.data.domainName);
				}
			}
		});
	}

	async function GetExistEmployeeCode() {
		var NumberCode = $('#txtNumberEmpCode').val();
		if (!NumberCode) return;
		$.ajax({
			url: '@baseUrl/EmployeeMasterAPI/GetExistEmployeeCode',
			type: 'POST',
			contentType: 'application/json',
			_silentLoader: true,
			data: JSON.stringify({ EmployeeCode: NumberCode, CompanyId: CompanyId }),
			success: function (res) {
				if (res.isSuccess && res.data && res.data.employeeCode != null) {
					showToast('The employee code \'' + res.data.employeeCode + '\' already exists!', 'error');
				}
			}
		});
	}

	async function GetGradeBySalaryRange() {
		var grossSalary = $('#txtGrossSalary').val();
		if (!grossSalary) return;
		var basicSalary    = $('#txtBasicSalary').val() || 0;
		var isPFApplicable = $('#isPFApplicable').is(':checked');
		try {
			var response = await new Promise(function (resolve, reject) {
				$.ajax({
					url: '@baseUrl/EmployeeMasterAPI/GetGradeBySalaryRange',
					method: 'POST',
					contentType: 'application/json',
					_silentLoader: true,
					data: JSON.stringify({ CompanyId: CompanyId, IsPFApplicable: isPFApplicable, GrossSalary: grossSalary, BasicSalary: basicSalary }),
					success: resolve,
					error: reject
				});
			});
			if (response.isSuccess) {
				var gradeEl = document.getElementById('ddlGrade');
				if (gradeEl._wmsSetValue) { gradeEl._wmsSetValue(response.data.GradeId); } else { gradeEl.value = response.data.GradeId; }
			}
		} catch (e) { console.error('Error fetching grade by salary range:', e); }
	}

	async function loadSalaryAllowance() {
		var grossSalary = $('#txtGrossSalary').val();
		if (!grossSalary) return;
		var isPFApplicable = $('#isPFApplicable').is(':checked');
		try {
			var response = await fetch('@baseUrl/EmployeeSalaryAllowanceAPI/GetLiveEmployeeSalaryAllowance', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					IsPFApplicable: isPFApplicable, GrossSalary: grossSalary, BasicSalary: 0,
					CompanyId: CompanyId, EmployeeId: 0,
					GradeId: $('#ddlGrade').val() || null,
					DesignationId: $('#ddlDesignation').val() || null
				})
			});
			var data = await response.json();
			if (data.isSuccess) {
				$('#txtBasicSalary').val(data.data.basicSalary);
				bindSalaryAllowance(data.data);
			} else {
				showToast(data.responseMessage || 'Unable to calculate allowance.', 'error');
			}
		} catch (e) { console.error('Fetch error:', e); }
	}

	function formatCurrency(amount) {
		return '₹' + amount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
	}

	function bindSalaryAllowance(d) {
		$('#monthlyGross').text(formatCurrency(d.totalGrossSalary));
		$('#AnualGross').text(formatCurrency(d.totalGrossSalary * 12));
		$('#basicSalaryMonth').text(formatCurrency(d.basicSalary));
		$('#basicSalaryYear').text(formatCurrency(d.basicSalary * 12));
		$('#hraMonth').text(formatCurrency(d.hra));
		$('#hraYear').text(formatCurrency(d.hra * 12));
		$('#deputationAllowanceMonth').text(formatCurrency(d.deputationAllowance));
		$('#deputationAllowanceYear').text(formatCurrency(d.deputationAllowance * 12));
		$('#conveyanceAllowanceMonth').text(formatCurrency(d.conveyanceAllowance));
		$('#conveyanceAllowanceYear').text(formatCurrency(d.conveyanceAllowance * 12));
		$('#medicalAllowanceMonth').text(formatCurrency(d.medicalAllowance));
		$('#medicalAllowanceYear').text(formatCurrency(d.medicalAllowance * 12));
		$('#childEducationAllowanceMonth').text(formatCurrency(d.childEducationAllowance));
		$('#childEducationAllowanceYear').text(formatCurrency(d.childEducationAllowance * 12));
		$('#totalGrossMonth').text(formatCurrency(d.totalGrossSalary));
		$('#totalGrossYear').text(formatCurrency(d.totalGrossSalary * 12));
		$('#pfMonth').text(formatCurrency(d.employeePF));
		$('#pfYear').text(formatCurrency(d.employeePF * 12));
		$('#esiMonth').text(formatCurrency(d.employeeESI));
		$('#esiYear').text(formatCurrency(d.employeeESI * 12));
		$('#ptMonth').text(formatCurrency(d.professionalTax));
		$('#ptYear').text(formatCurrency(d.professionalTax * 12));
		$('#groupMedicalMonth').text(formatCurrency(d.groupMedical));
		$('#groupMedicalYear').text(formatCurrency(d.groupMedical * 12));
		$('#termInsuranceMonth').text(formatCurrency(d.termInsurance));
		$('#termInsuranceYear').text(formatCurrency(d.termInsurance * 12));
		$('#totalDeductionMonth').text(formatCurrency(d.totalDeductions));
		$('#totalDeductionYear').text(formatCurrency(d.totalDeductions * 12));
		$('#netSalaryMonth').text(formatCurrency(d.netSalary));
		$('#netSalaryYear').text(formatCurrency(d.netSalary * 12));
		$('#CalculationGrossMonth').text(formatCurrency(d.ctc));
		$('#CalculationGrossYear').text(formatCurrency(d.ctc * 12));
		$('#CalculationPFMonth').text(formatCurrency(d.employeePF));
		$('#CalculationPFYear').text(formatCurrency(d.employeePF * 12));
		$('#CalculationESIMonth').text(formatCurrency(d.employeeESI));
		$('#ctcMonth').text(formatCurrency(d.ctc));
		$('#ctcYear').text(formatCurrency(d.ctc * 12));
		$('#summaryCtc').text(formatCurrency(d.ctc));
		$('#summaryNet').text(formatCurrency(d.netSalary));
		$('#summaryAnnual').text(formatCurrency(d.ctc * 12));
	}

	$(document).ready(function () {
		localStorage.removeItem('employeeDetailsLocalStorage');
		GetNextEmployeeCode();
		bindWeekOff();
		bindInitial();
		loadEmployeeRecords();
		loadTable('@baseUrl/EmployeeMasterAPI/GetAllEmployeeActiveOrLeft/false');
		$.get('@Url.Action("Allowance", "PartialView")', function (response) {
			$('#SalaryPartialView').html(response);
		});
	});
})();
</script>
