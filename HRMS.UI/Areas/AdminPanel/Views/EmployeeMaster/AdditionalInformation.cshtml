			}

			// Fills a native <select> with <option> tags; the WMS dropdown engine (hrms-wms-dropdown.js)
			// watches the select for childList changes and rebuilds its custom UI automatically.
			function fillSelect(id, data, valueKey, textKey, placeholder) {
				var el = document.getElementById(id);
				if (!el) return;
				el.innerHTML = '';
				var ph = document.createElement('option');
				ph.value = '';
				ph.textContent = placeholder || 'Select';
				el.appendChild(ph);
				(data || []).forEach(function (d) {
					var o = document.createElement('option');
					o.value = d[valueKey];
					o.textContent = d[textKey] || '';
					el.appendChild(o);
				});
			}

