<!-- CropperJS CSS & JS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
			let employeeList = [];
			let UserId=localStorage.getItem('EmployeeId');
			let CurrentEmployeeId=localStorage.getItem('CurrentEmployeeId');
			const savedCompany = localStorage.getItem('selectedCompany');
			var companyDetails = JSON.parse(savedCompany);

			const CurrentCompanyId=companyDetails.CompanyId;
			const Token=localStorage.getItem("authToken");

			var EmployeeProfileUrl="";
			var EmployeeSignatureUrl="";

			$(document).ready(function(){
				if (!CurrentCompanyId) {
					showToast("Please select company", 'error');
					return;
				}
				bindInitial();
				bindWeekOff();
			  loadEmployeeRecords();
			});


			$('#txtGrossSalary , #txtBasicSalary').blur(async function () {
				await GetGradeBySalaryRange();

			});

			async function GetGradeBySalaryRange() {
                var grossSalary = $('#txtGrossSalary').val();
				if(!grossSalary){
					return;
				}
				var basicSalary = $('#txtBasicSalary').val();
				var isPFApplicable = $('#isPFApplicable').is(':checked');
				if (basicSalary == null || basicSalary === '') {
					basicSalary = 0;
				}
				var parameter={
					CompanyId:CurrentCompanyId,
					IsPFApplicable: isPFApplicable,
					GrossSalary: grossSalary,
					BasicSalary: basicSalary
				}
				
				try {
					const response = await new Promise((resolve, reject) => {
						$.ajax({
							url: '@baseUrl/EmployeeMasterAPI/GetGradeBySalaryRange' ,
							method: 'POST',
							contentType: 'application/json',
							  data: JSON.stringify(parameter),
							success: function(response) {
								resolve(response);
							},
							error: function(error) {
								reject(error);
							}
						});
					});

					if (response.isSuccess) {
						var gradeEl = document.getElementById('ddlGrade');
						if (gradeEl._wmsSetValue) { gradeEl._wmsSetValue(response.data.GradeId); } else { gradeEl.value = response.data.GradeId; }
					}
				} catch (error) {
					console.error('Error fetching data:', error);
				}
			}


	
			async function loadEmployeeRecords() {
				showLoder();
				var parameter={
					CompanyId:CurrentCompanyId,
					EmployeeId:CurrentEmployeeId
				}
				try {
					const response = await new Promise((resolve, reject) => {
						$.ajax({
							url: '@baseUrl/EmployeeMasterAPI/GetRecordsForUpdate' ,
							method: 'POST',
							contentType: 'application/json',
							  data: JSON.stringify(parameter),
							success: function(response) {
								resolve(response);
							},
							error: function(error) {
								reject(error);
							}
						});
					});

					if (response.isSuccess) {
						
						bindBranch(response.data.branches);
						bindCategory(response.data.categories);
						bindDesignation(response.data.designations);
						bindReporting(response.data.reportingEmployees);
						bindDepartment(response.data.departments);
						bindGrade(response.data.grades);
						bindRole(response.data.roles);
						bindEmployeeType(response.data.employeeTypes);
						bindShift(response.data.shifts);						
						fillEmployeeForm(response.data.employees);
				
					} else {
						showToast(response.responseMessage, 'error');
						setTimeout(function() {
							window.location.href = "@UIBaseUrlLayout/AdminPanel/EmployeeMaster/EmployeeMaster";
						}, 1000);

					}
					hideLoder();
				} catch (error) {
					hideLoder();
					console.error('Error fetching data:', error);
				} finally {
					hideLoder();
				}
			}



			function wmsSetValue(id, val) {
				var el = document.getElementById(id);
				if (!el) return;
				if (el._wmsSetValue) { el._wmsSetValue(val); } else { el.value = val; }
			}

			// Fills a native <select> with <option> tags; the WMS dropdown engine (hrms-wms-dropdown.js)
			// watches the select for childList changes and rebuilds its custom UI automatically.
			function fillSelect(id, data, valueKey, textKey, placeholder) {
				var el = document.getElementById(id);
				if (!el) return;
				el.innerHTML = '';
				var ph = document.createElement('option');
				ph.value = '';
				ph.textContent = placeholder || 'Select';
				el.appendChild(ph);
				(data || []).forEach(function (d) {
					var o = document.createElement('option');
					o.value = d[valueKey];
					o.textContent = d[textKey] || '';
					el.appendChild(o);
				});
			}

			function bindInitial() {
				var data = [{ initial: 'Mr.' }, { initial: 'Mrs.' }, { initial: 'Ms.' }];
				fillSelect('ddlInitial', data, 'initial', 'initial', 'Initial');
			}

			function bindBranch(data) {
				fillSelect('ddlBranch', data, 'branchId', 'branchName', 'Branch');
			}

			function bindDesignation(data) {
				fillSelect('ddlDesignation', data, 'designationId', 'designationName', 'Designation');
			}

			function bindCategory(data) {
				fillSelect('ddlCategory', data, 'categoryId', 'categoryName', 'Category');
			}

			function bindReporting(data) {
				fillSelect('drpReporting', data, 'employeeId', 'employeeName', 'Reporting Manager');
			}

			function bindDepartment(data) {
				fillSelect('ddlDepartment', data, 'departmentId', 'departmentName', 'Department');
			}

			function bindGrade(data) {
				fillSelect('ddlGrade', data, 'gradeId', 'gradeName', 'Grade');
			}

			function bindRole(data) {
				fillSelect('ddlRole', data, 'roleId', 'roleName', 'Role');
			}

			function bindEmployeeType(data) {
				fillSelect('ddlEmpType', data, 'employeeTypeId', 'employeeTypeName', 'EmployeeType');
			}

			function bindShift(data) {
				fillSelect('ddlShift', data, 'shiftId', 'shiftName', 'Shift');
			}

			function bindWeekOff() {
				fillSelect('ddlWeekOfAssign', [], 'weekOffDetailsId', 'weekOffName', 'WeekOff Name');
			}

			$('#ddlBranch').on('change', function () { LoadWeekOffMaster(); });

			$('#ddlEmpType').on('change', function () {
				var selectedText = $(this).find('option:selected').text().trim();
				$('#probation').prop('checked', selectedText === 'Probation');
			});

			async function LoadWeekOffMaster() {
				return new Promise((resolve, reject) => {
					let branchId = $('#ddlBranch').val();

					// Validation
					if (!branchId) {
						showToast("Please select branch first!", 'warning');
						reject("Branch not selected");
						return;
					}

					var data = {
						branchId: branchId,
						CompanyId: CurrentCompanyId
					};

					$.ajax({
						url: '@baseUrl/WeekOffMasterAPI/GetAllWeekOffDetails',
						type: "POST",
						contentType: 'application/json',
						data: JSON.stringify(data),
						success: function (res) {
							fillSelect('ddlWeekOfAssign', res.data, 'weekOffDetailsId', 'weekOffName', 'WeekOff Name');
							resolve(res);
						},
						error: function (xhr, status, error) {
							showToast("Failed to fetch week off data.", 'error');
							reject(error);
						}
					});
				});
			}



		$("#backArrow,#btnBackEmployee").click(function(){
			window.location.href = '@UIBaseUrlLayout/AdminPanel/EmployeeMaster/EmployeeMaster';
		});

	function showBtnLoder()
	{
		setBtnLoading('#btnUpdateEmployee', 'Updating...');
	}
	function hideBtnLoder()
	{
		setBtnNormal('#btnUpdateEmployee', 'Update');
	}

	function formatDate(isoDateStr) {
			if (!isoDateStr) return '';
	  return isoDateStr.split('T')[0];
	}

	async function showLoder(){
	  $('#grid-loader').addClass('d-flex').show();
	}
	async function hideLoder(){
			$('#grid-loader').removeClass('d-flex').hide();
	}

	$('#txtLoginAlias').on('input', function () {
			var inputVal = $(this).val();
			var domain = $('#txtDomainName').text().trim();

			if (inputVal.includes('@@')) {
				showToast(`The domain "${domain}" is already added.`, 'warning');

				// Optionally remove the '@@' from the input
				$(this).val(inputVal.replace('@@', ''));
			}
	});

	$('#togglePassword').click(function() {
		let passwordInput = $('#txtPassword');
