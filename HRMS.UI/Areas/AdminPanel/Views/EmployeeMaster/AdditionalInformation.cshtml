	// #doj / #dob are DevExtreme dxDateBox widgets (init'd in initDateBoxes()
	// below), not native <input type="date"> — see the markup comment on
	// #doj for why. Idempotent: safe to call more than once (e.g. if the
	// tab/page init runs more than once), it only creates each widget the
	// first time.
	function initDateBoxes() {
		['doj', 'dob'].forEach(function (id) {
			var $el = $('#' + id);
			if ($el.data('dxDateBox')) return;
			$el.dxDateBox({
				displayFormat: 'dd-MM-yyyy',
				useMaskBehavior: true,
				openOnFieldClick: true,
				showClearButton: true,
				width: '100%'
			});
		});
	}

	// "2026-07-30T00:00:00" (or "2026-07-30") -> a JS Date for the dxDateBox
	// widget's `value` option. Pulls the y/m/d apart with a regex (not a
	// plain `new Date(isoDateStr)`) so this can't be affected by
	// timezone-shift parsing quirks (a plain ISO-with-no-offset string is
	// parsed as UTC by `new Date(...)`, which can roll the displayed day
	// back or forward a day depending on the browser's local timezone).
	function isoStringToLocalDate(isoDateStr) {
		if (!isoDateStr) return null;
		var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(isoDateStr);
		if (!m) return null;
		return new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10));
	}

	// The reverse — a JS Date (as read back from a dxDateBox's `value`
	// option) -> "yyyy-MM-dd" for the Update API, using the date's LOCAL
	// components (not `toISOString()`, which converts to UTC first and can
	// shift the day).
	function localDateToIsoString(date) {
		if (!date) return '';
		var y = date.getFullYear();
		var m = String(date.getMonth() + 1).padStart(2, '0');
		var d = String(date.getDate()).padStart(2, '0');
		return y + '-' + m + '-' + d;
	}

	function setDateField(id, isoDateStr) {
		var widget = $('#' + id).dxDateBox('instance');
		if (!widget) return;
		widget.option('value', isoStringToLocalDate(isoDateStr));
	}

	// Reads a dxDateBox's current value back out as "yyyy-MM-dd" (or '' if
	// empty), for building the Update payload.
	function getDateFieldIso(id) {
		var widget = $('#' + id).dxDateBox('instance');
		if (!widget) return '';
		return localDateToIsoString(widget.option('value'));
	}

