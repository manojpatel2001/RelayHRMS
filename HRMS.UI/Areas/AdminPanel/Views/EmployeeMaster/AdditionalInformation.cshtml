		// Attendance Limit Validation
	$('#txtAttendanceLimit').on('input', function() {
		let value = parseInt($(this).val());
		this.value = this.value.replace(/[^0-9]/g, '');

		if (value > 31) {
			$(this).val(31);
			showToast('Maximum value is 31', 'error');
		} else if (value < 0) {
			$(this).val(0);
		}
	});

	$('#txtAttendanceLimit').on('keypress', function(e) {
		if (this.value.length >= 2 && e.which !== 8) {
			e.preventDefault();
		}
	});

