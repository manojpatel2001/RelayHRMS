@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Additional Information";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
	string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
	var uri = new Uri(baseUrl);
	string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}
<style>
	#cropModal .modal-dialog {
		max-width: 600px;
	}

	#cropModal .modal-body {
		max-height: 70vh;
		overflow: auto;
	}

	#cropImagePreview {
		max-width: 100%;
		max-height: 60vh;
		display: block;
		margin: 0 auto;
	}

	.profile-photo-box {
		border: 1px solid #D8E2E8;
		border-radius: var(--r-md);
		background: #F9FBFC;
		padding: 14px;
		text-align: center;
	}

		.profile-photo-box img {
			width: 100px;
			height: 100px;
			object-fit: cover;
			border: 1px solid #D8E2E8;
			border-radius: var(--r-sm);
			cursor: pointer;
			background: #fff;
			margin-top: 6px;
		}

	/* ════════════════════════════════════════════════════════════════════
	   Employee Master redesign — compact fields, sticky header/actions/tabs,
	   sticky photo panel. Scoped to .emp-master-page (this view only): .fg /
	   .form-grid-3 / .wms-form-page are the shared form design system used
	   across ~150 other pages, so their base rules in wms-site.css and
	   hrms-wms-form-bridge.css are left untouched — everything here only
	   overrides them within this page.
	   ════════════════════════════════════════════════════════════════════ */

	/* Compact field sizing */
	.emp-master-page .fg {
		margin-bottom: 12px;
	}
	.emp-master-page .fg label:not(.btn):not(.lc-remember) {
		font-size: 11.5px;
	}
	.emp-master-page .fg input,
	.emp-master-page .fg select,
	.emp-master-page .fg textarea,
	.emp-master-page .wms-dd-trigger {
		min-height: 32px;
		padding: 5px 10px;
		font-size: 13px;
	}
	.emp-master-page .fg textarea {
		min-height: 56px;
	}

	/* DevExtreme dxDateBox (Date of Joining / Date of Birth) — match the
	   surrounding compact .fg input styling (border, radius, height,
	   padding, font-size) instead of DevExtreme's own larger default
	   theme appearance, so these two fields look consistent with every
	   other field on this form. */
	.emp-master-page .dx-datebox.dx-texteditor {
		min-height: 32px;
		border: 1px solid #B8C4CC;
		border-radius: var(--r-sm, 4px);
		background: #fff;
	}
	.emp-master-page .dx-datebox.dx-texteditor.dx-state-focused,
	.emp-master-page .dx-datebox.dx-texteditor.dx-state-active {
		border-color: #2F6F8E;
		box-shadow: 0 0 0 3px rgba(47,111,142,.15);
	}
	.emp-master-page .dx-datebox .dx-texteditor-input {
		min-height: 30px;
		padding: 5px 10px;
		font-size: 13px;
		font-family: inherit;
		color: var(--text, #1A1A1A);
		/* This inner <input> also matches the site-wide .fg input rule
		   (border: 1px solid #B8C4CC), which doubled up with the border
		   already on the outer .dx-datebox.dx-texteditor container above
		   — cancel it here so there's only the one, outer border. */
		border: none !important;
	}
	.emp-master-page .dx-datebox .dx-texteditor-buttons-container {
		height: 30px;
	}
	.emp-master-page .dx-datebox .dx-dropdowneditor-button {
		width: 26px;
		height: 30px;
	}
	.emp-master-page .dx-datebox .dx-clear-button-area {
		width: 22px;
		height: 30px;
	}
	.emp-master-page .dx-datebox .dx-placeholder {
		font-size: 13px;
		padding: 5px 10px;
	}
	.emp-master-page .form-grid-3 {
		gap: 8px 16px;
	}
	/* 4 fields per row on desktop instead of 3 — applies to Basic Info AND
	   every AJAX-loaded tab partial (Personal Info, Contact, Emergency
	   Contact, Attachments, Salary, etc.), since they all render inside
	   .emp-master-page and share the same .form-grid-3 class. Scoped to a
	   min-width query sitting just above the existing tablet (max-width:
	   1024px, 2-col) and mobile (max-width:767px, 1-col) breakpoints in
	   wms-site.css, so those keep working unchanged on smaller screens. */
	@@media (min-width: 1025px) {
		.emp-master-page .form-grid-3 {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.emp-master-page .sec-lbl {
		margin-top: 18px;
		margin-bottom: 10px;
	}
	.emp-master-page .divider {
		margin: 12px 0;
	}

	/* Sticky title bar — acts as the page breadcrumb/header, stays visible
	   while scrolling through the long field list below it. */
	.emp-master-page .card-header {
		position: sticky;
		top: 0;
		z-index: 15;
		background: var(--surface, #fff);
	}
	.emp-crumb-root {
		color: var(--text-3, #667);
		font-weight: 500;
	}

	/* Sticky action bar — Update/Cancel always reachable without scrolling
	   to the very bottom of the form. */
	.emp-master-page .emp-actions-bar {
		position: sticky;
		bottom: 0;
		z-index: 10;
		background: var(--surface, #fff);
		padding: 10px 0 4px;
		margin-top: 8px !important;
		border-top: 1px solid var(--border, #e2e8f0);
	}

	/* Sticky section tabs — stay visible while scrolling a long tab's
	   content instead of requiring a scroll back to the top to switch tabs.
	   The bar = two scroll-arrow buttons + the (horizontally scrollable)
	   tab list, all sticking together as one row. */
	.emp-master-page .emp-tabs-bar {
		position: sticky;
		top: 0;
		z-index: 12;
		display: flex;
		align-items: center;
		gap: 2px;
		background: var(--surface, #fff);
		padding: 8px 12px 0;
	}
	.emp-master-page .emp-tabs-nav-btn {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 5px;
		background: transparent;
		color: var(--text-3, #667);
		cursor: pointer;
		font-size: 15px;
	}
	.emp-master-page .emp-tabs-nav-btn:hover {
		background: #eef4fa;
		color: var(--hp-blue-mid, #2F6F8E);
	}
	.emp-master-page #employeeDetailTabs {
		flex: 1 1 auto;
		min-width: 0;
		flex-wrap: nowrap;
		overflow-x: auto;
		scroll-behavior: smooth;
		gap: 4px;
		/* Hide the native horizontal scrollbar — the ‹ › buttons are the
		   intended way to scroll the tab strip; dragging still works too. */
		scrollbar-width: none;
	}
	.emp-master-page #employeeDetailTabs::-webkit-scrollbar { display: none; }
	.emp-master-page #employeeDetailTabs .nav-item {
		flex-shrink: 0;
	}
	.emp-master-page #employeeDetailTabs .nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		white-space: nowrap;
		font-size: 12.5px;
	}
	.emp-master-page #employeeDetailTabs .nav-link i {
		font-size: 14px;
	}
	/* Selected tab — light blue-tinted background behind the navy text +
	   blue underline (the shared app-wide .nav-tabs.active rule only sets
	   the text/underline color with a transparent background; this adds
	   the highlighted "selected" look on top, scoped to this page only). */
	.emp-master-page #employeeDetailTabs .nav-link.active {
		background: #EAF1F8 !important;
		border-radius: 6px 6px 0 0;
	}

	/* Sticky, slightly smaller photo panel on the right — stays in view
	   while the (much longer) left-hand form column scrolls. */
	.emp-master-page .emp-photo-col {
		position: sticky;
		top: 54px;
		align-self: flex-start;
	}

	/* Subtle hover feedback on plain text/date/number inputs, matching the
	   hover state the WMS dropdown trigger already has. */
	.emp-master-page .fg input:hover,
	.emp-master-page .fg textarea:hover {
		border-color: #4E8FAD;
	}
</style>


<div id="grid-loader"
	 class="grid-loader justify-content-center align-items-center flex-column"
	 style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(3px); z-index: 9999;">

	<img src="@baseDomainUrl/loders/loder.png"
		 class="grid-logo-spinner"
		 style="width: 40px; height: 40px; animation: spin 1s linear infinite;" />

	<div class="grid-loading-text text-dark " style="font-size: 16px;">Loading...</div>
</div>

<div class="wms-form-page emp-master-page">

<div class="card" id="employeeDetailsCard">

	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0 emp-crumb"><span class="emp-crumb-root">Employee Master</span> <i class="bx bx-chevron-right"></i> Edit Employee</h6>
		<button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="backArrow">
			<i class="bx bx-arrow-back"></i> Back
		</button>
	</div>
</div>


<!-- Modal HTML -->
<div class="modal" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="cropModalLabel">Crop Profile Image</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<img id="cropImagePreview" src="" alt="Image preview" class="img-fluid">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-primary" id="cropConfirmBtn">Confirm Crop</button>
			</div>
		</div>
	</div>
</div>

<!--Addition menu-->
	<div class="card mt-3">
		<div class="emp-tabs-bar">
			<button type="button" class="emp-tabs-nav-btn" id="empTabsPrev" aria-label="Scroll tabs left"><i class="bx bx-chevron-left"></i></button>
			<button type="button" class="emp-tabs-nav-btn" id="empTabsNext" aria-label="Scroll tabs right"><i class="bx bx-chevron-right"></i></button>
			<ul class="nav nav-tabs mb-0" id="employeeDetailTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active py-2" type="button" role="tab" data-tabname="BasicInfo"><i class="bx bx-user-circle"></i> Basic Info</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="EmployeePersonalInfo"><i class="bx bx-id-card"></i> Personal Info</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="Contact"><i class="bx bx-phone"></i> Contact</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="EmergencyContacts"><i class="bx bx-shield"></i> Emergency Contact(s)</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="ReportingContract"><i class="bx bx-briefcase-alt"></i> Reporting &amp; Contract</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="Attachments"><i class="bx bx-paperclip"></i> Attachments</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="Allowance"><i class="bx bx-wallet"></i> Allowance</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link py-2" type="button" role="tab" data-tabname="Salary"><i class="bx bx-coin-stack"></i> Salary</button>
			</li>
			</ul>
		</div>

		<div class="card-body">
			<div id="partialViewContainer">
				<div id="BasicInfo" class="partial-section">
					<div class="row mt-2">
						<!-- Left Side: Form Data -->
						<div class="col-md-9">
							<form id="employeeForm">
								<div class="form-grid-3">

									<div class="fg fg-req">
										<label for="ddlInitial">Initial</label>
										<select id="ddlInitial"></select>
										<span class="field-validation-error" id="spnInitial" style="display:none;">Please Select Initial</span>
									</div>

									<div class="fg fg-req">
										<label for="txtFirstName">First Name</label>
										<input type="text" id="txtFirstName" placeholder="First Name">
										<span class="field-validation-error" id="spnFirstName" style="display:none;">Please Enter First Name</span>
									</div>
									<div class="fg">
										<label for="txtMiddleName">Middle Name</label>
										<input type="text" id="txtMiddleName" placeholder="Middle Name">
									</div>

									<div class="fg">
										<label for="txtLastName">Last Name</label>
										<input type="text" id="txtLastName" placeholder="Last Name">
									</div>
									<div class="fg fg-req">
										<label>Employee Code</label>
										<div style="display:flex;gap:6px">
											<input type="text" readonly id="txtEmpCode" placeholder="HRMS" value="" style="display:none;width:35%" />
											<input type="text" id="txtNumberEmpCode" placeholder="0001" value="" style="flex:1" />
										</div>
										<span class="field-validation-error" id="spnStringCode" style="display:none;">Please Enter String Code</span>
										<span class="field-validation-error" id="spnNumberCode" style="display:none;">Please Enter Employee Code</span>
									</div>
									<div class="fg fg-req">
										<label for="doj">Date of Joining</label>
										<!-- DevExtreme dxDateBox (initialized in the script below), not a
										     native <input type="date">. Something (browser-level autofill
										     or an extension — confirmed NOT our own JS/API/data) was
										     overwriting the correctly-set ISO value with a human-readable
										     one that native date inputs reject outright, showing as blank
										     even though our own code set it correctly moments earlier. A
										     DevExtreme widget isn't a native date input at all, so it isn't
										     a target for that interference, and it gives both an explicit
										     DD-MM-YYYY display AND a click-to-open calendar popup. -->
										<div id="doj"></div>
										<span class="field-validation-error" id="spnDoj" style="display:none;">Please Select Date Of Joining</span>
									</div>

									<div class="fg">
										<label for="txtRemark">Remark</label>
										<input type="text" id="txtRemark" placeholder="Remark">
									</div>
								</div>
								<div class="form-grid-3">
									<div class="fg fg-req">
										<label for="ddlBranch">Branch</label>
										<select id="ddlBranch"></select>
										<span class="field-validation-error" id="spnBranch" style="display:none;">Please Select Branch</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlGrade">Grade</label>
										<select id="ddlGrade" disabled></select>
										<span class="field-validation-error" id="spnGrade" style="display:none;">Please Select Grade</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlShift">Shift</label>
										<select id="ddlShift"></select>
										<span class="field-validation-error" id="spnShift" style="display:none;">Please Select Shift</span>
									</div>
								</div>

								<div class="form-grid-3">
									<div class="fg fg-req">
										<label for="ddlDesignation">Designation</label>
										<select id="ddlDesignation"></select>
										<span class="field-validation-error" id="spnDesignation" style="display:none;">Please Select Designation</span>
									</div>

									<div class="fg fg-req">
										<label for="txtGrossSalary">Gross Salary</label>
										<input type="text" id="txtGrossSalary" placeholder="Gross Salary" data-decimal oninput="this.value = this.value.replace(/[^0-9]/g, '')">
										<span class="field-validation-error" id="spnGrossSalary" style="display:none;">Please Enter GrossSalary</span>
									</div>

									<div class="fg fg-req">
										<label for="txtBasicSalary">Basic Salary</label>
										<input type="text" data-decimal id="txtBasicSalary" placeholder="Basic Salary">
										<span class="field-validation-error" id="spnBasicSalary" style="display:none;">Please Enter Basic Salary</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlCategory">Category</label>
										<select id="ddlCategory"></select>
										<span class="field-validation-error" id="spnCategory" style="display:none;">Please Select Category</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlDepartment">Department</label>
										<select id="ddlDepartment"></select>
										<span class="field-validation-error" id="spnDepartment" style="display:none;">Please Select Department</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlEmpType">Employee Type</label>
										<select id="ddlEmpType"></select>
										<span class="field-validation-error" id="spnEmployeeType" style="display:none;">Please Select Employee Type</span>
									</div>

									<div class="fg fg-req">
										<label for="dob">Date of Birth</label>
										<!-- See the identical comment on #doj above — same fix. -->
										<div id="dob"></div>
										<span class="field-validation-error" id="spnBirth" style="display:none;">Please Select Date Of Birth</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlRole">Role</label>
										<select id="ddlRole"></select>
										<span class="field-validation-error" id="spnRole" style="display:none;">Please select Role</span>
									</div>

									<div class="fg fg-req">
										<label for="txtLoginAlias">Login Alias</label>
										<div style="display:flex;align-items:center;gap:0">
											<input type="text" id="txtLoginAlias" placeholder="Login Alias" style="flex:1;border-radius:var(--r-sm) 0 0 var(--r-sm)">
											<span id="txtDomainName" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:inline-block;padding:0 10px;border:1px solid #B8C4CC;border-left:none;border-radius:0 var(--r-sm) var(--r-sm) 0;background:#F0F5F8;min-height:clamp(30px, 2.0vw, 40px);line-height:clamp(30px, 2.0vw, 40px);font-size:13px;"></span>
										</div>
										<span class="field-validation-error" id="spnLoginAlias" style="display:none;">Please Enter Login Alias</span>
									</div>

									<div class="fg fg-req" style="position:relative">
										<label for="txtPassword">Password</label>
										<input type="password" id="txtPassword" readonly placeholder="Password" style="padding-right:40px;">
										<i id="togglePassword" class="bx bx-show"
										   style="position:absolute;top:30px;right:10px;cursor:pointer;font-size:1.2rem;color:#666;"></i>
										<span class="field-validation-error" id="spnPassword" style="display:none;">Please Enter Password</span>
										<span class="field-validation-error" id="spnPasswordError" style="display:none;">Please Enter Valid Password</span>
									</div>

									<div class="fg fg-req">
										<label for="ddlWeekOfAssign">WeekOff Assign</label>
										<select id="ddlWeekOfAssign"></select>
										<span class="field-validation-error" id="spnWeekOff" style="display:none;">Please Enter Week Off</span>
									</div>

									<div class="fg fg-req">
										<label for="drpReporting">Reporting Manager</label>
										<select id="drpReporting"></select>
										<span class="field-validation-error" id="spnReporting" style="display:none;">Please Select Reporting Manager</span>
									</div>

									<div class="fg fg-req">
										<label for="txtAttendanceLimit">Attendance Limit</label>
										<input type="number" id="txtAttendanceLimit" placeholder="Attendance Limit" min="0" max="31" step="1">
										<span class="field-validation-error" id="spnAttendanceLimit" style="display:none;">Please Enter Attendance Limit</span>
										<span class="field-validation-error" id="spnAttendanceLimitRange" style="display:none;">Attendance Limit must be between 0 and 31</span>
									</div>
								</div>

								<div class="divider"></div>
								<div class="sec-lbl">Eligibility Flags</div>
								<div style="display:flex;gap:22px;flex-wrap:wrap">
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="pt" checked>
										<label class="form-check-label" for="pt">PT</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="checkInOut">
										<label class="form-check-label" for="checkInOut">Punch In Out</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" checked type="checkbox" id="isPFApplicable">
										<label class="form-check-label" for="isPFApplicable">Is PF Applicable</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="probation">
										<label class="form-check-label" for="probation">Probation</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="gtl" checked>
										<label class="form-check-label" for="gtl">GTL</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="gmp">
										<label class="form-check-label" for="gmp">GMP</label>
									</div>
								</div>

								<div class="emp-actions-bar d-flex justify-content-end gap-2 mt-3">
									<button type="button" class="btn btn-outline btn-sm" id="btnBackEmployee">Cancel</button>
									<button type="button" id="btnUpdateEmployee" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
										<span class="btn-spinner-icon"></span>
										<span class="btn-label-text">Update</span>
									</button>
								</div>
							</form>
						</div>

						<div class="col-md-3 emp-photo-col">
							<div class="profile-photo-box">
								<label class="sec-lbl" style="display:block;">Profile Picture</label>
								<img id="profileImage"
									 src="@baseDomainUrl/uploads/defaultuserprofile/user-profile-png-image.png"
									 alt="Profile Image" />
								<input type="file" id="profileInput" accept="image/jpeg" class="d-none" />
								<div id="uploadBtnTag" class="mt-2" style="display: none;">
									<button type="button" class="btn btn-primary btn-sm" id="btnUpload">Upload</button>
								</div>
							</div>
						</div>

					</div>
				</div>
