        </div>
        <div class="col-md-4">
          <div class="fg">
            <label for="txtPermanentDistrict">District</label>
            <input type="text" id="txtPermanentDistrict" placeholder="District" />
            <span id="spnPermanentDistrict" class="field-validation-error" style="display:none;">Please Enter District</span>
          </div>
        </div>
      </div>

      <div class="row px-5">
        <!-- City/Village -->
        <div class="col-md-4">
          <div class="fg">
            <label for="txtPermanentCity">City/Village</label>
            <input type="text" id="txtPermanentCity" placeholder="City/Village" />
            <span id="spnPermanentCity" class="field-validation-error" style="display:none;">Please Enter City/Village</span>
          </div>
        </div>
        <!-- State -->
        <div class="col-md-4">
          <div class="fg">
              <label for="ddlPermanentState">State</label>
              <select id="ddlPermanentState">
