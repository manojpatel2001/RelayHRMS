                    <div class="fg">
                        <label for="ddlCountry">Country</label>
                        <div style="display:flex;gap:6px">
                            <select id="ddlCountry" style="flex:1">
                                <option selected disabled value="">Select</option>
                                <!-- Add more options as needed -->
                            </select>
                            <button type="button" id="btnCountryModal" class="btn" style="cursor:pointer;">
                                +
                            </button>
                        </div>
                    </div>
                </div>


                <!-- Work Phone No -->
                <div class="col-md-4">
                    <div class="fg">
                        <label for="txtWorkPhone">Work Phone No</label>
                        <input type="text" id="txtWorkPhone" placeholder="Work Phone No" step="1" min="0" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        <span id="spnWorkPhone" class="field-validation-error" style="display:none;">Please Enter Work Phone No</span>
                    </div>
                </div>

                <!-- Personal Phone No -->
                <div class="col-md-4">
                    <div class="fg">
                        <label for="txtPersonalPhone">Personal Phone No</label>
                        <input type="text" id="txtPersonalPhone" placeholder="Personal Phone No" step="1" min="0" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        <span id="spnPersonalPhone" class="field-validation-error" style="display:none;">Please Enter Personal Phone No</span>
                    </div>
                </div>
            </div>

            <div class="row px-5">
                <!-- Official Email -->
                <div class="col-md-4">
