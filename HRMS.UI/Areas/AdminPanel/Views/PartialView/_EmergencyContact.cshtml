@inject IConfiguration Configuration
@{
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">
    <div class="sec-lbl">Emergency Contact</div>
    <form id="emergencyContactForm">
        <div class="form-grid-3">
            <div class="fg fg-req">
                <label for="txtEmergencyName">Name</label>
                <input type="text" id="txtEmergencyName" placeholder="Name" />
                <span id="spnEmergencyName" class="field-validation-error" style="display:none;">Please Enter Name</span>
            </div>

            <div class="fg fg-req">
                <label for="ddlEmergencyRelationship">Relationship</label>
                <select id="ddlEmergencyRelationship">
                    <option value="">Select</option>
                </select>
                <span id="spnEmergencyRelationship" class="field-validation-error" style="display:none;">Please Select Relationship</span>
            </div>

            <div class="fg fg-req">
                <label for="txtEmergencyMobile">Mobile</label>
                <input type="text" id="txtEmergencyMobile" placeholder="Mobile" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" />
                <span id="spnEmergencyMobile" class="field-validation-error" style="display:none;">Please Enter Mobile</span>
            </div>

            <div class="fg">
                <label for="txtEmergencyHomePhone">Home Phone</label>
                <input type="text" id="txtEmergencyHomePhone" placeholder="Home Phone" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" />
                <span id="spnEmergencyHomePhone" class="field-validation-error" style="display:none;">Please Enter Home Phone</span>
            </div>

            <div class="fg">
                <label for="txtEmergencyWorkPhone">Work Phone</label>
                <input type="text" id="txtEmergencyWorkPhone" placeholder="Work Phone" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" />
                <span id="spnEmergencyWorkPhone" class="field-validation-error" style="display:none;">Please Enter Work Phone</span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <button type="button" class="btn btn-secondary btn-sm" id="btnResetEmergencyContact">Reset</button>
            <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveEmergencyContact">
                <span class="btn-spinner-icon"></span>
                <span class="btn-label-text">Save</span>
            </button>
        </div>
    </form>

    <div class="divider"></div>
    <div id="gridContainerEmergency" class="mt-2"></div>
</div>

<script>
    (function () {
        const user = `${localStorage.getItem('EmployeeId')}`;
        let EmployeeIdEmegency = localStorage.getItem('CurrentEmployeeId');

        let EmergencyContactId = 0;
        let _contactCache = {};

        var grid = WMSGrid.create({
            container: 'gridContainerEmergency',
            title: 'Emergency Contacts',
            icon: 'bx-phone-call',
            perPage: 10,
            columns: [
                { field: 'name', header: 'Name', width: '160px' },
                { field: 'relationName', header: 'Relation', width: '140px' },
                { field: 'mobileNo', header: 'Mobile No', width: '130px' },
                { field: 'homePhoneNo', header: 'Home Phone', width: '130px' },
                { field: 'workPhoneNo', header: 'Work Phone', width: '130px' },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '120px',
                    render: function (v, row) {
                        return '<button class="wg-btn wg-btn-primary" onclick="_editEmergencyContact(' + row.emergencyContactId + ')"><i class="bx bx-edit"></i></button> ' +
                               '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteEmergencyContact(' + row.emergencyContactId + ',\'' + (row.name || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
                    }
                }
            ]
        });

        function loadEmergencyContactff() {
            grid.showLoader();
            $.ajax({
                url: '@baseUrl/EmergencyContactAPI/GetAllEmergencyContacts/' + EmployeeIdEmegency,
                type: 'GET', _silentLoader: true,
                success: function (data) {
                    var rows = data.isSuccess ? (data.data || []) : [];
                    _contactCache = {};
                    rows.forEach(function (r) { _contactCache[r.emergencyContactId] = r; });
                    grid.setData(rows);
                    grid.hideLoader();
                },
                error: function () { grid.hideLoader(); showToast('Failed to load emergency contacts.', 'error'); }
            });
        }

        function loadBindRelationShiptOption() {
            $.ajax({
                url: '@baseUrl/RelationShipAPI/GetAllRelationShips', type: 'GET',
                success: function (data) {
                    if (data.isSuccess) {
                        var dropdowns = $('#ddlEmergencyRelationship');
                        dropdowns.empty();
                        dropdowns.append($('<option>', { value: '', text: 'Select', selected: true, disabled: true }));
                        $.each(data.data, function (index, x) {
                            dropdowns.append($('<option>', { value: x.relationShipId, text: x.relationName }));
                        });
                    }
                },
                error: function () { console.error('Failed to load relationships.'); }
            });
        }

        $(document).ready(function () {
            loadEmergencyContactff();
            loadBindRelationShiptOption();
        });

        $('#btnSaveEmergencyContact').click(function () {
            if (!validateEmergencyContactForm()) return;

            setBtnLoading('#btnSaveEmergencyContact', EmergencyContactId > 0 ? 'Updating...' : 'Saving...');

            const contact = {
                EmployeeId: EmployeeIdEmegency,
                EmergencyContactId: EmergencyContactId || 0,
                Name: $('#txtEmergencyName').val().trim(),
                RelationShipId: $('#ddlEmergencyRelationship').val(),
                MobileNo: $('#txtEmergencyMobile').val().trim(),
                HomePhoneNo: $('#txtEmergencyHomePhone').val().trim() === '' ? null : $('#txtEmergencyHomePhone').val().trim(),
                WorkPhoneNo: $('#txtEmergencyWorkPhone').val().trim() === '' ? null : $('#txtEmergencyWorkPhone').val().trim(),
                CreatedBy: EmergencyContactId == 0 ? user : null,
                UpdatedBy: EmergencyContactId == 0 ? null : user
            };
            const isNew = EmergencyContactId === 0;
            const url = isNew ? '@baseUrl/EmergencyContactAPI/CreateEmergencyContact' : '@baseUrl/EmergencyContactAPI/UpdateEmergencyContact';
            const method = isNew ? 'POST' : 'PUT';

            $.ajax({
                url: url, type: method, contentType: 'application/json',
                data: JSON.stringify(contact),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        resetEmergencyContactForm();
                        loadEmergencyContactff();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveEmergencyContact', EmergencyContactId > 0 ? 'Update' : 'Save');
                },
                error: function (err) {
                    console.error(err);
                    setBtnNormal('#btnSaveEmergencyContact', EmergencyContactId > 0 ? 'Update' : 'Save');
                }
            });
        });

        $('#btnResetEmergencyContact').click(function () { resetEmergencyContactForm(); });

        function resetEmergencyContactForm() {
            EmergencyContactId = 0;
            $('#txtEmergencyName, #txtEmergencyMobile, #txtEmergencyHomePhone, #txtEmergencyWorkPhone').val('');
            $('#ddlEmergencyRelationship').val('');
            $('#spnEmergencyName, #spnEmergencyRelationship, #spnEmergencyMobile, #spnEmergencyHomePhone, #spnEmergencyWorkPhone').hide();
            setBtnNormal('#btnSaveEmergencyContact', 'Save');
        }

        window._editEmergencyContact = function (emergencyContactId) {
            resetEmergencyContactForm();
            const rowData = _contactCache[emergencyContactId];
            if (!rowData) return;

            EmergencyContactId = emergencyContactId;
            $('#txtEmergencyName').val(rowData.name);
            $('#ddlEmergencyRelationship').val(rowData.relationShipId);
            $('#txtEmergencyMobile').val(rowData.mobileNo);
            $('#txtEmergencyHomePhone').val(rowData.homePhoneNo);
            $('#txtEmergencyWorkPhone').val(rowData.workPhoneNo);
            setBtnNormal('#btnSaveEmergencyContact', 'Update');
        };

        window._deleteEmergencyContact = function (emergencyContactId, name) {
            wmsConfirm('Are you sure you want to delete emergency contact <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { id: emergencyContactId, deletedBy: localStorage.getItem('EmployeeId') };
                $.ajax({
                    url: '@baseUrl/EmergencyContactAPI/DeleteEmergencyContact',
                    type: 'DELETE', contentType: 'application/json',
                    data: JSON.stringify(deleteObj),
                    success: function (response) {
                        showToast(response.isSuccess ? response.responseMessage : response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadEmergencyContactff();
                    },
                    error: function () { showToast('Something went wrong. Please try again.', 'error'); }
                });
            });
        };

        function validateEmergencyContactForm() {
            let isValid = true;

            if ($('#txtEmergencyName').val().trim() === '') {
                $('#spnEmergencyName').show(); isValid = false;
            } else { $('#spnEmergencyName').hide(); }

            if (!$('#ddlEmergencyRelationship').val()) {
                $('#spnEmergencyRelationship').show(); isValid = false;
            } else { $('#spnEmergencyRelationship').hide(); }

            let mobile = $('#txtEmergencyMobile').val();
            if (mobile === '') {
                $('#spnEmergencyMobile').text('Please Enter Phone Number').show(); isValid = false;
            } else if (mobile.length !== 10) {
                $('#spnEmergencyMobile').text('Number must be 10 digits').show(); isValid = false;
            } else { $('#spnEmergencyMobile').hide(); }

            let homePhone = $('#txtEmergencyHomePhone').val();
            if (homePhone && homePhone.length !== 10) {
                $('#spnEmergencyHomePhone').text('Number must be 10 digits').show(); isValid = false;
            } else { $('#spnEmergencyHomePhone').hide(); }

            let workPhone = $('#txtEmergencyWorkPhone').val();
            if (workPhone && workPhone.length !== 10) {
                $('#spnEmergencyWorkPhone').text('Number must be 10 digits').show(); isValid = false;
            } else { $('#spnEmergencyWorkPhone').hide(); }

            return isValid;
        }
    })();
</script>
