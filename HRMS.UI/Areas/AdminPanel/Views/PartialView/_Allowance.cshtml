@inject IConfiguration Configuration
@{
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
    .salary-report .sec-card {
        border: 1px solid #D0D8DC;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        margin-bottom: 16px;
    }

    .salary-report .sec-card-hdr {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        background: #DDE6ED;
        border-bottom: 1px solid #D0D8DC;
        font-weight: 700;
        font-size: 12.5px;
        color: #3B5068;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .salary-report table {
        width: 100%;
        border-collapse: collapse;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 13px;
    }

    .salary-report thead th {
        background: #DDE6ED;
        padding: 8px 12px;
        font-size: 11px;
        font-weight: 700;
        color: #3B5068;
        text-align: left;
        border-bottom: 2px solid #B8C4CC;
    }

    .salary-report tbody td {
        padding: 9px 12px;
        border-bottom: 1px solid #D8E2E8;
        color: #1A1A1A;
    }

    .salary-report tbody tr:nth-child(even) td {
        background: #F5F8FA;
    }

    .salary-report tbody tr:hover td {
        background: #EAF2F8 !important;
    }

    .salary-report .amount {
        font-weight: 600;
        color: #1A1A1A;
        text-align: right;
    }

    .salary-report .row-total td {
        background: #DDE6ED !important;
        font-weight: 700;
        border-bottom: none;
    }

    .salary-report .row-net td {
        background: #E8F5E9 !important;
        color: #2E7D32;
        font-weight: 700;
        border-bottom: none;
    }

    .salary-report .row-ctc td {
        background: #E3F2FD !important;
        color: #1565C0;
        font-weight: 700;
        border-bottom: none;
    }

    .salary-summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
        margin-top: 4px;
    }

    .salary-summary-card {
        border: 1px solid #D8E2E8;
        border-radius: 8px;
        background: #F9FBFC;
        padding: 14px 16px;
        text-align: center;
    }

    .salary-summary-card h4 {
        margin: 0 0 6px 0;
        font-size: 12px;
        font-weight: 600;
        color: #778899;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .salary-summary-card .amount {
        font-size: 1.4em;
        font-weight: 700;
        color: #2F6F8E;
    }
</style>

<div class="wms-form-page salary-report">
    <div class="sec-lbl" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        Salary Breakdown Report
        <span style="display:inline-flex;align-items:center;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:#E3F2FD;border:1px solid #90CAF9;color:#1565C0;">Monthly Gross: <span id="monthlyGross" style="margin-left:4px"></span></span>
        <span style="display:inline-flex;align-items:center;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;background:#E8F5E9;border:1px solid #A5D6A7;color:#2E7D32;">Annual Package: <span id="AnualGross" style="margin-left:4px"></span></span>
    </div>

    <div id="SalaryContainer">
        <div class="sec-card">
            <div class="sec-card-hdr"><i class="bx bx-wallet"></i> Salary Components &amp; Earnings</div>
            <table>
                <thead>
                    <tr><th>Component</th><th class="amount">Per Month (₹)</th><th class="amount">Per Annum (₹)</th></tr>
                </thead>
                <tbody>
                    <tr><td>Basic Salary</td><td id="basicSalaryMonth" class="amount"></td><td id="basicSalaryYear" class="amount"></td></tr>
                    <tr><td>HRA (Housing Rent Allowance)</td><td id="hraMonth" class="amount"></td><td id="hraYear" class="amount"></td></tr>
                    <tr><td>Deputation Allowance</td><td id="deputationAllowanceMonth" class="amount"></td><td id="deputationAllowanceYear" class="amount"></td></tr>
                    <tr><td>Conveyance Allowance</td><td id="conveyanceAllowanceMonth" class="amount"></td><td id="conveyanceAllowanceYear" class="amount"></td></tr>
                    <tr><td>Medical Allowance</td><td id="medicalAllowanceMonth" class="amount"></td><td id="medicalAllowanceYear" class="amount"></td></tr>
                    <tr><td>Child Education Allowance</td><td id="childEducationAllowanceMonth" class="amount"></td><td id="childEducationAllowanceYear" class="amount"></td></tr>
                    <tr class="row-total"><td>TOTAL GROSS SALARY</td><td id="totalGrossMonth" class="amount"></td><td id="totalGrossYear" class="amount"></td></tr>
                </tbody>
            </table>
        </div>

        <div class="sec-card">
            <div class="sec-card-hdr"><i class="bx bx-trending-down"></i> Deductions</div>
            <table>
                <thead>
                    <tr><th>Deduction Type</th><th class="amount">Per Month (₹)</th><th class="amount">Per Annum (₹)</th></tr>
                </thead>
                <tbody>
                    <tr><td>Provident Fund (PF)</td><td id="pfMonth" class="amount"></td><td id="pfYear" class="amount"></td></tr>
                    <tr><td>ESI Contribution</td><td id="esiMonth" class="amount"></td><td id="esiYear" class="amount"></td></tr>
                    <tr><td>Professional Tax (PT)</td><td id="ptMonth" class="amount"></td><td id="ptYear" class="amount"></td></tr>
                    <tr><td>Group Medical Insurance</td><td id="groupMedicalMonth" class="amount"></td><td id="groupMedicalYear" class="amount"></td></tr>
                    <tr><td>Term Insurance</td><td id="termInsuranceMonth" class="amount"></td><td id="termInsuranceYear" class="amount"></td></tr>
                    <tr class="row-total"><td>TOTAL DEDUCTIONS</td><td id="totalDeductionMonth" class="amount"></td><td id="totalDeductionYear" class="amount"></td></tr>
                    <tr class="row-net"><td>NET SALARY (Take Home)</td><td id="netSalaryMonth" class="amount"></td><td id="netSalaryYear" class="amount"></td></tr>
                </tbody>
            </table>
        </div>

        <div class="sec-card">
            <div class="sec-card-hdr"><i class="bx bx-bar-chart-alt-2"></i> CTC Calculation</div>
            <table>
                <thead>
                    <tr><th>Component</th><th class="amount">Per Month (₹)</th><th class="amount">Per Annum (₹)</th></tr>
                </thead>
                <tbody>
                    <tr><td>Gross Salary</td><td id="CalculationGrossMonth" class="amount"></td><td id="CalculationGrossYear" class="amount"></td></tr>
                    <tr><td>Employer PF Contribution</td><td id="CalculationPFMonth" class="amount"></td><td id="CalculationPFYear" class="amount"></td></tr>
                    <tr><td>Employer ESI Contribution</td><td id="CalculationESIMonth" class="amount"></td><td id="CalculationESIYear" class="amount"></td></tr>
                    <tr class="row-ctc"><td>TOTAL CTC</td><td id="ctcMonth" class="amount"></td><td id="ctcYear" class="amount"></td></tr>
                </tbody>
            </table>
        </div>

        <div class="salary-summary-cards">
            <div class="salary-summary-card">
                <h4>Monthly CTC</h4>
                <div id="summaryCtc" class="amount"></div>
            </div>
            <div class="salary-summary-card">
                <h4>Take Home Salary</h4>
                <div id="summaryNet" class="amount"></div>
            </div>
            <div class="salary-summary-card">
                <h4>Annual Package</h4>
                <div id="summaryAnnual" class="amount"></div>
            </div>
        </div>
    </div>
    <div id="salaryNoFound" style="display:none;padding:20px;text-align:center;color:#778899;">No Record Found!</div>
</div>

<script>
    (function () {
        $(document).ready(function () {
            loadLiveSalaryAllowance();
        });

        $('#txtGrossSalary, #txtBasicSalary').on('blur', function () {
            loadLiveSalaryAllowance();
        });

        async function loadLiveSalaryAllowance() {
            var grossSalary = $('#txtGrossSalary').val();
            var basicSalary = $('#txtBasicSalary').val();
            var isPFApplicable = $('#isPFApplicable').is(':checked');
            if (basicSalary == null || basicSalary === '') {
                basicSalary = 0;
            }

            if (!grossSalary) {
                $('#SalaryContainer').hide();
                $('#salaryNoFound').show();
                return;
            }

            try {
                const response = await fetch('@baseUrl/EmployeeSalaryAllowanceAPI/GetLiveEmployeeSalaryAllowance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        IsPFApplicable: isPFApplicable,
                        GrossSalary: grossSalary,
                        BasicSalary: basicSalary,
                        CompanyId: CurrentCompanyId,
                        EmployeeId: CurrentEmployeeId
                    })
                });

                const data = await response.json();
                if (data.isSuccess) {
                    $('#SalaryContainer').show();
                    $('#salaryNoFound').hide();
                    bindSalaryAllowance(data.data);
                } else {
                    $('#SalaryContainer').hide();
                    $('#salaryNoFound').show();
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }

        function formatCurrency(value) {
            return '₹' + (value ?? 0).toFixed(2);
        }

        function bindSalaryAllowance(salaryData) {
            $('#monthlyGross').text(formatCurrency(salaryData.totalGrossSalary));
            $('#AnualGross').text(formatCurrency(salaryData.totalGrossSalary * 12));
            $('#txtBasicSalary').val(salaryData.basicSalary);
            $('#txtctcSalary').val(salaryData.ctc);
            $('#basicSalaryMonth').text(formatCurrency(salaryData.basicSalary));
            $('#basicSalaryYear').text(formatCurrency(salaryData.basicSalary * 12));
            $('#hraMonth').text(formatCurrency(salaryData.hra));
            $('#hraYear').text(formatCurrency(salaryData.hra * 12));
            $('#deputationAllowanceMonth').text(formatCurrency(salaryData.deputationAllowance));
            $('#deputationAllowanceYear').text(formatCurrency(salaryData.deputationAllowance * 12));
            $('#conveyanceAllowanceMonth').text(formatCurrency(salaryData.conveyanceAllowance));
            $('#conveyanceAllowanceYear').text(formatCurrency(salaryData.conveyanceAllowance * 12));
            $('#medicalAllowanceMonth').text(formatCurrency(salaryData.medicalAllowance));
            $('#medicalAllowanceYear').text(formatCurrency(salaryData.medicalAllowance * 12));
            $('#childEducationAllowanceMonth').text(formatCurrency(salaryData.childEducationAllowance));
            $('#childEducationAllowanceYear').text(formatCurrency(salaryData.childEducationAllowance * 12));
            $('#totalGrossMonth').text(formatCurrency(salaryData.totalGrossSalary));
            $('#totalGrossYear').text(formatCurrency(salaryData.totalGrossSalary * 12));

            $('#pfMonth').text(formatCurrency(salaryData.employeePF));
            $('#pfYear').text(formatCurrency(salaryData.employeePF * 12));
            $('#esiMonth').text(formatCurrency(salaryData.employeeESI));
            $('#esiYear').text(formatCurrency(salaryData.employeeESI * 12));
            $('#ptMonth').text(formatCurrency(salaryData.professionalTax));
            $('#ptYear').text(formatCurrency(salaryData.professionalTax * 12));
            $('#groupMedicalMonth').text(formatCurrency(salaryData.groupMedical));
            $('#groupMedicalYear').text(formatCurrency(salaryData.groupMedical * 12));
            $('#termInsuranceMonth').text(formatCurrency(salaryData.termInsurance));
            $('#termInsuranceYear').text(formatCurrency(salaryData.termInsurance * 12));
            $('#totalDeductionMonth').text(formatCurrency(salaryData.totalDeductions));
            $('#totalDeductionYear').text(formatCurrency(salaryData.totalDeductions * 12));

            $('#netSalaryMonth').text(formatCurrency(salaryData.netSalary));
            $('#netSalaryYear').text(formatCurrency(salaryData.netSalary * 12));

            $('#CalculationGrossMonth').text(formatCurrency(salaryData.totalGrossSalary));
            $('#CalculationGrossYear').text(formatCurrency(salaryData.ctc * 12));
            $('#CalculationPFMonth').text(formatCurrency(salaryData.employeePF));
            $('#CalculationPFYear').text(formatCurrency(salaryData.employeePF * 12));
            $('#CalculationESIMonth').text(formatCurrency(salaryData.employeeESI));
            $('#CalculationESIYear').text(formatCurrency(salaryData.employeeESI * 12));

            $('#ctcMonth').text(formatCurrency(salaryData.ctc));
            $('#ctcYear').text(formatCurrency(salaryData.ctc * 12));

            $('#summaryCtc').text(formatCurrency(salaryData.ctc));
            $('#summaryNet').text(formatCurrency(salaryData.netSalary));
            $('#summaryAnnual').text(formatCurrency(salaryData.ctc * 12));
        }

        window.loadLiveSalaryAllowance = loadLiveSalaryAllowance;
    })();
</script>
