@inject IConfiguration Configuration
@{
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">
    <div class="sec-lbl">Attachment</div>
    <form id="attachmentForm">
        <div class="form-grid-3">
            <div class="fg fg-req">
                <label for="documentName">Document Name</label>
                <select id="documentName">
                    <option value="" selected disabled>Select</option>
                </select>
                <span id="spnDocumentName" class="field-validation-error" style="display:none;">Please Select Document Name</span>
            </div>

            <div class="fg fg-req" style="position:relative;">
                <label for="documentFile">Document</label>
                <input type="file" id="documentFile" />
                <a href="#" target="_blank" id="documentViewLink" style="display:none;position:absolute;right:10px;top:34px;color:#1565C0;font-size:12px;text-decoration:none;cursor:pointer;">view</a>
                <span id="spnDocumentFile" class="field-validation-error" style="display:none;">Please Upload Document</span>
            </div>

            <div class="fg">
                <label for="expiryDate">Date of Expiry</label>
                <input type="date" id="expiryDate" />
            </div>

            <div class="fg" style="grid-column:span 3;">
                <label for="attachmentComments">Comments</label>
                <textarea id="attachmentComments" placeholder="Comments" rows="2"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <button type="button" class="btn btn-secondary btn-sm" id="btnResetAttachment">Reset</button>
            <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveAttachment">
                <span class="btn-spinner-icon"></span>
                <span class="btn-label-text">Save</span>
            </button>
        </div>
    </form>

    <div class="divider"></div>
    <div id="gridContainerAttachment" class="mt-2"></div>
</div>

<script>
    (function () {
        const userAttachment = localStorage.getItem('EmployeeId');
        let attachmentDetailsId = 0;
        let documentUrl = null;
        let _attachmentCache = {};

        var grid = WMSGrid.create({
            container: 'gridContainerAttachment',
            title: 'Attachments',
            icon: 'bx-paperclip',
            perPage: 10,
            columns: [
                { field: 'documentName', header: 'Document Name', width: '170px' },
                {
                    header: 'Attachment', sortable: false, width: '110px',
                    render: function (v, row) {
                        return row.documentUrl ? '<a href="' + row.documentUrl + '" target="_blank">View</a>' : 'N/A';
                    }
                },
                { field: 'comment', header: 'Comment', width: '180px' },
                {
                    header: 'Expiry Date', sortable: false, width: '120px',
                    render: function (v, row) { return formatToDDMMYYYY(row.dateOfExpiry); }
                },
                {
                    header: 'Created Date', sortable: false, width: '120px',
                    render: function (v, row) { return formatToDDMMYYYY(row.createdDate); }
                },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '120px',
                    render: function (v, row) {
                        return '<button class="wg-btn wg-btn-primary" onclick="_editAttachment(' + row.attachmentDetailsId + ')"><i class="bx bx-edit"></i></button> ' +
                               '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteAttachment(' + row.attachmentDetailsId + ')"><i class="bx bx-trash"></i></button>';
                    }
                }
            ]
        });

        function loadDocumentType() {
            $.ajax({
                url: '@baseUrl/AttachmentDetailsAPI/GetAllDocumentTypes',
                method: 'GET',
                success: function (response) {
                    var dropdown = $('#documentName');
                    dropdown.empty();
                    dropdown.append('<option disabled selected value="">Select</option>');
                    $.each(response.data, function (index, doc) {
                        dropdown.append($('<option>', { value: doc.documentTypeId, text: doc.documentName }));
                    });
                },
                error: function () { console.error('Error fetching document types.'); }
            });
        }

        function loadAttachmentDetails() {
            grid.showLoader();
            $.ajax({
                url: '@baseUrl/AttachmentDetailsAPI/GetAllAttachmentDetails/' + CurrentEmployeeId,
                type: 'GET', _silentLoader: true,
                success: function (data) {
                    var rows = data.isSuccess ? (data.data || []) : [];
                    _attachmentCache = {};
                    rows.forEach(function (r) { _attachmentCache[r.attachmentDetailsId] = r; });
                    grid.setData(rows);
                    grid.hideLoader();
                },
                error: function () { grid.hideLoader(); showToast('Failed to load attachments.', 'error'); }
            });
        }

        function formatToDDMMYYYY(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            return `${day}-${month}-${year}`;
        }

        $(document).ready(function () {
            loadAttachmentDetails();
            loadDocumentType();
        });

        $('#btnSaveAttachment').click(function () {
            if (!validateAttachForm()) return;

            setBtnLoading('#btnSaveAttachment', attachmentDetailsId > 0 ? 'Updating...' : 'Saving...');

            var formData = new FormData();
            formData.append('EmployeeId', CurrentEmployeeId);
            formData.append('DocumentTypeId', $('#documentName').val());
            formData.append('Comment', $('#attachmentComments').val());
            formData.append('DateOfExpiry', $('#expiryDate').val());
            formData.append('CreatedBy', userAttachment);
            formData.append('AttachmentDetailsId', attachmentDetailsId);

            const attachUrl = attachmentDetailsId == 0 ? '@baseUrl/AttachmentDetailsAPI/CreateAttachmentDetail' : '@baseUrl/AttachmentDetailsAPI/UpdateAttachmentDetail';
            const methodType = attachmentDetailsId == 0 ? 'POST' : 'PUT';

            var fileInput = $('#documentFile')[0];
            if (fileInput.files.length > 0) {
                formData.append('AttachmentFile', fileInput.files[0]);
            }

            $.ajax({
                url: attachUrl, type: methodType,
                data: formData, processData: false, contentType: false,
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        resetAttachmentForm();
                        loadAttachmentDetails();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveAttachment', attachmentDetailsId > 0 ? 'Update' : 'Save');
                },
                error: function (error) {
                    console.error('Error:', error);
                    setBtnNormal('#btnSaveAttachment', attachmentDetailsId > 0 ? 'Update' : 'Save');
                }
            });
        });

        $('#btnResetAttachment').click(function () { resetAttachmentForm(); });

        $('#documentFile').on('change', function () {
            const fileInput = this;
            if (fileInput.files && fileInput.files[0]) {
                const fileAttachURL = URL.createObjectURL(fileInput.files[0]);
                $('#documentViewLink').attr('href', fileAttachURL).show();
            } else {
                $('#documentViewLink').attr('href', '#').hide();
            }
        });

        window._editAttachment = function (id) {
            resetAttachmentForm();
            const rowData = _attachmentCache[id];
            if (!rowData) return;

            attachmentDetailsId = id;
            $('#documentName').val(rowData.documentTypeId);
            $('#attachmentComments').val(rowData.comment);
            $('#expiryDate').val(rowData.dateOfExpiry ? rowData.dateOfExpiry.substring(0, 10) : '');
            if (rowData.documentUrl) {
                documentUrl = rowData.documentUrl;
                $('#documentViewLink').attr('href', rowData.documentUrl).show();
            } else {
                $('#documentViewLink').hide();
            }
            setBtnNormal('#btnSaveAttachment', 'Update');
        };

        window._deleteAttachment = function (id) {
            wmsConfirm('Are you sure you want to delete this attachment?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { id: id, deletedBy: localStorage.getItem('EmployeeId') };
                $.ajax({
                    url: '@baseUrl/AttachmentDetailsAPI/DeleteAttachmentDetail',
                    type: 'DELETE', contentType: 'application/json',
                    data: JSON.stringify(deleteObj),
                    success: function (response) {
                        showToast(response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadAttachmentDetails();
                    },
                    error: function () { showToast('Something went wrong. Please try again.', 'error'); }
                });
            });
        };

        function validateAttachForm() {
            let isValid = true;

            if (!$('#documentName').val()) {
                $('#spnDocumentName').show(); isValid = false;
            } else { $('#spnDocumentName').hide(); }

            if ($('#documentFile')[0].files.length === 0 && documentUrl == null) {
                $('#spnDocumentFile').show(); isValid = false;
            } else { $('#spnDocumentFile').hide(); }

            return isValid;
        }

        function resetAttachmentForm() {
            $('#documentName').val('');
            $('#attachmentComments').val('');
            $('#expiryDate').val('');
            $('#documentFile').val('');
            $('#spnDocumentName, #spnDocumentFile').hide();
            setBtnNormal('#btnSaveAttachment', 'Save');
            attachmentDetailsId = 0;
            documentUrl = null;
            $('#documentViewLink').hide();
        }
    })();
</script>
