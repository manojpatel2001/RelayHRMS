@inject IConfiguration Configuration
@{
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Reporting Manager</h6>
                </div>
                <div class="card-body">
                    <div class="form-grid-3">
                        <div class="fg fg-req">
                            <label for="effectDateEdit">Effect Date</label>
                            <input type="date" id="effectDateEdit" />
                            <span id="spnEffectDate" class="field-validation-error" style="display:none;">Please Enter Effect Date</span>
                        </div>

                        <div class="fg fg-req">
                            <label for="reportingManagerEdit">Reporting Manager</label>
                            <select id="reportingManagerEdit">
                                <option value="">Select</option>
                            </select>
                            <span id="spnReporting" class="field-validation-error" style="display:none;">Please Select Reporting Manager</span>
                        </div>

                        <div class="fg">
                            <label for="methodEdit">Method</label>
                            <select id="methodEdit">
                                <option value="">Select</option>
                                <option value="Email">Email</option>
                                <option value="Phone Call">Phone Call</option>
                                <option value="Video Call">Video Call</option>
                                <option value="In Person">In Person</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn btn-secondary btn-sm" id="btnResetReporting">Reset</button>
                        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveReportingManager">
                            <span class="btn-spinner-icon"></span>
                            <span class="btn-label-text">Save</span>
                        </button>
                    </div>

                    <div class="divider"></div>
                    <div id="gridContainerReportingManager" class="mt-2"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Contract</h6>
                </div>
                <div class="card-body">
                    <div class="form-grid-3">
                        <div class="fg fg-req">
                            <label for="projectEdit">Project</label>
                            <div style="display:flex;gap:6px">
                                <select id="projectEdit" style="flex:1">
                                    <option value="">Select</option>
                                </select>
                                <button type="button" class="btn btn-outline" id="btnProjectModal" title="Add Project"><i class="bx bx-plus"></i></button>
                            </div>
                            <span id="spnProject" class="field-validation-error" style="display:none;">Please Select Project</span>
                        </div>

                        <div class="fg fg-req">
                            <label for="startDateEdit">Start Date</label>
                            <input type="date" id="startDateEdit" />
                            <span id="spnStartDate" class="field-validation-error" style="display:none;">Please Enter Start Date</span>
                        </div>

                        <div class="fg fg-req">
                            <label for="endDateEdit">End Date</label>
                            <input type="date" id="endDateEdit" />
                            <span id="spnEndDate" class="field-validation-error" style="display:none;">Please Enter End Date</span>
                        </div>

                        <div class="fg" style="grid-column:span 3;">
                            <label for="commentsEdit">Comments</label>
                            <textarea id="commentsEdit" placeholder="Comments" rows="2"></textarea>
                        </div>

                        <div class="form-check" style="margin:0">
                            <input class="form-check-input" type="checkbox" id="renew">
                            <label class="form-check-label" for="renew">Renew</label>
                        </div>

                        <div class="form-check" style="grid-column:span 2;margin:0">
                            <input class="form-check-input" type="checkbox" id="contractReminder">
                            <label class="form-check-label" for="contractReminder">Reminder For Contract Renew/Finished</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn btn-secondary btn-sm" id="btnResetContract">Reset</button>
                        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveContract">
                            <span class="btn-spinner-icon"></span>
                            <span class="btn-label-text">Save</span>
                        </button>
                    </div>

                    <div class="divider"></div>
                    <div id="gridContainerContract" class="mt-2"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addProjectModal" tabindex="-1" aria-labelledby="addProjectLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="addProjectLabel"><span class="formType">Add Project</span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body modal-body-font">
                <div class="wms-form-page">
                    <div class="fg fg-req">
                        <label for="ProjectInput">Project Name</label>
                        <input type="text" id="ProjectInput" placeholder="Project Name" />
                        <span id="spnProjectName" class="field-validation-error" style="display:none;">Please Enter Project Name</span>
                    </div>

                    <div class="fg">
                        <label for="ProjectDesc">Description</label>
                        <input type="text" placeholder="Description" id="ProjectDesc" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveProject">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const userReporting = localStorage.getItem('EmployeeId');
        let EmployeeIdReporting = localStorage.getItem('CurrentEmployeeId');

        let reportingDetails = [];
        let ReportingManagerDetailsId = 0;
        let _reportingCache = {};

        let ContractDetailsId = 0;
        let ContractDetails = [];
        let _contractCache = {};

        function formatToDDMMYYYY(dateInput) {
            if (!dateInput) return '';
            const dateObj = new Date(dateInput);
            if (isNaN(dateObj.getTime())) return '';
            const day = String(dateObj.getDate()).padStart(2, '0');
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const year = dateObj.getFullYear();
            return `${day}-${month}-${year}`;
        }

        function fillSelect(id, data, valueKey, textKey, placeholder) {
            var el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = '';
            var ph = document.createElement('option');
            ph.value = '';
            ph.textContent = placeholder || 'Select';
            el.appendChild(ph);
            (data || []).forEach(function (d) {
                var o = document.createElement('option');
                o.value = d[valueKey];
                o.textContent = d[textKey] || '';
                el.appendChild(o);
            });
        }

        var reportingGrid = WMSGrid.create({
            container: 'gridContainerReportingManager',
            title: 'Reporting Manager History',
            icon: 'bx-user-voice',
            perPage: 10,
            columns: [
                {
                    header: 'Manager Name', sortable: false, width: '180px',
                    render: function (v, row) { return (row.employeeCode || '') + ' - ' + (row.reportingManagerName || ''); }
                },
                { field: 'methodName', header: 'Method', width: '120px' },
                {
                    header: 'Effected Date', sortable: false, width: '120px',
                    render: function (v, row) { return formatToDDMMYYYY(row.effectedDate); }
                },
                {
                    header: 'Created Date', sortable: false, width: '120px',
                    render: function (v, row) { return formatToDDMMYYYY(row.createdDate); }
                },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '110px',
                    render: function (v, row) {
                        return '<button class="wg-btn wg-btn-primary" onclick="_editReportingManager(' + row.reportingManagerDetailsId + ')"><i class="bx bx-edit"></i></button> ' +
                               '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteReportingManager(' + row.reportingManagerDetailsId + ')"><i class="bx bx-trash"></i></button>';
                    }
                }
            ]
        });

        var contractGrid = WMSGrid.create({
            container: 'gridContainerContract',
            title: 'Contract History',
            icon: 'bx-file',
            perPage: 10,
            columns: [
                { field: 'projectName', header: 'Project Name', width: '150px' },
                {
                    header: 'Start Date', sortable: false, width: '110px',
                    render: function (v, row) { return formatToDDMMYYYY(row.startDate); }
                },
                {
                    header: 'End Date', sortable: false, width: '110px',
                    render: function (v, row) { return formatToDDMMYYYY(row.endDate); }
                },
                { field: 'comment', header: 'Comments', width: '160px' },
                {
                    header: 'Renew', sortable: false, width: '80px',
                    render: function (v, row) { return row.isRenew ? 'Yes' : 'No'; }
                },
                {
                    header: 'Reminder', sortable: false, width: '90px',
                    render: function (v, row) { return row.isContractRenew ? 'Yes' : 'No'; }
                },
                {
                    header: 'Created Date', sortable: false, width: '120px',
                    render: function (v, row) { return formatToDDMMYYYY(row.createdDate); }
                },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '110px',
                    render: function (v, row) {
                        return '<button class="wg-btn wg-btn-primary" onclick="_editContractDetail(' + row.contractDetailsId + ')"><i class="bx bx-edit"></i></button> ' +
                               '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteContractDetail(' + row.contractDetailsId + ')"><i class="bx bx-trash"></i></button>';
                    }
                }
            ]
        });

        function loadReportingDetails() {
            reportingGrid.showLoader();
            $.ajax({
                url: '@baseUrl/ReportingManagerDetailsAPI/GetAllReportingManagerDetails/' + EmployeeIdReporting,
                type: 'GET', _silentLoader: true,
                success: function (data) {
                    var rows = data.isSuccess ? (data.data || []) : [];
                    reportingDetails = rows;
                    _reportingCache = {};
                    rows.forEach(function (r) { _reportingCache[r.reportingManagerDetailsId] = r; });
                    reportingGrid.setData(rows);
                    reportingGrid.hideLoader();
                },
                error: function () { reportingGrid.hideLoader(); showToast('Failed to load reporting manager history.', 'error'); }
            });
        }

        function bindReportingManager() {
            return $.ajax({
                type: 'GET',
                url: '@baseUrl/EmployeeMasterAPI/GetReportingList'
            }).then(function (response) {
                if (response.isSuccess) {
                    fillSelect('reportingManagerEdit', response.data, 'employeeId', 'employeeName', 'Reporting Manager');
                }
            }).catch(function (error) { console.error('AJAX Error:', error); });
        }

        function validateReportingManagerForm() {
            let isValid = true;

            if (!$('#effectDateEdit').val()) {
                $('#spnEffectDate').show(); isValid = false;
            } else { $('#spnEffectDate').hide(); }

            if (!$('#reportingManagerEdit').val()) {
                $('#spnReporting').show(); isValid = false;
            } else { $('#spnReporting').hide(); }

            return isValid;
        }

        function resetReportingForm() {
            $('#effectDateEdit').val('');
            $('#reportingManagerEdit').val('');
            $('#methodEdit').val('');
            $('#spnEffectDate, #spnReporting').hide();
            ReportingManagerDetailsId = 0;
            setBtnNormal('#btnSaveReportingManager', 'Save');
        }

        $(document).ready(function () {
            bindReportingManager().then(function () { loadReportingDetails(); });
            loadContractDetails();
            bindProjectDropdown();
        });

        $('#btnSaveReportingManager').click(function () {
            if (!validateReportingManagerForm()) return;

            setBtnLoading('#btnSaveReportingManager', ReportingManagerDetailsId > 0 ? 'Updating...' : 'Saving...');

            var payloadReporting = {
                reportingManagerDetailsId: ReportingManagerDetailsId,
                employeeId: EmployeeIdReporting,
                effectedDate: $('#effectDateEdit').val(),
                reportingManagerId: $('#reportingManagerEdit').val(),
                methodName: $('#methodEdit').val() === '' ? null : $('#methodEdit').val(),
                createdBy: userReporting
            };

            const reportingUrl = ReportingManagerDetailsId == 0 ? '@baseUrl/ReportingManagerDetailsAPI/CreateReportingManagerDetail' : '@baseUrl/ReportingManagerDetailsAPI/UpdateReportingManagerDetail';
            const methodTypeReporting = ReportingManagerDetailsId == 0 ? 'POST' : 'PUT';

            $.ajax({
                type: methodTypeReporting, url: reportingUrl,
                data: JSON.stringify(payloadReporting), contentType: 'application/json',
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        resetReportingForm();
                        loadReportingDetails();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveReportingManager', ReportingManagerDetailsId > 0 ? 'Update' : 'Save');
                },
                error: function () {
                    showToast('Error saving data.', 'error');
                    setBtnNormal('#btnSaveReportingManager', ReportingManagerDetailsId > 0 ? 'Update' : 'Save');
                }
            });
        });

        $('#btnResetReporting').click(function () { resetReportingForm(); });

        window._editReportingManager = function (id) {
            resetReportingForm();
            const rowData = _reportingCache[id];
            if (!rowData) return;

            ReportingManagerDetailsId = id;
            $('#reportingManagerEdit').val(rowData.reportingManagerId);
            $('#methodEdit').val(rowData.methodName);
            $('#effectDateEdit').val(rowData.effectedDate ? rowData.effectedDate.substring(0, 10) : '');
            setBtnNormal('#btnSaveReportingManager', 'Update');
        };

        window._deleteReportingManager = function (id) {
            wmsConfirm('Are you sure you want to delete this reporting manager record?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { id: id, deletedBy: localStorage.getItem('EmployeeId') };
                $.ajax({
                    url: '@baseUrl/ReportingManagerDetailsAPI/DeleteReportingManagerDetail',
                    type: 'DELETE', contentType: 'application/json',
                    data: JSON.stringify(deleteObj),
                    success: function (response) {
                        showToast(response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadReportingDetails();
                    },
                    error: function () { showToast('Something went wrong. Please try again.', 'error'); }
                });
            });
        };

        $('#btnSaveContract').click(function () {
            if (!validateContractForm()) return;

            setBtnLoading('#btnSaveContract', ContractDetailsId > 0 ? 'Updating...' : 'Saving...');

            const payloadContract = {
                contractDetailsId: ContractDetailsId,
                employeeId: EmployeeIdReporting,
                ProjectDetailsId: $('#projectEdit').val(),
                startDate: $('#startDateEdit').val(),
                endDate: $('#endDateEdit').val(),
                comment: $('#commentsEdit').val() || null,
                IsRenew: $('#renew').is(':checked') || false,
                IsContractRenew: $('#contractReminder').is(':checked') || false,
                createdBy: ContractDetailsId == 0 ? userReporting : null,
                updatedBy: ContractDetailsId == 0 ? null : userReporting
            };

            const urlContract = ContractDetailsId === 0 ? '@baseUrl/ContractDetailsAPI/CreateContractDetail' : '@baseUrl/ContractDetailsAPI/UpdateContractDetail';
            const methodTypeContract = ContractDetailsId === 0 ? 'POST' : 'PUT';

            $.ajax({
                type: methodTypeContract, url: urlContract,
                data: JSON.stringify(payloadContract), contentType: 'application/json',
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        resetContractForm();
                        loadContractDetails();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveContract', ContractDetailsId > 0 ? 'Update' : 'Save');
                },
                error: function () {
                    showToast('Error saving contract.', 'error');
                    setBtnNormal('#btnSaveContract', ContractDetailsId > 0 ? 'Update' : 'Save');
                }
            });
        });

        $('#btnResetContract').click(function () { resetContractForm(); });

        function resetContractForm() {
            ContractDetailsId = 0;
            $('#projectEdit').val('');
            $('#startDateEdit').val('');
            $('#endDateEdit').val('');
            $('#commentsEdit').val('');
            $('#renew').prop('checked', false);
            $('#contractReminder').prop('checked', false);
            $('#spnProject, #spnStartDate, #spnEndDate').hide();
            setBtnNormal('#btnSaveContract', 'Save');
        }

        function validateContractForm() {
            let isValid = true;

            if (!$('#projectEdit').val()) {
                $('#spnProject').show(); isValid = false;
            } else { $('#spnProject').hide(); }

            if (!$('#startDateEdit').val()) {
                $('#spnStartDate').show(); isValid = false;
            } else { $('#spnStartDate').hide(); }

            if (!$('#endDateEdit').val()) {
                $('#spnEndDate').show(); isValid = false;
            } else { $('#spnEndDate').hide(); }

            return isValid;
        }

        function loadContractDetails() {
            contractGrid.showLoader();
            $.ajax({
                url: '@baseUrl/ContractDetailsAPI/GetAllContractDetails/' + EmployeeIdReporting,
                type: 'GET', _silentLoader: true,
                success: function (data) {
                    var rows = data.isSuccess ? (data.data || []) : [];
                    ContractDetails = rows;
                    _contractCache = {};
                    rows.forEach(function (r) { _contractCache[r.contractDetailsId] = r; });
                    contractGrid.setData(rows);
                    contractGrid.hideLoader();
                },
                error: function () { contractGrid.hideLoader(); showToast('Failed to load contract history.', 'error'); }
            });
        }

        function bindProjectDropdown() {
            $.ajax({
                type: 'GET',
                url: '@baseUrl/ProjectDetailsAPI/GetAllProjectDetails/' + EmployeeIdReporting,
                success: function (data) {
                    if (data.isSuccess) {
                        fillSelect('projectEdit', data.data, 'projectDetailsId', 'projectName', 'Select');
                    }
                },
                error: function (xhr, status, error) { console.error('AJAX Error: ' + status + ' - ' + error); }
            });
        }

        window._editContractDetail = function (id) {
            resetContractForm();
            const rowData = _contractCache[id];
            if (!rowData) return;

            ContractDetailsId = id;
            $('#projectEdit').val(rowData.projectDetailsId);
            $('#startDateEdit').val(rowData.startDate ? rowData.startDate.substring(0, 10) : '');
            $('#endDateEdit').val(rowData.endDate ? rowData.endDate.substring(0, 10) : '');
            $('#commentsEdit').val(rowData.comment);
            $('#renew').prop('checked', rowData.isRenew || false);
            $('#contractReminder').prop('checked', rowData.isContractRenew || false);
            setBtnNormal('#btnSaveContract', 'Update');
        };

        window._deleteContractDetail = function (id) {
            wmsConfirm('Are you sure you want to delete this contract record?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { id: id, deletedBy: localStorage.getItem('EmployeeId') };
                $.ajax({
                    url: '@baseUrl/ContractDetailsAPI/DeleteContractDetail',
                    type: 'DELETE', contentType: 'application/json',
                    data: JSON.stringify(deleteObj),
                    success: function (response) {
                        showToast(response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadContractDetails();
                    },
                    error: function () { showToast('Something went wrong. Please try again.', 'error'); }
                });
            });
        };

        $('#btnProjectModal').on('click', function () {
            $('#spnProjectName').hide();
            $('#ProjectInput').val('');
            $('#ProjectDesc').val('');
            setBtnNormal('#btnSaveProject', 'Save');
            $('#addProjectModal').modal('show');
        });

        $('#btnSaveProject').on('click', function () {
            var projectName = $('#ProjectInput').val().trim();
            var projectDescription = $('#ProjectDesc').val().trim();
            if (!projectName) {
                $('#spnProjectName').show();
                return;
            }
            $('#spnProjectName').hide();

            setBtnLoading('#btnSaveProject', 'Saving...');

            var projectPayload = {
                ProjectDetailsId: 0,
                ProjectName: projectName,
                Description: projectDescription === '' ? null : projectDescription,
                CompanyId: EmployeeIdReporting,
                createdBy: userReporting
            };
            $.ajax({
                url: '@baseUrl/ProjectDetailsAPI/CreateProjectDetail',
                type: 'POST', contentType: 'application/json',
                data: JSON.stringify(projectPayload),
                success: function (data) {
                    if (data.isSuccess) {
                        showToast(data.responseMessage, 'success');
                        bindProjectDropdown();
                        $('#addProjectModal').modal('hide');
                    } else {
                        showToast(data.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveProject', 'Save');
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    showToast('An error occurred while adding the project.', 'error');
                    setBtnNormal('#btnSaveProject', 'Save');
                }
            });
        });
    })();
</script>
