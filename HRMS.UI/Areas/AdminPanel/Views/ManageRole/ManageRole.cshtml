@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Manage Role";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Manage Role</h6>
		<button id="addRole" type="button" class="btn btn-primary btn-sm">Add Role</button>
	</div>
	<div class="card-body">
		<div id="gridContainerRole"></div>
	</div>
</div>

<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title"><span class="formType">Add</span> Role</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row">
					<div class="col-12">
						<div class="form-group mt-3 position-relative">
							<input type="text" class="form-control floating-input" placeholder="Role Name" id="txtRoleName" autocomplete="off" />
							<label class="floating-label" for="txtRoleName">Role Name <span class="required-star">*</span></label>
						</div>
						<span id="spnRoleName" style="color:red; display:none;">Please enter a role name.</span>
					</div>
					<div class="col-12">
						<div class="form-group mt-3 position-relative">
							<input type="text" class="form-control floating-input" placeholder="Slug" id="txtSlug" autocomplete="off" />
							<label class="floating-label" for="txtSlug">Slug <span class="required-star">*</span></label>
						</div>
						<span id="spnSlug" style="color:red; display:none;">Please enter a slug.</span>
					</div>
					<div class="col-12">
						<div class="form-group mt-3 position-relative">
							<input type="text" class="form-control floating-input" placeholder="Description" id="txtDescription" autocomplete="off" />
							<label class="floating-label" for="txtDescription">Description <span class="required-star">*</span></label>
						</div>
						<span id="spnDescription" style="color:red; display:none;">Please enter a description.</span>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnAddRole">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Save</span>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var RoleId = 0;
	var _roleCache = {};

	var grid = WMSGrid.create({
		container: 'gridContainerRole',
		title: 'All Roles',
		icon: 'bx-shield',
		perPage: 10,
		columns: [
			{ field: 'name',        header: 'Role Name',   width: '200px' },
			{ field: 'slug',        header: 'Slug',        width: '160px' },
			{ field: 'description', header: 'Description', width: '260px' },
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '130px',
				render: function (v, row) {
					return '<button class="wg-btn wg-btn-primary" onclick="_editRole(' + row.id + ')"><i class="bx bx-edit"></i> Edit</button> ' +
					       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteRole(' + row.id + ',\'' + (row.name || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
				}
			}
		],
		features: { export: true }
	});

	function loadRoleTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/RoleAPI/GetAllRoles', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_roleCache = {};
				rows.forEach(function (r) { _roleCache[r.id] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) { showToast(data.responseMessage || 'No records found.', 'info'); }
			},
			error: function () { grid.hideLoader(); showToast('Failed to load roles.', 'error'); }
		});
	}

	$('#addRole').on('click', function () { resetForm(); $('#addRoleModal').modal('show'); });
	$('#addRoleModal').on('hidden.bs.modal', function () { resetForm(); });

	$('#btnAddRole').on('click', function () {
		var name = $('#txtRoleName').val().trim();
		var slug = $('#txtSlug').val().trim();
		var desc = $('#txtDescription').val().trim();

		var isValid = true;
		if (!name) { $('#spnRoleName').show(); $('#txtRoleName').addClass('is-invalid'); isValid = false; } else { $('#spnRoleName').hide(); $('#txtRoleName').removeClass('is-invalid'); }
		if (!slug) { $('#spnSlug').show(); $('#txtSlug').addClass('is-invalid'); isValid = false; } else { $('#spnSlug').hide(); $('#txtSlug').removeClass('is-invalid'); }
		if (!desc) { $('#spnDescription').show(); $('#txtDescription').addClass('is-invalid'); isValid = false; } else { $('#spnDescription').hide(); $('#txtDescription').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnAddRole', RoleId > 0 ? 'Updating...' : 'Saving...');

		$.ajax({
			url:         RoleId > 0 ? '@baseUrl/RoleAPI/UpdateRole' : '@baseUrl/RoleAPI/CreateRole',
			type:        RoleId > 0 ? 'PUT' : 'POST',
			contentType: 'application/json', _silentLoader: true,
			headers:     { 'Authorization': 'Bearer ' + Token },
			data:        JSON.stringify({ RoleId: RoleId, RoleName: name, Slug: slug, Description: desc }),
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (RoleId > 0 ? 'Role updated.' : 'Role created.'), 'success');
					$('#addRoleModal').modal('hide');
					loadRoleTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnAddRole', RoleId > 0 ? 'Update' : 'Save');
				}
			},
			error: function () {
				showToast('Something went wrong. Please try again.', 'error');
				setBtnNormal('#btnAddRole', RoleId > 0 ? 'Update' : 'Save');
			}
		});
	});

	function resetForm() {
		RoleId = 0;
		$('#txtRoleName, #txtSlug, #txtDescription').val('').removeClass('is-invalid');
		$('#spnRoleName, #spnSlug, #spnDescription').hide();
		$('.formType').text('Add');
		setBtnNormal('#btnAddRole', 'Save');
	}

	window._editRole = function (id) {
		var data = _roleCache[id];
		if (!data) return;
		resetForm();
		RoleId = data.id;
		$('#txtRoleName').val(data.name || '');
		$('#txtSlug').val(data.slug || '');
		$('#txtDescription').val(data.description || '');
		$('.formType').text('Update');
		setBtnNormal('#btnAddRole', 'Update');
		$('#addRoleModal').modal('show');
	};

	window._deleteRole = function (id, name) {
		wmsConfirm('Are you sure you want to delete role <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/RoleAPI/DeleteRole', type: 'DELETE',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify({ id: id, deletedBy: null }),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Role deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadRoleTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () { loadRoleTable(); });
})();
</script>
