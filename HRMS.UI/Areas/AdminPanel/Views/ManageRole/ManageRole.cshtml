@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Manage Role";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
	<div class="card-header d-flex align-items-center justify-content-between px-4 py-3">
		<div>
			<h5 class="mb-0 fw-semibold" style="color: var(--hp-blue-dark); font-size:16px;">Manage Role</h5>
			<small id="rowCountRole" class="text-muted" style="font-size:12px;"></small>
		</div>
		<button id="addRole" type="button"
				class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
				<path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2z"/>
			</svg>
			Add Role
		</button>
	</div>

	<div class="card-body px-4 py-3">
		<div id="tagRoleGrid">
			<div id="gridContainerRole"></div>
		</div>
		<div id="spnNoRecord"
			 style="display:none; padding:48px; text-align:center; color:var(--hp-text-muted); font-size:14px;">
			No records found.
		</div>
	</div>
</div>


<!-- ═══════════════════════  ADD / EDIT ROLE MODAL  ═══════════════════════ -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h6 class="modal-title">
					<span class="formType">Add</span> Role
				</h6>
				<button type="button" class="btn-close" id="btnCloseModal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row g-3">

					<div class="col-12">
						<label class="form-label" for="txtRoleName">
							Role Name <span class="text-danger">*</span>
						</label>
						<input type="text" class="form-control" id="txtRoleName"
							   placeholder="Enter role name" autocomplete="off">
						<div id="spnRoleName" class="text-danger" style="display:none; font-size:12px; margin-top:4px;">
							Please enter a role name.
						</div>
					</div>

					<div class="col-12">
						<label class="form-label" for="txtSlug">
							Slug <span class="text-danger">*</span>
						</label>
						<input type="text" class="form-control" id="txtSlug"
							   placeholder="Enter slug" autocomplete="off">
						<div id="spnSlug" class="text-danger" style="display:none; font-size:12px; margin-top:4px;">
							Please enter a slug.
						</div>
					</div>

					<div class="col-12">
						<label class="form-label" for="txtDescription">
							Description <span class="text-danger">*</span>
						</label>
						<input type="text" class="form-control" id="txtDescription"
							   placeholder="Enter description" autocomplete="off">
						<div id="spnDescription" class="text-danger" style="display:none; font-size:12px; margin-top:4px;">
							Please enter a description.
						</div>
					</div>

				</div>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" id="btnCancelRole">
					Cancel
				</button>
				<button type="button"
						class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"
						id="btnAddRole">
					<span class="btn-spinner-icon" id="btnSaveSpinner"></span>
					<span class="btn-label-text" id="btnSaveText">Save</span>
				</button>
			</div>

		</div>
	</div>
</div>
<!-- ════════════════════════════════════════════════════════════════════════ -->

<script src="~/assets/js/jquery.min.js"></script>
<script>
(function () {
	'use strict';

	/* ── App globals ─────────────────────────────────────────────────── */
	var savedCompany = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
	var Token        = localStorage.getItem('authToken');
	var RoleId       = 0;           /* 0 = Add,  >0 = Edit */

	/* ── Bootstrap 5 modal instance ─────────────────────────────────── */
	var _modalEl   = null;
	var _modalInst = null;

	function _initModal() {
		_modalEl = document.getElementById('addRoleModal');
		if (!_modalEl) return;
		if (window.bootstrap && bootstrap.Modal) {
			_modalInst = new bootstrap.Modal(_modalEl, {
				keyboard: true,
				backdrop: true
			});
		}
		/* Always reset the form (and re-enable Save) whenever modal finishes closing */
		_modalEl.addEventListener('hidden.bs.modal', function () {
			resetForm();
		});
	}

	function showModal() {
		/* Belt-and-suspenders: ensure modal is always a <body> direct child */
		if (_modalEl && _modalEl.parentNode !== document.body) {
			document.body.appendChild(_modalEl);
			if (window.bootstrap && bootstrap.Modal) {
				_modalInst = new bootstrap.Modal(_modalEl, { keyboard: true, backdrop: true });
			}
		}
		if      (_modalInst)              _modalInst.show();
		else if (window.jQuery && $.fn.modal) $('#addRoleModal').modal('show');
		else { _modalEl.style.display = 'block'; _modalEl.classList.add('show'); }
	}

	function hideModal() {
		if      (_modalInst)              _modalInst.hide();
		else if (window.jQuery && $.fn.modal) $('#addRoleModal').modal('hide');
		else { _modalEl.style.display = 'none'; _modalEl.classList.remove('show'); }
	}

	/* ── Button loading helpers ──────────────────────────────────────── */
	function btnStartLoading(labelText) {
		$('#btnAddRole').prop('disabled', true);
		$('#btnSaveSpinner').css('display', 'inline-block');
		$('#btnSaveText').text(labelText || 'Saving...');
	}

	function btnStopLoading(labelText) {
		$('#btnAddRole').prop('disabled', false);
		$('#btnSaveSpinner').css('display', 'none');
		$('#btnSaveText').text(labelText || 'Save');
	}

	/* ── Validation ─────────────────────────────────────────────────── */
	function validateForm() {
		var ok = true;
		var fields = [
			{ input: '#txtRoleName',    msg: '#spnRoleName' },
			{ input: '#txtSlug',        msg: '#spnSlug' },
			{ input: '#txtDescription', msg: '#spnDescription' }
		];
		$.each(fields, function (_, f) {
			var empty = $(f.input).val().trim() === '';
			$(f.input).toggleClass('is-invalid', empty);
			$(f.msg)[empty ? 'show' : 'hide']();
			if (empty) ok = false;
		});
		return ok;
	}

	/* ── Reset form ─────────────────────────────────────────────────── */
	function resetForm() {
		RoleId = 0;
		$('#txtRoleName, #txtSlug, #txtDescription')
			.val('')
			.removeClass('is-invalid');
		$('#spnRoleName, #spnSlug, #spnDescription').hide();
		btnStopLoading('Save');
		$('.formType').text('Add');
	}

	/* ── "Add Role" header button ────────────────────────────────────── */
	$('#addRole').on('click', function () {
		resetForm();
		showModal();
	});

	/* ── Close / Cancel (explicit — not relying solely on data-bs-dismiss) */
	$(document).on('click', '#btnCloseModal, #btnCancelRole', function () {
		hideModal();
	});

	/* ── Clear validation on typing ─────────────────────────────────── */
	$(document).on('input', '#addRoleModal .form-control', function () {
		if ($(this).val().trim()) {
			$(this).removeClass('is-invalid');
			$(this).closest('.col-12').find('.text-danger').hide();
		}
	});

	/* ── Save / Update ───────────────────────────────────────────────── */
	$(document).on('click', '#btnAddRole', function () {
		if (!validateForm()) return;           /* validation failed — do nothing */

		var isUpdate  = RoleId > 0;
		btnStartLoading(isUpdate ? 'Updating...' : 'Saving...');

		var roleData = {
			RoleId:      RoleId,
			RoleName:    $('#txtRoleName').val().trim(),
			Slug:        $('#txtSlug').val().trim(),
			Description: $('#txtDescription').val().trim()
		};

		$.ajax({
			url:         isUpdate ? '@baseUrl/RoleAPI/UpdateRole' : '@baseUrl/RoleAPI/CreateRole',
			method:      isUpdate ? 'PUT' : 'POST',
			contentType: 'application/json',
			headers:     { 'Authorization': 'Bearer ' + Token },
			data:        JSON.stringify(roleData),
			success: function (r) {
				if (r.isSuccess) {
					hrmsNotify.success(isUpdate ? 'Record updated successfully.' : 'Record created successfully.');
					hideModal();
					loadRoleTable();
				} else {
					hrmsNotify.error(r.responseMessage || 'Something went wrong. Please try again.');
					btnStopLoading(isUpdate ? 'Update' : 'Save');
				}
			},
			error: function () {
				hrmsNotify.error('Something went wrong. Please try again.');
				btnStopLoading(isUpdate ? 'Update' : 'Save');
			}
		});
	});

	/* ── Ready ───────────────────────────────────────────────────────── */
	$(document).ready(function () {
		_initModal();
		loadRoleTable();
	});

	/* ── Load / Refresh grid ─────────────────────────────────────────── */
	function loadRoleTable() {
		if (typeof showLoader === 'function') showLoader();

		fetch('@baseUrl/RoleAPI/GetAllRoles', {
			method:  'GET',
			headers: { 'Accept': 'application/json', 'Authorization': 'Bearer ' + Token }
		})
		.then(function (resp) { return resp.json(); })
		.then(function (data) {
			if (data.isSuccess) {
				$('#spnNoRecord').hide();
				$('#tagRoleGrid').show();

				/* Safe dispose — avoids DevExtreme E0009 console error */
				var $g = $('#gridContainerRole');
				if ($.data($g[0], 'dxDataGrid')) { $g.dxDataGrid('dispose'); }

				$g.dxDataGrid({
					dataSource:            data.data,
					rowHeight:             32,
					width:                 '100%',
					columnsAutoWidth:      false,
					wordWrapEnabled:       false,
					showBorders:           true,
					rowAlternationEnabled: true,
					grouping:              { autoExpandAll: true },
					paging:                { pageSize: 10 },
					pager: {
						showPageSizeSelector:  true,
						allowedPageSizes:      [10, 25, 50, 100],
						showInfo:              true,
						infoText:              'Showing {0}–{1} of {2} Records',
						showNavigationButtons: true
					},
					headerFilter:        { visible: true },
					filterRow:           { visible: true, applyFilter: 'auto' },
					allowColumnResizing: true,
					groupPanel:          { visible: true },
					searchPanel:         { visible: true, width: 240, placeholder: 'Search...' },
					columnFixing:        { enabled: true },
					scrolling:           { mode: 'standard', useNative: false, scrollByContent: true, scrollByThumb: true },
					onContentReady: function (e) {
						var n = e.component.totalCount();
						$('#rowCountRole').text(n > 0 ? 'Total Records: ' + n : '');
					},
					columns: [
						{ dataField: 'name',        caption: 'Role Name',   minWidth: 180 },
						{ dataField: 'slug',        caption: 'Slug',        minWidth: 140 },
						{ dataField: 'description', caption: 'Description', minWidth: 200 },
						{
							type:           'buttons',
							caption:        'Actions',
							width:          80,
							fixed:          true,
							fixedPosition:  'right',
							allowFiltering: false,
							allowSorting:   false,
							buttons: [
								{
									hint:     'Edit',
									icon:     'edit',
									cssClass: 'hr-grid-btn hr-grid-btn-edit',
									onClick:  function (e) { editRole(e.row.data); }
								},
								{
									hint:     'Delete',
									icon:     'trash',
									cssClass: 'hr-grid-btn hr-grid-btn-delete',
									onClick:  function (e) { deleteRole(e.row.data); }
								}
							]
						}
					]
				});
			} else {
				$('#spnNoRecord').show();
				$('#tagRoleGrid').hide();
			}
		})
		.catch(function (err) {
			console.error('loadRoleTable error:', err);
		})
		.finally(function () {
			if (typeof hideLoader === 'function') hideLoader();
		});
	}

	/* ── Edit role ───────────────────────────────────────────────────── */
	function editRole(role) {
		resetForm();
		RoleId = role.id;
		$('.formType').text('Update');
		$('#btnSaveText').text('Update');
		$('#txtRoleName').val(role.name    || '');
		$('#txtSlug').val(role.slug        || '');
		$('#txtDescription').val(role.description || '');
		showModal();
	}

	/* ── Delete role ─────────────────────────────────────────────────── */
	function deleteRole(role) {
		hrmsConfirm.delete({
			onConfirm: function (done) {
				$.ajax({
					url:          '@baseUrl/RoleAPI/DeleteRole',
					type:         'DELETE',
					contentType:  'application/json',
					headers:      { 'Authorization': 'Bearer ' + Token },
					data:         JSON.stringify({ id: role.id, deletedBy: null }),
					_silentLoader: true,   /* confirm modal owns the UX during delete */
					success: function (r) {
						done();
						if (r.isSuccess) {
							hrmsNotify.success('Record deleted successfully.');
							loadRoleTable();
						} else {
							hrmsNotify.error(r.responseMessage || 'Something went wrong. Please try again.');
						}
					},
					error: function () {
						done();
						hrmsNotify.error('Something went wrong. Please try again.');
					}
				});
			}
		});
	}

})();
</script>
