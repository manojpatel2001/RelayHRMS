@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Role Master";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
	.role-form-row {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-end;
	}

		.role-form-row .fg {
			flex: 1 1 220px;
			min-width: 200px;
		}

	.role-status-toggle {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 38px;
		padding-left: 2.5em;
	}

		.role-status-toggle .form-check-input {
			width: 2.4em;
			height: 1.3em;
			min-height: 0;
			padding: 0;
			margin-left: -2.5em;
			margin-top: 0;
			cursor: pointer;
		}

		.role-status-toggle .role-status-label {
			font-weight: 600;
			font-size: 13px;
			color: #16A34A;
		}

		.role-status-toggle .form-check-input:not(:checked) ~ .role-status-label {
			color: #94A3B8;
		}

	.role-pill {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 20px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: .3px;
	}

		.role-pill.active {
			background: #DCFCE7;
			color: #16A34A;
		}

		.role-pill.inactive {
			background: #F1F5F9;
			color: #64748B;
		}
</style>

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0"><span class="formType">Add New</span> Role</h6>
		<button type="button" class="btn btn-secondary btn-sm" id="btnCancelRoleForm" style="display:none;">
			<i class="bx bx-x"></i> Cancel
		</button>
	</div>
	<div class="card-body">
		<div class="role-form-row">
			<div class="fg fg-req">
				<label for="txtRoleName">Role Name</label>
				<input type="text" placeholder="e.g. Regional Manager" id="txtRoleName" autocomplete="off" />
				<span class="field-validation-error" id="spnRoleName" style="display:none;">Please enter a role name.</span>
			</div>
			<div class="fg fg-req">
				<label for="txtSlug">Slug</label>
				<input type="text" placeholder="e.g. regional-manager" id="txtSlug" autocomplete="off" />
				<span class="field-validation-error" id="spnSlug" style="display:none;">Please enter a slug.</span>
			</div>
			<div class="fg fg-req">
				<label for="ddlAccessLevel">Access Level</label>
				<select id="ddlAccessLevel">
					<option value="" selected disabled>-- Select Access Level --</option>
					<option value="All Modules">All Modules</option>
					<option value="Admin Panel">Admin Panel</option>
					<option value="Employee Panel">Employee Panel</option>
					<option value="Reports Only">Reports Only</option>
					<option value="Custom">Custom</option>
				</select>
				<span class="field-validation-error" id="spnAccessLevel" style="display:none;">Please select an access level.</span>
			</div>
			<div class="fg">
				<label>Status</label>
				<div class="form-check form-switch role-status-toggle">
					<input type="checkbox" class="form-check-input" role="switch" id="chkIsEnabled" checked />
					<span class="role-status-label" id="lblIsEnabled">Active</span>
				</div>
			</div>
			<div class="fg" style="flex:2 1 320px;">
				<label for="txtDescription">Description</label>
				<input type="text" placeholder="Brief description of this role" id="txtDescription" autocomplete="off" />
			</div>
		</div>
		<div class="d-flex justify-content-end gap-2 mt-3">
			<button type="button" class="btn btn-secondary btn-sm" id="btnClearRoleForm">
				<i class="bx bx-eraser"></i> Clear
			</button>
			<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnAddRole">
				<span class="btn-spinner-icon"></span>
				<i class="bx bx-save"></i>
				<span class="btn-label-text">Save Role</span>
			</button>
		</div>
	</div>
</div>

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">All Roles</h6>
	</div>
	<div class="card-body">
		<div id="gridContainerRole"></div>
	</div>
</div>

<div class="modal fade" id="viewRoleModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title">Role Details</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row gy-2">
					<div class="col-6"><strong>Role Name</strong><div id="vwRoleName">-</div></div>
					<div class="col-6"><strong>Slug</strong><div id="vwSlug">-</div></div>
					<div class="col-6"><strong>Access Level</strong><div id="vwAccessLevel">-</div></div>
					<div class="col-6"><strong>Status</strong><div id="vwIsEnabled">-</div></div>
					<div class="col-12"><strong>Description</strong><div id="vwDescription">-</div></div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var RoleId = 0;
	var _roleCache = {};

	var grid = WMSGrid.create({
		container: 'gridContainerRole',
		title: 'All Roles',
		icon: 'bx-shield',
		perPage: 10,
		columns: [
			{ field: 'name',           header: 'Role Name',       width: '180px' },
			{ field: 'accessLevel',    header: 'Access Level',    width: '160px', render: function (v) { return v || '-'; } },
			{ field: 'description',    header: 'Description',     width: '240px' },
			{
				field: 'isEnabled', header: 'Is Active', width: '110px',
				render: function (v) {
					return v ? '<span class="role-pill active">Active</span>' : '<span class="role-pill inactive">Inactive</span>';
				}
			},
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '170px',
				render: function (v, row) {
					var html = '';
					if (PermGuard.has('edit-managerole')) {
						html += '<button class="wg-btn wg-btn-primary" onclick="_editRole(' + row.id + ')"><i class="bx bx-edit"></i> Edit</button> ';
					}
					html += '<button class="wg-btn wg-btn-outline" onclick="_viewRole(' + row.id + ')"><i class="bx bx-show"></i> View</button> ';
					if (PermGuard.has('delete-managerole')) {
						html += '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deleteRole(' + row.id + ',\'' + (row.name || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
					}
					return html;
				}
			}
		],
		features: { export: true }
	});

	function loadRoleTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/RoleAPI/GetAllRoles', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_roleCache = {};
				rows.forEach(function (r) { _roleCache[r.id] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) { showToast(data.responseMessage || 'No records found.', 'info'); }
			},
			error: function () { grid.hideLoader(); showToast('Failed to load roles.', 'error'); }
		});
	}

	$('#chkIsEnabled').on('change', function () {
		$('#lblIsEnabled').text(this.checked ? 'Active' : 'Inactive');
	});

	$('#btnClearRoleForm, #btnCancelRoleForm').on('click', function () { resetForm(); });

	$('#btnAddRole').on('click', function () {
		var name = $('#txtRoleName').val().trim();
		var slug = $('#txtSlug').val().trim();
		var accessLevel = $('#ddlAccessLevel').val();
		var desc = $('#txtDescription').val().trim();
		var isEnabled = $('#chkIsEnabled').is(':checked');

		var isValid = true;
		if (!name) { $('#spnRoleName').show(); $('#txtRoleName').addClass('is-invalid'); isValid = false; } else { $('#spnRoleName').hide(); $('#txtRoleName').removeClass('is-invalid'); }
		if (!slug) { $('#spnSlug').show(); $('#txtSlug').addClass('is-invalid'); isValid = false; } else { $('#spnSlug').hide(); $('#txtSlug').removeClass('is-invalid'); }
		if (!accessLevel) { $('#spnAccessLevel').show(); $('#ddlAccessLevel').addClass('is-invalid'); isValid = false; } else { $('#spnAccessLevel').hide(); $('#ddlAccessLevel').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnAddRole', RoleId > 0 ? 'Updating...' : 'Saving...');

		$.ajax({
			url:         RoleId > 0 ? '@baseUrl/RoleAPI/UpdateRole' : '@baseUrl/RoleAPI/CreateRole',
			type:        RoleId > 0 ? 'PUT' : 'POST',
			contentType: 'application/json', _silentLoader: true,
			headers:     { 'Authorization': 'Bearer ' + Token },
			data:        JSON.stringify({ RoleId: RoleId, RoleName: name, Slug: slug, Description: desc, AccessLevel: accessLevel, IsEnabled: isEnabled }),
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (RoleId > 0 ? 'Role updated.' : 'Role created.'), 'success');
					resetForm();
					loadRoleTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnAddRole', RoleId > 0 ? 'Update Role' : 'Save Role');
				}
			},
			error: function () {
				showToast('Something went wrong. Please try again.', 'error');
				setBtnNormal('#btnAddRole', RoleId > 0 ? 'Update Role' : 'Save Role');
			}
		});
	});

	function resetForm() {
		RoleId = 0;
		$('#txtRoleName, #txtSlug, #txtDescription').val('').removeClass('is-invalid');
		$('#ddlAccessLevel').val('').removeClass('is-invalid');
		$('#chkIsEnabled').prop('checked', true);
		$('#lblIsEnabled').text('Active');
		$('#spnRoleName, #spnSlug, #spnAccessLevel').hide();
		$('.formType').text('Add New');
		$('#btnCancelRoleForm').hide();
		setBtnNormal('#btnAddRole', 'Save Role');
	}

	window._editRole = function (id) {
		var data = _roleCache[id];
		if (!data) return;
		resetForm();
		RoleId = data.id;
		$('#txtRoleName').val(data.name || '');
		$('#txtSlug').val(data.slug || '');
		$('#txtDescription').val(data.description || '');
		$('#ddlAccessLevel').val(data.accessLevel || '');
		$('#chkIsEnabled').prop('checked', !!data.isEnabled);
		$('#lblIsEnabled').text(data.isEnabled ? 'Active' : 'Inactive');
		$('.formType').text('Update');
		$('#btnCancelRoleForm').show();
		setBtnNormal('#btnAddRole', 'Update Role');
		$('html, body').animate({ scrollTop: 0 }, 200);
	};

	window._viewRole = function (id) {
		var data = _roleCache[id];
		if (!data) return;
		$('#vwRoleName').text(data.name || '-');
		$('#vwSlug').text(data.slug || '-');
		$('#vwAccessLevel').text(data.accessLevel || '-');
		$('#vwIsEnabled').html(data.isEnabled ? '<span class="role-pill active">Active</span>' : '<span class="role-pill inactive">Inactive</span>');
		$('#vwDescription').text(data.description || '-');
		$('#viewRoleModal').modal('show');
	};

	window._deleteRole = function (id, name) {
		wmsConfirm('Are you sure you want to delete role <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/RoleAPI/DeleteRole', type: 'DELETE',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify({ id: id, deletedBy: null }),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Role deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadRoleTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () {
		PermGuard.onReady(function () {
			loadRoleTable();
			grid.setFeature('export', PermGuard.has('export-managerole'));
			// #btnAddRole is a dual-purpose Save button (create when the form is
			// blank, update when editing an existing row via _editRole) — hide it
			// only if neither action is permitted.
			if (!PermGuard.has('create-managerole') && !PermGuard.has('edit-managerole')) {
				$('#btnAddRole').closest('.d-flex').hide();
			}
		});
	});
})();
</script>
