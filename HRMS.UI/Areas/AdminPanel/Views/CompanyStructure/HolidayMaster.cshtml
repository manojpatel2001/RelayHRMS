@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Holiday Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Holiday Master</h6>
        <button id="addHolidayMaster" type="button" class="btn btn-primary btn-sm">Add Holiday</button>
    </div>
    <div class="card-body">
        <div id="holidayGrid"></div>
    </div>
</div>

<div class="modal fade" id="addHolidayMasterModel" tabindex="-1" aria-labelledby="holidayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="holidayModalLabel"><span class="formType">Add</span> Holiday Master</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="text" class="form-control floating-input" placeholder="Holiday Name" id="txtHolidayName" />
                            <label class="floating-label" for="txtHolidayName">Holiday Name <span class="required-star">*</span></label>
                        </div>
                        <span id="spnHolidayName" style="color:red; display:none;">Please Enter Holiday Name</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <select id="dropdownState" class="form-control floating-input">
                                <option value="" selected disabled>Select State</option>
                            </select>
                            <label class="floating-label" for="dropdownState">State <span class="required-star">*</span></label>
                        </div>
                        <span id="spnState" style="color:red; display:none;">Please Select State</span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative d-flex align-items-center gap-2 pt-4">
                            <label for="txtMultipleHoliday" class="mb-0">Multiple Holiday:</label>
                            <input type="checkbox" id="txtMultipleHoliday" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" placeholder="From Date" id="txtFromDate" />
                            <label class="floating-label" for="txtFromDate"><span id="spnNameFromDate">Holiday</span> Date <span class="required-star">*</span></label>
                        </div>
                        <span id="spnFromDate" style="color:red; display:none;">Please Select Holiday Date</span>
                    </div>
                    <div class="col-md-4" id="tagToDate" style="display:none;">
                        <div class="form-group mt-3 position-relative">
                            <input type="date" class="form-control floating-input" placeholder="To Date" id="txtToDate" />
                            <label class="floating-label" for="txtToDate">To Date <span class="required-star">*</span></label>
                        </div>
                        <span id="spnToDate" style="color:red; display:none;">Please Select To Date</span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group mt-3 position-relative">
                            <textarea class="form-control floating-input" placeholder="Message Text" id="txtMessageText"></textarea>
                            <label class="floating-label" for="txtMessageText">Message Text</label>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <div class="form-group mt-2 position-relative">
                            <b>Holiday Category:</b>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-2 position-relative d-flex align-items-center gap-2">
                            <input type="radio" name="category" checked id="txtNational" />
                            <label for="txtNational" class="mb-0">National</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mt-2 position-relative d-flex align-items-center gap-2">
                            <input type="radio" name="category" id="txtFestival" />
                            <label for="txtFestival" class="mb-0">Festival</label>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3">
                        <div class="form-group mt-2 position-relative d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-control-input holiday-checkbox" id="checkRepeatAnnually" />
                            <label for="checkRepeatAnnually" class="mb-0">Repeat Annually</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateHoliday">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Token = localStorage.getItem("authToken");
    const userId = localStorage.getItem("EmployeeId");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const CompId = companyDetails.CompanyId;
    let HolidayMasterId = 0;
    var _holidayCache = {};

    var grid = WMSGrid.create({
        container: 'holidayGrid', title: 'All Holidays', icon: 'bx-calendar-star', perPage: 10,
        columns: [
            { field: 'holidayName', header: 'Holiday Name', width: '160px' },
            { field: 'stateName', header: 'State', width: '120px' },
            {
                field: 'fromDate', header: 'From Date', width: '110px',
                render: function (v) { return v ? v.substring(0, 10) : ''; }
            },
            {
                field: 'toDate', header: 'To Date', width: '110px',
                render: function (v) { return v ? v.substring(0, 10) : ''; }
            },
            { field: 'holidaycategory', header: 'Category', width: '100px' },
            {
                header: 'Repeat Yearly', width: '110px', sortable: false,
                render: function (v, row) {
                    return row.repeatAnnually
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="updateHoliday(' + row.holidayMasterId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteHoliday(' + row.holidayMasterId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    $(() => {
        bindState();
        HolidayMasterDataTable();
    });

    $('#addHolidayMaster').click(function () { resetHolidayModalFields(); $('#addHolidayMasterModel').modal('show'); });
    $('#addHolidayMasterModel').on('hidden.bs.modal', function () { resetHolidayModalFields(); });

    function bindState() {
        $.ajax({
            type: 'GET', url: '@baseUrl/StateAPI/GetAllState', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                if (data.isSuccess) {
                    var $dd = $('#dropdownState');
                    $dd.empty().append('<option value="" selected disabled>Select State</option>');
                    $.each(data.data, function (i, s) { $dd.append('<option value="' + s.stateId + '">' + s.stateName + '</option>'); });
                }
            }
        });
    }

    $('#txtMultipleHoliday').on('change', function () {
        $('#spnFromDate, #spnToDate').hide();
        if ($(this).is(':checked')) { $('#tagToDate').show(); $('#spnNameFromDate').text('From'); }
        else { $('#tagToDate').hide(); $('#spnNameFromDate').text('Holiday'); }
    });

    function HolidayMasterDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/HolidayMasterAPI/GetAllHolidayMaster/' + CompId, _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                var rows = data.isSuccess ? (data.data || []) : [];
                _holidayCache = {};
                rows.forEach(function (r) { _holidayCache[r.holidayMasterId] = r; });
                grid.setData(rows); grid.hideLoader();
            },
            error: function () { grid.hideLoader(); showToast('Failed to load holidays.', 'error'); }
        });
    }

    $('#btnCreateHoliday').click(function () {
        var holidayName = $('#txtHolidayName').val();
        var state = $('#dropdownState').val();
        var fromDate = $('#txtFromDate').val();
        var toDate = $('#txtToDate').val();
        var messageText = $('#txtMessageText').val()?.trim();

        if (!$('#txtMultipleHoliday').is(':checked')) { toDate = fromDate; }

        var isValid = true;
        if (!holidayName) { $('#spnHolidayName').show(); $('#txtHolidayName').addClass('is-invalid'); isValid = false; } else { $('#spnHolidayName').hide(); $('#txtHolidayName').removeClass('is-invalid'); }
        if (!state) { $('#spnState').show(); $('#dropdownState').addClass('is-invalid'); isValid = false; } else { $('#spnState').hide(); $('#dropdownState').removeClass('is-invalid'); }
        if (!fromDate) { $('#spnFromDate').show(); $('#txtFromDate').addClass('is-invalid'); isValid = false; } else { $('#spnFromDate').hide(); $('#txtFromDate').removeClass('is-invalid'); }
        if ($('#txtMultipleHoliday').is(':checked') && !toDate) { $('#spnToDate').show(); $('#txtToDate').addClass('is-invalid'); isValid = false; } else { $('#spnToDate').hide(); $('#txtToDate').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateHoliday', 'Saving...');
        var model = {
            HolidayMasterId: HolidayMasterId || 0,
            HolidayName: holidayName, StateId: state,
            MultipleHoliday: $('#txtMultipleHoliday').is(':checked'),
            FromDate: fromDate, ToDate: toDate, MessageText: messageText,
            Holidaycategory: $('input[name="category"]:checked').attr('id') === 'txtNational' ? 'National' : 'Festival',
            RepeatAnnually: $('#checkRepeatAnnually').is(':checked'),
            IsActive: true, CompanyId: CompId,
            Createdby: HolidayMasterId == 0 ? userId : null,
            UpdatedBy: HolidayMasterId == 0 ? null : userId
        };

        $.ajax({
            url: HolidayMasterId == 0 ? '@baseUrl/HolidayMasterAPI/CreateHolidayMaster' : '@baseUrl/HolidayMasterAPI/UpdateHolidayMaster',
            type: HolidayMasterId == 0 ? 'POST' : 'PUT',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(model),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (HolidayMasterId == 0 ? 'Holiday created.' : 'Holiday updated.'), 'success');
                    $('#addHolidayMasterModel').modal('hide'); HolidayMasterDataTable();
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateHoliday', 'Save');
                }
            },
            error: function () { showToast('Unable to save holiday.', 'error'); setBtnNormal('#btnCreateHoliday', 'Save'); }
        });
    });

    function updateHoliday(id) {
        var data = _holidayCache[id];
        if (!data) return;
        resetHolidayModalFields();
        HolidayMasterId = data.holidayMasterId;
        $('#txtHolidayName').val(data.holidayName || '');
        $('#dropdownState').val(data.stateId || '');
        $('#txtFromDate').val(data.fromDate ? data.fromDate.substring(0, 10) : '');
        $('#txtToDate').val(data.toDate ? data.toDate.substring(0, 10) : '');
        $('#txtMessageText').val(data.messageText || '');
        $('#txtMultipleHoliday').prop('checked', data.multipleHoliday);
        if (data.multipleHoliday) { $('#tagToDate').show(); $('#spnNameFromDate').text('From'); }
        else { $('#tagToDate').hide(); $('#spnNameFromDate').text('Holiday'); }
        if (data.holidaycategory?.toLowerCase() === 'national') { $('#txtNational').prop('checked', true); }
        else { $('#txtFestival').prop('checked', true); }
        $('#checkRepeatAnnually').prop('checked', data.repeatAnnually || false);
        $('.formType').text('Update');
        setBtnNormal('#btnCreateHoliday', 'Update');
        $('#addHolidayMasterModel').modal('show');
    }

    function deleteHoliday(id) {
        wmsConfirm('Are you sure you want to delete this holiday?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/HolidayMasterAPI/DeleteHolidayMaster', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: userId }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) HolidayMasterDataTable();
                },
                error: function () { showToast('Error deleting holiday.', 'error'); }
            });
        });
    }

    function resetHolidayModalFields() {
        HolidayMasterId = 0;
        $('#txtHolidayName, #txtFromDate, #txtToDate, #txtMessageText').val('');
        $('#txtHolidayName, #txtFromDate, #txtToDate').removeClass('is-invalid');
        $('#dropdownState').val('').removeClass('is-invalid');
        $('#txtMultipleHoliday').prop('checked', false);
        $('#tagToDate').hide(); $('#spnNameFromDate').text('Holiday');
        $('#txtNational').prop('checked', true);
        $('#checkRepeatAnnually').prop('checked', false);
        $('#spnToDate, #spnFromDate, #spnState, #spnHolidayName').hide();
        $('.formType').text('Add');
        setBtnNormal('#btnCreateHoliday', 'Save');
    }
</script>
