@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Bank Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Bank Master</h6>
        <button id="addBank" type="button" class="btn btn-primary btn-sm">Add Bank</button>
    </div>
    <div class="card-body">
        <div id="bankGrid"></div>
    </div>
</div>

<div class="modal fade" id="addBankModel" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bankModalLabel"><span class="formType">Create</span> Bank</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-6">
                        <div class="fg fg-req">
                            <label for="txtBankName">Bank Name</label>
                            <input type="text" placeholder="Bank Name" data-uppercase-only id="txtBankName" />
                            <span class="field-validation-error" id="spnBankName" style="display:none;">Please Enter Bank Name</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg fg-req">
                            <label for="txtBankCode">Bank Code</label>
                            <input type="text" placeholder="Bank Code" data-trim-input id="txtBankCode" />
                            <span class="field-validation-error" id="spnBankCode" style="display:none;">Please Enter Bank Code</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg fg-req">
                            <label for="txtBranchName">Branch Name</label>
                            <input type="text" placeholder="Branch Name" data-letters-only id="txtBranchName" />
                            <span class="field-validation-error" id="spnBranchName" style="display:none;">Please Enter Branch Name</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg fg-req">
                            <label for="txtAccountNo">Account No</label>
                            <input type="text" placeholder="Account No" data-integer-only id="txtAccountNo" />
                            <span class="field-validation-error" id="spnAccountNo" style="display:none;">Please Enter Account No</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label for="txtAddress">Address</label>
                            <textarea placeholder="Address" data-trim-input id="txtAddress"></textarea>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label for="txtCity">City</label>
                            <input type="text" placeholder="City" data-trim-input id="txtCity" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label for="txtBankBSRCode">Bank BSR Code</label>
                            <input type="text" placeholder="Bank BSR Code" data-trim-input id="txtBankBSRCode" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mt-3 d-flex align-items-center gap-2">
                            <label for="txtDefaultBank" class="mb-0">Default Bank</label>
                            <input type="checkbox" id="txtDefaultBank" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateBank">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Create</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    let BankMasterId = 0;
    var _bankCache = {};

    var grid = WMSGrid.create({
        container: 'bankGrid', title: 'All Banks', icon: 'bx-building', perPage: 10,
        columns: [
            { field: 'bankName', header: 'Bank Name', width: '160px' },
            { field: 'bankCode', header: 'Bank Code', width: '110px' },
            { field: 'branchName', header: 'Branch Name', width: '140px' },
            { field: 'accountNo', header: 'Account No', width: '130px' },
            { field: 'address', header: 'Address', width: '160px' },
            { field: 'city', header: 'City', width: '100px' },
            { field: 'bankBSRCode', header: 'BSR Code', width: '100px' },
            {
                header: 'Default', width: '90px', sortable: false,
                render: function (v, row) {
                    return row.isDefaultBank
                        ? '<span class="wg-pill wg-pill-green">Yes</span>'
                        : '<span class="wg-pill wg-pill-red">No</span>';
                }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    var html = '';
                    if (PermGuard.has('edit-companystructure-bankmaster')) {
                        html += '<button class="wg-btn wg-btn-primary" onclick="updateBankMaster(' + row.bankMasterId + ')"><i class="bx bx-edit"></i> Edit</button> ';
                    }
                    if (PermGuard.has('delete-companystructure-bankmaster')) {
                        html += '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="deleteBankMaster(' + row.bankMasterId + ')"><i class="bx bx-trash"></i></button>';
                    }
                    return html;
                }
            }
        ], features: { export: true }
    });

    $(() => {
        PermGuard.onReady(function () { loadBankMasterDataTable(); });
        PermGuard.applyActions('companystructure-bankmaster', { create: '#addBank' });
    });

    $('#addBank').click(function () { clearBankForm(); $('.formType').text('Create'); setBtnNormal('#btnCreateBank', 'Create'); $('#addBankModel').modal('show'); });
    $('#addBankModel').on('hidden.bs.modal', function () { clearBankForm(); });

    function loadBankMasterDataTable() {
        grid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/BankMasterAPI/GetAllBankMaster', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = (response.isSuccess && response.data) ? (Array.isArray(response.data) ? response.data : [response.data]) : [];
                _bankCache = {};
                rows.forEach(function (r) { _bankCache[r.bankMasterId] = r; });
                grid.setData(rows); grid.hideLoader();
            },
            error: function () { grid.hideLoader(); showToast('Failed to load banks.', 'error'); }
        });
    }

    $('#btnCreateBank').click(function () {
        var bankName = $('#txtBankName').val().trim();
        var bankCode = $('#txtBankCode').val().trim();
        var branchName = $('#txtBranchName').val().trim();
        var accountNo = $('#txtAccountNo').val().trim();
        var address = $('#txtAddress').val().trim();
        var city = $('#txtCity').val().trim();
        var bsrCode = $('#txtBankBSRCode').val().trim();
        var defaultBank = $('#txtDefaultBank').is(':checked');

        var isValid = true;
        if (!bankName) { $('#spnBankName').show(); $('#txtBankName').addClass('is-invalid'); isValid = false; } else { $('#spnBankName').hide(); $('#txtBankName').removeClass('is-invalid'); }
        if (!bankCode) { $('#spnBankCode').show(); $('#txtBankCode').addClass('is-invalid'); isValid = false; } else { $('#spnBankCode').hide(); $('#txtBankCode').removeClass('is-invalid'); }
        if (!branchName) { $('#spnBranchName').show(); $('#txtBranchName').addClass('is-invalid'); isValid = false; } else { $('#spnBranchName').hide(); $('#txtBranchName').removeClass('is-invalid'); }
        if (!accountNo) { $('#spnAccountNo').show(); $('#txtAccountNo').addClass('is-invalid'); isValid = false; } else { $('#spnAccountNo').hide(); $('#txtAccountNo').removeClass('is-invalid'); }
        if (!isValid) return;

        setBtnLoading('#btnCreateBank', BankMasterId == 0 ? 'Creating...' : 'Updating...');
        var formData = {
            bankMasterId: BankMasterId == 0 ? 0 : BankMasterId,
            bankName: bankName, bankCode: bankCode, branchName: branchName,
            accountNo: accountNo, address: address, city: city,
            bankBSRCode: bsrCode, isDefaultBank: defaultBank,
            createdBy: null, updatedBy: null
        };

        $.ajax({
            url: '@baseUrl/BankMasterAPI/CreateBankMaster', method: 'POST',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(formData),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || (BankMasterId == 0 ? 'Bank created.' : 'Bank updated.'), 'success');
                    $('#addBankModel').modal('hide'); loadBankMasterDataTable();
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateBank', BankMasterId == 0 ? 'Create' : 'Update');
                }
            },
            error: function () {
                showToast('Unable to save bank.', 'error');
                setBtnNormal('#btnCreateBank', BankMasterId == 0 ? 'Create' : 'Update');
            }
        });
    });

    function updateBankMaster(id) {
        var data = _bankCache[id];
        if (!data) return;
        clearBankForm();
        BankMasterId = data.bankMasterId;
        $('#txtBankName').val(data.bankName || '');
        $('#txtBankCode').val(data.bankCode || '');
        $('#txtBranchName').val(data.branchName || '');
        $('#txtAccountNo').val(data.accountNo || '');
        $('#txtAddress').val(data.address || '');
        $('#txtCity').val(data.city || '');
        $('#txtBankBSRCode').val(data.bankBSRCode || '');
        $('#txtDefaultBank').prop('checked', data.isDefaultBank || false);
        $('.formType').text('Update');
        setBtnNormal('#btnCreateBank', 'Update');
        $('#addBankModel').modal('show');
    }

    function deleteBankMaster(id) {
        wmsConfirm('Are you sure you want to delete this bank?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/BankMasterAPI/DeleteBankMaster', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: null }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) loadBankMasterDataTable();
                },
                error: function () { showToast('Error deleting bank.', 'error'); }
            });
        });
    }

    function clearBankForm() {
        BankMasterId = 0;
        $('#txtBankName, #txtBankCode, #txtBranchName, #txtAccountNo, #txtAddress, #txtCity, #txtBankBSRCode').val('');
        $('#txtBankName, #txtBankCode, #txtBranchName, #txtAccountNo').removeClass('is-invalid');
        $('#txtDefaultBank').prop('checked', false);
        $('#spnBankName, #spnBankCode, #spnBranchName, #spnAccountNo').hide();
        $('.formType').text('Create');
        setBtnNormal('#btnCreateBank', 'Create');
    }
</script>
