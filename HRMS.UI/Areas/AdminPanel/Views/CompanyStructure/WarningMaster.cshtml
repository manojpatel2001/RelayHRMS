@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Warning Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Warning Master</h6>
        <div class="d-flex gap-2">
            <button id="addWarningBtn" type="button" class="btn btn-primary btn-sm">Add Warning</button>
            <button id="addMapCardBtn" type="button" class="btn btn-primary btn-sm d-none">Map Card</button>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3 mt-3 ms-3" id="MappingTabs" role="tablist">
        <li class="nav-item me-2" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#typeTab" type="button" role="tab" data-tabname="Warning">Warning</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#priorityTab" type="button" role="tab" data-tabname="Level Wise Card Mapping">Level Wise Card Mapping</button>
        </li>
    </ul>

    <div class="card-body">
        <div id="warningGridSection">
            <div id="warningGrid"></div>
        </div>
        <div id="mappingGridSection" class="d-none">
            <div id="mappingGrid"></div>
        </div>
    </div>
</div>

<!-- Warning Modal -->
<div class="modal fade" id="addWarningModel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="warningFormType">Create</span> Warning</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-6">
                        <div class="fg">
                            <label for="txtWarningName">Warning Name</label>
                            <input type="text" placeholder="Warning Name" id="txtWarningName" />
                            <span class="field-validation-error" id="spnWarningName" style="display:none;">Please Enter Warning Name</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fg">
                            <label for="dropdownLevel">Level</label>
                            <select id="dropdownLevel">
                                <option value="" selected disabled>Select Level</option>
                                <option value="Stage 1">Stage 1</option>
                                <option value="Stage 2">Stage 2</option>
                                <option value="Stage 3">Stage 3</option>
                            </select>
                            <span class="field-validation-error" id="spnLevel" style="display:none;">Please Select Level</span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="fg">
                            <label for="txtRemark">Remarks</label>
                            <textarea placeholder="Remarks" id="txtRemark"></textarea>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3">
                        <div class="form-group mt-3"><b>Deduction Type:</b></div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 d-flex align-items-center gap-2">
                            <input type="radio" name="deduction" checked value="NO" id="rdoNo" />
                            <label for="rdoNo" class="mb-0">No Deduction</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 d-flex align-items-center gap-2">
                            <input type="radio" name="deduction" value="AMT" id="rdoAmount" />
                            <label for="rdoAmount" class="mb-0">Amount</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mt-3 d-flex align-items-center gap-2">
                            <input type="radio" name="deduction" value="Day" id="rdoDays" />
                            <label for="rdoDays" class="mb-0">Days</label>
                        </div>
                    </div>
                </div>

                <div class="row mt-3" id="amountTableContainer" style="display:none;">
                    <div class="col-md-12">
                        <table class="table table-bordered" id="amountTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:25%">From (Warning Count)</th>
                                    <th style="width:25%">To (Warning Count)</th>
                                    <th style="width:25%">Deduct Amount</th>
                                    <th style="width:25%">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-success" id="btnAddRow">Add Row</button>
                    </div>
                </div>

                <div class="row mt-3" id="daysTableContainer" style="display:none;">
                    <div class="col-md-12">
                        <table id="daysTable" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th style="width:25%">From (warning count)</th>
                                    <th style="width:25%">To (warning count)</th>
                                    <th style="width:25%">Deduct Days</th>
                                    <th style="width:25%">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <button type="button" id="btnAddRowDays" class="btn btn-sm btn-success">Add Row</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateWarning">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Create</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Mapping Modal -->
<div class="modal fade" id="addMappingModel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="mappingFormType">Create</span> Level Wise Card Mapping</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="row">
                    <div class="col-md-12">
                        <div class="fg">
                            <label for="dropdownLevelMap">Level</label>
                            <select id="dropdownLevelMap">
                                <option value="" selected disabled>Select Level</option>
                                <option value="Stage 1">Stage 1</option>
                                <option value="Stage 2">Stage 2</option>
                                <option value="Stage 3">Stage 3</option>
                            </select>
                            <span class="field-validation-error" id="spnLevelMap" style="display:none;">Please Select Level</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="fg">
                            <label for="txtCardCount">Card Count</label>
                            <input type="text" placeholder="Card Count" id="txtCardCount"
                                   step="1" min="0" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                            <span class="field-validation-error" id="spnCardCount" style="display:none;">Please Enter Count</span>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="fg">
                            <label for="dropdownCard">Card</label>
                            <select id="dropdownCard">
                                <option value="" selected disabled>Select Card</option>
                                <option value="Yellow Card">Yellow Card</option>
                                <option value="Red Card">Red Card</option>
                            </select>
                            <span class="field-validation-error" id="spnCard" style="display:none;">Please Select Card</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnCreateMapping">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Create</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const Token = localStorage.getItem("authToken");
    let warningMasterId = 0;
    let levelWiseCardMappingId = 0;
    let deductionTypeAmountValue = null;
    let deductionTypeDayValue = null;
    var _warningCache = {};
    var _mappingCache = {};

    // --- Grids ---
    var warningWmsGrid = WMSGrid.create({
        container: 'warningGrid', title: 'All Warnings', icon: 'bx-error-alt', perPage: 10,
        columns: [
            { field: 'warningName', header: 'Warning Name', width: '160px' },
            { field: 'level', header: 'Level', width: '100px' },
            { field: 'remarks', header: 'Remarks', width: '200px' },
            { field: 'deductionType', header: 'Deduction Type', width: '130px' },
            { field: 'deductionTypeValue', header: 'Deduction Value', width: '130px' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="openUpdateWarning(' + row.warningMasterId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="openDeleteWarning(' + row.warningMasterId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    var mappingWmsGrid = WMSGrid.create({
        container: 'mappingGrid', title: 'Level Wise Card Mapping', icon: 'bx-id-card', perPage: 10,
        columns: [
            { field: 'level', header: 'Level', width: '130px' },
            {
                header: 'Card Type', width: '180px',
                render: function (v, row) { return (row.cardNo || '') + '  ' + (row.cardType || ''); }
            },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '130px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" onclick="openUpdateMapping(' + row.levelWiseCardMappingId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="openDeleteMapping(' + row.levelWiseCardMappingId + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ], features: { export: true }
    });

    // --- Tab switching ---
    $('#MappingTabs .nav-link').on('click', function () {
        var tab = $(this).data('tabname');
        if (tab === 'Warning') {
            $('#addWarningBtn').removeClass('d-none'); $('#addMapCardBtn').addClass('d-none');
            $('#warningGridSection').removeClass('d-none'); $('#mappingGridSection').addClass('d-none');
        } else {
            $('#addWarningBtn').addClass('d-none'); $('#addMapCardBtn').removeClass('d-none');
            $('#warningGridSection').addClass('d-none'); $('#mappingGridSection').removeClass('d-none');
        }
    });

    // --- On load ---
    $(() => { loadCardWarningGrid(); loadCardMappingGrid(); });

    // --- Warning Grid ---
    function loadCardWarningGrid() {
        warningWmsGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/WarningMasterAPI/GetAllWarningMaster', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = response.isSuccess ? (response.data || []) : [];
                _warningCache = {};
                rows.forEach(function (r) { _warningCache[r.warningMasterId] = r; });
                warningWmsGrid.setData(rows); warningWmsGrid.hideLoader();
            },
            error: function () { warningWmsGrid.hideLoader(); showToast('Failed to load warnings.', 'error'); }
        });
    }

    // --- Warning buttons ---
    $('#addWarningBtn').click(function () { resetWarningForm(); $('.warningFormType').text('Create'); setBtnNormal('#btnCreateWarning', 'Create'); $('#addWarningModel').modal('show'); });

    // --- Deduction type toggle ---
    $(document).ready(function () {
        $('#rdoAmount').on('change', function () {
            if ($(this).is(':checked')) {
                $('#daysTableContainer').hide(); $('#daysTable tbody').empty();
                $('#amountTableContainer').show();
                if ($('#amountTable tbody tr').length === 0) {
                    $('#amountTable tbody').append(buildAmountRow(true));
                }
            }
        });
        $('#rdoDays').on('change', function () {
            if ($(this).is(':checked')) {
                $('#amountTableContainer').hide(); $('#amountTable tbody').empty();
                $('#daysTableContainer').show();
                if ($('#daysTable tbody tr').length === 0) {
                    $('#daysTable tbody').append(buildDaysRow(true));
                }
            }
        });
        $('#rdoNo').on('change', function () {
            $('#amountTableContainer').hide(); $('#amountTable tbody').empty();
            $('#daysTableContainer').hide(); $('#daysTable tbody').empty();
        });

        $('#btnAddRow').on('click', function () {
            var lastRow = $('#amountTable tbody tr:last');
            if (!lastRow.find('.fromCount').val() || !lastRow.find('.toCount').val() || !lastRow.find('.deductAmount').val()) {
                showToast('Please fill all fields before adding new row.', 'error'); return;
            }
            if ($('.btnSave').text() == 'Save') { showToast('Please save record before adding new row.', 'error'); return; }
            lastRow.find('input').prop('disabled', true);
            lastRow.find('.btnSave').removeClass('btnSave btn-success').addClass('btnUpdate btn-primary').text('Update');
            $('#amountTable tbody').append(buildAmountRow(false));
            toggleDeleteButtons();
        });
        $('#amountTable').on('click', '.btnDelete', function () { $(this).closest('tr').remove(); toggleDeleteButtons(); });
        $('#amountTable').on('click', '.btnSave', function () {
            var row = $(this).closest('tr');
            if (!row.find('.fromCount').val() || !row.find('.toCount').val() || !row.find('.deductAmount').val()) {
                showToast('Please fill all fields before saving.', 'error'); return;
            }
            row.find('input').prop('disabled', true);
            $(this).removeClass('btnSave btn-success').addClass('btnUpdate btn-primary').text('Update');
            deductionTypeAmountValue = getAllSavedRowData(); toggleDeleteButtons();
        });
        $('#amountTable').on('click', '.btnUpdate', function () {
            var row = $(this).closest('tr');
            row.find('input').prop('disabled', false);
            $(this).removeClass('btnUpdate btn-primary').addClass('btnSave btn-success').text('Save');
        });

        $('#btnAddRowDays').on('click', function () {
            var lastRow = $('#daysTable tbody tr:last');
            if (!lastRow.find('.fromWarn').val() || !lastRow.find('.toWarn').val() || !lastRow.find('.deductDays').val()) {
                showToast('Please fill all fields before adding new row.', 'error'); return;
            }
            if ($('.btnSaveDays').text() == 'Save') { showToast('Please save record before adding new row.', 'error'); return; }
            lastRow.find('input').prop('disabled', true);
            lastRow.find('.btnSaveDays').removeClass('btnSaveDays btn-success').addClass('btnUpdateDays btn-primary').text('Update');
            $('#daysTable tbody').append(buildDaysRow(false));
            toggleDayDeleteButtons();
        });
        $('#daysTable').on('click', '.btnDeleteDays', function () { $(this).closest('tr').remove(); toggleDayDeleteButtons(); });
        $('#daysTable').on('click', '.btnSaveDays', function () {
            var row = $(this).closest('tr');
            if (!row.find('.fromWarn').val() || !row.find('.toWarn').val() || !row.find('.deductDays').val()) {
                showToast('Please fill all fields before saving.', 'error'); return;
            }
            row.find('input').prop('disabled', true);
            $(this).removeClass('btnSaveDays btn-success').addClass('btnUpdateDays btn-primary').text('Update');
            deductionTypeDayValue = getAllSavedDaysData(); toggleDayDeleteButtons();
        });
        $('#daysTable').on('click', '.btnUpdateDays', function () {
            var row = $(this).closest('tr');
            row.find('input').prop('disabled', false);
            $(this).removeClass('btnUpdateDays btn-primary').addClass('btnSaveDays btn-success').text('Save');
        });
    });

    function buildAmountRow(isDefault) {
        return '<tr' + (isDefault ? ' class="default-row"' : '') + '>' +
            '<td><input type="text" class="form-control fromCount" placeholder="From" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><input type="text" class="form-control toCount" placeholder="To" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><input type="text" class="form-control deductAmount" placeholder="Deduct Amount" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><button type="button" class="btn btn-sm btn-success btnSave me-2">Save</button>' +
            '<button type="button" class="btn btn-sm btn-danger btnDelete"' + (isDefault ? ' style="display:none;"' : '') + '>Delete</button></td></tr>';
    }

    function buildDaysRow(isDefault) {
        return '<tr' + (isDefault ? ' class="default-row"' : '') + '>' +
            '<td><input type="text" class="form-control fromWarn" placeholder="From" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><input type="text" class="form-control toWarn" placeholder="To" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><input type="text" class="form-control deductDays" placeholder="Deduct Days" oninput="this.value=this.value.replace(/[^0-9]/g,\'\')"/></td>' +
            '<td><button type="button" class="btn btn-sm btn-success btnSaveDays me-2">Save</button>' +
            '<button type="button" class="btn btn-sm btn-danger btnDeleteDays"' + (isDefault ? ' style="display:none;"' : '') + '>Delete</button></td></tr>';
    }

    function toggleDeleteButtons() {
        if ($('#amountTable tbody tr').length <= 1) { $('.btnDelete').hide(); } else { $('.btnDelete').show(); }
    }
    function toggleDayDeleteButtons() {
        if ($('#daysTable tbody tr').length <= 1) { $('.btnDeleteDays').hide(); } else { $('.btnDeleteDays').show(); }
    }

    function getAllSavedRowData() {
        var dataArr = [];
        $('#amountTable tbody tr').each(function () {
            var row = $(this);
            if (row.find('input').prop('disabled')) {
                dataArr.push(row.find('.fromCount').val() + ',' + row.find('.toCount').val() + ',' + row.find('.deductAmount').val());
            }
        });
        return dataArr.join('|');
    }
    function getAllSavedDaysData() {
        var dataArr = [];
        $('#daysTable tbody tr').each(function () {
            var row = $(this);
            if (row.find('input').prop('disabled')) {
                dataArr.push(row.find('.fromWarn').val() + ',' + row.find('.toWarn').val() + ',' + row.find('.deductDays').val());
            }
        });
        return dataArr.join('|');
    }

    // --- Warning Create/Update ---
    $('#btnCreateWarning').click(function () {
        var warningName = $('#txtWarningName').val();
        var level = $('#dropdownLevel').val();
        var remarks = $('#txtRemark').val();
        var deductionType = $("input[name='deduction']:checked").val();
        var isValid = true;
        $('#spnLevel, #spnWarningName').hide();
        $('#txtWarningName, #dropdownLevel').removeClass('is-invalid');
        if (!warningName) { $('#spnWarningName').show(); $('#txtWarningName').addClass('is-invalid'); isValid = false; }
        if (!level) { $('#spnLevel').show(); $('#dropdownLevel').addClass('is-invalid'); isValid = false; }
        if (!isValid) return;

        setBtnLoading('#btnCreateWarning', (warningMasterId || 0) == 0 ? 'Creating...' : 'Updating...');
        var value = deductionType === 'Day' ? deductionTypeDayValue : (deductionType === 'AMT' ? deductionTypeAmountValue : null);
        var payload = { warningMasterId: warningMasterId, level: level, warningName: warningName, remarks: remarks, deductionType: deductionType, deductionTypeValue: value, createdBy: null, updatedBy: null };

        $.ajax({
            url: '@baseUrl/WarningMasterAPI/CreateOrUpdateWarningMaster', type: 'POST',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || 'Warning saved.', 'success');
                    loadCardWarningGrid(); $('#addWarningModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateWarning', warningMasterId == 0 ? 'Create' : 'Update');
                }
            },
            error: function () { showToast('Unable to save warning.', 'error'); setBtnNormal('#btnCreateWarning', warningMasterId == 0 ? 'Create' : 'Update'); }
        });
    });

    function openUpdateWarning(id) {
        var data = _warningCache[id];
        if (!data) return;
        resetWarningForm();
        warningMasterId = data.warningMasterId;
        $('#txtWarningName').val(data.warningName || '');
        $('#dropdownLevel').val(data.level || '');
        $('#txtRemark').val(data.remarks || '');
        $("input[name='deduction'][value='" + data.deductionType + "']").prop('checked', true).trigger('change');

        var renderRows = function (rows, tableSelector, type) {
            var $tbody = $(tableSelector + ' tbody').empty();
            var inputClass = type === 'Day' ? ['fromWarn', 'toWarn', 'deductDays'] : ['fromCount', 'toCount', 'deductAmount'];
            var saveCls = type === 'Day' ? 'btnSaveDays' : 'btnSave';
            var deleteCls = type === 'Day' ? 'btnDeleteDays' : 'btnDelete';
            rows.forEach(function (row) {
                var parts = row.split(',');
                var rowHtml = '<tr><td><input type="text" class="form-control ' + inputClass[0] + '" value="' + (parts[0] || '') + '" oninput="this.value=this.value.replace(/\\D/g,\'\')" /></td>' +
                    '<td><input type="text" class="form-control ' + inputClass[1] + '" value="' + (parts[1] || '') + '" oninput="this.value=this.value.replace(/\\D/g,\'\')" /></td>' +
                    '<td><input type="text" class="form-control ' + inputClass[2] + '" value="' + (parts[2] || '') + '" oninput="this.value=this.value.replace(/\\D/g,\'\')" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-primary ' + saveCls + '">Save</button> ' +
                    '<button type="button" class="btn btn-sm btn-danger ' + deleteCls + '">Delete</button></td></tr>';
                $tbody.append(rowHtml);
            });
            $(tableSelector + 'Container').show();
        };

        if (data.deductionType === 'Day' && data.deductionTypeValue) {
            deductionTypeDayValue = data.deductionTypeValue;
            renderRows(data.deductionTypeValue.split('|'), '#daysTable', 'Day');
            toggleDayDeleteButtons();
        }
        if (data.deductionType === 'AMT' && data.deductionTypeValue) {
            deductionTypeAmountValue = data.deductionTypeValue;
            renderRows(data.deductionTypeValue.split('|'), '#amountTable', 'AMT');
            toggleDeleteButtons();
        }
        $('.warningFormType').text('Update');
        setBtnNormal('#btnCreateWarning', 'Update');
        $('#addWarningModel').modal('show');
    }

    function openDeleteWarning(id) {
        wmsConfirm('Are you sure you want to delete this warning?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/WarningMasterAPI/DeleteWarningMaster', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: null }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) loadCardWarningGrid();
                },
                error: function () { showToast('Error deleting warning.', 'error'); }
            });
        });
    }

    function resetWarningForm() {
        warningMasterId = 0; deductionTypeDayValue = null; deductionTypeAmountValue = null;
        $('#txtWarningName, #txtRemark').val(''); $('#txtWarningName').removeClass('is-invalid');
        $('#dropdownLevel').val('').removeClass('is-invalid');
        $("input[name='deduction']").prop('checked', false);
        $('#daysTableContainer, #amountTableContainer').hide();
        $('#daysTable tbody, #amountTable tbody').empty();
        $('#rdoNo').prop('checked', true).trigger('change');
        $('#spnWarningName, #spnLevel').hide();
    }

    // --- Mapping Grid ---
    function loadCardMappingGrid() {
        mappingWmsGrid.showLoader();
        $.ajax({
            type: 'GET', url: '@baseUrl/LevelWiseCardMappingAPI/GetAllLevelWiseCardMapping', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                var rows = response.isSuccess ? (response.data || []) : [];
                _mappingCache = {};
                rows.forEach(function (r) { _mappingCache[r.levelWiseCardMappingId] = r; });
                mappingWmsGrid.setData(rows); mappingWmsGrid.hideLoader();
            },
            error: function () { mappingWmsGrid.hideLoader(); showToast('Failed to load card mappings.', 'error'); }
        });
    }

    $('#addMapCardBtn').click(function () { levelWiseCardMappingId = 0; clearMappingForm(); $('.mappingFormType').text('Create'); setBtnNormal('#btnCreateMapping', 'Create'); $('#addMappingModel').modal('show'); });

    $('#btnCreateMapping').click(function () {
        var level = $('#dropdownLevelMap').val();
        var cardNo = $('#txtCardCount').val();
        var cardType = $('#dropdownCard').val();
        var isValid = true;
        $('#spnLevelMap, #spnCardCount, #spnCard').hide();
        $('#dropdownLevelMap, #txtCardCount, #dropdownCard').removeClass('is-invalid');
        if (!level) { $('#spnLevelMap').show(); $('#dropdownLevelMap').addClass('is-invalid'); isValid = false; }
        if (!cardNo) { $('#spnCardCount').show(); $('#txtCardCount').addClass('is-invalid'); isValid = false; }
        if (!cardType) { $('#spnCard').show(); $('#dropdownCard').addClass('is-invalid'); isValid = false; }
        if (!isValid) return;

        setBtnLoading('#btnCreateMapping', (levelWiseCardMappingId || 0) == 0 ? 'Creating...' : 'Updating...');
        var payload = { levelWiseCardMappingId: levelWiseCardMappingId, level: level, cardNo: cardNo, cardType: cardType, createdBy: null, updatedBy: null };

        $.ajax({
            url: '@baseUrl/LevelWiseCardMappingAPI/CreateOrUpdateLevelWiseCardMapping', type: 'POST',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage || 'Mapping saved.', 'success');
                    loadCardMappingGrid(); $('#addMappingModel').modal('hide');
                } else {
                    showToast(response.responseMessage || 'Something went wrong.', 'error');
                    setBtnNormal('#btnCreateMapping', levelWiseCardMappingId == 0 ? 'Create' : 'Update');
                }
            },
            error: function () { showToast('Unable to save mapping.', 'error'); setBtnNormal('#btnCreateMapping', levelWiseCardMappingId == 0 ? 'Create' : 'Update'); }
        });
    });

    function openUpdateMapping(id) {
        var data = _mappingCache[id];
        if (!data) return;
        levelWiseCardMappingId = data.levelWiseCardMappingId;
        $('#dropdownLevelMap').val(data.level || '');
        $('#txtCardCount').val(data.cardNo || '');
        $('#dropdownCard').val(data.cardType || '');
        $('.mappingFormType').text('Update');
        setBtnNormal('#btnCreateMapping', 'Update');
        $('#addMappingModel').modal('show');
    }

    function openDeleteMapping(id) {
        wmsConfirm('Are you sure you want to delete this card mapping?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/LevelWiseCardMappingAPI/DeleteLevelWiseCardMapping', type: 'DELETE',
                contentType: 'application/json', _silentLoader: true,
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: null }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted.') : (response.responseMessage || 'Error.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) loadCardMappingGrid();
                },
                error: function () { showToast('Error deleting mapping.', 'error'); }
            });
        });
    }

    function clearMappingForm() {
        $('#dropdownLevelMap, #dropdownCard').val('').removeClass('is-invalid');
        $('#txtCardCount').val('').removeClass('is-invalid');
        $('#spnLevelMap, #spnCardCount, #spnCard').hide();
    }
</script>
