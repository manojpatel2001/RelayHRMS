@inject IConfiguration Configuration
@{
    ViewData["Title"] = "WeekOff Master";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="card">
    <div class="card-header">
        <h6 class="mb-0">WeekOff Master</h6>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4"></div>
            <div class="col-md-4">
                <div class="form-group position-relative">
                    <select id="dropdownBranch" class="form-control floating-input">
                        <option value="" selected disabled>Select Branch</option>
                    </select>
                    <label class="floating-label" for="dropdownBranch">Branch Name</label>
                    <span id="spnBranch" style="color:red; display:none;">Please Select Branch</span>
                </div>
            </div>
        </div>

        <form id="weekOffForm" autocomplete="off">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50%;">Weekoff Name</th>
                                    <th style="width:50%;">Weekoff Day</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                                {
                                    <tr>
                                        <td>@day</td>
                                        <td>
                                            <div class="form-group position-relative">
                                                <select id="@(day)WeekOffDay" class="form-select floating-input">
                                                    <option selected value="">Select</option>
                                                    <option value="0.5">Half Day</option>
                                                    <option value="1">Full Day</option>
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-4"></div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveWeekOff">
                            <span class="btn-spinner-icon"></span>
                            <span class="btn-label-text">Save</span>
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" id="btnClearWeekOff">Clear</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");
    let WeekOffDetailsId = 0;
    let weekOffDetailsMap = {};

    $(() => { BindBranch(); });

    function BindBranch() {
        $.ajax({
            type: 'GET', url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId, _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess && response.data && response.data.length > 0) {
                    var $dd = $('#dropdownBranch');
                    $dd.empty().append('<option value="" selected disabled>Select Branch</option>');
                    $.each(response.data, function (i, b) { $dd.append('<option value="' + b.branchId + '">' + b.branchName + '</option>'); });
                }
            },
            error: function () { showToast('Something went wrong loading branches.', 'error'); }
        });
    }

    $(document).ready(function () {
        $('#dropdownBranch').change(function () {
            $('#spnBranch').hide();
            LoadWeekOffMaster();
        });

        $('#btnClearWeekOff').click(function () {
            $('#dropdownBranch').val('');
            $('#weekOffForm')[0].reset();
            $('#spnBranch').hide();
        });
    });

    function LoadWeekOffMaster() {
        var branchId = $('#dropdownBranch').val();
        if (!branchId) { $('#spnBranch').show(); return; }
        $('#spnBranch').hide();
        $('#dropdownBranch').prop('disabled', true);

        $.ajax({
            url: '@baseUrl/WeekOffMasterAPI/GetAllWeekOffDetails', type: 'Post',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({ branchId: branchId, CompanyId: CompanyId }),
            success: function (res) {
                if (res.isSuccess) { setWeekOffDataList(res.data); }
                else {
                    WeekOffDetailsId = 0;
                    showToast(res.responseMessage, 'warn');
                    $('#weekOffForm')[0].reset();
                }
                $('#dropdownBranch').prop('disabled', false);
            },
            error: function () {
                $('#dropdownBranch').prop('disabled', false);
                showToast('Failed to fetch week off data.', 'error');
            }
        });
    }

    function setWeekOffDataList(dataList) {
        var currentBranchId = parseInt($('#dropdownBranch').val());
        var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        days.forEach(function (day) {
            $('#' + day + 'WeekOffDay').val('');
            if (!weekOffDetailsMap[currentBranchId]) weekOffDetailsMap[currentBranchId] = {};
            weekOffDetailsMap[currentBranchId][day] = 0;
        });
        dataList.forEach(function (item) {
            if (parseInt(item.branchId) === currentBranchId) {
                var $input = $('#' + item.weekOffName + 'WeekOffDay');
                if ($input.length > 0) {
                    $input.val(item.weekOffDay);
                    weekOffDetailsMap[currentBranchId][item.weekOffName] = item.weekOffDetailsId || 0;
                }
            }
        });
    }

    $('#btnSaveWeekOff').click(function () {
        var branchId = $('#dropdownBranch').val();
        if (!branchId) { $('#spnBranch').show(); return; }
        $('#spnBranch').hide();

        var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var weekOffList = [];
        var hasAtLeastOneValue = false;
        days.forEach(function (day) {
            var weekOffDay = $('#' + day + 'WeekOffDay').val();
            if (weekOffDay !== '') {
                hasAtLeastOneValue = true;
                var detailsId = (weekOffDetailsMap[branchId] && weekOffDetailsMap[branchId][day]) || 0;
                weekOffList.push({ weekOffName: day, weekOffDay: weekOffDay, weekOffDetailsId: detailsId });
            }
        });

        if (!hasAtLeastOneValue) {
            showToast('Please enter at least one Week Off Day before saving.', 'warn');
            return;
        }

        setBtnLoading('#btnSaveWeekOff', 'Saving...');
        var data = {
            branchId: parseInt(branchId), companyId: CompanyId,
            createdBy: WeekOffDetailsId === 0 ? EmployeeId : null,
            updatedBy: WeekOffDetailsId !== 0 ? EmployeeId : null,
            WeekOff: weekOffList
        };

        $.ajax({
            url: '@baseUrl/WeekOffMasterAPI/CreateWeekOffDetails', type: 'POST',
            contentType: 'application/json', _silentLoader: true,
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(data),
            success: function (res) {
                if (res.isSuccess) {
                    showToast(res.responseMessage || 'Week off saved.', 'success');
                    $('#weekOffForm')[0].reset();
                    LoadWeekOffMaster();
                } else {
                    showToast(res.responseMessage || 'Something went wrong.', 'error');
                }
                setBtnNormal('#btnSaveWeekOff', 'Save');
            },
            error: function () {
                showToast('Error while saving weekOff data.', 'error');
                setBtnNormal('#btnSaveWeekOff', 'Save');
            }
        });
    });
</script>
