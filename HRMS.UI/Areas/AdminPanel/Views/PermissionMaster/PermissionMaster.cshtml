@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Permission Master";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
	.perm-form-row {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

		.perm-form-row .fg {
			flex: 1 1 220px;
			min-width: 200px;
		}

	.perm-type-pill {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 20px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: .3px;
	}

		.perm-type-pill.role { background: #DBEAFE; color: #1E40AF; }
		.perm-type-pill.user { background: #FEF3C7; color: #92400E; }
		.perm-type-pill.menu { background: #EDE9FE; color: #5B21B6; }
</style>

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0"><span class="formType">Add New</span> Permission</h6>
		<button type="button" class="btn btn-secondary btn-sm" id="btnCancelPermissionForm" style="display:none;">
			<i class="bx bx-x"></i> Cancel
		</button>
	</div>
	<div class="card-body">
		<div class="perm-form-row">
			<div class="fg fg-req">
				<label for="txtPermissionName">Permission Name</label>
				<input type="text" id="txtPermissionName" placeholder="e.g. View Employee Master" autocomplete="off" />
				<span class="field-validation-error" id="spnPermissionName" style="display:none;">Please enter a permission name.</span>
			</div>
			<div class="fg fg-req">
				<label for="txtSlug">Slug</label>
				<input type="text" id="txtSlug" placeholder="e.g. view-employeemaster" autocomplete="off" />
				<span class="field-validation-error" id="spnSlug" style="display:none;">Please enter a slug.</span>
			</div>
			<div class="fg">
				<label for="txtPermissionUrl">Permission URL</label>
				<input type="text" id="txtPermissionUrl" placeholder="e.g. /AdminPanel/EmployeeMaster/EmployeeMaster" autocomplete="off" />
			</div>
			<div class="fg fg-req">
				<label for="txtGroupName">Group Name</label>
				<input type="text" id="txtGroupName" placeholder="e.g. Employee" autocomplete="off" />
				<span class="field-validation-error" id="spnGroupName" style="display:none;">Please enter a group name.</span>
			</div>
		</div>
		<div class="perm-form-row mt-3">
			<div class="fg fg-req">
				<label for="txtDescription">Description</label>
				<input type="text" id="txtDescription" placeholder="Brief description of this permission" autocomplete="off" />
				<span class="field-validation-error" id="spnDescription" style="display:none;">Please enter a description.</span>
			</div>
			<div class="fg fg-req">
				<label for="ddlPermissionRoleType">Permission Role Type</label>
				<select id="ddlPermissionRoleType">
					<option selected disabled value="">-- Select --</option>
				</select>
				<span class="field-validation-error" id="spnPermissionRoleType" style="display:none;">Please select a permission role type.</span>
			</div>
			<div class="fg">
				<label for="drpPermissionType">Permission Type</label>
				<select id="drpPermissionType">
					<option value="Role">Role (Module Action)</option>
					<option value="Menu">Menu (Page Visibility)</option>
					<option value="User">User</option>
				</select>
			</div>
		</div>
		<div class="d-flex justify-content-end gap-2 mt-3">
			<button type="button" class="btn btn-secondary btn-sm" id="btnClearPermissionForm">
				<i class="bx bx-eraser"></i> Clear
			</button>
			<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnAddPermissionMaster">
				<span class="btn-spinner-icon"></span>
				<i class="bx bx-save"></i>
				<span class="btn-label-text">Save Permission</span>
			</button>
		</div>
	</div>
</div>

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">All Permissions</h6>
	</div>
	<div class="card-body">
		<div id="permissionGrid"></div>
	</div>
</div>

<div class="modal fade" id="viewPermissionModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title">Permission Details</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row gy-2">
					<div class="col-6"><strong>Permission Name</strong><div id="vwPermissionName">-</div></div>
					<div class="col-6"><strong>Slug</strong><div id="vwSlug">-</div></div>
					<div class="col-6"><strong>Group Name</strong><div id="vwGroupName">-</div></div>
					<div class="col-6"><strong>Permission Type</strong><div id="vwPermissionType">-</div></div>
					<div class="col-6"><strong>Role Type</strong><div id="vwPermissionRoleTypeName">-</div></div>
					<div class="col-12"><strong>Permission URL</strong><div id="vwPermissionUrl">-</div></div>
					<div class="col-12"><strong>Description</strong><div id="vwDescription">-</div></div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var PermissionId = 0;
	var _permissionCache = {};

	var grid = WMSGrid.create({
		container: 'permissionGrid',
		title: 'All Permissions',
		icon: 'bx-lock-alt',
		perPage: 10,
		columns: [
			{ field: 'permissionName',         header: 'Permission Name',      width: '200px' },
			{ field: 'slug',                   header: 'Slug',                 width: '160px' },
			{ field: 'groupName',              header: 'Group Name',           width: '150px' },
			{
				field: 'permissionType', header: 'Permission Type', width: '150px',
				render: function (v) {
					var cls = (v || '').toLowerCase();
					return '<span class="perm-type-pill ' + cls + '">' + (v || '-') + '</span>';
				}
			},
			{ field: 'permissionRoleTypeName', header: 'Role Type',            width: '130px', render: function (v) { return v || '-'; } },
			{ field: 'description',            header: 'Description',          width: '220px' },
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '170px',
				render: function (v, row) {
					var html = '';
					if (PermGuard.has('edit-permissionmaster')) {
						html += '<button class="wg-btn wg-btn-primary" onclick="_editPermission(' + row.permissionId + ')"><i class="bx bx-edit"></i> Edit</button> ';
					}
					html += '<button class="wg-btn wg-btn-outline" onclick="_viewPermission(' + row.permissionId + ')"><i class="bx bx-show"></i> View</button> ';
					if (PermGuard.has('delete-permissionmaster')) {
						html += '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deletePermission(' + row.permissionId + ',\'' + (row.permissionName || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
					}
					return html;
				}
			}
		],
		features: { export: true }
	});

	function loadTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/PermissionAPI/GetAllPermissions', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_permissionCache = {};
				rows.forEach(function (r) { _permissionCache[r.permissionId] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) showToast(data.responseMessage || 'No records found.', 'info');
			},
			error: function () { grid.hideLoader(); showToast('Failed to load permissions.', 'error'); }
		});
	}

	function loadRoleOptions() {
		$.ajax({
			url: '@baseUrl/RoleAPI/GetAllRoles', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				if (data.isSuccess) {
					var dd = $('#ddlPermissionRoleType');
					dd.empty().append('<option selected disabled value="">-- Select --</option>');
					$.each(data.data, function (i, r) {
						dd.append('<option value="' + r.id + '">' + r.name + '</option>');
					});
				}
			}
		});
	}

	$('#btnClearPermissionForm, #btnCancelPermissionForm').on('click', function () { resetForm(); });

	$('#btnAddPermissionMaster').on('click', function () {
		var permName  = $('#txtPermissionName').val().trim();
		var slug      = $('#txtSlug').val().trim();
		var desc      = $('#txtDescription').val().trim();
		var groupName = $('#txtGroupName').val().trim();
		var roleType  = $('#ddlPermissionRoleType').val();

		var isValid = true;
		if (!permName)  { $('#spnPermissionName').show();  $('#txtPermissionName').addClass('is-invalid');  isValid = false; } else { $('#spnPermissionName').hide();  $('#txtPermissionName').removeClass('is-invalid'); }
		if (!slug)      { $('#spnSlug').show();            $('#txtSlug').addClass('is-invalid');            isValid = false; } else { $('#spnSlug').hide();            $('#txtSlug').removeClass('is-invalid'); }
		if (!desc)      { $('#spnDescription').show();     $('#txtDescription').addClass('is-invalid');     isValid = false; } else { $('#spnDescription').hide();     $('#txtDescription').removeClass('is-invalid'); }
		if (!groupName) { $('#spnGroupName').show();       $('#txtGroupName').addClass('is-invalid');       isValid = false; } else { $('#spnGroupName').hide();       $('#txtGroupName').removeClass('is-invalid'); }
		if (!roleType)  { $('#spnPermissionRoleType').show(); $('#ddlPermissionRoleType').addClass('is-invalid'); isValid = false; } else { $('#spnPermissionRoleType').hide(); $('#ddlPermissionRoleType').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnAddPermissionMaster', PermissionId ? 'Updating...' : 'Saving...');

		var permissionMaster = {
			PermissionId:         PermissionId || 0,
			PermissionName:       permName,
			Slug:                 slug,
			Description:          desc,
			PermissionUrl:        $('#txtPermissionUrl').val().trim() || null,
			GroupName:            groupName,
			PermissionType:       $('#drpPermissionType').val(),
			PermissionRoleType:   roleType
		};

		$.ajax({
			url:  PermissionId ? '@baseUrl/PermissionAPI/UpdatePermission' : '@baseUrl/PermissionAPI/CreatePermission',
			type: PermissionId ? 'PUT' : 'POST',
			contentType: 'application/json', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			data: JSON.stringify(permissionMaster),
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (PermissionId ? 'Permission updated.' : 'Permission created.'), 'success');
					resetForm();
					loadTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnAddPermissionMaster', PermissionId ? 'Update Permission' : 'Save Permission');
				}
			},
			error: function () {
				showToast('Something went wrong. Please try again.', 'error');
				setBtnNormal('#btnAddPermissionMaster', PermissionId ? 'Update Permission' : 'Save Permission');
			}
		});
	});

	function resetForm() {
		PermissionId = 0;
		$('#txtPermissionName, #txtSlug, #txtPermissionUrl, #txtDescription, #txtGroupName').val('').removeClass('is-invalid');
		$('#ddlPermissionRoleType').val('').removeClass('is-invalid');
		$('#drpPermissionType').val('Role');
		$('#spnPermissionName, #spnSlug, #spnDescription, #spnGroupName, #spnPermissionRoleType').hide();
		$('.formType').text('Add New');
		$('#btnCancelPermissionForm').hide();
		setBtnNormal('#btnAddPermissionMaster', 'Save Permission');
	}

	window._editPermission = function (id) {
		var data = _permissionCache[id];
		if (!data) return;
		resetForm();
		PermissionId = data.permissionId;
		$('#txtPermissionName').val(data.permissionName || '');
		$('#txtSlug').val(data.slug || '');
		$('#txtPermissionUrl').val(data.permissionUrl || '');
		$('#txtDescription').val(data.description || '');
		$('#txtGroupName').val(data.groupName || '');
		$('#drpPermissionType').val(data.permissionType || 'Role');
		$('#ddlPermissionRoleType').val(data.permissionRoleType || '');
		$('.formType').text('Update');
		$('#btnCancelPermissionForm').show();
		setBtnNormal('#btnAddPermissionMaster', 'Update Permission');
		$('html, body').animate({ scrollTop: 0 }, 200);
	};

	window._viewPermission = function (id) {
		var data = _permissionCache[id];
		if (!data) return;
		$('#vwPermissionName').text(data.permissionName || '-');
		$('#vwSlug').text(data.slug || '-');
		$('#vwGroupName').text(data.groupName || '-');
		$('#vwPermissionType').html('<span class="perm-type-pill ' + (data.permissionType || '').toLowerCase() + '">' + (data.permissionType || '-') + '</span>');
		$('#vwPermissionRoleTypeName').text(data.permissionRoleTypeName || '-');
		$('#vwPermissionUrl').text(data.permissionUrl || '-');
		$('#vwDescription').text(data.description || '-');
		$('#viewPermissionModal').modal('show');
	};

	window._deletePermission = function (id, name) {
		wmsConfirm('Are you sure you want to delete permission <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/PermissionAPI/DeletePermission', type: 'DELETE',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify({ id: id, deletedBy: null }),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Permission deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () {
		PermGuard.onReady(function () {
			loadTable();
			// "Save Permission" submits either a create or an update depending on
			// whether an existing row was loaded into the form — hide it outright
			// if the role has neither permission.
			if (!PermGuard.has('create-permissionmaster') && !PermGuard.has('edit-permissionmaster')) {
				$('#btnAddPermissionMaster').hide();
			}
		});
		loadRoleOptions();
	});
})();
</script>
