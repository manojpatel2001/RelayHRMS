@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Manage Permission";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Permission Master</h6>
		<button id="addPermissionMaster" type="button" class="btn btn-primary btn-sm">Add Permission</button>
	</div>
	<div class="card-body">
		<div id="permissionGrid"></div>
	</div>
</div>

<div class="modal fade" id="addPermissionMasterModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title"><span class="formType">Add</span> Permission Master</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="row">
					<div class="col-md-6">
						<div class="fg fg-req">
							<label for="txtPermissionName">Permission Name</label>
							<input type="text" id="txtPermissionName" placeholder="Permission Name" autocomplete="off" />
							<span class="field-validation-error" id="spnPermissionName" style="display:none;">Please Enter Permission Name</span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg fg-req">
							<label for="txtSlug">Slug</label>
							<input type="text" id="txtSlug" placeholder="Slug" autocomplete="off" />
							<span class="field-validation-error" id="spnSlug" style="display:none;">Please Enter Slug</span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg">
							<label for="txtPermissionUrl">Permission URL</label>
							<input type="text" id="txtPermissionUrl" placeholder="Permission URL" autocomplete="off" />
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg fg-req">
							<label for="txtDescription">Description</label>
							<input type="text" id="txtDescription" placeholder="Description" autocomplete="off" />
							<span class="field-validation-error" id="spnDescription" style="display:none;">Please Enter Description</span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg fg-req">
							<label for="txtGroupName">Group Name</label>
							<input type="text" id="txtGroupName" placeholder="Group Name" autocomplete="off" />
							<span class="field-validation-error" id="spnGroupName" style="display:none;">Please Enter Group Name</span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg fg-req">
							<label for="ddlPermissionRoleType">Permission Role Type</label>
							<select id="ddlPermissionRoleType">
								<option selected disabled value="">Select</option>
							</select>
							<span class="field-validation-error" id="spnPermissionRoleType" style="display:none;">Please Select Permission Role Type</span>
						</div>
					</div>
					<div class="col-md-6">
						<div class="fg">
							<label for="drpPermissionType">Permission Type</label>
							<select id="drpPermissionType">
								<option value="Role">Role</option>
								<option value="User">User</option>
							</select>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnAddPermissionMaster">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Save</span>
				</button>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var Token = localStorage.getItem('authToken');
	var PermissionId = 0;
	var _permissionCache = {};

	var grid = WMSGrid.create({
		container: 'permissionGrid',
		title: 'All Permissions',
		icon: 'bx-lock-alt',
		perPage: 10,
		columns: [
			{ field: 'permissionName',         header: 'Permission Name',      width: '180px' },
			{ field: 'slug',                   header: 'Slug',                 width: '140px' },
			{ field: 'description',            header: 'Description',          width: '180px' },
			{ field: 'permissionUrl',          header: 'URL',                  width: '160px' },
			{ field: 'groupName',              header: 'Group Name',           width: '140px' },
			{ field: 'permissionType',         header: 'Permission Type',      width: '130px' },
			{ field: 'permissionRoleTypeName', header: 'Role Type',            width: '130px' },
			{
				header: 'Actions', sortable: false, stickyRight: true, width: '130px',
				render: function (v, row) {
					return '<button class="wg-btn wg-btn-primary" onclick="_editPermission(' + row.permissionId + ')"><i class="bx bx-edit"></i> Edit</button> ' +
					       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" onclick="_deletePermission(' + row.permissionId + ',\'' + (row.permissionName || '').replace(/'/g, "\\'") + '\')"><i class="bx bx-trash"></i></button>';
				}
			}
		],
		features: { export: true }
	});

	function loadTable() {
		grid.showLoader();
		$.ajax({
			url: '@baseUrl/PermissionAPI/GetAllPermissions', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				var rows = data.isSuccess ? (data.data || []) : [];
				_permissionCache = {};
				rows.forEach(function (r) { _permissionCache[r.permissionId] = r; });
				grid.setData(rows);
				grid.hideLoader();
				if (!data.isSuccess) showToast(data.responseMessage || 'No records found.', 'info');
			},
			error: function () { grid.hideLoader(); showToast('Failed to load permissions.', 'error'); }
		});
	}

	function loadRoleOptions() {
		$.ajax({
			url: '@baseUrl/RoleAPI/GetAllRoles', type: 'GET', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			success: function (data) {
				if (data.isSuccess) {
					var dd = $('#ddlPermissionRoleType');
					dd.empty().append('<option selected disabled value="">Select</option>');
					$.each(data.data, function (i, r) {
						dd.append('<option value="' + r.id + '">' + r.name + '</option>');
					});
				}
			}
		});
	}

	$('#addPermissionMaster').on('click', function () { resetForm(); $('#addPermissionMasterModal').modal('show'); });
	$('#addPermissionMasterModal').on('hidden.bs.modal', function () { resetForm(); });

	$('#btnAddPermissionMaster').on('click', function () {
		var permName  = $('#txtPermissionName').val().trim();
		var slug      = $('#txtSlug').val().trim();
		var desc      = $('#txtDescription').val().trim();
		var groupName = $('#txtGroupName').val().trim();
		var roleType  = $('#ddlPermissionRoleType').val();

		var isValid = true;
		if (!permName)  { $('#spnPermissionName').show();  $('#txtPermissionName').addClass('is-invalid');  isValid = false; } else { $('#spnPermissionName').hide();  $('#txtPermissionName').removeClass('is-invalid'); }
		if (!slug)      { $('#spnSlug').show();            $('#txtSlug').addClass('is-invalid');            isValid = false; } else { $('#spnSlug').hide();            $('#txtSlug').removeClass('is-invalid'); }
		if (!desc)      { $('#spnDescription').show();     $('#txtDescription').addClass('is-invalid');     isValid = false; } else { $('#spnDescription').hide();     $('#txtDescription').removeClass('is-invalid'); }
		if (!groupName) { $('#spnGroupName').show();       $('#txtGroupName').addClass('is-invalid');       isValid = false; } else { $('#spnGroupName').hide();       $('#txtGroupName').removeClass('is-invalid'); }
		if (!roleType)  { $('#spnPermissionRoleType').show(); $('#ddlPermissionRoleType').addClass('is-invalid'); isValid = false; } else { $('#spnPermissionRoleType').hide(); $('#ddlPermissionRoleType').removeClass('is-invalid'); }
		if (!isValid) return;

		setBtnLoading('#btnAddPermissionMaster', PermissionId ? 'Updating...' : 'Saving...');

		var permissionMaster = {
			PermissionId:         PermissionId || 0,
			PermissionName:       permName,
			Slug:                 slug,
			Description:          desc,
			PermissionUrl:        $('#txtPermissionUrl').val().trim() || null,
			GroupName:            groupName,
			PermissionType:       $('#drpPermissionType').val(),
			PermissionRoleType:   roleType
		};

		$.ajax({
			url:  PermissionId ? '@baseUrl/PermissionAPI/UpdatePermission' : '@baseUrl/PermissionAPI/CreatePermission',
			type: PermissionId ? 'PUT' : 'POST',
			contentType: 'application/json', _silentLoader: true,
			headers: { 'Authorization': 'Bearer ' + Token },
			data: JSON.stringify(permissionMaster),
			success: function (r) {
				if (r.isSuccess) {
					showToast(r.responseMessage || (PermissionId ? 'Permission updated.' : 'Permission created.'), 'success');
					$('#addPermissionMasterModal').modal('hide');
					loadTable();
				} else {
					showToast(r.responseMessage || 'Something went wrong.', 'error');
					setBtnNormal('#btnAddPermissionMaster', PermissionId ? 'Update' : 'Save');
				}
			},
			error: function () {
				showToast('Something went wrong. Please try again.', 'error');
				setBtnNormal('#btnAddPermissionMaster', PermissionId ? 'Update' : 'Save');
			}
		});
	});

	function resetForm() {
		PermissionId = 0;
		$('#txtPermissionName, #txtSlug, #txtPermissionUrl, #txtDescription, #txtGroupName').val('').removeClass('is-invalid');
		$('#ddlPermissionRoleType').val('').removeClass('is-invalid');
		$('#drpPermissionType').val('Role');
		$('#spnPermissionName, #spnSlug, #spnDescription, #spnGroupName, #spnPermissionRoleType').hide();
		$('.formType').text('Add');
		setBtnNormal('#btnAddPermissionMaster', 'Save');
	}

	window._editPermission = function (id) {
		var data = _permissionCache[id];
		if (!data) return;
		resetForm();
		PermissionId = data.permissionId;
		$('#txtPermissionName').val(data.permissionName || '');
		$('#txtSlug').val(data.slug || '');
		$('#txtPermissionUrl').val(data.permissionUrl || '');
		$('#txtDescription').val(data.description || '');
		$('#txtGroupName').val(data.groupName || '');
		$('#drpPermissionType').val(data.permissionType || 'Role');
		$('#ddlPermissionRoleType').val(data.permissionRoleType || '');
		$('.formType').text('Update');
		setBtnNormal('#btnAddPermissionMaster', 'Update');
		$('#addPermissionMasterModal').modal('show');
	};

	window._deletePermission = function (id, name) {
		wmsConfirm('Are you sure you want to delete permission <strong>"' + name + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
			$.ajax({
				url: '@baseUrl/PermissionAPI/DeletePermission', type: 'DELETE',
				contentType: 'application/json', _silentLoader: true,
				headers: { 'Authorization': 'Bearer ' + Token },
				data: JSON.stringify({ id: id, deletedBy: null }),
				success: function (r) {
					showToast(r.isSuccess ? (r.responseMessage || 'Permission deleted.') : (r.responseMessage || 'Something went wrong.'), r.isSuccess ? 'success' : 'error');
					if (r.isSuccess) loadTable();
				},
				error: function () { showToast('Something went wrong. Please try again.', 'error'); }
			});
		});
	};

	$(document).ready(function () { loadTable(); loadRoleOptions(); });
})();
</script>
