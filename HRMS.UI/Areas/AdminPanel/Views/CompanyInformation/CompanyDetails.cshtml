            var headerFile = $('#letterHeadHeader')[0].files[0];
            var footerFile = $('#letterHeadFooter')[0].files[0];

            if (headerFile) {
                formData.append('LetterHeadHeaderFile', headerFile);
            }

            if (footerFile) {
                formData.append('LetterHeadFooterFile', footerFile);
            }

