            url: '@baseUrl/CompanyDetailsAPI/GetAllCompanyDetails',
            success: function(data) {
                companyGrid.hideLoader();
                if (data.isSuccess) {
                    var rows = data.data || [];
                    _companyDetailsCache = {};
                    rows.forEach(function (r) { _companyDetailsCache[r.companyId] = r; });
                    companyGrid.setData(rows);
                } else {
                    _companyDetailsCache = {};
                    companyGrid.setData([]);
                }
            },
            error: function(xhr, status, error) {
                companyGrid.hideLoader();
                console.error("AJAX Error: " + status + " - " + error);
            }
        });
