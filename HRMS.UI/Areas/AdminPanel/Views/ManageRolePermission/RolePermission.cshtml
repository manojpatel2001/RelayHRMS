@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Role Permission";
	Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
	.rp-role-select {
		max-width: 320px;
	}

	.rp-status-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px;
		background: #EFF6FF;
		border: 1px solid #BFDBFE;
		border-radius: 8px;
		padding: 10px 16px;
		margin: 16px 0;
	}

		.rp-status-bar .rp-status-title {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 13px;
			color: #1E3A5F;
		}

			.rp-status-bar .rp-status-title i {
				color: #F59E0B;
			}

	.rp-toolbar {
		display: flex;
		justify-content: flex-end;
		background: #F8FAFC;
		border: 1px solid #E2E8F0;
		border-bottom: none;
		border-radius: 8px 8px 0 0;
		padding: 10px 14px;
	}

	.rp-table-wrap {
		border: 1px solid #E2E8F0;
		border-radius: 0 0 8px 8px;
		padding: 14px;
	}

	.rp-badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 20px;
		background: #fff;
		border: 1px solid #BFDBFE;
		font-size: 12px;
		font-weight: 700;
		color: #1E3A5F;
	}

	.rp-empty-state {
		text-align: center;
		color: #94A3B8;
		padding: 40px 20px;
	}

	.rp-table {
		width: 100%;
		border-collapse: collapse;
	}

		.rp-table thead th {
			text-align: center;
			font-size: 11.5px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: .4px;
			color: #64748B;
			padding: 10px 14px;
			border-bottom: 2px solid #E2E8F0;
		}

			.rp-table thead th:first-child {
				text-align: left;
			}

			.rp-col-master-wrap.form-check.form-switch {
				display: flex;
				justify-content: center;
				margin-top: 4px;
				padding-left: 2.2em;
			}

		.rp-table td {
			padding: 9px 14px;
			border-bottom: 1px solid #F1F5F9;
			vertical-align: middle;
			text-align: center;
		}

			.rp-table td:first-child {
				text-align: left;
			}

	.rp-row-panel td {
		background: #E9F0F7;
		font-weight: 700;
		font-size: 13px;
		color: #16324A;
		border-top: 1px solid #BFDBFE;
		border-bottom: 1px solid #BFDBFE;
		cursor: pointer;
	}

		.rp-row-panel td:first-child {
			border-left: 3px solid #3E6A8C;
		}

		.rp-row-panel .rp-panel-name {
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.rp-row-panel .rp-panel-count {
			font-size: 11px;
			font-weight: 500;
			color: #64748B;
			margin-left: 6px;
			text-transform: none;
		}

	.rp-row-group {
		cursor: pointer;
	}

		.rp-row-group td {
			background: #F8FAFC;
			font-weight: 700;
			font-size: 12.5px;
			color: #1E293B;
			border-top: 1px solid #E2E8F0;
			border-bottom: 1px solid #E2E8F0;
		}

			.rp-row-group td:first-child {
				border-left: 3px solid #8C5E3E;
				padding-left: 34px;
			}

			.rp-row-group .rp-group-name {
				display: flex;
				align-items: center;
				gap: 8px;
			}

	.rp-caret {
		font-size: 16px;
		color: #64748B;
		transition: transform .1s ease-in-out;
	}

	.rp-row-item .rp-item-name {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-left: 22px;
		font-size: 13px;
		color: #374151;
	}

		.rp-row-item .rp-item-name i {
			font-size: 15px;
			color: #94A3B8;
		}

	.rp-toggle.form-check.form-switch {
		margin: 0;
		padding-left: 2.5em;
		display: inline-block;
	}

		.rp-toggle.form-check.form-switch .form-check-input {
			width: 2.2em;
			height: 1.2em;
			min-height: 0;
			padding: 0;
			cursor: pointer;
			margin-left: -2.5em;
			margin-top: 0;
		}
</style>

<div class="wms-form-page">

<div class="card">
	<div class="card-header d-flex justify-content-between align-items-center">
		<h6 class="mb-0">Role Permission</h6>
	</div>
	<div class="card-body">
		<div class="fg" style="max-width:320px;">
			<label for="ddlRole">Select Role</label>
			<select id="ddlRole" class="rp-role-select">
				<option value="0" selected>-- Select a role --</option>
			</select>
		</div>

		<div id="rpStatusBar" class="rp-status-bar" style="display:none;">
			<div class="rp-status-title">
				<i class='bx bxs-lock-alt'></i>
				<span>Configuring permissions for <strong id="rpRoleName">-</strong></span>
			</div>
			<div class="d-flex gap-2">
				<span class="rp-badge" id="rpMenuBadge">0/0 permissions enabled</span>
			</div>
		</div>

		<div id="rpEmptyState" class="rp-empty-state">
			<i class='bx bx-lock-alt' style="font-size:32px;"></i>
			<div>Select a role above to configure its permissions.</div>
		</div>

		<div id="rpBody" style="display:none;">
			<div class="rp-toolbar">
				<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSavePermissions">
					<span class="btn-spinner-icon"></span>
					<i class="bx bx-save"></i>
					<span class="btn-label-text">Save Page &amp; Menu Permissions</span>
				</button>
			</div>
			<div class="rp-table-wrap">
				<div class="sec-lbl">Page &amp; Menu Visibility Access</div>
				<table class="rp-table">
					<thead>
						<tr>
							<th>Menu / Page</th>
							<th>All<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="All"></div></th>
							<th>View<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="View"></div></th>
							<th>Create<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="Create"></div></th>
							<th>Edit<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="Edit"></div></th>
							<th>Delete<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="Delete"></div></th>
							<th>Export<div class="form-check form-switch rp-toggle rp-col-master-wrap"><input type="checkbox" class="form-check-input rp-col-master" data-action="Export"></div></th>
						</tr>
					</thead>
					<tbody id="rpTableBody"></tbody>
				</table>
			</div>
		</div>
	</div>
</div>

</div>

<script>
(function () {
	'use strict';

	var ACTIONS = ['View', 'Create', 'Edit', 'Delete', 'Export'];

	var Token = localStorage.getItem('authToken');
	var companyDetails = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
	var companyId = companyDetails.CompanyId;

	var currentRoleId = 0;
	var menuCatalog = null;      // grouped catalog, PermissionType=Menu, pivoted into pages
	var menuIdSet = {};          // every permissionId across the whole Page & Menu catalog
	var originalMenuChecked = {};
	var currentMenuChecked = {};

	function authHeaders() { return { 'Authorization': 'Bearer ' + Token }; }

	function loadRoleOptions() {
		$.ajax({
			url: '@baseUrl/RoleAPI/GetAllRoles', type: 'GET', cache: false,
			headers: authHeaders(),
			success: function (res) {
				var $dd = $('#ddlRole');
				$dd.find('option:not(:first)').remove();
				if (res.isSuccess) {
					(res.data || []).forEach(function (r) {
						$dd.append('<option value="' + r.id + '">' + r.name + '</option>');
					});
				}
			},
			error: function () { showToast('Failed to load roles.', 'error'); }
		});
	}

	// The API returns permission names like "View Company Details" / "Create
	// Company Details" — split off the leading action word and group the
	// remaining 4 siblings under the same page name so each page becomes one
	// row with up to 5 action columns.
	function pivotIntoPages(catalog) {
		return (catalog || []).map(function (group) {
			var pageMap = {};
			var pageOrder = [];
			(group.permissions || []).forEach(function (p) {
				var sp = p.permissionName.indexOf(' ');
				var action = sp > 0 ? p.permissionName.substring(0, sp) : p.permissionName;
				var pageName = sp > 0 ? p.permissionName.substring(sp + 1) : p.permissionName;
				if (ACTIONS.indexOf(action) === -1) { action = 'View'; pageName = p.permissionName; }
				if (!pageMap[pageName]) { pageMap[pageName] = { pageName: pageName, actions: {} }; pageOrder.push(pageName); }
				pageMap[pageName].actions[action] = p.permissionId;
			});
			return { panel: group.panel || 'Admin', groupName: group.groupName, pages: pageOrder.map(function (n) { return pageMap[n]; }) };
		});
	}

	// Buckets the flat (panel, group) list into the two top-level panels, in a
	// fixed display order, for the Admin Panel / ESS Panel collapsible sections.
	function bucketByPanel(catalog) {
		var order = ['Admin', 'ESS'];
		var labels = { Admin: 'Admin Panel', ESS: 'ESS Panel' };
		return order
			.map(function (key) { return { panelKey: key, panelLabel: labels[key], groups: (catalog || []).filter(function (g) { return g.panel === key; }) }; })
			.filter(function (p) { return p.groups.length > 0; });
	}

	function fetchMenuCatalog() {
		return $.ajax({
			url: '@baseUrl/PermissionAPI/GetAllGroupPermissions/Menu', type: 'GET', cache: false,
			headers: authHeaders()
		}).then(function (res) { return pivotIntoPages(res.isSuccess ? (res.data || []) : []); },
		function () { return []; });
	}

	function buildIdSet(catalog) {
		var set = {};
		(catalog || []).forEach(function (g) {
			(g.pages || []).forEach(function (pg) {
				ACTIONS.forEach(function (a) { if (pg.actions[a]) set[pg.actions[a]] = true; });
			});
		});
		return set;
	}

	var ALL_COLUMNS = ['All'].concat(ACTIONS);

	function masterCellHtml(scopeType, scopeId, action) {
		return '<td><div class="form-check form-switch rp-toggle"><input type="checkbox" class="form-check-input rp-scope-master" data-scope-type="' + scopeType + '" data-scope-id="' + scopeId + '" data-action="' + action + '"></div></td>';
	}

	function renderTable(tbody, catalog, checkedSet) {
		tbody.empty();
		if (!catalog || catalog.length === 0) {
			tbody.append('<tr><td colspan="7" class="rp-empty-state">No page/menu permissions available.</td></tr>');
			return;
		}

		var panels = bucketByPanel(catalog);

		panels.forEach(function (panel, pi) {
			var panelId = 'panel-' + pi;
			var pageCount = panel.groups.reduce(function (n, g) { return n + (g.pages || []).length; }, 0);

			var panelHtml = '<tr class="rp-row-panel" data-panel-id="' + panelId + '">' +
				'<td><span class="rp-panel-name"><i class="bx bx-chevron-down rp-caret"></i><i class="bx bx-layer"></i>' + panel.panelLabel.toUpperCase() + '<span class="rp-panel-count">' + pageCount + ' pages</span></span></td>';
			ALL_COLUMNS.forEach(function (action) { panelHtml += masterCellHtml('panel', panelId, action); });
			panelHtml += '</tr>';
			tbody.append(panelHtml);

			panel.groups.forEach(function (group, gi) {
				var groupId = panelId + '-group-' + gi;

				var groupHtml = '<tr class="rp-row-group" data-panel-id="' + panelId + '" data-group-id="' + groupId + '">' +
					'<td><span class="rp-group-name"><i class="bx bx-chevron-down rp-caret"></i><i class="bx bx-folder"></i>' + group.groupName.toUpperCase() + '</span></td>';
				ALL_COLUMNS.forEach(function (action) { groupHtml += masterCellHtml('group', groupId, action); });
				groupHtml += '</tr>';
				tbody.append(groupHtml);

				(group.pages || []).forEach(function (pg) {
					var $row = $('<tr class="rp-row-item" data-panel-id="' + panelId + '" data-group-id="' + groupId + '"><td><span class="rp-item-name"><i class="bx bx-chevron-right"></i>' + pg.pageName + '</span></td></tr>');

					var anyAction = ACTIONS.some(function (a) { return !!pg.actions[a]; });
					var $allTd = $('<td></td>');
					if (anyAction) {
						$allTd.html('<div class="form-check form-switch rp-toggle"><input type="checkbox" class="form-check-input rp-row-all-toggle"></div>');
					} else {
						$allTd.html('&mdash;');
					}
					$row.append($allTd);

					ACTIONS.forEach(function (action) {
						var permId = pg.actions[action];
						var $td = $('<td></td>');
						if (permId) {
							var isChecked = !!checkedSet[permId];
							$td.html('<div class="form-check form-switch rp-toggle"><input type="checkbox" class="form-check-input rp-item-toggle" data-id="' + permId + '" data-action="' + action + '" ' + (isChecked ? 'checked' : '') + '></div>');
						} else {
							$td.html('&mdash;');
						}
						$row.append($td);
					});
					tbody.append($row);
					syncRowAllToggle($row);
				});
			});
		});

		refreshColumnMasters(tbody);
		refreshScopedMasters(tbody);

		tbody.on('click', '.rp-row-panel', function () {
			var panelId = $(this).data('panel-id');
			var collapsed = $(this).toggleClass('collapsed').hasClass('collapsed');
			$(this).find('.rp-caret').toggleClass('bx-chevron-down bx-chevron-right');
			tbody.find('[data-panel-id="' + panelId + '"]').not(this).toggle(!collapsed);
		});

		tbody.on('click', '.rp-row-group', function (e) {
			e.stopPropagation();
			var groupId = $(this).data('group-id');
			var collapsed = $(this).toggleClass('collapsed').hasClass('collapsed');
			$(this).find('.rp-caret').toggleClass('bx-chevron-down bx-chevron-right');
			tbody.find('.rp-row-item[data-group-id="' + groupId + '"]').toggle(!collapsed);
		});

		tbody.on('click', '.rp-toggle', function (e) { e.stopPropagation(); });

		tbody.on('change', '.rp-item-toggle', function () {
			var id = parseInt($(this).data('id'));
			if ($(this).is(':checked')) checkedSet[id] = true; else delete checkedSet[id];
			syncRowAllToggle($(this).closest('tr'));
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateBadge();
		});

		tbody.on('change', '.rp-row-all-toggle', function () {
			var on = $(this).is(':checked');
			$(this).closest('tr').find('.rp-item-toggle').prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) checkedSet[id] = true; else delete checkedSet[id];
			});
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateBadge();
		});

		tbody.on('change', '.rp-scope-master', function () {
			var scopeType = $(this).data('scope-type');
			var scopeId = $(this).data('scope-id');
			var action = $(this).data('action');
			var on = $(this).is(':checked');
			var attr = scopeType === 'panel' ? 'data-panel-id' : 'data-group-id';
			var $rows = tbody.find('.rp-row-item[' + attr + '="' + scopeId + '"]');
			var $targets = action === 'All' ? $rows.find('.rp-item-toggle') : $rows.find('.rp-item-toggle[data-action="' + action + '"]');
			$targets.prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) checkedSet[id] = true; else delete checkedSet[id];
			});
			$rows.each(function () { syncRowAllToggle($(this)); });
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateBadge();
		});
	}

	function syncRowAllToggle($row) {
		var $itemToggles = $row.find('.rp-item-toggle');
		var $allToggle = $row.find('.rp-row-all-toggle');
		if (!$allToggle.length || !$itemToggles.length) return;
		var checkedCount = $itemToggles.filter(':checked').length;
		$allToggle.prop('checked', checkedCount === $itemToggles.length);
		$allToggle.prop('indeterminate', checkedCount > 0 && checkedCount < $itemToggles.length);
	}

	// Column-master toggles (table header) select/deselect an entire action
	// column — or, for "All", every toggle in the table — across every page,
	// including pages inside collapsed panels/groups.
	function wireColumnMasters(tbody) {
		$('.rp-col-master').off('change').on('change', function () {
			var action = $(this).data('action');
			var on = $(this).is(':checked');
			var $targets = action === 'All' ? tbody.find('.rp-item-toggle') : tbody.find('.rp-item-toggle[data-action="' + action + '"]');
			$targets.prop('checked', on).each(function () {
				var id = parseInt($(this).data('id'));
				if (on) currentMenuChecked[id] = true; else delete currentMenuChecked[id];
			});
			tbody.find('.rp-row-item').each(function () { syncRowAllToggle($(this)); });
			refreshColumnMasters(tbody);
			refreshScopedMasters(tbody);
			updateBadge();
		});
	}

	// Panel-row and group-row master toggles (All/View/Create/Edit/Delete/Export)
	// each reflect and control every item toggle scoped to that panel or group.
	function refreshScopedMasters(tbody) {
		tbody.find('.rp-scope-master').each(function () {
			var $m = $(this);
			var scopeType = $m.data('scope-type');
			var scopeId = $m.data('scope-id');
			var action = $m.data('action');
			var attr = scopeType === 'panel' ? 'data-panel-id' : 'data-group-id';
			var $rows = tbody.find('.rp-row-item[' + attr + '="' + scopeId + '"]');
			var $targets = action === 'All' ? $rows.find('.rp-item-toggle') : $rows.find('.rp-item-toggle[data-action="' + action + '"]');
			if (!$targets.length) { $m.prop('checked', false).prop('indeterminate', false); return; }
			var checkedCount = $targets.filter(':checked').length;
			$m.prop('checked', checkedCount === $targets.length);
			$m.prop('indeterminate', checkedCount > 0 && checkedCount < $targets.length);
		});
	}

	function refreshColumnMasters(tbody) {
		ALL_COLUMNS.forEach(function (action) {
			var $col = $('.rp-col-master[data-action="' + action + '"]');
			var $targets = action === 'All' ? tbody.find('.rp-item-toggle') : tbody.find('.rp-item-toggle[data-action="' + action + '"]');
			if (!$targets.length) { $col.prop('checked', false).prop('indeterminate', false); return; }
			var checkedCount = $targets.filter(':checked').length;
			$col.prop('checked', checkedCount === $targets.length);
			$col.prop('indeterminate', checkedCount > 0 && checkedCount < $targets.length);
		});
	}

	function updateBadge() {
		var checked = Object.keys(currentMenuChecked).length;
		var total = Object.keys(menuIdSet).length;
		$('#rpMenuBadge').text(checked + '/' + total + ' permissions enabled');
	}

	function loadCatalogOnce() {
		if (menuCatalog) return $.Deferred().resolve().promise();
		return fetchMenuCatalog().then(function (d) { menuCatalog = d; menuIdSet = buildIdSet(d); });
	}

	function loadRolePermissions(roleId) {
		return $.ajax({
			url: '@baseUrl/RolePermissionAPI/GetAllPermissionByRoleId', type: 'POST',
			contentType: 'application/json', headers: authHeaders(),
			data: JSON.stringify({ RoleId: roleId, CompanyId: companyId })
		}).then(function (res) { return res.isSuccess ? (res.data || []) : []; }, function () { return []; });
	}

	$('#ddlRole').on('change', function () {
		var roleId = parseInt($(this).val());
		if (!roleId) {
			$('#rpStatusBar, #rpBody').hide();
			$('#rpEmptyState').show();
			currentRoleId = 0;
			return;
		}

		currentRoleId = roleId;
		$('#rpRoleName').text($(this).find('option:selected').text());
		$('#rpEmptyState').hide();

		$.when(loadCatalogOnce(), loadRolePermissions(roleId)).done(function (_, assigned) {
			originalMenuChecked = {};
			(assigned || []).forEach(function (a) {
				if (a.permissionId && menuIdSet[a.permissionId]) originalMenuChecked[a.permissionId] = true;
			});
			currentMenuChecked = Object.assign({}, originalMenuChecked);

			renderTable($('#rpTableBody'), menuCatalog, currentMenuChecked);
			wireColumnMasters($('#rpTableBody'));
			updateBadge();

			$('#rpStatusBar, #rpBody').show();
		});
	});

	function diffIds(originalSet, currentSet) {
		var toAdd = [], toRemove = [];
		Object.keys(currentSet).forEach(function (id) { if (!originalSet[id]) toAdd.push(id); });
		Object.keys(originalSet).forEach(function (id) { if (!currentSet[id]) toRemove.push(id); });
		return { toAdd: toAdd, toRemove: toRemove };
	}

	function callIfNeeded(ids, url) {
		if (!ids.length) return $.Deferred().resolve().promise();
		return $.ajax({
			url: url, type: 'POST', contentType: 'application/json', headers: authHeaders(),
			data: JSON.stringify({ RolePermissionId: 0, RoleId: currentRoleId, PermissionIds: ids.join(','), CompanyId: companyId })
		});
	}

	$('#btnSavePermissions').on('click', function () {
		if (!currentRoleId) return;
		setBtnLoading('#btnSavePermissions', 'Saving...');

		var diff = diffIds(originalMenuChecked, currentMenuChecked);

		$.when(
			callIfNeeded(diff.toAdd, '@baseUrl/RolePermissionAPI/CreateRolePermission'),
			callIfNeeded(diff.toRemove, '@baseUrl/RolePermissionAPI/RemoveRolePermission')
		).done(function () {
			showToast('Permissions saved successfully.', 'success');
			originalMenuChecked = Object.assign({}, currentMenuChecked);
			setBtnNormal('#btnSavePermissions', 'Save Page & Menu Permissions');
		}).fail(function () {
			showToast('Something went wrong while saving permissions.', 'error');
			setBtnNormal('#btnSavePermissions', 'Save Page & Menu Permissions');
		});
	});

	$(document).ready(function () {
		loadRoleOptions();
		PermGuard.onReady(function () {
			if (!PermGuard.has('edit-managerolepermission-rolepermission')) {
				$('#btnSavePermissions').hide();
			}
		});
	});
})();
</script>
