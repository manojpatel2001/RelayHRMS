@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Bulk Increment";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Employee Bulk Increment</h6>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnRefreshBulk">
                    <i class="bx bx-refresh"></i> Refresh
                </button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveBulk">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <a href="@Url.Action("EmployeeIncrement", "Increment")" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-arrow-back"></i> Back
                </a>
            </div>
        </div>
        <div class="card-body">
            <div id="gridContainerBulkIncrement"></div>
        </div>
    </div>

</div>

<style>
    .wg-cell-input {
        width: 100%;
        min-width: 110px;
        padding: 5px 8px;
        border: 1px solid var(--wg-border2, #B8C4CC);
        border-radius: 5px;
        font-size: 12.5px;
        font-family: inherit;
        color: var(--wg-text, #2c3e50);
        box-sizing: border-box;
    }

    .wg-cell-input:focus {
        outline: none;
        border-color: var(--wg-primary, #2F6F8E);
        box-shadow: 0 0 0 2px rgba(47,111,142,0.15);
    }

    .wg-cell-input.is-invalid {
        border-color: #C62828 !important;
        box-shadow: 0 0 0 2px rgba(198,40,40,0.12);
    }

    .wg-cell-num {
        text-align: right;
        display: block;
    }
</style>

<script>
    (function () {
        var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
        const CompanyId = companyDetails ? companyDetails.CompanyId : null;
        const Token = localStorage.getItem('authToken');
        const UserId = localStorage.getItem('EmployeeId');

        var reasonList = [];
        var selectedIds = {};

        function fmtMoney(v) {
            if (v === null || v === undefined || v === '') return '';
            return parseFloat(v).toFixed(2);
        }

        function defaultEffectiveDateStr() {
            var today = new Date();
            var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            var yyyy = firstDay.getFullYear();
            var mm = String(firstDay.getMonth() + 1).padStart(2, '0');
            var dd = String(firstDay.getDate()).padStart(2, '0');
            return yyyy + '-' + mm + '-' + dd;
        }

        function toDateInputValue(v) {
            if (!v) return defaultEffectiveDateStr();
            var d = new Date(v);
            if (isNaN(d.getTime())) return defaultEffectiveDateStr();
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        }

        function reasonOptionsHtml(selectedReasonId) {
            var html = '<option value="">Select Reason</option>';
            reasonList.forEach(function (r) {
                var sel = (String(r.reasonId) === String(selectedReasonId)) ? ' selected' : '';
                html += '<option value="' + r.reasonId + '"' + sel + '>' + r.reasonName + '</option>';
            });
            return html;
        }

        window._toggleBulkRow = function (employeeId, checked) {
            if (checked) selectedIds[employeeId] = true;
            else delete selectedIds[employeeId];
        };

        window._updateBulkField = function (employeeId, field, value, inputEl) {
            var rows = grid.getData();
            var row = rows.find(function (r) { return String(r.EmployeeId) === String(employeeId); });
            if (!row) return;

            if (field === 'EffectiveDate') {
                if (value && new Date(value).getDate() !== 1) {
                    showToast('Only the 1st day of the month is allowed for Effective Date.', 'warn');
                    if (inputEl) inputEl.value = row.EffectiveDate ? toDateInputValue(row.EffectiveDate) : defaultEffectiveDateStr();
                    return;
                }
            }

            row[field] = value;
            if (inputEl) inputEl.classList.remove('is-invalid');
        };

        var grid = WMSGrid.create({
            container: 'gridContainerBulkIncrement',
            title: 'Employees for Increment',
            icon: 'bx-group',
            perPage: 10,
            columns: [
                {
                    header: 'Select', sortable: false, width: '60px',
                    render: function (v, row) {
                        var checked = selectedIds[row.EmployeeId] ? ' checked' : '';
                        return '<input type="checkbox" class="bulk-row-chk"' + checked + ' onclick="_toggleBulkRow(' + row.EmployeeId + ', this.checked)">';
                    }
                },
                { field: 'EmployeeCode', header: 'Code', width: '100px' },
                { field: 'EmployeeName', header: 'Employee Name', width: '190px' },
                { field: 'BasicSalary', header: 'Old Basic Salary', width: '125px', render: function (v) { return '<span class="wg-cell-num">' + fmtMoney(v) + '</span>'; } },
                { field: 'GrossSalary', header: 'Old Gross Salary', width: '125px', render: function (v) { return '<span class="wg-cell-num">' + fmtMoney(v) + '</span>'; } },
                {
                    field: 'NewBasicSalary', header: 'New Basic Salary', width: '140px', sortable: false,
                    render: function (v, row) {
                        return '<input type="text" class="wg-cell-input" data-decimal value="' + (row.NewBasicSalary || '') + '" placeholder="0.00" ' +
                            'oninput="_updateBulkField(' + row.EmployeeId + ',\'NewBasicSalary\',this.value,this)">';
                    }
                },
                {
                    field: 'NewGrossSalary', header: 'New Gross Salary', width: '140px', sortable: false,
                    render: function (v, row) {
                        return '<input type="text" class="wg-cell-input" data-decimal value="' + (row.NewGrossSalary || '') + '" placeholder="0.00" ' +
                            'oninput="_updateBulkField(' + row.EmployeeId + ',\'NewGrossSalary\',this.value,this)">';
                    }
                },
                {
                    field: 'EffectiveDate', header: 'Effective Date', width: '155px', sortable: false,
                    render: function (v, row) {
                        return '<input type="date" class="wg-cell-input" value="' + toDateInputValue(row.EffectiveDate) + '" ' +
                            'onchange="_updateBulkField(' + row.EmployeeId + ',\'EffectiveDate\',this.value,this)">';
                    }
                },
                {
                    field: 'reasonId', header: 'Reason', width: '170px', sortable: false,
                    render: function (v, row) {
                        return '<select class="wg-cell-input" onchange="_updateBulkField(' + row.EmployeeId + ',\'reasonId\',this.value,this)">' +
                            reasonOptionsHtml(row.reasonId) + '</select>';
                    }
                }
            ],
            features: { export: true },
            extraButtons: [
                {
                    id: 'btnSelectAllBulk', label: 'Select All', icon: 'bx-check-square', cls: 'wg-btn-outline',
                    onClick: function (e, data) {
                        var allSelected = data.length > 0 && data.every(function (r) { return !!selectedIds[r.EmployeeId]; });
                        selectedIds = {};
                        if (!allSelected) { data.forEach(function (r) { selectedIds[r.EmployeeId] = true; }); }
                        grid.refresh();
                    }
                }
            ]
        });

        function loadReasonsAndData() {
            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/GetAllIncrementReason',
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    reasonList = response.isSuccess ? (response.data || []) : [];
                    loadBulkData();
                },
                error: function () { loadBulkData(); }
            });
        }

        function loadBulkData() {
            grid.showLoader();
            selectedIds = {};
            $.ajax({
                type: 'GET',
                url: '@baseUrl/EmployeeIncrementAPI/GetEmployeeSalaryInfoByCompnayId/' + CompanyId,
                headers: { 'Authorization': 'Bearer ' + Token },
                _silentLoader: true,
                success: function (response) {
                    var rows = response.isSuccess ? (response.data || []) : [];
                    rows.forEach(function (r) {
                        r.NewBasicSalary = r.NewBasicSalary || '';
                        r.NewGrossSalary = r.NewGrossSalary || '';
                        r.EffectiveDate = r.EffectiveDate || defaultEffectiveDateStr();
                        r.reasonId = r.reasonId || '';
                    });
                    grid.setData(rows);
                    grid.hideLoader();
                },
                error: function () {
                    grid.hideLoader();
                    showToast('Unable to load employee salary data.', 'error');
                }
            });
        }

        $(document).ready(function () { loadReasonsAndData(); });

        $('#btnRefreshBulk').click(function () { loadBulkData(); });

        $('#btnSaveBulk').click(function () {
            var rows = grid.getData();
            var selectedRows = rows.filter(function (r) { return !!selectedIds[r.EmployeeId]; });

            if (selectedRows.length === 0) {
                showToast('Please select at least one employee.', 'warn');
                return;
            }

            var invalid = false;
            selectedRows.forEach(function (r) {
                var newBasic = parseFloat(r.NewBasicSalary);
                var newGross = parseFloat(r.NewGrossSalary);
                var oldBasic = parseFloat(r.BasicSalary) || 0;
                var oldGross = parseFloat(r.GrossSalary) || 0;

                if (!r.NewBasicSalary || isNaN(newBasic) || newBasic < oldBasic ||
                    !r.NewGrossSalary || isNaN(newGross) || newGross < oldGross || newGross < newBasic ||
                    !r.reasonId || !r.EffectiveDate) {
                    invalid = true;
                }
            });

            if (invalid) {
                showToast('Please fill New Basic/Gross Salary, Reason and Effective Date correctly for all selected employees.', 'error');
                return;
            }

            setBtnLoading('#btnSaveBulk', 'Saving...');

            var payload = selectedRows.map(function (r) {
                return {
                    EmployeeId: r.EmployeeId,
                    OldBasicSalary: parseFloat(r.BasicSalary) || 0,
                    OldGrossSalary: parseFloat(r.GrossSalary) || 0,
                    NewBasicSalary: parseFloat(r.NewBasicSalary),
                    NewGrossSalary: parseFloat(r.NewGrossSalary),
                    EffectiveFromDate: r.EffectiveDate,
                    ReasonId: r.reasonId,
                    CreatedBy: UserId
                };
            });

            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/InsertBulkEmployeeSalaryHistory',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        loadBulkData();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveBulk', 'Save');
                },
                error: function () {
                    showToast('An error occurred while saving. Please try again.', 'error');
                    setBtnNormal('#btnSaveBulk', 'Save');
                }
            });
        });
    })();
</script>
