@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Monthly Salary";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Add Monthly Salary</h6>
        <a href="@UIBaseUrl/AdminPanel/SalaryDetails/Index" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bx bx-arrow-back"></i> Back
        </a>
    </div>

    <div class="card-body">
        <div class="d-flex flex-nowrap align-items-end gap-3" style="overflow-x:auto;">
            <div class="fg fg-req" style="min-width:150px;max-width:170px;flex-shrink:0;">
                <label for="monthDropdown">Month</label>
                <select id="monthDropdown">
                    <option value="" selected disabled>Select Month</option>
                </select>
                <span class="field-validation-error" id="errorMonth" style="display:none;">Please select month</span>
            </div>
            <div class="fg fg-req" style="min-width:120px;max-width:140px;flex-shrink:0;">
                <label for="yearDropdown">Year</label>
                <select id="yearDropdown">
                    <option value="" selected disabled>Select Year</option>
                </select>
                <span class="field-validation-error" id="errorYear" style="display:none;">Please select year</span>
            </div>
            <div class="fg fg-req" style="min-width:260px;flex:1 1 auto;">
                <label for="employeeDropdown">Employee</label>
                <select id="employeeDropdown" multiple></select>
                <span class="field-validation-error" id="errorEmployee" style="display:none;">Please select employee</span>
            </div>
            <button type="button" id="btnFetchSalary" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" style="flex-shrink:0;">
                <i class="bx bx-search"></i>
                <span class="btn-spinner-icon"></span>
                <span class="btn-label-text">Go</span>
            </button>
        </div>
    </div>
</div>

<div class="card mt-3" id="salaryPreviewCard" style="display:none;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Calculated Salary Preview</h6>
    </div>
    <div class="card-body">
        <div id="salaryGridContainer"></div>

        <div class="text-center mt-3">
            <button type="button" id="btnProcessSalary" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-check"></i>
                <span class="btn-spinner-icon"></span>
                <span class="btn-label-text">Process</span>
            </button>
            <button type="button" id="btnClearSalary" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-x"></i> Clear
            </button>
        </div>
    </div>
</div>

</div>

<script>
    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    let salaryPreviewGrid = null;
    let salaryPreviewRows = [];
    let selectedPreviewIds = {};

    function fillSelect(id, data, valueKey, textKey, placeholder) {
        var $sel = $('#' + id);
        $sel.empty();
        if (placeholder !== undefined) $sel.append($('<option>', { value: '', text: placeholder, disabled: true, selected: true }));
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item[valueKey], text: item[textKey] }));
        });
    }

    function numFmt(v) {
        return Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 });
    }

    $(document).ready(function () {
        const months = [
            { monthNumber: 1,  monthName: 'January'   },
            { monthNumber: 2,  monthName: 'February'  },
            { monthNumber: 3,  monthName: 'March'     },
            { monthNumber: 4,  monthName: 'April'     },
            { monthNumber: 5,  monthName: 'May'       },
            { monthNumber: 6,  monthName: 'June'      },
            { monthNumber: 7,  monthName: 'July'      },
            { monthNumber: 8,  monthName: 'August'    },
            { monthNumber: 9,  monthName: 'September' },
            { monthNumber: 10, monthName: 'October'   },
            { monthNumber: 11, monthName: 'November'  },
            { monthNumber: 12, monthName: 'December'  }
        ];

        const currentMonth = new Date().getMonth() + 1;
        const currentYear = new Date().getFullYear();

        const startYear = 2025;
        const years = [];
        for (let i = currentYear; i >= startYear; i--) {
            years.push({ yearName: i.toString() });
        }

        fillSelect('monthDropdown', months, 'monthNumber', 'monthName');
        $('#monthDropdown').val(currentMonth);

        fillSelect('yearDropdown', years, 'yearName', 'yearName');
        $('#yearDropdown').val(currentYear.toString());

        $('#monthDropdown, #yearDropdown').on('change', loadEmployeeDropdown);

        loadEmployeeDropdown();
    });

    function loadEmployeeDropdown() {
        const monthNumber = $('#monthDropdown').val() || new Date().getMonth() + 1;
        const year = $('#yearDropdown').val() || new Date().getFullYear();

        if (!monthNumber || !year) {
            console.error('Month or Year not selected');
            return;
        }

        $.ajax({
            url: '@baseUrl/EmployeeMasterAPI/GetEmployeesListForSalary',
            method: 'GET',
            data: { month: monthNumber, year: year, compId: CompanyId },
            success: function (res) {
                fillSelect('employeeDropdown', res.data || [], 'employeeCode', 'employeeName');
            },
            error: function (xhr, status, error) {
                console.error('Error loading employee dropdown:', error);
                showToast('Failed to load employees for selected month and year', 'error');
            }
        });
    }

    function goBack() {
        window.history.back();
    }

    $('#btnFetchSalary').on('click', function () {
        const monthNumber = $('#monthDropdown').val();
        const year = $('#yearDropdown').val();
        const employeeIds = $('#employeeDropdown').val();

        let isValid = true;

        if (!monthNumber) { $('#errorMonth').show(); isValid = false; } else { $('#errorMonth').hide(); }
        if (!year)        { $('#errorYear').show();  isValid = false; } else { $('#errorYear').hide();  }
        if (!employeeIds || employeeIds.length == 0) { $('#errorEmployee').show(); isValid = false; } else { $('#errorEmployee').hide(); }

        if (!isValid) return;

        setBtnLoading('#btnFetchSalary', 'Fetching...');

        const startDate = `${year}-${monthNumber.toString().padStart(2, '0')}-01`;
        const lastDayOfMonth = new Date(year, monthNumber, 0).getDate();
        const endDate = `${year}-${monthNumber.toString().padStart(2, '0')}-${lastDayOfMonth.toString().padStart(2, '0')}`;
        const empCodes = employeeIds.join(",");

        const requestData = {
            StartDate: startDate,
            EndDate: endDate,
            EmployeeCodes: empCodes,
            CompanyId: CompanyId,
            Action: "GetData",
            CreatedBy: EmployeeId
        };

        $.ajax({
            type: "POST",
            url: '@(baseDomainUrl + "/api/MonthlySalaryDetailsAPI/GetMonthlySalary")',
            data: JSON.stringify(requestData),
            contentType: "application/json",
            success: function (response) {
                setBtnNormal('#btnFetchSalary', 'Go');
                if (response && response.data && response.data.length > 0) {
                    salaryPreviewRows = response.data;
                    selectedPreviewIds = {};
                    renderSalaryPreviewGrid(salaryPreviewRows);
                    $('#salaryPreviewCard').show();
                    $('#monthDropdown, #yearDropdown, #employeeDropdown').prop('disabled', true);
                } else {
                    showToast(response.responseMessage || "No data found for the selected criteria", 'error');
                }
            },
            error: function (xhr) {
                setBtnNormal('#btnFetchSalary', 'Go');
                showToast("Failed to fetch salary data", 'error');
                console.log(xhr);
            }
        });
    });

    function togglePreviewRow(code, checked) {
        selectedPreviewIds[code] = checked;
    }

    function getSelectedPreviewRows() {
        return salaryPreviewRows.filter(function (r) { return selectedPreviewIds[r.EmployeeCode]; });
    }

    function renderSalaryPreviewGrid(rows) {
        if (!salaryPreviewGrid) {
            salaryPreviewGrid = WMSGrid.create({
                container: 'salaryGridContainer',
                title: 'Employees',
                icon: 'bx-wallet',
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false },
                data: rows,
                columns: [
                    {
                        header: '', sortable: false, width: '40px',
                        render: function (v, row) {
                            var checked = !!selectedPreviewIds[row.EmployeeCode];
                            return '<input type="checkbox" ' + (checked ? 'checked' : '') + ' onclick="togglePreviewRow(\'' + row.EmployeeCode + '\', this.checked)">';
                        }
                    },
                    { field: 'EmployeeCode', header: 'Code', width: '100px' },
                    { field: 'EmployeeName', header: 'Name', width: '180px' },
                    { field: 'GrossSalary', header: 'Gross Salary', width: '120px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'PayableDays', header: 'Payable Days', width: '110px', align: 'center' },
                    { field: 'AbsentDays', header: 'Absent Days', width: '100px', align: 'center' },
                    { field: 'PresentDays', header: 'Present Days', width: '100px', align: 'center' },
                    { field: 'WeekOff', header: 'Week Off', width: '90px', align: 'center' },
                    { field: 'Leave', header: 'Leave', width: '80px', align: 'center' },
                    { field: 'SalaryDays', header: 'Salary Days', width: '100px', align: 'center' },
                    { field: 'BasicSalary', header: 'Basic Salary', width: '110px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'HRA', header: 'HRA', width: '100px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'ConveyanceAllowance', header: 'Conveyance', width: '110px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'ChildEducationAllowance', header: 'Child Edu. Allowance', width: '150px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'MedicalAllowance', header: 'Medical Allowance', width: '140px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'DeputationAllowance', header: 'Deputation Allowance', width: '150px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'TotalGrossSalary', header: 'Total Gross Salary', width: '140px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'PF', header: 'PF', width: '90px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'ESIC', header: 'ESIC', width: '90px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'ProfessionalTax', header: 'Professional Tax', width: '130px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'LWF', header: 'LWF', width: '80px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'TDS', header: 'TDS', width: '90px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'Loan', header: 'Loan', width: '90px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'Arrears', header: 'Arrears', width: '100px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'GroupMedical', header: 'Group Medical', width: '120px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'TermInsurance', header: 'Term Insurance', width: '120px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'OtherDeduction', header: 'Other Deduction', width: '130px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'TotalDeductions', header: 'Total Deductions', width: '140px', align: 'right', render: function (v) { return numFmt(v); } },
                    { field: 'NetSalary', header: 'Net Salary', width: '120px', align: 'right', render: function (v) { return numFmt(v); } }
                ],
                extraButtons: [{
                    label: 'Select All',
                    onClick: function (e, data) {
                        var allSelected = data.every(function (r) { return selectedPreviewIds[r.EmployeeCode]; });
                        data.forEach(function (r) { selectedPreviewIds[r.EmployeeCode] = !allSelected; });
                        salaryPreviewGrid.refresh();
                    }
                }]
            });
        } else {
            salaryPreviewGrid.setData(rows);
            salaryPreviewGrid.hideLoader();
        }
    }

    $('#btnProcessSalary').on('click', function () {
        const monthNumber = $('#monthDropdown').val();
        const selectedYear = $('#yearDropdown').val();
        const selectedRows = getSelectedPreviewRows();
        const empCodes = selectedRows.map(emp => emp.EmployeeCode).join(",");

        let isValid = true;

        if (!monthNumber)  { $('#errorMonth').show(); isValid = false; } else { $('#errorMonth').hide(); }
        if (!selectedYear) { $('#errorYear').show();  isValid = false; } else { $('#errorYear').hide();  }

        if (!empCodes) {
            showToast("Please select at least one employee from the grid", 'warn');
            isValid = false;
        }

        if (!isValid) return;

        setBtnLoading('#btnProcessSalary', 'Checking...');

        // ── Duplicate-prevention guard: same employee + month + year must not already exist ──
        $.ajax({
            url: '@(baseDomainUrl + "/api/MonthlySalaryDetailsAPI/GetAll")',
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Month: parseInt(monthNumber), Year: parseInt(selectedYear), EmployeeCodes: '', BranchId: 0 }),
            success: function (existingResponse) {
                const existingCodes = (existingResponse && existingResponse.isSuccess && existingResponse.data)
                    ? existingResponse.data.map(function (r) { return String(r.employeeCode); })
                    : [];

                const duplicates = selectedRows.filter(function (r) { return existingCodes.indexOf(String(r.EmployeeCode)) !== -1; });

                if (duplicates.length > 0) {
                    setBtnNormal('#btnProcessSalary', 'Process');
                    showToast('Salary already exists for: ' + duplicates.map(function (d) { return d.EmployeeCode; }).join(', ') + ' for the selected month/year.', 'warn');
                    return;
                }

                setBtnLoading('#btnProcessSalary', 'Processing...');

                const startDate = `${selectedYear}-${monthNumber.toString().padStart(2, '0')}-01`;
                const lastDayOfMonth = new Date(selectedYear, monthNumber, 0).getDate();
                const endDate = `${selectedYear}-${monthNumber.toString().padStart(2, '0')}-${lastDayOfMonth.toString().padStart(2, '0')}`;

                processSalaryInsert({
                    StartDate: startDate,
                    EndDate: endDate,
                    EmployeeCodes: empCodes,
                    CompanyId: CompanyId,
                    Action: "Insert",
                    CreatedBy: EmployeeId
                });
            },
            error: function () {
                // If the duplicate-check call itself fails, fall through to Process —
                // the existing server-side calculation is still the source of truth.
                const startDate = `${selectedYear}-${monthNumber.toString().padStart(2, '0')}-01`;
                const lastDayOfMonth = new Date(selectedYear, monthNumber, 0).getDate();
                const endDate = `${selectedYear}-${monthNumber.toString().padStart(2, '0')}-${lastDayOfMonth.toString().padStart(2, '0')}`;

                setBtnLoading('#btnProcessSalary', 'Processing...');
                processSalaryInsert({
                    StartDate: startDate,
                    EndDate: endDate,
                    EmployeeCodes: empCodes,
                    CompanyId: CompanyId,
                    Action: "Insert",
                    CreatedBy: EmployeeId
                });
            }
        });
    });

    function processSalaryInsert(payload) {
        $.ajax({
            type: "POST",
            url: '@(baseDomainUrl + "/api/MonthlySalaryDetailsAPI/CreateMonthlySalary")',
            data: JSON.stringify(payload),
            contentType: "application/json",
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                setBtnNormal('#btnProcessSalary', 'Process');
                if (response.isSuccess) {
                    showToast(response.responseMessage, 'success');
                    setTimeout(function () {
                        window.location.href = '@UIBaseUrl/AdminPanel/SalaryDetails/Index';
                    }, 1500);
                } else {
                    showToast(response.responseMessage, 'error');
                }
            },
            error: function () {
                setBtnNormal('#btnProcessSalary', 'Process');
                showToast("Something went wrong!", 'error');
            }
        });
    }

    $("#btnClearSalary").on("click", function () {
        selectedPreviewIds = {};
        salaryPreviewRows = [];
        if (salaryPreviewGrid) salaryPreviewGrid.setData([]);
        $('#salaryPreviewCard').hide();
        $('#monthDropdown, #yearDropdown, #employeeDropdown').prop('disabled', false);
    });
</script>
