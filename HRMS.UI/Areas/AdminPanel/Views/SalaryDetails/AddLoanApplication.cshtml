@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Loan Application";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header bg-transparent ml-0 py-0">
        <div class="row">
            <div class="col-6">
                <h6 class="pt-2 mb-0">
                    Manage Employee Loan Application
                </h6>
            </div>
            <div class="col-6 d-flex justify-content-end align-items-center">
                <button id="addLoanApplication"
                        type="button"
                        class="btn mr-1 rounded-1"
                        style="background-color:#2395c6; color:white;">
                    Add
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <div class="grid-wrapper" style="position: relative;">
                        <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column"
                             style="display: none; inset: 0; background: rgba(255,255,255,0.6); z-index: 10;">
                            <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner"
                                 style="width: 30px; height: 30px; animation: spin 1s linear infinite;" />
                            <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                        </div>
                        <div id="gridTag">
                            <div class="rowCount" id="rowCount1"></div>
                            <div id="gridContainer"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loan Application Modal -->
<div class="modal fade" id="addLoanApplicationModal" tabindex="-1" aria-labelledby="addLoanApplicationLabel"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title btn-heading-title" id="modalTitle">Add Loan Application</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font" style="font-size:12px;">
                <form id="loanApplicationForm">
                    <input type="hidden" id="loanApplicationId" value="0">

                    <div class="row">
                        <!-- Application Date -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="applicationDate">Application Date</label>
                                <input type="date" id="applicationDate" placeholder="Application Date">
                            </div>
                            <span class="field-validation-error" id="spnapplicationDate" style="display:none; font-size: 0.85em;">Please Select Application Date</span>
                        </div>

                        <!-- Employee -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="employeeLoan">Employee</label>
                                <select id="employeeLoan">
                                    <option value="" selected disabled>Employee</option>
                                </select>
                                <span id="spnemployeeLoan" class="field-validation-error" style="display:none; font-size: 0.85em;">Please Select Employee</span>
                            </div>
                        </div>

                        <!-- Contact No -->
                        <div class="col-md-4">
                            <div class="fg">
                                <label for="contactNo">Contact No</label>
                                <input type="text" id="contactNo" placeholder="Contact No" readonly>
                            </div>
                        </div>

                        <!-- Email Id -->
                        <div class="col-md-4">
                            <div class="fg">
                                <label for="emailId">Email Id</label>
                                <input type="email" id="emailId" placeholder="Email Id" readonly>
                            </div>
                        </div>

                        <!-- Loan Name -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanName">Loan Name</label>
                                <select id="loanName">
                                    <option value="" selected disabled>Loan Name</option>
                                </select>
                                <span id="spnloanName" class="field-validation-error" style="display:none; font-size: 0.85em;">Please Select Loan Name</span>
                            </div>
                        </div>

                        <!-- Loan Max Limit -->
                        <div class="col-md-4">
                            <div class="fg">
                                <label for="loanMaxLimit">Loan Max Limit</label>
                                <input type="number" id="loanMaxLimit" placeholder="Loan Max Limit" readonly>
                            </div>
                        </div>

                        <!-- Loan Require Date -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanRequireDate">Loan Require Date</label>
                                <input type="date" id="loanRequireDate" placeholder="Loan Require Date">
                            </div>
                            <span class="field-validation-error" id="spnloanRequireDate" style="display:none; font-size: 0.85em;">Please Select Loan Require Date</span>
                        </div>

                        <!-- Loan Amount -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanAmount">Loan Amount</label>
                                <input type="number" id="loanAmount" placeholder="Loan Amount">
                            </div>
                            <span class="field-validation-error" id="spnloanAmount" style="display:none; font-size: 0.85em;">Please Enter Loan Amount</span>
                        </div>

                        <!-- Interest Type -->
                        <div class="col-md-4">
                            <div class="fg">
                                <label for="interestType">Interest Type</label>
                                <input type="text" id="interestType" placeholder="Interest Type" readonly>
                            </div>
                        </div>

                        <!-- Interest % (Yearly) -->
                        <div class="col-md-4">
                            <div class="fg">
                                <label for="interestRate">Interest (%) (Yearly)</label>
                                <input type="number" step="0.01" id="interestRate" placeholder="Interest Rate" readonly>
                            </div>
                        </div>

                        <!-- No of Installment -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="noOfInstallment">No of Installment</label>
                                <input type="number" id="noOfInstallment" placeholder="No of Installment">
                            </div>
                            <span class="field-validation-error" id="spnnoOfInstallment" style="display:none; font-size: 0.85em;">Please Enter No of Installment</span>
                        </div>

                        <!-- Installment Amount -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="installmentAmount">Installment Amount</label>
                                <input type="number" step="0.01" id="installmentAmount" placeholder="Installment Amount" readonly>
                            </div>
                            <span class="field-validation-error" id="spninstallmentAmount" style="display:none; font-size: 0.85em;">Installment Amount Required</span>
                        </div>

                        <!-- Installment Start Date -->
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="installmentStartDate">Installment Start Date</label>
                                <input type="date" id="installmentStartDate" placeholder="Installment Start Date">
                            </div>
                            <span class="field-validation-error" id="spninstallmentStartDate" style="display:none; font-size: 0.85em;">Please Select Installment Start Date</span>
                        </div>

                        <!-- Remark -->
                        <div class="col-md-12">
                            <div class="fg">
                                <label for="remark">Remark</label>
                                <textarea id="remark" placeholder="Remark" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-primary" id="btnSaveLoanApplication"
                        style="background-color:#2395c6; color:white;">
                    Save
                </button>
                <button type="button" class="btn btn-primary" id="btnSavingLoanApplication"
                        style="background-color:#2395c6; color:white;display:none;" disabled>
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span> Saving..
                </button>
                <button type="button" class="btn btn-secondary" id="btnClearLoanApplication">Clear</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script src="~/assets/js/jquery.min.js"></script>
<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails?.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    var loanMasterData = [];
    var employeeData = [];
    var gridDataSource = [];

    $(document).ready(function(){

        var today = new Date().toISOString().split('T')[0];
        $('#applicationDate').val(today);

        // Employee dropdown change
        $('#employeeLoan').on('change', function () {
            var val = $(this).val();
            if (val) {
                var item = employeeData.find(e => e.id == val) || { id: val };
                fetchEmployeeDetailsById(item);
            } else {
                $('#emailId').val('');
                $('#contactNo').val('');
                $('#loanMaxLimit').val('');
            }
        });

        // Loan dropdown change
        $('#loanName').on('change', function () {
            var val = $(this).val();
            var selectedLoan = loanMasterData.find(l => l.loanid == val);
            if (selectedLoan) {
                onLoanSelected(selectedLoan);
            }
        });

        $('#interestRate').val('0');

        loadLoanApplications();
        BindAllEmployees();
        BindLoanMasterDropdown();
    });

    $("#addLoanApplication").click(() => {
        resetLoanApplicationForm();
        $('#modalTitle').text('Add Loan Application');
        $("#addLoanApplicationModal").modal('show');
    });

    $("#btnClearLoanApplication").click(() => {
        resetLoanApplicationForm();
    });

    function showbtnLoder(isUpdate){
        $('#btnSaveLoanApplication').hide();
        if(isUpdate) {
            $('#btnSavingLoanApplication').html('<span class="spinner-border spinner-border-sm me-2" role="status"></span> Updating..');
        } else {
            $('#btnSavingLoanApplication').html('<span class="spinner-border spinner-border-sm me-2" role="status"></span> Saving..');
        }
        $('#btnSavingLoanApplication').show();
    }

    function hidebtnLoder(){
        $('#btnSaveLoanApplication').show();
        $('#btnSavingLoanApplication').hide();
    }

    async function fetchEmployeeDetailsById(employeeId) {
        debugger;
        if (!employeeId) return;

        try {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetEmployeeDetailsByEmpId?empId=' + employeeId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    if (response.isSuccess && response.data) {
                        var empData = response.data;
                        var officialEmail = empData.officialEmail || empData.OfficialEmail || '';
                        $('#emailId').val(officialEmail);

                        var contactNo = empData.contactNo || empData.ContactNo || '';
                        $('#contactNo').val(contactNo);

                        var grossSalary = parseFloat(empData.grossSalary || empData.GrossSalary || 0);
                        var loanMaxLimit = grossSalary * 2;
                        $('#loanMaxLimit').val(loanMaxLimit);

                        $('#interestRate').val('0');
                    }
                },
                error: function (error) {
                    console.error('Error fetching employee details:', error);
                }
            });
        } catch (error) {
            console.error('Exception in fetchEmployeeDetailsById:', error);
        }
    }

    async function BindAllEmployees() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetAllEmployee?companyId=' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (data) {
                    if (data.isSuccess) {
                        employeeData = data.data || [];
                        var $empSel = $('#employeeLoan');
                        $empSel.empty().append('<option value="" selected disabled>Employee</option>');
                        employeeData.forEach(function (e) {
                            $empSel.append($('<option>', { value: e.id, text: e.fullName }));
                        });
                        resolve(employeeData);
                    } else {
                        reject('Failed to fetch employees');
                    }
                },
                error: function (error) {
                    reject(error);
                }
            });
        });
    }

    async function BindLoanMasterDropdown() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/GetLoanNamesForDropdown',
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (data) {
                    if (data.isSuccess) {
                        loanMasterData = (data.data || []).map(loan => ({
                            loanid: loan.loanid || loan.Loanid || loan.LoanId,
                            loanName: loan.loanName || loan.LoanName,
                            maxLimit: loan.maxLimit || loan.MaxLimit || 0,
                            interestType: loan.interestType || loan.InterestType || '',
                            interestRate: loan.interestRate || loan.InterestRate || 0
                        }));

                        var $loanSel = $('#loanName');
                        $loanSel.empty().append('<option value="" selected disabled>Loan Name</option>');
                        loanMasterData.forEach(function (l) {
                            $loanSel.append($('<option>', { value: l.loanid, text: l.loanName }));
                        });
                        resolve(loanMasterData);
                    } else {
                        reject('Failed to fetch loans');
                    }
                },
                error: function (error) {
                    reject(error);
                }
            });
        });
    }

    function onLoanSelected(loan) {
        if (!loan) return;

        let selectedLoan = loan;

        if (!loan.hasOwnProperty('maxLimit') && !loan.hasOwnProperty('MaxLimit')) {
            const loanid = loan.loanid || loan.Loanid || loan.LoanId;
            selectedLoan = loanMasterData.find(l => l.loanid == loanid);

            if (!selectedLoan) {
                return;
            }
        }

        const interestType = selectedLoan.interestType || selectedLoan.InterestType || '';
        $('#interestType').val(interestType);
        $('#interestRate').val('0');

        calculateInstallmentAmount();
    }

    $('#loanAmount, #noOfInstallment').on('input', function() {
        var noOfInstallment = parseInt($('#noOfInstallment').val()) || 0;
        if (noOfInstallment > 10) {
            $('#noOfInstallment').val('10');
            round_error_noti('Number of installments cannot exceed 10');
        }

        calculateInstallmentAmount();
    });

    function calculateInstallmentAmount() {
        var loanAmount = parseFloat($('#loanAmount').val()) || 0;
        var noOfInstallment = parseInt($('#noOfInstallment').val()) || 0;

        if (loanAmount > 0 && noOfInstallment > 0) {
            var installmentAmount = loanAmount / noOfInstallment;
            $('#installmentAmount').val(installmentAmount.toFixed(2));
        } else {
            $('#installmentAmount').val('');
        }
    }

    async function loadLoanApplications() {
        $('#grid-loader').addClass('d-flex').show();
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/GetLoanApplication?CompanyId=' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    gridDataSource = response.data || [];
                    var gridInstance = $("#gridContainer").dxDataGrid({
                        dataSource: gridDataSource,
                        columns: [
                            {
                                dataField: 'applicationDate',
                                caption: 'Application Date',
                                dataType: 'date',
                                format: 'dd-MM-yyyy'
                            },
                            { dataField: 'employeeCode', caption: 'Employee Code' },
                            { dataField: 'fullName', caption: 'Employee Name' },
                            { dataField: 'loanName', caption: 'Loan Name' },
                            {
                                dataField: 'loanAmount',
                                caption: 'Loan Amount',
                                dataType: 'number',
                                format: '#,##0.00'
                            },
                            {
                                dataField: 'noOfinstallment',
                                caption: 'Installments'
                            },
                            {
                                dataField: 'installmentAmount',
                                caption: 'Installment Amount',
                                dataType: 'number',
                                format: '#,##0.00',
                                visible: false
                            },
                            {
                                dataField: 'loanRequireDate',
                                caption: 'Require Date',
                                dataType: 'date',
                                format: 'dd-MM-yyyy'
                            },
                            {
                                dataField: 'installmentStartDate',
                                caption: 'Installment Start Date',
                                dataType: 'date',
                                format: 'dd-MM-yyyy'
                            },
                            { dataField: 'remark', caption: 'Remark', visible: false },
                            { dataField: 'loanApplicationId', visible: false },
                            { dataField: 'loanApplicationID', visible: false },
                            { dataField: 'id', visible: false },
                            { dataField: 'employeeId', visible: false },
                            { dataField: 'loanid', visible: false },
                            { dataField: 'contactNo', visible: false },
                            { dataField: 'emailId', visible: false },
                            { dataField: 'loanMaxLimit', visible: false },
                            { dataField: 'interestType', visible: false },
                            { dataField: 'interestRate', visible: false },
                            { dataField: 'interestPercentage', visible: false },
                            {
                                dataField: '',
                                caption: 'Actions',
                                width: '100px',
                                cellTemplate: function (container, options) {
                                    var buttonElement = $('<div class="d-flex order-actions">' +
                                        '<a href="javascript:;" class="edit-action me-2" title="Edit Loan Application">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">' +
                                        '<path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>' +
                                        '<path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>' +
                                        '</svg>' +
                                        '</a>' +
                                        '<a href="javascript:;" class="delete-action" title="Delete Loan Application">' +
                                        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">' +
                                        '<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>' +
                                        '<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>' +
                                        '</svg>' +
                                        '</a>' +
                                        '</div>');

                                    buttonElement.find('.edit-action').on('click', function () {
                                        UpdateLoanApplicationData(options.data);
                                    });

                                    buttonElement.find('.delete-action').on('click', function () {
                                        DeleteLoanApplication(options.data);
                                    });

                                    buttonElement.appendTo(container);
                                }
                            }
                        ],
                        columnAutoWidth: true,
                        allowColumnResizing: true,
                        columnResizingMode: "widget",
                        wordWrapEnabled: false,
                        showBorders: true,
                        scrolling: {
                            mode: "standard",
                            useNative: true,
                            scrollByContent: true,
                            scrollByThumb: true,
                            showScrollbar: "always"
                        },
                        rowAlternationEnabled: false,
                        grouping: { autoExpandAll: false },
                        paging: { pageSize: 10 },
                        pager: {
                            showPageSizeSelector: true,
                            allowedPageSizes: [10, 25, 50, 100]
                        },
                        headerFilter: { visible: false },
                        filterRow: { visible: false, applyFilter: "auto" },
                        groupPanel: { visible: false },
                        searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                        allowColumnReordering: false,
                        onContentReady(e) {
                            $('.rowCount').html('Total Records: ' + e.component.totalCount());
                            e.component.updateDimensions();
                            $('#grid-loader').removeClass('d-flex').hide();
                        }
                    }).dxDataGrid('instance');

                    $('#grid-loader').removeClass('d-flex').hide();
                    resolve(response.data);
                },
                error: function (error) {
                    $('#grid-loader').removeClass('d-flex').hide();
                    console.error('Error loading loan applications:', error);
                    round_error_noti('Unable to load loan applications');
                    reject(error);
                }
            });
        });
    }

    async function fetchEmployeeDetailsById(employeeId) {
        debugger;
        const Empid = employeeId.id
        if (!Empid) return;

        try {
            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/GetEmployeeDetailsByEmpId?EmployeeId=' + Empid,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    if (response.isSuccess && response.data) {
                        var empData = response.data;

                        // Set Official Email
                        var officialEmail = empData.officialEmail || empData.OfficialEmail || '';
                        $('#emailId').val(officialEmail);

                        // Set Contact Number (first 10 digits only)
                        var contact = empData.contactNo || empData.ContactNo || empData.mobileNo || empData.MobileNo || '';
                        if (contact) {
                            contact = contact.toString().replace(/\D/g, '').substring(0, 10);
                        }
                        $('#contactNo').val(contact);

                        // Calculate Loan Max Limit (2 times of Gross Salary)
                        var grossSalary = parseFloat(empData.grossSalary || empData.GrossSalary || 0);
                        var loanMaxLimit = grossSalary * 2;
                        $('#loanMaxLimit').val(loanMaxLimit.toFixed(2));

                        // Set Interest Rate to 0
                        $('#interestRate').val('0');

                
                    } else {
                        console.error('Failed to fetch employee details');
                        round_error_noti('Unable to fetch employee details');
                    }
                },
                error: function (error) {
                    console.error('Error fetching employee details:', error);
                    round_error_noti('Error loading employee information');
                }
            });
        } catch (error) {
            console.error('Exception in fetchEmployeeDetailsById:', error);
        }
    }

    // Enhanced validation in Save button click handler
    // Replace the existing $('#btnSaveLoanApplication').click function with this:

    $('#btnSaveLoanApplication').click(function () {
        var loanApplicationId = parseInt($('#loanApplicationId').val()) || 0;
        var isUpdate = loanApplicationId > 0;

        showbtnLoder(isUpdate);

        var applicationDate = $('#applicationDate').val();
        var employee = $('#employeeLoan').val() || null;
        var loanIdValue = $('#loanName').val() || null;
        var loanRequireDate = $('#loanRequireDate').val();
        var loanAmount = $('#loanAmount').val();
        var noOfInstallment = $('#noOfInstallment').val();
        var installmentAmount = $('#installmentAmount').val();
        var installmentStartDate = $('#installmentStartDate').val();

        var isValid = true;

        // Application Date Validation
        if (!applicationDate) {
            $('#spnapplicationDate').text('Please Select Application Date').show();
            isValid = false;
        } else {
            $('#spnapplicationDate').hide();
        }

        // Employee Validation
        if (!employee) {
            $('#spnemployeeLoan').text('Please Select Employee').show();
            isValid = false;
        } else {
            $('#spnemployeeLoan').hide();
        }

        // Loan Name Validation
        if (!loanIdValue) {
            $('#spnloanName').text('Please Select Loan Name').show();
            isValid = false;
        } else {
            $('#spnloanName').hide();
        }

        // Loan Require Date Validation
        if (!loanRequireDate) {
            $('#spnloanRequireDate').text('Please Select Loan Require Date').show();
            isValid = false;
        } else {
            // Check if date is not in past
            var today = new Date().toISOString().split('T')[0];
            if (loanRequireDate < today) {
                $('#spnloanRequireDate').text('Date cannot be in the past').show();
                isValid = false;
            } else {
                $('#spnloanRequireDate').hide();
            }
        }

        // Loan Amount Validation
        if (!loanAmount || parseFloat(loanAmount) <= 0) {
            $('#spnloanAmount').text('Please Enter Valid Loan Amount').show();
            isValid = false;
        } else {
            var loanMaxLimit = parseFloat($('#loanMaxLimit').val()) || 0;
            if (loanMaxLimit > 0 && parseFloat(loanAmount) > loanMaxLimit) {
                $('#spnloanAmount').text('Amount exceeds maximum limit of ₹' + loanMaxLimit.toFixed(2)).show();
                isValid = false;
            } else {
                $('#spnloanAmount').hide();
            }
        }

        // Number of Installment Validation (Maximum 10)
        if (!noOfInstallment || parseInt(noOfInstallment) <= 0) {
            $('#spnnoOfInstallment').text('Please Enter Number of Installments').show();
            isValid = false;
        } else if (parseInt(noOfInstallment) > 10) {
            $('#spnnoOfInstallment').text('Maximum 10 installments allowed').show();
            isValid = false;
        } else {
            $('#spnnoOfInstallment').hide();
        }

        // Installment Amount Validation
        if (!installmentAmount || parseFloat(installmentAmount) <= 0) {
            $('#spninstallmentAmount').text('Installment Amount Required').show();
            isValid = false;
        } else {
            $('#spninstallmentAmount').hide();
        }

        // Installment Start Date Validation
        if (!installmentStartDate) {
            $('#spninstallmentStartDate').text('Please Select Installment Start Date').show();
            isValid = false;
        } else {
            // Check if date is not in past
            var today = new Date().toISOString().split('T')[0];
            if (installmentStartDate < today) {
                $('#spninstallmentStartDate').text('Date cannot be in the past').show();
                isValid = false;
            }
            // Check if installment start date is after loan require date
            else if (loanRequireDate && installmentStartDate < loanRequireDate) {
                $('#spninstallmentStartDate').text('Must be after loan require date').show();
                isValid = false;
            } else {
                $('#spninstallmentStartDate').hide();
            }
        }

        // If validation fails, stop and show first error
        if (!isValid) {
            hidebtnLoder();
            // Scroll to first visible error
            var firstError = $('span[id^="spn"]:visible').first();
            if (firstError.length) {
                $('html, body').animate({
                    scrollTop: firstError.offset().top - 100
                }, 300);
            }
            return;
        }

        // Prepare API payload
        var loanApplicationData = {
            LoanApplicationID: loanApplicationId,
            ApplicationDate: applicationDate,
            EmployeeId: parseInt(employee),
            ContactNo: $('#contactNo').val() || '',
            EmailId: $('#emailId').val() || '',
            LoanId: parseInt(loanIdValue),
            LoanRequireDate: loanRequireDate,
            LoanMaxLimit: parseFloat($('#loanMaxLimit').val()) || 0,
            LoanAmount: parseFloat(loanAmount),
            InterestType: $('#interestType').val() || '',
            InterestPercentage: 0, // Always 0
            NoOfInstallment: parseInt(noOfInstallment),
            InstallmentAmount: parseFloat(installmentAmount),
            InstallmentStartDate: installmentStartDate,
            Remark: $('#remark').val().trim() || '',
            IsEnabled: true,
            IsDeleted: false,
            CreatedBy: parseInt(EmployeeId),
            UpdatedBy: isUpdate ? parseInt(EmployeeId) : null,
            CreatedDate: new Date().toISOString(),
            UpdatedDate: isUpdate ? new Date().toISOString() : null,
            DeletedDate: null,
            DeletedBy: null
        };

        var apiUrl = isUpdate
            ? "@baseUrl/LoanApplicationAPI/UpdateLoanApplication"
            : "@baseUrl/LoanApplicationAPI/CreateLoanApplication";

        var httpMethod = isUpdate ? "PUT" : "POST";

        $.ajax({
            url: apiUrl,
            type: httpMethod,
            contentType: 'application/json',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            data: JSON.stringify(loanApplicationData),
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    $("#addLoanApplicationModal").modal('hide');
                    resetLoanApplicationForm();
                    loadLoanApplications();
                } else {
                    round_error_noti(response.responseMessage);
                }
                hidebtnLoder();
            },
            error: function (xhr) {
                hidebtnLoder();
                var errorMessage = 'Unable to save loan application';

                if (xhr.responseJSON) {
                    if (xhr.responseJSON.responseMessage) {
                        errorMessage = xhr.responseJSON.responseMessage;
                    } else if (xhr.responseJSON.errors) {
                        var errors = xhr.responseJSON.errors;
                        var errorList = [];
                        for (var key in errors) {
                            if (errors.hasOwnProperty(key)) {
                                errorList.push(errors[key].join(', '));
                            }
                        }
                        errorMessage = errorList.join('; ');
                    } else if (xhr.responseJSON.title) {
                        errorMessage = xhr.responseJSON.title;
                    }
                } else if (xhr.responseText) {
                    try {
                        var errorResponse = JSON.parse(xhr.responseText);
                        errorMessage = errorResponse.responseMessage || errorResponse.message || errorMessage;
                    } catch (e) {
                        errorMessage = xhr.responseText.substring(0, 200);
                    }
                }

                round_error_noti(errorMessage);
            }
        });
    });

    // Update the installment input handler to restrict to max 10
    $('#loanAmount, #noOfInstallment').on('input', function() {
        var noOfInstallment = parseInt($('#noOfInstallment').val()) || 0;

        // Restrict to maximum 10 installments
        if (noOfInstallment > 10) {
            $('#noOfInstallment').val('10');
            round_error_noti('Maximum 10 installments allowed');
        }

        calculateInstallmentAmount();
    });

    // Clear error messages on input change
    $('#loanApplicationForm input, #loanApplicationForm textarea, #loanApplicationForm select').on('input change', function () {
        var fieldId = $(this).attr('id');
        if (fieldId) {
            $('#spn' + fieldId).hide();
        }
    });

    async function resetLoanApplicationForm() {
        $('#loanApplicationId').val('0');

        var today = new Date().toISOString().split('T')[0];
        $('#applicationDate').val(today);

        $('#employeeLoan').val('');
        $('#loanName').val('');

        $('#contactNo').val('');
        $('#emailId').val('');
        $('#loanMaxLimit').val('');
        $('#loanRequireDate').val('');
        $('#loanAmount').val('');
        $('#interestType').val('');
        $('#interestRate').val('0');
        $('#noOfInstallment').val('');
        $('#installmentAmount').val('');
        $('#installmentStartDate').val('');
        $('#remark').val('');

        hidebtnLoder();
        $('#btnSaveLoanApplication').text('Save');

        $('span[id^="spn"]').hide();
    }

    async function UpdateLoanApplicationData(data) {

        await resetLoanApplicationForm();

        $('#modalTitle').text('Update Loan Application');
        $('#btnSaveLoanApplication').text('Update');

        // Set Loan Application ID
        var loanAppId = data.loanApplicationId || data.LoanApplicationId || data.loanApplicationID || data.LoanApplicationID || 0;
        $('#loanApplicationId').val(loanAppId);

        // Set Application Date
        var appDateStr = data.applicationdate || data.applicationDate || data.ApplicationDate;
        if (appDateStr) {
            var formattedDate = formatDateForInput(appDateStr);
            $('#applicationDate').val(formattedDate);
    
        }

        // Set Contact, Email, Loan Max Limit
        var contactNo = data.contactNo || data.ContactNo || '';
        var emailId = data.emailId || data.EmailId || '';
        var loanMaxLimit = data.loanMaxLimit || data.LoanMaxLimit || '';

        $('#contactNo').val(contactNo);
        $('#emailId').val(emailId);
        $('#loanMaxLimit').val(loanMaxLimit);

        // Set Interest Type and Rate
        var interestType = data.interestType || data.InterestType || '';
        var interestRate = data.interestRate || data.InterestRate || data.interestPercentage || data.InterestPercentage || '0';
        $('#interestType').val(interestType);
        $('#interestRate').val(interestRate);


        // Set Loan Require Date
        var loanReqDateStr = data.loanRequireDate || data.LoanRequireDate;
        if (loanReqDateStr) {
            var formattedLoanReqDate = formatDateForInput(loanReqDateStr);
            $('#loanRequireDate').val(formattedLoanReqDate);
    
        }

        // Set Loan Amount, Installments
        var loanAmt = data.loanAmount || data.LoanAmount || '';
        var numInstallments = data.noOfinstallment || data.noOfInstallment || data.NoOfInstallment || '';
        var instAmt = data.installmentAmount || data.InstallmentAmount || '';

        $('#loanAmount').val(loanAmt);
        $('#noOfInstallment').val(numInstallments);
        $('#installmentAmount').val(instAmt);


        // Set Installment Start Date
        var instStartDateStr = data.installmentStartDate || data.InstallmentStartDate || data.installmentstartDate;
        if (instStartDateStr) {
            var formattedInstStartDate = formatDateForInput(instStartDateStr);
            $('#installmentStartDate').val(formattedInstStartDate);
   
        }

        // Set Remark
        var remarkText = data.remark || data.Remark || '';
        $('#remark').val(remarkText);
  

        // SET EMPLOYEE DROPDOWN
        var employeeId = data.employeeId || data.id || data.Id;


        if (employeeId) {
            setTimeout(() => {
                $('#employeeLoan').val(employeeId);
            }, 300);
        } else {
            console.error('NO EMPLOYEE ID FOUND IN DATA!');
        }

        // SET LOAN NAME DROPDOWN
        var loanId = data.loanId || data.loanID;


        if (loanId) {
            setTimeout(() => {
                $('#loanName').val(loanId);
            }, 400);
        } else {
            console.error('NO LOAN ID FOUND IN DATA!');
        }

        $("#addLoanApplicationModal").modal('show');
    }

    function formatDateForInput(dateStr) {
        if (!dateStr) return '';

        try {
            if (dateStr.includes('T')) {
                return dateStr.split('T')[0];
            } else if (dateStr.includes(' ')) {
                return dateStr.split(' ')[0];
            } else if (dateStr.includes('-')) {
                var parts = dateStr.split('-');
                if (parts[0].length === 4) {
                    return dateStr;
                } else if (parts[2].length === 4) {
                    return parts[2] + '-' + parts[1] + '-' + parts[0];
                }
            }
            return dateStr;
        } catch (e) {
            console.error('Error formatting date:', e);
            return '';
        }
    }

    function DeleteLoanApplication(data) {
        if (!confirm("Are you sure you want to delete this loan application record?")) {
            return;
        }

        var deleteObj = {
            Id: [data.loanApplicationId || data.LoanApplicationId || data.loanApplicationID || data.LoanApplicationID],
            DeletedBy: EmployeeId.toString(),
        };

        $.ajax({
            url: '@baseUrl/LoanApplicationAPI/Delete',
            type: "DELETE",
            data: JSON.stringify(deleteObj),
            contentType: 'application/json',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    loadLoanApplications();
                } else {
                    round_error_noti(response.responseMessage);
                }
            },
            error: function (xhr, status, error) {
                round_error_noti('An error occurred while deleting the record. Please try again');
            }
        });
    }

</script>