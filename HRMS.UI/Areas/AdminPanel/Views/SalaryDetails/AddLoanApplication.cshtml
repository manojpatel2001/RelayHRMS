@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Loan Application";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Manage Employee Loan Application</h6>
        <button id="addLoanApplication" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bx bx-plus"></i> Add
        </button>
    </div>
    <div class="card-body">
        <div id="loanGridContainer"></div>
    </div>
</div>

<!-- Loan Application Modal -->
<div class="modal fade" id="addLoanApplicationModal" tabindex="-1" aria-labelledby="addLoanApplicationLabel"
     aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="modalTitle">Add Loan Application</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="loanApplicationForm">
                    <input type="hidden" id="loanApplicationId" value="0">

                    <div class="sec-lbl">Employee Details</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="fg fg-req">
                                <label for="applicationDate">Application Date</label>
                                <input type="date" id="applicationDate">
                            </div>
                            <span class="field-validation-error" id="spnapplicationDate" style="display:none;">Please Select Application Date</span>
                        </div>

                        <div class="col-md-3">
                            <div class="fg fg-req">
                                <label for="employeeLoan">Employee</label>
                                <select id="employeeLoan">
                                    <option value="" selected disabled>Select Employee</option>
                                </select>
                            </div>
                            <span id="spnemployeeLoan" class="field-validation-error" style="display:none;">Please Select Employee</span>
                        </div>

                        <div class="col-md-3">
                            <div class="fg">
                                <label for="contactNo">Contact No</label>
                                <input type="text" id="contactNo" placeholder="Auto-filled" readonly>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="fg">
                                <label for="emailId">Email Id</label>
                                <input type="email" id="emailId" placeholder="Auto-filled" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="sec-lbl">Loan Details</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanName">Loan Name</label>
                                <select id="loanName">
                                    <option value="" selected disabled>Select Loan</option>
                                </select>
                            </div>
                            <span id="spnloanName" class="field-validation-error" style="display:none;">Please Select Loan Name</span>
                        </div>

                        <div class="col-md-4">
                            <div class="fg">
                                <label for="loanMaxLimit">Loan Max Limit</label>
                                <input type="number" id="loanMaxLimit" placeholder="Auto-calculated" readonly>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanRequireDate">Loan Require Date</label>
                                <input type="date" id="loanRequireDate">
                            </div>
                            <span class="field-validation-error" id="spnloanRequireDate" style="display:none;">Please Select Loan Require Date</span>
                        </div>

                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="loanAmount">Loan Amount</label>
                                <input type="number" id="loanAmount" placeholder="Enter Loan Amount">
                            </div>
                            <span class="field-validation-error" id="spnloanAmount" style="display:none;">Please Enter Loan Amount</span>
                        </div>

                        <div class="col-md-4">
                            <div class="fg">
                                <label for="interestType">Interest Type</label>
                                <input type="text" id="interestType" placeholder="Auto-filled" readonly>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="fg">
                                <label for="interestRate">Interest (%) (Yearly)</label>
                                <input type="number" step="0.01" id="interestRate" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="sec-lbl">Installment Details</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="noOfInstallment">No of Installments</label>
                                <input type="number" id="noOfInstallment" placeholder="Max 10" min="1" max="10">
                            </div>
                            <span class="field-validation-error" id="spnnoOfInstallment" style="display:none;">Please Enter No of Installments</span>
                        </div>

                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="installmentAmount">Installment Amount</label>
                                <input type="number" step="0.01" id="installmentAmount" placeholder="Auto-calculated" readonly>
                            </div>
                            <span class="field-validation-error" id="spninstallmentAmount" style="display:none;">Installment Amount Required</span>
                        </div>

                        <div class="col-md-4">
                            <div class="fg fg-req">
                                <label for="installmentStartDate">Installment Start Date</label>
                                <input type="date" id="installmentStartDate">
                            </div>
                            <span class="field-validation-error" id="spninstallmentStartDate" style="display:none;">Please Select Installment Start Date</span>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="sec-lbl">Additional Information</div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="fg">
                                <label for="remark">Remark</label>
                                <textarea id="remark" placeholder="Remark (optional)" rows="3" maxlength="250"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveLoanApplication">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Save</span>
                </button>
                <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="btnClearLoanApplication">
                    <i class="bx bx-refresh"></i> Reset
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails?.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    var loanMasterData = [];
    var employeeData = [];
    var gridDataSource = [];
    var loanGrid = null;
    var isSavingLoan = false;

    function fmtDate(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        return String(d.getDate()).padStart(2, '0') + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + d.getFullYear();
    }

    $(document).ready(function(){

        var today = new Date().toISOString().split('T')[0];
        $('#applicationDate').val(today);
        $('#interestRate').val('0');

        // Employee dropdown change
        $('#employeeLoan').on('change', function () {
            var val = $(this).val();
            if (val) {
                fetchEmployeeDetailsById(val);
            } else {
                $('#emailId').val('');
                $('#contactNo').val('');
                $('#loanMaxLimit').val('');
            }
        });

        // Loan dropdown change
        $('#loanName').on('change', function () {
            var val = $(this).val();
            var selectedLoan = loanMasterData.find(l => l.loanid == val);
            if (selectedLoan) {
                onLoanSelected(selectedLoan);
            }
        });

        PermGuard.onReady(function () { loadLoanApplications(); });
        BindAllEmployees();
        BindLoanMasterDropdown();
        PermGuard.applyActions('salarydetails-addloanapplication', { create: '#addLoanApplication' });
    });

    $("#addLoanApplication").click(() => {
        resetLoanApplicationForm();
        $('#modalTitle').text('Add Loan Application');
        $("#addLoanApplicationModal").modal('show');
    });

    $("#btnClearLoanApplication").click(() => {
        resetLoanApplicationForm();
    });

    async function fetchEmployeeDetailsById(employeeId) {
        if (!employeeId) return;

        $.ajax({
            url: '@baseUrl/LoanApplicationAPI/GetEmployeeDetailsByEmpId?EmployeeId=' + employeeId,
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess && response.data) {
                    var empData = response.data;

                    var officialEmail = empData.officialEmail || empData.OfficialEmail || '';
                    $('#emailId').val(officialEmail);

                    var contact = empData.contactNo || empData.ContactNo || empData.mobileNo || empData.MobileNo || '';
                    if (contact) {
                        contact = contact.toString().replace(/\D/g, '').substring(0, 10);
                    }
                    $('#contactNo').val(contact);

                    var grossSalary = parseFloat(empData.grossSalary || empData.GrossSalary || 0);
                    var loanMaxLimit = grossSalary * 2;
                    $('#loanMaxLimit').val(loanMaxLimit.toFixed(2));

                    $('#interestRate').val('0');
                } else {
                    showToast('Unable to fetch employee details', 'error');
                }
            },
            error: function (error) {
                console.error('Error fetching employee details:', error);
                showToast('Error loading employee information', 'error');
            }
        });
    }

    async function BindAllEmployees() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetAllEmployee?companyId=' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (data) {
                    if (data.isSuccess) {
                        employeeData = data.data || [];
                        var $empSel = $('#employeeLoan');
                        $empSel.empty().append('<option value="" selected disabled>Select Employee</option>');
                        employeeData.forEach(function (e) {
                            $empSel.append($('<option>', { value: e.id, text: e.fullName }));
                        });
                        resolve(employeeData);
                    } else {
                        reject('Failed to fetch employees');
                    }
                },
                error: function (error) {
                    reject(error);
                }
            });
        });
    }

    async function BindLoanMasterDropdown() {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/GetLoanNamesForDropdown',
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (data) {
                    if (data.isSuccess) {
                        loanMasterData = (data.data || []).map(loan => ({
                            loanid: loan.loanid || loan.Loanid || loan.LoanId,
                            loanName: loan.loanName || loan.LoanName,
                            maxLimit: loan.maxLimit || loan.MaxLimit || 0,
                            interestType: loan.interestType || loan.InterestType || '',
                            interestRate: loan.interestRate || loan.InterestRate || 0
                        }));

                        var $loanSel = $('#loanName');
                        $loanSel.empty().append('<option value="" selected disabled>Select Loan</option>');
                        loanMasterData.forEach(function (l) {
                            $loanSel.append($('<option>', { value: l.loanid, text: l.loanName }));
                        });
                        resolve(loanMasterData);
                    } else {
                        reject('Failed to fetch loans');
                    }
                },
                error: function (error) {
                    reject(error);
                }
            });
        });
    }

    function onLoanSelected(loan) {
        if (!loan) return;

        const interestType = loan.interestType || loan.InterestType || '';
        $('#interestType').val(interestType);
        $('#interestRate').val('0');

        calculateInstallmentAmount();
    }

    $('#loanAmount, #noOfInstallment').on('input', function () {
        var noOfInstallment = parseInt($('#noOfInstallment').val()) || 0;
        if (noOfInstallment > 10) {
            $('#noOfInstallment').val('10');
            showToast('Maximum 10 installments allowed', 'warn');
        }
        calculateInstallmentAmount();
    });

    function calculateInstallmentAmount() {
        var loanAmount = parseFloat($('#loanAmount').val()) || 0;
        var noOfInstallment = parseInt($('#noOfInstallment').val()) || 0;

        if (loanAmount > 0 && noOfInstallment > 0) {
            var installmentAmount = loanAmount / noOfInstallment;
            $('#installmentAmount').val(installmentAmount.toFixed(2));
            $('#spninstallmentAmount').hide();
        } else {
            $('#installmentAmount').val('');
        }
    }

    // ─── Grid ─────────────────────────────────────────────────────────────────────
    function renderLoanGrid(rows) {
        if (!loanGrid) {
            loanGrid = WMSGrid.create({
                container: 'loanGridContainer',
                title: 'Loan Applications',
                icon: 'bx-money',
                perPage: 10,
                data: rows,
                columns: [
                    { field: 'applicationDate', header: 'Application Date', width: '130px', align: 'center', render: function (v) { return fmtDate(v); } },
                    { field: 'employeeCode', header: 'Employee Code', width: '120px' },
                    { field: 'fullName', header: 'Employee Name', width: '180px' },
                    { field: 'loanName', header: 'Loan Name', width: '150px' },
                    { field: 'loanAmount', header: 'Loan Amount', width: '130px', align: 'right', render: function (v) { return Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } },
                    { field: 'noOfinstallment', header: 'Installments', width: '110px', align: 'center' },
                    { field: 'loanRequireDate', header: 'Require Date', width: '130px', align: 'center', render: function (v) { return fmtDate(v); } },
                    { field: 'installmentStartDate', header: 'Installment Start Date', width: '160px', align: 'center', render: function (v) { return fmtDate(v); } },
                    {
                        header: 'Actions', sortable: false, stickyRight: true, width: '100px', align: 'center',
                        render: function (v, row) {
                            var key = row.loanApplicationId || row.loanApplicationID || row.id;
                            var html = '';
                            if (PermGuard.has('edit-salarydetails-addloanapplication')) {
                                html += '<button type="button" class="wg-btn wg-btn-outline" title="Edit" onclick="UpdateLoanApplicationData(gridDataSource.find(function(r){return (r.loanApplicationId||r.loanApplicationID||r.id)===' + key + ';}))"><i class="bx bx-edit"></i></button> ';
                            }
                            if (PermGuard.has('delete-salarydetails-addloanapplication')) {
                                html += '<button type="button" class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="DeleteLoanApplication(gridDataSource.find(function(r){return (r.loanApplicationId||r.loanApplicationID||r.id)===' + key + ';}))"><i class="bx bx-trash"></i></button>';
                            }
                            return html;
                        }
                    }
                ]
            });
        } else {
            loanGrid.setData(rows);
            loanGrid.hideLoader();
        }
    }

    async function loadLoanApplications() {
        if (loanGrid) loanGrid.showLoader();
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/GetLoanApplication?CompanyId=' + CompanyId,
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    gridDataSource = response.data || [];
                    renderLoanGrid(gridDataSource);
                    resolve(response.data);
                },
                error: function (error) {
                    if (loanGrid) loanGrid.hideLoader();
                    console.error('Error loading loan applications:', error);
                    showToast('Unable to load loan applications', 'error');
                    reject(error);
                }
            });
        });
    }

    // ─── Save ─────────────────────────────────────────────────────────────────────
    $('#btnSaveLoanApplication').click(function () {
        if (isSavingLoan) return;

        var loanApplicationId = parseInt($('#loanApplicationId').val()) || 0;
        var isUpdate = loanApplicationId > 0;

        var applicationDate = $('#applicationDate').val();
        var employee = $('#employeeLoan').val() || null;
        var loanIdValue = $('#loanName').val() || null;
        var loanRequireDate = $('#loanRequireDate').val();
        var loanAmount = $('#loanAmount').val();
        var noOfInstallment = $('#noOfInstallment').val();
        var installmentAmount = $('#installmentAmount').val();
        var installmentStartDate = $('#installmentStartDate').val();

        var isValid = true;

        if (!applicationDate) {
            $('#spnapplicationDate').text('Please Select Application Date').show();
            isValid = false;
        } else {
            $('#spnapplicationDate').hide();
        }

        if (!employee) {
            $('#spnemployeeLoan').text('Please Select Employee').show();
            isValid = false;
        } else {
            $('#spnemployeeLoan').hide();
        }

        if (!loanIdValue) {
            $('#spnloanName').text('Please Select Loan Name').show();
            isValid = false;
        } else {
            $('#spnloanName').hide();
        }

        if (!loanRequireDate) {
            $('#spnloanRequireDate').text('Please Select Loan Require Date').show();
            isValid = false;
        } else {
            var today = new Date().toISOString().split('T')[0];
            if (loanRequireDate < today) {
                $('#spnloanRequireDate').text('Date cannot be in the past').show();
                isValid = false;
            } else {
                $('#spnloanRequireDate').hide();
            }
        }

        if (!loanAmount || parseFloat(loanAmount) <= 0) {
            $('#spnloanAmount').text('Please Enter Valid Loan Amount').show();
            isValid = false;
        } else {
            var loanMaxLimit = parseFloat($('#loanMaxLimit').val()) || 0;
            if (loanMaxLimit > 0 && parseFloat(loanAmount) > loanMaxLimit) {
                $('#spnloanAmount').text('Amount exceeds maximum limit of ₹' + loanMaxLimit.toFixed(2)).show();
                isValid = false;
            } else {
                $('#spnloanAmount').hide();
            }
        }

        if (!noOfInstallment || parseInt(noOfInstallment) <= 0) {
            $('#spnnoOfInstallment').text('Please Enter Number of Installments').show();
            isValid = false;
        } else if (parseInt(noOfInstallment) > 10) {
            $('#spnnoOfInstallment').text('Maximum 10 installments allowed').show();
            isValid = false;
        } else {
            $('#spnnoOfInstallment').hide();
        }

        if (!installmentAmount || parseFloat(installmentAmount) <= 0) {
            $('#spninstallmentAmount').text('Installment Amount Required').show();
            isValid = false;
        } else {
            $('#spninstallmentAmount').hide();
        }

        if (!installmentStartDate) {
            $('#spninstallmentStartDate').text('Please Select Installment Start Date').show();
            isValid = false;
        } else {
            var today2 = new Date().toISOString().split('T')[0];
            if (installmentStartDate < today2) {
                $('#spninstallmentStartDate').text('Date cannot be in the past').show();
                isValid = false;
            } else if (loanRequireDate && installmentStartDate < loanRequireDate) {
                $('#spninstallmentStartDate').text('Must be after loan require date').show();
                isValid = false;
            } else {
                $('#spninstallmentStartDate').hide();
            }
        }

        if (!isValid) {
            var firstError = $('span[id^="spn"]:visible').first();
            if (firstError.length) {
                $('html, body').animate({ scrollTop: firstError.offset().top - 100 }, 300);
            }
            return;
        }

        var loanApplicationData = {
            LoanApplicationID: loanApplicationId,
            ApplicationDate: applicationDate,
            EmployeeId: parseInt(employee),
            ContactNo: $('#contactNo').val() || '',
            EmailId: $('#emailId').val() || '',
            LoanId: parseInt(loanIdValue),
            LoanRequireDate: loanRequireDate,
            LoanMaxLimit: parseFloat($('#loanMaxLimit').val()) || 0,
            LoanAmount: parseFloat(loanAmount),
            InterestType: $('#interestType').val() || '',
            InterestPercentage: 0,
            NoOfInstallment: parseInt(noOfInstallment),
            InstallmentAmount: parseFloat(installmentAmount),
            InstallmentStartDate: installmentStartDate,
            Remark: $('#remark').val().trim() || '',
            IsEnabled: true,
            IsDeleted: false,
            CreatedBy: parseInt(EmployeeId),
            UpdatedBy: isUpdate ? parseInt(EmployeeId) : null,
            CreatedDate: new Date().toISOString(),
            UpdatedDate: isUpdate ? new Date().toISOString() : null,
            DeletedDate: null,
            DeletedBy: null
        };

        var apiUrl = isUpdate
            ? "@baseUrl/LoanApplicationAPI/UpdateLoanApplication"
            : "@baseUrl/LoanApplicationAPI/CreateLoanApplication";

        var httpMethod = isUpdate ? "PUT" : "POST";

        isSavingLoan = true;
        setBtnLoading('#btnSaveLoanApplication', isUpdate ? 'Updating...' : 'Saving...');

        $.ajax({
            url: apiUrl,
            type: httpMethod,
            contentType: 'application/json',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            data: JSON.stringify(loanApplicationData),
            success: function (response) {
                isSavingLoan = false;
                setBtnNormal('#btnSaveLoanApplication', isUpdate ? 'Update' : 'Save');
                if (response.isSuccess) {
                    showToast(response.responseMessage, 'success');
                    $("#addLoanApplicationModal").modal('hide');
                    resetLoanApplicationForm();
                    loadLoanApplications();
                } else {
                    showToast(response.responseMessage, 'error');
                }
            },
            error: function (xhr) {
                isSavingLoan = false;
                setBtnNormal('#btnSaveLoanApplication', isUpdate ? 'Update' : 'Save');
                var errorMessage = 'Unable to save loan application';

                if (xhr.responseJSON) {
                    if (xhr.responseJSON.responseMessage) {
                        errorMessage = xhr.responseJSON.responseMessage;
                    } else if (xhr.responseJSON.errors) {
                        var errors = xhr.responseJSON.errors;
                        var errorList = [];
                        for (var key in errors) {
                            if (errors.hasOwnProperty(key)) {
                                errorList.push(errors[key].join(', '));
                            }
                        }
                        errorMessage = errorList.join('; ');
                    } else if (xhr.responseJSON.title) {
                        errorMessage = xhr.responseJSON.title;
                    }
                } else if (xhr.responseText) {
                    try {
                        var errorResponse = JSON.parse(xhr.responseText);
                        errorMessage = errorResponse.responseMessage || errorResponse.message || errorMessage;
                    } catch (e) {
                        errorMessage = xhr.responseText.substring(0, 200);
                    }
                }

                showToast(errorMessage, 'error');
            }
        });
    });

    // Clear error messages on input change
    $('#loanApplicationForm input, #loanApplicationForm textarea, #loanApplicationForm select').on('input change', function () {
        var fieldId = $(this).attr('id');
        if (fieldId) {
            $('#spn' + fieldId).hide();
        }
    });

    async function resetLoanApplicationForm() {
        $('#loanApplicationId').val('0');

        var today = new Date().toISOString().split('T')[0];
        $('#applicationDate').val(today);

        $('#employeeLoan').val('');
        $('#loanName').val('');

        $('#contactNo').val('');
        $('#emailId').val('');
        $('#loanMaxLimit').val('');
        $('#loanRequireDate').val('');
        $('#loanAmount').val('');
        $('#interestType').val('');
        $('#interestRate').val('0');
        $('#noOfInstallment').val('');
        $('#installmentAmount').val('');
        $('#installmentStartDate').val('');
        $('#remark').val('');

        isSavingLoan = false;
        setBtnNormal('#btnSaveLoanApplication', 'Save');

        $('span[id^="spn"]').hide();
    }

    async function UpdateLoanApplicationData(data) {
        if (!data) return;

        await resetLoanApplicationForm();

        $('#modalTitle').text('Update Loan Application');
        setBtnNormal('#btnSaveLoanApplication', 'Update');

        var loanAppId = data.loanApplicationId || data.LoanApplicationId || data.loanApplicationID || data.LoanApplicationID || 0;
        $('#loanApplicationId').val(loanAppId);

        var appDateStr = data.applicationdate || data.applicationDate || data.ApplicationDate;
        if (appDateStr) {
            $('#applicationDate').val(formatDateForInput(appDateStr));
        }

        var contactNo = data.contactNo || data.ContactNo || '';
        var emailId = data.emailId || data.EmailId || '';
        var loanMaxLimit = data.loanMaxLimit || data.LoanMaxLimit || '';

        $('#contactNo').val(contactNo);
        $('#emailId').val(emailId);
        $('#loanMaxLimit').val(loanMaxLimit);

        var interestType = data.interestType || data.InterestType || '';
        var interestRate = data.interestRate || data.InterestRate || data.interestPercentage || data.InterestPercentage || '0';
        $('#interestType').val(interestType);
        $('#interestRate').val(interestRate);

        var loanReqDateStr = data.loanRequireDate || data.LoanRequireDate;
        if (loanReqDateStr) {
            $('#loanRequireDate').val(formatDateForInput(loanReqDateStr));
        }

        var loanAmt = data.loanAmount || data.LoanAmount || '';
        var numInstallments = data.noOfinstallment || data.noOfInstallment || data.NoOfInstallment || '';
        var instAmt = data.installmentAmount || data.InstallmentAmount || '';

        $('#loanAmount').val(loanAmt);
        $('#noOfInstallment').val(numInstallments);
        $('#installmentAmount').val(instAmt);

        var instStartDateStr = data.installmentStartDate || data.InstallmentStartDate || data.installmentstartDate;
        if (instStartDateStr) {
            $('#installmentStartDate').val(formatDateForInput(instStartDateStr));
        }

        var remarkText = data.remark || data.Remark || '';
        $('#remark').val(remarkText);

        var employeeId = data.employeeId || data.id || data.Id;
        if (employeeId) {
            setTimeout(() => { $('#employeeLoan').val(employeeId); }, 300);
        } else {
            console.error('NO EMPLOYEE ID FOUND IN DATA!');
        }

        var loanId = data.loanId || data.loanID;
        if (loanId) {
            setTimeout(() => { $('#loanName').val(loanId); }, 400);
        } else {
            console.error('NO LOAN ID FOUND IN DATA!');
        }

        $("#addLoanApplicationModal").modal('show');
    }

    function formatDateForInput(dateStr) {
        if (!dateStr) return '';

        try {
            if (dateStr.includes('T')) {
                return dateStr.split('T')[0];
            } else if (dateStr.includes(' ')) {
                return dateStr.split(' ')[0];
            } else if (dateStr.includes('-')) {
                var parts = dateStr.split('-');
                if (parts[0].length === 4) {
                    return dateStr;
                } else if (parts[2].length === 4) {
                    return parts[2] + '-' + parts[1] + '-' + parts[0];
                }
            }
            return dateStr;
        } catch (e) {
            console.error('Error formatting date:', e);
            return '';
        }
    }

    function DeleteLoanApplication(data) {
        if (!data) return;

        var loanAppId = data.loanApplicationId || data.LoanApplicationId || data.loanApplicationID || data.LoanApplicationID;

        wmsConfirm('Are you sure you want to delete this loan application record?', function () {
            var deleteObj = {
                Id: [loanAppId],
                DeletedBy: EmployeeId.toString()
            };

            $.ajax({
                url: '@baseUrl/LoanApplicationAPI/Delete',
                type: "DELETE",
                data: JSON.stringify(deleteObj),
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        loadLoanApplications();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    showToast('An error occurred while deleting the record. Please try again', 'error');
                }
            });
        }, { title: 'Delete Loan Application', confirmText: 'Delete' });
    }

</script>
