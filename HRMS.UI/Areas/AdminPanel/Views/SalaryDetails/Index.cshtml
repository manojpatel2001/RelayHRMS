@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Salary Details";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Salary Master</h6>
        <a href="/AdminPanel/SalaryDetails/MonthlySalary" id="btnAddSalaryMaster" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bx bx-plus"></i> Add
        </a>
    </div>

    <div class="card-body">
        <div class="sec-lbl">Search Panel</div>
        <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
            <div class="fg fg-req" style="min-width:150px;max-width:170px;flex-shrink:0;">
                <label for="ddlMonth">Month</label>
                <select id="ddlMonth">
                    <option value="" selected disabled>Select Month</option>
                </select>
                <span class="field-validation-error" id="errorMonth" style="display:none;">Please select month</span>
            </div>
            <div class="fg fg-req" style="min-width:120px;max-width:140px;flex-shrink:0;">
                <label for="ddlYear">Year</label>
                <select id="ddlYear">
                    <option value="" selected disabled>Select Year</option>
                </select>
                <span class="field-validation-error" id="errorYear" style="display:none;">Please select year</span>
            </div>
            <div class="fg" style="min-width:170px;max-width:190px;flex-shrink:0;">
                <label for="ddlBranch">Branch</label>
                <select id="ddlBranch">
                    <option value="">All</option>
                </select>
            </div>
            <div class="fg" style="min-width:150px;max-width:170px;flex-shrink:0;">
                <label for="empCode">Employee Code</label>
                <input type="text" id="empCode" placeholder="Enter code">
            </div>
            <div class="d-flex gap-2" style="flex-shrink:0;">
                <button type="button" id="btnGo" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-search"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Go</span>
                </button>
                <button type="button" id="btnClear" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-x"></i> Clear
                </button>
                <button type="button" onclick="goBack()" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-arrow-back"></i> Back
                </button>
            </div>
        </div>

        <div id="recordDetails" style="display:none;">
            <div class="d-flex justify-content-end mb-2">
                <button type="button" id="btnDelete" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-trash"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Delete Selected</span>
                </button>
            </div>
            <div id="salaryGridContainer"></div>
        </div>
    </div>
</div>


<!-- Salary Slip Modal -->
<div class="modal fade" id="salarySlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title">Salary Slip - <span id="modalMonthYear"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="salarySlipContent"></div>
            <div class="modal-footer">
                <button type="button" id="btnDownloadSlip" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-download"></i> Download PDF
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

</div>

<script>
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany);
    const CompanyId  = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token      = localStorage.getItem("authToken");

    let salaryGrid = null;
    let salaryRows = [];
    let selectedSalaryIds = {};
    let lastSearch = { month: null, year: null, empCode: '', branch: 0 };

    // ─── Helpers ──────────────────────────────────────────────────────────────────
    const INR  = n => Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const FIX2 = n => Number(n || 0).toFixed(2);
    const RV   = v => Math.round(parseFloat(v) || 0);

    function fmtDate(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        return String(d.getDate()).padStart(2, '0') + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + d.getFullYear();
    }

    function fillSelect(id, data, valueKey, textKey, placeholder) {
        var $sel = $('#' + id);
        $sel.empty();
        if (placeholder !== undefined) $sel.append($('<option>', { value: '', text: placeholder }));
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item[valueKey], text: item[textKey] }));
        });
    }

    /**
     * buildEarningsArray(data)
     * Dynamic: iterates all known earning fields, picks only those > 0.
     * Rate comes from SP's *Rate fields (EmployeeSalaryAllowance).
     */
    function buildEarningsArray(data) {
        const dep = parseFloat(data.deputationAllowance) || 0;
        const rows = [
            { name: "Basic Salary",                    amount: data.basicSalary,            rate: data.basicSalaryRate            },
            { name: "House Rent Allowance (HRA)",      amount: data.hra,                    rate: data.hraRate                    },
            { name: "Conveyance Allowances",           amount: data.conveyanceAllowance,    rate: data.conveyanceAllowanceRate    },
            { name: "Medical Allowances",              amount: data.medicalAllowance,       rate: data.medicalAllowanceRate       },
            { name: "Child Education Allowance (CEA)", amount: data.childEducationAllowance,rate: data.childEducationAllowanceRate},
            { name: "Arrears",                         amount: data.arrears,                rate: null                            }
        ]
        .filter(e => parseFloat(e.amount) > 0)
        .map(e => ({ name: e.name, amount: parseFloat(e.amount), rate: parseFloat(e.rate) || 0 }));

        if (dep > 0)
            rows.push({ name: "Deputation Allowance", amount: dep, rate: parseFloat(data.deputationAllowanceRate) || 0 });

        return rows;
    }

    /**
     * buildDeductionsArray(data)
     * Dynamic: only non-zero deductions included.
     * If deputationAllowance is negative → treat as recovery deduction.
     */
    function buildDeductionsArray(data) {
        const dep = parseFloat(data.deputationAllowance) || 0;
        const rows = [
            { name: "PF",               amount: data.pf               },
            { name: "ESIC",             amount: data.esic             },
            { name: "Professional Tax", amount: data.professionalTax  },
            { name: "Group Medical",    amount: data.groupMedical     },
            { name: "Term Insurance",   amount: data.termInsurance    },
            { name: "LWF",             amount: data.lwf              },
            { name: "TDS",             amount: data.tds              },
            { name: "Loan",            amount: data.loan             },
            { name: "OtherDeduction",  amount: data.otherDeduction   }
        ]
        .filter(d => parseFloat(d.amount) > 0)
        .map(d => ({ name: d.name, amount: parseFloat(d.amount) }));

        if (dep < 0)
            rows.push({ name: "Deputation Allowance (Recovery)", amount: Math.abs(dep) });

        return rows;
    }

    // ─── Page Load ────────────────────────────────────────────────────────────────
    $(document).ready(async function () {
        localStorage.removeItem("SalaryMonth");
        localStorage.removeItem("SalaryYear");
        localStorage.removeItem("SalaryEmpCodes");
        localStorage.removeItem("SalaryBranchId");

        const months = [
            { monthNumber:1,  monthName:'January'   }, { monthNumber:2,  monthName:'February'  },
            { monthNumber:3,  monthName:'March'     }, { monthNumber:4,  monthName:'April'     },
            { monthNumber:5,  monthName:'May'       }, { monthNumber:6,  monthName:'June'      },
            { monthNumber:7,  monthName:'July'      }, { monthNumber:8,  monthName:'August'    },
            { monthNumber:9,  monthName:'September' }, { monthNumber:10, monthName:'October'   },
            { monthNumber:11, monthName:'November'  }, { monthNumber:12, monthName:'December'  }
        ];
        const cy = new Date().getFullYear();
        const years = [];
        for (let i = cy - 1; i <= cy; i++) years.push({ yearName: i.toString() });

        $('#ddlMonth').append(months.map(m => `<option value="${m.monthNumber}">${m.monthName}</option>`).join(''));
        $('#ddlYear').append(years.map(y => `<option value="${y.yearName}">${y.yearName}</option>`).join(''));

        BindBranchDropdown();
        PermGuard.applyActions('salarydetails', { create: '#btnAddSalaryMaster', delete: '#btnDelete' });
    });

    // ─── Branch ───────────────────────────────────────────────────────────────────
    function BindBranchDropdown() {
        $.ajax({
            url: '@baseUrl/BranchAPI/GetAllBranchesListByCompanyId/' + CompanyId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res?.data?.length > 0) fillSelect('ddlBranch', res.data, 'branchId', 'branchName', 'All');
            }
        });
    }

    function goBack() { window.location.href = '@UIBaseUrl/AdminPanel/Home/index'; }

    // ─── Go ───────────────────────────────────────────────────────────────────────
    $('#btnGo').on('click', function () {
        $('#recordDetails').hide();
        const month   = $('#ddlMonth').val();
        const year    = $('#ddlYear').val();
        const empCode = $('#empCode').val();
        const branch  = $('#ddlBranch').val() || 0;

        let ok = true;
        if (!month) { $('#errorMonth').show(); ok = false; } else { $('#errorMonth').hide(); }
        if (!year)  { $('#errorYear').show();  ok = false; } else { $('#errorYear').hide();  }
        if (!ok) return;

        setBtnLoading('#btnGo', 'Searching...');
        fetchAndBindSalaryData(month, year, empCode, branch);
    });

    // ─── Fetch & Bind Grid ────────────────────────────────────────────────────────
    function fetchAndBindSalaryData(month, year, empCode, branch) {
        lastSearch = { month: month, year: year, empCode: empCode, branch: branch };
        $.ajax({
            url: '@(baseDomainUrl + "/api/MonthlySalaryDetailsAPI/GetAll")',
            type: "POST",
            data: JSON.stringify({ Month: parseInt(month), Year: parseInt(year), EmployeeCodes: empCode || '', BranchId: parseInt(branch) || 0 }),
            contentType: "application/json",
            success: function (response) {
                setBtnNormal('#btnGo', 'Go');
                if (response.isSuccess) {
                    salaryRows = response.data || [];
                    selectedSalaryIds = {};
                    renderSalaryGrid(salaryRows);
                    $('#recordDetails').show();
                } else {
                    $('#recordDetails').hide();
                    showToast(response.responseMessage, 'error');
                }
            },
            error: function () {
                setBtnNormal('#btnGo', 'Go');
                $('#recordDetails').hide();
                showToast("An error occurred while fetching salary records", 'error');
            }
        });
    }

    // ─── Grid ─────────────────────────────────────────────────────────────────────
    function toggleSalaryRow(code, checked) {
        selectedSalaryIds[code] = checked;
    }

    function getSelectedSalaryRows() {
        return salaryRows.filter(function (r) { return selectedSalaryIds[r.employeeCode]; });
    }

    function renderSalaryGrid(rows) {
        if (!salaryGrid) {
            salaryGrid = WMSGrid.create({
                container: 'salaryGridContainer',
                title: 'Salary Records',
                icon: 'bx-wallet',
                perPage: 10,
                data: rows,
                columns: [
                    {
                        header: '', sortable: false, width: '40px',
                        render: function (v, row) {
                            var checked = !!selectedSalaryIds[row.employeeCode];
                            return '<input type="checkbox" ' + (checked ? 'checked' : '') + ' onclick="toggleSalaryRow(\'' + row.employeeCode + '\', this.checked)">';
                        }
                    },
                    { field: 'employeeCode', header: 'Emp Code', width: '110px' },
                    { field: 'employeeName', header: 'Name', width: '180px' },
                    { field: 'branchName', header: 'Branch', width: '150px' },
                    { field: 'grossSalary', header: 'Gross Salary', width: '130px', align: 'right', render: function (v) { return INR(v); } },
                    { field: 'netSalary', header: 'Net Salary', width: '130px', align: 'right', render: function (v) { return INR(v); } },
                    { field: 'presentDays', header: 'Present', width: '90px', align: 'center' },
                    { field: 'absentDays', header: 'Absent', width: '90px', align: 'center' },
                    { field: 'salaryDays', header: 'Sal Days', width: '90px', align: 'center' },
                    { field: 'totalDeductions', header: 'Deductions', width: '120px', align: 'right', render: function (v) { return INR(v); } },
                    { field: 'arrears', header: 'Arrears', width: '110px', align: 'right', render: function (v) { return INR(v); } },
                    { field: 'otherDeduction', header: 'Other Ded.', width: '110px', align: 'right', render: function (v) { return INR(v); } },
                    { field: 'createdDate', header: 'Created', width: '120px', align: 'center', render: function (v) { return fmtDate(v); } },
                    {
                        header: 'Actions', sortable: false, stickyRight: true, width: '100px', align: 'center',
                        render: function (v, row) {
                            return '<button type="button" class="wg-btn wg-btn-outline" title="View Salary Slip" onclick="showSalarySlipModal(salaryRows.find(function(r){return r.employeeCode===\'' + row.employeeCode + '\';}))"><i class="bx bx-show"></i></button> ' +
                                   '<button type="button" class="wg-btn wg-btn-outline" title="Download PDF" onclick="downloadSalarySlipPDF(salaryRows.find(function(r){return r.employeeCode===\'' + row.employeeCode + '\';}))"><i class="bx bx-download"></i></button>';
                        }
                    }
                ],
                extraButtons: [{
                    label: 'Select All',
                    onClick: function (e, data) {
                        var allSelected = data.every(function (r) { return selectedSalaryIds[r.employeeCode]; });
                        data.forEach(function (r) { selectedSalaryIds[r.employeeCode] = !allSelected; });
                        salaryGrid.refresh();
                    }
                }]
            });
        } else {
            salaryGrid.setData(rows);
            salaryGrid.hideLoader();
        }
    }

    // ─── Delete ───────────────────────────────────────────────────────────────────
    $('#btnDelete').on('click', function () {
        const sel = getSelectedSalaryRows();
        if (!sel.length) { showToast('Please select at least one row.', 'warn'); return; }

        wmsConfirm('Delete selected salary record(s)?', function () {
            setBtnLoading('#btnDelete', 'Deleting...');
            $.ajax({
                url: '@baseUrl/MonthlySalaryDetailsAPI/DeleteSalaryDetails',
                type: 'DELETE', contentType: 'application/json',
                data: JSON.stringify({ id: sel.map(r => r.id), deletedBy: EmployeeId }),
                success: function (res) {
                    setBtnNormal('#btnDelete', 'Delete Selected');
                    if (res.isSuccess) {
                        showToast(res.responseMessage || "Deleted successfully.", 'success');
                        selectedSalaryIds = {};
                        fetchAndBindSalaryData(lastSearch.month, lastSearch.year, lastSearch.empCode, lastSearch.branch);
                    } else { showToast(res.responseMessage, 'error'); }
                },
                error: function () { setBtnNormal('#btnDelete', 'Delete Selected'); showToast("Something went wrong!", 'error'); }
            });
        }, { title: 'Delete Salary Record', confirmText: 'Delete' });
    });

    // ─── Modal (compact HTML preview) ────────────────────────────────────────────
    function buildModalHTML(data) {
        const earnings   = buildEarningsArray(data);
        const deductions = buildDeductionsArray(data);
        const totalE = earnings.reduce((s, e) => s + e.amount, 0);
        const totalD = deductions.reduce((s, d) => s + d.amount, 0);

        return `
        <style>
            .ct { margin-bottom:5px!important; font-size:12px!important; }
            .ct thead th { background:#f5f5f5!important; padding:4px 6px!important; }
            .ct tbody td { padding:3px 6px!important; }
        </style>
        <div class="row mb-1" style="font-size:12px;">
            <div class="col-md-6 p-1"><strong>Employee:</strong> ${data.employeeCode} - ${data.employeeName}</div>
            <div class="col-md-6 p-1"><strong>Present:</strong> ${data.presentDays} | <strong>Week off:</strong> ${data.weekOff}</div>
        </div>
        <div class="row mb-2" style="font-size:12px;">
            <div class="col-md-6 p-1"><strong>Month Days:</strong> ${data.monthDays} | <strong>Holiday:</strong> ${data.holiday}</div>
            <div class="col-md-6 p-1"><strong>Absent:</strong> ${data.absentDays} | <strong>Salary Days:</strong> ${data.salaryDays}</div>
            <div class="col-md-6 p-1"><strong>Paid Leave Days:</strong> ${data.leave}</div>
        </div>
        <div class="row">
            <div class="col-md-6 px-1">
                <table class="table table-bordered ct">
                    <thead>
                        <tr><th colspan="2" class="text-center">Earnings</th></tr>
                        <tr><th style="width:70%">Component</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        ${earnings.map(e => `<tr><td>${e.name}</td><td class="text-end">&#8377;${FIX2(e.amount)}</td></tr>`).join('')}
                        <tr class="fw-bold"><td>Total Earnings</td><td class="text-end">&#8377;${FIX2(totalE)}</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-6 px-1">
                <table class="table table-bordered ct">
                    <thead>
                        <tr><th colspan="2" class="text-center">Deductions</th></tr>
                        <tr><th style="width:70%">Component</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        ${deductions.map(d => `<tr><td>${d.name}</td><td class="text-end">&#8377;${FIX2(d.amount)}</td></tr>`).join('')}
                        <tr class="fw-bold"><td>Total Deductions</td><td class="text-end">&#8377;${FIX2(totalD)}</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-end mt-1">
            <h6 class="text-success mb-0" style="font-size:13px;">Net Salary: &#8377;${FIX2(data.netSalary)}</h6>
        </div>`;
    }

    function showSalarySlipModal(data) {
        if (!data) return;
        $('#modalMonthYear').text(`${data.monthName} ${data.year}`);
        $('#salarySlipContent').html(buildModalHTML(data));
        $('#salarySlipModal .modal-dialog').removeClass('modal-xl').addClass('modal-lg');
        $('#btnDownloadSlip').off('click').on('click', () => downloadSalarySlipPDF(data));
        new bootstrap.Modal(document.getElementById('salarySlipModal')).show();
    }


    // ─── Professional Landscape PDF ───────────────────────────────────────────────
    async function downloadSalarySlipPDF(data) {
        if (!data) return;
        const { jsPDF } = window.jspdf;

        const earnings   = buildEarningsArray(data);
        const deductions = buildDeductionsArray(data);
        const totalEarnings   = earnings.reduce((s, e) => s + e.amount, 0);
        const totalDeductions = deductions.reduce((s, d) => s + d.amount, 0);
        const netPay          = parseFloat(data.netSalary) || 0;

        const doc   = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4" });
        const pageW = 297, margin = 15, contentW = pageW - margin * 2;
        let y = 15;

        // ── Logo + Header ──────────────────────────────────────────────────────────
        try {
            const imgData = await loadLogoAsBase64('/assets/images/relaylogo.jpeg');
            doc.addImage(imgData, 'JPEG', margin, y, 60, 12);
        } catch (_) { /* logo optional */ }

        doc.setFont("helvetica", "bold").setFontSize(12);
        doc.text("RELAY EXPRESS PVT LTD", pageW / 2, y + 8, { align: "center" });
        doc.setFont("helvetica", "normal").setFontSize(9);
        doc.text("406, KATARIA ARCADE, MAKARBA,, AHMEDABAD, GUJARAT 380051", pageW / 2, y + 15, { align: "center" });
        y += 25;

        doc.setFont("helvetica", "bold").setFontSize(11);
        doc.text(`Pay slip for the month of ${data.monthName} - ${data.year}`, pageW / 2, y, { align: "center" });
        y += 8;

        // ── Employee Details Grid (3 col × 5 row) ─────────────────────────────────
        const gridRowH = 8, gridRows = 5, colW = contentW / 3, gridTop = y;
        doc.setDrawColor(0).setLineWidth(0.35);
        doc.rect(margin, gridTop, contentW, gridRowH * gridRows);
        for (let c = 1; c < 3; c++)
            doc.line(margin + c * colW, gridTop, margin + c * colW, gridTop + gridRowH * gridRows);
        for (let r = 1; r < gridRows; r++)
            doc.line(margin, gridTop + r * gridRowH, margin + contentW, gridTop + r * gridRowH);

        function pair(col, row, label, value) {
            const cx = margin + col * colW + 3;
            const cy = gridTop + row * gridRowH + 5;
            doc.setFontSize(9).setFont("helvetica", "bold");
            doc.text(label, cx, cy);
            const lw = doc.getTextWidth(label);
            doc.setFont("helvetica", "normal");
            doc.text(" : " + String(value ?? ""), cx + lw, cy, { maxWidth: colW - lw - 8 });
        }

        const fmtDate2 = d => d ? new Date(d).toLocaleDateString('en-IN') : '';

        pair(0, 0, "Employee Code",   data.employeeCode    || '');
        pair(1, 0, "Employee Name",   data.employeeName    || '');
        pair(2, 0, "Branch",          data.branchName      || '');
        pair(0, 1, "Department",      data.departmentName  || '');
        pair(1, 1, "Designation",     data.designationName || '');
        pair(2, 1, "Grade",           data.gradeName       || '');
        pair(0, 2, "Date of Birth",   fmtDate2(data.dateOfBirth));
        pair(1, 2, "Date of Joining", fmtDate2(data.dateOfJoining));
        pair(2, 2, "PF No",           data.pFNo            || '');
        pair(0, 3, "Bank A/c No",     data.primaryAccountNumber || '');
        pair(1, 3, "Bank Name",       data.primaryBankName || '');
        pair(2, 3, "PAN No",          data.pANNo           || '');
        pair(0, 4, "UAN No",          data.uANNumber       || '');
        pair(1, 4, "ESIC No",         data.eSICNo          || '');

        // ── Attendance Row ────────────────────────────────────────────────────────
        const attY = gridTop + gridRowH * gridRows;
        doc.rect(margin, attY, contentW, gridRowH);
        doc.setFont("helvetica", "normal").setFontSize(9);
        let ax = margin + 3, ay = attY + 5;
        function att(label, val) {
            doc.setFont("helvetica", "bold"); doc.text(label, ax, ay);
            const lw = doc.getTextWidth(label);
            doc.setFont("helvetica", "normal"); doc.text(" : ", ax + lw, ay);
            const vx = ax + lw + 6; doc.text(String(val ?? ''), vx, ay);
            ax = vx + doc.getTextWidth(String(val ?? '')) + 8;
        }
        att("Present Day",   data.presentDays ?? 0);
        att("Paid Leave",    data.leave        ?? 0);
        att("Holiday",       data.holiday      ?? 0);
        att("Week off",      data.weekOff      ?? 0);
        att("Total Sal Day", data.salaryDays   ?? 0);
        att("Absent",        data.absentDays   ?? 0);
        y = attY + gridRowH + 5;

        // ── Earnings / Deductions 5-Column Table ──────────────────────────────────
        const tX    = margin, tRowH = 8;
        const L_PART = 85, L_RATE = 38, L_EARN = 45, R_PART = 65;
        const R_DED  = contentW - (L_PART + L_RATE + L_EARN + R_PART);
        const tTop   = y;

        // pScale: dynamic row count based on actual data (not hardcoded)
        const rowsData = Math.max(earnings.length, deductions.length);
        // +1 for totals row, +1 for header row = tRows+1 total rows including header
        const tRows    = rowsData + 1;

        doc.setDrawColor(0).setLineWidth(0.35);
        // Header row background
        doc.setFillColor(230, 230, 230);
        doc.rect(tX, tTop, contentW, tRowH, "F");
        // Full table border (header + data rows + totals row)
        doc.rect(tX, tTop, contentW, tRowH * (tRows + 1));

        // Vertical column dividers
        let cx2 = tX;
        [L_PART, L_RATE, L_EARN, R_PART].forEach(w => {
            cx2 += w;
            doc.line(cx2, tTop, cx2, tTop + tRowH * (tRows + 1));
        });
        // Horizontal row dividers
        for (let r = 1; r <= tRows + 1; r++)
            doc.line(tX, tTop + r * tRowH, tX + contentW, tTop + r * tRowH);

        // Header labels
        doc.setFont("helvetica", "bold").setFontSize(9);
        const hy = tTop + 5;
        let hx = tX;
        doc.text("Particulars", hx + 3,           hy);                             hx += L_PART;
        doc.text("Rate",        hx + L_RATE / 2,  hy, { align: "center" });        hx += L_RATE;
        doc.text("Earnings",    hx + L_EARN / 2,  hy, { align: "center" });        hx += L_EARN;
        doc.text("Particulars", hx + 3,           hy);                             hx += R_PART;
        doc.text("Deduction",   hx + R_DED / 2,   hy, { align: "center" });

        // Data rows — fully dynamic, no hardcoded list
        doc.setFont("helvetica", "normal").setFontSize(8);
        for (let i = 0; i < rowsData; i++) {
            const yb = tTop + tRowH * (i + 1) + 5;

            if (earnings[i]) {
                const e = earnings[i];
                doc.text(e.name,      tX + 3,                              yb, { maxWidth: L_PART - 6 });
                doc.text(FIX2(e.rate),tX + L_PART + L_RATE - 3,           yb, { align: "right" });
                doc.text(INR(e.amount),tX + L_PART + L_RATE + L_EARN - 3, yb, { align: "right" });
            }

            if (deductions[i]) {
                const d  = deductions[i];
                const dx = tX + L_PART + L_RATE + L_EARN;
                doc.text(d.name,       dx + 3,                yb, { maxWidth: R_PART - 6 });
                doc.text(INR(d.amount),dx + R_PART + R_DED - 3, yb, { align: "right" });
            }
        }

        // Totals row
        const ty = tTop + tRowH * (rowsData + 1) + 5;
        doc.setFont("helvetica", "bold").setFontSize(9);
        doc.text("Total Earnings",    tX + 3,                               ty);
        doc.text(INR(totalEarnings),  tX + L_PART + L_RATE + L_EARN - 3,   ty, { align: "right" });
        doc.text("Total Deduction",   tX + L_PART + L_RATE + L_EARN + 3,   ty);
        doc.text(INR(totalDeductions),tX + contentW - 3,                    ty, { align: "right" });
        y = tTop + tRowH * (tRows + 1) + 5;

        // ── Net Pay Bar ───────────────────────────────────────────────────────────
        const barH = 12;
        doc.setFillColor(255, 255, 200);
        doc.rect(margin, y, contentW, barH, "F");
        doc.setDrawColor(0).setLineWidth(0.5);
        doc.rect(margin, y, contentW, barH);
        doc.setFont("helvetica", "bold").setFontSize(10);
        doc.text("Employee Net Pay",  margin + 5,  y + 8);
        doc.text(":",                 margin + 60, y + 8);
        doc.text(`${INR(netPay)} ( ${numberToWords(netPay)} Only )`, margin + 65, y + 8);
        y += barH + 8;

        // ── Footer ────────────────────────────────────────────────────────────────
        doc.setFont("helvetica", "italic").setFontSize(8);
        doc.text("This is a computer generated salary slip. Signature not required", pageW / 2, y, { align: "center" });

        doc.save(`Pay_Slip_${data.employeeCode}_${data.monthName}-${data.year}.pdf`);
    }


    // ─── Load Logo ────────────────────────────────────────────────────────────────
    async function loadLogoAsBase64(url) {
        const res  = await fetch(url);
        const blob = await res.blob();
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.onerror  = reject;
            reader.readAsDataURL(blob);
        });
    }

    // ─── Number to Words ──────────────────────────────────────────────────────────
    function numberToWords(amount) {
        const ones  = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine"];
        const teens = ["Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
        const tens  = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
        function three(n) {
            let o = "";
            if (n >= 100) { o += ones[Math.floor(n/100)] + " Hundred "; n %= 100; }
            if (n >= 20)  { o += tens[Math.floor(n/10)] + " "; n %= 10; }
            else if (n >= 10) { o += teens[n-10] + " "; n = 0; }
            if (n > 0) o += ones[n] + " ";
            return o.trim();
        }
        amount = Math.floor(Number(amount));
        if (!amount) return "Zero";
        const parts = [];
        const cr = Math.floor(amount/10000000); amount %= 10000000;
        const la = Math.floor(amount/100000);   amount %= 100000;
        const th = Math.floor(amount/1000);     amount %= 1000;
        if (cr) parts.push(three(cr) + " Crore");
        if (la) parts.push(three(la) + " Lakh");
        if (th) parts.push(three(th) + " Thousand");
        if (amount) parts.push(three(amount));
        return parts.join(" ").replace(/\s+/g, " ").trim();
    }

    // ─── Clear ────────────────────────────────────────────────────────────────────
    $('#btnClear').on('click', function () {
        $('#ddlMonth, #ddlYear').val('');
        $('#ddlBranch').val('');
        $('#empCode').val('');
        $('#errorMonth, #errorYear').hide();
        salaryRows = [];
        selectedSalaryIds = {};
        $('#recordDetails').hide();
    });
</script>
