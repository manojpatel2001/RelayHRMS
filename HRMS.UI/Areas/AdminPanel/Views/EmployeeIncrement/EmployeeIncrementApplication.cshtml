@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Increment Application";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Increment Application</h6>
            <a href="@Url.Action("AddEmployeeIncrement", "EmployeeIncrement")" id="btnAddEmployeeIncrementApplication" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add
            </a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="form-grid-3">
                <div class="fg">
                    <label for="searchText">Search (Code / Name)</label>
                    <input type="text" id="searchText" placeholder="Enter employee code or name" />
                </div>

                <div class="fg">
                    <label for="ddlReasonFilter">Reason</label>
                    <select id="ddlReasonFilter">
                        <option value="">All Reasons</option>
                    </select>
                </div>

                <div class="fg">
                    <label for="fromDate">From Date</label>
                    <input type="date" id="fromDate" />
                </div>

                <div class="fg">
                    <label for="toDate">To Date</label>
                    <input type="date" id="toDate" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-primary btn-sm" id="btnGo"><i class="bx bx-search"></i> GO</button>
                <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
            </div>

            <div class="divider"></div>

            <div id="gridContainerIncrement"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
        const CompanyId = companyDetails ? companyDetails.CompanyId : null;
        const Token = localStorage.getItem('authToken');
        const EmployeeId = localStorage.getItem('EmployeeId');
        let _allRows = [];

        function fmtDate(v) {
            if (!v) return '';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear();
        }

        function fmtMoney(v) {
            if (v === null || v === undefined || v === '') return '';
            return parseFloat(v).toFixed(2);
        }

        function fillSelect(id, data, valueKey, textKey, placeholder) {
            var el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = '';
            var ph = document.createElement('option');
            ph.value = '';
            ph.textContent = placeholder || 'Select';
            el.appendChild(ph);
            (data || []).forEach(function (d) {
                var o = document.createElement('option');
                o.value = d[valueKey];
                o.textContent = d[textKey] || '';
                el.appendChild(o);
            });
        }

        var grid = WMSGrid.create({
            container: 'gridContainerIncrement',
            title: 'Increment Records',
            icon: 'bx-trending-up',
            perPage: 10,
            columns: [
                { field: 'employeeCode', header: 'Employee Code', width: '130px' },
                { field: 'fullName', header: 'Employee Name', width: '180px' },
                { field: 'oldBasicSalary', header: 'Old Basic Salary', width: '130px', render: function (v) { return fmtMoney(v); } },
                { field: 'newBasicSalary', header: 'New Basic Salary', width: '130px', render: function (v) { return fmtMoney(v); } },
                { field: 'oldGrossSalary', header: 'Old Gross Salary', width: '130px', render: function (v) { return fmtMoney(v); } },
                { field: 'newGrossSalary', header: 'New Gross Salary', width: '130px', render: function (v) { return fmtMoney(v); } },
                { header: 'Effective Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.effectiveFromDate); } },
                { field: 'reason', header: 'Reason', width: '160px' },
                {
                    header: 'Actions', sortable: false, stickyRight: true, width: '70px',
                    render: function (v, row) {
                        if (!PermGuard.has('delete-employeeincrement-employeeincrementapplication')) return '';
                        return '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteIncrement(' + row.id + ')"><i class="bx bx-trash"></i></button>';
                    }
                }
            ],
            features: { export: true }
        });

        function loadReasons() {
            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/GetAllIncrementReason',
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        fillSelect('ddlReasonFilter', response.data, 'reasonId', 'reasonName', 'All Reasons');
                    }
                },
                error: function () { console.error('Failed to fetch increment reasons.'); }
            });
        }

        function loadDataTable() {
            grid.showLoader();
            $.ajax({
                type: 'GET',
                url: '@baseUrl/EmployeeIncrementAPI/GetAllIncrementEmployees/' + CompanyId,
                headers: { 'Authorization': 'Bearer ' + Token },
                _silentLoader: true,
                success: function (response) {
                    _allRows = response.isSuccess ? (response.data || []) : [];
                    applyFilters();
                    grid.hideLoader();
                },
                error: function () {
                    grid.hideLoader();
                    showToast('Unable to load increment data.', 'error');
                }
            });
        }

        function applyFilters() {
            var text = ($('#searchText').val() || '').trim().toLowerCase();
            var reasonId = $('#ddlReasonFilter').val();
            var reasonName = reasonId ? $('#ddlReasonFilter option:selected').text() : '';
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();

            var rows = _allRows.filter(function (r) {
                if (text) {
                    var hay = ((r.employeeCode || '') + ' ' + (r.fullName || '')).toLowerCase();
                    if (hay.indexOf(text) === -1) return false;
                }
                if (reasonId && r.reason !== reasonName) return false;
                if (fromDate && (!r.effectiveFromDate || r.effectiveFromDate.split('T')[0] < fromDate)) return false;
                if (toDate && (!r.effectiveFromDate || r.effectiveFromDate.split('T')[0] > toDate)) return false;
                return true;
            });

            grid.setData(rows);
        }

        $(document).ready(function () {
            loadReasons();
            PermGuard.onReady(function () { loadDataTable(); });
            PermGuard.applyActions('employeeincrement-employeeincrementapplication', { create: '#btnAddEmployeeIncrementApplication', export: '#gridContainerIncrement_exportBtn' });
        });

        $('#btnGo').click(function () { applyFilters(); });

        $('#btnClear').click(function () {
            $('#searchText').val('');
            $('#ddlReasonFilter').val('');
            $('#fromDate').val('');
            $('#toDate').val('');
            applyFilters();
        });

        window._deleteIncrement = function (id) {
            wmsConfirm('Are you sure you want to delete this increment record?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
                var deleteObj = { Id: id, DeletedBy: EmployeeId };
                $.ajax({
                    url: '@baseUrl/EmployeeIncrementAPI/DeleteIncrement',
                    type: 'DELETE',
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + Token },
                    data: JSON.stringify(deleteObj),
                    success: function (response) {
                        showToast(response.responseMessage, response.isSuccess ? 'success' : 'error');
                        if (response.isSuccess) loadDataTable();
                    },
                    error: function () { showToast('An error occurred while deleting the record. Please try again.', 'error'); }
                });
            });
        };
    })();
</script>
