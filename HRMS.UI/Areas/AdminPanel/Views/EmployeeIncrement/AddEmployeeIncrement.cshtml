@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Add Increment Application";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Add Employee Increment/Decrement Application</h6>
            <a href="@Url.Action("EmployeeIncrementApplication", "EmployeeIncrement")" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-arrow-back"></i> Back
            </a>
        </div>
        <div class="card-body">
            <form id="incrementForm">
                <div class="form-grid-3">
                    <div class="fg fg-req">
                        <label for="ddlEmployee">Employee</label>
                        <select id="ddlEmployee">
                            <option value="" selected disabled>Select Employee</option>
                        </select>
                        <span id="spnEmployee" class="field-validation-error" style="display:none;">Please Select Employee</span>
                    </div>

                    <div class="fg fg-req">
                        <label for="ddlReason">Reason</label>
                        <select id="ddlReason">
                            <option value="" selected disabled>Select Reason</option>
                        </select>
                        <span id="spnReason" class="field-validation-error" style="display:none;">Please Select Reason</span>
                    </div>

                    <div class="fg fg-req">
                        <label for="effectiveDate">Effective Date</label>
                        <input type="date" id="effectiveDate" />
                        <span id="spnEffectiveDate" class="field-validation-error" style="display:none;">Please Select Effective Date</span>
                    </div>
                </div>

                <div class="divider"></div>
                <div class="sec-lbl" style="margin-top:0">Salary Structure</div>

                <div class="form-grid-3">
                    <div class="fg">
                        <label for="oldBasicSalary">Old Basic Salary</label>
                        <input type="text" id="oldBasicSalary" readonly placeholder="0.00" />
                    </div>

                    <div class="fg fg-req">
                        <label for="newBasicSalary">New Basic Salary</label>
                        <input type="text" id="newBasicSalary" data-decimal placeholder="Enter New Basic Salary" />
                        <span id="spnNewBasicSalary" class="field-validation-error" style="display:none;">Please Enter New Basic Salary</span>
                    </div>

                    <div class="fg">
                        <label for="oldGrossSalary">Old Gross Salary</label>
                        <input type="text" id="oldGrossSalary" readonly placeholder="0.00" />
                    </div>

                    <div class="fg fg-req">
                        <label for="newGrossSalary">New Gross Salary</label>
                        <input type="text" id="newGrossSalary" data-decimal placeholder="Enter New Gross Salary" />
                        <span id="spnNewGrossSalary" class="field-validation-error" style="display:none;">Please Enter New Gross Salary</span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClearIncrement">Clear</button>
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnSaveIncrement">
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Save</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
    (function () {
        var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
        const CompanyId = companyDetails ? companyDetails.CompanyId : null;
        const Token = localStorage.getItem('authToken');
        const EmployeeId = localStorage.getItem('EmployeeId');

        function fillSelect(id, data, valueKey, textKey, placeholder) {
            var el = document.getElementById(id);
            if (!el) return;
            el.innerHTML = '';
            var ph = document.createElement('option');
            ph.value = '';
            ph.textContent = placeholder || 'Select';
            ph.disabled = true;
            ph.selected = true;
            el.appendChild(ph);
            (data || []).forEach(function (d) {
                var o = document.createElement('option');
                o.value = d[valueKey];
                o.textContent = d[textKey] || '';
                el.appendChild(o);
            });
        }

        function clearErrors() {
            $('#spnEmployee, #spnReason, #spnEffectiveDate, #spnNewBasicSalary, #spnNewGrossSalary').hide();
        }

        function loadEmployees() {
            $.ajax({
                url: '@baseUrl/EmployeeMasterAPI/GetAllEmployeeList/' + CompanyId,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        fillSelect('ddlEmployee', response.data, 'EmployeeId', 'EmployeeName', 'Select Employee');
                    }
                },
                error: function () { console.error('Failed to fetch employees.'); }
            });
        }

        function loadReasons() {
            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/GetAllIncrementReason',
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        fillSelect('ddlReason', response.data, 'reasonId', 'reasonName', 'Select Reason');
                    }
                },
                error: function () { console.error('Failed to fetch increment reasons.'); }
            });
        }

        function loadSalaryInfo() {
            var empId = $('#ddlEmployee').val();
            $('#oldBasicSalary').val('');
            $('#oldGrossSalary').val('');
            if (!empId) return;

            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/GetEmployeeSalaryInfo/' + empId,
                method: 'GET',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess && response.data) {
                        $('#oldBasicSalary').val(parseFloat(response.data.basicSalary || 0).toFixed(2));
                        $('#oldGrossSalary').val(parseFloat(response.data.grossSalary || 0).toFixed(2));
                    } else {
                        showToast(response.responseMessage || 'Unable to fetch salary details.', 'error');
                    }
                },
                error: function () { showToast('Unable to fetch salary details.', 'error'); }
            });
        }

        function resetForm() {
            clearErrors();
            $('#incrementForm')[0].reset();
            $('#ddlEmployee').val('');
            $('#ddlReason').val('');
            $('#oldBasicSalary, #oldGrossSalary, #newBasicSalary, #newGrossSalary').val('');
            setBtnNormal('#btnSaveIncrement', 'Save');
        }

        $(document).ready(function () {
            loadEmployees();
            loadReasons();
        });

        $('#ddlEmployee').on('change', function () { loadSalaryInfo(); });

        $('#btnClearIncrement').click(function () { resetForm(); });

        $('#btnSaveIncrement').click(function () {
            clearErrors();

            var empId = $('#ddlEmployee').val();
            var reasonId = $('#ddlReason').val();
            var effectiveDate = $('#effectiveDate').val();
            var oldBasicSalary = parseFloat($('#oldBasicSalary').val()) || 0;
            var oldGrossSalary = parseFloat($('#oldGrossSalary').val()) || 0;
            var newBasicSalary = parseFloat($('#newBasicSalary').val()) || 0;
            var newGrossSalary = parseFloat($('#newGrossSalary').val()) || 0;

            var isValid = true;

            if (!empId) {
                $('#spnEmployee').show();
                isValid = false;
            }
            if (!reasonId) {
                $('#spnReason').show();
                isValid = false;
            }
            if (!effectiveDate) {
                $('#spnEffectiveDate').show();
                isValid = false;
            }
            if (!$('#newBasicSalary').val()) {
                $('#spnNewBasicSalary').text('Please Enter New Basic Salary').show();
                isValid = false;
            } else if (newBasicSalary < oldBasicSalary) {
                $('#spnNewBasicSalary').text('New Basic Salary must be greater than or equal to Old Basic Salary').show();
                isValid = false;
            }
            if (!$('#newGrossSalary').val()) {
                $('#spnNewGrossSalary').text('Please Enter New Gross Salary').show();
                isValid = false;
            } else if (newGrossSalary < oldGrossSalary) {
                $('#spnNewGrossSalary').text('New Gross Salary must be greater than or equal to Old Gross Salary').show();
                isValid = false;
            } else if (newGrossSalary < newBasicSalary) {
                $('#spnNewGrossSalary').text('New Gross Salary cannot be less than New Basic Salary').show();
                isValid = false;
            }

            if (!isValid) return;

            setBtnLoading('#btnSaveIncrement', 'Saving...');

            var payload = {
                EmployeeId: empId,
                OldBasicSalary: oldBasicSalary,
                NewBasicSalary: newBasicSalary,
                OldGrossSalary: oldGrossSalary,
                NewGrossSalary: newGrossSalary,
                EffectiveFromDate: effectiveDate,
                ReasonId: reasonId,
                CreatedBy: EmployeeId
            };

            $.ajax({
                url: '@baseUrl/EmployeeIncrementAPI/InsertEmployeeSalaryHistory',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        resetForm();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                    setBtnNormal('#btnSaveIncrement', 'Save');
                },
                error: function () {
                    showToast('An error occurred while saving. Please try again.', 'error');
                    setBtnNormal('#btnSaveIncrement', 'Save');
                }
            });
        });
    })();
</script>
