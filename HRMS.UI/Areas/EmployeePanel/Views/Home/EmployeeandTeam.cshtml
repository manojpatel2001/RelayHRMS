@{
	ViewData["Title"] = "Employee & Team";
	Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
	string baseUrl = ViewBag.BaseUrl;
	string apiBase = ViewBag.BaseUrlAPI;
}
<style>
	/* Page-local overrides only — everything else (cards, buttons, form
	   fields, DevExtreme grid skin) comes from the shared theme CSS. */

	.et-avatar {
		width: 92px;
		height: 92px;
		object-fit: cover;
		border-radius: 50%;
		border: 3px solid var(--hp-surface-3);
		box-shadow: var(--hp-shadow-sm);
	}

	.et-profile-name { font-size: 16px; font-weight: 700; color: var(--hp-text); }
	.et-profile-role { font-size: 12.5px; color: var(--hp-text-muted); margin-top: 2px; }

	.et-last-login {
		font-size: 12px;
		color: var(--hp-text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		margin: 14px 0 0;
		padding-top: 14px;
		border-top: 1px solid var(--hp-border);
	}
	.et-last-login i { font-size: 14px; color: var(--hp-blue-mid); }

	.et-stat-row { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
	.et-stat-row .hrms-stat-card { padding: 10px 14px; }
	.et-stat-row .hrms-stat-num { font-size: 19px; }

	#aboutmeid .list-group-item {
		font-size: 13px;
		padding: 9px 2px;
		border: none;
		border-bottom: 1px solid var(--hp-border);
		color: var(--hp-text-md);
	}
	#aboutmeid .list-group-item:last-child { border-bottom: none; }
	#aboutmeid .list-group-item i { color: var(--hp-blue-mid); margin-right: 7px; font-size: 14px; width: 14px; text-align: center; }
	#aboutmeid .list-group-item > span:first-child { color: var(--hp-text); font-weight: 600; }
	#aboutmeid .list-group-item.et-warning > span:last-child { color: var(--hp-danger); font-weight: 700; }

	/* Theme-native underline tabs (replaces default Bootstrap gray tab chrome) */
	#attendanceTabs {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		border-bottom: 1px solid var(--hp-border);
		margin-bottom: 16px;
	}
	#attendanceTabs .nav-link {
		border: none;
		border-bottom: 2px solid transparent;
		border-radius: 0;
		color: var(--hp-text-muted);
		background: transparent;
		padding: 9px 12px;
		font-size: 13px;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 6px;
		transition: color .15s ease, border-color .15s ease;
	}
	#attendanceTabs .nav-link i { font-size: 15px; }
	#attendanceTabs .nav-link:hover { color: var(--hp-blue-mid); }
	#attendanceTabs .nav-link.active,
	#attendanceTabs .nav-link.active:hover {
		color: var(--hp-blue-mid);
		background: transparent;
		border-bottom-color: var(--hp-blue-mid);
	}

	.text-center-cell { text-align: center !important; }
	.text-center-cell > div { text-align: center !important; }
</style>

<div class="wms-form-page">

	<div class="card mb-3">
		<div class="card-header">
			<h6 class="mb-0"><i class="bx bx-group" style="color:var(--hp-blue-mid);margin-right:6px;"></i>Employee &amp; Team Dashboard</h6>
		</div>
	</div>

	<!-- Profile, About Me, and My Team panel -->
	<div class="row align-items-stretch">
		<!-- Left column: Profile + About Me -->
		<div class="col-md-4 col-lg-3 d-flex flex-column gap-3 mb-3">

			<div id="profileid" class="card">
				<div class="card-body text-center">
					<img id="profilePhoto" src="/images/default-avatar.png" class="et-avatar mb-2 mx-auto" alt="Profile Photo" />
					<div class="et-profile-name" id="profileName">&nbsp;</div>
					<div class="et-profile-role" id="profileRole"></div>

					<div class="et-stat-row">
						<div class="hrms-stat-card hrms-stat-blue">
							<div class="hrms-stat-icon"><i class="bx bx-user"></i></div>
							<div class="hrms-stat-info">
								<div class="hrms-stat-num is-loading" id="directTeamCount">--</div>
								<div class="hrms-stat-label">Direct Team Members</div>
							</div>
						</div>
						<div class="hrms-stat-card hrms-stat-green">
							<div class="hrms-stat-icon"><i class="bx bx-sitemap"></i></div>
							<div class="hrms-stat-info">
								<div class="hrms-stat-num is-loading" id="indirectTeamCount">--</div>
								<div class="hrms-stat-label">In-Direct Team Members</div>
							</div>
						</div>
					</div>

					<div class="et-last-login">
						<i class="bx bx-time-five"></i>
						<span>Last login: <strong id="lastLogin">-</strong></span>
					</div>
				</div>
			</div>

			<div id="aboutmeid" class="card flex-fill">
				<div class="card-body">
					<h6 class="text-center mb-3" style="font-weight:700;color:var(--hp-text);">
						<i class="bx bx-id-card" style="color:var(--hp-blue-mid);margin-right:6px;"></i>About Me
					</h6>
					<ul class="list-group list-group-flush small">
						<li class="list-group-item d-flex justify-content-between">
							<span><i class="bx bx-buildings"></i>Branch</span>
							<span id="branch">-</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span><i class="bx bx-briefcase-alt-2"></i>Designation</span>
							<span id="designation">-</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span><i class="bx bx-network-chart"></i>Department</span>
							<span id="department">-</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span><i class="bx bx-calendar-check"></i>Joining Date</span>
							<span id="joiningDate">-</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							<span><i class="bx bx-map"></i>Address</span>
							<span id="address">-</span>
						</li>
						<li class="list-group-item d-flex justify-content-between" id="warningRow">
							<span><i class="bx bx-error-circle"></i>Warning Card</span>
							<span id="warningCard">0</span>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Right column: My Team panel -->
		<div class="col-md-8 col-lg-9 mb-3">
			<div id="rightSideCard" class="card h-100">
				<div class="card-header d-flex justify-content-between align-items-center">
					<h6 class="mb-0"><i class="bx bx-group" style="color:var(--hp-blue-mid);margin-right:6px;"></i>My Team</h6>
					<div class="d-flex gap-2">
						<button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="myInOutBtn">
							<i class="bx bx-log-in-circle"></i><span>My In-Out</span>
						</button>
						<button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="myProfileBtn">
							<i class="bx bx-user-circle"></i><span>My Profile</span>
						</button>
					</div>
				</div>
				<div class="card-body">

					<ul class="nav nav-tabs" id="attendanceTabs" role="tablist">
						<li class="nav-item">
							<button class="nav-link active" id="team-tab" data-bs-toggle="tab" data-bs-target="#teamid" type="button" role="tab">
								<i class="bx bx-calendar-week"></i>My Team Leave
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="direct-tab" data-bs-toggle="tab" data-bs-target="#directid" type="button" role="tab">
								<i class="bx bx-user"></i>Direct Reportees
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="indirect-tab" data-bs-toggle="tab" data-bs-target="#indirectid" type="button" role="tab">
								<i class="bx bx-sitemap"></i>Indirect Reportees
							</button>
						</li>
						<li class="nav-item">
							<button class="nav-link" id="Member-tab" data-bs-toggle="tab" data-bs-target="#memberid" type="button" role="tab">
								<i class="bx bx-log-in-circle"></i>My Members In-Out
							</button>
						</li>
					</ul>

					<div class="tab-content" id="attendanceTabContent">

						<div class="tab-pane fade show active" id="teamid" role="tabpanel">
							<div id="teamleavecount" class="hp-record-count"></div>
							<div id="teamleavegrid"></div>
						</div>

						<div class="tab-pane fade" id="directid" role="tabpanel">
							<div id="directcount" class="hp-record-count"></div>
							<div id="directgrid"></div>
						</div>

						<div class="tab-pane fade" id="indirectid" role="tabpanel">
							<div id="indirectcount" class="hp-record-count"></div>
							<div id="indirectgrid"></div>
						</div>

						<div class="tab-pane fade" id="memberid" role="tabpanel">
							<div class="d-flex flex-wrap align-items-end gap-3 mb-3">
								<div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
									<label for="fromDate">From</label>
									<input type="date" id="fromDate" />
								</div>
								<div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
									<label for="toDate">To</label>
									<input type="date" id="toDate" />
								</div>
								<div class="fg" style="flex:1 1 220px;min-width:200px;">
									<label for="ddlMember">Employee Code</label>
									<select id="ddlMember">
										<option value="">Select</option>
									</select>
								</div>
								<div class="d-flex gap-2" style="flex-shrink:0;">
									<button type="button" id="btnGo" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
										<i class="bx bx-search"></i><span>Go</span>
									</button>
									<button type="button" class="btn btn-secondary btn-sm" onclick="resetDetails()">Clear</button>
								</div>
							</div>
							<div class="divider"></div>

							<div id="rowCountInout" class="hp-record-count"></div>
							<div id="gridInout"></div>
							<div id="spnNoRecord" class="text-center py-5 text-muted" style="display:none;">No Record Found!</div>
						</div>

					</div>
				</div>
			</div>
		</div>

	</div>

</div>
<script>
	const apiBase = '@apiBase';
	const Empid = parseInt(localStorage.getItem("EmployeeId"));
	const savedCompany = localStorage.getItem('selectedCompany');
	const companyDetails = JSON.parse(savedCompany || '{}');
	const Compid = parseInt(companyDetails.CompanyId);
	const Token = localStorage.getItem("authToken");

	var now = new Date();
	var firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

	// Named to avoid clashing with the global window.formatDate defined in
	// compoffleavemodal.js (which returns a display string like "Aug 1, 2026"
	// that native <input type="date"> silently rejects).
	function toInputDateStr(date) {
		var d = new Date(date),
			month = '' + (d.getMonth() + 1),
			day = '' + d.getDate(),
			year = d.getFullYear();

		if (month.length < 2) month = '0' + month;
		if (day.length < 2) day = '0' + day;

		return [year, month, day].join('-');
	}

	function toDisplayDateStr(dateStr) {
		const date = new Date(dateStr);
		if (isNaN(date)) return '-';
		const day = String(date.getDate()).padStart(2, '0');
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const year = date.getFullYear();
		return `${day}/${month}/${year}`;
	}

	function toDisplayDateTimeStr(dateString) {
		const date = new Date(dateString);
		if (isNaN(date)) return '-';
		const day = String(date.getDate()).padStart(2, '0');
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const year = date.getFullYear();
		const hours = String(date.getHours()).padStart(2, '0');
		const minutes = String(date.getMinutes()).padStart(2, '0');
		const seconds = String(date.getSeconds()).padStart(2, '0');
		return `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
	}

	$(document).ready(function () {
		loadpersonaldata();
		loaddirectindirectdata();
		Getteamleave();
	});

	function resetDetails() {
		$('#btnGo').prop("disabled", false);
		$('#fromDate').val(toInputDateStr(firstDayOfMonth));
		$('#toDate').val(toInputDateStr(now));
		$('#ddlMember').val('');
		const fromDate = $('#fromDate').val();
		const toDate = $('#toDate').val();
		const memberId = $('#ddlMember').val();
		if (!fromDate || !toDate) return showToast("Please select from date and to date", "warn");
		loadPunchDetails(Empid, Compid, memberId, fromDate, toDate);
	}

	document.getElementById("myInOutBtn").addEventListener("click", function () {
		window.location.href = "@baseUrl/EmployeePanel/Employee/Index";
	});

	document.getElementById("myProfileBtn").addEventListener("click", function () {
		window.location.href = "@baseUrl/EmployeePanel/Employee/MyProfile";
	});

	function loadpersonaldata() {
		$.ajax({
			url: `${apiBase}/EmployeeMasterAPI/EmployeePersonalInformation?empid=${Empid}&Compid=${Compid}`,
			method: 'GET',
			contentType: 'application/json',
			success: function (data) {
				if (data.isSuccess && Array.isArray(data.data) && data.data.length > 0) {
					let emp = data.data[0];

					$('#profileName').text(emp.fullName || '-');
					$('#profileRole').text(emp.designationName || '');
					$('#lastLogin').text(emp.lastLogin ? toDisplayDateTimeStr(emp.lastLogin) : '-');
					const profileUrl = emp.employeeProfileUrl?.trim();
					$('#profilePhoto').attr('src', profileUrl ? profileUrl : '/images/default-avatar.png');

					$('#branch').text(emp.branchName || '-');
					$('#designation').text(emp.designationName || '-');
					$('#department').text(emp.departmentName || '-');
					$('#joiningDate').text(emp.joiningDate ? toDisplayDateStr(emp.joiningDate) : '-');
					$('#address').text(emp.permanentAddress || 'N/A');

					const warningCount = emp.warningCard || 0;
					$('#warningCard').text(warningCount);
					$('#warningRow').toggleClass('et-warning', Number(warningCount) > 0);
				} else {
					console.warn("No employee data found.");
				}
			},
			error: function (xhr) {
				showToast('Server error: ' + (xhr.responseText || 'Unable to load data.'), 'error');
			}
		});
	}

	function loaddirectindirectdata() {
		$.ajax({
			url: `${apiBase}/EmployeeDashBoardAPI/GetCountDirectOrIndirectEmployees?empid=${Empid}&Compid=${Compid}`,
			method: 'GET',
			contentType: 'application/json',
			success: function (data) {
				if (data.isSuccess && Array.isArray(data.data) && data.data.length > 0) {
					let emp = data.data[0];
					$('#directTeamCount').removeClass('is-loading').text(emp.directMember || '0');
					$('#indirectTeamCount').removeClass('is-loading').text(emp.indirectMember || '0');
				} else {
					console.warn("No employee data found.");
					$('#directTeamCount, #indirectTeamCount').removeClass('is-loading').text('0');
				}
			},
			error: function (xhr) {
				$('#directTeamCount, #indirectTeamCount').removeClass('is-loading').text('0');
				showToast('Server error: ' + (xhr.responseText || 'Unable to load data.'), 'error');
			}
		});
	}

	let fromDateStr = '';

	$('#direct-tab').on('click', function () {
		fromDateStr = 'direct';
		loaddirectdetails(fromDateStr);
	});

	$('#indirect-tab').on('click', function () {
		fromDateStr = 'indirect';
		loadindirectdetails(fromDateStr);
	});

	function loaddirectdetails(type) {
		$.ajax({
			url: `${apiBase}/EmployeeDashBoardAPI/GetDirectIndirectEmployee?EmployeeId=${Empid}&Compid=${Compid}&Action=${type}`,
			method: 'GET',
			contentType: 'application/json',
			success: function (response) {
				if (response.isSuccess && response.data && response.data.length > 0) {
					$("#directgrid").dxDataGrid({
						dataSource: response.data,
						keyExpr: "employeeCode",
						showBorders: true,
						columnAutoWidth: true,
						columns: [
							{ dataField: "employeeCode", caption: "Code", cssClass: "text-center-cell" },
							{ dataField: "fullName", caption: "Name", cssClass: "text-center-cell" }
						],
						onContentReady(e) {
							$('#directcount').html('Total Records: ' + e.component.totalCount());
						}
					});
				} else {
					$("#directgrid").html('<div class="text-muted text-center py-4">No direct member found</div>');
				}
			},
			error: function () {
				console.error("Failed to load direct member.");
				showToast("Could not load direct member", "error");
			}
		});
	}

	function loadindirectdetails(type) {
		$.ajax({
			url: `${apiBase}/EmployeeDashBoardAPI/GetDirectIndirectEmployee?EmployeeId=${Empid}&Compid=${Compid}&Action=${type}`,
			method: 'GET',
			contentType: 'application/json',
			success: function (responses) {
				if (responses.isSuccess && responses.data && responses.data.length > 0) {
					$("#indirectgrid").dxDataGrid({
						dataSource: responses.data,
						keyExpr: "employeeCode",
						showBorders: true,
						columnAutoWidth: true,
						columns: [
							{ dataField: "employeeCode", caption: "Code", cssClass: "text-center-cell" },
							{ dataField: "fullName", caption: "Name", cssClass: "text-center-cell" }
						],
						onContentReady(e) {
							$('#indirectcount').html('Total Records: ' + e.component.totalCount());
						}
					});
				} else {
					$("#indirectgrid").html('<div class="text-muted text-center py-4">No indirect member found</div>');
				}
			},
			error: function () {
				console.error("Failed to load indirect member.");
				showToast("Could not load indirect member", "error");
			}
		});
	}

	$('#fromDate,#ddlMember,#toDate').focus(function () {
		$('#btnGo').prop("disabled", false);
	});

	$('#btnGo').click(function () {
		$('#btnGo').prop("disabled", true);
		const fromDate = $('#fromDate').val();
		const toDate = $('#toDate').val();
		const memberId = $('#ddlMember').val();
		if (!fromDate || !toDate) return showToast("Please select from date and to date", "warn");

		loadPunchDetails(Empid, Compid, memberId, fromDate, toDate);
	});

	$('#Member-tab').on('click', function () {
		bindMember();
		resetDetails();
	});

	async function loadPunchDetails(Empid, Compid, memberId, fromDate, toDate) {
		var drpMemberId = memberId ? memberId : 0;
		try {
			const response = await fetch('@apiBase/EmployeeInOut/GetDateWiseAttendanceDetails', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'Authorization': `Bearer ${Token}`
				},
				body: JSON.stringify({
					employeeId: Empid,
					companyId: Compid,
					memberId: drpMemberId,
					fromDate: fromDate,
					toDate: toDate
				})
			});

			if (!response.ok) {
				throw new Error(`HTTP error! Status: ${response.status}`);
			}

			const data = await response.json();
			if (data.isSuccess && Array.isArray(data.data)) {
				$('#spnNoRecord').hide();
				$('#gridInout').dxDataGrid({
					dataSource: data.data,
					rowHeight: 40,
					width: '100%',
					columns: [
						{ dataField: 'employeeCode', caption: 'Employee Code' },
						{ dataField: 'fullName', caption: 'Full Name' },
						{ dataField: 'branchName', caption: 'Branch' },
						{ dataField: 'companyName', caption: 'Company Name' },
						{
							dataField: 'shiftDate',
							caption: 'Shift Date',
							dataType: 'date',
							format: 'dd-MM-yyyy'
						},
						{ dataField: 'inTime', caption: 'In Time' },
						{ dataField: 'outTime', caption: 'Out Time' },
						{
							dataField: 'workingHours',
							caption: 'Working Hours',
							dataType: 'number',
							format: '#0.00',
							alignment: 'left'
						},
						{ dataField: 'attendanceStatus', caption: 'Attendance Status' },
						{
							dataField: 'salaryDay',
							caption: 'Salary Day',
							dataType: 'number',
							format: '#0.0',
							alignment: 'left'
						}
					],
					columnsAutoWidth: false,
					wordWrapEnabled: false,
					showBorders: true,
					rowAlternationEnabled: false,
					grouping: { autoExpandAll: false },
					headerFilter: { visible: false },
					filterRow: { visible: false, applyFilter: "auto" },
					allowColumnResizing: true,
					groupPanel: { visible: false },
					searchPanel: { visible: true, width: 240, placeholder: "Search..." },
					columnFixing: { enabled: false },
					scrolling: {
						mode: "standard",
						useNative: false,
						scrollByContent: true,
						scrollByThumb: true
					},
					onContentReady(e) {
						$('#rowCountInout').html('Total Records: ' + e.component.totalCount());
					}
				});
			} else {
				$('#spnNoRecord').show();
			}
		} catch (error) {
			console.error('Failed to load In/Out records:', error);
			showToast("Failed to load In/Out records.", "error");
		}
	}

	async function bindMember() {
		$.ajax({
			url: '@apiBase/EmployeeInOut/GetEmployeesByReportingManager/' + Empid,
			method: 'GET',
			headers: {
				'Authorization': `Bearer ${Token}`
			},
			success: function (data) {
				if (data.isSuccess) {
					var dropdown = $('#ddlMember');
					dropdown.empty();
					dropdown.append('<option disabled selected value="">Select</option>');
					$.each(data.data, function (index, member) {
						dropdown.append($('<option>', {
							value: member.employeeId,
							text: member.employeeCode + " - " + member.fullName
						}));
					});
				}
			},
			error: function (error) {
				console.error('Error fetching grade data:', error);
			}
		});
	}

	$('#team-tab').on('click', function () {
		Getteamleave();
	});

	function Getteamleave() {
		$.ajax({
			url: `${apiBase}/EmployeeDashBoardAPI/GetMyteamleave?empid=${Empid}&Compid=${Compid}`,
			method: 'GET',
			contentType: 'application/json',
			success: function (responses) {
				if (responses.isSuccess && responses.data && responses.data.length > 0) {
					$("#teamleavegrid").dxDataGrid({
						dataSource: responses.data,
						showBorders: true,
						columnAutoWidth: true,
						columns: [
							{ dataField: "fullName", caption: "Name", cssClass: "text-center-cell" },
							{ dataField: "fromDate", caption: "FromDate", cssClass: "text-center-cell", dataType: "date", format: "dd/MM/yyyy" },
							{ dataField: "toDate", caption: "ToDate", cssClass: "text-center-cell", dataType: "date", format: "dd/MM/yyyy" },
							{ dataField: "no_Of_Date", caption: "NoOfDate", cssClass: "text-center-cell" },
							{ dataField: "leave_Type", caption: "Leave_Type", cssClass: "text-center-cell" }
						],
						onContentReady(e) {
							$('#teamleavecount').html('Total Records: ' + e.component.totalCount());
						}
					});
				} else {
					$("#teamleavegrid").html('<div class="text-muted text-center py-4">No team leave found</div>');
				}
			},
			error: function () {
				console.error("Failed to load team leave.");
				showToast("Could not load team leave", "error");
			}
		});
	}
</script>
