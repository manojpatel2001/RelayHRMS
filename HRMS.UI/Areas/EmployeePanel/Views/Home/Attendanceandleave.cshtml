@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Attendance Calendar";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}
<style>
    /* Page-local overrides only — cards, buttons, form fields and the
       Inter font all come from the shared theme CSS (hrms-premium.css). */

    .et-calendar-card { overflow: hidden; }

    .et-cal-banner {
        background: linear-gradient(135deg, var(--hp-blue-dark) 0%, var(--hp-blue-mid) 100%);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .et-cal-banner .btn span { display: inline; }
    .et-cal-title { text-align: center; }
    .et-month-title {
        font-size: 20px;
        font-weight: 700;
        color: #fff;
        line-height: 1.1;
        letter-spacing: .3px;
    }
    .et-year-subtitle {
        font-size: 12.5px;
        color: rgba(255,255,255,.75);
        margin-top: 2px;
    }

    .et-calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
    }

    .et-day-header {
        background: var(--hp-surface-3);
        color: var(--hp-text-md);
        text-align: center;
        padding: 9px 4px;
        font-weight: 700;
        font-size: 11.5px;
        letter-spacing: .4px;
        text-transform: uppercase;
        border-bottom: 1px solid var(--hp-border);
    }

    .et-calendar-day {
        min-height: 96px;
        border: 1px solid var(--hp-border);
        padding: 6px 4px;
        background: var(--hp-surface);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        transition: background .15s ease, box-shadow .15s ease;
    }
    .et-calendar-day:hover { background: var(--hp-surface-2); box-shadow: inset 0 0 0 1px var(--hp-border-md); }

    .et-calendar-day.et-weekend { background: var(--hp-surface-2); }
    .et-calendar-day.et-other-month { background: var(--hp-surface-2); color: var(--hp-text-faint); }
    .et-calendar-day.et-other-month .et-day-number { color: var(--hp-text-faint); }

    .et-calendar-day.et-today {
        background: rgba(45,122,181,.08);
        border-color: var(--hp-blue-mid);
        box-shadow: inset 0 0 0 1px var(--hp-blue-mid);
    }
    .et-calendar-day.et-today .et-day-number { color: var(--hp-blue-mid); }

    .et-day-number {
        font-size: 14.5px;
        font-weight: 700;
        color: var(--hp-text);
        margin-bottom: 4px;
    }

    .et-attendance-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        width: 100%;
    }

    .et-status-badge {
        padding: 2px 9px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 10.5px;
        letter-spacing: .2px;
        min-width: 26px;
        display: inline-block;
    }

    .et-time-info,
    .et-description {
        font-size: 10.5px;
        color: var(--hp-text-muted);
        line-height: 1.25;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Status colors — mapped to the theme's semantic tokens instead of
       arbitrary Bootstrap-alert pastels, so every color used here already
       means the same thing elsewhere in the app. */
    .et-status-P    { background: rgba(16,185,129,.14);  color: #047857; }
    .et-status-A    { background: rgba(239,68,68,.12);   color: #b91c1c; }
    .et-status-HD   { background: rgba(16,185,129,.10);  color: #047857; border: 1px dashed rgba(16,185,129,.45); }
    .et-status-H    { background: rgba(245,158,11,.16);  color: #92400e; }
    .et-status-W    { background: var(--hp-surface-3);   color: var(--hp-text-muted); }
    .et-status-PL   { background: rgba(59,130,246,.12);  color: #1d4ed8; }
    .et-status-COMP { background: rgba(45,122,181,.14);  color: var(--hp-blue-dark); }
    .et-status-SHL  { background: rgba(59,130,246,.12);  color: #1d4ed8; }
    .et-status-LWP  { background: var(--hp-surface);     color: var(--hp-danger); border: 1px solid rgba(239,68,68,.35); }
    .et-status-NOT_JOINED,
    .et-status-LEFT { background: var(--hp-surface-3);   color: var(--hp-text-faint); }
    .et-status-FUTURE { background: var(--hp-surface);   color: var(--hp-text-faint); border: 1px dashed var(--hp-border-md); }

    /* Monthly summary tiles */
    .et-summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
    }

    /* Legend */
    .et-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; }
    .et-legend-item { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--hp-text-md); }
    .et-legend-swatch { width: 13px; height: 13px; border-radius: 4px; flex-shrink: 0; }

    @@media (max-width: 768px) {
        .et-calendar-day { min-height: 66px; padding: 4px 2px; }
        .et-month-title { font-size: 17px; }
        .et-cal-banner .btn span { display: none; }
        .et-status-badge { font-size: 9.5px; padding: 1px 7px; }
        .et-time-info, .et-description { font-size: 9px; }
    }
</style>

<div class="wms-form-page">

    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bx bx-calendar-alt" style="color:var(--hp-blue-mid);margin-right:6px;"></i>My Attendance Calendar</h6>
            <div class="d-flex align-items-center gap-2">
                <label for="monthSelect" class="mb-0" style="font-size:12px;font-weight:600;color:var(--hp-text-muted);white-space:nowrap;">Month / Year</label>
                <select class="form-select form-select-sm" id="monthSelect" style="width:auto;min-width:160px;" onchange="loadCalendar()">
                    <!-- Options populated dynamically by JavaScript -->
                </select>
            </div>
        </div>
    </div>

    <div class="card et-calendar-card mb-3">
        <div class="et-cal-banner">
            <button type="button" class="btn btn-light btn-sm" onclick="previousMonth()">
                <i class="bx bx-chevron-left"></i><span>Previous</span>
            </button>
            <div class="et-cal-title">
                <div class="et-month-title" id="monthTitle">August</div>
                <div class="et-year-subtitle" id="yearSubtitle">2025</div>
            </div>
            <button type="button" class="btn btn-light btn-sm" onclick="nextMonth()">
                <span>Next</span><i class="bx bx-chevron-right"></i>
            </button>
        </div>

        <div class="et-calendar-grid" id="calendarGrid">
            <div class="et-day-header">Sun</div>
            <div class="et-day-header">Mon</div>
            <div class="et-day-header">Tue</div>
            <div class="et-day-header">Wed</div>
            <div class="et-day-header">Thu</div>
            <div class="et-day-header">Fri</div>
            <div class="et-day-header">Sat</div>
            <!-- Calendar days populated by JavaScript -->
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bx bx-bar-chart-alt-2" style="color:var(--hp-blue-mid);margin-right:6px;"></i>Monthly Summary</h6>
        </div>
        <div class="card-body">
            <div class="et-summary-grid">
                <div class="hrms-stat-card hrms-stat-green">
                    <div class="hrms-stat-icon"><i class="bx bx-check-circle"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="totalPresent">0</div>
                        <div class="hrms-stat-label">Present</div>
                    </div>
                </div>
                <div class="hrms-stat-card hrms-stat-red">
                    <div class="hrms-stat-icon"><i class="bx bx-x-circle"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="totalAbsent">0</div>
                        <div class="hrms-stat-label">Absent</div>
                    </div>
                </div>
                <div class="hrms-stat-card hrms-stat-blue">
                    <div class="hrms-stat-icon"><i class="bx bx-calendar-week"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="totalWeekends">0</div>
                        <div class="hrms-stat-label">Weekends</div>
                    </div>
                </div>
                <div class="hrms-stat-card hrms-stat-orange">
                    <div class="hrms-stat-icon"><i class="bx bx-gift"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="totalHolidays">0</div>
                        <div class="hrms-stat-label">Holidays</div>
                    </div>
                </div>
                <div class="hrms-stat-card hrms-stat-blue">
                    <div class="hrms-stat-icon"><i class="bx bx-calendar-minus"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="totalLeaves">0</div>
                        <div class="hrms-stat-label">Leaves</div>
                    </div>
                </div>
                <div class="hrms-stat-card hrms-stat-green">
                    <div class="hrms-stat-icon"><i class="bx bx-trending-up"></i></div>
                    <div class="hrms-stat-info">
                        <div class="hrms-stat-num" id="attendancePercentage">0%</div>
                        <div class="hrms-stat-label">Attendance %</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bx bx-info-circle" style="color:var(--hp-blue-mid);margin-right:6px;"></i>Legend</h6>
        </div>
        <div class="card-body">
            <div class="et-legend">
                <div class="et-legend-item"><span class="et-legend-swatch et-status-P"></span>Present (P)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-A"></span>Absent (A)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-W"></span>Weekend (W)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-H"></span>Holiday (H)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-HD"></span>Half Day (HD)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-PL"></span>Paid Leave (PL)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-COMP"></span>Compensatory Off (COMP)</div>
                <div class="et-legend-item"><span class="et-legend-swatch et-status-LWP"></span>Leave Without Pay (LWP)</div>
            </div>
        </div>
    </div>

</div>
<script>
    const EmployeeId = localStorage.getItem("EmployeeId");
    var Token = localStorage.getItem("authToken");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const companyId = parseInt(companyDetails.CompanyId);

    const today = new Date();
    const currentActualYear = today.getFullYear();
    const currentActualMonth = today.getMonth() + 1;

    let currentYear = currentActualYear;
    let currentMonth = currentActualMonth;

    let AttedanceCalanderData = [];

    function populateMonthDropdown() {
        const monthSelect = document.getElementById('monthSelect');
        monthSelect.innerHTML = '';

        const monthNames = [
            'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
        ];

        const totalMonthsToShow = 24;

        for (let i = 0; i < totalMonthsToShow; i++) {
            const optionDate = new Date(currentActualYear, currentActualMonth - 1 - i, 1);
            const optionYear = optionDate.getFullYear();
            const optionMonth = optionDate.getMonth() + 1;

            const option = document.createElement('option');
            const monthValue = optionMonth.toString().padStart(2, '0');
            option.value = `${optionYear}-${monthValue}`;
            option.textContent = `${monthNames[optionMonth - 1]} ${optionYear}`;

            if (optionYear === currentActualYear && optionMonth === currentActualMonth) {
                option.selected = true;
            }

            monthSelect.appendChild(option);
        }
    }

    async function loadCalendar() {
        await GetMonthlyCalanderData();
        updateCalendarHeader();
        populateCalendar();
        updateSummary();
        updateNavigationButtons();
    }

    async function GetMonthlyCalanderData() {
        const monthSelect = document.getElementById('monthSelect');
        const [year, month] = monthSelect.value.split('-');
        currentYear = parseInt(year);
        currentMonth = parseInt(month);

        if (!monthSelect) {
            return Promise.resolve();
        }

        return new Promise((resolve, reject) => {
            $.ajax({
                type: "POST",
                url: "@baseUrl/EmployeeReportAPI/GetAttendanceCalender",
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                data: JSON.stringify({
                    EmployeeId: EmployeeId,
                    Month: currentMonth,
                    Year: currentYear
                }),
                success: function (data) {
                    if (data.isSuccess) {
                        AttedanceCalanderData = data.data;
                        resolve();
                    } else {
                        reject("Failed: Data indicates failure");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error: " + status + " - " + error);
                    reject(error);
                }
            });
        });
    }

    function getLocalDateString(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function updateCalendarHeader() {
        const monthNames = [
            'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
        ];
        document.getElementById('monthTitle').textContent = monthNames[currentMonth - 1];
        document.getElementById('yearSubtitle').textContent = currentYear;
    }

    function populateCalendar() {
        const grid = document.getElementById('calendarGrid');
        const headers = grid.querySelectorAll('.et-day-header');
        grid.innerHTML = '';
        headers.forEach(header => grid.appendChild(header));

        const firstDay = new Date(currentYear, currentMonth - 1, 1);
        const today = new Date();
        const startDate = new Date(firstDay);
        startDate.setDate(firstDay.getDate() - firstDay.getDay());

        for (let i = 0; i < 42; i++) {
            const currentDate = new Date(startDate);
            currentDate.setDate(startDate.getDate() + i);
            const dayElement = createDayElement(currentDate, currentMonth, today);
            grid.appendChild(dayElement);
        }
    }

    function createDayElement(date, currentMonth, today) {
        const dayDiv = document.createElement('div');
        dayDiv.className = 'et-calendar-day';

        const isCurrentMonth = date.getMonth() + 1 === currentMonth;
        const isToday = date.toDateString() === today.toDateString();
        const isWeekend = date.getDay() === 0 || date.getDay() === 6;

        if (!isCurrentMonth) dayDiv.classList.add('et-other-month');
        if (isToday) dayDiv.classList.add('et-today');
        if (isWeekend) dayDiv.classList.add('et-weekend');

        const dateStr = getLocalDateString(date);
        const attendanceData = AttedanceCalanderData?.attedanceCalanderDays?.find(d => {
            if (!d.calendarDate) return false;
            const calendarDate = d.calendarDate.split('T')[0];
            return calendarDate === dateStr;
        });

        dayDiv.innerHTML = `
            <div class="et-day-number">${date.getDate()}</div>
            <div class="et-attendance-info">
                ${createAttendanceInfo(attendanceData, isWeekend, isCurrentMonth)}
            </div>
        `;

        return dayDiv;
    }

    function createAttendanceInfo(attendanceData, isWeekend, isCurrentMonth) {
        if (!isCurrentMonth) return '';

        if (!attendanceData) {
            if (isWeekend) {
                return '<div class="et-status-badge et-status-W">W</div>';
            }
            return '<div class="et-status-badge et-status-FUTURE">-</div>';
        }

        let html = `<div class="et-status-badge et-status-${attendanceData.attendanceStatus}">${attendanceData.attendanceStatus}</div>`;

        if (attendanceData.inTime && attendanceData.outTime) {
            html += `<div class="et-time-info">${attendanceData.inTime} - ${attendanceData.outTime}</div>`;
        }

        if (attendanceData.workingHours) {
            html += `<div class="et-time-info">${attendanceData.workingHours}h</div>`;
        }

        if (attendanceData.statusDescription || attendanceData.holidayName || attendanceData.leaveReason) {
            const description = attendanceData.statusDescription || attendanceData.holidayName || attendanceData.leaveReason;
            html += `<div class="et-description">${description}</div>`;
        }

        return html;
    }

    function updateSummary() {
        if (AttedanceCalanderData?.attedanceCalanderDaysSummary) {
            document.getElementById('totalPresent').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.totalPresent;
            document.getElementById('totalAbsent').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.totalAbsent;
            document.getElementById('totalWeekends').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.totalWeekends;
            document.getElementById('totalHolidays').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.totalHolidays;
            document.getElementById('totalLeaves').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.totalLeaves;
            document.getElementById('attendancePercentage').textContent = AttedanceCalanderData.attedanceCalanderDaysSummary.attendancePercentage + '%';
        }
    }

    function canNavigateNext() {
        if (currentYear < currentActualYear) {
            return true;
        } else if (currentYear === currentActualYear && currentMonth < currentActualMonth) {
            return true;
        }
        return false;
    }

    function canNavigatePrevious() {
        const limitDate = new Date(currentActualYear, currentActualMonth - 24, 1);
        const currentViewDate = new Date(currentYear, currentMonth - 1, 1);
        return currentViewDate >= limitDate;
    }

    function updateNavigationButtons() {
        const prevButton = document.querySelector('button[onclick="previousMonth()"]');
        const nextButton = document.querySelector('button[onclick="nextMonth()"]');

        if (prevButton) {
            prevButton.disabled = !canNavigatePrevious();
        }

        if (nextButton) {
            nextButton.disabled = !canNavigateNext();
        }
    }

    function previousMonth() {
        if (!canNavigatePrevious()) return;

        if (currentMonth === 1) {
            currentMonth = 12;
            currentYear--;
        } else {
            currentMonth--;
        }

        const monthValue = currentMonth.toString().padStart(2, '0');
        document.getElementById('monthSelect').value = `${currentYear}-${monthValue}`;
        loadCalendar();
    }

    function nextMonth() {
        if (!canNavigateNext()) return;

        if (currentMonth === 12) {
            currentMonth = 1;
            currentYear++;
        } else {
            currentMonth++;
        }

        const monthValue = currentMonth.toString().padStart(2, '0');
        document.getElementById('monthSelect').value = `${currentYear}-${monthValue}`;
        loadCalendar();
    }

    document.addEventListener('DOMContentLoaded', function () {
        populateMonthDropdown();
        loadCalendar();
    });
</script>
