<!-- Main Dashboard Cards -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 essPenalSec">
    <div class="col">
        <div id="employeeid" class="card h-100 border-0" style="background: linear-gradient(135deg, #1e9bca 0%, #1e88b8 100%); box-shadow: 0 8px 16px rgba(30, 155, 202, 0.4); border-radius: 0;">
            <div class="card-body position-relative">
                <div style="padding-right: 80px;">
                    <p class="my-1 text-white fs-4 fw-semibold mb-2">Employee & Team</p>
                    <h6 class="mb-0 text-white" style="opacity: 0.95; font-size: 14px; line-height: 1.4;">Explore your team detail from direct & in-direct reporting.</h6>
                </div>
                <div class="text-white position-absolute" style="font-size: 4.5rem; line-height: 1; opacity: 0.9; right: 20px; top: 50%; transform: translateY(-50%);">
                    <i class='bx bxs-group'></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div id="attendanceleaveid" class="card h-100 border-0" style="background: linear-gradient(135deg, #f06292 0%, #ec407a 100%); box-shadow: 0 8px 16px rgba(240, 98, 146, 0.4); border-radius: 0;">
            <div class="card-body position-relative">
                <div style="padding-right: 80px;">
                    <p class="my-1 text-white fs-4 fw-semibold mb-2">Attendance & Leave</p>
                    <h6 class="mb-0 text-white" style="opacity: 0.95; font-size: 14px; line-height: 1.4;">Daily or Monthly Attendance Details</h6>
                    <div class="mt-2" style="background: rgba(139, 0, 59, 0.4); padding: 5px 10px; border-radius: 5px; display: inline-block; color: white;">
                        <small style="font-weight: 600;">In Time: </small>
                        <span id="inTime" class="badge" style="background: transparent; color: white; padding: 0; font-weight: bold;">Pending</span>
                    </div>
                </div>
                <div class="text-white position-absolute" style="font-size: 4.5rem; line-height: 1; opacity: 0.9; right: 20px; top: 50%; transform: translateY(-50%);">
                    <i class='bx bx-history'></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div id="salaryid" class="card h-100 border-0" style="background: linear-gradient(135deg, #ffa726 0%, #fb8c00 100%); box-shadow: 0 8px 16px rgba(255, 167, 38, 0.4); border-radius: 0;">
            <div class="card-body position-relative">
                <div style="padding-right: 80px;">
                    <p class="my-1 text-white fs-4 fw-semibold mb-2">Salary</p>
                    <h6 class="mb-0 text-white" style="opacity: 0.95; font-size: 14px; line-height: 1.4;">Check-out your processed and published salary detail.</h6>
                </div>
                <div class="text-white position-absolute" style="font-size: 4.5rem; line-height: 1; opacity: 0.9; right: 20px; top: 50%; transform: translateY(-50%);">
                    <i class='bx bx-rupee'></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div id="reportid" class="card h-100 border-0" style="background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%); box-shadow: 0 8px 16px rgba(102, 187, 106, 0.4); border-radius: 0;">
            <div class="card-body position-relative">
                <div style="padding-right: 80px;">
                    <p class="my-1 text-white fs-4 fw-semibold mb-2">Reports</p>
                    <h6 class="mb-0 text-white" style="opacity: 0.95; font-size: 14px; line-height: 1.4;">Get the details of reports</h6>
                </div>
                <div class="text-white position-absolute" style="font-size: 4.5rem; line-height: 1; opacity: 0.9; right: 20px; top: 50%; transform: translateY(-50%);">
                    <i class='bx bx-line-chart-down'></i>
                </div>
            </div>
        </div>
    </div>
</div>
<br />

<!-- Latest Members & Wishes Section -->
<div class="row" style="margin-bottom: 40px;">
    <div class="col-md-3">
        <div id="latestmemberid" class="card border-0" style="box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); border-radius: 0; height: calc(100vh - 300px);">
            <div style="height: 3px; background: linear-gradient(to right, #ff9800 0%, #ff9800 100%);"></div>
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center" style="padding: 15px 20px;">
                <h6 class="mb-0 fw-bold" style="color: #2c3e50;">Latest Members</h6>
                <div class="d-flex align-items-center gap-2">
                    <span id="totalMemberCount" class="badge bg-success text-white" style="font-size: 12px; padding: 4px 8px;">0 </span>
                    <i class='bx bx-refresh' style="font-size: 20px; color: #666; cursor: pointer;"></i>
                </div>
            </div>
            <div class="px-3 py-2 bg-warning">
                <div id="companyNameDisplay" class="fw-bold text-white">RELAY EXPRESS PVT LTD</div>
            </div>
            <div class="card-body p-3" style="height: calc(100vh - 450px); overflow-y: auto; overflow-x: hidden;" id="latestMembersContent">
                <p class="card-text">Loading members...</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 wishes-card" style="box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); border-radius: 0; height: calc(100vh - 300px); background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); position: relative; overflow: hidden;">
            <div id="wishesTopBorder" style="position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(to right, #ff9800 0%, #ff9800 100%); z-index: 1000;"></div>
            <div style="display: flex; flex-direction: column; height: 100%; padding-top: 3px;">
                <ul class="nav nav-tabs border-0" id="wishesid" role="tablist" style="padding: 0 20px; margin-top: 12px; background: transparent; flex-shrink: 0;">
                    <li class="nav-item">
                        <a class="nav-link active px-3 py-2 border-0" id="birthday-tab" data-toggle="tab" href="#birthdayid" role="tab" onclick="changeTopBorder('#ff9800')" style="color: #666; font-weight: 500;">
                            🎂 Birthday
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 border-0" id="workanniversary-tab" data-toggle="tab" href="#workanniversaryid" role="tab" onclick="changeTopBorder('#e6a800')" style="color: #666; font-weight: 500;">
                            🏢 Work Anniversary
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 border-0" id="anniversary-tab" data-toggle="tab" href="#anniversaryid" role="tab" onclick="changeTopBorder('#9c27b0')" style="color: #666; font-weight: 500;">
                            💍 Marriage Anniversary
                        </a>
                    </li>
                    <li class="nav-item ms-auto">
                        <i class='bx bx-refresh' style="font-size: 20px; color: #666; cursor: pointer; margin-top: 8px;"></i>
                    </li>
                </ul>

                <div class="tab-content" style="padding: 20px; flex: 1; overflow: hidden;">
                    <div class="tab-pane fade show active" id="birthdayid" role="tabpanel" style="height: 100%; overflow-y: auto; overflow-x: hidden;">
                        <div id="groupedBirthdayList" class="list-group border-0">
                            <p class="text-muted">Loading birthdays...</p>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="workanniversaryid" role="tabpanel" style="height: 100%; overflow-y: auto; overflow-x: hidden;">
                        <div id="workAnniversaryList" class="list-group border-0"></div>
                    </div>
                    <div class="tab-pane fade" id="anniversaryid" role="tabpanel" style="height: 100%; overflow-y: auto; overflow-x: hidden;">
                        <div id="marriageAnniversaryList" class="list-group border-0"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); border-radius: 0; height: calc(100vh - 300px);">
            <div style="height: 3px; background: linear-gradient(to right, #ff9800 0%, #ffc107 100%);"></div>
            <div style="display: flex; flex-direction: column; height: 100%;">
                <div style="background-color: #fff; padding: 15px 20px; border-bottom: 1px solid #e0e0e0; cursor: pointer; flex-shrink: 0;" onclick="toggleHolidays()">
                    <div class="d-flex align-items-center">
                        <span id="holidayArrow" style="color: #ff9800; margin-right: 8px; font-weight: bold;">▼</span>
                        <h6 class="mb-0 fw-semibold" style="color: #2c3e50;">Upcoming Holidays</h6>
                    </div>
                </div>
                <div id="holidaysContent" style="padding: 20px; overflow-y: auto; overflow-x: hidden; flex: 1;">
                    <div id="upcomingHolidayList"></div>
                </div>
                <div style="background-color: #f5f5f5; padding: 15px 20px; border-top: 1px solid #e0e0e0; cursor: pointer; flex-shrink: 0;" onclick="toggleOrgPolicy()">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <span id="orgArrow" style="color: #ff9800; margin-right: 8px; font-weight: bold;">▶</span>
                            <h6 class="mb-0 fw-semibold" style="color: #2c3e50;">Organization Policy</h6>
                        </div>
                        <span class="badge bg-warning text-white" style="font-size: 10px; padding: 3px 8px;">NEW</span>
                    </div>
                </div>
                <div id="orgPolicyContent" style="padding: 20px; overflow-y: auto; overflow-x: hidden; display: none; flex: 1;">
                    <div id="organizationPolicyList"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function changeTopBorder(color) {
        const topBorder = document.getElementById('wishesTopBorder');
        if (topBorder) {
            topBorder.style.background = `linear-gradient(to right, ${color} 0%, ${color} 100%)`;
            topBorder.style.display = 'block';
            topBorder.style.visibility = 'visible';
            topBorder.style.opacity = '1';
            topBorder.style.height = '3px';
            topBorder.style.position = 'absolute';
            topBorder.style.top = '0';
            topBorder.style.left = '0';
            topBorder.style.right = '0';
            topBorder.style.zIndex = '1000';
        }
    }

    function ensureBorderVisible() {
        const topBorder = document.getElementById('wishesTopBorder');
        if (topBorder) {
            topBorder.style.display = 'block';
            topBorder.style.visibility = 'visible';
            topBorder.style.opacity = '1';
