/* ── Work + Marriage Anniversary, combined (Today / Week / Month) ── */
function loadAnniversaries() {
    $.when(
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetTodayWorkAnniversary?Compid=' + Compid, type: 'GET' }),
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetTodayMarriageAnnivarsary?Compid=' + Compid, type: 'GET' })
    ).done(function(workResp, marriageResp) {
        var work = Array.isArray(workResp[0].data) ? workResp[0].data : [];
        var marriage = Array.isArray(marriageResp[0].data) ? marriageResp[0].data : [];
        work.forEach(function(m) { m._type = 'work'; });
        marriage.forEach(function(m) { m._type = 'marriage'; });
        var combined = work.concat(marriage);
        var buckets = bucketByDate(combined);
        renderBucketPane('annivTodayPane', 'annivTodayCount', buckets.today, buildAnnivCard, 'bxs-building', 'No anniversaries today.');
        renderBucketPane('annivWeekPane', 'annivWeekCount', buckets.week, buildAnnivCard, 'bxs-building', 'No anniversaries this week.');
        renderBucketPane('annivMonthPane', 'annivMonthCount', buckets.month, buildAnnivCard, 'bxs-building', 'No anniversaries this month.');
    }).fail(function() {
        ['annivTodayPane','annivWeekPane','annivMonthPane'].forEach(function(id) {
            $('#' + id).html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load anniversaries.</p></div>');
        });
    });
}
function buildAnnivCard(m) {
    var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
    var icon = m._type === 'marriage' ? '💍' : '🏢';
    return '<div class="ess-bday-card">' +
        '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
        '<div style="flex:1;min-width:0;">' +
            '<div class="ess-bday-name">' + icon + ' ' + (m.fullName || '') + '</div>' +
            '<div class="ess-bday-info">' + (m.designationName || '') + (m.departmentName ? ' | ' + m.departmentName : '') + '</div>' +
            '<div class="ess-bday-info">' + (m.branchName || '') + (m.ageInYears ? ' · ' + m.ageInYears + ' yr(s)' : '') + '</div>' +
        '</div>' +
        '<div class="ess-bday-date">' + formatDDMMYYYY(m.date) + '</div>' +
        '</div>';
}

/* ── Upcoming Holidays ("View Holiday Calendar" expands the already-
   fetched list in place — there's no dedicated calendar page yet) ── */
var allHolidays = [];
var holidaysExpanded = false;
var HOLIDAY_PREVIEW_COUNT = 4;

function loadUpcomingHolidays() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/Getupcommingholidays?Compid=' + Compid + '&EmployeeId=' + Empid,
        type: 'GET',
        success: function(resp) {
            allHolidays = Array.isArray(resp.data) ? resp.data : [];
