function fetchInTime() {
    $.ajax({
        url: apiBase + '/EmpAttendanceAPI/GetEmployeeInTime/' + localStorage.getItem('EmployeeId'),
        type: 'GET',
        success: function(resp) {
            if (resp.isSuccess && resp.data && resp.data.length > 0) {
                $('#inTime').text(resp.data[0].inTime);
