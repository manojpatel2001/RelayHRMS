    let currentNewsId = null;
    let newsCheckInterval = null;

    function loadNewsAnnouncement() {
        const apiUrl = `${apiBase}/NewsAnnouncementAPI/GetActiveNewsForDashboard?companyId=${Compid}&employeeId=${Empid}`;

        $.ajax({
            url: apiUrl,
            type: 'GET',
            success: function(response) {
                if (response.isSuccess && response.data && response.data.length > 0) {
                    displayNewsAnnouncement(response.data[0]);
                } else {
                    hideNewsAnnouncement();
                }
            },
            error: function(xhr, status, error) {
                console.error('Error loading news:', error);
                hideNewsAnnouncement();
            }
        });
    }

    function displayNewsAnnouncement(news) {
        if (!news) {
            hideNewsAnnouncement();
            return;
        }

        const closedNewsId = sessionStorage.getItem('closedNewsId');
        if (closedNewsId && parseInt(closedNewsId) === news.newsID) {
            return;
        }

        currentNewsId = news.newsID;
        $('#newsTitle').text(news.newsTitle || 'News Announcement');
        $('#newsDescription').text(news.newsDescription || '');
        $('#newsAnnouncementContainer').slideDown(400);
    }

    function hideNewsAnnouncement() {
        $('#newsAnnouncementContainer').slideUp(300);
        currentNewsId = null;
    }

    function closeNewsAnnouncement() {
        if (currentNewsId) {
            sessionStorage.setItem('closedNewsId', currentNewsId);
        }

        const container = document.getElementById('newsAnnouncementContainer');
        if (container) {
            container.classList.add('closing');
            setTimeout(() => {
                hideNewsAnnouncement();
                container.classList.remove('closing');
            }, 400);
        } else {
            hideNewsAnnouncement();
        }
    }

