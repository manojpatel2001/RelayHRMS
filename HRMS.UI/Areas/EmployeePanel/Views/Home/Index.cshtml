@{
    ViewData["Title"] = "ESS Dashboard";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<style>
/* ════════════════════════════════════════════════════════════════
   ESS DASHBOARD  —  WMS steel-blue theme
   Card layout/colors restyled to match the reference admin dashboard
   (stage.hrmsui.ethicstechnology.net/Dashboard) — flat white card
   headers, underline tabs, colored quick-action icons — except the 4
   hero cards at the top, which are kept exactly as they were.
   Recent Activity and Attendance Overview have no backend yet (no
   audit log, no attendance-aggregate API), so they render as honest
   "coming soon" placeholders in the right position/style rather than
   fabricated numbers. Add Employee / Shifts / Holidays quick actions
   have no ESS page yet either, so those 3 tiles show a "coming soon"
   notice instead of a broken link.
   ════════════════════════════════════════════════════════════════ */

/* ── Hero action cards (unchanged) ────────────────────────────── */
.ess-hero-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

/* ── Dashboard rows (middle + bottom sections) ────────────────────
   Plain CSS Grid, not Bootstrap's .row/.col-* — Bootstrap's .row class
   carries a built-in `margin-top: calc(-1 * var(--bs-gutter-y))` (with
   .g-3 that's -16px) that fought every margin-based attempt to add a
   clean gap above these rows. A dedicated class with no competing
   framework margin removes that fight — margin-top here is the ONLY
   thing controlling the gap above each row.
   (A later attempt made both rows share leftover viewport height via
   flexbox so the page would never need its own scrollbar — reverted:
   the two rows stopped ending up the same height in practice, which
   silently ate the gap between them. Fixed pixel heights are back —
   see the `max-height` media queries near the bottom of this block for
   how short laptop screens are handled instead: same idea, just a
   handful of discrete pixel tiers keyed off viewport HEIGHT rather than
   a fluid split, so both rows still always share one exact value.) */
.ess-dash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 32px;
}
@@media (max-width: 1200px) {
    .ess-dash-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 576px) {
    .ess-dash-grid { grid-template-columns: 1fr; }
}
.ess-hero-card {
    position: relative;
    border-radius: 10px;
    padding: 8px 14px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: none;
    box-shadow: 0 4px 16px rgba(0,0,0,.12);
    min-height: 52px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.ess-hero-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0,0,0,.18);
}
.ess-hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.04);
    pointer-events: none;
    transition: background 0.2s;
}
.ess-hero-card:hover::after { background: rgba(255,255,255,.09); }

.ess-hero-card .hc-bg-icon {
    position: absolute;
    right: -8px;
    bottom: -8px;
    font-size: 80px;
    opacity: 0.12;
    line-height: 1;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
}
.ess-hero-card:hover .hc-bg-icon { opacity: 0.20; transform: scale(1.06); }

.ess-hero-card .hc-title {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 3px;
    letter-spacing: 0.15px;
}
.ess-hero-card .hc-desc {
    font-size: 11.5px;
    color: rgba(255,255,255,.80);
    margin: 0;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.ess-hero-card .hc-hint {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 10.5px;
    font-weight: 700;
    color: rgba(255,255,255,.85);
    margin: 5px 0 0;
    letter-spacing: 0.2px;
}
.ess-hero-card .hc-hint i {
    font-size: 14px;
    transition: transform 0.2s ease;
}
.ess-hero-card:hover .hc-hint i {
    transform: translateX(3px);
}
.ess-hero-card .hc-badge {
    display: inline-block;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.30);
    border-radius: 20px;
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
    padding: 2px 9px;
    margin-top: 5px;
    width: fit-content;
}

/* Card color variants */
.ess-hc-1 { background: linear-gradient(135deg, #1e3a5f 0%, #3e6a8c 100%); }
.ess-hc-2 { background: linear-gradient(135deg, #2d5a8a 0%, #2d7ab5 100%); }
.ess-hc-3 { background: linear-gradient(135deg, #1a5a7a 0%, #0e7490 100%); }
.ess-hc-4 { background: linear-gradient(135deg, #1e4060 0%, #2d5a80 100%); }

@@media (max-width: 1200px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 768px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
@@media (max-width: 576px) {
    .ess-hero-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .ess-hero-card { min-height: 46px; padding: 7px 10px; }
    .ess-hero-card .hc-bg-icon { font-size: 56px; }
}

/* ── Panel / Section card ─────────────────────────────────────
   Values below are read directly from the reference project's source
   (Dashboard.tsx) rather than estimated from screenshots: 4px radius,
   no shadow, and a light blue-tint gradient header — not flat white. */
.ess-panel {
    background: #fff;
    border-radius: 4px;
    border: 1px solid #d0dce8;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.ess-panel-hdr {
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #334e6a;
    background: linear-gradient(to bottom, #e8f0f8, #dce7f2);
    border-bottom: 1px solid #d0dce8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.ess-panel-hdr > span:first-child { display: flex; align-items: center; gap: 6px; }
.ess-panel-hdr i { font-size: 13px; color: #628db6; }
.ess-panel-hdr-badge {
    background: #d4f0e3;
    color: #166534;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    letter-spacing: 0.3px;
}
.ess-panel-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 10px 12px;
    scrollbar-width: thin;
    scrollbar-color: #c8d9e6 transparent;
}
.ess-panel-body::-webkit-scrollbar { width: 4px; }
.ess-panel-body::-webkit-scrollbar-thumb { background:#c8d9e6; border-radius:2px; }

.ess-view-all-link {
    font-size: 11.5px;
    font-weight: 700;
    color: #628db6;
    cursor: pointer;
}
.ess-view-all-link:hover { text-decoration: underline; }

.ess-view-all-btn {
    display: none;
    width: 100%;
    margin-top: 6px;
    padding: 7px;
    border: 1px dashed #c8d9e6;
    border-radius: 4px;
    background: #f8fbfd;
    color: #628db6;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
}
.ess-view-all-btn:hover { background: #eef5fb; }

/* ── Latest Members items ────────────────────────────────────── */
.ess-member-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #eef3f8;
}
.ess-member-item:last-child { border-bottom: none; }
.ess-member-item img {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-member-name  { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-member-role  { font-size: 11px; color: #5a7088; }
.ess-member-date  { font-size: 10.5px; color: #8da0b3; margin-top: 1px; }

.ess-empty-state {
    text-align: center;
    padding: 30px 16px;
    color: #8da0b3;
}
.ess-empty-state i { font-size: 36px; color: #c8d9e6; display: block; margin-bottom: 8px; }
.ess-empty-state p { font-size: 12.5px; margin: 0; }

/* ── Tabs (Birthday / Anniversary Today·Week·Month) — underline
   style, matching the reference instead of the earlier filled
   pill-tab look. ──────────────────────────────────────────────── */
.ess-tab-nav {
    display: flex;
    background: #f9fbfd;
    border-bottom: 2px solid #e8f0f8;
    flex-shrink: 0;
}
.ess-tab-btn {
    flex: 1 1 0;
    border: none;
    background: none;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    padding: 8px 4px;
    margin-bottom: -2px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.16s, border-color 0.16s;
    white-space: nowrap;
    font-family: inherit;
}
.ess-tab-btn:hover { color: #628db6; }
.ess-tab-btn.active { color: #628db6; font-weight: 600; border-bottom-color: #628db6; }
.ess-tab-pane { display: none; }
.ess-tab-pane.active { display: block; }
.ess-tab-count { font-weight: inherit; margin-left: 1px; }

/* ── Birthday / Anniversary card ────────────────────────────── */
.ess-bday-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e4edf4;
    border-left: 3px solid #2d7ab5;
    margin-bottom: 7px;
    transition: box-shadow 0.16s, border-color 0.16s;
    position: relative;
}
.ess-bday-card:hover {
    box-shadow: 0 3px 10px rgba(45,122,181,.12);
    border-left-color: #1e3a5f;
}
.ess-bday-card img {
    width: 40px; height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-bday-text   { flex: 1; min-width: 0; padding-right: 56px; }
.ess-bday-name   { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-bday-info   { font-size: 11px; color: #5a7088; }
.ess-bday-date   {
    position: absolute; top: 8px; right: 8px;
    font-size: 10px; color: #8da0b3;
    display: flex; align-items: center; gap: 3px;
    background: #fff;
}

/* Happy-birthday footer banner — shown only when today's list is
   non-empty (no fabricated "always on" celebration state). */
.ess-happy-banner {
    display: none;
    margin: 8px 12px 12px;
    padding: 8px;
    text-align: center;
    background: #fdeef2;
    border: 1px solid #f7c9d6;
    border-radius: 8px;
    color: #c2255c;
    font-weight: 700;
    font-size: 12px;
    flex-shrink: 0;
}
.ess-happy-banner.show { display: block; }

/* ── Holiday card ────────────────────────────────────────────── */
.ess-holiday-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #f8fafb;
    border: 1px solid #e4edf4;
    margin-bottom: 7px;
    transition: background 0.15s;
}
.ess-holiday-card:hover { background: #eef5fb; }
.ess-holiday-date-box {
    text-align: center;
    min-width: 42px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,.18);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}
.ess-holiday-month {
    font-size: 9.5px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    background: #E23A3A;
    padding: 2px 6px;
}
.ess-holiday-day {
    font-size: 17px;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.3;
    background: #fff;
    padding: 1px 6px 3px;
}
.ess-holiday-name    { font-size: 12.5px; font-weight: 600; color: #1e3a5f; }
.ess-holiday-weekday { font-size: 10.5px; color: #8da0b3; margin-top: 1px; }

/* ── Section toggle (Organization Policy accordion) ───────────── */
.ess-section-toggle {
    padding: 9px 14px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid #e4edf4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f4f7fa;
    transition: background 0.15s;
    flex-shrink: 0;
}
.ess-section-toggle:hover { background: #eef5fb; }
.ess-section-toggle-title {
    font-size: 12px;
    font-weight: 700;
    color: #1e3a5f;
    display: flex;
    align-items: center;
    gap: 7px;
}
.ess-section-toggle-title i { color: #2d7ab5; font-size: 14px; }
.ess-section-toggle-arrow { color: #2d7ab5; font-size: 13px; transition: transform 0.2s; }
.ess-section-toggle.collapsed .ess-section-toggle-arrow { transform: rotate(-90deg); }

/* ── Policy item ─────────────────────────────────────────────── */
.ess-policy-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 0;
    border-bottom: 1px solid #eef3f8;
    cursor: pointer;
}
.ess-policy-item:last-child { border-bottom: none; }
.ess-policy-item:hover .ess-policy-name { color: #2d7ab5; }
.ess-policy-icon { font-size: 18px; color: #c0392b; flex-shrink: 0; }
.ess-policy-name { font-size: 12px; font-weight: 500; color: #1e3a5f; transition: color 0.15s; }

/* ── News & Announcements feed ────────────────────────────────── */
.ess-news-item {
    padding: 10px 0;
    border-bottom: 1px solid #eef3f8;
}
.ess-news-item:last-child { border-bottom: none; }
.ess-news-item-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.ess-news-tag {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.4px;
    padding: 2px 8px;
    border-radius: 10px;
    text-transform: uppercase;
}
.ess-news-tag-new    { background: #d4f0e3; color: #166534; }
.ess-news-tag-update { background: #ddeef8; color: #1168a0; }
.ess-news-tag-info   { background: #f3e8ff; color: #7c3aed; }
.ess-news-item-date { font-size: 10.5px; color: #8da0b3; }
.ess-news-item-title { font-size: 13px; font-weight: 700; color: #1e3a5f; margin-bottom: 3px; }
.ess-news-item-desc { font-size: 12px; color: #5a7088; line-height: 1.45; }

/* ── Recent Activity feed ─────────────────────────────────────── */
.ess-activity-item { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid #eef3f8; }
.ess-activity-item:last-child { border-bottom: none; }
.ess-activity-icon {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 14px;
}
.ess-activity-icon.act-leave { background: #ddeef8; color: #1168a0; }
.ess-activity-icon.act-attendanceregularization { background: #fff3cd; color: #92610e; }
.ess-activity-icon.act-compoff { background: #f3e8ff; color: #7c3aed; }
.ess-activity-icon.act-exit { background: #fde2e2; color: #b91c1c; }
.ess-activity-icon.act-punch { background: #d4f0e3; color: #166534; }
.ess-activity-body { flex: 1; min-width: 0; }
.ess-activity-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.ess-activity-title { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-activity-date { font-size: 10.5px; color: #8da0b3; white-space: nowrap; flex-shrink: 0; }
.ess-activity-desc { font-size: 11.5px; color: #5a7088; line-height: 1.4; margin-top: 2px; }
.ess-activity-meta { display: flex; align-items: center; gap: 6px; margin-top: 5px; }
.ess-activity-pill { font-size: 9.5px; font-weight: 800; letter-spacing: 0.3px; padding: 2px 7px; border-radius: 10px; text-transform: uppercase; }
.ess-activity-pill-approved { background: #d4f0e3; color: #166534; }
.ess-activity-pill-rejected { background: #fde2e2; color: #b91c1c; }
.ess-activity-pill-pending  { background: #fff3cd; color: #92610e; }
.ess-activity-pill-recorded { background: #ddeef8; color: #1168a0; }
.ess-activity-pill-proceedtohrd { background: #f3e8ff; color: #7c3aed; }
.ess-activity-role { font-size: 10px; color: #628db6; font-weight: 700; }

/* ── Quick Actions grid ────────────────────────────────────────
   6 items, 2 columns × 3 rows, each tile a fixed-height card so zoom
   in/out can't stretch/shrink rows or leave the last row uneven —
   min-height/max-height/height are all pinned to the same value on
   purpose, not just a single `height`. 70px (down from 110px) is sized
   so all 3 rows fit inside the card's 295px height without the card
   needing its own scrollbar. */
.ess-qa-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}
.ess-qa-tile {
    height: 85px;
    min-height: 85px;
    max-height: 85px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
    padding: 6px 8px;
    background: #fff;
    border: 1px solid #e4edf4;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    cursor: pointer;
    transition: box-shadow 0.15s, transform 0.15s;
}
.ess-qa-tile:hover {
    box-shadow: 0 4px 10px rgba(45,122,181,.15);
    transform: translateY(-2px);
}
.ess-qa-icon { font-size: 18px; color: #628db6; transition: color 0.15s; }
.ess-qa-tile:hover .ess-qa-icon { color: #3e6a8c; }
.ess-qa-label { font-size: 11px; font-weight: 600; color: #334e6a; }
.ess-qa-sub { font-size: 9px; color: #8da0b3; }

@@media (max-width: 992px) {
    .ess-qa-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
@@media (max-width: 576px) {
    .ess-qa-grid { grid-template-columns: repeat(1, 1fr); gap: 8px; }
}

/* ── Honest "coming soon" placeholder — used for Recent Activity
   and Attendance Overview, which have no backend yet. ───────────── */
.ess-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: #9aa7b4;
    padding: 20px;
}
.ess-coming-soon i { font-size: 34px; color: #c8d9e6; margin-bottom: 10px; }
.ess-coming-soon p { font-size: 12.5px; margin: 0 0 4px; font-weight: 700; color: #5a7088; }
.ess-coming-soon span { font-size: 11px; }

/* ── Attendance Overview bars ──────────────────────────────────── */
.ess-attn-row { margin-bottom: 12px; }
.ess-attn-row:last-child { margin-bottom: 0; }
.ess-attn-row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}
.ess-attn-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #334e6a;
}
.ess-attn-label i { font-size: 14px; }
.ess-attn-count { font-size: 11.5px; font-weight: 700; color: #5a7088; }
.ess-attn-bar-track {
    height: 7px;
    border-radius: 4px;
    background: #eef1f5;
    overflow: hidden;
}
.ess-attn-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s ease;
}

/* ── Card heights fill their row ───────────────────────────────
   Reverted to fixed pixel heights (see the comment on .ess-dash-grid
   above for why the fill-the-screen version was rolled back). All 8
   non-hero cards (both rows) share the SAME height, 295px, so every
   card lines up evenly both across its own row and against the other
   row. At 295px the Quick Actions 2×3 grid (70px tiles) fits with no
   scroll needed; New Joiners/Birthdays-style lists that run longer
   than the card still rely on .ess-panel-body's own internal scroll,
   same as always. (Quick Actions itself switches to a 3×2 grid at the
   shorter tiers below instead of relying on that scroll — see why in
   the comment just below.) */
.ess-panel-mid, .ess-panel-fill { height: 350px; }

/* ── Short-viewport (laptop) tiers ───────────────────────────────
   .main-area's usable height is `100vh - 106px topbar - 38px footer
   clearance` (app-shell.css) — it shrinks 1:1 with the browser window,
   but every size above was tuned against a full-height desktop
   monitor, so on a 1366×768 / 1440×900 laptop (often ~630-770px of
   *usable* height once browser chrome is subtracted) the fixed hero
   row + two 295px rows no longer fit and .main-area scrolls, with
   .ess-panel-body's own internal scrollbar making it look doubly
   broken. These tiers key off viewport HEIGHT (not width — width-based
   breakpoints above are unrelated and still control column count) and
   scale the same properties down together so the two dash-grid rows
   stay pixel-equal at every tier, exactly like the 295px rule above. */
/* Quick Actions is a fixed 6-tile grid (not a scrollable list like New
   Joiners/Birthdays) — all 6 must stay visible without the card needing
   its own scrollbar. The base 2-col × 3-row layout (tile height 70px)
   only has room for that because the desktop 295px card height allows
   it; at the shorter tiered card heights below there isn't enough
   vertical room left for 3 rows even at a tiny tile size, so each tier
   also switches the grid to 3 columns × 2 rows (half the row count)
   and sizes the tile/gap to exactly what's left after the header
   (~30px) and body padding (~20px): tile = (cardHeight - 50 - gap) / 2. */
@@media (max-height: 930px) {
    .ess-hero-card { min-height: 40px; padding: 7px 10px; }
    .ess-hero-grid { gap: 16px; }
    .ess-dash-grid { gap: 16px; margin-top: 20px; }
    .ess-panel-mid, .ess-panel-fill { height: 270px; }
    .ess-qa-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .ess-qa-tile { height: 100px; min-height: 100px; max-height: 100px; }
}
@@media (max-height: 820px) {
    .ess-hero-card { min-height: 34px; padding: 6px 10px; }
    .ess-hero-grid { gap: 12px; }
    .ess-dash-grid { gap: 12px; margin-top: 16px; }
    .ess-panel-mid, .ess-panel-fill { height: 230px; }
    .ess-qa-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .ess-qa-tile { height: 90px; min-height: 90px; max-height: 90px; }
}
@@media (max-height: 700px) {
    .ess-hero-card { min-height: 30px; padding: 5px 8px; }
    .ess-hero-card .hc-desc { display: none; }
    .ess-hero-grid { gap: 8px; }
    .ess-dash-grid { gap: 8px; margin-top: 10px; }
    .ess-panel-mid, .ess-panel-fill { height: 195px; }
    .ess-qa-grid { grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .ess-qa-tile { height: 64px; min-height: 64px; max-height: 64px; padding: 4px 6px; }
    .ess-qa-sub { display: none; }
