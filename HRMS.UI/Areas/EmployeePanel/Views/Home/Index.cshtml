/* ── News & Announcements feed ────────────────────────────────
   Uses the existing CRUD-backed GetNewsAnnouncement/{CompanyId} list
   endpoint (create/edit/delete already live under Admin ▸ Job Master
   ▸ News Announcement) — only client-side filtering (visible + within
   date range) and a NEW/UPDATE/INFO tag (derived from how recently it
   was created — there's no separate "type" field on the backend) are
   new here; no backend changes needed. */
var allNewsItems = [];
var newsExpanded = false;
var NEWS_PREVIEW_COUNT = 4;
var newsCheckInterval = null;

function loadNewsFeed() {
    $.ajax({
        url: apiBase + '/NewsAnnouncementAPI/GetNewsAnnouncement/' + Compid,
        type: 'GET',
        success: function(resp) {
            var items = Array.isArray(resp.data) ? resp.data : [];
            var now = new Date();
            allNewsItems = items.filter(function(n) {
                if (n.isVisible === false) return false;
                var start = n.startDate ? new Date(n.startDate) : null;
                // EndDate comes in as a bare date (midnight) from the Admin form's
                // date picker, so a same-day announcement (StartDate == EndDate)
                // must be treated as valid through the END of that day — not its
                // literal 00:00:00 timestamp, which would expire it the instant
                // the clock passes midnight.
                var end = n.endDate ? new Date(n.endDate) : null;
                if (end) { end.setHours(23, 59, 59, 999); }
                if (start && now < start) return false;
                if (end && now > end) return false;
                return true;
            }).sort(function(a, b) { return new Date(b.createdDate) - new Date(a.createdDate); });

            renderNewsFeed();
            handleAnnouncementPopups(allNewsItems);
            handleLoginNotifications(allNewsItems);
        },
        error: function() {
            $('#newsFeedList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load announcements.</p></div>');
        }
    });
}

/* ── Shared "have we shown this already" helper for the popup/login-
   notification handlers below. Each announcement's IsPopShowOnce /
   IsLoginNotificationShowOnce (set on the Admin form) picks one of two
   sessionStorage key shapes:
     - show-once  : keyed by NewsID alone — fires the first time this
       browser tab sees the item, never again this tab (matches the
       "once" radio option on the Admin form).
     - show-every-login : keyed by NewsID + the current LoginHistoryID
       (decoded from the authToken JWT, unique per login event) — fires
       once per *login*, so logging out and back in shows it again even
       within the same tab, but a plain refresh/5-min poll doesn't. ── */
function getCurrentLoginId() {
    try {
        var token = localStorage.getItem('authToken');
        if (!token || typeof jwt_decode !== 'function') return '';
        var decoded = jwt_decode(token);
        return String(decoded.LoginHistoryID || decoded.jti || '');
    } catch (e) { return ''; }
}
function essShownKey(prefix, newsID, showOnce) {
    return showOnce === false ? (prefix + newsID + '_login_' + getCurrentLoginId()) : (prefix + newsID);
}

/* ── Announcement popup — NewsAnnouncement.IsPop items shown as a modal,
   using each announcement's own PopupDurationSeconds / IsPopShowOnce
   (set on the Admin form) instead of a hardcoded interval/frequency.
   Multiple pending popups are queued and shown one after another. ── */
var essPopupQueue = [];
var essPopupAutoCloseTimer = null;
function handleAnnouncementPopups(items) {
    var pending = items.filter(function(n) {
        return n.isPop === true && !sessionStorage.getItem(essShownKey('essPopupShown_', n.newsID, n.isPopShowOnce));
    });
    if (!pending.length) return;
    essPopupQueue = essPopupQueue.concat(pending);
    if (essPopupQueue.length === pending.length) showNextAnnouncementPopup();
}
function showNextAnnouncementPopup() {
    if (essPopupAutoCloseTimer) { clearTimeout(essPopupAutoCloseTimer); essPopupAutoCloseTimer = null; }
    if (!essPopupQueue.length) return;
    var n = essPopupQueue.shift();
    sessionStorage.setItem(essShownKey('essPopupShown_', n.newsID, n.isPopShowOnce), '1');
    $('#essAnnouncementPopupTitle').text(n.newsTitle || 'Announcement');
    $('#essAnnouncementPopupBody').text(n.newsDescription || '');
    var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('essAnnouncementPopupModal'));
    modal.show();
    var durationMs = (n.popupDurationSeconds || 20) * 1000;
    essPopupAutoCloseTimer = setTimeout(function() { modal.hide(); }, durationMs);
}
$('#essAnnouncementPopupModal').on('hidden.bs.modal', function() {
    if (essPopupAutoCloseTimer) { clearTimeout(essPopupAutoCloseTimer); essPopupAutoCloseTimer = null; }
    showNextAnnouncementPopup();
});

/* ── Login notification — NewsAnnouncement.IsLoginNotification items
   shown as a toast, using each announcement's own
   LoginNotificationDurationSeconds / IsLoginNotificationShowOnce. ── */
function handleLoginNotifications(items) {
    var notifs = items.filter(function(n) {
        return n.isLoginNotification === true &&
            !sessionStorage.getItem(essShownKey('essLoginNotifShown_', n.newsID, n.isLoginNotificationShowOnce));
    });
    if (!notifs.length) return;
    var cumulativeMs = 0;
    notifs.forEach(function(n) {
        sessionStorage.setItem(essShownKey('essLoginNotifShown_', n.newsID, n.isLoginNotificationShowOnce), '1');
        var durationMs = (n.loginNotificationDurationSeconds || 20) * 1000;
        var delay = cumulativeMs;
        cumulativeMs += durationMs + 500;
        setTimeout(function() {
            showToast(n.newsTitle || n.newsDescription || 'New announcement', 'info', durationMs);
        }, delay);
    });
}
function renderNewsFeed() {
    $('#newsCount').text(allNewsItems.length);
    if (!allNewsItems.length) {
        $('#newsFeedList').html('<div class="ess-empty-state"><i class="bx bx-bell-off"></i><p>No announcements right now.</p></div>');
        $('#newsViewAllBtn').hide();
        return;
    }
    var visible = newsExpanded ? allNewsItems : allNewsItems.slice(0, NEWS_PREVIEW_COUNT);
    var now = new Date();
    var html = '';
    visible.forEach(function(n) {
        var created = n.createdDate ? new Date(n.createdDate) : null;
        var hasCreated = created && !isNaN(created);
        var ageDays = hasCreated ? (now - created) / (24 * 60 * 60 * 1000) : Infinity;
        var tag, tagClass;
        if (ageDays < 3) { tag = 'NEW'; tagClass = 'ess-news-tag-new'; }
        else if (ageDays < 10) { tag = 'UPDATE'; tagClass = 'ess-news-tag-update'; }
        else { tag = 'INFO'; tagClass = 'ess-news-tag-info'; }
        var dateStr = hasCreated ? formatDDMMM(n.createdDate) : '';
        html += '<div class="ess-news-item">' +
            '<div class="ess-news-item-top">' +
                '<span class="ess-news-tag ' + tagClass + '">' + tag + '</span>' +
                '<span class="ess-news-item-date">' + dateStr + '</span>' +
            '</div>' +
            '<div class="ess-news-item-title">' + (n.newsTitle || '') + '</div>' +
            '<div class="ess-news-item-desc">' + (n.newsDescription || '') + '</div>' +
            '</div>';
    });
    $('#newsFeedList').html(html);

    if (allNewsItems.length > NEWS_PREVIEW_COUNT) {
        $('#newsViewAllBtn').show().text(newsExpanded ? 'Show Less' : 'View All (' + allNewsItems.length + ')');
    } else {
        $('#newsViewAllBtn').hide();
    }
}
function toggleNewsExpand() {
    newsExpanded = !newsExpanded;
    renderNewsFeed();
}
function startNewsCheck() {
    loadNewsFeed();
    newsCheckInterval = setInterval(loadNewsFeed, 300000);
}

/* ── Recent Activity feed ─────────────────────────────────────────
   Own submissions + approver actions across Leave, Attendance
   Regularization, Comp-Off, Exit Application and attendance punches
   (last 30 days, top 20) — served by EmployeeDashBoardAPI/GetRecentActivity,
   backed by sp_GetRecentActivity. ── */
var ACTIVITY_ICONS = {
    Leave: 'bx-calendar-x',
    AttendanceRegularization: 'bx-time',
    CompOff: 'bx-calendar-plus',
    Exit: 'bx-log-out',
    Punch: 'bx-fingerprint'
};
function loadRecentActivity() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetRecentActivity?EmployeeId=' + Empid + '&Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            renderRecentActivity(Array.isArray(resp.data) ? resp.data : []);
        },
        error: function() {
            $('#activityList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load activity.</p></div>');
        }
    });
}
function renderRecentActivity(items) {
    $('#activityCount').text(items.length);
    if (!items.length) {
        $('#activityList').html('<div class="ess-empty-state"><i class="bx bx-time-five"></i><p>No recent activity.</p></div>');
        return;
    }
    var html = items.map(function(a) {
        var iconClass = ACTIVITY_ICONS[a.activityType] || 'bx-info-circle';
        var iconColorClass = 'act-' + (a.activityType || '').toLowerCase();
        var statusClass = 'ess-activity-pill-' + (a.status || 'Pending').toLowerCase().replace(/\s+/g, '');
        var dateStr = a.activityDate ? (formatDDMMM(a.activityDate) + ', ' + formatTimeHHMM(a.activityDate)) : '';
        var title = a.title || '';
        if (a.role === 'Approver' && a.relatedEmployeeName) { title += ' — ' + a.relatedEmployeeName; }
        return '<div class="ess-activity-item">' +
            '<div class="ess-activity-icon ' + iconColorClass + '"><i class="bx ' + iconClass + '"></i></div>' +
            '<div class="ess-activity-body">' +
                '<div class="ess-activity-top">' +
                    '<span class="ess-activity-title">' + title + '</span>' +
                    '<span class="ess-activity-date">' + dateStr + '</span>' +
                '</div>' +
                (a.description ? '<div class="ess-activity-desc">' + a.description + '</div>' : '') +
                '<div class="ess-activity-meta">' +
                    '<span class="ess-activity-pill ' + statusClass + '">' + (a.status || 'Pending') + '</span>' +
                    (a.role === 'Approver' ? '<span class="ess-activity-role">as approver</span>' : '') +
                '</div>' +
            '</div>' +
        '</div>';
    }).join('');
    $('#activityList').html(html);
}

