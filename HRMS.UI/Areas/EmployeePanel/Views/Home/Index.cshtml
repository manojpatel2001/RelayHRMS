                    html = '<p class="card-text">No new members found.</p>';
                } else {
                    const count = members.length;
                    const text = count === 1 ? "1 new employee" : `${count} new employees`;
                    $("#totalMemberCount").text(text);

                    html += '<ul class="list-group">';
                    members.forEach(member => {
                        const imageUrl = member.employeeProfileUrl || `${baseDomain}/default-image/avatar-2.png`;
