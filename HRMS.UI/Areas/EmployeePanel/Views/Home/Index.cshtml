@{
    ViewData["Title"] = "ESS Dashboard";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<style>
/* ════════════════════════════════════════════════════════════════
   ESS DASHBOARD  —  WMS steel-blue theme
   ════════════════════════════════════════════════════════════════ */

/* ── Hero action cards ───────────────────────────────────────── */
.ess-hero-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 18px;
}
.ess-hero-card {
    position: relative;
    border-radius: 10px;
    padding: 18px 20px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: none;
    box-shadow: 0 4px 16px rgba(0,0,0,.12);
    min-height: 108px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.ess-hero-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0,0,0,.18);
}
.ess-hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.04);
    pointer-events: none;
    transition: background 0.2s;
}
.ess-hero-card:hover::after { background: rgba(255,255,255,.09); }

.ess-hero-card .hc-bg-icon {
    position: absolute;
    right: -8px;
    bottom: -8px;
    font-size: 80px;
    opacity: 0.12;
    line-height: 1;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
}
.ess-hero-card:hover .hc-bg-icon { opacity: 0.20; transform: scale(1.06); }

.ess-hero-card .hc-title {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 5px;
    letter-spacing: 0.15px;
}
.ess-hero-card .hc-desc {
    font-size: 11.5px;
    color: rgba(255,255,255,.80);
    margin: 0;
    line-height: 1.45;
}
.ess-hero-card .hc-badge {
    display: inline-block;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.30);
    border-radius: 20px;
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
    padding: 2px 9px;
    margin-top: 8px;
    width: fit-content;
}

/* Card color variants */
.ess-hc-1 { background: linear-gradient(135deg, #1e3a5f 0%, #3e6a8c 100%); }
.ess-hc-2 { background: linear-gradient(135deg, #2d5a8a 0%, #2d7ab5 100%); }
.ess-hc-3 { background: linear-gradient(135deg, #1a5a7a 0%, #0e7490 100%); }
.ess-hc-4 { background: linear-gradient(135deg, #1e4060 0%, #2d5a80 100%); }

/* ── Panel / Section card ────────────────────────────────────── */
.ess-panel {
    background: #fff;
    border-radius: 10px;
    border: 1px solid #d0dce8;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.ess-panel-hdr {
    padding: 10px 14px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.55px;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #1e3a5f 0%, #3e6a8c 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.ess-panel-hdr i { font-size: 14px; opacity: .85; }
.ess-panel-hdr-badge {
    background: rgba(255,255,255,.20);
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 7px;
    color: #fff;
    border: 1px solid rgba(255,255,255,.30);
}
.ess-panel-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 10px 12px;
    scrollbar-width: thin;
    scrollbar-color: #c8d9e6 transparent;
}
.ess-panel-body::-webkit-scrollbar { width: 4px; }
.ess-panel-body::-webkit-scrollbar-thumb { background:#c8d9e6; border-radius:2px; }

/* ── News announcement banner ────────────────────────────────── */
#newsAnnouncementContainer {
    margin-bottom: 14px;
}
.ess-news-banner {
    background: linear-gradient(135deg, #eef5fb 0%, #ddeef8 100%);
    border: 1px solid #a8c9e0;
    border-left: 4px solid #2d7ab5;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    animation: ess-fade-in 0.4s ease;
}
@keyframes ess-fade-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
}
.ess-news-icon {
    width: 38px; height: 38px;
    background: linear-gradient(135deg, #3e6a8c, #2d7ab5);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.ess-news-icon i { color: #fff; font-size: 18px; }
.ess-news-content { flex: 1; min-width: 0; }
.ess-news-title { font-size: 13px; font-weight: 700; color: #1e3a5f; margin-bottom: 2px; }
.ess-news-desc  { font-size: 12.5px; color: #3e6a8c; line-height: 1.4; }
.ess-news-close {
    background: none; border: none; color: #3e6a8c;
    font-size: 20px; cursor: pointer; padding: 2px 6px; line-height: 1;
    border-radius: 50%; transition: background 0.15s;
    flex-shrink: 0;
}
.ess-news-close:hover { background: rgba(45,122,181,.12); }

/* ── Latest Members items ────────────────────────────────────── */
.ess-member-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #eef3f8;
}
.ess-member-item:last-child { border-bottom: none; }
.ess-member-item img {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-member-name  { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-member-role  { font-size: 11px; color: #5a7088; }
.ess-member-date  { font-size: 10.5px; color: #8da0b3; margin-top: 1px; }

.ess-empty-state {
    text-align: center;
    padding: 30px 16px;
    color: #8da0b3;
}
.ess-empty-state i { font-size: 36px; color: #c8d9e6; display: block; margin-bottom: 8px; }
.ess-empty-state p { font-size: 12.5px; margin: 0; }

/* ── Wishes/Birthday tabs ─────────────────────────────────────── */
.ess-tab-nav {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    border-bottom: 1px solid #e4edf4;
    background: #f4f7fa;
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;
}
.ess-tab-nav::-webkit-scrollbar { display: none; }
.ess-tab-btn {
    border: none;
    background: none;
    color: #5a7088;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.16s, color 0.16s;
    white-space: nowrap;
    font-family: inherit;
}
.ess-tab-btn:hover { background: #dde9f4; color: #2d7ab5; }
.ess-tab-btn.active {
    background: linear-gradient(135deg, #3e6a8c, #2d7ab5);
    color: #fff;
}
.ess-tab-pane { display: none; }
.ess-tab-pane.active { display: block; }

/* ── Date group header ───────────────────────────────────────── */
.ess-date-group {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    background: linear-gradient(135deg, #3e6a8c, #2d7ab5);
    color: #fff;
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    margin: 8px 0 6px;
}
.ess-date-group.today {
    background: linear-gradient(135deg, #1e3a5f, #3e6a8c);
}

/* ── Birthday / Anniversary card ────────────────────────────── */
.ess-bday-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e4edf4;
    border-left: 3px solid #2d7ab5;
    margin-bottom: 7px;
    transition: box-shadow 0.16s, border-color 0.16s;
    position: relative;
}
.ess-bday-card:hover {
    box-shadow: 0 3px 10px rgba(45,122,181,.12);
    border-left-color: #1e3a5f;
}
.ess-bday-card img {
    width: 40px; height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-bday-name   { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-bday-info   { font-size: 11px; color: #5a7088; }
.ess-bday-date   {
    position: absolute; top: 8px; right: 8px;
    font-size: 10px; color: #8da0b3;
    display: flex; align-items: center; gap: 3px;
}

/* ── Holiday card ────────────────────────────────────────────── */
.ess-holiday-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #f4f7fa;
    border: 1px solid #e4edf4;
    margin-bottom: 7px;
    transition: background 0.15s;
}
.ess-holiday-card:hover { background: #eef5fb; }
.ess-holiday-date-box {
    text-align: center;
    min-width: 42px;
    background: linear-gradient(135deg, #1e3a5f, #2d7ab5);
    border-radius: 7px;
    padding: 4px 6px;
    flex-shrink: 0;
}
.ess-holiday-month { font-size: 9.5px; font-weight: 700; color: rgba(255,255,255,.80); text-transform: uppercase; }
.ess-holiday-day   { font-size: 17px; font-weight: 800; color: #fff; line-height: 1.1; }
.ess-holiday-name  { font-size: 12.5px; font-weight: 600; color: #1e3a5f; }

/* ── Right panel section toggle ─────────────────────────────── */
.ess-section-toggle {
    padding: 9px 14px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid #e4edf4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f4f7fa;
    transition: background 0.15s;
    flex-shrink: 0;
}
.ess-section-toggle:hover { background: #eef5fb; }
.ess-section-toggle-title {
    font-size: 12px;
    font-weight: 700;
    color: #1e3a5f;
    display: flex;
    align-items: center;
    gap: 7px;
}
.ess-section-toggle-title i { color: #2d7ab5; font-size: 14px; }
.ess-section-toggle-arrow { color: #2d7ab5; font-size: 13px; transition: transform 0.2s; }
.ess-section-toggle.collapsed .ess-section-toggle-arrow { transform: rotate(-90deg); }

/* ── Policy item ─────────────────────────────────────────────── */
.ess-policy-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 0;
    border-bottom: 1px solid #eef3f8;
    cursor: pointer;
}
.ess-policy-item:last-child { border-bottom: none; }
.ess-policy-item:hover .ess-policy-name { color: #2d7ab5; }
.ess-policy-icon { font-size: 18px; color: #c0392b; flex-shrink: 0; }
.ess-policy-name { font-size: 12px; font-weight: 500; color: #1e3a5f; transition: color 0.15s; }

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 1200px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
@media (max-width: 576px) {
    .ess-hero-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .ess-hero-card { min-height: 90px; padding: 14px; }
    .ess-hero-card .hc-bg-icon { font-size: 56px; }
}

/* Override the global nav-tabs orange from the original file */
.nav-tabs .nav-link.active { color: #2d7ab5 !important; border-bottom-color: #2d7ab5 !important; }
.nav-tabs .nav-link:hover  { color: #2d7ab5 !important; }

/* Override scrollbar orange */
::-webkit-scrollbar-thumb { background: #c8d9e6 !important; }
::-webkit-scrollbar-thumb:hover { background: #2d7ab5 !important; }
</style>

<!-- ══ NEWS ANNOUNCEMENT BANNER ══ -->
<div id="newsAnnouncementContainer" style="display:none;">
    <div class="ess-news-banner">
        <div class="ess-news-icon"><i class="bx bxs-megaphone"></i></div>
        <div class="ess-news-content">
            <div class="ess-news-title" id="newsTitle">News Announcement</div>
            <div class="ess-news-desc"  id="newsDescription"></div>
        </div>
        <button class="ess-news-close" onclick="closeNewsAnnouncement()" aria-label="Close">×</button>
    </div>
</div>

<!-- ══ HERO ACTION CARDS ══ -->
<div class="ess-hero-grid">

    <div class="ess-hero-card ess-hc-1" id="employeeid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bxs-group" style="margin-right:6px;opacity:.9"></i>Employee &amp; Team</p>
            <p class="hc-desc">Explore your team's direct &amp; indirect reporting structure.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bxs-group"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-2" id="attendanceleaveid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-history" style="margin-right:6px;opacity:.9"></i>Attendance &amp; Leave</p>
            <p class="hc-desc">Daily or monthly attendance details &amp; leave records.</p>
        </div>
        <div class="hc-badge" id="inTimeDisplay">In Time: <span id="inTime">—</span></div>
        <div class="hc-bg-icon"><i class="bx bx-calendar-check"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-3" id="salaryid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-rupee" style="margin-right:6px;opacity:.9"></i>Salary</p>
            <p class="hc-desc">View your processed &amp; published salary details.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bx-money"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-4" id="reportid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-line-chart" style="margin-right:6px;opacity:.9"></i>Reports</p>
            <p class="hc-desc">Access attendance, leave, and salary reports.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bx-bar-chart-alt-2"></i></div>
    </div>

</div>

<!-- ══ LOWER THREE-COLUMN SECTION ══ -->
<div class="row g-3" style="min-height:0;">

    <!-- LEFT — Latest Members -->
    <div class="col-lg-3 col-md-4">
        <div class="ess-panel" style="height:460px;">
            <div class="ess-panel-hdr">
                <span><i class="bx bx-user-plus" style="margin-right:6px;"></i>Latest Members</span>
                <span class="ess-panel-hdr-badge" id="totalMemberCount">0</span>
            </div>
            <div style="padding:6px 12px;font-size:11px;font-weight:700;color:#3e6a8c;background:#eef5fb;border-bottom:1px solid #d0dce8;flex-shrink:0;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;" id="companyNameDisplay"></div>
            <div class="ess-panel-body" id="latestMembersContent">
                <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading members…</p></div>
            </div>
        </div>
    </div>

    <!-- CENTER — Birthday / Anniversary / Work Anniversary Tabs -->
    <div class="col-lg-6 col-md-8">
        <div class="ess-panel" style="height:460px;">
            <div class="ess-panel-hdr">
                <span><i class="bx bx-gift" style="margin-right:6px;"></i>Celebrations</span>
            </div>
            <div class="ess-tab-nav" id="celebrationTabNav">
                <button class="ess-tab-btn active" data-target="birthdayPane" onclick="switchEssTab(this,'birthdayPane'); loadBirthday();">
                    🎂 Birthday
                </button>
                <button class="ess-tab-btn" data-target="workAnnPane" onclick="switchEssTab(this,'workAnnPane'); loadworkanniversary();">
                    🏢 Work Anniversary
                </button>
                <button class="ess-tab-btn" data-target="marriageAnnPane" onclick="switchEssTab(this,'marriageAnnPane'); loadanniversary();">
                    💍 Marriage Anniversary
                </button>
            </div>
            <div class="ess-panel-body">
                <div class="ess-tab-pane active" id="birthdayPane">
                    <div id="groupedBirthdayList">
                        <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading birthdays…</p></div>
                    </div>
                </div>
                <div class="ess-tab-pane" id="workAnnPane">
                    <div id="workAnniversaryList">
                        <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading anniversaries…</p></div>
                    </div>
                </div>
                <div class="ess-tab-pane" id="marriageAnnPane">
                    <div id="marriageAnniversaryList">
                        <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading anniversaries…</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT — Upcoming Holidays + Org Policy -->
    <div class="col-lg-3 col-md-12">
        <div class="ess-panel" style="height:460px;">
            <div class="ess-panel-hdr">
                <span><i class="bx bx-calendar-event" style="margin-right:6px;"></i>Info</span>
            </div>

            <!-- Holidays section toggle -->
            <div class="ess-section-toggle" id="holidayToggle" onclick="toggleEssSection('holidayToggle','holidayBody')">
                <span class="ess-section-toggle-title"><i class="bx bx-sun"></i>Upcoming Holidays</span>
                <i class="bx bx-chevron-down ess-section-toggle-arrow"></i>
            </div>
            <div class="ess-panel-body" id="holidayBody" style="max-height:180px;flex:none;">
                <div id="upcomingHolidayList">
                    <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading…</p></div>
                </div>
            </div>

            <!-- Org policy section toggle -->
            <div class="ess-section-toggle collapsed" id="policyToggle" onclick="toggleEssSection('policyToggle','policyBody')">
                <span class="ess-section-toggle-title"><i class="bx bx-file"></i>Organization Policy</span>
                <i class="bx bx-chevron-down ess-section-toggle-arrow"></i>
            </div>
            <div class="ess-panel-body" id="policyBody" style="max-height:200px;flex:none;display:none;">
                <div id="organizationPolicyList">
                    <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading…</p></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
/* ── Variables ───────────────────────────────────────────────── */
const apiBase  = '@apiBase';
const baseUrl  = '@baseUrl';
const baseDomain = (function() {
    try { return new URL(apiBase).origin; } catch(e) { return ''; }
})();
const Empid    = parseInt(localStorage.getItem('EmployeeId'));
const savedCompany   = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
const Compid   = parseInt(savedCompany.CompanyId || '0');

/* ── Navigation ─────────────────────────────────────────────── */
document.getElementById('employeeid').onclick      = function() { location.href = baseUrl + '/EmployeePanel/Home/EmployeeandTeam'; };
document.getElementById('attendanceleaveid').onclick = function() { location.href = baseUrl + '/EmployeePanel/Home/Attendanceandleave'; };
document.getElementById('salaryid').onclick        = function() { location.href = baseUrl + '/EmployeePanel/Home/Salary'; };
document.getElementById('reportid').onclick        = function() { location.href = baseUrl + '/EmployeePanel/MyReports/Index'; };

/* ── Tab switching ───────────────────────────────────────────── */
function switchEssTab(btn, paneId) {
    document.querySelectorAll('.ess-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.ess-tab-pane').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    var pane = document.getElementById(paneId);
    if (pane) pane.classList.add('active');
}

/* ── Section toggle (holidays / policy) ─────────────────────── */
function toggleEssSection(toggleId, bodyId) {
    var toggle = document.getElementById(toggleId);
    var body   = document.getElementById(bodyId);
    if (!toggle || !body) return;
    var isCollapsed = toggle.classList.contains('collapsed');
    if (isCollapsed) {
        toggle.classList.remove('collapsed');
        body.style.display = '';
    } else {
        toggle.classList.add('collapsed');
        body.style.display = 'none';
    }
}

/* ── Date helpers ────────────────────────────────────────────── */
function formatDDMMM(dateString) {
    var d = new Date(dateString);
    return String(d.getDate()).padStart(2,'0') + ' ' + d.toLocaleString('en-US', { month:'short' });
}
function formatDDMMYYYY(dateString) {
    var d = new Date(dateString);
    return String(d.getDate()).padStart(2,'0') + '/' +
           String(d.getMonth()+1).padStart(2,'0') + '/' +
           new Date().getFullYear();
}

/* ── Latest Members ──────────────────────────────────────────── */
function loadLatestMembers() {
    document.getElementById('companyNameDisplay').textContent = savedCompany.CompanyName || '';
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetRecentJoinedEmployees?Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            var members = resp.data;
            if (!Array.isArray(members) || members.length === 0) {
                $('#latestMembersContent').html('<div class="ess-empty-state"><i class="bx bx-user"></i><p>No new members found.</p></div>');
                return;
            }
            $('#totalMemberCount').text(members.length + (members.length === 1 ? ' new' : ' new'));
            var html = '';
            members.forEach(function(m) {
                var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
                var joined = m.dateOfJoining ? m.dateOfJoining.split('T')[0].split('-').reverse().join('/') : '';
                html += '<div class="ess-member-item">' +
                    '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
                    '<div><div class="ess-member-name">' + (m.fullName || '') + '</div>' +
                    '<div class="ess-member-role">' + (m.designationName || '') + (m.departmentName ? ' · ' + m.departmentName : '') + '</div>' +
                    '<div class="ess-member-date">Joined: ' + joined + '</div></div>' +
                    '</div>';
            });
            $('#latestMembersContent').html(html);
        },
        error: function() {
