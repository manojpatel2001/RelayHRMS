@{
    ViewData["Title"] = "ESS Dashboard";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<style>
/* ════════════════════════════════════════════════════════════════
   ESS DASHBOARD  —  WMS steel-blue theme
   Card layout/colors restyled to match the reference admin dashboard
   (stage.hrmsui.ethicstechnology.net/Dashboard) — flat white card
   headers, underline tabs, colored quick-action icons — except the 4
   hero cards at the top, which are kept exactly as they were.
   Recent Activity and Attendance Overview have no backend yet (no
   audit log, no attendance-aggregate API), so they render as honest
   "coming soon" placeholders in the right position/style rather than
   fabricated numbers. Add Employee / Shifts / Holidays quick actions
   have no ESS page yet either, so those 3 tiles show a "coming soon"
   notice instead of a broken link.
   ════════════════════════════════════════════════════════════════ */

/* ── Hero action cards (unchanged) ────────────────────────────── */
.ess-hero-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

/* ── Dashboard rows (middle + bottom sections) ────────────────────
   Plain CSS Grid, not Bootstrap's .row/.col-* — Bootstrap's .row class
   carries a built-in `margin-top: calc(-1 * var(--bs-gutter-y))` (with
   .g-3 that's -16px) that fought every margin-based attempt to add a
   clean gap above these rows. A dedicated class with no competing
   framework margin removes that fight — margin-top here is the ONLY
   thing controlling the gap above each row.
   (A later attempt made both rows share leftover viewport height via
   flexbox so the page would never need its own scrollbar — reverted:
   the two rows stopped ending up the same height in practice, which
   silently ate the gap between them. Fixed pixel heights are back
   until that's solved properly.) */
.ess-dash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 32px;
}
@@media (max-width: 1200px) {
    .ess-dash-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 576px) {
    .ess-dash-grid { grid-template-columns: 1fr; }
}
.ess-hero-card {
    position: relative;
    border-radius: 10px;
    padding: 18px 20px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: none;
    box-shadow: 0 4px 16px rgba(0,0,0,.12);
    min-height: 108px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.ess-hero-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0,0,0,.18);
}
.ess-hero-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.04);
    pointer-events: none;
    transition: background 0.2s;
}
.ess-hero-card:hover::after { background: rgba(255,255,255,.09); }

.ess-hero-card .hc-bg-icon {
    position: absolute;
    right: -8px;
    bottom: -8px;
    font-size: 80px;
    opacity: 0.12;
    line-height: 1;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
}
.ess-hero-card:hover .hc-bg-icon { opacity: 0.20; transform: scale(1.06); }

.ess-hero-card .hc-title {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 5px;
    letter-spacing: 0.15px;
}
.ess-hero-card .hc-desc {
    font-size: 11.5px;
    color: rgba(255,255,255,.80);
    margin: 0;
    line-height: 1.45;
}
.ess-hero-card .hc-badge {
    display: inline-block;
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.30);
    border-radius: 20px;
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
    padding: 2px 9px;
    margin-top: 8px;
    width: fit-content;
}

/* Card color variants */
.ess-hc-1 { background: linear-gradient(135deg, #1e3a5f 0%, #3e6a8c 100%); }
.ess-hc-2 { background: linear-gradient(135deg, #2d5a8a 0%, #2d7ab5 100%); }
.ess-hc-3 { background: linear-gradient(135deg, #1a5a7a 0%, #0e7490 100%); }
.ess-hc-4 { background: linear-gradient(135deg, #1e4060 0%, #2d5a80 100%); }

@@media (max-width: 1200px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 768px) {
    .ess-hero-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
@@media (max-width: 576px) {
    .ess-hero-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .ess-hero-card { min-height: 90px; padding: 14px; }
    .ess-hero-card .hc-bg-icon { font-size: 56px; }
}

/* ── Panel / Section card ─────────────────────────────────────
   Values below are read directly from the reference project's source
   (Dashboard.tsx) rather than estimated from screenshots: 4px radius,
   no shadow, and a light blue-tint gradient header — not flat white. */
.ess-panel {
    background: #fff;
    border-radius: 4px;
    border: 1px solid #d0dce8;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.ess-panel-hdr {
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #334e6a;
    background: linear-gradient(to bottom, #e8f0f8, #dce7f2);
    border-bottom: 1px solid #d0dce8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.ess-panel-hdr > span:first-child { display: flex; align-items: center; gap: 6px; }
.ess-panel-hdr i { font-size: 13px; color: #628db6; }
.ess-panel-hdr-badge {
    background: #d4f0e3;
    color: #166534;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 8px;
    letter-spacing: 0.3px;
}
.ess-panel-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 10px 12px;
    scrollbar-width: thin;
    scrollbar-color: #c8d9e6 transparent;
}
.ess-panel-body::-webkit-scrollbar { width: 4px; }
.ess-panel-body::-webkit-scrollbar-thumb { background:#c8d9e6; border-radius:2px; }

.ess-view-all-link {
    font-size: 11.5px;
    font-weight: 700;
    color: #628db6;
    cursor: pointer;
}
.ess-view-all-link:hover { text-decoration: underline; }

.ess-view-all-btn {
    display: none;
    width: 100%;
    margin-top: 6px;
    padding: 7px;
    border: 1px dashed #c8d9e6;
    border-radius: 4px;
    background: #f8fbfd;
    color: #628db6;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
}
.ess-view-all-btn:hover { background: #eef5fb; }

/* ── Latest Members items ────────────────────────────────────── */
.ess-member-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid #eef3f8;
}
.ess-member-item:last-child { border-bottom: none; }
.ess-member-item img {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-member-name  { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-member-role  { font-size: 11px; color: #5a7088; }
.ess-member-date  { font-size: 10.5px; color: #8da0b3; margin-top: 1px; }

.ess-empty-state {
    text-align: center;
    padding: 30px 16px;
    color: #8da0b3;
}
.ess-empty-state i { font-size: 36px; color: #c8d9e6; display: block; margin-bottom: 8px; }
.ess-empty-state p { font-size: 12.5px; margin: 0; }

/* ── Tabs (Birthday / Anniversary Today·Week·Month) — underline
   style, matching the reference instead of the earlier filled
   pill-tab look. ──────────────────────────────────────────────── */
.ess-tab-nav {
    display: flex;
    background: #f9fbfd;
    border-bottom: 2px solid #e8f0f8;
    flex-shrink: 0;
}
.ess-tab-btn {
    flex: 1 1 0;
    border: none;
    background: none;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    padding: 8px 4px;
    margin-bottom: -2px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.16s, border-color 0.16s;
    white-space: nowrap;
    font-family: inherit;
}
.ess-tab-btn:hover { color: #628db6; }
.ess-tab-btn.active { color: #628db6; font-weight: 600; border-bottom-color: #628db6; }
.ess-tab-pane { display: none; }
.ess-tab-pane.active { display: block; }
.ess-tab-count { font-weight: inherit; margin-left: 1px; }

/* ── Birthday / Anniversary card ────────────────────────────── */
.ess-bday-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e4edf4;
    border-left: 3px solid #2d7ab5;
    margin-bottom: 7px;
    transition: box-shadow 0.16s, border-color 0.16s;
    position: relative;
}
.ess-bday-card:hover {
    box-shadow: 0 3px 10px rgba(45,122,181,.12);
    border-left-color: #1e3a5f;
}
.ess-bday-card img {
    width: 40px; height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #d0dce8;
    flex-shrink: 0;
}
.ess-bday-name   { font-size: 12.5px; font-weight: 700; color: #1e3a5f; }
.ess-bday-info   { font-size: 11px; color: #5a7088; }
.ess-bday-date   {
    position: absolute; top: 8px; right: 8px;
    font-size: 10px; color: #8da0b3;
    display: flex; align-items: center; gap: 3px;
}

/* Happy-birthday footer banner — shown only when today's list is
   non-empty (no fabricated "always on" celebration state). */
.ess-happy-banner {
    display: none;
    margin: 8px 12px 12px;
    padding: 8px;
    text-align: center;
    background: #fdeef2;
    border: 1px solid #f7c9d6;
    border-radius: 8px;
    color: #c2255c;
    font-weight: 700;
    font-size: 12px;
    flex-shrink: 0;
}
.ess-happy-banner.show { display: block; }

/* ── Holiday card ────────────────────────────────────────────── */
.ess-holiday-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #f8fafb;
    border: 1px solid #e4edf4;
    margin-bottom: 7px;
    transition: background 0.15s;
}
.ess-holiday-card:hover { background: #eef5fb; }
.ess-holiday-date-box {
    text-align: center;
    min-width: 42px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,.18);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}
.ess-holiday-month {
    font-size: 9.5px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    background: #E23A3A;
    padding: 2px 6px;
}
.ess-holiday-day {
    font-size: 17px;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.3;
    background: #fff;
    padding: 1px 6px 3px;
}
.ess-holiday-name    { font-size: 12.5px; font-weight: 600; color: #1e3a5f; }
.ess-holiday-weekday { font-size: 10.5px; color: #8da0b3; margin-top: 1px; }

/* ── Section toggle (Organization Policy accordion) ───────────── */
.ess-section-toggle {
    padding: 9px 14px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid #e4edf4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f4f7fa;
    transition: background 0.15s;
    flex-shrink: 0;
}
.ess-section-toggle:hover { background: #eef5fb; }
.ess-section-toggle-title {
    font-size: 12px;
    font-weight: 700;
    color: #1e3a5f;
    display: flex;
    align-items: center;
    gap: 7px;
}
.ess-section-toggle-title i { color: #2d7ab5; font-size: 14px; }
.ess-section-toggle-arrow { color: #2d7ab5; font-size: 13px; transition: transform 0.2s; }
.ess-section-toggle.collapsed .ess-section-toggle-arrow { transform: rotate(-90deg); }

/* ── Policy item ─────────────────────────────────────────────── */
.ess-policy-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 0;
    border-bottom: 1px solid #eef3f8;
    cursor: pointer;
}
.ess-policy-item:last-child { border-bottom: none; }
.ess-policy-item:hover .ess-policy-name { color: #2d7ab5; }
.ess-policy-icon { font-size: 18px; color: #c0392b; flex-shrink: 0; }
.ess-policy-name { font-size: 12px; font-weight: 500; color: #1e3a5f; transition: color 0.15s; }

/* ── News & Announcements feed ────────────────────────────────── */
.ess-news-item {
    padding: 10px 0;
    border-bottom: 1px solid #eef3f8;
}
.ess-news-item:last-child { border-bottom: none; }
.ess-news-item-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.ess-news-tag {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.4px;
    padding: 2px 8px;
    border-radius: 10px;
    text-transform: uppercase;
}
.ess-news-tag-new    { background: #d4f0e3; color: #166534; }
.ess-news-tag-update { background: #ddeef8; color: #1168a0; }
.ess-news-tag-info   { background: #f3e8ff; color: #7c3aed; }
.ess-news-item-date { font-size: 10.5px; color: #8da0b3; }
.ess-news-item-title { font-size: 13px; font-weight: 700; color: #1e3a5f; margin-bottom: 3px; }
.ess-news-item-desc { font-size: 12px; color: #5a7088; line-height: 1.45; }

/* ── Quick Actions grid ────────────────────────────────────────
   6 items, 2 columns × 3 rows, each tile a fixed-height card so zoom
   in/out can't stretch/shrink rows or leave the last row uneven —
   min-height/max-height/height are all pinned to the same value on
   purpose, not just a single `height`. 70px (down from 110px) is sized
   so all 3 rows fit inside the card's 295px height without the card
   needing its own scrollbar. */
.ess-qa-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}
.ess-qa-tile {
    height: 70px;
    min-height: 70px;
    max-height: 70px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
    padding: 6px 8px;
    background: #fff;
    border: 1px solid #e4edf4;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    cursor: pointer;
    transition: box-shadow 0.15s, transform 0.15s;
}
.ess-qa-tile:hover {
    box-shadow: 0 4px 10px rgba(45,122,181,.15);
    transform: translateY(-2px);
}
.ess-qa-icon { font-size: 18px; color: #628db6; transition: color 0.15s; }
.ess-qa-tile:hover .ess-qa-icon { color: #3e6a8c; }
.ess-qa-label { font-size: 11px; font-weight: 600; color: #334e6a; }
.ess-qa-sub { font-size: 9px; color: #8da0b3; }

@@media (max-width: 992px) {
    .ess-qa-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
@@media (max-width: 576px) {
    .ess-qa-grid { grid-template-columns: repeat(1, 1fr); gap: 8px; }
}

/* ── Honest "coming soon" placeholder — used for Recent Activity
   and Attendance Overview, which have no backend yet. ───────────── */
.ess-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: #9aa7b4;
    padding: 20px;
}
.ess-coming-soon i { font-size: 34px; color: #c8d9e6; margin-bottom: 10px; }
.ess-coming-soon p { font-size: 12.5px; margin: 0 0 4px; font-weight: 700; color: #5a7088; }
.ess-coming-soon span { font-size: 11px; }

/* ── Card heights fill their row ───────────────────────────────
   Reverted to fixed pixel heights (see the comment on .ess-dash-grid
   above for why the fill-the-screen version was rolled back). All 8
   non-hero cards (both rows) share the SAME height, 295px, so every
   card lines up evenly both across its own row and against the other
   row. At 295px the Quick Actions 2×3 grid (110px tiles) no longer
   fits without its own scroll — that's fine, .ess-panel-body already
   scrolls internally, same as New Joiners/Birthdays do when their
   list is longer than the card. */
.ess-panel-mid, .ess-panel-fill { height: 295px; }

/* Override the global nav-tabs orange from the original file */
.nav-tabs .nav-link.active { color: #2d7ab5 !important; border-bottom-color: #2d7ab5 !important; }
.nav-tabs .nav-link:hover  { color: #2d7ab5 !important; }

/* Override scrollbar orange */
::-webkit-scrollbar-thumb { background: #c8d9e6 !important; }
::-webkit-scrollbar-thumb:hover { background: #2d7ab5 !important; }
</style>

<!-- ══ HERO ACTION CARDS (kept as-is) ══ -->
<div class="ess-hero-grid">

    <div class="ess-hero-card ess-hc-1" id="employeeid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bxs-group" style="margin-right:6px;opacity:.9"></i>Employee &amp; Team</p>
            <p class="hc-desc">Explore your team's direct &amp; indirect reporting structure.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bxs-group"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-2" id="attendanceleaveid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-history" style="margin-right:6px;opacity:.9"></i>Attendance &amp; Leave</p>
            <p class="hc-desc">Daily or monthly attendance details &amp; leave records.</p>
        </div>
        <div class="hc-badge" id="inTimeDisplay">In Time: <span id="inTime">—</span></div>
        <div class="hc-bg-icon"><i class="bx bx-calendar-check"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-3" id="salaryid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-rupee" style="margin-right:6px;opacity:.9"></i>Salary</p>
            <p class="hc-desc">View your processed &amp; published salary details.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bx-money"></i></div>
    </div>

    <div class="ess-hero-card ess-hc-4" id="reportid" role="button" tabindex="0">
        <div>
            <p class="hc-title"><i class="bx bx-line-chart" style="margin-right:6px;opacity:.9"></i>Reports</p>
            <p class="hc-desc">Access attendance, leave, and salary reports.</p>
        </div>
        <div class="hc-bg-icon"><i class="bx bx-bar-chart-alt-2"></i></div>
    </div>

</div>

<!-- ══ MIDDLE SECTION — New Joiners · Birthdays · Anniversaries · Holidays ══ -->
<div class="ess-dash-grid">

    <!-- New Joiners -->
    <div>
        <div class="ess-panel ess-panel-mid">
            <div class="ess-panel-hdr">
                <span><i class="bx bx-user-plus"></i>New Joiners</span>
                <span style="display:flex;align-items:center;gap:10px;">
                    <span class="ess-panel-hdr-badge" id="totalMemberCount">0</span>
                    <span class="ess-view-all-link" id="membersViewAll">View All</span>
                </span>
            </div>
            <div style="padding:6px 12px;font-size:11px;font-weight:700;color:#3e6a8c;background:#f4f9fc;border-bottom:1px solid #eef1f5;flex-shrink:0;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;" id="companyNameDisplay"></div>
            <div class="ess-panel-body" id="latestMembersContent">
                <div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading members…</p></div>
            </div>
        </div>
    </div>

    <!-- This Month Birthdays -->
    <div>
        <div class="ess-panel ess-panel-mid">
            <div class="ess-panel-hdr">
                <span><i class="bx bx-cake"></i>This Month Birthdays</span>
            </div>
            <div class="ess-tab-nav">
                <button class="ess-tab-btn active" onclick="switchEssTabScoped(this,'bdayTodayPane')">Today <span class="ess-tab-count" id="bdayTodayCount">(0)</span></button>
                <button class="ess-tab-btn" onclick="switchEssTabScoped(this,'bdayWeekPane')">This Week <span class="ess-tab-count" id="bdayWeekCount">(0)</span></button>
                <button class="ess-tab-btn" onclick="switchEssTabScoped(this,'bdayMonthPane')">This Month <span class="ess-tab-count" id="bdayMonthCount">(0)</span></button>
            </div>
            <div class="ess-panel-body">
                <div class="ess-tab-pane active" id="bdayTodayPane"><div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading…</p></div></div>
                <div class="ess-tab-pane" id="bdayWeekPane"></div>
                <div class="ess-tab-pane" id="bdayMonthPane"></div>
            </div>
            <div class="ess-happy-banner" id="happyBdayBanner">🎉 Happy Birthday!</div>
        </div>
    </div>

    <!-- Work / Marriage Anniversary -->
    <div>
        <div class="ess-panel ess-panel-mid">
            <div class="ess-panel-hdr">
                <span><i class="bx bxs-building"></i>Work Anniversary</span>
            </div>
            <div class="ess-tab-nav">
                <button class="ess-tab-btn active" onclick="switchEssTabScoped(this,'annivTodayPane')">Today <span class="ess-tab-count" id="annivTodayCount">(0)</span></button>
                <button class="ess-tab-btn" onclick="switchEssTabScoped(this,'annivWeekPane')">This Week <span class="ess-tab-count" id="annivWeekCount">(0)</span></button>
                <button class="ess-tab-btn" onclick="switchEssTabScoped(this,'annivMonthPane')">This Month <span class="ess-tab-count" id="annivMonthCount">(0)</span></button>
            </div>
            <div class="ess-panel-body">
                <div class="ess-tab-pane active" id="annivTodayPane"><div class="ess-empty-state"><i class="bx bx-loader-alt"></i><p>Loading…</p></div></div>
                <div class="ess-tab-pane" id="annivWeekPane"></div>
                <div class="ess-tab-pane" id="annivMonthPane"></div>
            </div>
        </div>
    </div>

