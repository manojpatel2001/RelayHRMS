    function openPDFCustomViewer(url, fileName) {
        const modalHtml = `
            <div class="modal fade" id="customPdfViewer" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content">
                        <div class="modal-header bg-light">
                            <div class="d-flex align-items-center">
                                <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png"
                                     style="width:24px; height:24px; margin-right:8px;" alt="PDF">
                                <h5 class="modal-title mb-0">${fileName}</h5>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-success me-3">📖 Document Preview</span>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                        </div>
                        <div class="modal-body p-0" style="background: #f8f9fa;">
                            <div id="pdfLoadingSpinner" class="text-center p-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted">Loading document preview...</p>
                            </div>
                            <iframe id="pdfFrame"
                                    src="${url}#toolbar=0&navpanes=0&scrollbar=1&view=FitH&zoom=80"
                                    style="width:100%; height:calc(100vh - 140px); border:none; display:none;"
                                    onload="hidePdfLoadingSpinner()"
                                    title="${fileName}">
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
        `;

        $('#customPdfViewer').remove();
        $('body').append(modalHtml);
        $('#customPdfViewer').modal('show');
    }

    function hidePdfLoadingSpinner() {
        $('#pdfLoadingSpinner').hide();
        $('#pdfFrame').show();
    }

    function fetchInTime() {
        const EmployeeId = localStorage.getItem("EmployeeId");
        const apiUrl = `${apiBase}/EmpAttendanceAPI/GetEmployeeInTime/${EmployeeId}`;

        $.ajax({
            url: apiUrl,
            method: "GET",
            dataType: "json",
            success: function(response) {
                if (response.isSuccess && response.data && response.data.length > 0) {
                    $("#inTime").text(response.data[0].inTime);
                } else {
                    $("#inTime").text("Pending");
                    console.error("Failed to fetch IN Time:", response.responseMessage || "No data available");
                }
            },
            error: function(xhr, status, error) {
                console.error("Error fetching IN Time:", error);
                $("#inTime").text("Pending");
                console.warn("Failed to fetch IN Time. Please try again later.");
            }
        });
    }

