@section Scripts {
<script>
/* ── Variables ───────────────────────────────────────────────── */
const apiBase  = '@apiBase';
const baseUrl  = '@baseUrl';
const baseDomain = (function() {
    try { return new URL(apiBase).origin; } catch(e) { return ''; }
})();
const Empid    = parseInt(localStorage.getItem('EmployeeId'));
const savedCompany   = JSON.parse(localStorage.getItem('selectedCompany') || '{}');
const Compid   = parseInt(savedCompany.CompanyId || '0');

/* ── Hero card navigation ──────────────────────────────────────── */
document.getElementById('employeeid').onclick        = function() { location.href = baseUrl + '/EmployeePanel/Home/EmployeeandTeam'; };
document.getElementById('attendanceleaveid').onclick = function() { location.href = baseUrl + '/EmployeePanel/Home/Attendanceandleave'; };
document.getElementById('salaryid').onclick          = function() { location.href = baseUrl + '/EmployeePanel/Home/Salary'; };
document.getElementById('reportid').onclick          = function() { location.href = baseUrl + '/EmployeePanel/MyReports/Index'; };

/* ── Quick Actions navigation ─────────────────────────────────── */
function essComingSoon() {
    if (window.hrmsNotify && typeof hrmsNotify.info === 'function') {
        hrmsNotify.info('This page is coming soon.');
    } else {
        alert('This page is coming soon.');
    }
}
document.getElementById('qaShifts').onclick       = essComingSoon;
document.getElementById('qaEmployees').onclick    = function() { location.href = baseUrl + '/EmployeePanel/Home/EmployeeandTeam'; };
document.getElementById('qaAttendance').onclick   = function() { location.href = baseUrl + '/EmployeePanel/Employee/Index'; };
document.getElementById('qaLeaveRequest').onclick = function() { location.href = baseUrl + '/EmployeePanel/Leave/LeaveApplication'; };
document.getElementById('qaApprovals').onclick    = function() { location.href = baseUrl + '/EmployeePanel/Leave/AdminLeaveApproval'; };
document.getElementById('qaPayroll').onclick      = function() { location.href = baseUrl + '/EmployeePanel/Home/Salary'; };
document.getElementById('membersViewAll').onclick = function() { location.href = baseUrl + '/EmployeePanel/EmployeeDirectory/Index'; };

/* ── Tab switching (scoped to the tab-nav's own panel, since the
   dashboard now has multiple independent Today/Week/Month tab
   groups instead of one shared set) ──────────────────────────── */
function switchEssTabScoped(btn, paneId) {
    var nav = btn.closest('.ess-tab-nav');
    if (nav) {
        nav.querySelectorAll('.ess-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    }
    btn.classList.add('active');
    var body = nav ? nav.nextElementSibling : null;
    if (body) {
        body.querySelectorAll(':scope > .ess-tab-pane').forEach(function(p) { p.classList.remove('active'); });
    }
    var pane = document.getElementById(paneId);
    if (pane) pane.classList.add('active');
}

/* ── Section toggle (Organization Policy accordion) ───────────── */
function toggleEssSection(toggleId, bodyId) {
    var toggle = document.getElementById(toggleId);
    var body   = document.getElementById(bodyId);
    if (!toggle || !body) return;
    var isCollapsed = toggle.classList.contains('collapsed');
    if (isCollapsed) {
        toggle.classList.remove('collapsed');
        body.style.display = '';
    } else {
        toggle.classList.add('collapsed');
        body.style.display = 'none';
    }
}

/* ── Date helpers ────────────────────────────────────────────── */
function formatDDMMM(dateString) {
    var d = new Date(dateString);
    return String(d.getDate()).padStart(2,'0') + ' ' + d.toLocaleString('en-US', { month:'short' });
}
function formatTimeHHMM(dateString) {
    var d = new Date(dateString);
    return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
}
function formatDDMMYYYY(dateString) {
    var d = new Date(dateString);
    return String(d.getDate()).padStart(2,'0') + '/' +
           String(d.getMonth()+1).padStart(2,'0') + '/' +
           new Date().getFullYear();
}

/* Buckets a list of {date: ...} records into Today / This Week (next
   7 days) / This Month (rest of the current calendar month).
   IMPORTANT: the API returns each record's ORIGINAL date — an actual
   birth date or joining date, e.g. "1982-07-30" — not a recomputed
   "next occurrence in the current year". Comparing that raw date
   against today's full date (as this used to do) can never match,
   since the year is never the same; "Today" would always be empty
   even for an employee whose birthday genuinely is today. These are
   recurring annual events, so only the month/day matter — project
   the record's month/day onto the current year (or next year, if
   that occurrence has already passed) before comparing. */
function bucketByDate(list) {
    var today = new Date(); today.setHours(0,0,0,0);
    var weekEnd = new Date(today); weekEnd.setDate(today.getDate() + 7);
    var monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    var buckets = { today: [], week: [], month: [] };
    list.forEach(function(m) {
        var raw = new Date(m.date);
        if (isNaN(raw)) return;
        var d = new Date(today.getFullYear(), raw.getMonth(), raw.getDate());
        if (d.getTime() < today.getTime()) {
            d = new Date(today.getFullYear() + 1, raw.getMonth(), raw.getDate());
        }
        if (d.getTime() === today.getTime()) buckets.today.push(m);
        if (d.getTime() >= today.getTime() && d.getTime() <= weekEnd.getTime()) buckets.week.push(m);
        if (d.getTime() >= today.getTime() && d.getTime() <= monthEnd.getTime()) buckets.month.push(m);
    });
    return buckets;
}
function renderBucketPane(paneId, countId, list, itemBuilder, emptyIcon, emptyText) {
    $('#' + countId).text('(' + list.length + ')');
    if (!list.length) {
        $('#' + paneId).html('<div class="ess-empty-state"><i class="bx ' + emptyIcon + '"></i><p>' + emptyText + '</p></div>');
        return;
    }
    var html = '';
    list.forEach(function(m) { html += itemBuilder(m); });
    $('#' + paneId).html(html);
}

/* ── Latest Members ──────────────────────────────────────────── */
function loadLatestMembers() {
    document.getElementById('companyNameDisplay').textContent = savedCompany.CompanyName || '';
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetRecentJoinedEmployees?Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            var members = Array.isArray(resp.data) ? resp.data : [];
            if (!members.length) {
                $('#latestMembersContent').html('<div class="ess-empty-state"><i class="bx bx-user"></i><p>No new members found.</p></div>');
                return;
            }
            $('#totalMemberCount').text(members.length + ' new');
            var html = '';
            members.forEach(function(m) {
                var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
                var joined = m.dateOfJoining ? m.dateOfJoining.split('T')[0].split('-').reverse().join('/') : '';
                html += '<div class="ess-member-item">' +
                    '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
                    '<div><div class="ess-member-name">' + (m.fullName || '') + '</div>' +
                    '<div class="ess-member-role">' + (m.designationName || '') + (m.departmentName ? ' · ' + m.departmentName : '') + '</div>' +
                    '<div class="ess-member-date">Joined: ' + joined + '</div></div>' +
                    '</div>';
            });
            $('#latestMembersContent').html(html);
        },
        error: function() {
            $('#latestMembersContent').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load members.</p></div>');
        }
    });
}

/* ── Birthday (Today / This Week / This Month) ────────────────── */
function loadBirthday() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetTodayBirthdaysByCompany?Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            var members = Array.isArray(resp.data) ? resp.data : [];
            var buckets = bucketByDate(members);
            renderBucketPane('bdayTodayPane', 'bdayTodayCount', buckets.today, buildBdayCard, 'bx-cake', 'No birthdays today.');
            renderBucketPane('bdayWeekPane', 'bdayWeekCount', buckets.week, buildBdayCard, 'bx-cake', 'No birthdays this week.');
            renderBucketPane('bdayMonthPane', 'bdayMonthCount', buckets.month, buildBdayCard, 'bx-cake', 'No birthdays this month.');
            $('#happyBdayBanner').toggleClass('show', buckets.today.length > 0);
        },
        error: function() {
            ['bdayTodayPane','bdayWeekPane','bdayMonthPane'].forEach(function(id) {
                $('#' + id).html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load birthdays.</p></div>');
            });
        }
    });
}
function buildBdayCard(m) {
    var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
    return '<div class="ess-bday-card">' +
        '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
        '<div class="ess-bday-text">' +
            '<div class="ess-bday-name">' + (m.employeeCode ? m.employeeCode + ' – ' : '') + (m.fullName || '') + '</div>' +
            '<div class="ess-bday-info">' + (m.designationName || '') + (m.departmentName ? ' | ' + m.departmentName : '') + '</div>' +
            '<div class="ess-bday-info">' + (m.branchName || '') + '</div>' +
        '</div>' +
        '<div class="ess-bday-date">' + formatDDMMYYYY(m.date) + '</div>' +
        '</div>';
}

/* ── Work + Marriage Anniversary, combined (Today / Week / Month) ── */
function loadAnniversaries() {
    $.when(
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetTodayWorkAnniversary?Compid=' + Compid, type: 'GET' }),
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetTodayMarriageAnnivarsary?Compid=' + Compid, type: 'GET' })
    ).done(function(workResp, marriageResp) {
        var work = Array.isArray(workResp[0].data) ? workResp[0].data : [];
        var marriage = Array.isArray(marriageResp[0].data) ? marriageResp[0].data : [];
        work.forEach(function(m) { m._type = 'work'; });
        marriage.forEach(function(m) { m._type = 'marriage'; });
        var combined = work.concat(marriage);
        var buckets = bucketByDate(combined);
        renderBucketPane('annivTodayPane', 'annivTodayCount', buckets.today, buildAnnivCard, 'bxs-building', 'No anniversaries today.');
        renderBucketPane('annivWeekPane', 'annivWeekCount', buckets.week, buildAnnivCard, 'bxs-building', 'No anniversaries this week.');
        renderBucketPane('annivMonthPane', 'annivMonthCount', buckets.month, buildAnnivCard, 'bxs-building', 'No anniversaries this month.');
    }).fail(function() {
        ['annivTodayPane','annivWeekPane','annivMonthPane'].forEach(function(id) {
            $('#' + id).html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load anniversaries.</p></div>');
        });
    });
}
function buildAnnivCard(m) {
    var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
    var icon = m._type === 'marriage' ? '💍' : '🏢';
    return '<div class="ess-bday-card">' +
        '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
        '<div class="ess-bday-text">' +
            '<div class="ess-bday-name">' + icon + ' ' + (m.fullName || '') + '</div>' +
            '<div class="ess-bday-info">' + (m.designationName || '') + (m.departmentName ? ' | ' + m.departmentName : '') + '</div>' +
            '<div class="ess-bday-info">' + (m.branchName || '') + (m.ageInYears ? ' · ' + m.ageInYears + ' yr(s)' : '') + '</div>' +
        '</div>' +
        '<div class="ess-bday-date">' + formatDDMMYYYY(m.date) + '</div>' +
        '</div>';
}

/* ── Upcoming Holidays ("View Holiday Calendar" expands the already-
   fetched list in place — there's no dedicated calendar page yet) ── */
var allHolidays = [];
var holidaysExpanded = false;
var HOLIDAY_PREVIEW_COUNT = 4;

function loadUpcomingHolidays() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/Getupcommingholidays?Compid=' + Compid + '&EmployeeId=' + Empid,
        type: 'GET',
        success: function(resp) {
            allHolidays = Array.isArray(resp.data) ? resp.data : [];
            renderHolidays();
        },
        error: function() {
            $('#upcomingHolidayList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load holidays.</p></div>');
        }
    });
}
function renderHolidays() {
    if (!allHolidays.length) {
        $('#upcomingHolidayList').html('<div class="ess-empty-state"><i class="bx bx-sun"></i><p>No upcoming holidays.</p></div>');
        $('#holidayViewAllBtn').hide();
        return;
    }
    var visible = holidaysExpanded ? allHolidays : allHolidays.slice(0, HOLIDAY_PREVIEW_COUNT);
    var html = '';
    visible.forEach(function(h) {
        var d = new Date(h.holidayDate);
        if (isNaN(d)) return;
        var month = d.toLocaleString('en-US', { month:'short' });
        var day   = String(d.getDate()).padStart(2,'0');
        var weekday = d.toLocaleString('en-US', { weekday:'long' });
        html += '<div class="ess-holiday-card">' +
            '<div class="ess-holiday-date-box"><div class="ess-holiday-month">' + month + '</div><div class="ess-holiday-day">' + day + '</div></div>' +
            '<div><div class="ess-holiday-name">' + (h.holidayName || '') + '</div>' +
            '<div class="ess-holiday-weekday">' + weekday + '</div></div>' +
            '</div>';
    });
    $('#upcomingHolidayList').html(html);
    if (allHolidays.length > HOLIDAY_PREVIEW_COUNT) {
        $('#holidayViewAllBtn').show().text(holidaysExpanded ? 'Show Less' : 'View Holiday Calendar (' + allHolidays.length + ')');
    } else {
        $('#holidayViewAllBtn').hide();
    }
}
function toggleHolidaysExpand() {
    holidaysExpanded = !holidaysExpanded;
    renderHolidays();
}

/* ── Attendance Overview (today, scoped to the logged-in employee
   plus their own team) ── Two existing endpoints, no new backend:
   GetDirectIndirectEmployee (called once for "direct" and once for
   "indirect" reports, merged) gives the team roster; the logged-in
   employee's own EmployeeCode is added to that same roster so their
   own attendance is folded in too. GetTodaysAttendanceAdmin gives
   today's attendance for the whole company. There's no shared numeric
   employee id between the two responses, so roster membership is
   matched by EmployeeCode instead. AttendanceStatus is a short code
   (not a full word) — P/A/L/HF/H/W/LWP — mapped to the 4 buckets
   below. There's no "Remote" concept in this backend at all, so that
   reference-design category is intentionally left out rather than
   faked; Half Day stands in as the 4th bucket since it's real data. */
var ATTENDANCE_BUCKETS = [
    { key: 'P',  label: 'Present',   icon: 'bx-check-circle',    color: '#28a745' },
    { key: 'L',  label: 'On Leave',  icon: 'bx-calendar-x',      color: '#fd7e14' },
    { key: 'A',  label: 'Absent',    icon: 'bx-user-x',          color: '#dc3545' },
    { key: 'HF', label: 'Half Day',  icon: 'bx-time-five',       color: '#628db6' }
];

function loadTeamAttendanceOverview() {
    // GetTodaysAttendanceDashbord is scoped per-branch (a required CSV of
    // branch ids, not a company-wide call), and per-company. The team
    // roster (GetDirectIndirectEmployee) doesn't carry a branch field, so
    // branches are resolved separately via GetAllBranchesListByCompanyId
    // (the one call here that needs the Authorization header).
    //
    // A manager's indirect reports can belong to a DIFFERENT company than
    // the manager (a cross-company reporting line) — confirmed live while
    // building this: 2 of this test manager's 6 team members had a
    // companyId different from her own. Grouping the team by their own
    // companyId and querying each company separately (instead of just
    // Compid) is what makes those show up too, instead of silently
    // dropping them.
    var authToken = localStorage.getItem('authToken');
    $.when(
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetDirectIndirectEmployee?Compid=' + Compid + '&EmployeeId=' + Empid + '&Action=direct', type: 'GET' }),
        $.ajax({ url: apiBase + '/EmployeeDashBoardAPI/GetDirectIndirectEmployee?Compid=' + Compid + '&EmployeeId=' + Empid + '&Action=indirect', type: 'GET' })
    ).done(function(directResp, indirectResp) {
        var direct = Array.isArray(directResp[0].data) ? directResp[0].data : [];
        var indirect = Array.isArray(indirectResp[0].data) ? indirectResp[0].data : [];
        var team = direct.concat(indirect);
        var teamCodes = {};
        team.forEach(function(m) { if (m.employeeCode) teamCodes[m.employeeCode] = true; });
        // Include the logged-in employee's own attendance alongside their team's.
        var myCode = localStorage.getItem('EmployeeCode');
        if (myCode) teamCodes[myCode] = true;

        var companyIds = {};
        team.forEach(function(m) { if (m.companyId) companyIds[m.companyId] = true; });
        // Always fetch the logged-in employee's own company too, even if none
        // of their reports share it — otherwise their own attendance record
        // (added to teamCodes above) would never get pulled in.
        companyIds[Compid] = true;

        var perCompanyFetches = Object.keys(companyIds).map(function(cid) {
            return $.ajax({ url: apiBase + '/BranchAPI/GetAllBranchesListByCompanyId/' + cid, type: 'GET', headers: { 'Authorization': 'Bearer ' + authToken } })
                .then(function(branchResp) {
                    var branches = (branchResp.isSuccess && Array.isArray(branchResp.data)) ? branchResp.data : [];
                    var branchIds = branches.map(function(b) { return b.branchId; }).filter(Boolean).join(',');
                    if (!branchIds) return [];
                    return $.ajax({ url: apiBase + '/EmpAttendanceAPI/GetTodaysAttendanceDashbord?BranchId=' + branchIds + '&ShiftMatserId=0&CompanyId=' + cid, type: 'GET' })
                        .then(
                            function(attnResp) { return (attnResp.isSuccess && Array.isArray(attnResp.data)) ? attnResp.data : []; },
                            function() { return []; }
                        );
                }, function() { return []; });
        });

        $.when.apply($, perCompanyFetches).done(function() {
            var perCompanyResults = perCompanyFetches.length === 1 ? [arguments[0]] : Array.prototype.slice.call(arguments);
            var allAttendance = [].concat.apply([], perCompanyResults);
            var teamAttendance = allAttendance.filter(function(a) { return teamCodes[a.employeeCode]; });
            renderAttendanceOverview(teamAttendance);
        }).fail(function() {
            $('#attendanceOverviewList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load attendance.</p></div>');
        });
    }).fail(function() {
        $('#attendanceOverviewList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load attendance.</p></div>');
    });
}

function renderAttendanceOverview(teamAttendance) {
    $('#attnTeamCount').text(teamAttendance.length);
    if (!teamAttendance.length) {
        $('#attendanceOverviewList').html('<div class="ess-empty-state"><i class="bx bx-group"></i><p>No team members found.</p></div>');
        return;
    }
    var total = teamAttendance.length;
    var html = '';
    ATTENDANCE_BUCKETS.forEach(function(bucket) {
        var count = teamAttendance.filter(function(a) { return a.attendanceStatus === bucket.key; }).length;
        var pct = Math.round((count / total) * 100);
        html += '<div class="ess-attn-row">' +
            '<div class="ess-attn-row-top">' +
                '<span class="ess-attn-label"><i class="bx ' + bucket.icon + '" style="color:' + bucket.color + '"></i>' + bucket.label + '</span>' +
                '<span class="ess-attn-count">' + count + ' (' + pct + '%)</span>' +
            '</div>' +
            '<div class="ess-attn-bar-track"><div class="ess-attn-bar-fill" style="width:' + pct + '%;background:' + bucket.color + ';"></div></div>' +
            '</div>';
    });
    $('#attendanceOverviewList').html(html);
}

