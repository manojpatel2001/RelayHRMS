/* ── PDF Viewer ──────────────────────────────────────────────── */
function openPDFCustomViewer(url, fileName) {
    var existingModal = document.getElementById('customPdfViewer');
    if (existingModal) existingModal.remove();

    var html = '<div class="modal fade" id="customPdfViewer" tabindex="-1" aria-hidden="true">' +
        '<div class="modal-dialog modal-fullscreen">' +
        '<div class="modal-content">' +
        '<div class="modal-header" style="background:linear-gradient(135deg,#1e3a5f,#3e6a8c);color:#fff;padding:12px 18px;">' +
        '<h5 class="modal-title mb-0" style="font-size:14px;font-weight:700;">' + fileName + '</h5>' +
        '<button type="button" class="hrms-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="bx bx-x"></i></button>' +
        '</div>' +
        '<div class="modal-body p-0" style="background:#f4f7fa;">' +
        '<div id="pdfLoadingSpinner" class="text-center p-4">' +
        '<div class="wg-dot-spinner mx-auto"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>' +
        '<p class="mt-3 text-muted" style="font-size:13px;">Loading document…</p>' +
        '</div>' +
        '<iframe id="pdfFrame" src="' + url + '#toolbar=0&navpanes=0&scrollbar=1&view=FitH&zoom=80" style="width:100%;height:calc(100vh - 140px);border:none;display:none;" onload="hidePdfLoadingSpinner()" title="' + fileName + '"></iframe>' +
        '</div></div></div></div>';

    document.body.insertAdjacentHTML('beforeend', html);
    new bootstrap.Modal(document.getElementById('customPdfViewer')).show();
}
function hidePdfLoadingSpinner() {
    var s = document.getElementById('pdfLoadingSpinner');
    var f = document.getElementById('pdfFrame');
    if (s) s.style.display = 'none';
    if (f) f.style.display = 'block';
}

/* ── News Announcement ───────────────────────────────────────── */
var currentNewsId = null;
var newsCheckInterval = null;

function loadNewsAnnouncement() {
    $.ajax({
        url: apiBase + '/NewsAnnouncementAPI/GetActiveNewsForDashboard?companyId=' + Compid + '&employeeId=' + Empid,
        type: 'GET',
        success: function(resp) {
            if (resp.isSuccess && resp.data && resp.data.length > 0) {
                var news = resp.data[0];
                if (sessionStorage.getItem('closedNewsId') == news.newsID) return;
                currentNewsId = news.newsID;
                document.getElementById('newsTitle').textContent       = news.newsTitle || 'News Announcement';
                document.getElementById('newsDescription').textContent = news.newsDescription || '';
                $('#newsAnnouncementContainer').slideDown(350);
            } else {
                $('#newsAnnouncementContainer').slideUp(300);
            }
        },
        error: function() { $('#newsAnnouncementContainer').slideUp(300); }
    });
}
function closeNewsAnnouncement() {
    if (currentNewsId) sessionStorage.setItem('closedNewsId', currentNewsId);
    $('#newsAnnouncementContainer').slideUp(300);
    currentNewsId = null;
}
function startNewsCheck() {
    loadNewsAnnouncement();
    newsCheckInterval = setInterval(loadNewsAnnouncement, 300000);
}

/* ── Init ────────────────────────────────────────────────────── */
$(document).ready(function() {
    loadLatestMembers();
    loadBirthday();
    loadUpcomingHolidays();
    loadOrganizationPolicies();
    fetchInTime();
    startNewsCheck();
});

$(window).on('beforeunload', function() {
    if (newsCheckInterval) clearInterval(newsCheckInterval);
});
</script>
