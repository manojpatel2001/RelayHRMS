        // }, 2000);

        newsCheckInterval = setInterval(function() {
            loadNewsAnnouncement();
        }, 300000);
    }

    function stopNewsCheck() {
        if (newsCheckInterval) {
            clearInterval(newsCheckInterval);
            newsCheckInterval = null;
        }
    }

    $(window).on('beforeunload', function() {
        stopNewsCheck();
    });
