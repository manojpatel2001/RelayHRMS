/* ── Birthday ────────────────────────────────────────────────── */
function loadBirthday() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetTodayBirthdaysByCompany?Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            var members = resp.data;
            if (!Array.isArray(members) || members.length === 0) {
                $('#groupedBirthdayList').html('<div class="ess-empty-state"><i class="bx bx-cake"></i><p>No upcoming birthdays.</p></div>');
                return;
            }
            var today = new Date();
            var todayBdays = [], upcoming = [];
            members.forEach(function(m) {
                var d = new Date(m.date);
                if (d.getDate() === today.getDate() && d.getMonth() === today.getMonth()) {
                    todayBdays.push(m);
                } else {
                    upcoming.push(m);
                }
            });
            upcoming.sort(function(a, b) {
                var da = new Date(a.date), db = new Date(b.date);
                var getDiff = function(d) {
                    var mo = d.getMonth() - today.getMonth();
                    if (mo < 0 || (mo === 0 && d.getDate() < today.getDate())) mo += 12;
                    return mo * 31 + d.getDate();
                };
                return getDiff(da) - getDiff(db);
            });
            var html = '';
            if (todayBdays.length > 0) {
                html += '<div class="ess-date-group today">Today 🎂</div>';
                todayBdays.forEach(function(m) { html += buildBdayCard(m); });
            }
            var lastLabel = '';
            upcoming.forEach(function(m) {
                var label = formatDDMMM(m.date);
                if (label !== lastLabel) {
                    lastLabel = label;
                    html += '<div class="ess-date-group">' + label + '</div>';
                }
                html += buildBdayCard(m);
            });
            $('#groupedBirthdayList').html(html);
        },
        error: function() {
            $('#groupedBirthdayList').html('<div class="ess-empty-state"><i class="bx bx-error"></i><p>Failed to load birthdays.</p></div>');
        }
    });
}
function buildBdayCard(m) {
    var img = m.employeeProfileUrl || (baseDomain + '/default-image/avatar-2.png');
    return '<div class="ess-bday-card">' +
        '<img src="' + img + '" onerror="this.src=\'' + baseDomain + '/default-image/avatar-2.png\'" alt=""/>' +
        '<div style="flex:1;min-width:0;">' +
            '<div class="ess-bday-name">' + (m.employeeCode ? m.employeeCode + ' – ' : '') + (m.fullName || '') + '</div>' +
            '<div class="ess-bday-info">' + (m.designationName || '') + (m.departmentName ? ' | ' + m.departmentName : '') + '</div>' +
            '<div class="ess-bday-info">' + (m.branchName || '') + '</div>' +
        '</div>' +
        '<div class="ess-bday-date">' + formatDDMMYYYY(m.date) + '</div>' +
        '</div>';
}

/* ── Work Anniversary ────────────────────────────────────────── */
function loadworkanniversary() {
    $.ajax({
        url: apiBase + '/EmployeeDashBoardAPI/GetTodayWorkAnniversary?Compid=' + Compid,
        type: 'GET',
        success: function(resp) {
            var members = resp.data;
            if (!Array.isArray(members) || members.length === 0) {
                $('#workAnniversaryList').html('<div class="ess-empty-state"><i class="bx bxs-building"></i><p>No work anniversaries found.</p></div>');
                return;
            }
            var todayKey = new Date().toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
            var grouped = {};
            members.forEach(function(m) {
                var key = new Date(m.date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(m);
            });
            var html = '';
            for (var date in grouped) {
                var isToday = date === todayKey;
                html += '<div class="ess-date-group' + (isToday ? ' today' : '') + '">' + (isToday ? 'Today 🏢' : date) + '</div>';
