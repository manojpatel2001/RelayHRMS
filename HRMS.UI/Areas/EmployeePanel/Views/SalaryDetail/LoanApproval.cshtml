@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Loan Management";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Manage Loan Applications</h6>
        </div>
        <div class="card-body">
            <div id="gridContainerLoanManagement"></div>
        </div>
    </div>

</div>

<!-- Modal for Loan Status Update -->
<div class="modal fade" id="loanStatusModal" tabindex="-1" role="dialog" aria-labelledby="loanStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="loanStatusModalLabel">Update Loan Status</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="loanStatusForm">
                    <div class="fg fg-req">
                        <label for="loanStatus">Loan Status</label>
                        <select id="loanStatus">
                            <option value="">Select Status</option>
                        </select>
                    </div>
                    <div class="fg fg-req mt-2">
                        <label for="remarks">Remarks</label>
                        <textarea class="form-control" id="remarks" rows="3" placeholder="Enter your remarks"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="confirmBtn">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Confirm</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Loan Details / Approval History -->
<div class="modal fade" id="loanDetailModal" tabindex="-1" role="dialog" aria-labelledby="loanDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="loanDetailModalLabel">Loan Application Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h6>Loan Application Details</h6>
                <table class="table table-bordered" id="loanDetailTable">
                    <tbody></tbody>
                </table>
                <h6 class="mt-3">Approval History</h6>
                <div id="loanHistoryGridContainer"></div>
                <div id="loanHistoryEmptyMsg" class="text-muted" style="display:none;">No approval history available</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const EmployeeId = localStorage.getItem("EmployeeId");
        var Token = localStorage.getItem("authToken");
        var grid = null;
        var historyGrid = null;
        var currentRows = [];
        var currentLoanData = null;
        var loanStatusList = [];
        var isLoadingLoanMgmt = false;
        var isUpdatingLoanStatus = false;

        function fmtDateTime(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var hh = String(d.getHours()).padStart(2, '0');
            var mm = String(d.getMinutes()).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear() + ' ' + hh + ':' + mm;
        }

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + d.getFullYear();
        }

        $(function () {
            // Load loan statuses first, then load the grid
            loadLoanStatuses();

            // Close button handlers
            $('#loanStatusModal .close, #loanStatusModal [data-dismiss="modal"]').on('click', function () {
                $('#loanStatusModal').modal('hide');
            });
            $('#loanDetailModal .close, #loanDetailModal [data-dismiss="modal"]').on('click', function () {
                $('#loanDetailModal').modal('hide');
            });

            // Confirm button click handler
            $('#confirmBtn').on('click', function () {
                const statusId = $('#loanStatus').val();
                const remarks = $('#remarks').val().trim();

                if (!statusId) {
                    showToast('Please select a loan status', 'warn');
                    return;
                }

                if (!remarks) {
                    showToast('Please enter remarks', 'warn');
                    return;
                }

                if (currentLoanData) {
                    // Find the selected status object
                    const selectedStatus = loanStatusList.find(s => {
                        const id = s.probationStatusId || s.ProbationStatusId ||
                                  s.statusId || s.StatusId ||
                                  s.id || s.Id;
                        return id == statusId;
                    });

                    let statusName = '';
                    if (selectedStatus) {
                        statusName = selectedStatus.probationStatusName || selectedStatus.ProbationStatusName ||
                                    selectedStatus.statusName || selectedStatus.StatusName ||
                                    selectedStatus.name || selectedStatus.Name || '';
                    }

                    updateLoanApplication(currentLoanData, statusId, statusName, remarks);
                }
            });

            // Reset form when modal is closed
            $('#loanStatusModal').on('hidden.bs.modal', function () {
                $('#loanStatusForm')[0].reset();
                currentLoanData = null;
            });

            // Additional fix: Handle ESC key
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape' && $('#loanStatusModal').hasClass('show')) {
                    $('#loanStatusModal').modal('hide');
                }
            });
        });

        function loadLoanStatuses() {
            $.ajax({
                type: "GET",
                url: '@baseUrl/LoanApplicationAPI/GetAllLoanStatus',
                headers: {
                    'Authorization': 'Bearer ' + Token,
                    'Content-Type': 'application/json'
                },
                success: function (response) {
                    if (response.isSuccess && response.data) {
                        loanStatusList = response.data;

                        // Populate dropdown
                        const dropdown = $('#loanStatus');
                        dropdown.empty();
                        dropdown.append('<option value="">Select Status</option>');

                        loanStatusList.forEach(function (status) {
                            // Try different possible property name combinations
                            const statusId = status.probationStatusId || status.ProbationStatusId ||
                                           status.statusId || status.StatusId ||
                                           status.id || status.Id;
                            const statusName = status.probationStatusName || status.ProbationStatusName ||
                                             status.statusName || status.StatusName ||
                                             status.name || status.Name;

                            dropdown.append(`<option value="${statusId}">${statusName}</option>`);
                        });

                        // Load grid after statuses are loaded
                        loadPendingLoanApplications();
                    } else {
                        console.error("Failed to load loan statuses");
                        showToast('Failed to load loan statuses. Please refresh the page.', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading loan statuses:", error);
                    showToast('Error loading loan statuses. Please refresh the page.', 'error');
                }
            });
        }

        function loadPendingLoanApplications() {
            if (isLoadingLoanMgmt) return;
            isLoadingLoanMgmt = true;
            if (grid) grid.showLoader();

            const approverEmployeeId = EmployeeId;
            const status = "7";
            const approvalMasterId = 2;

            $.ajax({
                type: "POST",
                url: '@baseUrl/ProbationPerformanceAPI/GetPendingApprovalRequestsWithHistory1',
                headers: {
                    'Authorization': 'Bearer ' + Token,
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify({
                    approverEmployeeId: approverEmployeeId,
                    status: status,
                    ApprovalMasterId: approvalMasterId
                }),
                success: function (data) {
                    isLoadingLoanMgmt = false;
                    currentRows = (data && data.data) ? data.data : [];
                    renderGrid(currentRows);
                },
                error: function (xhr, status, error) {
                    isLoadingLoanMgmt = false;
                    console.error("Error loading loan applications:", error);
                    showToast('Error loading loan applications. Please try again.', 'error');
                    currentRows = [];
                    renderGrid([]);
                }
            });
        }

        window._openStatusModalByIdx = function (idx) {
            openStatusModal(currentRows[idx]);
        };

        window._openDetailModalByIdx = function (idx) {
            openDetailModal(currentRows[idx]);
        };

        function renderGrid(data) {
            var columns = [
                { field: 'requesterName', header: 'Applicant', width: '200px' },
                { field: 'loanName', header: 'Loan Type', width: '150px' },
                {
                    field: 'loanAmount', header: 'Amount', width: '120px',
                    render: function (v) { return (v !== null && v !== undefined) ? parseFloat(v).toFixed(2) : '-'; }
                },
                { field: 'currentLevelStatus', header: 'Status', width: '120px' },
                { field: 'currentLevelNo', header: 'Level', width: '70px' },
                { header: 'Assigned On', sortable: false, width: '150px', render: function (v, row) { return fmtDateTime(row.assignedOn); } },
                { header: 'Due On', sortable: false, width: '150px', render: function (v, row) { return fmtDateTime(row.escalationDueOn); } },
                {
                    header: 'Details', sortable: false, width: '90px',
                    render: function (v, row) {
                        var idx = currentRows.indexOf(row);
                        return '<button class="wg-btn wg-btn-outline" title="View Details" onclick="_openDetailModalByIdx(' + idx + ')"><i class="bx bx-show"></i></button>';
                    }
                },
                {
                    header: 'Action', sortable: false, width: '90px', stickyRight: true,
                    render: function (v, row) {
                        var idx = currentRows.indexOf(row);
                        return '<button class="wg-btn wg-btn-primary" title="Update Status" onclick="_openStatusModalByIdx(' + idx + ')"><i class="bx bx-edit"></i></button>';
                    }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerLoanManagement',
                    title: 'Pending Loan Applications',
                    icon: 'bx-money',
                    exportName: 'PendingLoanApplications',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
                grid.hideLoader();
            }
        }

        function openStatusModal(data) {
            currentLoanData = data;
            $('#loanStatusModal').modal('show');
        }

        function openDetailModal(data) {
            var rows = [
                ['Applicant Name', data.applicantName || data.requesterName || 'N/A'],
                ['Loan Type', data.loanType || data.loanName || 'N/A'],
                ['Loan Amount', data.loanAmount ? '₹' + data.loanAmount.toLocaleString() : 'N/A'],
                ['Application Date', data.applicationDate ? fmtDate(data.applicationDate) : 'N/A'],
                ['Tenure (Months)', data.tenureMonths || 'N/A'],
                ['Purpose', data.purpose || 'N/A'],
                ['Branch', data.branchName || 'N/A']
            ];

            var $tbody = $('#loanDetailTable tbody');
            $tbody.empty();
            rows.forEach(function (r) {
                $tbody.append('<tr><th>' + r[0] + '</th><td>' + r[1] + '</td></tr>');
            });

            historyGrid = null;
            $('#loanHistoryGridContainer').empty();
            $('#loanHistoryEmptyMsg').hide();

            if (data.previousApprovalLevelsJson) {
                try {
                    var historyData = JSON.parse(data.previousApprovalLevelsJson);

                    if (historyData && historyData.length > 0) {
                        historyGrid = WMSGrid.create({
                            container: 'loanHistoryGridContainer',
                            title: '',
                            data: historyData,
                            columns: [
                                { field: 'HistoryLevelNo', header: 'Level', width: '80px' },
                                { field: 'HistoryStatus', header: 'Status', width: '120px' },
                                { field: 'HistoryApproverName', header: 'Approver', width: '220px' },
                                { header: 'Assigned On', sortable: false, width: '160px', render: function (v, row) { return fmtDateTime(row.HistoryAssignedOn); } },
                                { header: 'Due On', sortable: false, width: '160px', render: function (v, row) { return fmtDateTime(row.HistoryEscalationDueOn); } }
                            ],
                            perPage: 100000,
                            features: { pagination: false, perPage: false, paginationInfo: false }
                        });
                    } else {
                        $('#loanHistoryEmptyMsg').show();
                    }
                } catch (e) {
                    console.error('Error parsing history JSON:', e);
                    $('#loanHistoryEmptyMsg').text('Error loading approval history').show();
                }
            } else {
                $('#loanHistoryEmptyMsg').show();
            }

            $('#loanDetailModal').modal('show');
        }

        function updateLoanApplication(data, statusId, statusName, remarks) {
            if (isUpdatingLoanStatus) return;
            isUpdatingLoanStatus = true;
            setBtnLoading('#confirmBtn', 'Updating...');

            // Prepare update data
            const updateData = {
                LoanApplicationId: data.loanApplicationID,
                ApprovalRequestLevelId: data.currentApprovalRequestLevelId,
                ApprovalRequestId: data.approvalRequestId,
                ApproverEmployeeId: parseInt(EmployeeId),
                StatusId: parseInt(statusId),
                Status: statusName,
                LevelNo: data.currentLevelNo,
                UpdatedBy: parseInt(EmployeeId),
                Remarks: remarks
            };

            $.ajax({
                type: "PUT",
                url: '@baseUrl/LoanApplicationAPI/LoanApproval',
                headers: {
                    'Authorization': 'Bearer ' + Token,
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify(updateData),
                success: function (response) {
                    if (response.isSuccess) {
                        const message = response.responseMessage || `Loan application ${statusName.toLowerCase()} successfully!`;
                        showToast(message, 'success');
                        $('#loanStatusModal').modal('hide');

                        // Refresh the grid
                        loadPendingLoanApplications();
                    } else {
                        const errorMessage = response.responseMessage || 'Failed to update loan application';
                        showToast(errorMessage, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error updating loan application:", error);
                    showToast('Error updating loan application. Please try again.', 'error');
                },
                complete: function () {
                    isUpdatingLoanStatus = false;
                    setBtnNormal('#confirmBtn', 'Confirm');
                }
            });
        }
    })();
</script>
