@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Inout record";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Employee IN-OUT Record</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="fromDate">From</label>
                    <input type="date" id="fromDate" />
                </div>

                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="toDate">To</label>
                    <input type="date" id="toDate" />
                </div>

                <div class="fg" style="flex:1 1 220px;min-width:200px;">
                    <label for="ddlMember">Employee Code</label>
                    <select id="ddlMember">
                        <option value="">Select</option>
                    </select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" id="btnGo" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" id="btnClear" class="btn btn-secondary btn-sm">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerInOut"></div>
        </div>
    </div>

</div>

<script>
    const baseUrl = '@baseUrl';
    const userId = parseInt(localStorage.getItem("EmployeeId"));
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany);
    const companyId = parseInt(companyDetails.CompanyId);
    const Token = localStorage.getItem("authToken");

    var now = new Date();
    var firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    var isLoadingInOut = false;
    var inOutGrid = null;

    // Format dates as YYYY-MM-DD for the date input
    // NOTE: named toInputDateStr (not formatDate) to avoid clashing with the
    // global window.formatDate defined in compoffleavemodal.js, which returns
    // a display string like "Aug 1, 2026" that native <input type="date"> rejects.
    var toInputDateStr = function (date) {
        var d = new Date(date),
            month = '' + (d.getMonth() + 1),
            day = '' + d.getDate(),
            year = d.getFullYear();

        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;

        return [year, month, day].join('-');
    };

    function fmtDate(dateStr) {
        if (!dateStr) return '-';
        var date = new Date(dateStr);
        return isNaN(date) ? '-' : date.toLocaleDateString('en-GB'); // dd/MM/yyyy
    }

    function renderInOutColumns() {
        return [
            { field: 'employeeCode', header: 'Employee Code', width: '130px', render: function (v) { return v || '-'; } },
            { field: 'fullName', header: 'Full Name', width: '180px', render: function (v) { return v || '-'; } },
            { field: 'branchName', header: 'Branch', width: '150px', render: function (v) { return v || '-'; } },
            { field: 'companyName', header: 'Company Name', width: '150px', render: function (v) { return v || '-'; } },
            { header: 'Shift Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.shiftDate); } },
            { field: 'inTime', header: 'In Time', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'outTime', header: 'Out Time', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'workingHours', header: 'Working Hours', width: '120px', render: function (v) { return (v || v === 0) ? Number(v).toFixed(2) : '-'; } },
            { field: 'attendanceStatus', header: 'Attendance Status', width: '150px', render: function (v) { return v || '-'; } },
            { field: 'salaryDay', header: 'Salary Day', width: '100px', render: function (v) { return (v || v === 0) ? Number(v).toFixed(1) : '-'; } }
        ];
    }

    function renderInOutGrid(data) {
        if (!inOutGrid) {
            inOutGrid = WMSGrid.create({
                container: 'gridContainerInOut',
                title: 'Employee IN-OUT Record',
                icon: 'bx-log-in-circle',
                exportName: 'EmployeeInOutRecord',
                data: data,
                columns: renderInOutColumns(),
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            inOutGrid.setData(data);
        }
    }

    function resetDetails() {
        $('#fromDate').val(toInputDateStr(firstDayOfMonth));
        $('#toDate').val(toInputDateStr(now));
        $('#ddlMember').val('');
        const fromDate = $('#fromDate').val();
        const toDate = $('#toDate').val();
        const memberId = $('#ddlMember').val();
        if (!fromDate || !toDate) return showToast('Please select from date and to date', 'warn');
        loadPunchDetails(userId, companyId, memberId, fromDate, toDate);
    }

    $(document).ready(function () {
        bindMember();
        resetDetails();
    });

    $('#btnClear').on('click', function () {
        resetDetails();
    });

    $('#btnGo').click(function () {
        if (isLoadingInOut) return;

        const fromDate = $('#fromDate').val();
        const toDate = $('#toDate').val();
        const memberId = $('#ddlMember').val();
        if (!fromDate || !toDate) { showToast('Please select from date and to date', 'warn'); return; }

        loadPunchDetails(userId, companyId, memberId, fromDate, toDate);
    });

    async function loadPunchDetails(userId, companyId, memberId, fromDate, toDate) {
        var drpMemberId = memberId ? memberId : 0;
        isLoadingInOut = true;
        setBtnLoading('#btnGo', 'Go');
        try {
            const response = await fetch('@baseUrl/EmployeeInOut/GetDateWiseAttendanceDetails', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${Token}`
                },
                body: JSON.stringify({
                    employeeId: userId,
                    companyId: companyId,
                    memberId: drpMemberId,
                    fromDate: fromDate,
                    toDate: toDate
                })
            });

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();
            if (data.isSuccess && Array.isArray(data.data)) {
                renderInOutGrid(data.data);
            } else {
                renderInOutGrid([]);
            }
        } catch (error) {
            console.error('Failed to load In/Out records:', error);
            showToast('Failed to load In/Out records.', 'error');
            renderInOutGrid([]);
        } finally {
            isLoadingInOut = false;
            setBtnNormal('#btnGo', 'Go');
        }
    }

    async function bindMember() {
        $.ajax({
            url: '@baseUrl/EmployeeInOut/GetEmployeesByReportingManager/' + userId,
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${Token}`
            },
            success: function (data) {
                if (data.isSuccess) {
                    var dropdown = $('#ddlMember');
                    dropdown.empty();
                    dropdown.append('<option disabled selected value="">Select</option>');
                    $.each(data.data, function (index, member) {
                        dropdown.append($('<option>', {
                            value: member.employeeId,
                            text: member.employeeCode + " - " + member.fullName
                        }));
                    });
                }
            },
            error: function (error) {
                console.error('Error fetching grade data:', error);
            }
        });
    }
</script>
