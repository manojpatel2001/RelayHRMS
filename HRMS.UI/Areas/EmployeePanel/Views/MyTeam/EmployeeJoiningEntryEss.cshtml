@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Joining Entry";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}

<style>
    .file-input-wrapper {
        position: relative;
        border: 2px dashed #D8E2E8;
        padding: 14px;
        border-radius: var(--r-sm);
        text-align: center;
        background: #F9FBFC;
        transition: all .2s ease;
    }

        .file-input-wrapper:hover {
            border-color: #2F6F8E;
            background: #F0F5F8;
        }

        .file-input-wrapper input[type="file"] {
            cursor: pointer;
            width: 100%;
        }

    /* Grid Styles - Full Width Fix (modal-internal Relation/Document grids only) */
    #GridRelationContainer,
    #GridDocumentContainer {
        width: 100% !important;
        overflow-x: auto;
    }
</style>

<div class="wms-form-page">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Employee Joining Entries</h6>
            <button id="addEmployeeJoining" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add Employee Joining
            </button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 170px;min-width:160px;">
                    <label for="ddlSearchBy">Search By</label>
                    <select id="ddlSearchBy">
                        <option value="0">-- Select --</option>
                        <option value="EmployeeName">Employee Name</option>
                        <option value="Department">Department</option>
                        <option value="Designation">Designation</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="txtSearchFor">Search For</label>
                    <input type="text" id="txtSearchFor" placeholder="Type to search..." disabled />
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="goButtonId">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearButtonId">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="employeeJoiningGridContainer"></div>
        </div>
    </div>
</div>

<!-- Employee Joining Modal -->
<div class="modal fade" id="employeeJoiningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title">
                    <span class="formType">Add</span> Employee Joining Entry
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs mb-0" id="employeeJoiningTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-2" type="button" role="tab" data-tabname="employee-info"><i class="bx bx-id-card"></i> Employee Info</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-2" type="button" role="tab" data-tabname="joining-details"><i class="bx bx-buildings"></i> Joining Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-2" type="button" role="tab" data-tabname="salary-details"><i class="bx bx-money"></i> Salary Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-2" type="button" role="tab" data-tabname="contact-details"><i class="bx bx-phone"></i> Contact Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-2" type="button" role="tab" data-tabname="document-details"><i class="bx bx-file"></i> Documents</button>
                    </li>
                </ul>

                <div class="card-body" style="padding-top:18px;">

                    <!-- Employee Info Tab -->
                    <div id="employee-info" class="tab-content">
                        <div class="form-grid-3">
                            <div class="fg">
                                <label for="operationType">Operation Type</label>
                                <select id="operationType">
                                    <option value="">Select</option>
                                    <option selected>Add New</option>
                                </select>
                            </div>

                            <div class="fg fg-req">
                                <label for="referenceNo">Reference No</label>
                                <select id="referenceNo">
                                    <option value="" selected disabled>Select Reference</option>
                                </select>
                                <span class="field-validation-error" id="errorReference" style="display:none;">Please select reference no</span>
                            </div>

                            <div class="fg">
                                <label for="employeeName">Name</label>
                                <input type="text" id="employeeName" disabled>
                                <span class="field-validation-error" id="errorName" style="display:none;">Please enter name</span>
                            </div>

                            <div class="fg">
                                <label for="employeeEmail">Email</label>
                                <input type="email" id="employeeEmail" disabled placeholder="email@example.com">
                                <span class="field-validation-error" id="errorEmail" style="display:none;">Please enter email</span>
                            </div>

                            <div class="fg">
                                <label for="lastEducation">Last Education</label>
                                <input type="text" id="lastEducation" disabled placeholder="Highest qualification">
                                <span class="field-validation-error" id="errorLastEducation" style="display:none;">Please enter last education</span>
                            </div>

                            <div class="fg">
                                <label for="maritalStatus">Marital Status</label>
                                <select id="maritalStatus">
                                    <option value="">Select</option>
                                    <option>Single</option>
                                    <option>Married</option>
                                </select>
                                <span class="field-validation-error" id="errorMaritalStatus" style="display:none;">Please select marital status</span>
                            </div>

                            <div class="fg">
                                <label for="dateOfBirth">Date of Birth</label>
                                <input type="date" id="dateOfBirth">
                                <span class="field-validation-error" id="errorDateofBirth" style="display:none;">Please select date of birth</span>
                            </div>

                            <div class="fg">
                                <label for="totalExperience">Total Experience</label>
                                <input type="text" id="totalExperience" disabled placeholder="Years of experience">
                                <span class="field-validation-error" id="errorTotalExperience" style="display:none;">Please enter total experience</span>
                            </div>

                            <div class="fg">
                                <label for="mobileNo">Mobile No.</label>
                                <input type="text" id="mobileNo" disabled placeholder="10-digit mobile number">
                            </div>

                            <div class="fg">
                                <label for="bloodGroup">Blood Group</label>
                                <input type="text" id="bloodGroup" placeholder="e.g., O+, A+, B+">
                            </div>

                            <div class="fg" style="grid-column:1 / -1;">
                                <label for="presentAddress">Address (Present)</label>
                                <textarea id="presentAddress" rows="2" placeholder="Enter present address"></textarea>
                                <span class="field-validation-error" id="errorPresentAddress" style="display:none;">Please enter present address</span>
                            </div>

                            <div class="fg" style="grid-column:1 / -1;">
                                <label for="permanentAddress">Address (Permanent)</label>
                                <textarea id="permanentAddress" rows="2" placeholder="Enter permanent address"></textarea>
                                <span class="field-validation-error" id="errorPermanentAddress" style="display:none;">Please enter permanent address</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" id="btnEmployeeInfo" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                <span class="btn-spinner-icon"></span>
                                <span class="btn-label-text">Save</span>
                            </button>
                        </div>
                    </div>

                    <!-- Joining Details Tab -->
                    <div id="joining-details" class="tab-content d-none">
                        <div class="form-grid-3">
                            <div class="fg">
                                <label for="branchName">Branch Name</label>
                                <input type="text" id="branchName" disabled>
                            </div>
                            <div class="fg">
                                <label for="reportingTo">Reporting To</label>
                                <input type="text" id="reportingTo" disabled>
                            </div>
                            <div class="fg">
                                <label for="department">Department</label>
                                <input type="text" id="department" disabled>
                            </div>
                            <div class="fg">
                                <label for="designation">Designation</label>
                                <input type="text" id="designation" disabled>
                            </div>
                            <div class="fg">
                                <label for="dateOfJoining">Date of Joining</label>
                                <input type="date" id="dateOfJoining" disabled>
                            </div>
                            <div class="fg">
                                <label for="erpCode">ERP CODE</label>
                                <input type="text" id="erpCode" placeholder="ERP code">
                            </div>
                            <div class="fg">
                                <label for="previousCompanyUAN">Previous Company UAN</label>
                                <input type="text" id="previousCompanyUAN" placeholder="UAN number">
                            </div>
                            <div class="fg">
                                <label for="previousCompanyESIC">Previous Company ESIC</label>
                                <input type="text" id="previousCompanyESIC" placeholder="ESIC number">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" id="btnJoiningDetails" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                <span class="btn-spinner-icon"></span>
                                <span class="btn-label-text">Save</span>
                            </button>
                        </div>
                    </div>

                    <!-- Salary Details Tab -->
                    <div id="salary-details" class="tab-content d-none">
                        <div class="form-grid-3">
                            <div class="fg fg-req">
                                <label for="pfUAN">PF UAN</label>
                                <input type="text" id="pfUAN" placeholder="PF UAN number">
                                <span class="field-validation-error" id="errorpfuan" style="display:none;">Please enter PF UAN</span>
                            </div>
                            <div class="fg fg-req">
                                <label for="esicNo">ESIC No.</label>
                                <input type="text" id="esicNo" placeholder="ESIC number">
                                <span class="field-validation-error" id="errorESICNo" style="display:none;">Please enter ESIC No</span>
                            </div>
                            <div class="fg fg-req">
                                <label for="pan">PAN</label>
                                <input type="text" id="pan" placeholder="PAN number">
                                <span class="field-validation-error" id="errorPanPAN" style="display:none;">Please enter PAN</span>
                            </div>
                            <div class="fg">
                                <label for="grossSalary">Gross Salary</label>
                                <input type="text" id="grossSalary" disabled>
                                <span class="field-validation-error" id="errorGrossSalary" style="display:none;">Please enter gross salary</span>
                            </div>
                            <div class="fg">
                                <label for="netSalary">Net Salary</label>
                                <input type="text" id="netSalary" disabled>
                                <span class="field-validation-error" id="errorNetSalary" style="display:none;">Please enter net salary</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" id="btnSalary" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                <span class="btn-spinner-icon"></span>
                                <span class="btn-label-text">Save</span>
                            </button>
                        </div>
                    </div>

                    <!-- Contact Details Tab -->
                    <div id="contact-details" class="tab-content d-none">
                        <form id="manpowerRelationForm">
                            <div class="form-grid-3">
                                <div class="fg fg-req">
                                    <label for="contactPersonName">Contact Person Name</label>
                                    <input type="text" id="contactPersonName" placeholder="Person name">
                                    <span class="field-validation-error" id="errorContactName" style="display:none;">Please enter a name</span>
                                </div>

                                <div class="fg fg-req">
                                    <label for="contactPersonRelation">Relationship</label>
                                    <select id="contactPersonRelation">
                                        <option value="" selected disabled>Select Relation</option>
                                    </select>
                                    <span class="field-validation-error" id="errorRelation" style="display:none;">Please select a relation</span>
                                </div>

                                <div class="fg fg-req">
                                    <label for="contactMobileNo">Mobile No.</label>
                                    <input type="text" id="contactMobileNo" placeholder="Mobile number">
                                    <span class="field-validation-error" id="errorMobile" style="display:none;">Please enter a valid mobile number</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline btn-sm" onclick="ResetForm()">Clear</button>
                                <button type="button" id="btnRelation" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                    <span class="btn-spinner-icon"></span>
                                    <span class="btn-label-text">Save</span>
                                </button>
                            </div>
                        </form>

                        <div class="divider"></div>

                        <div style="position: relative;" id="gridTagRelation">
                            <div id="grid-loader-relation" class="grid-loader justify-content-center align-items-center flex-column" style="display: none; position: absolute; inset: 0; background: rgba(255,255,255,0.6); z-index: 10;">
                                <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner" style="width: 30px; height: 30px; animation: spin 1s linear infinite;" />
                                <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                            </div>
                            <div id="GridRelationContainer"></div>
                        </div>
                    </div>

                    <!-- Document Details Tab -->
                    <div id="document-details" class="tab-content d-none">
                        <form>
                            <div class="form-grid-3">
                                <div class="fg fg-req">
                                    <label for="documentName">Document Name</label>
                                    <select id="documentName">
                                        <option value="" selected disabled>Select Document</option>
                                    </select>
                                    <span class="field-validation-error" id="errorDocument" style="display:none;">Please select document</span>
                                </div>

                                <div class="fg">
                                    <label for="document">Document</label>
                                    <div class="file-input-wrapper">
                                        <input type="file" id="document" accept="image/*,application/pdf">
                                        <small>Choose file or drag here</small>
                                    </div>
                                </div>

                                <div class="fg">
                                    <label for="dateOfExpiry">Date of Expiry</label>
                                    <input type="date" id="dateOfExpiry">
                                </div>

                                <div class="fg" style="grid-column:1 / -1;">
                                    <label for="comment">Comment</label>
                                    <textarea id="comment" placeholder="comment"></textarea>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline btn-sm" onclick="ResetDocumentForm()">Clear</button>
                                <button type="button" id="btnDocument" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                    <span class="btn-spinner-icon"></span>
                                    <span class="btn-label-text">Save</span>
                                </button>
                            </div>
                        </form>

                        <div class="divider"></div>

                        <div style="position: relative;" id="gridTagDocument">
                            <div id="grid-loader-document" class="grid-loader justify-content-center align-items-center flex-column" style="display: none; position: absolute; inset: 0; background: rgba(255,255,255,0.6); z-index: 10;">
                                <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner" style="width: 30px; height: 30px; animation: spin 1s linear infinite;" />
                                <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                            </div>
                            <div id="GridDocumentContainer"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    // =============================================
    // GLOBAL: Update ke liye data store karna
    // =============================================
    var _updateManpowerRequisitionId = null;
    var _employeeJoiningCache = {};

    $("#addEmployeeJoining").click(() => {
        _updateManpowerRequisitionId = null;
        resetAllForms();
        loadRefrence();
        loadDocumentType();
        loadBindRelationShiptOption();
        $(".formType").text("Add");
        setBtnNormal('#btnEmployeeInfo', 'Save');
        setBtnNormal('#btnJoiningDetails', 'Save');
        setBtnNormal('#btnSalary', 'Save');
        $("#employeeJoiningModal").modal('show');
    });

    // Tab switching (Bootstrap nav-tabs / partial-section convention)
    $('#employeeJoiningTabs').on('click', '.nav-link', function () {
        var tabName = $(this).data('tabname');
        $('#employeeJoiningTabs .nav-link').removeClass('active');
        $(this).addClass('active');
        $('.modal-body .tab-content').addClass('d-none');
        $('#' + tabName).removeClass('d-none');
    });

    $(document).ready(function () {
        employeeJoiningDataTable();
        loadRefrence();
        loadDocumentType();
        loadBindRelationShiptOption();

        $('#ddlSearchBy').on('change', function () {
            $('#txtSearchFor').prop('disabled', $(this).val() === '0');
        });

        $('#goButtonId').on('click', function () {
            employeeJoiningDataTable();
        });

        $('#txtSearchFor').on('keypress', function (e) {
            if (e.which === 13) { employeeJoiningDataTable(); }
        });

        $('#clearButtonId').on('click', function () {
            $('#ddlSearchBy').val('0');
            $('#txtSearchFor').val('').prop('disabled', true);
            employeeJoiningDataTable();
        });
    });

    function fmtJoiningDate(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + d.getFullYear();
    }

    function escJoiningAttr(v) {
        return (v == null ? '' : String(v)).replace(/'/g, "\\'");
    }

    // Main grid — standard HRMS WMSGrid
    var employeeJoiningGrid = WMSGrid.create({
        container: 'employeeJoiningGridContainer',
        title: 'All Employee Joining Entries',
        icon: 'bx-user-plus',
        exportName: 'EmployeeJoiningEntries',
        columns: [
            { field: 'SerialNo', header: 'Serial No', width: '110px' },
            { field: 'EmployeeName', header: 'Employee Name', width: '170px' },
            { field: 'PersonalEmail', header: 'Email', width: '190px' },
            { field: 'ContactNumber', header: 'Contact', width: '130px' },
            { field: 'DepartmentName', header: 'Department', width: '150px' },
            { field: 'DesignationName', header: 'Designation', width: '150px' },
            { field: 'DateOfJoining', header: 'Date of Joining', width: '130px', render: function (v) { return fmtJoiningDate(v); } },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '120px',
                render: function (v, row) {
                    return '<button class="wg-btn wg-btn-primary" title="Update" onclick="_editEmployeeJoining(' + row.ManpowerRequisitionId + ')"><i class="bx bx-edit"></i></button> ' +
                           '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteEmployeeJoining(' + row.ManpowerRequisitionId + ',\'' + escJoiningAttr(row.EmployeeName) + '\')"><i class="bx bx-trash"></i></button>';
                }
            }
        ],
        features: { export: true }
    });

    // Main data table
    function employeeJoiningDataTable() {
        var searchBy = $('#ddlSearchBy').val();
        var searchFor = $('#txtSearchFor').val().trim();
        var statusValue = 'Approved/Rejected';
        var requestData = {
            CompId: CompanyId,
            Emplooyeid: EmployeeId,
            Status: statusValue,
            SearchType: searchBy === '0' ? null : searchBy,
            SearchFor: searchFor || null
        };

        try {
            employeeJoiningGrid.showLoader();
            $.ajax({
                type: 'POST',
                url: '@baseUrl/ManpowerRequisitionAPI/GetAllJoingWithApprovalCheck',
                data: JSON.stringify(requestData),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (data) {
                    employeeJoiningGrid.hideLoader();

                    var actualData = [];
                    if (data) {
                        if (Array.isArray(data)) {
                            actualData = data;
                        } else if (data.isSuccess && data.data) {
                            if (Array.isArray(data.data)) {
                                actualData = data.data;
                            } else if (Array.isArray(data.data.data)) {
                                actualData = data.data.data;
                            }
                        } else if (Array.isArray(data.data)) {
                            actualData = data.data;
                        }
                    }

                    _employeeJoiningCache = {};
                    actualData.forEach(function (r) { _employeeJoiningCache[r.ManpowerRequisitionId] = r; });
                    employeeJoiningGrid.setData(actualData);
                },
                error: function (xhr, status, error) {
                    employeeJoiningGrid.hideLoader();
                    console.error("AJAX Error: " + status + " - " + error);
                    showToast('Failed to load employee joining entries.', 'error');
                }
            });
        } catch (e) {
            console.error("Error in employeeJoiningDataTable:", e);
            employeeJoiningGrid.hideLoader();
        }
    }

    window._editEmployeeJoining = function (id) {
        var data = _employeeJoiningCache[id];
        if (!data) return;
        updateEmployeeJoining(data);
    };

    window._deleteEmployeeJoining = function (id, name) {
        wmsConfirm('Are you sure you want to delete the joining entry for <strong>"' + (name || 'this employee') + '"</strong>?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                url: '@baseUrl/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                type: 'DELETE',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify({ id: id, deletedBy: EmployeeId }),
                success: function (response) {
                    showToast(response.isSuccess ? (response.responseMessage || 'Deleted successfully.') : (response.responseMessage || 'Something went wrong.'), response.isSuccess ? 'success' : 'error');
                    if (response.isSuccess) employeeJoiningDataTable();
                },
                error: function (error) {
                    console.log(error);
                    showToast('Error deleting record.', 'error');
                }
            });
        });
    };

    // =============================================
    // BIND SERIAL - autoSelectId support ke sath
    // =============================================
    function bindSerial(data, autoSelectId) {
        var $sel = $('#referenceNo');
        $sel.off('change.bindSerial');
        $sel.empty().append('<option value="" selected disabled>Select Reference</option>');
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item.manpowerRequisitionId, text: item.serialNo }));
        });

        $sel.on('change.bindSerial', function () {
            var val = $(this).val();
            if (val) {
                loadManpowerDetails(val);
                ManpowerRelationDataTable();
                ManpowerDocumentDataTable();
            }
        });

        // AUTO SELECT - Update ke waqt reference auto fill
        if (autoSelectId) {
            $sel.val(autoSelectId);
        }
    }

    async function bindDocument(data) {
        var $sel = $('#documentName');
        $sel.empty().append('<option value="" selected disabled>Select Document</option>');
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item.documentTypeId, text: item.documentName }));
        });
    }

    async function bindRelationShipOptions(data) {
        var $sel = $('#contactPersonRelation');
        $sel.empty().append('<option value="" selected disabled>Select Relation</option>');
        (data || []).forEach(function (item) {
            $sel.append($('<option>', { value: item.relationShipId, text: item.relationName }));
        });
    }

    function resetAllForms() {
        $('#operationType').val('');
        $('#employeeName').val('');
        $('#employeeEmail').val('');
