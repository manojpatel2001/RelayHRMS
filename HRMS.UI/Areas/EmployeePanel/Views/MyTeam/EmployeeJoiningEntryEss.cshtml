<script src="~/assets/js/jquery.min.js"></script>
<script>
    var companyDetails = JSON.parse(localStorage.getItem('selectedCompany'));
    const CompanyId = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    // =============================================
    // GLOBAL: Update ke liye data store karna
    // =============================================
    var _updateManpowerRequisitionId = null;

    // =============================================
    // ADD BUTTON
    // =============================================
    $("#addEmployeeJoining").click(() => {
        _updateManpowerRequisitionId = null;
        resetAllForms();
        loadRefrence();
        loadDocumentType();
        loadBindRelationShiptOption();
        $(".formType").text("Add");
        $("#btnEmployeeInfo").text("Save");
        $("#btnJoiningDetails").text("Save");
        $("#btnSalary").text("Save");
        $("#employeeJoiningModal").modal('show');
    });

    // =============================================
    // TAB SWITCHING
    // =============================================
    function openTab(evt, tabName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].classList.remove("active");
        }
        tablinks = document.getElementsByClassName("tab");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    // =============================================
    // PAGE LOAD
    // =============================================
    $(document).ready(function () {
        employeeJoiningDataTable();
        loadRefrence();
        loadDocumentType();
        loadBindRelationShiptOption();

        $('#ddlSearchBy').on('change', function () {
            if ($(this).val() === '0') {
                $('#txtSearchFor').val('').prop('disabled', true);
            } else {
                $('#txtSearchFor').prop('disabled', false).focus();
            }
        });

        $('#goButtonId').on('click', function () {
            employeeJoiningDataTable();
        });

        $('#txtSearchFor').on('keypress', function (e) {
            if (e.which === 13) { employeeJoiningDataTable(); }
        });

        $('#clearButtonId').on('click', function () {
            $('#ddlSearchBy').val('0');
            $('#txtSearchFor').val('').prop('disabled', true);
            employeeJoiningDataTable();
        });
    });

    // =============================================
    // MAIN GRID - Dispose + Recreate
    // SerialNo plain text only - nothing opens
    // =============================================
    function employeeJoiningDataTable() {
        if ($("#GridContainer").data("dxDataGrid")) {
            $("#GridContainer").dxDataGrid("dispose");
        }
        $("#GridContainer").empty();

        var searchBy = $('#ddlSearchBy').val();
        var searchFor = $('#txtSearchFor').val().trim();
          var statusValue ='Approved/Rejected';;
        var requestData = {
            CompId: CompanyId,
            Emplooyeid: EmployeeId,
            Status: statusValue,
            SearchType: searchBy === '0' ? null : searchBy,
            SearchFor: searchFor || null
        };

        $('#grid-loader').css('display', 'flex');
        $('#rowCount').text('');

        $.ajax({
            type: 'POST',
            url: '@baseUrl/ManpowerRequisitionAPI/GetAllJoingWithApprovalCheck',
            data: JSON.stringify(requestData),
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                $('#grid-loader').hide();

                var actualData = [];
                if (data) {
                    if (Array.isArray(data)) {
                        actualData = data;
                    } else if (data.isSuccess && data.data) {
                        if (Array.isArray(data.data)) {
                            actualData = data.data;
                        } else if (Array.isArray(data.data.data)) {
                            actualData = data.data.data;
                        }
                    } else if (Array.isArray(data.data)) {
                        actualData = data.data;
                    }
                }

                if (!actualData || actualData.length === 0) {
                    $('#GridContainer').html('<div class="text-center text-muted py-3" style="padding:20px;">No records found.</div>');
                    $('#rowCount').text('Total Records: 0');
                    return;
                }

                $("#GridContainer").dxDataGrid({
                    dataSource: actualData,
                    columns: [
                        {
                            // Plain serial number - koi click nahi, kuch open nahi
                            dataField: 'SerialNo',
                            caption: 'Sr. No',
                            width: 70,
                            allowSorting: false,
                            allowFiltering: false,
                            allowEditing: false,
                            allowHeaderFiltering: false,
                            cellTemplate: function (container, options) {
                                $('<div>')
                                    .css({ textAlign: 'center', userSelect: 'none', cursor: 'default' })
                                    .text(options.value != null ? options.value : (options.rowIndex + 1))
                                    .appendTo(container);
                            }
                        },
                        { dataField: 'EmployeeName', caption: 'Employee Name', minWidth: 150 },
                        { dataField: 'PersonalEmail', caption: 'Email', minWidth: 180 },
                        { dataField: 'ContactNumber', caption: 'Contact', minWidth: 120 },
                        { dataField: 'DepartmentName', caption: 'Department', minWidth: 150 },
                        { dataField: 'DesignationName', caption: 'Designation', minWidth: 150 },
                        {
                            dataField: 'DateOfJoining',
                            caption: 'Date of Joining',
                            minWidth: 120,
                            dataType: 'date',
                            format: 'dd-MM-yyyy'
                        },
                        {
                            dataField: '',
                            caption: 'Edit',
                            alignment: 'center',
                            width: 60,
                            allowSorting: false,
                            allowFiltering: false,
                            allowHeaderFiltering: false,
                            cellTemplate: function (container, options) {
                                $('<div class="d-flex order-actions">')
                                    .append(
                                        $('<a href="javascript:;" class="edit-action" title="Update">')
                                            .html('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16"><path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456l-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/></svg>')
                                            .on('click', function () { updateEmployeeJoining(options.data); })
                                    )
                                    .appendTo(container);
                            }
                        },
                        {
                            dataField: '',
                            caption: 'Delete',
                            alignment: 'center',
                            width: 60,
                            allowSorting: false,
                            allowFiltering: false,
                            allowHeaderFiltering: false,
                            cellTemplate: function (container, options) {
                                $('<div class="d-flex order-actions">')
                                    .append(
                                        $('<a href="javascript:;" class="delete-action" title="Delete">')
                                            .html('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16"><path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/></svg>')
                                            .on('click', function () { deleteEmployeeJoining(options.data); })
                                    )
                                    .appendTo(container);
                            }
                        }
                    ],
                    columnAutoWidth: true,
                    width: '100%',
                    wordWrapEnabled: false,
                    rowAlternationEnabled: false,
                    showBorders: true,
                    paging: { pageSize: 10 },
                    pager: {
                        showPageSizeSelector: true,
                        allowedPageSizes: [10, 25, 50, 100],
                        showInfo: true
                    },
                    headerFilter: { visible: false },
                    filterRow: { visible: true, applyFilter: "auto" },
                    allowColumnResizing: true,
                    searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                    scrolling: {
                        mode: "standard",
                        useNative: false,
                        showScrollbar: "always",
                        columnRenderingMode: "virtual"
                    },
                    onContentReady: function (e) {
                        $('#rowCount').html('Total Records: ' + e.component.totalCount());
                    }
                });
            },
            error: function (xhr, status, error) {
                $('#grid-loader').hide();
                $('#GridContainer').html('<div class="text-center text-muted py-3" style="padding:20px;">Error loading data.</div>');
                console.error("AJAX Error: " + status + " - " + error);
            }
        });
    }

    // =============================================
    // DELETE
    // =============================================
    function deleteEmployeeJoining(data) {
        if (!confirm("Are you sure you want to delete this employee joining entry?")) {
            return;
        }
        var deleteObj = {
            id: data.ManpowerRequisitionId,
            deletedBy: EmployeeId
        };
        $.ajax({
            url: '@baseUrl/ManpowerRequisitionAPI/DeleteManpowerRequisition',
            type: 'DELETE',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(deleteObj),
            success: function (response) {
                if (response.isSuccess) {
                    round_success_noti(response.responseMessage);
                    employeeJoiningDataTable();
                } else {
                    round_error_noti(response.responseMessage);
                }
            },
            error: function (error) {
                console.log(error);
                round_error_noti("Error deleting record");
            }
        });
    }

    // =============================================
    // BIND SERIAL - autoSelectId support ke sath
    // =============================================
    function bindSerial(data, autoSelectId) {
        const existing = $('#referenceNo').data('searchableSelect');
        if (existing) existing.destroy();

        $('#referenceNo').val('');

        $('#referenceNo').searchableSelect({
            data: data || [],
            valueKey: 'manpowerRequisitionId',
            textKey: 'serialNo',
            placeholder: 'Select Reference',
            searchPlaceholder: 'Search reference...',
            onChange: function (item) {
                if (item && item.manpowerRequisitionId) {
                    loadManpowerDetails(item.manpowerRequisitionId);
                    ManpowerRelationDataTable();
                    ManpowerDocumentDataTable();
                }
            }
        });

        // AUTO SELECT - Update ke waqt reference auto fill
        if (autoSelectId) {
            setTimeout(function () {
                var matchedItem = null;
                (data || []).forEach(function (item) {
                    if (String(item.manpowerRequisitionId) === String(autoSelectId)) {
                        matchedItem = item;
                    }
                });

                if (matchedItem) {
                    $('#referenceNo').val(matchedItem.serialNo);

                    var pluginInstance = $('#referenceNo').data('searchableSelect');
                    if (pluginInstance) {
                        if (typeof pluginInstance.setValue === 'function') {
                            pluginInstance.setValue(autoSelectId);
                        }
                        if (pluginInstance.hasOwnProperty('selectedValue')) {
                            pluginInstance.selectedValue = autoSelectId;
                        }
                        if (pluginInstance.hasOwnProperty('_value')) {
                            pluginInstance._value = autoSelectId;
                        }
                        if (pluginInstance.hasOwnProperty('currentValue')) {
                            pluginInstance.currentValue = autoSelectId;
                        }
                    }

                    setTimeout(function () {
                        $('#referenceWrapper .searchable-select-options .option-item, #referenceWrapper .searchable-select-options li, #referenceWrapper .searchable-select-options div[data-value]').each(function () {
                            var itemVal = $(this).attr('data-value') || $(this).data('value');
                            if (String(itemVal) === String(autoSelectId)) {
                                $(this).addClass('selected active');
                            }
                        });
                    }, 100);
                }
            }, 400);
        } else {
            setTimeout(() => {
                const instance = $('#referenceNo').data('searchableSelect');
                if (instance && !instance.getValue()) {
                    $('#referenceNo').attr('placeholder', 'Select Reference');
                    $('#referenceNo').val('');
                }
            }, 100);
        }
    }

    async function bindDocument(data) {
        const existing = $('#documentName').data('searchableSelect');
        if (existing) existing.destroy();

        $('#documentName').val('');

        $('#documentName').searchableSelect({
            data: data || [],
            valueKey: 'documentTypeId',
            textKey: 'documentName',
            placeholder: 'Select Document',
            searchPlaceholder: 'Search document...',
            onChange: function (item) { }
        });

        setTimeout(() => {
            const instance = $('#documentName').data('searchableSelect');
            if (instance && !instance.getValue()) {
                $('#documentName').attr('placeholder', 'Select Document');
                $('#documentName').val('');
            }
        }, 100);
    }

    async function bindRelationShipOptions(data) {
        const existing = $('#contactPersonRelation').data('searchableSelect');
        if (existing) existing.destroy();

        $('#contactPersonRelation').val('');

        $('#contactPersonRelation').searchableSelect({
            data: data || [],
            valueKey: 'relationShipId',
            textKey: 'relationName',
            placeholder: 'Select Relation',
            searchPlaceholder: 'Search relation...',
            onChange: function (item) { }
        });

        setTimeout(() => {
            const instance = $('#contactPersonRelation').data('searchableSelect');
            if (instance && !instance.getValue()) {
                $('#contactPersonRelation').attr('placeholder', 'Select Relation');
                $('#contactPersonRelation').val('');
            }
        }, 100);
    }

    // =============================================
    // RESET ALL FORMS
    // =============================================
    function resetAllForms() {
        $('#operationType').val('');
        $('#employeeName').val('');
        $('#employeeEmail').val('');
        $('#presentAddress').val('');
        $('#permanentAddress').val('');
        $('#lastEducation').val('');
        $('#maritalStatus').val('');
        $('#dateOfBirth').val('');
        $('#totalExperience').val('');
        $('#mobileNo').val('');
        $('#bloodGroup').val('');
        $('#branchName').val('');
        $('#reportingTo').val('');
        $('#department').val('');
        $('#designation').val('');
        $('#dateOfJoining').val('');
        $('#erpCode').val('');
        $('#previousCompanyUAN').val('');
        $('#previousCompanyESIC').val('');
        $('#pfUAN').val('');
        $('#esicNo').val('');
        $('#pan').val('');
        $('#grossSalary').val('');
        $('#netSalary').val('');
        $('#contactPersonName').val('');
        $('#contactMobileNo').val('');
        $('#comment').val('');
        $('#dateOfExpiry').val('');
        $('#document').val('');

        $(".error-message").hide();
        $(".is-invalid").removeClass("is-invalid");

        $(".tab").removeClass("active");
        $(".tab-content").removeClass("active");
        $(".tab:first").addClass("active");
        $("#employee-info").addClass("active");

        const refInstance = $('#referenceNo').data('searchableSelect');
        if (refInstance) refInstance.clear();

        const docInstance = $('#documentName').data('searchableSelect');
        if (docInstance) docInstance.clear();

        const relInstance = $('#contactPersonRelation').data('searchableSelect');
        if (relInstance) relInstance.clear();

        if ($("#GridRelationContainer").data("dxDataGrid")) {
            $("#GridRelationContainer").dxDataGrid("instance").option("dataSource", []);
        }
        if ($("#GridDocumentContainer").data("dxDataGrid")) {
            $("#GridDocumentContainer").dxDataGrid("instance").option("dataSource", []);
        }
    }

    // =============================================
    // LOAD REFERENCE - autoSelectId support ke sath
    // =============================================
    function loadRefrence(autoSelectId) {
        return new Promise((resolve, reject) => {
            $.ajax({
                type: 'POST',
                url: '@baseUrl/ManpowerRequisitionAPI/GetAllSerialNo',
                data: JSON.stringify({ CompanyId: CompanyId, EmployeeId: EmployeeId }),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (response) {
                    if (response.isSuccess) {
                        bindSerial(response.data, autoSelectId || null);
                        resolve(response.data);
                    } else {
                        reject();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    reject(error);
                }
            });
        });
    }

    // =============================================
    // UPDATE
    // =============================================
    function updateEmployeeJoining(data) {
        resetAllForms();

        _updateManpowerRequisitionId = data.ManpowerRequisitionId;

        $(".formType").text("Update");
        $("#btnEmployeeInfo").text("Update");
        $("#btnJoiningDetails").text("Update");
        $("#btnSalary").text("Update");

        $("#employeeJoiningModal").modal('show');

        $.ajax({
            type: 'GET',
            url: '@baseUrl/ManpowerRequisitionAPI/GetManpowerRequisitionByManpowerRequisitionId/' + data.ManpowerRequisitionId,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    var apiData = response.data;

                    $('#referenceNo').val(apiData.SerialNo || data.SerialNo || '');
                    $('#operationType').val(apiData.OperationType || '');
                    $('#employeeName').val(apiData.EmployeeName || '');
                    $('#employeeEmail').val(apiData.PersonalEmail || '');
                    $('#presentAddress').val(apiData.PresentAddress || '');
                    $('#permanentAddress').val(apiData.PermanentAddress || '');
                    $('#lastEducation').val(apiData.EducationalQualification || '');
                    $('#maritalStatus').val(apiData.MaritalStatus || '');

                    if (apiData.DateOfBirth) {
                        $('#dateOfBirth').val(new Date(apiData.DateOfBirth).toISOString().split('T')[0]);
                    }

                    $('#totalExperience').val(apiData.ExperienceRange || '');
                    $('#mobileNo').val(apiData.ContactNumber || '');
                    $('#bloodGroup').val(apiData.BloodGroup || '');
                    $('#branchName').val(apiData.BranchName || '');
                    $('#reportingTo').val(apiData.ReportingName || '');
                    $('#department').val(apiData.DepartmentName || '');
                    $('#designation').val(apiData.DesignationName || '');

                    if (apiData.DateOfJoining) {
                        $('#dateOfJoining').val(new Date(apiData.DateOfJoining).toISOString().split('T')[0]);
                    }

                    $('#erpCode').val(apiData.ErpCode || '');
                    $('#previousCompanyUAN').val(apiData.PreviousCompanyUAN || '');
                    $('#previousCompanyESIC').val(apiData.PreviousCompanyESIC || '');
                    $('#grossSalary').val(apiData.GrossSalary || '');
                    $('#netSalary').val(apiData.TakeHomeSalary || '');
                    $('#esicNo').val(apiData.EsicNo || '');
                    $('#pfUAN').val(apiData.PFUAN || '');
                    $('#pan').val(apiData.Pan || '');
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading data:", error);
                round_error_noti("Data load karne mein error aaya");
            }
        });

        Promise.all([
            loadRefrence(data.ManpowerRequisitionId),
            loadDocumentType(),
            loadBindRelationShiptOption()
        ]).then(function () {
            setTimeout(function () {
                ManpowerRelationDataTable();
                ManpowerDocumentDataTable();
            }, 500);
        });
    }

    // =============================================
    // LOAD MANPOWER DETAILS (on reference select)
    // =============================================
    async function loadManpowerDetails(Id) {
        $.ajax({
            type: 'GET',
            url: '@baseUrl/ManpowerRequisitionAPI/GetManpowerRequisitionByManpowerRequisitionId/' + Id,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess) {
                    populateFormWithApiData(response.data);
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX Error:", status, error);
            }
        });
    }

    function populateFormWithApiData(apiData) {
        $('#operationType').val(apiData.OperationType || '');
        $('#employeeName').val(apiData.EmployeeName || '');
        $('#employeeEmail').val(apiData.PersonalEmail || '');
        $('#presentAddress').val(apiData.PresentAddress || '');
        $('#permanentAddress').val(apiData.PermanentAddress || '');
        $('#lastEducation').val(apiData.EducationalQualification || '');
        $('#maritalStatus').val(apiData.MaritalStatus || '');

        if (apiData.DateOfBirth) {
