    function ValidateDocumentForm() {
        let isValid = true;
        const documentName = $("#documentName").val();
        const documentFile = $("#document")[0].files[0];
        const manpowerRequisitionId = ($('#referenceNo').val())
            || _updateManpowerRequisitionId;

        if (!manpowerRequisitionId) {
            showToast("Please select a reference no", 'error');
            return false;
        }
        if (!documentName) {
            $("#errorDocument").show();
            isValid = false;
        } else {
            $("#errorDocument").hide();
        }
        if (!documentFile && !selectedManpowerAttachmentId) {
            showToast("Please upload a document", 'error');
            isValid = false;
        }
        return isValid;
    }

    function SaveManpowerDocument() {
        const formData = new FormData();
        const documentFile = $("#document")[0].files[0];
        const manpowerRequisitionId = ($('#referenceNo').val())
            || _updateManpowerRequisitionId;

        formData.append("ManpowerAttachmentId", selectedManpowerAttachmentId || "");
        formData.append("ManpowerRequisitionId", manpowerRequisitionId || "");
        formData.append("DocumentTypeId", $('#documentName').val() || "");
        formData.append("Comment", $("#comment").val().trim() || "");
        formData.append("DateOfExpiry", $("#dateOfExpiry").val() || "");
        formData.append("CreatedBy", EmployeeId || "");
        formData.append("UpdatedBy", EmployeeId || "");

        if (documentFile) {
            formData.append("DocumentFile", documentFile);
        }

        const url = selectedManpowerAttachmentId ?
            '@baseUrl/ManpowerAttachmentAPI/Update' :
            '@baseUrl/ManpowerAttachmentAPI/Create';

        _isSavingDocument = true;
        setBtnLoading('#btnDocument', 'Saving...');
        $.ajax({
            type: "POST",
            url: url,
            headers: { 'Authorization': 'Bearer ' + Token },
            contentType: false,
            processData: false,
            data: formData,
            success: function (response) {
                if (response.isSuccess) {
                    showToast(response.responseMessage, 'success');
                    ResetDocumentForm();
                    ManpowerDocumentDataTable();
                } else {
                    showToast(response.responseMessage, 'error');
                }
                _isSavingDocument = false;
                setBtnNormal('#btnDocument', selectedManpowerAttachmentId ? 'Update' : 'Save');
            },
            error: function (xhr, status, error) {
                showToast("Unable to save document. Please try again later.", 'error');
                _isSavingDocument = false;
                setBtnNormal('#btnDocument', selectedManpowerAttachmentId ? 'Update' : 'Save');
            }
        });
    }

