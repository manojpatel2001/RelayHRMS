            url: '@baseUrl/ManpowerRelationAPI/GetAll/' + manpowerRequisitionId,
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (data) {
                WMSGrid.create({
                    container: 'GridRelationContainer',
                    title: 'Contact Relations',
                    icon: 'bx-phone',
                    data: data.data || [],
                    columns: [
                        { field: 'Name', header: 'Contact Person Name', width: '180px' },
                        { field: 'RelationName', header: 'Relationship', width: '140px' },
                        { field: 'MobileNo', header: 'Mobile No.', width: '130px' },
                        {
                            header: 'Actions', sortable: false, stickyRight: true, width: '110px',
                            render: function (v, row) {
                                return '<button class="wg-btn wg-btn-primary" title="Edit" onclick="UpdateManpowerRelation(' + row.ManpowerRelationId + ')"><i class="bx bx-edit"></i></button> ' +
                                       '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="DeleteManpowerRelation(' + row.ManpowerRelationId + ')"><i class="bx bx-trash"></i></button>';
                            }
                        }
                    ],
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
                _manpowerRelationCache = {};
                (data.data || []).forEach(function (r) { _manpowerRelationCache[r.ManpowerRelationId] = r; });
                $('#grid-loader-relation').removeClass('d-flex').hide();
            },
            error: function (xhr, status, error) {
                $('#grid-loader-relation').removeClass('d-flex').hide();
                console.error("AJAX Error: " + status + " - " + error);
            }
        });
    }

    window.UpdateManpowerRelation = function (id) {
        var data = _manpowerRelationCache[id];
        if (!data) return;
        ResetForm();
        selectedManpowerRelationId = data.ManpowerRelationId;
        $("#contactPersonName").val(data.Name);
        $("#contactPersonRelation").val(data.RelationShipId);
        $("#contactMobileNo").val(data.MobileNo);
        setBtnNormal('#btnRelation', 'Update');
    };

    window.DeleteManpowerRelation = function (manpowerRelationId) {
        wmsConfirm('Are you sure you want to delete this relation?<br><small style="color:#E53E3E;display:block;margin-top:4px">This action cannot be undone.</small>', function () {
            $.ajax({
                type: "DELETE",
                url: '@baseUrl/ManpowerRelationAPI/Delete',
                headers: { 'Authorization': 'Bearer ' + Token },
                contentType: "application/json",
                data: JSON.stringify({ Id: manpowerRelationId, DeletedBy: EmployeeId }),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        ManpowerRelationDataTable();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                },
                error: function () {
                    showToast("Unable to delete relation. Please try again later.", 'error');
                }
            });
        });
    }
</script>
