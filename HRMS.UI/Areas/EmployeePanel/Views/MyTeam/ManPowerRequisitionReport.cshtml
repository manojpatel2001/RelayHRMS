@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #ffffff;
    }

    .form-section {
        padding: 15px;
        border: 1px solid #ccc;
    }

    .btn-custom {
        background-color: #3e4b6d;
        color: white;
        font-weight: 600;
        padding: 4px 12px;
        border: none;
        border-radius: 4px;
    }

        .btn-custom:hover {
            background-color: #2c3a57;
        }

    .search-panel-container {
        background-color: #3e4b6d;
        padding: 6px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .form-control-sm, .form-select-sm {
        height: calc(1.5em + .5rem + 2px);
        font-size: 0.875rem;
        padding: .25rem .5rem;
    }

    .text-center-cell {
        text-align: center !important;
    }

        .text-center-cell > div {
            text-align: center !important;
        }

    /* Radio Button Styles */
    .status-radio-wrapper {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 20px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .status-radio-group {
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .status-radio-group label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
            font-weight: 500;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

        .status-radio-group input[type="radio"] {
            accent-color: #3e4b6d;
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

    #bulkDeleteBtn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 4px 14px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        #bulkDeleteBtn:hover {
            background-color: #b02a37;
        }

    /* Serial No link style */
    .serialno-link {
        color: #2395c6;
        text-decoration: underline;
        cursor: pointer;
        font-weight: 600;
    }

    .responsive-logo {
        max-width: 100%;
    }

    /* Full width & auto height grid styles */
    .search-panel-wrapper,
    .form-section {
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        border-left: none !important;
        border-right: none !important;
        width: 100% !important;
        box-sizing: border-box;
    }

    #manpowerGrid {
        width: 100% !important;
    }

        #manpowerGrid .dx-datagrid {
            width: 100% !important;
        }

        #manpowerGrid .dx-datagrid-rowsview {
            height: auto !important;
            overflow-y: visible !important;
        }

        #manpowerGrid .dx-scrollable-content {
            height: auto !important;
        }

    .container-fluid,
    .container {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
</style>

<!-- Search Panel Header -->
<div class="search-panel-wrapper">
    <div class="search-panel-container">
        <div class="search-panel-row">
            <div class="search-heading">Search Panel</div>
            <div class="ms-auto">
                <a href='@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })' class="btn btn-primary btn-sm">Add Manpower</a>
            </div>
        </div>
    </div>
</div>

<!-- Search Form -->
<div class="form-section">
    <div class="row justify-content-center mb-3">
        <div class="col-md-4 d-flex align-items-center">
            <label for="ddlSearchBy" class="form-label mb-0 me-2" style="width: 120px;">Search By:</label>
            <select class="form-control form-control-sm" id="ddlSearchBy">
                <option value="0">-- Select --</option>
                <option value="Department">Department</option>
                <option value="Designation">Designation</option>
                <option value="EmployeeName">Employee Name</option>
                <option value="CategoryOfEmployment">Category</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <label for="txtSearchFor" class="form-label mb-0 me-2" style="width: 120px;">Search For:</label>
            <input type="text" class="form-control form-control-sm" id="txtSearchFor" placeholder="Type to search..." disabled />
        </div>
    </div>

    <!-- GO and Clear Buttons -->
    <div class="row justify-content-center mb-3">
        <div class="col d-flex align-items-center justify-content-center flex-wrap gap-3">
            <button type="button" class="search-panel-container search-heading btn-sm" id="goButtonId">GO</button>
            <button type="button" class="search-panel-container search-heading btn-sm" id="clearButtonId">Clear</button>
        </div>
    </div>

    <!-- Grid Heading -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">Manpower Requisition List</div>
            </div>
        </div>
    </div>
</div>


<!-- Grid Section -->
<div style="width:100%; padding: 0 10px; box-sizing: border-box;">

    <!-- Radio Buttons + Delete Button -->
    <div class="status-radio-wrapper">
        <div class="status-radio-group">
            <label>
                <input type="radio" name="statusFilter" value="Pending" checked />
                Pending
            </label>
            <label>
                <input type="radio" name="statusFilter" value="Approved/Rejected" />
                Approved/Rejected
            </label>
        </div>
        <button type="button" id="bulkDeleteBtn" style="display:none;">Delete</button>
    </div>

    <div id="manpowerGrid">Loading...</div>
    <div id="recordSummary" class="text-center mt-2 text-muted"></div>
</div>


<!-- ========== Manpower Detail View Modal ========== -->
<div class="modal fade" id="showManpowerDetailsModal" tabindex="-1" aria-labelledby="manpowerDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="manpowerDetailLabel">Manpower Requisition Form</h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-info me-2" id="downloadPDF">Download as PDF</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body" id="pdfContent">
                <!-- Logo and Header -->
                <div class="row mb-3">
                    <div class="col-md-2">
                        <img src="@baseAPIDomainUrl/default-image/relaylogo.jpeg" alt="Relay Express Logo" class="responsive-logo">
                    </div>
                    <div class="col-md-7 text-center">
                        <h4>RELAY EXPRESS</h4>
                        <p>Express Distribution</p>
                        <p>AN ISO 9001:2015 CERTIFIED COMPANY</p>
                    </div>
                    <div class="col-md-3 text-end">
                        <p><strong>Sr. No.:</strong> <span id="popSerialNo"></span></p>
                        <p><strong>Date:</strong> <span id="popDate"></span></p>
                    </div>
                </div>

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td><strong>Location:</strong></td>
                            <td id="popLocation"></td>
                            <td><strong>Department:</strong></td>
                            <td id="popDepartmentName"></td>
                        </tr>
                        <tr>
                            <td><strong>Requirement:</strong></td>
                            <td id="popRequirementType"></td>
                            <td><strong>Name of Employee:</strong></td>
                            <td id="popEmployeeName"></td>
                        </tr>
                        <tr>
                            <td><strong>Personal Email:</strong></td>
                            <td id="popPersonalEmail"></td>
                            <td><strong>Personal Contact No:</strong></td>
                            <td id="popContactNumber"></td>
                        </tr>
                        <tr>
                            <td><strong>Closure by Branch/HR:</strong></td>
                            <td id="popClosureBy"></td>
                            <td><strong>Designation:</strong></td>
                            <td id="popDesignationName"></td>
                        </tr>
                        <tr>
                            <td><strong>Experience Range:</strong></td>
                            <td id="popExperienceRange"></td>
                            <td><strong>Minimum Qualification:</strong></td>
                            <td id="popEducationalQualification"></td>
                        </tr>
                        <tr>
                            <td><strong>Specific Computer Skills:</strong></td>
                            <td id="popComputerSkills"></td>
                            <td><strong>Job Responsibility:</strong></td>
                            <td id="popJobResponsibility"></td>
                        </tr>
                        <tr>
                            <td><strong>Age:</strong></td>
                            <td id="popAge"></td>
                            <td><strong>Gender:</strong></td>
                            <td id="popGender"></td>
                        </tr>
                        <tr>
                            <td><strong>Reporting To:</strong></td>
                            <td id="popReportingName"></td>
                            <td><strong>Date of Joining:</strong></td>
                            <td id="popDateOfJoining"></td>
                        </tr>
                        <tr>
                            <td><strong>Category of Employment:</strong></td>
                            <td id="popCategoryOfEmployment"></td>
                            <td><strong>Take Home Salary:</strong></td>
                            <td id="popTakeHomeSalary"></td>
                        </tr>
                        <tr>
                            <td><strong>Remark:</strong></td>
                            <td id="popOtherBenefits"></td>
                            <td><strong>Amount:</strong></td>
                            <td id="popAmount"></td>
                        </tr>
                        <tr>
                            <td><strong>System Require:</strong></td>
                            <td id="popSystemRequire"></td>
                            <td><strong>Email ID Require:</strong></td>
                            <td id="popEmailIdRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>SIM Require:</strong></td>
                            <td id="popSimRequire"></td>
                            <td><strong>Mobile Handset Require:</strong></td>
                            <td id="popMobileHandsetRequire"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Approval Section -->
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Authorised</th>
                            <th>Requested By</th>
                            <th>Approved By</th>
                            <th>Received By (HRD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="popAuthorisedName"></td>
                            <td id="popRequestedBy"></td>
                            <td id="popApprovedBy"></td>
                            <td id="popReceivedBy"></td>
                        </tr>
                        <tr>
                            <td id="popAuthorisedDesignation"></td>
                            <td id="popRequestedByDesignation"></td>
                            <td id="popApprovedByDesignation"></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td id="popAuthorisedDate"></td>
                            <td id="popRequestedByDate"></td>
                            <td id="popApprovedByDate"></td>
                            <td id="popReceivedByDate"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- ========== End Modal ========== -->


<script type="text/javascript">
    var baseUrl = '@baseUrl';
    var Token = localStorage.getItem('authToken');
    var savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany || '{}');
    var CompanyId = parseInt(companyDetails.CompanyId);
    var EmployeeId = parseInt(localStorage.getItem("EmployeeId"));

    // Edit page URL base (used in Edit button click)
    var editPageUrl = '@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })';

    $(document).ready(function () {
        fetchManpowerData();

        // Enable search input when Search By is selected
        $('#ddlSearchBy').on('change', function () {
            $('#txtSearchFor').prop('disabled', $(this).val() === '0');
        });

        // GO button
        $('#goButtonId').on('click', function () {
            fetchManpowerData();
        });

        // Clear button
        $('#clearButtonId').on('click', function () {
            $('#ddlSearchBy').val('0');
            $('#txtSearchFor').val('').prop('disabled', true);
            $('input[name="statusFilter"][value="Pending"]').prop('checked', true);
            fetchManpowerData();
        });

        // Radio button change pe auto fetch
        $('input[name="statusFilter"]').on('change', function () {
            fetchManpowerData();
        });

        // Bulk Delete button
        $('#bulkDeleteBtn').on('click', function () {
            var grid = $("#manpowerGrid").dxDataGrid("instance");
            var selectedKeys = grid.getSelectedRowKeys();
            if (selectedKeys.length === 0) {
                Swal.fire('Warning', 'Please select at least one record to delete.', 'warning');
                return;
            }
            Swal.fire({
                title: 'Are you sure?',
                text: selectedKeys.length + ' record(s) will be deleted permanently.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete!',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    var deletePromises = selectedKeys.map(function (id) {
                        return $.ajax({
                            url: baseUrl + '/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                            type: 'DELETE',
                            contentType: 'application/json',
                            headers: { 'Authorization': 'Bearer ' + Token },
                            data: JSON.stringify({ id: id, deletedBy: EmployeeId.toString() })
                        });
                    });
                    Promise.all(deletePromises).then(function () {
                        Swal.fire({ title: 'Deleted!', text: 'Selected records deleted.', icon: 'success', timer: 2000 })
                            .then(function () { fetchManpowerData(); });
                    }).catch(function () {
                        Swal.fire('Error', 'Something went wrong during deletion.', 'error');
                    });
                }
            });
        });

        // Download PDF button
        document.getElementById('downloadPDF').addEventListener('click', function () {
            const { jsPDF } = window.jspdf;
            const element = document.getElementById('pdfContent');

            html2canvas(element, {
                scale: 2,
                logging: false,
                useCORS: true,
                allowTaint: false
            }).then(function (canvas) {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');
                const imgWidth = 210;
                const pageHeight = 295;
                const imgHeight = canvas.height * imgWidth / canvas.width;
                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save('Manpower_Requisition_Form.pdf');
            });
        });
    });

    function fetchManpowerData() {
        if ($("#manpowerGrid").data("dxDataGrid")) {
            $("#manpowerGrid").dxDataGrid("dispose");
            $("#manpowerGrid").empty();
        }

        $('#bulkDeleteBtn').hide();

        var searchBy = $('#ddlSearchBy').val();
        var searchFor = $('#txtSearchFor').val().trim();
        var selectedStatus = $('input[name="statusFilter"]:checked').val();

        var statusValue = null;
        if (selectedStatus === 'Pending') {
            statusValue = 'Pending';
        } else if (selectedStatus === 'Approved/Rejected') {
            statusValue = 'Approved/Rejected';
        }

        var filter = {
            CompId: CompanyId,
            BranchId: 0,
            Status: statusValue,
            SearchType: searchBy === '0' ? null : searchBy,
            SearchFor: searchFor || null
        };

        $.ajax({
            url: baseUrl + '/ManpowerRequisitionAPI/GetAllManpowerRequisitionsEss',
            method: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(filter),
            success: function (data) {
                if (data.isSuccess && data.data.isSuccess) {
                    var actualData = data.data.data;
                    if (actualData && actualData.length > 0) {
                        renderGrid(actualData);
                        $('#recordSummary').text('Total Records: ' + actualData.length);
                    } else {
                        $('#manpowerGrid').html('<div class="text-center text-muted py-3">No records found.</div>');
                        $('#recordSummary').text('');
                    }
                } else {
                    $('#manpowerGrid').html('<div class="text-center text-muted py-3">No records found.</div>');
                    $('#recordSummary').text('');
                }
            },
            error: function (xhr) {
                console.error("AJAX error:", xhr);
                Swal.fire("Error", "Something went wrong while fetching data.", "error");
            }
        });
    }

    function renderGrid(data) {
        $("#manpowerGrid").dxDataGrid({
            dataSource: data,
            keyExpr: "ManpowerRequisitionId",
            showBorders: true,
            width: "100%",
            columnAutoWidth: false,
            wordWrapEnabled: false,
            paging: { enabled: false },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always"
            },
            onSelectionChanged: function (e) {
                var selectedRows = e.selectedRowKeys;
                if (selectedRows.length > 0) {
                    $('#bulkDeleteBtn').show();
                } else {
                    $('#bulkDeleteBtn').hide();
                }
            },
            scrolling: {
                mode: "standard",
                useNative: false,
                showScrollbar: "onHover"
            },
            allowColumnResizing: true,
            columns: [
                {
                    // SerialNo - Clickable link to open detail modal
                    dataField: "SerialNo",
                    caption: "Sr. No.",
                    width: 70,
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        $('<a href="javascript:;">')
                            .text(options.value)
                            .addClass('serialno-link')
                            .on('click', function () {
                                populateManpowerModal(options.data);
                            })
                            .appendTo(container);
                    }
                },
                { dataField: "DepartmentName", caption: "Department", cssClass: "text-center-cell" },
                { dataField: "DesignationName", caption: "Designation", cssClass: "text-center-cell" },
                { dataField: "RequirementType", caption: "Requirement Type", cssClass: "text-center-cell" },
                { dataField: "EmployeeName", caption: "Employee Name", cssClass: "text-center-cell" },
                { dataField: "PersonalEmail", caption: "Personal Email", cssClass: "text-center-cell" },
                { dataField: "ContactNumber", caption: "Contact Number", cssClass: "text-center-cell" },
                { dataField: "ExperienceRange", caption: "Experience", cssClass: "text-center-cell" },
                { dataField: "EducationalQualification", caption: "Education", cssClass: "text-center-cell" },
                { dataField: "Gender", caption: "Gender", width: 70, cssClass: "text-center-cell" },
                { dataField: "CategoryOfEmployment", caption: "Category", cssClass: "text-center-cell" },
                {
                    dataField: "TakeHomeSalary", caption: "Take Home Salary",
                    cssClass: "text-center-cell", dataType: "number",
                    format: { type: "fixedPoint", precision: 2 }
                },
                {
                    dataField: "DateOfJoining", caption: "Date of Joining",
                    dataType: "date", format: "dd/MM/yyyy",
                    cssClass: "text-center-cell"
                },
                { dataField: "RequestedBy", caption: "Requested By", cssClass: "text-center-cell" },
                {
                    // Status Badge Column
                    dataField: "Status", caption: "Status", width: 100,
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        var status = (options.value || '').trim();
                        var colorMap = {
                            'Pending':  '#ffc107',
                            'Approved': '#28a745',
                            'Rejected': '#dc3545'
                        };
                        var bg = colorMap[status] || '#6c757d';
                        $('<span>')
                            .text(status || 'N/A')
                            .css({
                                'background-color': bg,
                                'color': status === 'Pending' ? '#000' : 'white',
                                'padding': '2px 10px',
                                'border-radius': '12px',
                                'font-size': '12px',
                                'font-weight': '600',
                                'display': 'inline-block'
                            })
                            .appendTo(container);
                    }
                },
                                 {
                        caption: "Edit",
                        width: 60,
                        alignment: "center",
                        cssClass: "text-center-cell",
                        cellTemplate: function (container, options) {
                            var status = (options.data.Status || '').trim();
                            // Only allow edit if Pending
                            if (status !== 'Pending') {
                                $('<span>').text('-').appendTo(container);
                                return;
                            }
                            $('<a href="javascript:;" title="Edit">')
                                .append('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#3e4b6d" class="bi bi-pencil-square" viewBox="0 0 16 16"><path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456l-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/></svg>')
                                .on('click', function () {
                                    window.location.href = '@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })' + '?id=' + options.data.ManpowerRequisitionId;
                                })
                                .appendTo(container);
                        }
                    },
                {
                    caption: "Delete",
                    width: 60,
                    alignment: "center",
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        $('<a href="javascript:;" title="Delete">')
                            .append('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#dc3545" class="bi bi-trash-fill" viewBox="0 0 16 16"><path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/></svg>')
                            .on('click', function () {
                                deleteManpower(options.data.ManpowerRequisitionId);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });
    }

    // Populate Detail Modal
    function populateManpowerModal(data) {
        $('#popSerialNo').text(data.SerialNo || '');
        $('#popDate').text(data.CreatedDate ? new Date(data.CreatedDate).toLocaleDateString('en-GB') : '');
        $('#popLocation').text(data.BranchName || '');
        $('#popDepartmentName').text(data.DepartmentName || '');
        $('#popRequirementType').text(data.RequirementType || '');
        $('#popEmployeeName').text(data.EmployeeName || '');
        $('#popPersonalEmail').text(data.PersonalEmail || '');
        $('#popContactNumber').text(data.ContactNumber || '');
