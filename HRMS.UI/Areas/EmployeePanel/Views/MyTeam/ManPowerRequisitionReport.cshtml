@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<style>
    .responsive-logo {
        max-width: 100%;
        transition: max-width 0.3s ease;
    }

    @@media (min-width: 768px) {
        .responsive-logo {
            max-width: 170%;
        }
    }

    /* Approval table */
    .approval-table td {
        vertical-align: top;
        padding: 8px;
    }

    .approval-table .approval-label {
        font-weight: bold;
        font-size: 12px;
        color: #555;
        margin-bottom: 2px;
    }

    .approval-table .approval-value {
        font-size: 13px;
        min-height: 18px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 3px;
        margin-bottom: 8px;
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Manpower Requisition Report</h6>
            <a id="btnAddManpower" href='@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })' class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add Manpower
            </a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 170px;min-width:160px;">
                    <label for="ddlSearchBy">Search By</label>
                    <select id="ddlSearchBy">
                        <option value="0">-- Select --</option>
                        <option value="Department">Department</option>
                        <option value="Designation">Designation</option>
                        <option value="EmployeeName">Employee Name</option>
                        <option value="CategoryOfEmployment">Category</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="txtSearchFor">Search For</label>
                    <input type="text" id="txtSearchFor" placeholder="Type to search..." disabled />
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="statusFilter" id="statusPending" value="Pending" checked>
                            <label class="form-check-label" for="statusPending">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="statusFilter" id="statusApprovedRejected" value="Approved/Rejected">
                            <label class="form-check-label" for="statusApprovedRejected">Approved/Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="goButtonId">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearButtonId">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="actionButtonsWrap" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnSelectAllMp">
                        <i class="bx bx-check-square"></i> Select All
                    </button>
                    <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnExportExcel">
                        <i class="bx bx-download"></i> Export to Excel
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="bulkDeleteBtn" style="display:none;">
                        <i class="bx bx-trash"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Delete</span>
                    </button>
                </div>
            </div>

            <div id="manpowerGrid"></div>
        </div>
    </div>

</div>


<!-- ========== Manpower Detail View Modal — matches Admin panel exactly ========== -->
<div class="modal fade" id="showManpowerDetailsModal" tabindex="-1" aria-labelledby="manpowerDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="manpowerDetailLabel">
                    <span>Manpower Requisition Form</span>
                </h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-info me-2" id="downloadPDF">Download as PDF</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body modal-body-font" id="pdfContent">

                <!-- Header: Logo left | Title center | Sr.No + Date right -->
                <div class="row mb-3 align-items-center">
                    <div class="col-md-3">
                        <img id="companyLogoImg" src="@baseAPIDomainUrl/default-image/relaylogo.jpeg"
                             alt="Relay Express Logo" class="responsive-logo"
                             crossorigin="anonymous"
                             style="max-height: 70px; object-fit: contain;">
                    </div>
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-0">Manpower Requisition Form</h5>
                    </div>
                    <div class="col-md-3 text-end">
                        <p class="mb-1"><strong>Sr. No.:</strong> <span id="popSerialNo"></span></p>
                        <p class="mb-0"><strong>Date:</strong> <span id="popDate"></span></p>
                    </div>
                </div>

                <!-- Main Details Table — same as Admin page -->
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td><strong>Location (Branch):</strong></td>
                            <td id="popLocation"></td>
                            <td><strong>Department:</strong></td>
                            <td id="popDepartmentName"></td>
                        </tr>
                        <tr>
                            <td><strong>Requirement:</strong></td>
                            <td id="popRequirementType"></td>
                            <td><strong>Name of Employee:</strong></td>
                            <td id="popEmployeeName"></td>
                        </tr>
                        <tr>
                            <td><strong>Personal Email:</strong></td>
                            <td id="popPersonalEmail"></td>
                            <td><strong>Personal Contact No:</strong></td>
                            <td id="popContactNumber"></td>
                        </tr>
                        <tr>
                            <td><strong>Closure by:</strong></td>
                            <td id="popClosureBy"></td>
                            <td><strong>Designation:</strong></td>
                            <td id="popDesignationName"></td>
                        </tr>
                        <tr>
                            <td><strong>Job Category:</strong></td>
                            <td id="popJobCategory"></td>
                            <td><strong>Customer Name:</strong></td>
                            <td id="popCustomerName"></td>
                        </tr>
                        <tr>
                            <td><strong>Experience (Years):</strong></td>
                            <td id="popExperienceRange"></td>
                            <td><strong>Highest Qualification:</strong></td>
                            <td id="popEducationalQualification"></td>
                        </tr>
                        <tr>
                            <td><strong>Specific Computer Skills:</strong></td>
                            <td id="popComputerSkills"></td>
                            <td><strong>Job Responsibility:</strong></td>
                            <td id="popJobResponsibility"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Birth:</strong></td>
                            <td id="popDateOfBirth"></td>
                            <td><strong>Age:</strong></td>
                            <td id="popAge"></td>
                        </tr>
                        <tr>
                            <td><strong>Gender:</strong></td>
                            <td id="popGender"></td>
                            <td><strong>Other Benefits Remark:</strong></td>
                            <td id="popOtherBenefits"></td>
                        </tr>
                        <tr>
                            <td><strong>Other Benefits Amount:</strong></td>
                            <td id="popAmount"></td>
                            <td><strong>Reporting To:</strong></td>
                            <td id="popReportingName"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Joining:</strong></td>
                            <td id="popDateOfJoining"></td>
                            <td><strong>Category of Employment:</strong></td>
                            <td id="popCategoryOfEmployment"></td>
                        </tr>
                        <tr>
                            <td><strong>Take Home Salary:</strong></td>
                            <td id="popTakeHomeSalary"></td>
                            <td><strong>System Require:</strong></td>
                            <td id="popSystemRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>Email ID Require:</strong></td>
                            <td id="popEmailIdRequire"></td>
                            <td><strong>SIM Require:</strong></td>
                            <td id="popSimRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>ERP ID:</strong></td>
                            <td id="popErpId"></td>
                            <td><strong>Number of Position:</strong></td>
                            <td id="popNumberPosition"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Approval Table — same structure as Admin page -->
                <table class="table table-bordered approval-table">
                    <thead>
                        <tr>
                            <th>Requested By</th>
                            <th>Approved By</th>
                            <th>Received By (HRD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <!-- Requested By -->
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="popRequestedByName"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="popRequestedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="popRequestedByDate"></span></div>
                            </td>
                            <!-- Approved By -->
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="popApprovedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="popApprovedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="popApprovedByDate"></span></div>
                            </td>
                            <!-- Received By (HRD) -->
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="popReceivedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value">&nbsp;</div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="popReceivedByDate"></span></div>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
            <div class="modal-footer btn-heading-title">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- ========== End Modal ========== -->


<script type="text/javascript">
    (function () {
        var baseUrl = '@baseUrl';
        var Token = localStorage.getItem('authToken');
        var savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = JSON.parse(savedCompany || '{}');
        var CompanyId = parseInt(companyDetails.CompanyId);
        var EmployeeId = parseInt(localStorage.getItem("EmployeeId"));

        var editPageUrl = '@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })';

        var selectedIds = {};
        var currentRows = [];
        var grid = null;
        var isLoadingMp = false;
        var isDeletingMp = false;

        // Pre-load logo as base64 so html2canvas renders it correctly in PDF
        var logoBase64 = null;

        function loadLogoAsBase64(url, callback) {
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function () {
                var canvas = document.createElement('canvas');
                canvas.width = img.naturalWidth;
                canvas.height = img.naturalHeight;
                canvas.getContext('2d').drawImage(img, 0, 0);
                try {
                    logoBase64 = canvas.toDataURL('image/jpeg');
                    var logoEl = document.getElementById('companyLogoImg');
                    if (logoEl) logoEl.src = logoBase64;
                } catch (e) {
                    console.warn('Logo base64 conversion failed:', e);
                }
                if (callback) callback();
            };
            img.onerror = function () {
                console.warn('Logo load failed.');
                if (callback) callback();
            };
            img.src = url + '?t=' + new Date().getTime();
        }

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        $(document).ready(function () {
            loadLogoAsBase64('@baseAPIDomainUrl/default-image/relaylogo.jpeg');

            // Deferred until permissions are loaded so the very first render of
            // the per-row Edit/Delete buttons (gated below) reflects the real
            // permission list, not the pre-load default of "hidden".
            PermGuard.onReady(function () { fetchManpowerData(); });

            PermGuard.applyActions('ess-myteam-manpowerrequisitionreport', { create: '#btnAddManpower', export: '#btnExportExcel' });

            $('#ddlSearchBy').on('change', function () {
                $('#txtSearchFor').prop('disabled', $(this).val() === '0');
            });

            $('#goButtonId').on('click', function () {
                fetchManpowerData();
            });

            $('#clearButtonId').on('click', function () {
                $('#ddlSearchBy').val('0');
                $('#txtSearchFor').val('').prop('disabled', true);
                $('input[name="statusFilter"][value="Pending"]').prop('checked', true);
                fetchManpowerData();
            });

            $('input[name="statusFilter"]').on('change', function () {
                fetchManpowerData();
            });

            $('#btnSelectAllMp').on('click', function () {
                var allSelected = currentRows.length > 0 && currentRows.every(function (r) { return !!selectedIds[r.ManpowerRequisitionId]; });
                selectedIds = {};
                if (!allSelected) { currentRows.forEach(function (r) { selectedIds[r.ManpowerRequisitionId] = true; }); }
                if (grid) grid.refresh();
                toggleDeleteBtn();
            });

            // Export to Excel
            $('#btnExportExcel').on('click', function () {
                exportManpowerToExcel();
            });

            // Bulk Delete
            $('#bulkDeleteBtn').on('click', function () {
                var ids = Object.keys(selectedIds).map(function (k) { return parseInt(k); });
                if (ids.length === 0) {
                    showToast('Please select at least one row to delete.', 'warn');
                    return;
                }
                var rows = currentRows.filter(function (r) { return ids.indexOf(r.ManpowerRequisitionId) !== -1; });
                var blocked = rows.filter(function (r) { var st = (r.Status || '').trim(); return st === 'Approved' || st === 'Rejected'; });
                if (blocked.length > 0) {
                    showToast('Approved or Rejected records cannot be deleted.', 'warn');
                    return;
                }
                deleteManpowerBulk(ids);
            });

            // Download PDF
            document.getElementById('downloadPDF').addEventListener('click', function () {
                function generatePDF() {
                    const { jsPDF } = window.jspdf;
                    html2canvas(document.getElementById('pdfContent'), {
                        scale: 2, logging: false, useCORS: true, allowTaint: false, imageTimeout: 15000
                    }).then(function (canvas) {
                        var imgData = canvas.toDataURL('image/png');
                        var pdf = new jsPDF('p', 'mm', 'a4');
                        var imgWidth = 210, pageHeight = 295;
                        var imgHeight = canvas.height * imgWidth / canvas.width;
                        var heightLeft = imgHeight, position = 0;
                        pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                        heightLeft -= pageHeight;
                        while (heightLeft >= 0) {
                            position = heightLeft - imgHeight;
                            pdf.addPage();
                            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                            heightLeft -= pageHeight;
                        }
                        pdf.save('Manpower_Requisition_Form.pdf');
                    });
                }

                if (!logoBase64) {
                    loadLogoAsBase64('@baseAPIDomainUrl/default-image/relaylogo.jpeg', function () {
                        setTimeout(generatePDF, 300);
                    });
                } else {
                    generatePDF();
                }
            });
        });

        function toggleDeleteBtn() {
            var anySelected = Object.keys(selectedIds).length > 0;
            // Combined with the permission check so a later toggle (e.g. selecting a
            // row) can't re-show this button for a role without delete permission.
            $('#bulkDeleteBtn').toggle(anySelected && PermGuard.has('delete-ess-myteam-manpowerrequisitionreport'));
        }

        window._toggleMpRow = function (id, checked) {
            if (checked) selectedIds[id] = true;
            else delete selectedIds[id];
            toggleDeleteBtn();
        };

        window._viewMpRow = function (id) {
            var row = currentRows.filter(function (r) { return r.ManpowerRequisitionId === id; })[0];
            if (row) populateManpowerModal(row);
        };

        window._editMpRow = function (id) {
            window.location.href = editPageUrl + '?id=' + id;
        };

        window._deleteMpRow = function (id) {
            var row = currentRows.filter(function (r) { return r.ManpowerRequisitionId === id; })[0];
            if (row) deleteManpower(id, row.Status);
        };

        function getSelectedRows() {
            return currentRows.filter(function (r) { return !!selectedIds[r.ManpowerRequisitionId]; });
        }

        // ====================================================
        // FETCH GRID DATA
        // ====================================================
        function fetchManpowerData() {
            if (isLoadingMp) return;

            var searchBy = $('#ddlSearchBy').val();
            var searchFor = $('#txtSearchFor').val().trim();
            var selectedStatus = $('input[name="statusFilter"]:checked').val();

            var filter = {
                CompId: CompanyId,
                BranchId: EmployeeId,
                Status: selectedStatus === 'Pending' ? 'Pending' : 'Approved/Rejected',
                SearchType: searchBy === '0' ? null : searchBy,
                SearchFor: searchFor || null
            };

            selectedIds = {};
            $('#actionButtonsWrap').hide();
            $('#bulkDeleteBtn').hide();

            isLoadingMp = true;
            setBtnLoading('#goButtonId', 'Go');

            $.ajax({
                url: baseUrl + '/ManpowerRequisitionAPI/GetAllManpowerRequisitionsEss',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                data: JSON.stringify(filter),
                success: function (data) {
                    isLoadingMp = false;
                    setBtnNormal('#goButtonId', 'Go');

                    if (data.isSuccess && data.data && data.data.isSuccess) {
                        var actualData = data.data.data;
                        if (actualData && actualData.length > 0) {
                            currentRows = actualData;
                            renderGrid(currentRows);
                            $('#actionButtonsWrap').show();
                        } else {
                            currentRows = [];
                            grid = null;
                            $('#manpowerGrid').empty();
                            showToast('No records found.', 'info');
                            $('#actionButtonsWrap').hide();
                        }
                    } else {
                        currentRows = [];
                        grid = null;
                        $('#manpowerGrid').empty();
                        showToast('No records found.', 'info');
                        $('#actionButtonsWrap').hide();
                    }
                },
                error: function (xhr) {
                    isLoadingMp = false;
                    setBtnNormal('#goButtonId', 'Go');
                    console.error("AJAX error:", xhr);
                    currentRows = [];
                    grid = null;
                    $('#manpowerGrid').empty();
                    showToast('Something went wrong while fetching data.', 'error');
                    $('#actionButtonsWrap').hide();
                }
            });
        }

        // ====================================================
        // RENDER WMSGrid
        // ====================================================
        function renderGrid(data) {
            var columns = [
                {
                    header: '', sortable: false, width: '40px',
                    render: function (v, row) {
                        var checked = selectedIds[row.ManpowerRequisitionId] ? ' checked' : '';
                        return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="_toggleMpRow(' + row.ManpowerRequisitionId + ', this.checked)">';
                    }
                },
                {
                    header: 'Sr. No.', sortable: false, width: '80px',
                    render: function (v, row) {
                        return '<a href="javascript:;" class="serialno-link" style="color:#2395c6;text-decoration:underline;font-weight:600;" onclick="_viewMpRow(' + row.ManpowerRequisitionId + ')">' + (row.SerialNo != null ? row.SerialNo : '') + '</a>';
                    }
                },
                { field: 'DepartmentName', header: 'Department', width: '140px' },
                { field: 'DesignationName', header: 'Designation', width: '140px' },
                { field: 'RequirementType', header: 'Requirement Type', width: '140px' },
                { field: 'EmployeeName', header: 'Employee Name', width: '160px' },
                { field: 'PersonalEmail', header: 'Personal Email', width: '180px' },
                { field: 'ContactNumber', header: 'Contact Number', width: '130px' },
                { field: 'ExperienceRange', header: 'Experience (Years)', width: '130px' },
                { field: 'EducationalQualification', header: 'Education', width: '140px' },
                { field: 'Gender', header: 'Gender', width: '90px' },
                { field: 'CategoryOfEmployment', header: 'Category', width: '120px' },
                {
                    header: 'Take Home Salary', sortable: false, width: '140px',
                    render: function (v, row) {
                        var n = parseFloat(row.TakeHomeSalary);
                        return isNaN(n) ? '-' : n.toFixed(2);
                    }
                },
                { header: 'Date of Joining', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.DateOfJoining); } },
                { header: 'Created Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.CreatedDate); } },
                { field: 'RequestedBy', header: 'Requested By', width: '140px' },
                {
                    header: 'Approval Status', sortable: false, width: '130px',
                    render: function (v, row) {
                        var status = row.ApprovalStatus;
                        if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
                        if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
                        if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
                        return status || '-';
                    }
                },
                {
                    header: 'Action', sortable: false, width: '100px', stickyRight: true,
                    render: function (v, row) {
                        var status = (row.Status || '').trim();
                        var canEdit = (status === 'Pending' || status === '' || status === 'N/A');
                        var canEditPerm = PermGuard.has('edit-ess-myteam-manpowerrequisitionreport');
                        var canDeletePerm = PermGuard.has('delete-ess-myteam-manpowerrequisitionreport');
                        var html = '<div class="d-flex gap-1">';
                        if (canEdit && (canEditPerm || canDeletePerm)) {
                            if (canEditPerm) html += '<button class="wg-btn wg-btn-primary" title="Edit" onclick="_editMpRow(' + row.ManpowerRequisitionId + ')"><i class="bx bx-edit"></i></button>';
                            if (canDeletePerm) html += '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="_deleteMpRow(' + row.ManpowerRequisitionId + ')"><i class="bx bx-trash"></i></button>';
                        } else {
                            html += '<span class="text-muted">-</span>';
                        }
                        html += '</div>';
                        return html;
                    }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'manpowerGrid',
                    title: 'Manpower Requisition List',
                    icon: 'bx-id-card',
                    exportName: 'ManpowerRequisitionList',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
                // Deferred so the toolbar's own Export Excel button isn't hidden
                // based on the pre-load default (permissions not fetched yet).
                // This is separate from the custom #btnExportExcel button above.
                PermGuard.onReady(function () {
                    if (!PermGuard.has('export-ess-myteam-manpowerrequisitionreport')) grid.setFeature('export', false);
                });
            } else {
                grid.setData(data);
            }
        }

        // ====================================================
        // EXPORT TO EXCEL
        // ====================================================
        function exportManpowerToExcel() {
            var rows = getSelectedRows();
            if (rows.length === 0) rows = currentRows;

            if (!rows || rows.length === 0) {
                showToast('No data available to export.', 'warn');
                return;
            }

            if (typeof ExcelJS === 'undefined') {
                showToast('ExcelJS library not loaded. Please refresh the page.', 'error');
                return;
            }

            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('Manpower');

            worksheet.columns = [
                { header: 'Sr. No.', key: 'SerialNo', width: 10 },
                { header: 'Department', key: 'DepartmentName', width: 18 },
                { header: 'Designation', key: 'DesignationName', width: 18 },
                { header: 'Requirement Type', key: 'RequirementType', width: 16 },
                { header: 'Employee Name', key: 'EmployeeName', width: 22 },
                { header: 'Personal Email', key: 'PersonalEmail', width: 24 },
                { header: 'Contact Number', key: 'ContactNumber', width: 16 },
                { header: 'Experience (Years)', key: 'ExperienceRange', width: 16 },
                { header: 'Education', key: 'EducationalQualification', width: 18 },
                { header: 'Gender', key: 'Gender', width: 10 },
                { header: 'Category', key: 'CategoryOfEmployment', width: 16 },
                { header: 'Take Home Salary', key: 'TakeHomeSalary', width: 16 },
                { header: 'Date of Joining', key: 'DateOfJoining', width: 14 },
                { header: 'Created Date', key: 'CreatedDate', width: 14 },
                { header: 'Requested By', key: 'RequestedBy', width: 18 },
                { header: 'Approval Status', key: 'ApprovalStatus', width: 16 }
            ];

            var headerRow = worksheet.getRow(1);
            headerRow.eachCell(function (cell) {
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF2F6F8E' } };
                cell.alignment = { vertical: 'middle', horizontal: 'center' };
                cell.border = {
                    top: { style: 'thin' }, left: { style: 'thin' },
                    bottom: { style: 'thin' }, right: { style: 'thin' }
                };
            });
            headerRow.height = 25;

            function safe(val) { return (val === null || val === undefined) ? '' : String(val); }

            rows.forEach(function (row) {
                if (!row) return;
                var n = parseFloat(row.TakeHomeSalary);
                var dataRow = worksheet.addRow({
                    SerialNo: safe(row.SerialNo),
                    DepartmentName: safe(row.DepartmentName),
                    DesignationName: safe(row.DesignationName),
                    RequirementType: safe(row.RequirementType),
                    EmployeeName: safe(row.EmployeeName),
                    PersonalEmail: safe(row.PersonalEmail),
                    ContactNumber: safe(row.ContactNumber),
                    ExperienceRange: safe(row.ExperienceRange),
                    EducationalQualification: safe(row.EducationalQualification),
                    Gender: safe(row.Gender),
                    CategoryOfEmployment: safe(row.CategoryOfEmployment),
                    TakeHomeSalary: isNaN(n) ? '-' : n.toFixed(2),
                    DateOfJoining: fmtDate(row.DateOfJoining),
                    CreatedDate: fmtDate(row.CreatedDate),
                    RequestedBy: safe(row.RequestedBy),
                    ApprovalStatus: safe(row.ApprovalStatus)
                });

                dataRow.eachCell(function (cell) {
                    cell.border = {
                        top: { style: 'thin', color: { argb: 'FFD3D3D3' } },
                        left: { style: 'thin', color: { argb: 'FFD3D3D3' } },
                        bottom: { style: 'thin', color: { argb: 'FFD3D3D3' } },
                        right: { style: 'thin', color: { argb: 'FFD3D3D3' } }
                    };
                    cell.alignment = { horizontal: 'left', vertical: 'middle' };
                });
            });

            var today = new Date();
            var dateStr = String(today.getDate()).padStart(2, '0') + '-' +
                String(today.getMonth() + 1).padStart(2, '0') + '-' +
                today.getFullYear();
            var fileName = 'ManpowerData_' + dateStr + '.xlsx';

            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
                showToast(rows.length + ' record(s) exported successfully.', 'success');
            }).catch(function (err) {
                console.error('Export error:', err);
                showToast('Export failed: ' + err.message, 'error');
            });
        }

