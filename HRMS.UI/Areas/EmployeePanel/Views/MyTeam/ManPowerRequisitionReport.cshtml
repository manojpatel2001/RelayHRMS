        $('#popExperienceRange').text(data.ExperienceRange || '');
        $('#popEducationalQualification').text(data.EducationalQualification || '');
        $('#popComputerSkills').text(data.ComputerSkills || '');
        $('#popJobResponsibility').text(data.JobResponsibility || '');
        $('#popAge').text(data.Age || '');
        $('#popGender').text(data.Gender || '');
        $('#popReportingName').text(data.ReportingName || '');
        $('#popDateOfJoining').text(data.DateOfJoining ? new Date(data.DateOfJoining).toLocaleDateString('en-GB') : '');
        $('#popCategoryOfEmployment').text(data.CategoryOfEmployment || '');
        $('#popTakeHomeSalary').text(data.TakeHomeSalary || '');
        // Remark (stored in OtherBenefits) and Amount
        $('#popOtherBenefits').text(data.OtherBenefits || '');
        $('#popAmount').text(data.Amount || '');
        $('#popSystemRequire').text(data.SystemRequire || '');
        $('#popEmailIdRequire').text(data.EmailIdRequire || '');
        $('#popSimRequire').text(data.SimRequire || '');
        $('#popMobileHandsetRequire').text(data.MobileHandsetRequire || '');

        // Approval Section
        $('#popAuthorisedName').text(data.RequestedBy || '');
        $('#popRequestedBy').text(data.RequestedBy || '');
        $('#popRequestedByDesignation').text(data.DesignationName || '');
        $('#popRequestedByDate').text(data.CreatedDate ? new Date(data.CreatedDate).toLocaleDateString('en-GB') : '');
        $('#popApprovedBy').text(data.ApprovedBy || '');
        $('#popApprovedByDesignation').text(data.ApprovedByDesignation || '');
        $('#popApprovedByDate').text(data.ApprovedDate ? new Date(data.ApprovedDate).toLocaleDateString('en-GB') : '');

        $('#showManpowerDetailsModal').modal('show');
    }

    function deleteManpower(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: 'This record will be deleted permanently.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: baseUrl + '/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                    type: 'DELETE',
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + Token },
                    data: JSON.stringify({ id: id, deletedBy: EmployeeId.toString() }),
                    success: function (res) {
                        if (res.isSuccess) {
                            Swal.fire({
                                title: 'Deleted!',
                                text: res.responseMessage,
                                icon: 'success',
                                timer: 2000
                            }).then(function () {
                                fetchManpowerData();
                            });
                        } else {
                            Swal.fire('Error', res.responseMessage, 'error');
                        }
                    },
                    error: function (xhr) {
                        Swal.fire('Error', 'Something went wrong during deletion.', 'error');
                        console.error('Delete error:', xhr);
                    }
                });
            }
        });
    }
</script>
