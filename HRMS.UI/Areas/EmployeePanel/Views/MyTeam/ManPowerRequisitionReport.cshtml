                            <th>Approved By</th>
                            <th>Received By (HRD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Name:</strong> <span id="popRequestedByName"></span></td>
                            <td><strong>Name:</strong> <span id="popApprovedBy"></span></td>
                            <td><strong>Name:</strong> <span id="popReceivedBy"></span></td>
                        </tr>
                        <tr>
                            <td><strong>Designation:</strong> <span id="popRequestedByDesignation"></span></td>
                            <td><strong>Designation:</strong> <span id="popApprovedByDesignation"></span></td>
                            <td><strong>Designation:</strong></td>
                        </tr>
                        <tr>
                            <td><strong>Date:</strong> <span id="popRequestedByDate"></span></td>
                            <td><strong>Date:</strong> <span id="popApprovedByDate"></span></td>
