@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #ffffff;
    }

    .form-section {
        padding: 15px;
        border: 1px solid #ccc;
    }

    .btn-custom {
        background-color: #3e4b6d;
        color: white;
        font-weight: 600;
        padding: 4px 12px;
        border: none;
        border-radius: 4px;
    }

        .btn-custom:hover {
            background-color: #2c3a57;
        }

    .search-panel-container {
        background-color: #3e4b6d;
        padding: 6px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .form-control-sm, .form-select-sm {
        height: calc(1.5em + .5rem + 2px);
        font-size: 0.875rem;
        padding: .25rem .5rem;
    }

    .text-center-cell {
        text-align: center !important;
    }

        .text-center-cell > div {
            text-align: center !important;
        }

    /* Radio Button Styles */
    .status-radio-wrapper {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 20px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .status-radio-group {
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .status-radio-group label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
            font-weight: 500;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

        .status-radio-group input[type="radio"] {
            accent-color: #3e4b6d;
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

    #bulkDeleteBtn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 4px 14px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        #bulkDeleteBtn:hover {
            background-color: #b02a37;
        }

    /* Serial No link style */
    .serialno-link {
        color: #2395c6;
        text-decoration: underline;
        cursor: pointer;
        font-weight: 600;
    }

    .responsive-logo {
        max-width: 100%;
        transition: max-width 0.3s ease;
    }

    @@media (min-width: 768px) {
        .responsive-logo {
            max-width: 170%;
        }
    }

    /* Full width & auto height grid styles */
    .search-panel-wrapper,
    .form-section {
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 10px !important;
        padding-right: 10px !important;
        border-left: none !important;
        border-right: none !important;
        width: 100% !important;
        box-sizing: border-box;
    }

    #manpowerGrid {
        width: 100% !important;
    }

        #manpowerGrid .dx-datagrid {
            width: 100% !important;
        }

        #manpowerGrid .dx-datagrid-rowsview {
            height: auto !important;
            overflow-y: visible !important;
        }

        #manpowerGrid .dx-scrollable-content {
            height: auto !important;
        }

    .container-fluid,
    .container {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    /* Excel Export Button */
    #btnExportExcel {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 4px 14px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        #btnExportExcel:hover {
            background-color: #1e7e34;
        }

    /* Approval table */
    .approval-table td {
        vertical-align: top;
        padding: 8px;
    }

    .approval-table .approval-label {
        font-weight: bold;
        font-size: 12px;
        color: #555;
        margin-bottom: 2px;
    }

    .approval-table .approval-value {
        font-size: 13px;
        min-height: 18px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 3px;
        margin-bottom: 8px;
    }
</style>

<!-- Search Panel Header -->
<div class="search-panel-wrapper">
    <div class="search-panel-container">
        <div class="search-panel-row">
            <div class="search-heading">Search Panel</div>
            <div class="ms-auto d-flex gap-2 align-items-center">
                <button id="btnExportExcel" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-file-earmark-excel me-1" viewBox="0 0 16 16">
                        <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z" />
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z" />
                    </svg>
                    Export to Excel
                </button>
                <a href='@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })' class="btn btn-primary btn-sm">Add Manpower</a>
            </div>
        </div>
    </div>
</div>

<!-- Search Form -->
<div class="form-section">
    <div class="row justify-content-center mb-3">
        <div class="col-md-4 d-flex align-items-center">
            <label for="ddlSearchBy" class="form-label mb-0 me-2" style="width: 120px;">Search By:</label>
            <select class="form-control form-control-sm" id="ddlSearchBy">
                <option value="0">-- Select --</option>
                <option value="Department">Department</option>
                <option value="Designation">Designation</option>
                <option value="EmployeeName">Employee Name</option>
                <option value="CategoryOfEmployment">Category</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <label for="txtSearchFor" class="form-label mb-0 me-2" style="width: 120px;">Search For:</label>
            <input type="text" class="form-control form-control-sm" id="txtSearchFor" placeholder="Type to search..." disabled />
        </div>
    </div>

    <!-- GO and Clear Buttons -->
    <div class="row justify-content-center mb-3">
        <div class="col d-flex align-items-center justify-content-center flex-wrap gap-3">
            <button type="button" class="search-panel-container search-heading btn-sm" id="goButtonId">GO</button>
            <button type="button" class="search-panel-container search-heading btn-sm" id="clearButtonId">Clear</button>
        </div>
    </div>

    <!-- Grid Heading -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">Manpower Requisition List</div>
            </div>
        </div>
    </div>
</div>

<!-- Grid Section -->
<div style="width:100%; padding: 0 10px; box-sizing: border-box;">

    <!-- Radio Buttons + Delete Button -->
    <div class="status-radio-wrapper">
        <div class="status-radio-group">
            <label>
                <input type="radio" name="statusFilter" value="Pending" checked />
                Pending
            </label>
            <label>
                <input type="radio" name="statusFilter" value="Approved/Rejected" />
                Approved/Rejected
            </label>
        </div>
        <button type="button" id="bulkDeleteBtn" style="display:none;">Delete</button>
    </div>

    <div id="manpowerGrid">Loading...</div>
    <div id="recordSummary" class="text-center mt-2 text-muted"></div>
</div>


<!-- ========== Manpower Detail View Modal — matches Admin panel exactly ========== -->
<div class="modal fade" id="showManpowerDetailsModal" tabindex="-1" aria-labelledby="manpowerDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title btn-heading-title" id="manpowerDetailLabel">
                    <span>Manpower Requisition Form</span>
                </h5>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-info me-2" id="downloadPDF">Download as PDF</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body modal-body-font" id="pdfContent">

                <!-- Header: Logo left | Title center | Sr.No + Date right -->
                <div class="row mb-3 align-items-center">
                    <div class="col-md-3">
                        <img id="companyLogoImg" src="@baseAPIDomainUrl/default-image/relaylogo.jpeg"
                             alt="Relay Express Logo" class="responsive-logo"
                             crossorigin="anonymous"
                             style="max-height: 70px; object-fit: contain;">
                    </div>
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-0">Manpower Requisition Form</h5>
                    </div>
                    <div class="col-md-3 text-end">
                        <p class="mb-1"><strong>Sr. No.:</strong> <span id="popSerialNo"></span></p>
                        <p class="mb-0"><strong>Date:</strong> <span id="popDate"></span></p>
                    </div>
                </div>

                <!-- Main Details Table — same as Admin page -->
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td><strong>Location (Branch):</strong></td>
                            <td id="popLocation"></td>
                            <td><strong>Department:</strong></td>
                            <td id="popDepartmentName"></td>
                        </tr>
                        <tr>
                            <td><strong>Requirement:</strong></td>
                            <td id="popRequirementType"></td>
                            <td><strong>Name of Employee:</strong></td>
                            <td id="popEmployeeName"></td>
                        </tr>
                        <tr>
                            <td><strong>Personal Email:</strong></td>
                            <td id="popPersonalEmail"></td>
                            <td><strong>Personal Contact No:</strong></td>
                            <td id="popContactNumber"></td>
                        </tr>
                        <tr>
                            <td><strong>Closure by:</strong></td>
                            <td id="popClosureBy"></td>
                            <td><strong>Designation:</strong></td>
                            <td id="popDesignationName"></td>
                        </tr>
                        <tr>
                            <td><strong>Job Category:</strong></td>
                            <td id="popJobCategory"></td>
                            <td><strong>Customer Name:</strong></td>
                            <td id="popCustomerName"></td>
                        </tr>
                        <tr>
                            <td><strong>Experience (Years):</strong></td>
                            <td id="popExperienceRange"></td>
                            <td><strong>Highest Qualification:</strong></td>
                            <td id="popEducationalQualification"></td>
                        </tr>
                        <tr>
                            <td><strong>Specific Computer Skills:</strong></td>
                            <td id="popComputerSkills"></td>
                            <td><strong>Job Responsibility:</strong></td>
                            <td id="popJobResponsibility"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Birth:</strong></td>
                            <td id="popDateOfBirth"></td>
                            <td><strong>Age:</strong></td>
                            <td id="popAge"></td>
                        </tr>
                        <tr>
                            <td><strong>Gender:</strong></td>
                            <td id="popGender"></td>
                            <td><strong>Other Benefits Remark:</strong></td>
                            <td id="popOtherBenefits"></td>
                        </tr>
                        <tr>
                            <td><strong>Other Benefits Amount:</strong></td>
                            <td id="popAmount"></td>
                            <td><strong>Reporting To:</strong></td>
                            <td id="popReportingName"></td>
                        </tr>
                        <tr>
                            <td><strong>Date of Joining:</strong></td>
                            <td id="popDateOfJoining"></td>
                            <td><strong>Category of Employment:</strong></td>
                            <td id="popCategoryOfEmployment"></td>
                        </tr>
                        <tr>
                            <td><strong>Take Home Salary:</strong></td>
                            <td id="popTakeHomeSalary"></td>
                            <td><strong>System Require:</strong></td>
                            <td id="popSystemRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>Email ID Require:</strong></td>
                            <td id="popEmailIdRequire"></td>
                            <td><strong>SIM Require:</strong></td>
                            <td id="popSimRequire"></td>
                        </tr>
                        <tr>
                            <td><strong>ERP ID:</strong></td>
                            <td id="popErpId"></td>
                            <td><strong>Number of Position:</strong></td>
                            <td id="popNumberPosition"></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Approval Table — same structure as Admin page -->
                <table class="table table-bordered approval-table">
                    <thead>
                        <tr>
                            <th>Requested By</th>
                            <th>Approved By</th>
                            <th>Received By (HRD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <!-- Requested By -->
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="popRequestedByName"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="popRequestedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="popRequestedByDate"></span></div>
                            </td>
                            <!-- Approved By -->
                            <td>
                                <div class="approval-label">Name:</div>
                                <div class="approval-value"><span id="popApprovedBy"></span></div>
                                <div class="approval-label">Designation:</div>
                                <div class="approval-value"><span id="popApprovedByDesignation"></span></div>
                                <div class="approval-label">Date:</div>
                                <div class="approval-value"><span id="popApprovedByDate"></span></div>
                            </td>
                            <!-- Received By (HRD) -->
