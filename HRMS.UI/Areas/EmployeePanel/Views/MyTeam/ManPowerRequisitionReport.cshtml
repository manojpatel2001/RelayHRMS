    // ====================================================
    // LOAD APPROVAL STATUS — exact same logic as Admin page
    // ====================================================
    function loadApprovalStatus(manpowerRequisitionId) {
        $.ajax({
            url: baseUrl + '/ManpowerRequisitionAPI/GetApprovalStatus',
            type: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify({
                ApprovalMasterId: 3,
                ManpowerRequisitionId: manpowerRequisitionId
            }),
            success: function (res) {
                if (!res || !res.isSuccess) return;

                var levels = res.data && res.data.levels ? res.data.levels : [];

                console.log('Approval Levels:', levels);

                // ---- Approved By: LevelNo 1 or 2, StatusId = 11 ----
                var approvedLevel = null;
                for (var i = 0; i < levels.length; i++) {
                    var l = levels[i];
                    if (l.LevelNo == 1 || l.LevelNo == 2) {
                        if (l.StatusId == 11) {
                            approvedLevel = l;
                            break;
                        } else if (!approvedLevel && (l.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)')) {
                            approvedLevel = l;
                            break;
                        }
                    }
                }

                // ---- Received By (HRD): HR type OR highest LevelNo ----
                var hrLevel = null;
                var maxLevelNo = 0;
                for (var j = 0; j < levels.length; j++) {
                    var lv = levels[j];
                    var lvType = (lv.ApproverType || '').toUpperCase();
                    if (lvType.indexOf('HR') > -1) {
                        hrLevel = lv;
                        break;
                    }
                    if (lv.LevelNo > maxLevelNo) {
                        maxLevelNo = lv.LevelNo;
                        hrLevel = lv;
                    }
                }

                // Populate Approved By
                if (approvedLevel) {
                    var approvedName = approvedLevel.ActionByName || approvedLevel.ApproverName || '';
                    var approvedDesig = approvedLevel.ApproverType || '';
                    var approvedDate  = approvedLevel.ActionOn
                        ? new Date(approvedLevel.ActionOn).toLocaleDateString('en-GB') : '';

                    if (approvedLevel.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)') {
                        approvedName = approvedLevel.ApproverName || '';
                        approvedDate = approvedLevel.AssignedOn
                            ? new Date(approvedLevel.AssignedOn).toLocaleDateString('en-GB') : '';
                    }

                    $('#popApprovedBy').text(approvedName);
                    $('#popApprovedByDesignation').text(approvedDesig);
                    $('#popApprovedByDate').text(approvedDate);
                }

                // Populate Received By (HRD)
                if (hrLevel) {
                    var receivedName = hrLevel.ActionByName || hrLevel.ApproverName || '';
                    var receivedDate = hrLevel.ActionOn
                        ? new Date(hrLevel.ActionOn).toLocaleDateString('en-GB') : '';

                    if (hrLevel.LevelStatus === 'Auto Approved (Admin - ClosureBy HR)') {
                        receivedName = hrLevel.ApproverName || '';
                        receivedDate = hrLevel.AssignedOn
                            ? new Date(hrLevel.AssignedOn).toLocaleDateString('en-GB') : '';
                    }

                    $('#popReceivedBy').text(receivedName);
                    $('#popReceivedByDate').text(receivedDate);
                }
            },
            error: function (err) {
                console.error('Approval status load failed:', err);
            }
        });
    }

    // ====================================================
    // DELETE
    // ====================================================
    function deleteManpower(id, status) {
        var st = (status || '').trim();
        if (st === 'Approved' || st === 'Rejected') {
            Swal.fire('Not Allowed', 'Approved or Rejected records cannot be deleted.', 'warning');
            return;
        }

        Swal.fire({
            title: 'Are you sure?',
            text: 'This record will be deleted permanently.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete!',
            cancelButtonText: 'Cancel'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: baseUrl + '/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                    type: 'DELETE',
                    contentType: 'application/json',
                    headers: { 'Authorization': 'Bearer ' + Token },
                    data: JSON.stringify({ id: id, deletedBy: EmployeeId.toString() }),
                    success: function (res) {
                        if (res.isSuccess) {
                            Swal.fire({ title: 'Deleted!', text: res.responseMessage, icon: 'success', timer: 2000 })
                                .then(function () { fetchManpowerData(); });
                        } else {
                            Swal.fire('Error', res.responseMessage, 'error');
                        }
                    },
                    error: function (xhr) {
                        Swal.fire('Error', 'Something went wrong during deletion.', 'error');
                        console.error('Delete error:', xhr);
                    }
                });
            }
        });
    }
