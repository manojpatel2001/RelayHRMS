<!-- ========== End Modal ========== -->


<script type="text/javascript">
    var baseUrl = '@baseUrl';
    var Token = localStorage.getItem('authToken');
    var savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany || '{}');
    var CompanyId = parseInt(companyDetails.CompanyId);
    var EmployeeId = parseInt(localStorage.getItem("EmployeeId"));

    // Edit page URL base
    var editPageUrl = '@Url.Action("ManPowerRequisitionEss", "MyTeam", new { area = "EmployeePanel" })';

    $(document).ready(function () {
        fetchManpowerData();

        // Enable search input when Search By is selected
        $('#ddlSearchBy').on('change', function () {
            $('#txtSearchFor').prop('disabled', $(this).val() === '0');
        });

        // GO button
        $('#goButtonId').on('click', function () {
            fetchManpowerData();
        });

        // Clear button
        $('#clearButtonId').on('click', function () {
            $('#ddlSearchBy').val('0');
            $('#txtSearchFor').val('').prop('disabled', true);
            $('input[name="statusFilter"][value="Pending"]').prop('checked', true);
            fetchManpowerData();
        });

        // Radio button change
        $('input[name="statusFilter"]').on('change', function () {
            fetchManpowerData();
        });

        // ✅ Export to Excel Button
        $('#btnExportExcel').on('click', function () {
            var gridInstance = null;
            try {
                gridInstance = $("#manpowerGrid").dxDataGrid('instance');
            } catch (ex) {
                Swal.fire('Warning', 'Grid abhi load nahi hua. Thodi der baad try karein.', 'warning');
                return;
            }

            if (!gridInstance) {
                Swal.fire('Warning', 'Grid abhi load nahi hua. Thodi der baad try karein.', 'warning');
                return;
            }

            var selectedRows = gridInstance.getSelectedRowsData();
            if (selectedRows.length === 0) {
                Swal.fire('Warning', 'Please select at least one row to export.', 'warning');
                return;
            }

            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('Manpower');

            DevExpress.excelExporter.exportDataGrid({
                component: gridInstance,
                worksheet: worksheet,
                selectedRowsOnly: true,
                autoFilterEnabled: true,
                customizeCell: function (options) {
                    var excelCell = options.excelCell;
                    // ✅ Header row - Green background, white bold text
                    if (excelCell.row === 1) {
                        excelCell.font = { bold: true, color: { argb: 'FFFFFFFF' } };
                        excelCell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: 'FF28A745' }
                        };
                    }
                    // ✅ All cells border
                    excelCell.border = {
                        top: { style: 'thin' },
                        left: { style: 'thin' },
                        bottom: { style: 'thin' },
                        right: { style: 'thin' }
                    };
                    excelCell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
                }
            }).then(function () {
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(
                        new Blob([buffer], { type: 'application/octet-stream' }),
                        'ManpowerData.xlsx'
                    );
                });
            });
        });

        // Bulk Delete button
        $('#bulkDeleteBtn').on('click', function () {
            var grid = $("#manpowerGrid").dxDataGrid("instance");
            var selectedKeys = grid.getSelectedRowKeys();
            if (selectedKeys.length === 0) {
                Swal.fire('Warning', 'Please select at least one record to delete.', 'warning');
                return;
            }
            Swal.fire({
                title: 'Are you sure?',
                text: selectedKeys.length + ' record(s) will be deleted permanently.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete!',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    var deletePromises = selectedKeys.map(function (id) {
                        return $.ajax({
                            url: baseUrl + '/ManpowerRequisitionAPI/DeleteManpowerRequisition',
                            type: 'DELETE',
                            contentType: 'application/json',
                            headers: { 'Authorization': 'Bearer ' + Token },
                            data: JSON.stringify({ id: id, deletedBy: EmployeeId.toString() })
                        });
                    });
                    Promise.all(deletePromises).then(function () {
                        Swal.fire({ title: 'Deleted!', text: 'Selected records deleted.', icon: 'success', timer: 2000 })
                            .then(function () { fetchManpowerData(); });
                    }).catch(function () {
                        Swal.fire('Error', 'Something went wrong during deletion.', 'error');
                    });
                }
            });
        });

        // Download PDF button
        document.getElementById('downloadPDF').addEventListener('click', function () {
            const { jsPDF } = window.jspdf;
            const element = document.getElementById('pdfContent');

            html2canvas(element, {
                scale: 2,
                logging: false,
                useCORS: true,
                allowTaint: false
            }).then(function (canvas) {
                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');
                const imgWidth = 210;
                const pageHeight = 295;
                const imgHeight = canvas.height * imgWidth / canvas.width;
                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save('Manpower_Requisition_Form.pdf');
            });
        });
    });

    function fetchManpowerData() {
        if ($("#manpowerGrid").data("dxDataGrid")) {
            try { $("#manpowerGrid").dxDataGrid("dispose"); } catch (e) {}
            $("#manpowerGrid").empty();
        }

        $('#bulkDeleteBtn').hide();

        var searchBy = $('#ddlSearchBy').val();
        var searchFor = $('#txtSearchFor').val().trim();
        var selectedStatus = $('input[name="statusFilter"]:checked').val();

        var statusValue = null;
        if (selectedStatus === 'Pending') {
            statusValue = 'Pending';
        } else if (selectedStatus === 'Approved/Rejected') {
            statusValue = 'Approved/Rejected';
        }

        var filter = {
            CompId: CompanyId,
            BranchId: EmployeeId,
            Status: statusValue,
            SearchType: searchBy === '0' ? null : searchBy,
            SearchFor: searchFor || null
        };

        $.ajax({
            url: baseUrl + '/ManpowerRequisitionAPI/GetAllManpowerRequisitionsEss',
            method: 'POST',
            contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            data: JSON.stringify(filter),
            success: function (data) {
                if (data.isSuccess && data.data && data.data.isSuccess) {
                    var actualData = data.data.data;
                    if (actualData && actualData.length > 0) {
                        renderGrid(actualData);
                        $('#recordSummary').text('Total Records: ' + actualData.length);
                    } else {
                        $('#manpowerGrid').html('<div class="text-center text-muted py-3">No records found.</div>');
                        $('#recordSummary').text('');
                    }
                } else {
                    $('#manpowerGrid').html('<div class="text-center text-muted py-3">No records found.</div>');
                    $('#recordSummary').text('');
                }
            },
            error: function (xhr) {
                console.error("AJAX error:", xhr);
                Swal.fire("Error", "Something went wrong while fetching data.", "error");
            }
        });
    }

    function renderGrid(data) {
        $("#manpowerGrid").dxDataGrid({
            dataSource: data,
            keyExpr: "ManpowerRequisitionId",
            showBorders: true,
            width: "100%",
            columnAutoWidth: false,
            wordWrapEnabled: false,
            paging: { pageSize: 10 },
            pager: { showPageSizeSelector: true, allowedPageSizes: [10, 25, 50, 100] },
            selection: {
                mode: "multiple",
                showCheckBoxesMode: "always"
            },
            onSelectionChanged: function (e) {
                if (e.selectedRowKeys.length > 0) {
                    $('#bulkDeleteBtn').show();
                } else {
                    $('#bulkDeleteBtn').hide();
                }
            },
            filterRow: { visible: true, applyFilter: "auto" },
            searchPanel: { visible: true, width: 240, placeholder: "Search..." },
            allowColumnResizing: true,
            scrolling: {
                mode: "standard",
                useNative: true,
                showScrollbar: "always"
            },
            // ✅ Grid ka built-in export DISABLED - upar wala custom button use hoga
            export: { enabled: false },
            onContentReady: function (e) {
                $('#recordSummary').text('Total Records: ' + e.component.totalCount());
            },
            columns: [
                {
                    dataField: "SerialNo",
                    caption: "Sr. No.",
                    width: 80,
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        $('<a href="javascript:;">')
                            .text(options.value)
                            .addClass('serialno-link')
                            .on('click', function () {
                                populateManpowerModal(options.data);
                            })
                            .appendTo(container);
                    }
                },
                { dataField: "DepartmentName", caption: "Department", cssClass: "text-center-cell" },
                { dataField: "DesignationName", caption: "Designation", cssClass: "text-center-cell" },
                { dataField: "RequirementType", caption: "Requirement Type", cssClass: "text-center-cell" },
                { dataField: "EmployeeName", caption: "Employee Name", cssClass: "text-center-cell" },
                { dataField: "PersonalEmail", caption: "Personal Email", cssClass: "text-center-cell" },
                { dataField: "ContactNumber", caption: "Contact Number", cssClass: "text-center-cell" },
                { dataField: "ExperienceRange", caption: "Experience (Years)", cssClass: "text-center-cell" },
                { dataField: "EducationalQualification", caption: "Education", cssClass: "text-center-cell" },
                { dataField: "Gender", caption: "Gender", width: 70, cssClass: "text-center-cell" },
                { dataField: "CategoryOfEmployment", caption: "Category", cssClass: "text-center-cell" },
                {
                    dataField: "TakeHomeSalary", caption: "Take Home Salary",
                    cssClass: "text-center-cell", dataType: "number",
                    format: { type: "fixedPoint", precision: 2 }
                },
                {
                    dataField: "DateOfJoining", caption: "Date of Joining",
                    dataType: "date", format: "dd/MM/yyyy",
                    cssClass: "text-center-cell"
                },
                {
                    dataField: "CreatedDate", caption: "Created Date",
                    dataType: "datetime", format: "dd-MM-yyyy",
                    cssClass: "text-center-cell"
                },
                { dataField: "RequestedBy", caption: "Requested By", cssClass: "text-center-cell" },
                {
                    dataField: "Status", caption: "Status", width: 100,
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        var status = (options.value || '').trim();
                        var colorMap = {
                            'Pending': '#ffc107',
                            'Approved': '#28a745',
                            'Rejected': '#dc3545'
                        };
                        var bg = colorMap[status] || '#6c757d';
                        $('<span>')
                            .text(status || 'N/A')
                            .css({
                                'background-color': bg,
                                'color': status === 'Pending' ? '#000' : 'white',
                                'padding': '2px 10px',
                                'border-radius': '12px',
                                'font-size': '12px',
                                'font-weight': '600',
                                'display': 'inline-block'
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Edit",
                    width: 60,
                    alignment: "center",
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        var status = (options.data.Status || '').trim();
                        var canEdit = (status === 'Pending' || status === '' || status === 'N/A');

                        if (!canEdit) {
                            $('<span>').text('-').appendTo(container);
                            return;
                        }

                        $('<a href="javascript:;" title="Edit">')
                            .append('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#3e4b6d" class="bi bi-pencil-square" viewBox="0 0 16 16"><path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456l-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/></svg>')
                            .on('click', function () {
                                window.location.href = editPageUrl + '?id=' + options.data.ManpowerRequisitionId;
                            })
                            .appendTo(container);
                    }
                },
                {
                    caption: "Delete",
                    width: 60,
                    alignment: "center",
                    cssClass: "text-center-cell",
                    cellTemplate: function (container, options) {
                        $('<a href="javascript:;" title="Delete">')
                            .append('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#dc3545" class="bi bi-trash-fill" viewBox="0 0 16 16"><path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/></svg>')
                            .on('click', function () {
                                deleteManpower(options.data.ManpowerRequisitionId, options.data.Status);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });
    }

