@* <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manpower Details</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: #f0f4f8;
            color: #2d3748;
            min-height: 100vh;
        }

        /* ── Top nav bar (dark slate, matches screenshot header) ── */
        .top-bar {
            background: #2d3a4a;
            color: #fff;
            padding: 10px 24px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .top-bar svg {
                opacity: .75;
            }

        /* ── Page wrapper ── */
        .page-wrap {
            padding: 24px;
        }

        /* ── Search / filter panel ── */
        .search-panel {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
            padding: 18px 20px;
            margin-bottom: 18px;
            display: flex;
            align-items: flex-end;
            gap: 14px;
            flex-wrap: wrap;
        }

        .sp-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 180px;
            flex: 1;
        }

            .sp-group label {
                font-size: 12px;
                font-weight: 600;
                color: #6b7280;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            .sp-group input,
            .sp-group select {
                border: 1.5px solid #e2e8f0;
                border-radius: 7px;
                padding: 8px 12px;
                font-size: 13.5px;
                font-family: 'Nunito', sans-serif;
                color: #2d3748;
                background: #f8fafc;
                outline: none;
                transition: border-color .2s;
            }

                .sp-group input:focus, .sp-group select:focus {
                    border-color: #2d7dd2;
                    background: #fff;
                }

        .sp-actions {
            display: flex;
            gap: 8px;
            align-items: flex-end;
        }

        .btn {
            cursor: pointer;
            border: none;
            border-radius: 7px;
            padding: 9px 18px;
            font-size: 13.5px;
            font-family: 'Nunito', sans-serif;
            font-weight: 700;
            transition: all .18s;
        }

        .btn-primary {
            background: #2d7dd2;
            color: #fff;
        }

            .btn-primary:hover {
                background: #1a5fa8;
            }

        .btn-success {
            background: #22c55e;
            color: #fff;
        }

            .btn-success:hover {
                background: #16a34a;
            }

        .btn-secondary {
            background: #e2e8f0;
            color: #4a5568;
        }

            .btn-secondary:hover {
                background: #cbd5e0;
            }

        .btn-danger {
            background: #ef4444;
            color: #fff;
        }

            .btn-danger:hover {
                background: #dc2626;
            }

        .btn-info {
            background: #0ea5e9;
            color: #fff;
        }

            .btn-info:hover {
                background: #0284c7;
            }

        /* ── Grid card ── */
        .grid-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
            overflow: hidden;
        }

        .grid-header {
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e8edf2;
            background: #f8fafc;
        }

            .grid-header h6 {
                font-size: 14px;
                font-weight: 700;
                color: #2d3748;
            }

        .record-count {
            font-size: 12px;
            color: #6b7280;
            font-weight: 600;
        }

        .grid-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead th {
            background: #2d3a4a;
            color: #fff;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            white-space: nowrap;
            position: sticky;
            top: 0;
        }

        tbody tr {
            border-bottom: 1px solid #f0f4f8;
            transition: background .15s;
        }

            tbody tr:hover {
                background: #f0f6ff;
            }

        tbody td {
            padding: 9px 12px;
            white-space: nowrap;
            color: #374151;
        }

            tbody td a {
                color: #2d7dd2;
                text-decoration: none;
                font-weight: 600;
            }

                tbody td a:hover {
                    text-decoration: underline;
                }

        .action-btn {
            cursor: pointer;
            border: none;
            border-radius: 5px;
            padding: 5px 7px;
            margin: 0 2px;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all .15s;
        }

        .action-edit {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

            .action-edit:hover {
                background: #2563eb;
                color: #fff;
            }

        .action-del {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

            .action-del:hover {
                background: #dc2626;
                color: #fff;
            }

        .pagination {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 12px 20px;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .pg-btn {
            border: 1.5px solid #e2e8f0;
            background: #fff;
            border-radius: 5px;
            padding: 5px 10px;
            font-size: 12px;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: all .15s;
        }

            .pg-btn:hover, .pg-btn.active {
                background: #2d7dd2;
                color: #fff;
                border-color: #2d7dd2;
            }

        .pg-info {
            font-size: 12px;
            color: #6b7280;
            margin-right: 8px;
        }

        /* ── OVERLAY / MODAL ── */
        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 900;
        }

            .overlay.open {
                display: block;
            }

        .modal-panel {
            position: fixed;
            top: 0;
            right: 0;
            width: 100%;
            max-width: 880px;
            height: 100%;
            background: #fff;
            z-index: 901;
            box-shadow: -6px 0 40px rgba(0,0,0,.18);
            display: flex;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform .3s cubic-bezier(.4,0,.2,1);
        }

            .modal-panel.open {
                transform: translateX(0);
            }

        .modal-top {
            background: #2d3a4a;
            color: #fff;
            padding: 14px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

            .modal-top h5 {
                font-size: 15px;
                font-weight: 700;
            }

        .modal-close {
            background: none;
            border: none;
            color: #fff;
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
        }

        .modal-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px 22px;
        }

        /* Form grid — 3 columns like reference */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 14px 18px;
            margin-bottom: 0;
        }
        @@media(max - width:700px) {
            .form-row

        {
            grid-template-columns: 1fr;
        }

        }
        @media(max - width:960px) {
            .form-row

        {
            grid-template-columns: 1fr 1fr;
        }

        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .form-group.span2 {
                grid-column: span 2;
            }

            .form-group label {
                font-size: 12px;
                font-weight: 600;
                color: #6b7280;
            }

                .form-group label span.req {
                    color: #ef4444;
                }

            .form-group input,
            .form-group select,
            .form-group textarea {
                border: 1.5px solid #e2e8f0;
                border-radius: 7px;
                padding: 9px 12px;
                font-size: 13.5px;
                font-family: 'Nunito', sans-serif;
                color: #2d3748;
                background: #f8fafc;
                outline: none;
                transition: border-color .2s, background .2s;
                width: 100%;
            }

                .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                    border-color: #2d7dd2;
                    background: #fff;
                }

                .form-group input.is-invalid,
                .form-group select.is-invalid,
                .form-group textarea.is-invalid {
                    border-color: #ef4444;
                }

            .form-group textarea {
                resize: vertical;
                min-height: 72px;
            }

        .err-msg {
            font-size: 11px;
            color: #ef4444;
            min-height: 14px;
        }

        .section-divider {
            grid-column: 1/-1;
            border: none;
            border-top: 1.5px dashed #e2e8f0;
            margin: 6px 0;
        }

        .section-label {
            grid-column: 1/-1;
            font-size: 11px;
            font-weight: 700;
            color: #2d7dd2;
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-top: 4px;
        }

        /* Radio group */
        .radio-group {
            display: flex;
            gap: 16px;
            align-items: center;
            padding: 9px 0;
        }

            .radio-group label {
                font-size: 13.5px;
                color: #374151;
                display: flex;
                align-items: center;
                gap: 5px;
                cursor: pointer;
                font-weight: 500;
            }

        /* Checkbox row */
        .check-row {
            grid-column: 1/-1;
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
            padding: 6px 0;
        }

        .check-item {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            color: #374151;
            cursor: pointer;
        }

            .check-item input[type=checkbox] {
                accent-color: #2d7dd2;
                width: 16px;
                height: 16px;
            }

        /* Tag box */
        .tag-box-wrap {
            border: 1.5px solid #e2e8f0;
            border-radius: 7px;
            padding: 6px 10px;
            background: #f8fafc;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            min-height: 40px;
            cursor: text;
            position: relative;
        }

            .tag-box-wrap:focus-within {
                border-color: #2d7dd2;
                background: #fff;
            }

        .tag {
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 4px;
            padding: 2px 7px 2px 8px;
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .tag-x {
            cursor: pointer;
            font-size: 13px;
            color: #1d4ed8;
            line-height: 1;
        }

        .tag-input {
            border: none;
            outline: none;
            font-size: 13px;
            font-family: 'Nunito',sans-serif;
            background: transparent;
            flex: 1;
            min-width: 80px;
            padding: 2px;
        }

        .tag-dropdown {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1.5px solid #e2e8f0;
            border-radius: 7px;
            box-shadow: 0 4px 12px rgba(0,0,0,.1);
            z-index: 99;
            display: none;
            max-height: 150px;
            overflow-y: auto;
        }

            .tag-dropdown.show {
                display: block;
            }

        .tag-opt {
            padding: 8px 12px;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .tag-opt:hover, .tag-opt.selected {
                background: #eff6ff;
            }

            .tag-opt input[type=checkbox] {
                accent-color: #2d7dd2;
            }

        .modal-foot {
            border-top: 1px solid #e8edf2;
            padding: 14px 22px;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            flex-shrink: 0;
            background: #f8fafc;
        }

        /* View modal */
        .view-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(.93);
            width: 95%;
            max-width: 860px;
            max-height: 90vh;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 12px 50px rgba(0,0,0,.25);
            z-index: 902;
            display: flex;
            flex-direction: column;
            opacity: 0;
            pointer-events: none;
            transition: all .25s cubic-bezier(.4,0,.2,1);
        }

            .view-modal.open {
                opacity: 1;
                pointer-events: all;
                transform: translate(-50%,-50%) scale(1);
            }

            .view-modal .modal-top {
                border-radius: 12px 12px 0 0;
            }

            .view-modal .modal-body {
                overflow-y: auto;
            }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .info-table th, .info-table td {
                padding: 9px 12px;
                border: 1px solid #e2e8f0;
            }

            .info-table th {
                background: #f8fafc;
                color: #6b7280;
                font-weight: 600;
                text-align: left;
                width: 28%;
            }

            .info-table td {
                color: #2d3748;
            }

            .info-table tr:hover td {
                background: #f0f6ff;
            }

        .approval-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            margin-top: 16px;
        }

            .approval-table th {
                background: #2d3a4a;
                color: #fff;
                padding: 9px 12px;
                font-weight: 600;
                font-size: 12px;
                text-align: center;
            }

            .approval-table td {
                padding: 10px 12px;
                border: 1px solid #e2e8f0;
                text-align: center;
                color: #374151;
            }

        /* Company header in view */
        .company-hdr {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 18px;
            padding-bottom: 14px;
            border-bottom: 2px solid #e2e8f0;
        }

            .company-hdr .logo-box {
                width: 60px;
                height: 60px;
                background: #2d3a4a;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 11px;
                text-align: center;
                line-height: 1.3;
            }

            .company-hdr .info h4 {
                font-size: 16px;
                font-weight: 700;
                color: #2d3a4a;
            }

            .company-hdr .info p {
                font-size: 12px;
                color: #6b7280;
            }

            .company-hdr .meta {
                margin-left: auto;
                text-align: right;
                font-size: 12.5px;
                color: #374151;
            }

                .company-hdr .meta strong {
                    display: block;
                }

        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-yes {
            background: #dcfce7;
            color: #16a34a;
        }

        .badge-no {
            background: #fef2f2;
            color: #dc2626;
        }

        /* Loading spinner */
        .spinner {
            display: none;
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,.7);
            z-index: 50;
            justify-content: center;
            align-items: center;
        }

            .spinner.show {
                display: flex;
            }

        .spin-ring {
            width: 32px;
            height: 32px;
            border: 3px solid #e2e8f0;
            border-top-color: #2d7dd2;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }
        @keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 48px 20px;
            color: #9ca3af;
        }

            .empty-state svg {
                margin-bottom: 12px;
                opacity: .4;
            }

            .empty-state p {
                font-size: 14px;
            }
    </style>
</head>
<body>

    <!-- Top header bar (matches screenshot) -->
    <div class="top-bar">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        Manpower Details
    </div>

    <div class="page-wrap">

        <!-- ── Search Panel ── -->
        <div class="search-panel">
            <div class="sp-group">
                <label>Search By</label>
                <select id="searchBy">
                    <option value="all">All</option>
                    <option value="EmployeeName">Employee Name</option>
                    <option value="DepartmentName">Department</option>
                    <option value="DesignationName">Designation</option>
                    <option value="RequirementType">Requirement Type</option>
                    <option value="CategoryOfEmployment">Employment Category</option>
                </select>
            </div>
            <div class="sp-group">
                <label>Search For</label>
                <input type="text" id="searchFor" placeholder="Type to search..." />
            </div>
            <div class="sp-actions">
                <button class="btn btn-primary" onclick="applySearch()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;margin-right:4px"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                    Search
                </button>
                <button class="btn btn-secondary" onclick="clearSearch()">Clear</button>
                <button class="btn btn-success" onclick="openAddPanel()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;margin-right:4px"><path d="M12 5v14M5 12h14" /></svg>
                    Add Manpower
                </button>
            </div>
        </div>

        <!-- ── Grid Card ── -->
        <div class="grid-card">
            <div class="grid-header">
                <h6>Manpower Requisition List</h6>
                <span class="record-count" id="recordCount">Total Records: 0</span>
            </div>
            <div class="grid-wrap" style="position:relative;">
                <div class="spinner" id="gridLoader"><div class="spin-ring"></div></div>
                <table id="manpowerTable">
                    <thead>
                        <tr>
                            <th>Serial No</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Req. Type</th>
                            <th>Employee Name</th>
                            <th>Personal Email</th>
                            <th>Contact No</th>
                            <th>Closure By</th>
                            <th>Experience</th>
                            <th>Education</th>
                            <th>Gender</th>
                            <th>Date of Joining</th>
                            <th>Category</th>
                            <th>Take Home</th>
                            <th>Created Date</th>
                            <th>Requested By</th>
                            <th style="text-align:center">Edit</th>
                            <th style="text-align:center">Delete</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="18" style="text-align:center;padding:40px;color:#9ca3af;">Loading data...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="pagination" id="paginationWrap"></div>
        </div>
    </div>

    <!-- ── Overlay ── -->
    <div class="overlay" id="overlay" onclick="closePanels()"></div>

    <!-- ── Add/Edit Slide Panel ── -->
    <div class="modal-panel" id="addPanel">
        <div class="modal-top">
            <h5 id="panelTitle">Add Manpower Requisition</h5>
            <button class="modal-close" onclick="closePanels()">×</button>
        </div>
        <div class="modal-body">
            <div class="form-row">

                <div class="section-label">Basic Information</div>

                <div class="form-group">
                    <label>Department <span class="req">*</span></label>
                    <select id="ddlDepartment">
                        <option value="">Select Department</option>
                        <option value="1">HR</option>
                        <option value="2">Operations</option>
                        <option value="3">Finance</option>
                        <option value="4">IT</option>
                        <option value="5">Sales</option>
                    </select>
                    <span class="err-msg" id="errorDepartment"></span>
                </div>

                <div class="form-group">
                    <label>Requirement Type <span class="req">*</span></label>
                    <select id="ddlRequirementType">
                        <option value="">Select</option>
                        <option value="1">New Position</option>
                        <option value="2">Replacement</option>
                    </select>
                    <span class="err-msg" id="errorRequirementType"></span>
                </div>

                <div class="form-group">
                    <label>Name of Employee <span class="req">*</span></label>
                    <input type="text" id="txtEmployeeName" placeholder="Full name" />
                    <span class="err-msg" id="errorEmployeeName"></span>
                </div>

                <div class="form-group">
                    <label>Personal Email Id <span class="req">*</span></label>
                    <input type="email" id="txtPersonalEmail" placeholder="email@example.com" />
                    <span class="err-msg" id="errorPersonalEmail"></span>
                </div>

                <div class="form-group">
                    <label>Personal Contact Number <span class="req">*</span></label>
                    <input type="text" id="txtContactNumber" placeholder="10-digit number" maxlength="10" />
                    <span class="err-msg" id="errorContactNumber"></span>
                </div>

                <div class="form-group">
                    <label>Closure by Branch/HR/Reference <span class="req">*</span></label>
                    <input type="text" id="txtClosureBy" placeholder="Branch / HR / Reference" />
                    <span class="err-msg" id="errorClosureBy"></span>
                </div>

                <hr class="section-divider" />
                <div class="section-label">Role & Qualification</div>

                <div class="form-group">
                    <label>Designation <span class="req">*</span></label>
                    <select id="ddlDesignation">
                        <option value="">Select Designation</option>
                        <option value="1">Manager</option>
                        <option value="2">Executive</option>
                        <option value="3">Coordinator</option>
                        <option value="4">Analyst</option>
                        <option value="5">Driver</option>
                    </select>
                    <span class="err-msg" id="errorDesignation"></span>
