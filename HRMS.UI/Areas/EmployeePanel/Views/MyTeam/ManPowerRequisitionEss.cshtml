@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f9f9f9;
    }

    .search-panel-container {
        background-color: #3e4b6d;
        padding: 8px 20px;
        border-radius: 6px;
        margin-bottom: 15px;
        width: 100%;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
    }

    .center-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        min-height: calc(100vh - 120px);
        padding: 30px 15px;
    }

    .form-section {
        background-color: #fff;
        padding: 25px 30px;
        border: 1px solid #ccc;
        border-radius: 8px;
        width: 100%;
        max-width: 1200px;
        box-shadow: 0 0 8px rgba(0, 0, 0, 0.05);
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
    }

    .form-control-sm, .form-select-sm {
        font-size: 0.875rem;
        padding: .25rem .5rem;
        height: calc(1.5em + .5rem + 2px);
    }

    .error-msg {
        font-size: 12px;
        color: red;
        display: none;
    }
</style>

<div class="top-header">
    <div class="search-panel-container">
        <div class="search-panel-row">
            <div class="search-heading" id="formHeading">Add Manpower Requisition</div>
        </div>
    </div>
</div>

<div class="center-wrapper">
    <form id="manpowerForm" class="form-section">

        <!-- Hidden field for edit mode -->
        <input type="hidden" id="hdnManpowerRequisitionId" value="0" />

        <!-- Row 1: Department and Requirement Type -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlDepartment" class="col-sm-4 col-form-label form-label">Department<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlDepartment">
                            <option value="">--Select Department--</option>
                        </select>
                        <span class="error-msg" id="ddlDepartment-error">Please select a department</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlRequirementType" class="col-sm-4 col-form-label form-label">Requirement Type<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlRequirementType">
                            <option value="">--Select--</option>
                            <option value="New Position">New Position</option>
                            <option value="Replacement">Replacement</option>
                        </select>
                        <span class="error-msg" id="ddlRequirementType-error">Please select requirement type</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: Employee Name (As per Aadhaar) and Personal Email -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtEmployeeName" class="col-sm-4 col-form-label form-label">Name of Employee (As per Aadhaar)<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtEmployeeName" placeholder="Name as per Aadhaar" />
                        <span class="error-msg" id="txtEmployeeName-error">Employee name is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtPersonalEmail" class="col-sm-4 col-form-label form-label">Personal Email Id<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="email" class="form-control form-control-sm" id="txtPersonalEmail" placeholder="Personal Email Id" />
                        <span class="error-msg" id="txtPersonalEmail-error">Personal email is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Contact Number and Closure By (Dropdown) -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtContactNumber" class="col-sm-4 col-form-label form-label">Personal Contact Number<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtContactNumber" maxlength="10" placeholder="Personal Contact Number" />
                        <span class="error-msg" id="txtContactNumber-error">Contact number is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlClosureBy" class="col-sm-4 col-form-label form-label">Closure by<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlClosureBy">
                            <option value="">--Select--</option>
                            <option value="Branch">Branch</option>
                            <option value="HR">HR</option>
                        </select>
                        <span class="error-msg" id="ddlClosureBy-error">Closure by is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: Designation and Experience (Years) -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlDesignation" class="col-sm-4 col-form-label form-label">Designation<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlDesignation">
                            <option value="">--Select Designation--</option>
                        </select>
                        <span class="error-msg" id="ddlDesignation-error">Please select designation</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtExperienceRange" class="col-sm-4 col-form-label form-label">Experience (Years)<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtExperienceRange" placeholder="e.g. 3" oninput="this.value=this.value.replace(/[^0-9.]/g,'')" />
                        <span class="error-msg" id="txtExperienceRange-error">Experience is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 5: Highest Qualification and Specific Computer Skills -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlEducationalQualification" class="col-sm-4 col-form-label form-label">Highest Qualification<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlEducationalQualification">
                            <option value="">--Select--</option>
                            <option value="Post Graduate">Post Graduate</option>
                            <option value="Graduate">Graduate</option>
                            <option value="Diploma">Diploma</option>
                            <option value="12th Passed">12th Passed</option>
                            <option value="10th Passed">10th Passed</option>
                            <option value="Below 10th">Below 10th</option>
                        </select>
                        <span class="error-msg" id="ddlEducationalQualification-error">Please select qualification</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtComputerSkills" class="col-sm-4 col-form-label form-label">Specific Computer Skills/Technology<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtComputerSkills" placeholder="Specific Computer Skills/Technology" />
                        <span class="error-msg" id="txtComputerSkills-error">Computer skills are required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 6: Job Responsibility and Date of Birth -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtJobResponsibility" class="col-sm-4 col-form-label form-label">Job Responsibility (in Brief)<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <textarea class="form-control form-control-sm" id="txtJobResponsibility" rows="3" placeholder="Job Responsibility (in Brief)"></textarea>
                        <span class="error-msg" id="txtJobResponsibility-error">Job responsibility is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtDateOfBirth" class="col-sm-4 col-form-label form-label">Date of Birth<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="date" class="form-control form-control-sm" id="txtDateOfBirth" />
                        <span class="error-msg" id="txtDateOfBirth-error">Date of birth is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 7: Age (auto-filled) and Gender -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtAge" class="col-sm-4 col-form-label form-label">Age (Auto Calculated)<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="number" class="form-control form-control-sm" id="txtAge" min="18" max="100" placeholder="Auto-filled from Date of Birth" readonly style="background-color:#f0f0f0; cursor:not-allowed;" />
                        <span class="error-msg" id="txtAge-error">Valid age (18-100) is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label class="col-sm-4 col-form-label form-label">Gender<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <div class="d-flex align-items-center gap-3 pt-1">
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="gender" id="maleGender" value="Male" />
                                <label class="form-check-label form-label mb-0" for="maleGender">Male</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" name="gender" id="femaleGender" value="Female" />
                                <label class="form-check-label form-label mb-0" for="femaleGender">Female</label>
                            </div>
                        </div>
                        <span class="error-msg" id="gender-error">Gender is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 8: Other Benefits Remark and Other Benefits Amount -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtRemark" class="col-sm-4 col-form-label form-label">Other Benefits Remark:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtRemark" placeholder="Other Benefits Remark" />
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtAmount" class="col-sm-4 col-form-label form-label">Other Benefits Amount:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtAmount" placeholder="Other Benefits Amount" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 9: Checkboxes - System, Email, SIM, ERP ID -->
        <div class="row mb-3">
            <div class="col-sm-4 col-form-label form-label">Requirements:</div>
            <div class="col-sm-8">
                <div class="d-flex flex-wrap gap-4 align-items-center pt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkSystemRequire" />
                        <label class="form-check-label form-label mb-0" for="chkSystemRequire">System Require</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkEmailIdRequire" />
                        <label class="form-check-label form-label mb-0" for="chkEmailIdRequire">Email Id Require</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkSIMRequire" />
                        <label class="form-check-label form-label mb-0" for="chkSIMRequire">SIM Require</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkErpId" />
                        <label class="form-check-label form-label mb-0" for="chkErpId">ERP ID</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 10: Number of Position and Job Category -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="txtNumberPosition" class="col-sm-4 col-form-label form-label">Number of Position<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control form-control-sm" id="txtNumberPosition" placeholder="Number of Position" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                        <span class="error-msg" id="txtNumberPosition-error">Number of position is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlJobCategory" class="col-sm-4 col-form-label form-label">Job Category<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlJobCategory">
                            <option value="">--Select--</option>
                        </select>
                        <span class="error-msg" id="ddlJobCategory-error">Please select job category</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 11: Reporting To and Date of Joining -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlReportingTo" class="col-sm-4 col-form-label form-label">Reporting To<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlReportingTo">
                            <option value="">--Select--</option>
                        </select>
                        <span class="error-msg" id="ddlReportingTo-error">Reporting to is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtDateOfJoining" class="col-sm-4 col-form-label form-label">Date of Joining<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="date" class="form-control form-control-sm" id="txtDateOfJoining" />
                        <span class="error-msg" id="txtDateOfJoining-error">Date of joining is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 12: Category of Employment and Take Home Salary -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="row">
                    <label for="ddlCategoryOfEmployment" class="col-sm-4 col-form-label form-label">Category of Employment<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <select class="form-select form-select-sm" id="ddlCategoryOfEmployment">
                            <option value="">--Select--</option>
                            <option value="On Roll">On Roll</option>
                            <option value="Off Roll">Off Roll</option>
                        </select>
                        <span class="error-msg" id="ddlCategoryOfEmployment-error">Category of employment is required</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <label for="txtTakeHomeSalary" class="col-sm-4 col-form-label form-label">Take Home Salary<span class="text-danger">*</span>:</label>
                    <div class="col-sm-8">
                        <input type="number" step="0.01" class="form-control form-control-sm" id="txtTakeHomeSalary" placeholder="Enter take home salary" />
                        <span class="error-msg" id="txtTakeHomeSalary-error">Take home salary is required</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit, Clear and Back Buttons -->
        <div class="row mb-3">
            <div class="col-12 d-flex justify-content-end gap-2">
                <button type="submit" id="submitid" class="search-panel-container search-heading btn-sm">Submit</button>
                <button type="button" id="resetid" class="search-panel-container search-heading btn-sm">Clear</button>
                <a href='@Url.Action("ManPowerRequisitionReport", "MyTeam", new { area = "EmployeePanel" })' class="search-panel-container search-heading btn-sm text-decoration-none">Back</a>
            </div>
        </div>
    </form>
</div>

<script type="text/javascript">
    var baseUrl = '@baseUrl';
    var Token = localStorage.getItem('authToken');
    var savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    var CompanyId = parseInt(companyDetails.CompanyId);
    var EmployeeId = parseInt(localStorage.getItem("EmployeeId"));

    // =============================================
    // CHECK FOR EDIT MODE (id from query string)
    // =============================================
    function getQueryParam(name) {
        var urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    var editId = getQueryParam('id');
    var isEditMode = editId && parseInt(editId) > 0;

    $(document).ready(function () {

        if (isEditMode) {
            $('#formHeading').text('Update Manpower Requisition');
            $('#submitid').text('Update');
        }

        loadDropDownForManpower();

        // =============================================
        // DATE OF BIRTH -> AUTO FILL AGE
        // =============================================
        $('#txtDateOfBirth').on('change', function () {
            var dob = $(this).val();
            if (dob) {
                var today = new Date();
                var birthDate = new Date(dob);

                if (birthDate >= today) {
                    $('#txtDateOfBirth-error').text('Date of Birth cannot be a future date').show();
                    $('#txtAge').val('');
                    return;
                }

                var age = today.getFullYear() - birthDate.getFullYear();
                var monthDiff = today.getMonth() - birthDate.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                $('#txtDateOfBirth-error').hide();

                if (age < 18 || age > 100) {
                    $('#txtAge-error').text('Age must be between 18 and 100').show();
                    $('#txtAge').val('');
                } else {
                    $('#txtAge').val(age);
                    $('#txtAge-error').hide();
                }
            } else {
                $('#txtAge').val('');
            }
        });

        // =============================================
        // FORM SUBMIT (CREATE or UPDATE)
        // =============================================
        $('#manpowerForm').on('submit', function (e) {
            e.preventDefault();

            var isValid = true;
            $('.error-msg').hide();

            if (!$('#ddlDepartment').val()) {
                $('#ddlDepartment-error').show();
                isValid = false;
            }

            if (!$('#ddlRequirementType').val()) {
                $('#ddlRequirementType-error').show();
                isValid = false;
            }

            if (!$('#txtEmployeeName').val()) {
                $('#txtEmployeeName-error').show();
                isValid = false;
            }

            if (!$('#txtPersonalEmail').val()) {
                $('#txtPersonalEmail-error').show();
                isValid = false;
            }

            if (!$('#txtContactNumber').val()) {
                $('#txtContactNumber-error').show();
                isValid = false;
            }

            if (!$('#ddlClosureBy').val()) {
                $('#ddlClosureBy-error').show();
                isValid = false;
            }

            if (!$('#ddlDesignation').val()) {
                $('#ddlDesignation-error').show();
                isValid = false;
            }

            if (!$('#txtExperienceRange').val()) {
                $('#txtExperienceRange-error').show();
                isValid = false;
            }

            if (!$('#ddlEducationalQualification').val()) {
                $('#ddlEducationalQualification-error').show();
                isValid = false;
            }

            if (!$('#txtComputerSkills').val()) {
                $('#txtComputerSkills-error').show();
                isValid = false;
            }

            if (!$('#txtJobResponsibility').val()) {
                $('#txtJobResponsibility-error').show();
                isValid = false;
            }

            if (!$('#txtDateOfBirth').val()) {
                $('#txtDateOfBirth-error').text('Date of birth is required').show();
                isValid = false;
            } else if ($('#txtAge').val() === '') {
                $('#txtDateOfBirth-error').text('Please enter a valid Date of Birth (Age 18-100)').show();
                isValid = false;
            }

            var age = parseInt($('#txtAge').val());
            if ($('#txtAge').val() && !isNaN(age) && (age < 18 || age > 100)) {
                $('#txtAge-error').text('Age must be between 18 and 100').show();
                isValid = false;
            }

            if (!$('input[name="gender"]:checked').length) {
                $('#gender-error').show();
                isValid = false;
            }

            if (!$('#txtNumberPosition').val()) {
                $('#txtNumberPosition-error').show();
                isValid = false;
            }

            if (!$('#ddlJobCategory').val()) {
                $('#ddlJobCategory-error').show();
                isValid = false;
            }

            if (!$('#ddlReportingTo').val()) {
                $('#ddlReportingTo-error').show();
                isValid = false;
            }

            if (!$('#txtDateOfJoining').val()) {
                $('#txtDateOfJoining-error').show();
                isValid = false;
            }

            if (!$('#ddlCategoryOfEmployment').val()) {
                $('#ddlCategoryOfEmployment-error').show();
                isValid = false;
            }

            if (!$('#txtTakeHomeSalary').val()) {
                $('#txtTakeHomeSalary-error').show();
                isValid = false;
            }

            if (!isValid) {
                $('html, body').animate({
                    scrollTop: $(".error-msg:visible:first").offset().top - 100
                }, 500);
                return;
            }

            var payload = {
                ManpowerRequisitionId: isEditMode ? parseInt(editId) : 0,
                DepartmentId: $('#ddlDepartment').val() ? parseInt($('#ddlDepartment').val()) : null,
                RequirementType: $('#ddlRequirementType').val() || null,
                EmployeeName: $('#txtEmployeeName').val() || null,
                PersonalEmail: $('#txtPersonalEmail').val() || null,
                ContactNumber: $('#txtContactNumber').val() || null,
                ClosureBy: $('#ddlClosureBy').val() || null,
                DesignationId: $('#ddlDesignation').val() ? parseInt($('#ddlDesignation').val()) : null,
                ExperienceRange: $('#txtExperienceRange').val() || null,
                EducationalQualification: $('#ddlEducationalQualification').val() || null,
                ComputerSkills: $('#txtComputerSkills').val() || null,
                JobResponsibility: $('#txtJobResponsibility').val() || null,
                DateOfBirth: $('#txtDateOfBirth').val() ? new Date($('#txtDateOfBirth').val()).toISOString() : null,
                Age: $('#txtAge').val() ? parseInt($('#txtAge').val()) : null,
                Gender: $('input[name="gender"]:checked').val() || null,
                OtherBenefits: $('#txtRemark').val() || null,
                Amount: $('#txtAmount').val() ? parseFloat($('#txtAmount').val()) : null,
                SystemRequire: $('#chkSystemRequire').is(':checked') ? "Yes" : "No",
                EmailIdRequire: $('#chkEmailIdRequire').is(':checked') ? "Yes" : "No",
                SIMRequire: $('#chkSIMRequire').is(':checked') ? "Yes" : "No",
                MobileHandsetRequire: "No",
                ErpId: $('#chkErpId').is(':checked') ? "Yes" : "No",
                NumberPosition: $('#txtNumberPosition').val() ? parseInt($('#txtNumberPosition').val()) : null,
                JobCategory: $('#ddlJobCategory').val() || null,
                ReportingToId: $('#ddlReportingTo').val() ? parseInt($('#ddlReportingTo').val()) : null,
                DateOfJoining: $('#txtDateOfJoining').val() ? new Date($('#txtDateOfJoining').val()).toISOString() : null,
                CategoryOfEmployment: $('#ddlCategoryOfEmployment').val() || null,
                TakeHomeSalary: $('#txtTakeHomeSalary').val() ? parseFloat($('#txtTakeHomeSalary').val()) : null,
                CreatedBy: EmployeeId.toString(),
                UpdatedBy: EmployeeId.toString(),
                CompanyId: CompanyId
            };

            console.log('payload', payload);

            var $btn = $('#submitid');
            $btn.prop('disabled', true).text(isEditMode ? 'Updating...' : 'Submitting...');

            var apiUrl = isEditMode
                ? baseUrl + '/ManpowerRequisitionAPI/UpdateManpowerRequisition'
                : baseUrl + '/ManpowerRequisitionAPI/CreateManpowerRequisition';

            $.ajax({
                url: apiUrl,
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.isSuccess) {
                        round_success_noti(res.responseMessage);
                        if (isEditMode) {
                            setTimeout(function () {
                                window.location.href = '@Url.Action("ManPowerRequisitionReport", "MyTeam", new { area = "EmployeePanel" })';
                            }, 1500);
                        } else {
                            resetFormToDefaults();
                            $btn.prop('disabled', false).text('Submit');
                        }
                    } else {
                        round_error_noti(res.responseMessage);
                        $btn.prop('disabled', false).text(isEditMode ? 'Update' : 'Submit');
                    }
                },
                error: function (xhr, status, error) {
                    var errorMessage = 'Error submitting application.';
                    if (xhr.responseJSON && xhr.responseJSON.responseMessage) {
                        errorMessage = xhr.responseJSON.responseMessage;
                    }
                    Swal.fire({
                        icon: 'error',
                        title: errorMessage,
                        confirmButtonText: 'OK'
                    });
                    $btn.prop('disabled', false).text(isEditMode ? 'Update' : 'Submit');
                }
            });
        });

        $('#manpowerForm input, #manpowerForm textarea, #manpowerForm select').on('input change', function () {
            $(this).siblings('.error-msg').hide();
        });

        $('input[name="gender"]').on('change', function () {
            $('#gender-error').hide();
        });
    });

    // =============================================
    // RESET BUTTON
    // =============================================
    $('#resetid').on('click', function (e) {
        e.preventDefault();
        resetFormToDefaults();
    });

    function resetFormToDefaults() {
        $('#manpowerForm')[0].reset();
        $('#txtAge').val('');
        $('.error-msg').hide();
        loadDropDownForManpower();
    }

    // =============================================
    // LOAD DROPDOWNS
    // =============================================
    function loadDropDownForManpower() {
        $.ajax({
            url: baseUrl + '/ManpowerRequisitionAPI/GetDropDownForManpower/' + CompanyId,
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess) {
                    bindDepartment(response.data.departments);
                    bindDesignation(response.data.designations);
                    bindReporting(response.data.reportingEmployees);
                    bindJobCategory(response.data.categories || []);

                    if (isEditMode) {
                        loadEditData(editId);
                    }
                } else {
                    round_error_noti(response.responseMessage);
                }
            },
            error: function (error) {
                console.error('Error fetching dropdowns:', error);
            }
        });
    }

    function bindDepartment(data) {
        var dropdown = $('#ddlDepartment');
        dropdown.empty().append('<option value="">--Select Department--</option>');
        $.each(data, function (index, item) {
            dropdown.append($('<option>', { value: item.departmentId, text: item.departmentName }));
        });
    }

    function bindDesignation(data) {
        var dropdown = $('#ddlDesignation');
        dropdown.empty().append('<option value="">--Select Designation--</option>');
        $.each(data, function (index, item) {
            dropdown.append($('<option>', { value: item.designationId, text: item.designationName }));
        });
    }

    function bindReporting(data) {
        var dropdown = $('#ddlReportingTo');
        dropdown.empty().append('<option value="">--Select--</option>');
        $.each(data, function (index, item) {
            dropdown.append($('<option>', { value: item.employeeId, text: item.fullName + ' - ' + item.employeeCode }));
        });
    }

    function bindJobCategory(data) {
        var dropdown = $('#ddlJobCategory');
        var currentVal = dropdown.val();
        dropdown.empty().append('<option value="">--Select--</option>');
        $.each(data, function (index, item) {
            dropdown.append($('<option>', { value: item.categoryId, text: item.categoryName }));
        });
        if (currentVal) dropdown.val(currentVal);
    }

    // =============================================
    // LOAD EDIT DATA (Auto-fill form for update)
    // =============================================
    function loadEditData(id) {
        $.ajax({
            url: baseUrl + '/ManpowerRequisitionAPI/GetManpowerRequisitionByManpowerRequisitionId/' + id,
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + Token
            },
            success: function (response) {
                if (response.isSuccess && response.data) {
                    console.log('response', response);
                    var d = response.data;

                    $('#ddlDepartment').val(d.DepartmentId);
                    $('#ddlDesignation').val(d.DesignationId);
                    $('#ddlReportingTo').val(d.ReportingToId);
                    $('#ddlRequirementType').val(d.RequirementType);
                    $('#ddlEducationalQualification').val(d.EducationalQualification);
                    $('#ddlCategoryOfEmployment').val(d.CategoryOfEmployment);
                    $('#ddlClosureBy').val(d.ClosureBy);
                    $('#ddlJobCategory').val(d.JobCategory);

                    // Text inputs
                    $('#txtEmployeeName').val(d.EmployeeName || '');
                    $('#txtPersonalEmail').val(d.PersonalEmail || '');
                    $('#txtContactNumber').val(d.ContactNumber || '');
                    $('#txtExperienceRange').val(d.ExperienceRange || '');
                    $('#txtComputerSkills').val(d.ComputerSkills || '');
                    $('#txtJobResponsibility').val(d.JobResponsibility || '');
                    $('#txtTakeHomeSalary').val(d.TakeHomeSalary || '');
                    $('#txtRemark').val(d.OtherBenefits || '');
                    $('#txtAmount').val(d.Amount || '');
                    $('#txtNumberPosition').val(d.NumberPosition || '');

                    // Date of Birth & auto-fill age
                    if (d.DateOfBirth) {
                        var dobFormatted = new Date(d.DateOfBirth).toISOString().split('T')[0];
                        $('#txtDateOfBirth').val(dobFormatted).trigger('change');
                    }

                    if (d.Age) {
                        $('#txtAge').val(d.Age);
                    }

                    if (d.DateOfJoining) {
                        $('#txtDateOfJoining').val(new Date(d.DateOfJoining).toISOString().split('T')[0]);
                    }

                    // Gender
                    if (d.Gender) {
                        $('input[name="gender"][value="' + d.Gender + '"]').prop('checked', true);
                    }

                    $('#chkSystemRequire').prop('checked', d.SystemRequire === 'Yes');
                    $('#chkEmailIdRequire').prop('checked', d.EmailIdRequire === 'Yes');
                    $('#chkSIMRequire').prop('checked', d.SIMRequire === 'Yes' || d.SimRequire === 'Yes' || d.sIMRequire === 'Yes');
                    $('#chkErpId').prop('checked', d.ErpId === 'Yes');

                } else {
                    Swal.fire('Error', 'Could not load record for editing.', 'error');
                }
            },
            error: function (xhr) {
                console.error('Error loading edit data:', xhr);
                Swal.fire('Error', 'Failed to fetch record details.', 'error');
            }
        });
    }
</script>
