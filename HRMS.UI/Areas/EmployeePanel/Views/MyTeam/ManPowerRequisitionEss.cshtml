          document.getElementById('vPersonalEmail').textContent=d.PersonalEmail||'—';
          document.getElementById('vContactNumber').textContent=d.ContactNumber||'—';
          document.getElementById('vClosureBy').textContent=d.ClosureBy||'—';
          document.getElementById('vDesignation').textContent=d.DesignationName||'—';
          document.getElementById('vExperienceRange').textContent=d.ExperienceRange||'—';
          document.getElementById('vEducation').textContent=d.EducationalQualification||'—';
          document.getElementById('vComputerSkills').textContent=d.ComputerSkills||'—';
          document.getElementById('vJobResponsibility').textContent=d.JobResponsibility||'—';
          document.getElementById('vAge').textContent=d.Age||'—';
          document.getElementById('vGender').textContent=d.Gender||'—';
          document.getElementById('vReportingTo').textContent=d.ReportingName||'—';
