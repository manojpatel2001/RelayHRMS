        let allData = [
          { ManpowerRequisitionId:1, SerialNo:'MP-001', DepartmentId:'1', DepartmentName:'HR', DesignationId:'1', DesignationName:'Manager', RequirementType:'New Position', EmployeeName:'Rahul Sharma', PersonalEmail:'rahul@gmail.com', ContactNumber:'9812345678', ClosureBy:'Branch', ExperienceRange:'3-5 years', EducationalQualification:'Graduate', ComputerSkills:'MS Office', JobResponsibility:'Team management', Age:32, Gender:'Male', OtherBenefits:'Petrol Allowance', ReportingToId:'2', ReportingName:'Priya Mehta - EMP002', DateOfJoining:'2026-03-01T00:00:00', CategoryOfEmployment:'On Roll', GrossSalary:45000, CTC_Monthly:52000, TakeHomeSalary:38000, SystemRequire:'Yes', EmailIdRequire:'Yes', SIMRequire:'No', MobileHandsetRequire:'No', CreatedDate:'2026-01-15T00:00:00', RequestedBy:'Admin', BranchName:'Mumbai HQ' },
          { ManpowerRequisitionId:2, SerialNo:'MP-002', DepartmentId:'3', DepartmentName:'Finance', DesignationId:'4', DesignationName:'Analyst', RequirementType:'Replacement', EmployeeName:'Neha Patel', PersonalEmail:'neha@gmail.com', ContactNumber:'9823456789', ClosureBy:'HR', ExperienceRange:'1-3 years', EducationalQualification:'Post Graduate', ComputerSkills:'Tally, Excel', JobResponsibility:'Account reconciliation', Age:26, Gender:'Female', OtherBenefits:'Convenience', ReportingToId:'1', ReportingName:'Rahul Sharma - EMP001', DateOfJoining:'2026-02-15T00:00:00', CategoryOfEmployment:'On Roll', GrossSalary:30000, CTC_Monthly:35000, TakeHomeSalary:25000, SystemRequire:'Yes', EmailIdRequire:'Yes', SIMRequire:'No', MobileHandsetRequire:'No', CreatedDate:'2026-01-20T00:00:00', RequestedBy:'Finance Head', BranchName:'Pune Branch' },
          { ManpowerRequisitionId:3, SerialNo:'MP-003', DepartmentId:'2', DepartmentName:'Operations', DesignationId:'5', DesignationName:'Driver', RequirementType:'New Position', EmployeeName:'Suresh Kumar', PersonalEmail:'suresh@gmail.com', ContactNumber:'9834567890', ClosureBy:'Reference', ExperienceRange:'2+ years', EducationalQualification:'10th Passed', ComputerSkills:'Not Applicable', JobResponsibility:'Vehicle operation & delivery', Age:28, Gender:'Male', OtherBenefits:'Not Applicable', ReportingToId:'3', ReportingName:'Amit Patel - EMP003', DateOfJoining:'2026-03-10T00:00:00', CategoryOfEmployment:'Off Roll', GrossSalary:18000, CTC_Monthly:20000, TakeHomeSalary:16000, SystemRequire:'No', EmailIdRequire:'No', SIMRequire:'Yes', MobileHandsetRequire:'Yes', CreatedDate:'2026-01-25T00:00:00', RequestedBy:'Ops Manager', BranchName:'Aurangabad' },
        ];

        let filteredData = [...allData];
        let editingId = 0;
        const PAGE_SIZE = 10;
        let currentPage = 1;

        /* ─────────── TAG BOX ─────────── */
        const benefitOptions = ['Not Applicable','Convenience','Petrol Allowance'];
        let selectedBenefits = [];

        function renderTagBox() {
          const wrap = document.getElementById('tagBoxWrap');
          // Remove existing tags
          wrap.querySelectorAll('.tag').forEach(t => t.remove());
          const input = document.getElementById('tagInput');
          selectedBenefits.forEach(b => {
            const tag = document.createElement('span');
            tag.className = 'tag';
            tag.innerHTML = b + ' <span class="tag-x" onclick="removeTag(\''+b+'\')">×</span>';
            wrap.insertBefore(tag, input);
          });
          renderTagDropdown('');
        }
        function renderTagDropdown(q) {
          const dd = document.getElementById('tagDropdown');
          dd.innerHTML = '';
          benefitOptions.filter(o => o.toLowerCase().includes(q.toLowerCase())).forEach(o => {
            const div = document.createElement('div');
            div.className = 'tag-opt' + (selectedBenefits.includes(o)?' selected':'');
            div.innerHTML = '<input type="checkbox" '+(selectedBenefits.includes(o)?'checked':'')+'/> '+o;
            div.onmousedown = (e) => { e.preventDefault(); toggleTag(o); };
            dd.appendChild(div);
          });
        }
        function filterTagOptions(q){ renderTagDropdown(q); }
        function showTagDrop(){ document.getElementById('tagDropdown').classList.add('show'); }
        function hideTagDrop(){ setTimeout(()=>document.getElementById('tagDropdown').classList.remove('show'),200); }
        function toggleTag(val){
          if(selectedBenefits.includes(val)) selectedBenefits=selectedBenefits.filter(x=>x!==val);
          else selectedBenefits.push(val);
          renderTagBox();
          document.getElementById('tagInput').value='';
        }
        function removeTag(val){ selectedBenefits=selectedBenefits.filter(x=>x!==val); renderTagBox(); }
        function initTagBox(){ renderTagBox(); }

        /* ─────────── SEARCH ─────────── */
        function applySearch(){
          const by = document.getElementById('searchBy').value;
          const q  = document.getElementById('searchFor').value.trim().toLowerCase();
          if(!q){ filteredData=[...allData]; }
          else {
            filteredData = allData.filter(row => {
              if(by==='all') return Object.values(row).some(v=>String(v).toLowerCase().includes(q));
              return String(row[by]||'').toLowerCase().includes(q);
            });
          }
          currentPage=1; renderTable();
        }
        function clearSearch(){
          document.getElementById('searchBy').value='all';
          document.getElementById('searchFor').value='';
          filteredData=[...allData]; currentPage=1; renderTable();
        }

        /* ─────────── TABLE ─────────── */
        function renderTable(){
          const tbody = document.getElementById('tableBody');
          const start=(currentPage-1)*PAGE_SIZE, end=start+PAGE_SIZE;
          const pageData=filteredData.slice(start,end);
          document.getElementById('recordCount').textContent='Total Records: '+filteredData.length;

          if(!pageData.length){
            tbody.innerHTML='<tr><td colspan="18" style="text-align:center;padding:40px;color:#9ca3af;">No records found</td></tr>';
            renderPagination(); return;
          }
          tbody.innerHTML = pageData.map(r=>`
            <tr>
              <td><a href="#" onclick="viewManpower(${r.ManpowerRequisitionId});return false;">${r.SerialNo}</a></td>
              <td>${r.DepartmentName}</td>
              <td>${r.DesignationName}</td>
              <td>${r.RequirementType}</td>
              <td>${r.EmployeeName}</td>
              <td>${r.PersonalEmail}</td>
              <td>${r.ContactNumber}</td>
              <td>${r.ClosureBy}</td>
              <td>${r.ExperienceRange}</td>
              <td>${r.EducationalQualification}</td>
              <td>${r.Gender}</td>
              <td>${fmtDate(r.DateOfJoining)}</td>
              <td>${r.CategoryOfEmployment}</td>
              <td>₹${Number(r.TakeHomeSalary).toLocaleString()}</td>
              <td>${fmtDate(r.CreatedDate)}</td>
              <td>${r.RequestedBy}</td>
              <td style="text-align:center"><button class="action-btn action-edit" onclick="editManpower(${r.ManpowerRequisitionId})">✏</button></td>
              <td style="text-align:center"><button class="action-btn action-del" onclick="deleteManpower(${r.ManpowerRequisitionId})">🗑</button></td>
            </tr>`).join('');
          renderPagination();
        }

        function renderPagination(){
          const total=Math.ceil(filteredData.length/PAGE_SIZE);
          const wrap=document.getElementById('paginationWrap');
          if(total<=1){wrap.innerHTML='';return;}
          let html=`<span class="pg-info">Page ${currentPage} of ${total}</span>`;
          html+=`<button class="pg-btn" onclick="gotoPage(1)" ${currentPage==1?'disabled':''}>«</button>`;
          html+=`<button class="pg-btn" onclick="gotoPage(${currentPage-1})" ${currentPage==1?'disabled':''}>‹</button>`;
          for(let i=Math.max(1,currentPage-2);i<=Math.min(total,currentPage+2);i++)
            html+=`<button class="pg-btn${i==currentPage?' active':''}" onclick="gotoPage(${i})">${i}</button>`;
          html+=`<button class="pg-btn" onclick="gotoPage(${currentPage+1})" ${currentPage==total?'disabled':''}>›</button>`;
          html+=`<button class="pg-btn" onclick="gotoPage(${total})" ${currentPage==total?'disabled':''}>»</button>`;
          wrap.innerHTML=html;
        }
        function gotoPage(p){ currentPage=p; renderTable(); }
        function fmtDate(d){ if(!d)return'—'; const dt=new Date(d); return isNaN(dt)?d:dt.toLocaleDateString('en-GB'); }

        /* ─────────── PANEL OPEN/CLOSE ─────────── */
        function openAddPanel(){
          resetForm(); editingId=0;
          document.getElementById('panelTitle').textContent='Add Manpower Requisition';
          document.getElementById('btnSubmit').textContent='Save';
          document.getElementById('overlay').classList.add('open');
          document.getElementById('addPanel').classList.add('open');
        }
        function closePanels(){
          document.getElementById('overlay').classList.remove('open');
          document.getElementById('addPanel').classList.remove('open');
        }
        function closeView(){
          document.getElementById('overlay').classList.remove('open');
          document.getElementById('viewModal').classList.remove('open');
        }

        /* ─────────── VIEW ─────────── */
        function viewManpower(id){
          const d=allData.find(x=>x.ManpowerRequisitionId===id); if(!d)return;
          document.getElementById('vSerialNo').textContent=d.SerialNo||'—';
          document.getElementById('vDate').textContent=fmtDate(d.CreatedDate);
          document.getElementById('vLocation').textContent=d.BranchName||'—';
