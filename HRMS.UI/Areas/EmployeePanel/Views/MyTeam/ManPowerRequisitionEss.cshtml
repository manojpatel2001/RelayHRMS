          document.getElementById('vCategory').textContent=d.CategoryOfEmployment||'—';
          document.getElementById('vTakeHome').textContent=d.TakeHomeSalary?'₹'+Number(d.TakeHomeSalary).toLocaleString():'—';
          document.getElementById('vGross').textContent=d.GrossSalary?'₹'+Number(d.GrossSalary).toLocaleString():'—';
          document.getElementById('vCTC').textContent=d.CTC_Monthly?'₹'+Number(d.CTC_Monthly).toLocaleString():'—';
          document.getElementById('vOtherBenefits').textContent=d.OtherBenefits||'—';
          document.getElementById('vSystemReq').innerHTML=badge(d.SystemRequire);
          document.getElementById('vEmailReq').innerHTML=badge(d.EmailIdRequire);
          document.getElementById('vSimReq').innerHTML=badge(d.SIMRequire);
          document.getElementById('vMobileReq').innerHTML=badge(d.MobileHandsetRequire);
          document.getElementById('vAuthorised').textContent=d.RequestedBy||'—';
          document.getElementById('vRequestedBy').textContent=d.RequestedBy||'—';
          document.getElementById('vRequestedDesig').textContent=d.DesignationName||'—';
          document.getElementById('vRequestedDate').textContent=fmtDate(d.CreatedDate);
          document.getElementById('vAuthorisedDate').textContent=fmtDate(d.CreatedDate);
          document.getElementById('vApprovedBy').textContent='—';
          document.getElementById('vReceivedBy').textContent='—';
          document.getElementById('overlay').classList.add('open');
          document.getElementById('viewModal').classList.add('open');
        }
        function badge(v){ return v==='Yes'?'<span class="badge badge-yes">Yes</span>':'<span class="badge badge-no">No</span>'; }

        /* ─────────── EDIT ─────────── */
        function editManpower(id){
          const d=allData.find(x=>x.ManpowerRequisitionId===id); if(!d)return;
          resetForm(); editingId=id;
          document.getElementById('panelTitle').textContent='Update Manpower Requisition';
          document.getElementById('btnSubmit').textContent='Update';
          document.getElementById('ddlDepartment').value=d.DepartmentId||'';
          document.getElementById('ddlRequirementType').value=d.RequirementType==='New Position'?'1':'2';
          document.getElementById('ddlDesignation').value=d.DesignationId||'';
          document.getElementById('ddlEducationalQualification').value=d.EducationalQualification||'';
          document.getElementById('ddlCategoryOfEmployment').value=d.CategoryOfEmployment||'';
          document.getElementById('ddlReportingTo').value=d.ReportingToId||'';
          document.getElementById('txtEmployeeName').value=d.EmployeeName||'';
          document.getElementById('txtPersonalEmail').value=d.PersonalEmail||'';
          document.getElementById('txtContactNumber').value=d.ContactNumber||'';
          document.getElementById('txtClosureBy').value=d.ClosureBy||'';
          document.getElementById('txtExperienceRange').value=d.ExperienceRange||'';
          document.getElementById('txtComputerSkills').value=d.ComputerSkills||'';
          document.getElementById('txtJobResponsibility').value=d.JobResponsibility||'';
          document.getElementById('txtAge').value=d.Age||'';
          document.getElementById('txtGrossSalary').value=d.GrossSalary||'';
          document.getElementById('txtCTC_Monthly').value=d.CTC_Monthly||'';
          document.getElementById('txtTakeHomeSalary').value=d.TakeHomeSalary||'';
          if(d.Gender) document.querySelector(`input[name="gender"][value="${d.Gender}"]`).checked=true;
          if(d.DateOfJoining) document.getElementById('txtDateOfJoining').value=d.DateOfJoining.split('T')[0];
          document.getElementById('chkSystemRequire').checked=d.SystemRequire==='Yes';
          document.getElementById('chkEmailIdRequire').checked=d.EmailIdRequire==='Yes';
          document.getElementById('chkSIMRequire').checked=d.SIMRequire==='Yes';
          document.getElementById('chkMobileHandsetRequire').checked=d.MobileHandsetRequire==='Yes';
          if(d.OtherBenefits) selectedBenefits=d.OtherBenefits.split(',').map(x=>x.trim());
          renderTagBox();
          document.getElementById('overlay').classList.add('open');
          document.getElementById('addPanel').classList.add('open');
        }

        /* ─────────── DELETE ─────────── */
        function deleteManpower(id){
          if(!confirm('Are you sure you want to delete this record?')) return;
          allData=allData.filter(x=>x.ManpowerRequisitionId!==id);
          filteredData=filteredData.filter(x=>x.ManpowerRequisitionId!==id);
          renderTable();
          showToast('Record deleted successfully!','error');
        }

        /* ─────────── SUBMIT ─────────── */
        function submitManpower(){
          if(!validateForm()) return;
          const reqType = document.getElementById('ddlRequirementType').value;
          const reqTypeText = reqType==='1'?'New Position':'Replacement';
          const deptEl=document.getElementById('ddlDepartment');
          const designEl=document.getElementById('ddlDesignation');

          const formData = {
            ManpowerRequisitionId: editingId,
            SerialNo: editingId===0?'MP-00'+(allData.length+1):(allData.find(x=>x.ManpowerRequisitionId===editingId)||{}).SerialNo,
            DepartmentId: document.getElementById('ddlDepartment').value,
            DepartmentName: deptEl.options[deptEl.selectedIndex].text,
            RequirementType: reqTypeText,
            EmployeeName: document.getElementById('txtEmployeeName').value.trim(),
            PersonalEmail: document.getElementById('txtPersonalEmail').value.trim(),
            ContactNumber: document.getElementById('txtContactNumber').value.trim(),
            ClosureBy: document.getElementById('txtClosureBy').value.trim(),
            DesignationId: document.getElementById('ddlDesignation').value,
            DesignationName: designEl.options[designEl.selectedIndex].text,
            ExperienceRange: document.getElementById('txtExperienceRange').value.trim(),
            EducationalQualification: document.getElementById('ddlEducationalQualification').value,
            ComputerSkills: document.getElementById('txtComputerSkills').value.trim(),
            JobResponsibility: document.getElementById('txtJobResponsibility').value.trim(),
            Age: parseInt(document.getElementById('txtAge').value)||null,
            Gender: document.querySelector('input[name="gender"]:checked')?.value||'',
            OtherBenefits: selectedBenefits.join(', '),
            SystemRequire: document.getElementById('chkSystemRequire').checked?'Yes':'No',
            EmailIdRequire: document.getElementById('chkEmailIdRequire').checked?'Yes':'No',
            SIMRequire: document.getElementById('chkSIMRequire').checked?'Yes':'No',
            MobileHandsetRequire: document.getElementById('chkMobileHandsetRequire').checked?'Yes':'No',
            ReportingToId: document.getElementById('ddlReportingTo').value,
            ReportingName: (()=>{const el=document.getElementById('ddlReportingTo');return el.options[el.selectedIndex].text;})(),
            DateOfJoining: document.getElementById('txtDateOfJoining').value+'T00:00:00',
            CategoryOfEmployment: document.getElementById('ddlCategoryOfEmployment').value,
            GrossSalary: parseFloat(document.getElementById('txtGrossSalary').value)||null,
            CTC_Monthly: parseFloat(document.getElementById('txtCTC_Monthly').value)||null,
            TakeHomeSalary: parseFloat(document.getElementById('txtTakeHomeSalary').value)||null,
            CreatedDate: new Date().toISOString(),
            RequestedBy: 'Admin',
            BranchName: 'HQ',
          };

          if(editingId===0){
            formData.ManpowerRequisitionId = allData.length ? Math.max(...allData.map(x=>x.ManpowerRequisitionId))+1 : 1;
            allData.push(formData);
            showToast('Manpower added successfully!');
          } else {
            const idx=allData.findIndex(x=>x.ManpowerRequisitionId===editingId);
            if(idx>-1) allData[idx]=formData;
            showToast('Manpower updated successfully!');
          }
          filteredData=[...allData];
          renderTable(); closePanels();
        }

        /* ─────────── VALIDATE ─────────── */
        function validateForm(){
          let ok=true;
          const req=[
            ['ddlDepartment','errorDepartment','Department is required'],
            ['ddlRequirementType','errorRequirementType','Requirement Type is required'],
            ['txtEmployeeName','errorEmployeeName','Employee Name is required'],
            ['txtPersonalEmail','errorPersonalEmail','Personal Email is required'],
            ['txtContactNumber','errorContactNumber','Contact Number is required'],
            ['txtClosureBy','errorClosureBy','Closure By is required'],
            ['ddlDesignation','errorDesignation','Designation is required'],
            ['txtExperienceRange','errorExperienceRange','Experience Range is required'],
            ['ddlEducationalQualification','errorEducationalQualification','Educational Qualification is required'],
            ['txtComputerSkills','errorComputerSkills','Computer Skills are required'],
            ['txtJobResponsibility','errorJobResponsibility','Job Responsibility is required'],
            ['ddlReportingTo','errorReportingTo','Reporting To is required'],
            ['txtDateOfJoining','errorDateOfJoining','Date of Joining is required'],
            ['ddlCategoryOfEmployment','errorCategoryOfEmployment','Category of Employment is required'],
            ['txtTakeHomeSalary','errorTakeHomeSalary','Take Home Salary is required'],
          ];
          req.forEach(([id,err,msg])=>{
            const el=document.getElementById(id);
            if(!el.value.trim()){ document.getElementById(err).textContent=msg; el.classList.add('is-invalid'); ok=false; }
            else { document.getElementById(err).textContent=''; el.classList.remove('is-invalid'); }
          });
          const age=parseInt(document.getElementById('txtAge').value);
          if(!age){ document.getElementById('errorAge').textContent='Age is required'; document.getElementById('txtAge').classList.add('is-invalid'); ok=false; }
          else if(age<18||age>100){ document.getElementById('errorAge').textContent='Age must be 18–100'; document.getElementById('txtAge').classList.add('is-invalid'); ok=false; }
          else { document.getElementById('errorAge').textContent=''; document.getElementById('txtAge').classList.remove('is-invalid'); }
          if(!document.querySelector('input[name="gender"]:checked')){ document.getElementById('errorGender').textContent='Gender is required'; ok=false; }
          else document.getElementById('errorGender').textContent='';
          if(!selectedBenefits.length){ document.getElementById('errorOtherBenfit').textContent='Other Benefits is required'; ok=false; }
          else document.getElementById('errorOtherBenfit').textContent='';
          return ok;
        }

        /* ─────────── RESET FORM ─────────── */
        function resetForm(){
          selectedBenefits=[];
          document.querySelectorAll('#addPanel .form-group input, #addPanel .form-group select, #addPanel .form-group textarea').forEach(el=>{
            if(el.type==='checkbox'||el.type==='radio') el.checked=false;
            else el.value='';
            el.classList.remove('is-invalid');
          });
          document.querySelectorAll('.err-msg').forEach(el=>el.textContent='');
          renderTagBox();
        }

        /* ─────────── TOAST ─────────── */
        function showToast(msg, type='success'){
          const t=document.createElement('div');
          t.style.cssText=`position:fixed;bottom:24px;right:24px;background:${type==='error'?'#ef4444':'#22c55e'};color:#fff;padding:12px 20px;border-radius:8px;font-size:13px;font-weight:600;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.18);animation:fadein .3s`;
          t.textContent=msg; document.body.appendChild(t);
          setTimeout(()=>{ t.style.opacity='0'; t.style.transition='opacity .4s'; setTimeout(()=>t.remove(),400); },2800);
        }

        /* ─────────── PDF DOWNLOAD ─────────── */
        function downloadPDF(){
          const el=document.getElementById('pdfContent');
          // Simple print approach for demo
          const w=window.open('','_blank');
          w.document.write('<html><head><title>Manpower Form</title><style>body{font-family:sans-serif;font-size:13px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ccc;padding:8px}th{background:#f5f5f5}</style></head><body>'+el.innerHTML+'</body></html>');
          w.document.close(); w.print();
        }

        /* ─────────── INIT ─────────── */
        document.addEventListener('DOMContentLoaded',()=>{
          initTagBox();
          renderTable();
          // Close on Escape
          document.addEventListener('keydown',e=>{ if(e.key==='Escape'){ closePanels(); closeView(); } });
        });
    </script>
</body>
</html> *@