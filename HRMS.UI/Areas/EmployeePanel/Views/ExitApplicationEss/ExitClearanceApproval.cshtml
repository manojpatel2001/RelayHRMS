@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Exit Application Approval";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrls = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrls);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<title>Exit Approval Panel</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
    /* NOC Preview Modal Styles (kept — custom printable form doesn't map to WMSGrid) */
    .noc-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
        overflow: auto;
    }

    .noc-modal-content {
        background-color: #fefefe;
        margin: 2% auto;
        padding: 0;
        border: 1px solid #888;
        width: 90%;
        max-width: 900px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .noc-modal-header {
        padding: 15px 20px;
        background-color: #3e4b6d;
        color: white;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .noc-modal-header h3 {
            margin: 0;
            font-size: 18px;
        }

    .noc-close {
        color: white;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
    }

        .noc-close:hover,
        .noc-close:focus {
            color: #ddd;
        }

    .noc-modal-body {
        padding: 20px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .noc-form-container {
        border: 2px solid #333;
        padding: 20px;
        background-color: white;
    }

    .noc-form-header {
        display: flex;
        border: 1px solid #000;
        margin-bottom: 10px;
    }

    .noc-logo-section {
        border-right: 1px solid #000;
        padding: 10px;
        width: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .noc-title-section {
        flex: 1;
        padding: 10px;
        text-align: center;
        border-right: 1px solid #000;
    }

        .noc-title-section h2 {
            margin: 0;
            font-size: 16px;
            font-weight: bold;
        }

    .noc-doc-info {
        padding: 10px;
        width: 120px;
        font-size: 11px;
    }

    .noc-approval-section {
        display: flex;
        border: 1px solid #000;
        margin-bottom: 10px;
    }

        .noc-approval-section > div {
            padding: 8px;
            border-right: 1px solid #000;
            font-size: 12px;
        }

            .noc-approval-section > div:last-child {
                border-right: none;
            }

    .noc-info-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
        font-size: 12px;
    }

        .noc-info-table td {
            border: 1px solid #000;
            padding: 8px;
        }

            .noc-info-table td:first-child {
                font-weight: bold;
                width: 40%;
            }

    .noc-items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
        font-size: 11px;
    }

        .noc-items-table th,
        .noc-items-table td {
            border: 1px solid #000;
            padding: 6px;
            text-align: left;
        }

        .noc-items-table th {
            background-color: #f0f0f0;
            font-weight: bold;
            text-align: center;
        }

    .noc-signature-section {
        margin-top: 15px;
    }

    .noc-signature-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
        margin-bottom: 10px;
    }

        .noc-signature-table th,
        .noc-signature-table td {
            border: 1px solid #000;
            padding: 8px;
        }

        .noc-signature-table th {
            background-color: #f0f0f0;
            font-weight: bold;
            text-align: center;
        }

    .noc-note {
        font-size: 11px;
        margin-top: 10px;
        padding: 10px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
    }

        .noc-note strong {
            display: block;
            margin-bottom: 5px;
        }

    .noc-declaration {
        font-size: 11px;
        margin-top: 10px;
        padding: 10px;
        border: 1px solid #000;
    }

        .noc-declaration strong {
            display: block;
            margin-bottom: 5px;
            text-decoration: underline;
        }

    .noc-modal-footer {
        padding: 15px 20px;
        background-color: #f5f5f5;
        border-top: 1px solid #ddd;
        text-align: right;
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .btn-download-pdf {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 20px;
        font-size: 14px;
        font-weight: 600;
        border-radius: 4px;
        cursor: pointer;
        margin-left: 10px;
    }

        .btn-download-pdf:hover {
            background-color: #c82333;
        }

    .checkmark {
        color: green;
        font-weight: bold;
        font-size: 16px;
    }

    .crossmark {
        color: red;
        font-weight: bold;
        font-size: 16px;
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Exit Application Approval</h6>
            <button type="button" class="btn btn-secondary btn-sm" id="btnBack">Back</button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 170px;min-width:160px;">
                    <label for="searchby">Search By</label>
                    <select id="searchby">
                        <option value="1">Emp Name</option>
                        <option value="2">Emp Code</option>
                        <option value="3">Reason</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="searchfor">Search For</label>
                    <input type="text" id="searchfor" placeholder="Enter search text" />
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="r2" name="type" value="Pending" checked>
                            <label class="form-check-label" for="r2">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="r3" name="type" value="Approved">
                            <label class="form-check-label" for="r3">Approved</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="r4" name="type" value="Rejected">
                            <label class="form-check-label" for="r4">Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">GO</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="actionButtonsWrap" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnSelectAllExitClr">
                        <i class="bx bx-check-square"></i> Select All
                    </button>
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnApprove">
                        <i class="bx bx-check"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Approve</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="btnReject">
                        <i class="bx bx-x"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Reject</span>
                    </button>
                </div>
            </div>

            <div id="gridContainerExitClearance"></div>
        </div>
    </div>

</div>

<!-- NOC Form Modal -->
<div id="nocModal" class="noc-modal">
    <div class="noc-modal-content">
        <div class="noc-modal-header">
            <h3>NOC Form Preview - F &amp; F Settlement Form</h3>
            <button class="noc-close" onclick="closeNOCModal()">&times;</button>
        </div>
        <div class="noc-modal-body" id="nocModalBody">
            <!-- NOC Form content will be dynamically inserted here -->
        </div>
        <div class="noc-modal-footer">
            <button class="btn btn-secondary btn-sm" onclick="closeNOCModal()">Close</button>
            <button class="btn-download-pdf" onclick="downloadNOCForm('pdf')">
                <i class="bx bx-download"></i> Download PDF
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        const EmployeeId = localStorage.getItem('EmployeeId');
        let currentExitApplicationID = null;
        let currentNOCData = null;

        var grid = null;
        var currentRows = [];
        var selectedIds = {};
        var isLoadingExitClr = false;
        var isProcessingExitClr = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function statusPill(row) {
            if (row.isApproved === true) return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (row.isRejected === true) return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (row.isPending === true) return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return '-';
        }

        function getStatus() {
            return $('input[name="type"]:checked').val() || null;
        }

        function getSearchByText(value) {
            switch (value) {
                case '1': return 'EmpName';
                case '2': return 'EmpCode';
                case '3': return 'Reason';
                default: return null;
            }
        }

        $(document).ready(function () {
            // Wrapped so the grid's first paint (its per-row Export action,
            // gated below in the render callback) already reflects the real
            // permission list instead of racing ahead of it.
            PermGuard.onReady(function () {
                loadExitClearanceData();
            });

            PermGuard.applyActions('ess-exitapplicationess-exitclearanceapproval', { edit: '#btnApprove, #btnReject' });

            $('#btnBack').on('click', function () {
                window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
            });

            $('#btnGo').on('click', function () { loadExitClearanceData(); });

            $('#btnClear').on('click', function () {
                $('#searchby').val('1');
                $('#searchfor').val('');
                $('input[name="type"][value="Pending"]').prop('checked', true);
                loadExitClearanceData();
            });

            $('#btnApprove').on('click', function () { updateExitStatus('Approved'); });
            $('#btnReject').on('click', function () { updateExitStatus('Rejected'); });

            $('#btnSelectAllExitClr').on('click', function () {
                var allSelected = currentRows.length > 0 && currentRows.every(function (r) { return !!selectedIds[r.exitApplicationID]; });
                selectedIds = {};
                if (!allSelected) { currentRows.forEach(function (r) { selectedIds[r.exitApplicationID] = true; }); }
                if (grid) grid.refresh();
            });

            // Close modal on outside click
            $(window).on('click', function (event) {
                if (event.target.id === 'nocModal') {
                    closeNOCModal();
                }
            });
        });

        window._toggleExitClrRow = function (id, checked) {
            if (checked) selectedIds[id] = true;
            else delete selectedIds[id];
        };

        window._previewNocByIdx = function (idx) {
            previewNOCForm(currentRows[idx].employeeId);
        };

        window._downloadNocByIdx = function (idx) {
            downloadNOCFormDirect(currentRows[idx].employeeId, 'pdf');
        };

        function getSelectedRows() {
            return currentRows.filter(function (r) { return !!selectedIds[r.exitApplicationID]; });
        }

        function loadExitClearanceData() {
            if (isLoadingExitClr) return;
            isLoadingExitClr = true;
            setBtnLoading('#btnGo', 'GO');

            let model = {
                EmployeeId: EmployeeId,
                Status: getStatus(),
                SearchBy: getSearchByText($('#searchby').val()),
                SearchValue: $('#searchfor').val()
            };

            selectedIds = {};
            $('#actionButtonsWrap').hide();

            $.ajax({
                url: "@baseUrls/ExitApplicationAPI/GetExitClearanceApproval",
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                success: function (res) {
                    isLoadingExitClr = false;
                    setBtnNormal('#btnGo', 'GO');

                    if (res.isSuccess && res.data && res.data.length > 0) {
                        currentRows = res.data;
                        renderGrid(currentRows);
                        $('#actionButtonsWrap').show();
                    } else {
                        currentRows = [];
                        grid = null;
                        $('#gridContainerExitClearance').empty();
                        showToast(res.responseMessage || 'No records found.', 'info');
                        $('#actionButtonsWrap').hide();
                    }
                },
                error: function (xhr, status, error) {
                    isLoadingExitClr = false;
                    setBtnNormal('#btnGo', 'GO');
                    console.error('AJAX Error:', { status: status, error: error, responseText: xhr.responseText, statusCode: xhr.status });
                    currentRows = [];
                    grid = null;
                    $('#gridContainerExitClearance').empty();
                    showToast('Error loading data: ' + error, 'error');
                    $('#actionButtonsWrap').hide();
                }
            });
        }

        function renderGrid(data) {
            var columns = [
                {
                    header: '', sortable: false, width: '40px',
                    render: function (v, row) {
                        var checked = selectedIds[row.exitApplicationID] ? ' checked' : '';
                        return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="_toggleExitClrRow(' + row.exitApplicationID + ', this.checked)">';
                    }
                },
                { field: 'employeeCode', header: 'Emp Code', width: '100px' },
                { field: 'fullName', header: 'Employee Name', width: '180px' },
                { header: 'Resignation Date', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.resignationDate); } },
                { field: 'reasonForResignation', header: 'Reason', width: '180px' },
                { header: 'Last Working Date', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.lastWorkingDate); } },
                { header: 'Status', sortable: false, width: '110px', render: function (v, row) { return statusPill(row); } },
                {
                    field: 'approvedByReportingPerson', header: 'Approved By Reporting Person', width: '180px',
                    render: function (v) { return v || '-'; }
                },
                { header: 'Approved Date', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.updatedDate); } },
                {
                    header: 'Preview', sortable: false, width: '90px',
                    render: function (v, row) {
                        if (row.isNOCFormFilled !== true) return '<span class="text-muted">-</span>';
                        var idx = currentRows.indexOf(row);
                        return '<button class="wg-btn wg-btn-outline" title="Preview NOC Form" onclick="_previewNocByIdx(' + idx + ')"><i class="bx bx-show"></i></button>';
                    }
                },
                {
                    header: 'Export', sortable: false, width: '90px', stickyRight: true,
                    render: function (v, row) {
                        if (row.isNOCFormFilled !== true) return '<span class="text-muted">-</span>';
                        if (!PermGuard.has('export-ess-exitapplicationess-exitclearanceapproval')) return '<span class="text-muted">-</span>';
                        var idx = currentRows.indexOf(row);
                        return '<button class="wg-btn wg-btn-outline" title="Download NOC PDF" onclick="_downloadNocByIdx(' + idx + ')"><i class="bx bx-download"></i></button>';
                    }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerExitClearance',
                    title: 'Exit Applications',
                    icon: 'bx-log-out-circle',
                    exportName: 'ExitClearanceApproval',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
            }
        }

        // Function to preview NOC Form
        function previewNOCForm(employeeId) {
            currentExitApplicationID = employeeId;

            $.ajax({
                url: "@baseUrls/NOCAPI/GetNOCByGetEmployeeExitDetails",
                type: 'GET',
                data: { EmployeeId: employeeId },
                success: function (res) {
                    if (res.isSuccess && res.data) {
                        const nocData = Array.isArray(res.data) ? res.data[0] : res.data;

                        if (!nocData) {
                            showToast('No NOC form data found', 'error');
                            return;
                        }

                        currentNOCData = nocData;
                        displayNOCForm(nocData);
                        $("#nocModal").show();
                    } else {
                        showToast(res.responseMessage || 'Failed to load NOC form data', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading NOC form:', error);
                    showToast('Error loading NOC form: ' + error, 'error');
                }
            });
        }

        // Function to display NOC Form in modal
        function displayNOCForm(data) {
            // Company logo path
            const logoUrl = '/assets/images/relaylogo.jpeg';

            const nocItems = data.nocItems || [];

            let itemsHtml = '';
            nocItems.forEach(function (item) {
                const yesCheck = item.isHandedOver ? '✓' : '';
                const noCheck = !item.isHandedOver ? '✓' : '';
                const handoverTo = item.handoverTo && item.handoverTo !== 'NULL' ? item.handoverTo : '-';
                const remarks = item.remarks && item.remarks !== 'NULL' ? item.remarks : '-';

                itemsHtml += `
                    <tr>
                        <td>${item.itemName}</td>
                        <td style="text-align: center;">${yesCheck ? '<span class="checkmark">✓</span>' : ''}</td>
                        <td style="text-align: center;">${noCheck ? '<span class="crossmark">✗</span>' : ''}</td>
                        <td>${handoverTo}</td>
                        <td>${remarks}</td>
                    </tr>
                `;
            });

            const nocFormHtml = `
                <div class="noc-form-container">
                    <!-- Header -->
                    <div class="noc-form-header">
                        <div class="noc-logo-section">
                            <img src="${logoUrl}" alt="Company Logo" style="max-width: 130px; max-height: 60px; object-fit: contain;" onerror="this.style.display='none'; this.parentElement.innerHTML='<strong>RELAY EXPRESS</strong>';" />
                        </div>
                        <div class="noc-title-section">
                            <h2>Title- No Dues Claim/F & F Settlement Form</h2>
                        </div>
                        <div class="noc-doc-info">
                            <strong>Document No-8</strong><br>
                            <strong>Issue No: 1</strong><br>
                            <strong>Page:1 of 1</strong><br>
                            <strong>w.e.f :01.06.2017</strong>
                        </div>
                    </div>

                    <!-- Approval Section -->
                    <div class="noc-approval-section">
                        <div style="width: 33.33%;"><strong>Prepared By:</strong> HRD</div>
                        <div style="width: 33.33%;"><strong>Approved By:</strong> Management</div>
                        <div style="width: 33.33%;"><strong>Issued By:</strong> MR</div>
                    </div>

                    <!-- Employee Information -->
                    <table class="noc-info-table">
                        <tr>
                            <td>Employee Name</td>
                            <td>${data.employeeName || '-'}</td>
                            <td><strong>Employee Code</strong></td>
                            <td>${data.employeeCode || '-'}</td>
                        </tr>
                        <tr>
                            <td>Designation</td>
                            <td>${data.designation || '-'}</td>
                            <td><strong>Branch</strong></td>
                            <td>${data.branch || '-'}</td>
                        </tr>
                        <tr>
                            <td>Department</td>
                            <td>${data.department || '-'}</td>
                            <td><strong>Date of Joining</strong></td>
                            <td>${formatDate(data.dateOfJoining)}</td>
                        </tr>
                        <tr>
                            <td>Resignation Date (Mandatory)</td>
                            <td>${formatDate(data.resignationDate)}</td>
                            <td><strong>Date of Leaving</strong></td>
                            <td>${formatDate(data.lastWorkingDate)}</td>
                        </tr>
                        <tr>
                            <td>Notice Period as per Policy</td>
                            <td>${data.noticePeriodDays || '0'} days</td>
                            <td><strong>Short Fall Days</strong></td>
                            <td>${data.shortFallDays || '0'} days</td>
                        </tr>
                        <tr>
                            <td>Reason of Leaving</td>
                            <td colspan="3">${data.reasonForResignation || '-'}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td colspan="3"><strong>Notice Period actual served: ${data.noticePeriodDays || '0'} days</strong></td>
                        </tr>
                    </table>

                    <!-- Items Handover Table -->
                    <table class="noc-items-table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">Dept. / Section</th>
                                <th style="width: 10%;">Yes</th>
                                <th style="width: 10%;">No</th>
                                <th style="width: 25%;">Handover to</th>
                                <th style="width: 25%;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${itemsHtml}
                        </tbody>
                    </table>

                    <!-- Signature Section -->
                    <div class="noc-signature-section">
                        <table class="noc-signature-table">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Approved By (Dept. Mgr.)</th>
                                    <th>Charge to be given to</th>
                                    <th>Received By (HRD)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="height: 50px;"><strong>Signature</strong></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Note -->
                    <div class="noc-note">
                        <strong>Note:</strong> - Settlement will have to be made to the employee only after obtaining this form duly approved by all
                        concerned and Full & final settlement will be done after 45 days from the last working day and if, employee will not
                        serve notice as per the HQO then HRD will adjust notice period amount against F & F settlement amount.
                    </div>

                    <!-- Employee's Declaration -->
                    <div class="noc-declaration">
                        <strong>Employee's Self Declaration on his Personal Liabilities / A Guarantor:</strong>
                        <p>For any kind of loan (Home Loan/Personal Loan/ Vehicle Loan etc.) taken by me from third party, in that case Relay
                        Express Pvt Ltd. will nowhere liable for its repayment. I will solely and exclusively liable to repay my loan or any kind
                        financial liability to the lender. Even if I have availed any kind of loan /financial facility by making Relay Express as a
                        guarantor and not repaid that liability. I shall be exclusively responsible for that loan repayment, Relay Express will nowhere liable for its repayment.</p>
                        <div style="margin-top: 50px; text-align: right;">
                            <strong>Employee's Signature</strong>
                        </div>
                    </div>
                </div>
            `;

            $('#nocModalBody').html(nocFormHtml);
        }

        // Function to close NOC modal
        window.closeNOCModal = function () {
            $("#nocModal").hide();
            currentExitApplicationID = null;
            currentNOCData = null;
        };

        // Function to download NOC Form
        window.downloadNOCForm = function (format) {
            if (!currentExitApplicationID || !currentNOCData) {
                showToast('No NOC form data available', 'error');
                return;
            }
            downloadNOCFormDirect(currentExitApplicationID, format);
        };

        function formatDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            return `${day}/${month}/${year}`;
        }

        // ============ FIXED PDF GENERATION FUNCTION WITH LOGO AND SINGLE PAGE ============
        function downloadNOCFormDirect(employeeId, format) {
            $.ajax({
                url: "@baseUrls/NOCAPI/GetNOCByGetEmployeeExitDetails",
                type: 'GET',
                data: { EmployeeId: employeeId },
                success: function (res) {
                    if (res.isSuccess && res.data) {
                        const nocData = Array.isArray(res.data) ? res.data[0] : res.data;

                        if (!nocData) {
                            showToast('No NOC form data found', 'error');
                            return;
                        }

                        generateNOCPDF(nocData);
                    } else {
                        showToast(res.responseMessage || 'Failed to load NOC form data', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading NOC form:', error);
                    showToast('Error loading NOC form: ' + error, 'error');
                }
            });
        }

        // Function to generate PDF from NOC data - OPTIMIZED FOR SINGLE PAGE WITH LOGO
        function generateNOCPDF(data) {
            // Company logo path
