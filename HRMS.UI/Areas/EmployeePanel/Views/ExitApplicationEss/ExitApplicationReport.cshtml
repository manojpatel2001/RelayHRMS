@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Exit Application";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrls = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrls);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<title>Exit Application</title>

<style>
    /* NOC Modal Styles (kept — custom handover table doesn't map to WMSGrid) */
    .noc-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
    }

    .noc-modal-content {
        background-color: #fefefe;
        margin: 2% auto;
        padding: 0;
        border: 1px solid #888;
        width: 90%;
        max-width: 900px;
        border-radius: 8px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .noc-modal-header {
        background-color: #3e4b6d;
        color: white;
        padding: 15px 20px;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .noc-modal-header h3 {
            margin: 0;
            font-size: 18px;
        }

    .noc-close {
        color: white;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        line-height: 20px;
    }

        .noc-close:hover {
            color: #ddd;
        }

    .noc-modal-body {
        padding: 20px;
    }

    .noc-form-section {
        margin-bottom: 25px;
    }

        .noc-form-section h4 {
            background-color: #f0f0f0;
            padding: 10px;
            margin: 0 0 15px 0;
            border-left: 4px solid #3e4b6d;
            font-size: 15px;
        }

    .noc-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .noc-table th,
        .noc-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
            font-size: 12px;
        }

        .noc-table th {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        .noc-table input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .noc-table input[type="text"] {
            width: 100%;
            padding: 5px;
            border: 1px solid #ddd;
            border-radius: 3px;
        }

            .noc-table input[type="checkbox"]:disabled,
            .noc-table input[type="text"]:disabled {
                cursor: not-allowed;
                opacity: 0.6;
            }

    .noc-modal-footer {
        padding: 15px 20px;
        background-color: #f8f9fa;
        border-top: 1px solid #ddd;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-save-noc {
        background-color: #28a745;
        color: white;
        padding: 8px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

        .btn-save-noc:hover {
            background-color: #218838;
        }

    .btn-cancel-noc {
        background-color: #6c757d;
        color: white;
        padding: 8px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

        .btn-cancel-noc:hover {
            background-color: #5a6268;
        }

    .noc-note {
        margin-top: 20px;
        padding: 15px;
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
        font-size: 12px;
    }

        .noc-note p {
            margin: 5px 0;
        }

    .btn-update-form {
        background-color: #ffc107;
        color: #000;
        font-size: 12px;
        padding: 4px 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-update-form:hover {
            background-color: #e0a800;
        }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Exit Application</h6>
            <div class="d-flex gap-2">
                <button id="btnAdd" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" style="display:none;">
                    <i class="bx bx-plus"></i> Add
                </button>
                <button id="btnDelete" type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" style="display:none;">
                    <i class="bx bx-trash"></i> Delete
                </button>
                <button id="btnBack" type="button" class="btn btn-secondary btn-sm">Back</button>
            </div>
        </div>
        <div class="card-body">
            <div id="gridContainerExitApplication"></div>

            <div class="note-section mt-3" style="font-size:13px;color:#333;">
                <p class="mb-1"><strong>Note:</strong></p>
                <p class="mb-1"><span style="color:red;font-weight:bold;">Reject *</span> indicate that exit application rejected by manager without interview process.</p>
                <p class="mb-0"><span style="color:red;font-weight:bold;">Reject</span> indicate that exit application rejected by manager with interview process.</p>
            </div>
        </div>
    </div>

</div>

<!-- NOC Form Modal -->
<div id="nocModal" class="noc-modal">
    <div class="noc-modal-content">
        <div class="noc-modal-header">
            <h3>No Dues Claim / F &amp; F Settlement Form</h3>
            <span class="noc-close">&times;</span>
        </div>
        <div class="noc-modal-body">
            <form id="nocForm">
                <input type="hidden" id="currentExitAppId" />
                <input type="hidden" id="isViewOnlyMode" value="false" />

                <div class="noc-form-section">
                    <h4>Department / Section Handover</h4>
                    <table class="noc-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Item</th>
                                <th style="width: 10%; text-align: center;">Yes <span style="color: red;">*</span></th>
                                <th style="width: 10%; text-align: center;">No <span style="color: red;">*</span></th>
                                <th style="width: 20%;">Handover to <span style="color: red;">*</span></th>
                                <th style="width: 20%;">Remarks <span style="color: red;">*</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-item="softCopies">
                                <td>To handover files handled by him/her (Soft Copies) (list required)</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="softCopies" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="softCopies" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="hardCopies">
                                <td>Hard copies (list required)</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="hardCopies" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="hardCopies" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="laptop">
                                <td>Laptop</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="laptop" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="laptop" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="idCard">
                                <td>ID Card</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="idCard" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="idCard" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="keys">
                                <td>Keys for drawers, Cabinets, etc.</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="keys" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="keys" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="vehicle">
                                <td>Company Vehicle with Vehicle No.</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="vehicle" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="vehicle" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="advance">
                                <td>Advance/Loan, If any</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="advance" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="advance" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="accommodation">
                                <td>Accommodation</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="accommodation" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="accommodation" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="mobilePhone">
                                <td>Mobile Phone / Sim Card</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="mobilePhone" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="mobilePhone" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="mobileSetNo">
                                <td>Mobile Set No. / Sim No.</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="mobileSetNo" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="mobileSetNo" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                            <tr data-item="otherBelongings">
                                <td>Other Belongings, If any</td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-yes-checkbox" data-item="otherBelongings" /></td>
                                <td style="text-align: center;"><input type="checkbox" class="noc-no-checkbox" data-item="otherBelongings" /></td>
                                <td><input type="text" class="handover-to" placeholder="Required if Yes" /></td>
                                <td><input type="text" class="remarks" placeholder="Required" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="noc-note">
                    <p><strong>Note:</strong></p>
                    <p>Settlement will have to be made to the employee only after obtaining this form duly approved by all concerned and Full & final settlement will be done after 45 days from the last working day and if, employee will not serve notice period then amount against F & F settlement amount.</p>
                    <p><strong>Employee's Self Declaration on his Personal Liabilities / as a Guarantor:</strong></p>
                    <p>For any kind of loan (Home Loan/Personal Loan/ Vehicle Loan etc.) is taken by me from third party, in that case Relay Express will not be held responsible and shall not be held exclusively liable to repay my loan or any kind of personal liabilities. Also, if I have taken guarantee of any person's loan repayment, then I will be solely &amp; exclusively responsible for that loan repayment. Relay Express will nowhere liable for that repayment.</p>
                </div>
            </form>
        </div>
        <div class="noc-modal-footer">
            <button type="button" class="btn-cancel-noc">Close</button>
            <button type="button" class="btn-save-noc">Save</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const EmployeeId = localStorage.getItem('EmployeeId');

        var grid = null;
        var currentRows = [];
        var selectedIds = {};

        function statusPill(status) {
            if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return status || '-';
        }

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        $(document).ready(function () {
            // Wrapped so loadExitApplicationData's own Add/Delete show/hide
            // business logic (below) already sees the real permission list
            // instead of racing ahead of it -- that function's success/error
            // handlers gate #btnAdd/#btnDelete themselves rather than relying
            // on a separate PermGuard.applyActions call, since which of the
            // two is shown already depends on whether the employee has an
            // existing exit application.
            PermGuard.onReady(function () {
                loadExitApplicationData();
            });

            // Back button handler
            $("#btnBack").click(function () {
                window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
            });

            $("#btnAdd").click(function () {
                window.location.href = '@UIBaseUrl/EmployeePanel/ExitApplicationEss/ExitApplication';
            });

            $("#btnDelete").click(function () {
                var selectedRows = currentRows.filter(function (r) { return !!selectedIds[r.exitApplicationID]; });

                if (selectedRows.length === 0) {
                    showToast('Please select at least one record.', 'warn');
                    return;
                }

                var approvedRecords = selectedRows.filter(function (row) { return row.status === 'Approved'; });
                if (approvedRecords.length > 0) {
                    showToast('Approved records cannot be deleted.', 'error');
                    return;
                }

                var selectedIdsArr = selectedRows.map(function (row) { return row.exitApplicationID; });

                var deletePayload = {
                    Id: selectedIdsArr,
                    DeletedBy: EmployeeId
                };

                setBtnLoading('#btnDelete', 'Deleting...');

                $.ajax({
                    url: "@baseUrls/ExitApplicationAPI/Delete",
                    type: 'DELETE',
                    contentType: 'application/json',
                    data: JSON.stringify(deletePayload),
                    success: function (res) {
                        setBtnNormal('#btnDelete', 'Delete');
                        if (res.isSuccess) {
                            showToast(res.responseMessage || "Deleted successfully.", 'success');
                            selectedIds = {};
                            loadExitApplicationData();
                        } else {
                            showToast(res.responseMessage || "Deletion failed.", 'error');
                        }
                    },
                    error: function () {
                        setBtnNormal('#btnDelete', 'Delete');
                        showToast('Something went wrong during deletion.', 'error');
                    }
                });
            });

            // NOC Modal handlers
            $(".noc-close, .btn-cancel-noc").click(function () {
                $("#nocModal").hide();
            });

            // Close modal on outside click
            $(window).click(function (event) {
                if (event.target.id === 'nocModal') {
                    $("#nocModal").hide();
                }
            });

            // Checkbox exclusive selection (Yes/No cannot both be checked)
            $(".noc-yes-checkbox").change(function () {
                if ($(this).is(':checked')) {
                    $(`.noc-no-checkbox[data-item="${$(this).data('item')}"]`).prop('checked', false);
                }
            });

            $(".noc-no-checkbox").change(function () {
                if ($(this).is(':checked')) {
                    $(`.noc-yes-checkbox[data-item="${$(this).data('item')}"]`).prop('checked', false);
                }
            });

            // Save NOC Form
            $(".btn-save-noc").click(function () {
                saveNOCForm();
            });
        });

        function loadExitApplicationData() {
            if (grid) grid.showLoader();

            $.ajax({
                url: "@baseUrls/ExitApplicationAPI/GetExitApplicationById",
                type: 'GET',
                data: { EmployeeId: EmployeeId },
                success: function (res) {
                    if (res.isSuccess && res.data) {
                        let gridData = Array.isArray(res.data) ? res.data : [res.data];
                        $("#btnAdd").hide();
                        if (PermGuard.has('delete-ess-exitapplicationess-exitapplicationreport')) { $("#btnDelete").show(); } else { $("#btnDelete").hide(); }
                        currentRows = gridData;
                        selectedIds = {};
                        renderGrid(gridData);
                    } else {
                        if (PermGuard.has('create-ess-exitapplicationess-exitapplicationreport')) { $("#btnAdd").show(); } else { $("#btnAdd").hide(); }
                        $("#btnDelete").hide();
                        currentRows = [];
                        selectedIds = {};
                        renderGrid([]);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', error);
                    if (PermGuard.has('create-ess-exitapplicationess-exitapplicationreport')) { $("#btnAdd").show(); } else { $("#btnAdd").hide(); }
                    $("#btnDelete").hide();
                    currentRows = [];
                    selectedIds = {};
                    renderGrid([]);
                }
            });
        }

        window._toggleExitRow = function (id, checked) {
            if (checked) selectedIds[id] = true;
            else delete selectedIds[id];
        };

        function employeeStatusText(row) {
            if (row.isApproved === true) return statusPill('Approved');
            if (row.isRejected === true) return statusPill('Rejected');
            if (row.isPending === true) return statusPill('Pending');
            return '-';
        }

        function hrStatusText(row) {
            if (row.isApprovedByHR === true) return '<span class="wg-pill wg-pill-green">Approved by HR</span>';
            if (row.isRejectedByHR === true) return '<span class="wg-pill wg-pill-red">Rejected by HR</span>';
            return '-';
        }

        function nocStatusText(row) {
            var isFormFilled = row.isNOCFormFilled === true || row.IsNOCFormFilled === true;
            if (isFormFilled) return '<span style="color:#2E7D32;">&#9989; Filled</span>';
            return '<span style="color:#E65100;">&#9203; Pending</span>';
        }

        function nocActionHtml(row, idx) {
            if (row.isApproved !== true) return '<span class="text-muted">-</span>';

            var isFormFilled = row.isNOCFormFilled === true || row.IsNOCFormFilled === true;
            var isApprovedByHR = row.isApprovedByHR === true;

            // If HR has approved, show only View button (read-only mode)
            if (isApprovedByHR && isFormFilled) {
                return '<button class="wg-btn wg-btn-outline" onclick="_openNocModalByIdx(' + idx + ', true)">View NOC Form</button>';
            }
            // If HR hasn't approved yet, allow fill/update
            if (!isApprovedByHR) {
                if (!PermGuard.has('edit-ess-exitapplicationess-exitapplicationreport')) return '<span class="text-muted">-</span>';
                var label = isFormFilled ? 'Update NOC Form' : 'Fill NOC Form';
                var cls = isFormFilled ? 'wg-btn-outline' : 'wg-btn-primary';
                return '<button class="wg-btn ' + cls + '" onclick="_openNocModalByIdx(' + idx + ', false)">' + label + '</button>';
            }
            // If HR approved but form not filled (edge case)
            return '<span class="text-muted">-</span>';
        }

        window._openNocModalByIdx = function (idx, isViewOnly) {
            openNOCModal(currentRows[idx], isViewOnly);
        };

        /* ── Render WMSGrid ───────────────────────────── */
        function renderGrid(data) {
            var columns = [
                {
                    header: '', sortable: false, width: '40px',
                    render: function (v, row) {
                        var checked = selectedIds[row.exitApplicationID] ? ' checked' : '';
                        return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="_toggleExitRow(' + row.exitApplicationID + ', this.checked)">';
                    }
                },
                { field: 'employeeCode', header: 'Code', width: '100px' },
                { field: 'fullName', header: 'Employee', width: '200px' },
                { header: 'Resignation Date', sortable: false, width: '140px', render: function (v, row) { return fmtDate(row.resignationDate); } },
                { header: 'Last Working Date', sortable: false, width: '140px', render: function (v, row) { return fmtDate(row.lastWorkingDate); } },
                { header: 'Employee Status', sortable: false, width: '140px', render: function (v, row) { return employeeStatusText(row); } },
                { header: 'HR Status', sortable: false, width: '150px', render: function (v, row) { return hrStatusText(row); } },
                { header: 'NOC Status', sortable: false, width: '110px', render: function (v, row) { return nocStatusText(row); } },
                {
                    header: 'NOC Form Action', sortable: false, width: '150px', stickyRight: true,
                    render: function (v, row) { return nocActionHtml(row, currentRows.indexOf(row)); }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerExitApplication',
                    title: 'Exit Applications',
                    icon: 'bx-log-out-circle',
                    exportName: 'ExitApplications',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
                grid.hideLoader();
            }
        }

        function openNOCModal(rowData, isViewOnly = false) {
            // Reset form first
            $("#nocForm")[0].reset();
            $("#currentExitAppId").val(rowData.exitApplicationID);
            $("#isViewOnlyMode").val(isViewOnly ? "true" : "false");
            $(".noc-yes-checkbox, .noc-no-checkbox").prop('checked', false);
            $(".noc-table input[type='text']").val('');

            // Clear any existing NOSID data attributes
            $(".noc-table tbody tr[data-item]").removeAttr('data-nosid');

            // Set modal title and button based on mode
            if (isViewOnly) {
                $(".noc-modal-header h3").text("View No Dues Claim / F & F Settlement Form");
                $(".btn-save-noc").hide();
                $(".btn-cancel-noc").text("Close");

                // Disable all form inputs
                $(".noc-table input").prop('disabled', true);
            } else {
                $(".noc-modal-header h3").text("No Dues Claim / F & F Settlement Form");
                $(".btn-cancel-noc").text("Cancel");

                const isFormFilled = rowData.isNOCFormFilled === true || rowData.IsNOCFormFilled === true;
                $(".btn-save-noc").text(isFormFilled ? "Update" : "Save").show();

                // Enable all form inputs
                $(".noc-table input").prop('disabled', false);
            }

            // Load existing data if form is filled
            const isFormFilled = rowData.isNOCFormFilled === true || rowData.IsNOCFormFilled === true;
            if (isFormFilled) {
                loadExistingNOCData(rowData.exitApplicationID);
            }

            $("#nocModal").show();
        }

        function loadExistingNOCData(exitAppId) {
            $.ajax({
                url: "@baseUrls/NOCAPI/GetNOCByExitApplicationId?exitApplicationId=" + exitAppId,
                type: 'GET',
                success: function (response) {
                    if (response.isSuccess && response.data && response.data.length > 0) {
                        // Populate the form with existing data
                        response.data.forEach(function(item) {
                            $(".noc-table tbody tr[data-item]").each(function() {
                                const row = $(this);
                                const rowItemName = row.find('td:first').text().trim();

                                if (rowItemName === item.itemName) {
                                    // Store NOSID in the row for update
                                    row.attr('data-nosid', item.nosid);

                                    // Set checkboxes
                                    if (item.isHandedOver) {
                                        row.find('.noc-yes-checkbox').prop('checked', true);
                                        row.find('.noc-no-checkbox').prop('checked', false);
                                    } else {
                                        row.find('.noc-yes-checkbox').prop('checked', false);
                                        row.find('.noc-no-checkbox').prop('checked', true);
                                    }

                                    // Set text fields
                                    row.find('.handover-to').val(item.handoverTo || '');
                                    row.find('.remarks').val(item.remarks || '');
                                }
                            });
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error loading NOC data:", error);
                    showToast('Failed to load existing NOC data.', 'error');
                }
            });
        }

        var isSavingNOC = false;

        function saveNOCForm() {
            const isViewOnly = $("#isViewOnlyMode").val() === "true";

            if (isViewOnly) {
                $("#nocModal").hide();
                return;
            }

            if (isSavingNOC) return;

            const exitAppId = $("#currentExitAppId").val();

            if (!exitAppId) {
                showToast('Exit Application ID is missing.', 'error');
                return;
            }

            // Validate all fields are filled - Check checkboxes first
            let hasCheckboxError = false;
            let checkboxErrors = [];

            // First pass: Check only Yes/No checkboxes
            $(".noc-table tbody tr[data-item]").each(function () {
                const row = $(this);
                const itemName = row.find('td:first').text().trim();
                const yesChecked = row.find('.noc-yes-checkbox').is(':checked');
                const noChecked = row.find('.noc-no-checkbox').is(':checked');

                if (!yesChecked && !noChecked) {
                    hasCheckboxError = true;
                    checkboxErrors.push(`${itemName}: This field is mandatory`);
                }
            });

            // If checkbox errors exist, show them immediately and stop
            if (hasCheckboxError) {
                showToast(checkboxErrors.join(' | '), 'error');
                return;
            }

            // Second pass: Validate other fields and collect data
            let validationErrors = [];
            const nocItems = [];

            $(".noc-table tbody tr[data-item]").each(function () {
                const row = $(this);
                const itemName = row.find('td:first').text().trim();
                const yesChecked = row.find('.noc-yes-checkbox').is(':checked');
                const noChecked = row.find('.noc-no-checkbox').is(':checked');
                const handoverTo = row.find('.handover-to').val()?.trim() || '';
                const remarks = row.find('.remarks').val()?.trim() || '';
                const nosid = row.attr('data-nosid') ? parseInt(row.attr('data-nosid')) : 0;

                // Validation: If Yes is selected, Handover To is mandatory
                if (yesChecked && !handoverTo) {
                    validationErrors.push(`${itemName}: This field is mandatory`);
                }

                // Validation: Remarks is mandatory for all items
                if (!remarks) {
                    validationErrors.push(`${itemName}: This field is mandatory`);
                }

                // Collect item data
                nocItems.push({
                    NOSID: nosid,
                    ExitApplicationID: parseInt(exitAppId),
                    ItemName: itemName,
                    IsHandedOver: yesChecked,
                    HandoverTo: handoverTo || null,
                    Remarks: remarks || null,
                    DocumentProof: null,
                    CreatedBy: parseInt(EmployeeId)
                });
            });

            // Show other validation errors if any
            if (validationErrors.length > 0) {
                showToast(validationErrors.join(' | '), 'error');
                return;
            }

            isSavingNOC = true;
            setBtnLoading('.btn-save-noc', 'Saving...');

            let successCount = 0;
            let errorCount = 0;
            const totalItems = nocItems.length;

            // Process each item
            nocItems.forEach((item, index) => {
                const apiUrl = item.NOSID > 0
                    ? "@baseUrls/NOCAPI/UpdateNOC"
                    : "@baseUrls/NOCAPI/CreateNOC";

                $.ajax({
                    url: apiUrl,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(item),
                    success: function (response) {
                        successCount++;

                        if (successCount + errorCount === totalItems) {
                            handleSaveComplete(successCount, errorCount, exitAppId);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error(`Error saving item ${index + 1}/${totalItems}:`, item.ItemName, {
                            status: xhr.status,
                            statusText: xhr.statusText,
                            response: xhr.responseText,
                            error: error
                        });

                        errorCount++;

                        if (successCount + errorCount === totalItems) {
                            handleSaveComplete(successCount, errorCount, exitAppId);
                        }
                    }
                });
            });
        }

        function handleSaveComplete(successCount, errorCount, exitAppId) {
            if (successCount > 0 && errorCount === 0) {
                // All items saved/updated successfully, now update the flag
                updateNOCFormFlag(exitAppId);
            } else {
                isSavingNOC = false;
                setBtnNormal('.btn-save-noc', 'Save');
                if (successCount > 0 && errorCount > 0) {
                    showToast(`Saved/Updated: ${successCount}, Failed: ${errorCount}. Check console for details.`, 'error');
                } else {
                    showToast('Failed to save/update NOC items. Please check console for details.', 'error');
                }
            }
        }

        function updateNOCFormFlag(exitAppId) {
            $.ajax({
                url: "@baseUrls/ExitApplicationAPI/UpdateNOCFormFlag?exitApplicationId=" + exitAppId,
                type: 'PUT',
                contentType: 'application/json',
                success: function (response) {
                    isSavingNOC = false;
                    setBtnNormal('.btn-save-noc', 'Save');
                    if (response.isSuccess) {
                        showToast('NOC Form saved/updated successfully!', 'success');
                        $("#nocModal").hide();

                        // Reload grid to get fresh data
                        setTimeout(function() {
                            loadExitApplicationData();
                        }, 500);
                    } else {
                        showToast(response.responseMessage || 'Failed to update NOC form flag.', 'error');
                    }
                },
                error: function (xhr, status, error) {
                    isSavingNOC = false;
                    setBtnNormal('.btn-save-noc', 'Save');
                    console.error("Error updating NOC form flag:", error);
                    showToast('Failed to update NOC form flag.', 'error');
                }
            });
        }
    })();
</script>
