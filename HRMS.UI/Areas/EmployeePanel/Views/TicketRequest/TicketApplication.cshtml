@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Ticket Application";
	Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
	string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
	string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
	var uriAPI = new Uri(baseUrl);
	string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}

<div class="wms-form-page">

	<div class="card">
		<div class="card-header d-flex justify-content-between align-items-center">
			<h6 class="mb-0">Ticket Application</h6>
		</div>

		<div class="card-body">
			<div id="gridContainerTicketApplication"></div>
		</div>
	</div>

</div>


<div class="modal fade" id="sendTicketRequestModel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title btn-heading-title" id="exampleModalLabel"><span class="formType">Send</span> Ticket Request</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="wms-form-page">
				<div class="row  ">
					<!-- Ticket Generate Date -->
					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="ticketDate">Ticket Generate Date</label>
							<input type="date"
								   id="ticketDate"
								   readonly />
						</div>
						<span id="spnTicketDate" class="field-validation-error" style="display:none; ">Please select Ticket Generate Date</span>
					</div>

					<!-- Ticket Assign -->
					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="drpDepartment">Department</label>
							<select id="drpDepartment">
								<option value="" selected disabled>Select</option>

							</select>
						</div>
						<span id="spnDepartment" class="field-validation-error" style="display:none; ">Please select Department</span>
					</div>

					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="drpAssign">Ticket Assign</label>
							<select id="drpAssign">
								<option value="" selected disabled>Select</option>

							</select>
						</div>
						<span id="spnAssign" class="field-validation-error" style="display:none; ">Please select Ticket Assign</span>
					</div>


					<!-- Ticket Type -->
					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="drpTiketType">Ticket Type</label>
							<select id="drpTiketType">
								<option value="" selected disabled>Select</option>
							</select>
						</div>
						<span id="spnTicketType" class="field-validation-error" style="display:none; ">Please select Ticket Type</span>
					</div>


					<!-- Ticket Priority -->
					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="priorityid">Ticket Priority</label>
							<select id="drpTicketPriority">
								<option value="" selected disabled>Select</option>
							</select>
						</div>
						<span id="spnTicketPriority" class="field-validation-error" style="display:none; ">Please select Ticket Priority</span>
					</div>



					<!-- Attach Document -->
					<div class="col-sm-4 mt-3">
						<div class="fg">
							<label for="attatchFile">Attach Document</label>
							<input type="file"
								   id="attatchFile" />
						</div>
					</div>

					<!-- Ticket Description -->
					<div class="col-sm-12 mt-3">
						<div class="fg fg-req">
							<label for="txtDescription">Ticket Description</label>
							<textarea id="txtDescription"
									  data-trim-input
									  style="height:30px;"
									  placeholder=" "></textarea>
						</div>
						<span id="spnDescription" class="field-validation-error" style="display:none;">Please Enter Description</span>

					</div>


				</div>
				</div>




			</div>
			<div class="modal-footer btn-heading-title">

				<button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1" id="btnSendRequest">
					<span class="btn-spinner-icon"></span>
					<span class="btn-label-text">Send</span>
				</button>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>


<div class="modal fade" id="followUpModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title btn-heading-title" id="exampleModalLabel"><span class="formType">Add</span> Ticket Follow Up</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body modal-body-font">
				<div class="wms-form-page">
				<div class="row  ">
					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="folloUpDate">Ticket Follow Up Date</label>
							<input type="date"
								   id="folloUpDate"
								   readonly />
						</div>
						<span id="spnFolloUpDate" class="field-validation-error" style="display:none; ">Please select Ticket FollowUp Date</span>
					</div>

					<div class="col-sm-4 mt-3" id="tagNextFollowUpDate">
						<div class="fg fg-req">
							<label for="nextFolloUpDate">Next Follou Up Date</label>
							<input type="date"
								   id="nextFolloUpDate" />
						</div>
						<span id="spnNextFolloUpDate" class="field-validation-error" style="display:none; ">Please select Next FollowUp Date</span>

					</div>


					<div class="col-sm-4 mt-3">
						<div class="fg fg-req">
							<label for="drpTicketStatus">Ticket Status</label>
							<select id="drpTicketStatus">
								<option value="" selected disabled>Select</option>
							</select>
						</div>
						<span id="spnTicketStatus" class="field-validation-error" style="display:none; ">Please select Ticket Status.</span>
					</div>



					<!-- Attach Document -->
					<div class="col-sm-4 mt-3">
						<div class="form-group">
							<div class="input-group">
								<input type="file" class="form-control" id="attatchFollowUpFile" />
								<a href="#" style="display:none;" id="followUpFileLink" target="_blank">
									<span class="input-group-text " style="border-radius:0px; cursor:pointer;">
										<i class="bx bx-file text-danger"></i>
									</span>
								</a>
							</div>

						</div>
					</div>

					<div class="col-sm-12 mt-3">
						<div class="fg fg-req">
							<label for="txtFolloUpRemark">Folllow Up Remark</label>
							<textarea id="txtFolloUpRemark"
									  data-trim-input
									  style="height:50px;"
									  placeholder=" "></textarea>
						</div>
						<span id="spnFolloUpRemark" class="field-validation-error" style="display:none;">Please Enter Folllow Up Remark</span>

					</div>


				</div>
				</div>

				<div class="modal-footer btn-heading-title">

					<button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1" id="btnAddFollowUp">
						<span class="btn-spinner-icon"></span>
						<span class="btn-label-text">Add</span>
					</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				</div>

				<div class="row mt-3">
					<div class="col-md-12">
						<div id="gridContainerTicketFollowUp"></div>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>

<script>
	(function () {
		const EmployeeId = localStorage.getItem("EmployeeId");
		var Token = localStorage.getItem("authToken");
		const savedCompany = localStorage.getItem('selectedCompany');
		const companyDetails = JSON.parse(savedCompany || '{}');
		const companyId = parseInt(companyDetails.CompanyId);
		let TicketStatusId = 0;
		let TicketApplicationId = 0;

		var grid = null;
		var currentRows = [];
		var isLoadingTicketApp = false;

		var followGrid = null;
		var followCurrentRows = [];
		var isLoadingFollowUp = false;

		function fmtDate(v) {
			if (!v) return '-';
			var d = new Date(v);
			if (isNaN(d.getTime())) return '-';
			var day = String(d.getDate()).padStart(2, '0');
			var month = String(d.getMonth() + 1).padStart(2, '0');
			return day + '/' + month + '/' + d.getFullYear();
		}

		function statusPill(status) {
			if (status === 'Close' || status === 'Resolved') return '<span class="wg-pill wg-pill-green">' + status + '</span>';
			if (status === 'Open') return '<span class="wg-pill wg-pill-amber">Open</span>';
			return status ? '<span class="wg-pill wg-pill-amber">' + status + '</span>' : '-';
		}

		function attachmentLink(value) {
			if (!value) return 'No Document';
			return '<a href="' + value + '" target="_blank" title="Open Document" style="color:inherit;text-decoration:none;font-size:20px;"><i class="bx bx-file"></i></a>';
		}

		$(() => {

			setTicketDate();
			localStorage.removeItem('ticketApplicationLocalstorage');

			// Wrapped so the grid's first paint (its per-row Follow-Up action,
			// gated above in the render callback) already reflects the real
			// permission list instead of racing ahead of it.
			PermGuard.onReady(function () {
				TicketApplicationDataTable();
			});

		});

		function setTicketDate(){
			const today = new Date();
			// Format the date as YYYY-MM-DD for the date input field
			const formattedDate = today.toISOString().substring(0, 10);

			// Set the value of the date input field to the current date
			$('#folloUpDate').val(formattedDate);
		}

		window._followUpRow = function (ticketApplicationId) {
			var row = currentRows.find(function (r) { return r.ticketApplicationId === ticketApplicationId; });
			if (row) followUpTicketApplication(row);
		};

		function renderGrid(data) {
			var columns = [
				{
					header: 'Employee Name', sortable: false, width: '180px',
					render: function (v, row) { return (row.employeeCode || '') + ' - ' + (row.employeeName || ''); }
				},
				{ field: 'departmentName', header: 'Department', width: '140px' },
				{ field: 'ticketTypeName', header: 'Ticket Type', width: '140px' },
				{ field: 'ticketDescription', header: 'Ticket Description', width: '200px' },
				{ field: 'ticketPriorityName', header: 'Ticket Priority', width: '130px' },
				{ field: 'escalationHours', header: 'Escalation Hours', width: '120px' },
				{
					header: 'AssignTo', sortable: false, width: '170px',
					render: function (v, row) { return (row.assignToCode || '') + ' - ' + (row.assignTo || ''); }
				},
				{ header: 'Ticket Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.ticketDate); } },
				{ header: 'Attachment', sortable: false, width: '100px', render: function (v, row) { return attachmentLink(row.attachDocumentUrl); } },
				{ header: 'Ticket Status', sortable: false, width: '120px', render: function (v, row) { return statusPill(row.ticketStatusName); } },
				{
					header: 'Action', sortable: false, width: '70px', stickyRight: true,
					render: function (v, row) {
						if (row.ticketStatusName === 'Close' || row.ticketStatusName === 'Resolved') return '<span class="text-muted">-</span>';
						if (!PermGuard.has('edit-ess-ticketrequest-ticketapplication')) return '<span class="text-muted">-</span>';
						return '<button class="wg-btn wg-btn-primary" title="Follow Up Ticket Request" onclick="_followUpRow(' + row.ticketApplicationId + ')"><i class="bx bx-plus"></i></button>';
					}
				}
			];

			if (!grid) {
				grid = WMSGrid.create({
					container: 'gridContainerTicketApplication',
					title: 'Ticket Applications',
					icon: 'bx-support',
					exportName: 'TicketApplications',
					data: data,
					columns: columns,
					perPage: 100000,
					features: { pagination: false, perPage: false, paginationInfo: false }
				});
			} else {
				grid.setData(data);
			}
		}

		function TicketApplicationDataTable() {
			if (isLoadingTicketApp) return;
			try {
				isLoadingTicketApp = true;
				$.ajax({
					type: "POST",
					url: '@baseUrl/TicketApplicationAPI/GetAllAssignTicketApplications',
					contentType: 'application/json',
					headers: {
						'Authorization': 'Bearer ' + Token
					},
					data: JSON.stringify({CompanyId:companyId,EmployeeId}),
					success: function (data) {
						if (data.isSuccess) {
							currentRows = data.data || [];
							renderGrid(currentRows);
						} else {
							currentRows = [];
							renderGrid(currentRows);
						}
					},
					error: function (xhr, status, error) {
						console.error("AJAX Error: " + status + " - " + error);
						currentRows = [];
						renderGrid(currentRows);
						showToast('Error loading ticket applications.', 'error');
					},
					complete: function () {
						isLoadingTicketApp = false;
					}
				});

			  } catch (e)
			  {
				   console.error("Error in fetching ticket application:", e);
				   isLoadingTicketApp = false;
			  }
		}

		function clearTicketStatusForm()
		{
				TicketApplicationId=0
			setTicketDate();// Set date in YYYY-MM-DD format
				$('#drpDepartment').val('');
				$('#drpAssign').val('');
				$('#drpTiketType').val('');
				$('#drpTicketPriority').val('');
				$('#txtDescription').val('');
			setBtnNormal('#btnSendRequest', 'Send');
			$('.formType').text('Send');
			   $('#spnTicketDate').hide();
			   $('#spnDepartment').hide();
			   $('#spnAssign').hide();
			   $('#spnTicketType').hide();
			   $('#spnTicketPriority').hide();
			   $('#spnDescription').hide();

		}


	$('#btnSendRequest').click(function () {
		setBtnLoading('#btnSendRequest', 'Send');
		let isValid = true;

		// Get form values
		const ticketDate = $('#ticketDate').val();
		const departmentId = $('#drpDepartment').val();
		const ticketAssignId = $('#drpAssign').val();
		const ticketTypeId = $('#drpTiketType').val();
		const ticketPriorityId = $('#drpTicketPriority').val();
		const ticketDescription = $('#txtDescription').val();
		const attachFile = $('#attatchFile')[0].files[0];
		// Validation
		if (ticketDate === '') {
			$('#spnTicketDate').show();
			isValid = false;
		} else {
			$('#spnTicketDate').hide();
		}

		if (departmentId === '' || departmentId === null) {
			$('#spnDepartment').show();
			isValid = false;
		} else {
			$('#spnDepartment').hide();
		}
		if (ticketAssignId === '' || ticketAssignId === null) {
			$('#spnAssign').show();
			isValid = false;
		} else {
			$('#spnAssign').hide();
		}

		if (ticketTypeId === '' || ticketTypeId === null) {
			$('#spnTicketType').show();
			isValid = false;
		} else {
			$('#spnTicketType').hide();
		}

		if (ticketPriorityId === '' || ticketPriorityId === null) {
			$('#spnTicketPriority').show();
			isValid = false;
		} else {
			$('#spnTicketPriority').hide();
		}

		if (ticketDescription === '') {
			$('#spnDescription').show();
			isValid = false;
		} else {
			$('#spnDescription').hide();
		}

		if (!isValid) {
			setBtnNormal('#btnSendRequest', 'Send');
			return;
		}

		// Create FormData object
		const formData = new FormData();

		// Append all form data
		formData.append('TicketApplicationId', TicketApplicationId || 0);
		formData.append('TicketDate', ticketDate);
		formData.append('DepartmentId', departmentId);
		formData.append('TicketAssignId', ticketAssignId);
		formData.append('TicketTypeId', ticketTypeId);
		formData.append('TicketPriorityId', ticketPriorityId);
		formData.append('TicketDescription', ticketDescription);
		formData.append('EmployeeId', EmployeeId);
		formData.append('CompanyId', companyId);
		if(TicketApplicationId==0)
		{
		  formData.append('CreatedBy',EmployeeId);
		}
		else
		{
			formData.append('UpdatedBy',EmployeeId);
		}
		// Append file if exists
		if (attachFile) {
			formData.append('AttachDocumentFile', attachFile);
		}

		const ApplicationUrl = TicketApplicationId == 0 ?
			'@baseUrl/TicketApplicationAPI/CreateTicketApplication' :
			'@baseUrl/TicketApplicationAPI/UpdateTicketApplication';
		const TypeMethod = TicketApplicationId == 0 ? "POST" : "PUT";

		// AJAX call
		$.ajax({
			url: ApplicationUrl,
			type: TypeMethod,
			contentType: false,  // Required for FormData
			processData: false,  // Required for FormData
			headers: {
				'Authorization': 'Bearer ' + Token
			},
			data: formData,
			success: function (response) {
				if (response.isSuccess) {
					showToast(response.responseMessage, 'success');
				} else {
					showToast(response.responseMessage, 'error');
				}
				$('#sendTicketRequestModel').modal('hide');
				TicketApplicationDataTable(); // optional: reload list
			},
			error: function (xhr, status, error) {

				showToast('Error while creating ticket application', 'error');
			},
			complete: function () {
				setBtnNormal('#btnSendRequest', 'Send');
			}

		});
	});

	$(document).ready(function () {
			   // Optional: Clear form on modal close
				$('#followUpModal').on('hidden.bs.modal', function () {
				TicketApplicationDataTable();
			  });
  });


			   let TicketFollowUpId=0;
		   let folloUpTicketApplication=0;
		   async function followUpTicketApplication(data)
		   {
			   folloUpTicketApplication=data.ticketApplicationId
			   await bindTicketStatus(data);
			   await TicketFollowupDataTable();
			   clearTicketFollowUpForm();

			   $('#followUpModal').modal('show');
		   }

		 async function bindTicketStatus(applicationDetails) {
			  return new Promise((resolve, reject) => {
				$.ajax({
				  url: '@baseUrl/TicketStatusAPI/GetAllTicketStatus',
				  method: 'GET',
				  headers: {
					'Authorization': 'Bearer ' + Token
				  },
				  success: function (data) {
					if (data.isSuccess) {
					  const dropdown = $('#drpTicketStatus');
					  dropdown.empty();
					  dropdown.append('<option disabled selected value="">Select</option>');
					  $.each(data.data, function (index, status) {
						  if (status.ticketStatusName === "Close" || status.ticketStatusName === "Open") {
							  return;
						  }
							  dropdown.append($('<option>', {
									value: status.ticketStatusId,
									text: status.ticketStatusName
								}));

					  });
						  var statusId=applicationDetails.ticketStatusName=="Open"||applicationDetails.ticketStatusName=="Close"?"":applicationDetails.ticketStatusId;
						$('#drpTicketStatus').val(statusId);
					  resolve(data);
					} else {
					  reject(new Error('API returned unsuccessful response'));
					}
				  },
				  error: function (error) {
					console.error('Error fetching ticket status:', error);
					reject(error); // Reject the promise on error
				  }
				});
			  });
	   }


	 $(document).ready(function() {

		  // Event listener for changes
		  $('#drpTicketStatus').change(function(){
			  var status = $('#drpTicketStatus option:selected').text();
			  if (status === "Close" || status === "Resolved") {
				  $('#tagNextFollowUpDate').hide();
			  } else {
				  $('#tagNextFollowUpDate').show();
			  }
		  });
	  });

	 $('#btnAddFollowUp').click(function () {
		setBtnLoading('#btnAddFollowUp', 'Add');
		var isValid = true;

		// Get form values
		const followUpDate = $('#folloUpDate').val();
		const nextFolloUpDate = $('#nextFolloUpDate').val();
		const ticketStatus = $('#drpTicketStatus').val();

		const followupDescription = $('#txtFolloUpRemark').val();
		const attachFollowFile = $('#attatchFollowUpFile')[0].files[0];
		  var status = $('#drpTicketStatus option:selected').text();

		  // Validation
		if (followUpDate === '') {
			$('#spnFolloUpDate').show();
			isValid = false;
		} else {
			$('#spnFolloUpDate').hide();
		}
		if (status != "Resolved") {

			if (nextFolloUpDate === '') {
				$('#spnNextFolloUpDate').show();
				isValid = false;
			} else {
				$('#spnNextFolloUpDate').hide();
			}
		}




		if (ticketStatus === '' || ticketStatus === null) {
			$('#spnTicketStatus').show();
			isValid = false;
		} else {
			$('#spnTicketStatus').hide();
		}


		if (followupDescription === '') {
			$('#spnFolloUpRemark').show();
			isValid = false;
		} else {
			$('#spnFolloUpRemark').hide();
		}

		if (!isValid||folloUpTicketApplication==0) {
			setBtnNormal('#btnAddFollowUp', 'Add');
			return;
		}

		// Create FormData object
		const followUpFormData = new FormData();

		// Append all form data
		followUpFormData.append('TicketFollowUpId', TicketFollowUpId || 0);
		followUpFormData.append('TicketFollowDate', followUpDate);
		  if ( status != "Resolved")
		  {
				followUpFormData.append('NextTicketFollowDate', nextFolloUpDate);
		  }
		followUpFormData.append('TicketStatusId', ticketStatus);
		followUpFormData.append('TicketApplicationId', folloUpTicketApplication);
		followUpFormData.append('TicketFollowRemark', followupDescription);
		followUpFormData.append('EmployeeId', EmployeeId);

		if(TicketFollowUpId==0)
		{
		  followUpFormData.append('CreatedBy',EmployeeId);
		}
		else
		{
			followUpFormData.append('UpdatedBy',EmployeeId);
		}
		// Append file if exists
		if (attachFollowFile) {
			followUpFormData.append('FollowUpDocumentFile', attachFollowFile);
		}
			// After populating formData

		const FollowUpUrl = TicketFollowUpId == 0 ?
			'@baseUrl/TicketFollowUpAPI/CreateTicketFollowUp' :
			'@baseUrl/TicketFollowUpAPI/UpdateTicketFollowUp';
		const FollowMethod = TicketFollowUpId == 0 ? "POST" : "PUT";

		$.ajax({
			url: FollowUpUrl,
			type: FollowMethod,
			contentType: false,  // Required for FormData
			processData: false,  // Required for FormData
			headers: {
				'Authorization': 'Bearer ' + Token
			},
			data: followUpFormData,
			success: function (response) {
				if (response.isSuccess) {
					showToast(response.responseMessage, 'success');
					clearTicketFollowUpForm();
				} else {
					showToast(response.responseMessage, 'error');
				}
				//$('#followUpModal').modal('hide');
				TicketFollowupDataTable(); // optional: reload list
			},
			error: function (xhr, status, error) {

				showToast('Error while adding ticket follow up', 'error');
			},
			complete: function () {
				setBtnNormal('#btnAddFollowUp', 'Add');
			}

		});
	});

	function renderFollowGrid(data) {
		var columns = [
			{
				header: 'Employee Name', sortable: false, width: '180px',
				render: function (v, row) { return (row.employeeCode || '') + ' - ' + (row.employeeName || ''); }
			},
			{ header: 'Follow-Up Date', sortable: false, width: '120px', render: function (v, row) { return fmtDate(row.ticketFollowDate); } },
			{ header: 'Next Follow-Up Date', sortable: false, width: '140px', render: function (v, row) { return fmtDate(row.nextTicketFollowDate); } },
			{ field: 'ticketFollowRemark', header: 'Ticket Follow Remark', width: '200px' },
			{ header: 'Attachment', sortable: false, width: '100px', render: function (v, row) { return attachmentLink(row.followUpDocumentUrl); } },
			{ field: 'ticketStatusName', header: 'Ticket Status', width: '120px' }
		];

		if (!followGrid) {
			followGrid = WMSGrid.create({
				container: 'gridContainerTicketFollowUp',
				title: 'Ticket Follow Ups',
				icon: 'bx-history',
				exportName: 'TicketFollowUps',
				data: data,
				columns: columns,
				perPage: 100000,
				features: { pagination: false, perPage: false, paginationInfo: false }
			});
		} else {
			followGrid.setData(data);
		}
	}

	async function TicketFollowupDataTable() {
		if (isLoadingFollowUp) return;
		try {
			isLoadingFollowUp = true;
			$.ajax({
				type: "GET",
				 url: '@baseUrl/TicketFollowUpAPI/GetAllTicketFollowUpByApplicationId/'+ folloUpTicketApplication,
				contentType: 'application/json',
				 headers: {
						'Authorization': 'Bearer ' + Token
					},

				 success: function (data) {
					if (data.isSuccess) {
						followCurrentRows = data.data || [];
						renderFollowGrid(followCurrentRows);
					} else {
						followCurrentRows = [];
						renderFollowGrid(followCurrentRows);
					}
				},
				error: function (xhr, status, error) {
					console.error("AJAX Error: " + status + " - " + error);
					followCurrentRows = [];
					renderFollowGrid(followCurrentRows);
					showToast('Error loading follow up history.', 'error');
				},
				complete: function () {
					isLoadingFollowUp = false;
				}
			});

		  } catch (e)
		  {
			   console.error("Error in fetching ticket application:", e);
			   isLoadingFollowUp = false;
		  }
	}


	$('#attatchFollowUpFile').on('change', function () {
	  const fileFolloup = this.files[0];
	  if (fileFolloup) {
		const fileFolloupURL = URL.createObjectURL(fileFolloup);
		$(this).siblings('a').show();
		$(this).siblings('a').attr('href', fileFolloupURL).attr('target', '_blank');

	  }
	  else{
		  $(this).siblings('a').hide();
	  }
	});


	function clearTicketFollowUpForm()
		{
			setTicketDate();// Set date in YYYY-MM-DD format
				$('#txtFolloUpRemark').val('');
				$('#nextFolloUpDate').val('');
				$('#spnFolloUpRemark').val('');
				$('#attatchFollowUpFile').val('');
			setBtnNormal('#btnAddFollowUp', 'Add');
			$('.formType').text('Add');
			   $('#spnNextFolloUpDate').hide();
			   $('#spnFolloUpDate').hide();
			   $('#spnFolloUpRemark').hide();
			   $('#spnTicketStatus').hide();

			   $('#followUpFileLink').hide();
				$('#followUpFileLink').attr('href', '#');

		}
	})();
</script>
