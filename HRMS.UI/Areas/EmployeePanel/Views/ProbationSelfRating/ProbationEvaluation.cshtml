@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Probation Evaluation Form";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}

<div class="no-print-content">
    <div class="card">
        <div class="card-header bg-transparent ml-0 py-0">
            <div class="row">
                <div class="col-6">
                    <h6 class="p-2 mb-0">Probation Evaluation Form</h6>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="grid-wrapper" style="position: relative;">
                        <div id="grid-loader" class="grid-loader justify-content-center align-items-center flex-column"
                             style="display: none; inset: 0; background: rgba(255,255,255,0.6); z-index: 10;">
                            <img src="@baseAPIDomainUrl/loders/loder.png" class="grid-logo-spinner"
                                 style="width: 30px; height: 30px; animation: spin 1s linear infinite;" />
                            <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
                        </div>
                        <div id="GridContainer"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel">Upload Evaluation Form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Employee: <strong id="modalEmployeeName"></strong></label>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Filled Form (PDF) <span class="text-danger">*</span></label>
                    <input type="file" class="form-control" id="evaluationFormFile" accept=".pdf,.jpg,.jpeg,.png" />
                    <small class="text-muted">Accepted formats: PDF, JPG, PNG</small>
                </div>
                <div id="uploadError" class="text-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUploadSubmit" onclick="submitUpload()">
                    <span id="uploadSpinner" class="spinner-border spinner-border-sm d-none me-1"></span>
                    Upload
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
    const EmployeeId = localStorage.getItem("EmployeeId");
    var Token = localStorage.getItem("authToken");
    var selectedEmployeeId = null;

    $(() => {
        LoadProbationEvaluationGrid();
    });

    function LoadProbationEvaluationGrid() {
        try {
            $('#grid-loader').addClass('d-flex').show();

            $.ajax({
                type: "GET",
                url: '@baseUrl/ProbationEvaluationAPI/GetProbationEvaluationFormList?loggedInUserId=' + EmployeeId,
                headers: {
                    'Authorization': 'Bearer ' + Token,
                    'Content-Type': 'application/json'
                },
                success: function (response) {
                    var data = response.data || [];

                    $("#GridContainer").dxDataGrid({
                        dataSource: data,
                        columns: [
                            { dataField: "employeeCode", caption: "Employee Code", width: 140 },
                            { dataField: "fullName", caption: "Full Name", minWidth: 200 },
                            { dataField: "branchName", caption: "Branch", minWidth: 150 },
                            {
                                dataField: "probationEndDate",
                                caption: "Probation End Date",
                                dataType: "date",
                                format: "dd-MM-yyyy",
                                alignment: "center",
                                width: 160
                            },
                            {
                                dataField: "alertStatus",
                                caption: "Alert Status",
                                alignment: "center",
                                width: 160,
                                cellTemplate: function (container, options) {
                                    var badgeClass = "bg-secondary";
                                    var label = options.value;
                                    if (options.value === "NOTIFY_MANAGER") { badgeClass = "bg-primary"; label = "Notify Manager"; }
                                    else if (options.value === "ESCALATED_TO_HR") { badgeClass = "bg-warning text-dark"; label = "Escalated To HR"; }
                                    else if (options.value === "HRD_ALERT") { badgeClass = "bg-danger"; label = "HRD Alert"; }
                                    $('<span class="badge ' + badgeClass + '">' + label + '</span>').appendTo(container);
                                }
                            },
                            {
                                dataField: "isUploaded",
                                caption: "Form Status",
                                alignment: "center",
                                width: 130,
                                cellTemplate: function (container, options) {
                                    if (options.value) {
                                        $('<span class="badge bg-success">Uploaded</span>').appendTo(container);
                                    } else {
                                        $('<span class="badge bg-warning text-dark">Pending</span>').appendTo(container);
                                    }
                                }
                            },
                            {
                                caption: "Action",
                                alignment: "center",
                                width: 220,
                                cellTemplate: function (container, options) {
                                    var row = options.data;

                                    // ✅ Download Button
                                    $('<a/>')
                                        .attr('href', 'javascript:;')
                                        .addClass('btn btn-sm btn-outline-primary me-2')
                                        .html('<i class="bi bi-download me-1"></i>Download')
                                        .on('click', function () {
                                            downloadForm(row);
                                        })
                                        .appendTo(container);

                                    // ✅ Upload Button — sirf tab jab upload nahi hua
                                    if (!row.isUploaded) {
                                        $('<a/>')
                                            .attr('href', 'javascript:;')
                                            .addClass('btn btn-sm btn-outline-success')
                                            .html('<i class="bi bi-upload me-1"></i>Upload')
                                            .on('click', function () {
                                                openUploadModal(row);
                                            })
                                            .appendTo(container);
                                    }
                                }
                            }
                        ],
                        showBorders: true,
                        rowAlternationEnabled: true,
                        columnsAutoWidth: true,
                        wordWrapEnabled: true,
                        paging: { pageSize: 10 },
                        pager: {
                            showPageSizeSelector: true,
                            allowedPageSizes: [10, 25, 50],
                            showInfo: true
                        },
                        searchPanel: { visible: true, width: 240, placeholder: "Search..." },
                        allowColumnResizing: true,
                        scrolling: { mode: "standard", useNative: false }
                    });

                    $('#grid-loader').removeClass('d-flex').hide();
                },
                error: function (xhr) {
                    $('#grid-loader').removeClass('d-flex').hide();
                    console.error("Error loading data:", xhr);
                }
            });
        } catch (e) {
            $('#grid-loader').removeClass('d-flex').hide();
            console.error("Error:", e);
        }
    }

    // ✅ Download blank PDF — Form folder sahi kiya
    function downloadForm(row) {
        var link = document.createElement('a');
        link.href = '@baseAPIDomainUrl/Form/Performance_Evaluation_Form.pdf'; // ✅ Form (capital F)
        link.download = 'Performance_Evaluation_Form_' + row.employeeCode + '.pdf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // ✅ Open Upload Modal
    function openUploadModal(row) {
        selectedEmployeeId = row.employeeId;
        $('#modalEmployeeName').text(row.fullName + ' (' + row.employeeCode + ')');
        $('#evaluationFormFile').val('');
        $('#uploadError').addClass('d-none').text('');
        $('#uploadModal').modal('show');
    }

    // ✅ Submit Upload — 2 step: file upload then DB save
      function submitUpload() {
        var file = $('#evaluationFormFile')[0].files[0];

        if (!file) {
            $('#uploadError').removeClass('d-none').text('Please select a file to upload.');
            return;
        }

        // ✅ File size validation (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
            $('#uploadError').removeClass('d-none').text('File size must be less than 5MB.');
            return;
        }

        $('#uploadSpinner').removeClass('d-none');
        $('#btnUploadSubmit').prop('disabled', true);
        $('#uploadError').addClass('d-none').text('');

        var formData = new FormData();
        formData.append('file', file);

        // ✅ Use fetch instead of $.ajax for FormData uploads
        fetch('@baseUrl/ProbationEvaluationAPI/UploadFormFile', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + Token
                // ❌ DO NOT set Content-Type — browser sets it automatically with boundary for FormData
            },
            body: formData
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('HTTP error! Status: ' + response.status);
            }
            return response.json();
        })
        .then(function(uploadResponse) {
            if (uploadResponse.isSuccess) {
                var fileUrl = uploadResponse.data;

                // Step 2 - Save to DB
                return fetch('@baseUrl/ProbationEvaluationAPI/CreateProbationEvaluationForm', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + Token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        employeeId: selectedEmployeeId,
                        probationEvaluationFormUrl: fileUrl,
                        isUploaded: true,
                        isEnabled: true,
                        isDeleted: false,
                        createdBy: EmployeeId
                    })
                })
                .then(r => r.json())
                .then(function(response) {
                    $('#uploadSpinner').addClass('d-none');
                    $('#btnUploadSubmit').prop('disabled', false);

                    if (response.isSuccess) {
                        $('#uploadModal').modal('hide');
                        DevExpress.ui.notify("Form uploaded successfully!", "success", 3000);
                        $("#GridContainer").dxDataGrid("instance").refresh();
                    } else {
                        $('#uploadError').removeClass('d-none').text(response.responseMessage || 'Save failed.');
                    }
                });
            } else {
                $('#uploadSpinner').addClass('d-none');
                $('#btnUploadSubmit').prop('disabled', false);
                $('#uploadError').removeClass('d-none').text(uploadResponse.responseMessage || 'File upload failed.');
            }
        })
        .catch(function(err) {
            $('#uploadSpinner').addClass('d-none');
            $('#btnUploadSubmit').prop('disabled', false);
            console.error("Upload error:", err);
            $('#uploadError').removeClass('d-none').text('Upload failed: ' + err.message);
        });
    }
</script>