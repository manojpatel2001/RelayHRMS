@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Probation Evaluation Form";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uriAPI = new Uri(baseUrl);
    string baseAPIDomainUrl = $"{uriAPI.Scheme}://{uriAPI.Host}:{uriAPI.Port}";
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Probation Evaluation Form</h6>
    </div>
    <div class="card-body">
        <div id="GridContainer"></div>
    </div>
</div>

</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel">Upload Evaluation Form</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-font">
                <div class="wms-form-page">
                    <div class="fg">
                        <label>Employee</label>
                        <input type="text" id="modalEmployeeName" readonly />
                    </div>
                    <div class="fg fg-req">
                        <label for="evaluationFormFile">Select Filled Form (PDF)</label>
                        <input type="file" id="evaluationFormFile" accept=".pdf,.jpg,.jpeg,.png" />
                        <span class="field-validation-error" id="uploadError" style="display:none;"></span>
                    </div>
                    <small class="text-muted">Accepted formats: PDF, JPG, PNG</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnUploadSubmit" onclick="submitUpload()">
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Upload</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    var EmployeeId = localStorage.getItem("EmployeeId");
    var Token = localStorage.getItem("authToken");
    var selectedEmployeeId = null;
    var grid = null;

    $(document).ready(function () {
        LoadProbationEvaluationGrid();
    });

    function fmtDate(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        var day = String(d.getDate()).padStart(2, '0');
        var month = String(d.getMonth() + 1).padStart(2, '0');
        return day + '-' + month + '-' + d.getFullYear();
    }

    function alertPill(v) {
        var badgeClass = 'wg-pill-pu';
        var label = v || '-';
        if (v === 'NOTIFY_MANAGER') { badgeClass = 'wg-pill-blue'; label = 'Notify Manager'; }
        else if (v === 'ESCALATED_TO_HR') { badgeClass = 'wg-pill-amber'; label = 'Escalated To HR'; }
        else if (v === 'HRD_ALERT') { badgeClass = 'wg-pill-red'; label = 'HRD Alert'; }
        return '<span class="wg-pill ' + badgeClass + '">' + label + '</span>';
    }

    function LoadProbationEvaluationGrid() {
        if (grid) grid.showLoader();

        $.ajax({
            type: 'GET',
            url: '@baseUrl/ProbationEvaluationAPI/GetProbationEvaluationFormList?loggedInUserId=' + EmployeeId,
            headers: {
                'Authorization': 'Bearer ' + Token,
                'Content-Type': 'application/json'
            },
            success: function (response) {
                var data = response.data || [];
                renderGrid(data);
            },
            error: function (xhr) {
                if (grid) grid.hideLoader();
                console.error('Error loading data:', xhr);
                showToast('Failed to load probation evaluation forms.', 'error');
            }
        });
    }

    function renderGrid(data) {
        var columns = [
            { field: 'employeeCode', header: 'Employee Code', width: '140px' },
            { field: 'fullName', header: 'Full Name', width: '200px' },
            { field: 'branchName', header: 'Branch', width: '150px' },
            { field: 'probationEndDate', header: 'Probation End Date', width: '160px', align: 'center', render: function (v) { return fmtDate(v); } },
            { field: 'alertStatus', header: 'Alert Status', width: '160px', align: 'center', render: function (v) { return alertPill(v); } },
            {
                field: 'isUploaded', header: 'Form Status', width: '130px', align: 'center',
                render: function (v) {
                    return v ? '<span class="wg-pill wg-pill-green">Uploaded</span>' : '<span class="wg-pill wg-pill-amber">Pending</span>';
                }
            },
            {
                header: 'Action', sortable: false, width: '180px', stickyRight: true,
                render: function (v, row) {
                    return buildActionButtons(row);
                }
            }
        ];

        if (!grid) {
            grid = WMSGrid.create({
                container: 'GridContainer',
                title: 'Probation Evaluation Forms',
                icon: 'bx-id-card',
                exportName: 'ProbationEvaluationForms',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            grid.setData(data);
            grid.hideLoader();
        }
    }

    function buildActionButtons(row) {
        var safeJson = JSON.stringify(row).replace(/'/g, "&#39;");
        var html = '<button type="button" class="wg-btn wg-btn-outline" title="Download"' +
            ' onclick=\'_downloadForm(' + safeJson + ')\'><i class="bx bx-download"></i></button>';
        if (!row.isUploaded) {
            html += ' <button type="button" class="wg-btn wg-btn-primary" title="Upload"' +
                ' onclick=\'_openUploadModal(' + safeJson + ')\'><i class="bx bx-upload"></i></button>';
        }
        return html;
    }

    window._downloadForm = function (row) {
        var url = '@baseUrl/ProbationEvaluationAPI/DownloadEvaluationForm';
        var link = document.createElement('a');
        link.href = url;
        link.download = 'Performance_Evaluation_Form_' + row.employeeCode + '.pdf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    window._openUploadModal = function (row) {
        selectedEmployeeId = row.employeeId;
        $('#modalEmployeeName').val(row.fullName + ' (' + row.employeeCode + ')');
        $('#evaluationFormFile').val('');
        $('#uploadError').hide().text('');
        setBtnNormal('#btnUploadSubmit', 'Upload');
        $('#uploadModal').modal('show');
    };

    window.submitUpload = function () {
        var file = $('#evaluationFormFile')[0].files[0];

        if (!file) {
            $('#uploadError').show().text('Please select a file to upload.');
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            $('#uploadError').show().text('File size must be less than 5MB.');
            return;
        }
        $('#uploadError').hide().text('');

        setBtnLoading('#btnUploadSubmit', 'Uploading...');

        var formData = new FormData();
        formData.append('file', file);

        fetch('@baseUrl/ProbationEvaluationAPI/UploadFormFile', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + Token
                // DO NOT set Content-Type — browser sets it automatically with boundary for FormData
            },
            body: formData
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('HTTP error! Status: ' + response.status);
            }
            return response.json();
        })
        .then(function (uploadResponse) {
            if (uploadResponse.isSuccess) {
                var fileUrl = uploadResponse.data;

                return fetch('@baseUrl/ProbationEvaluationAPI/CreateProbationEvaluationForm', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + Token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        employeeId: selectedEmployeeId,
                        probationEvaluationFormUrl: fileUrl,
                        isUploaded: true,
                        isEnabled: true,
                        isDeleted: false,
                        createdBy: EmployeeId
                    })
                })
                .then(function (r) { return r.json(); })
                .then(function (response) {
                    setBtnNormal('#btnUploadSubmit', 'Upload');

                    if (response.isSuccess) {
                        $('#uploadModal').modal('hide');
                        showToast('Form uploaded successfully!', 'success');
                        LoadProbationEvaluationGrid();
                    } else {
                        $('#uploadError').show().text(response.responseMessage || 'Save failed.');
                    }
                });
            } else {
                setBtnNormal('#btnUploadSubmit', 'Upload');
                $('#uploadError').show().text(uploadResponse.responseMessage || 'File upload failed.');
            }
        })
        .catch(function (err) {
            setBtnNormal('#btnUploadSubmit', 'Upload');
            console.error('Upload error:', err);
            $('#uploadError').show().text('Upload failed: ' + err.message);
        });
    };
})();
</script>
