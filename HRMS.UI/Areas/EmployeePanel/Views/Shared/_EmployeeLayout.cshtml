@inject IConfiguration Configuration
@{
    string baseUrlLayout   = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrlLayout = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri                = new Uri(baseUrlLayout);
    string baseDomainUrl   = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — HRMS" : "ESS Panel — HRMS")</title>
    <link rel="icon" href="~/assets/images/relayfevicon.jpeg" type="image/png" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

    <!-- WMS Core CSS -->
    <link rel="stylesheet" href="~/assets/css/wms-site.css" />
    <link rel="stylesheet" href="~/assets/css/app-shell.css" />
    <link rel="stylesheet" href="~/assets/css/wms-theme.css" />
    <link rel="stylesheet" href="~/assets/css/wms-modal.css" />
    <!-- HRMS UI enhancements (stat cards, notification, modals) -->
    <link rel="stylesheet" href="~/assets/css/hrms-ui.css" />

    <!-- DevExtreme base theme (required by dx.all.js widgets: dxTagBox, popups, grids, toolbars) -->
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.common.css">
    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/21.1.5/css/dx.light.css">

    <!-- Bootstrap -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />

    <!-- HRMS Plugin / App CSS -->
    <link href="~/assets/plugins/perfect-scrollbar/css/perfect-scrollbar.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/plugins/notifications/css/lobibox.min.css" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/assets/css/company-modal.css" rel="stylesheet" />
    <link href="~/assets/css/compoffleavemodal.css" rel="stylesheet" />

    <!-- HRMS Premium UI — must be last to override Bootstrap + DevExtreme -->
    <link rel="stylesheet" href="~/assets/css/hrms-premium.css" />
    <link rel="stylesheet" href="~/assets/css/hrms-wms-form-bridge.css" />

    <!-- Styles for the .searchable-select-wrapper widget (searchableselect.js) —
         without this, its dropdown-arrow SVG and dropdown panel have no CSS at
         all and fall back to raw browser defaults (a ~300px arrow, unstyled list). -->
    <link rel="stylesheet" href="~/assets/css/searchable-select.css" />

    <script src="~/assets/js/wms-theme.js"></script>

    <style>
        /* ── Notification ── */
        #notificationCount { display:none; }
        .hrms-notif-wrap { position: relative; }
        /* notification-dropdown + notification-item styles → hrms-ui.css */

        /* ── Company ── */
        .hrms-company-name {
            font-size: 11px; color: rgba(255,255,255,.75);
            max-width: 200px; overflow: hidden;
            white-space: nowrap; text-overflow: ellipsis;
        }
        .companyNameLayout {
            max-width: 200px; overflow-x: auto; white-space: nowrap;
            scrollbar-width: none;
        }
        .companyNameLayout::-webkit-scrollbar { display: none; }
        .custom-tooltip { display:inline-block; cursor:grab; position:relative; }
        .custom-tooltip::after {
            content: attr(data-tooltip);
            position: absolute; bottom:150%; left:0;
            background: rgba(0,0,0,.85); color:#fff;
            padding: 6px 10px; border-radius:5px;
            white-space: normal; max-width:400px;
            opacity:0; pointer-events:none;
            transition: opacity .3s; z-index: 1000;
        }
        .custom-tooltip:hover::after { opacity:1; }

        /* ── Sidebar sub-groups ── */
        .sb-subgroup { margin: 3px 6px 3px 6px; border-radius:6px; overflow:hidden; }
        .sb-subgroup .sb-group-hdr {
            font-size: 11.5px !important;
            padding: 5px 10px !important;
            background: linear-gradient(to bottom, #6b8fa8, #5a7e99) !important;
        }
        .sb-link-indent { padding-left: 28px !important; font-size: 11.5px !important; }

        /* ── DX grid ── */
        .dx-datagrid .dx-row > td { padding: 2px; }
        .dx-row > td, .dx-row > tr > td { border: 1px solid #ced4da; }
        .dx-widget { font-size: 12px; }

        /* ══════════════════════════════════════════════════════════════
           UI REFINEMENTS  (WMS-native sizing, minimal overrides)
           ══════════════════════════════════════════════════════════════ */

        /* ── HRMS brand text ── */
        .hrms-brand-text {
            font-size: 15px;
            font-weight: 900;
            letter-spacing: 3.5px;
            color: #ffffff;
            text-transform: uppercase;
            font-family: 'Inter', sans-serif;
            padding: 0 2px;
        }
        .as-top-nav-brand { text-decoration: none !important; }

        /* ── Company name + page subtitle in project header ── */
        .hrms-proj-header-brand {
            display: flex;
            align-items: baseline;
            gap: 10px;
            min-width: 0;
            overflow: hidden;
        }
        .hrms-company-headline {
            font-size: 17px;
            font-weight: 800;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-family: 'Inter', sans-serif;
            white-space: nowrap;
            flex-shrink: 0;
            text-shadow: 0 1px 6px rgba(0,0,0,.25);
        }
        .hrms-proj-separator {
            color: rgba(255,255,255,.35);
            font-size: 17px;
            font-weight: 200;
            flex-shrink: 0;
        }
        .hrms-page-subtitle {
            font-size: 12px;
            color: rgba(255,255,255,.70);
            font-weight: 400;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-top: 2px;
        }

        /* ── Sidebar: hide left icon, add right › arrow only ── */
        .sidebar .sb-link { position: relative !important; padding-right: 26px !important; }
        .sidebar .sb-link .sb-ic { display: none !important; }
        .sidebar .sb-link::after {
            content: '›';
            font-size: 18px;
            line-height: 1;
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            opacity: .30;
            transition: opacity .15s, transform .15s;
        }
        .sidebar .sb-link:hover::after     { opacity: .80; transform: translateY(-50%) translateX(2px); }
        .sidebar .sb-link.is-active::after { opacity: 1;   transform: translateY(-50%) translateX(2px); }

        /* ── Dashboard link right arrow ── */
        .sidebar .sb-dash-link { position: relative !important; padding-right: 26px !important; }
        .sidebar .sb-dash-link::after {
            content: '›';
            font-size: 18px;
            line-height: 1;
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            opacity: .30;
            transition: opacity .15s;
        }
        .sidebar .sb-dash-link:hover::after     { opacity: .80; }
        .sidebar .sb-dash-link.is-active::after { opacity: 1; }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ Page Loader — WMS premium dot spinner ══ -->
    <div id="loader" class="wg-page-loader" style="display:none">
        <div class="wg-dot-spinner">
            <div></div><div></div><div></div><div></div><div></div><div></div>
            <div></div><div></div><div></div><div></div><div></div><div></div>
        </div>
        <p class="hrms-loader-text">Please wait<span class="hrms-loader-dots"></span></p>
    </div>

    <!-- Critical deps: load before app-shell (and before @RenderBody inline scripts) -->
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/hrms-loader.js"></script>
    <script src="~/assets/js/hrms-notify.js"></script>
    <script src="~/assets/js/hrms-utils.js"></script>
    <script src="~/assets/js/hrms-grid-config.js"></script>
    <script src="~/assets/js/wms-grid.js"></script>

    <div id="app-shell-wrap">
        <div class="app-shell">

            <!-- ══ SLIM TOP NAV (28 px) ══════════════════════════════════ -->
            <header class="as-top-nav">
                <div class="as-top-nav-left">
                    <a class="as-top-nav-brand" href="@UIBaseUrlLayout/EmployeePanel/Home/index">
                        <span class="hrms-brand-text">HRMS</span>
                    </a>
                </div>
                <div class="as-top-nav-right">
                    <span class="hrms-company-name companyNameLayout">
                        <span class="custom-tooltip"></span>
                    </span>
                    <span class="as-top-nav-sep">|</span>
                    <span class="as-top-nav-loggedas">Logged in as <strong id="as-userName" class="user-name">User</strong></span>
                    <span class="as-top-nav-sep">|</span>
                    <div id="as-user-dd-wrap" class="as-user-dd-wrap">
                        <button type="button" class="as-top-nav-link" id="as-myAccountBtn"
                                onclick="AppShell.toggleUserDd();return false;" title="My Account">
                            My Account <i class="bx bx-chevron-down" style="font-size:11px;margin-left:2px;opacity:.85"></i>
                        </button>
                        <div id="as-user-dd" class="as-user-dd">
                            <div id="dropdown-user-info" style="padding:12px 16px;border-bottom:1px solid #F1F5F9;background:#F8FAFC">
                                <div style="font-size:13px;font-weight:700;color:#1e3a5f" id="dropdown-name"></div>
                                <div style="font-size:11px;color:#64748B" id="dropdown-role">Employee Self Service</div>
                            </div>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Employee/MyProfile" class="as-user-dd-item">
                                <i class="bx bx-user"></i> My Profile
                            </a>
                            <a href="@UIBaseUrlLayout/AdminPanel/Home/index" class="as-user-dd-item" id="dropdownAdminSwitch" style="display:none;">
                                <i class="bx bx-transfer"></i> Switch to Admin
                            </a>
                            <a href="javascript:;" class="as-user-dd-item" id="companyDrop">
                                <i class="bx bx-building"></i> Change Company
                            </a>
                            <a href="@UIBaseUrlLayout/AuthManage/ChangePassword" class="as-user-dd-item" id="changePassword">
                                <i class="bx bx-key"></i> Change Password
                            </a>
                            <div style="border-top:1px solid #F1F5F9;margin:4px 0"></div>
                            <a href="#" class="as-user-dd-item as-user-dd-signout" id="btnLogout">
                                <i class="bx bx-log-out"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- ══ PROJECT HEADER (40 px) ════════════════════════════════ -->
            <header class="as-project-header">
                <div class="as-project-header-left">
                    <button class="as-top-nav-link" id="mob-menu-btn"
                            onclick="hrmsToggleMobSidebar()" title="Toggle navigation"
                            style="padding:3px 8px;background:rgba(255,255,255,.12)">
                        <i class="bx bx-menu"></i>
                    </button>
                    <div class="hrms-proj-header-brand">
                        <span class="hrms-company-headline" id="hrms-company-header">HRMS</span>
                        <span class="hrms-proj-separator">|</span>
                        <span class="hrms-page-subtitle" id="topbar-page-title">@(ViewData["Title"]?.ToString() ?? "Employee Self Service")</span>
                    </div>
                </div>
                <div class="as-project-header-right">
                    <!-- Notification Bell -->
                    <div class="hrms-notif-wrap" id="bellIcon">
                        <button type="button" class="as-notif-btn" id="notif-bell-btn"
                                title="Notifications"
                                onclick="document.getElementById('notificationDropdown').classList.toggle('show');event.stopPropagation();">
                            <i class="bx bx-bell"></i>
                            <span class="as-notif-dot" id="notif-dot-topbar">0</span>
                        </button>
                        <div class="notification-dropdown" id="notificationDropdown">
                            <div class="notification-header">
                                <h6><i class="bx bx-bell"></i> Notifications</h6>
                                <button class="notif-mark-all-btn" type="button"
                                        onclick="if(typeof readNotification==='function') readNotification('All'); loadAllUnreadNotification(); return false;">
                                    Mark all read
                                </button>
                            </div>
                            <div class="notification-list" id="notificationList"></div>
                            <div class="notification-footer">
                                <a href="#" class="notif-view-all" onclick="return false;">
                                    View all notifications <i class="bx bx-right-arrow-alt"></i>
                                </a>
                            </div>
                        </div>
                        <span id="notificationCount" style="display:none">0</span>
                    </div>

                    <!-- Search -->
                    <div class="as-quick-search-wrap">
                        <span class="as-quick-search-icon"><i class="bx bx-search"></i></span>
                        <input type="text" id="as-globalSearch" class="as-quick-search-input"
                               placeholder="Search pages…"
                               autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" />
                        <div id="as-globalSearch-dd" class="as-quick-search-dd"></div>
                    </div>

                    <!-- Jump to page -->
                    <select id="as-jumpToPage" class="as-jump-select wms-no-dd" title="Jump to a page" aria-label="Jump to a page">
                        <option value="">Jump to a page…</option>
                    </select>
                </div>
            </header>

            <!-- ══ MODULE TABS (38 px) ═══════════════════════════════════ -->
            <nav class="as-tab-nav" id="as-tab-nav" role="tablist" aria-label="Module tabs">
                <a class="as-tab-nav-item essDashboard" href="@UIBaseUrlLayout/EmployeePanel/Home/index"
                   data-tab-ctrl="home"><i class="bx bx-home-circle"></i><span>Dashboard</span></a>
                <a class="as-tab-nav-item essEmployeeMenu" href="@UIBaseUrlLayout/EmployeePanel/Employee/MyProfile"
                   data-tab-ctrl="employee"><i class="bx bx-user"></i><span>Employee</span></a>
                <a class="as-tab-nav-item essLeaveMenu" href="@UIBaseUrlLayout/EmployeePanel/Leave/LeaveApplication"
                   data-tab-ctrl="leave"><i class="bx bx-calendar"></i><span>Leave</span></a>
                <a class="as-tab-nav-item essSalaryDetailsMenu" href="@UIBaseUrlLayout/EmployeePanel/SalaryDetail/SalarySlip"
                   data-tab-ctrl="salarydetail"><i class="bx bx-wallet"></i><span>Salary Details</span></a>
                <a class="as-tab-nav-item essMyTeamMenu" href="@UIBaseUrlLayout/EmployeePanel/MyTeam/MemberDetails"
                   data-tab-ctrl="myteam"><i class="bx bx-group"></i><span>My Team</span></a>
                <a class="as-tab-nav-item essMyReportMenu" href="@UIBaseUrlLayout/EmployeePanel/MyReports/AttendanceRegister"
                   data-tab-ctrl="myreports"><i class="bx bx-bar-chart-square"></i><span>My Reports</span></a>
            </nav>

            <!-- ══ SIDEBAR ════════════════════════════════════════════════ -->
            <aside class="sidebar" id="sidebar">
                <!-- Profile block -->
                <div class="sb-user" id="sb-profile-block">
                    <div class="sb-user-av" id="sb-user-av">
                        <img src="@baseDomainUrl/default-image/avatar-2.png"
                             alt="Profile" id="sb-user-avatar-img" class="profileImage"
                             style="width:100%;height:100%;object-fit:cover;border-radius:50%" />
                    </div>
                    <div class="sb-user-info" id="sb-user-info">
                        <div class="sb-user-name user-name" id="sb-user-name">Loading…</div>
                        <div class="sb-user-role designation" id="sb-user-role">Employee Self Service</div>
                    </div>
                </div>

                <div id="sidebar-link">

                    <!-- Dashboard -->
                    <a href="@UIBaseUrlLayout/EmployeePanel/Home/index" class="sb-dash-link essDashboard">
                        <span class="sb-ic"><i class="bx bx-home-circle"></i></span>
                        <span class="sb-label">Dashboard</span>
                    </a>

                    <!-- ── Employee ── -->
                    <div class="sb-group collapsed essEmployeeMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-user"></i></span>
                            <span class="sb-group-hdr-txt">Employee</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/Employee/MyProfile" class="sb-link essMyProfile">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">My Profile</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Employee/Index" class="sb-link essMyInout">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">My In Out</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/EmployeeDirectory/Index" class="sb-link essEmployeeDirectory">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Employee Directory</span>
                            </a>
                            <!-- Ticket -->
                            <a href="@UIBaseUrlLayout/EmployeePanel/TicketRequest/TicketRequest" class="sb-link essTicketRequest">
                                <span class="sb-ic"><i class="bx bx-support"></i></span>
                                <span class="sb-label">Ticket Request</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/TicketRequest/TicketApplication" class="sb-link essTicketRequest">
                                <span class="sb-ic"><i class="bx bx-support"></i></span>
                                <span class="sb-label">Ticket Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ManageProbation/Probation" class="sb-link essProbationOver">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Probation Over</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ProbationSelfRating/ProbationEvaluation" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Probation Evaluation</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ExitApplicationEss/ExitApplicationReport" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Exit Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ExitApplicationEss/ExitApproval" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Exit Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ExitApplicationEss/ExitClearanceApproval" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Exit Clearance Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/ManPowerApproval/ManPowerApproval" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Man Power Approval</span>
                            </a>
                        </div>
                    </div>

                    <!-- ── Recruitment Process ── -->
                    <div class="sb-group collapsed">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-briefcase"></i></span>
                            <span class="sb-group-hdr-txt">Recruitment Process</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyInterviews/InterviewFeedback" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-calendar-check"></i></span>
                                <span class="sb-label">My Interviews</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/OfferApprovalEss/OfferApprovalEss" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-check-shield"></i></span>
                                <span class="sb-label">Offer Approvals</span>
                            </a>
                        </div>
                    </div>

                    <!-- ── Leave ── -->
                    <div class="sb-group collapsed essLeaveMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-calendar"></i></span>
                            <span class="sb-group-hdr-txt">Leave</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/LeaveApplication" class="sb-link essLeaveApplication">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/LeaveApproval" class="sb-link essLeaveApproval">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Approval</span>
                            </a>
                            <!-- Comp Off -->
                            <a href="@UIBaseUrlLayout/EmployeePanel/CompOffApplication/Index" class="sb-link essCompOffMenu essCompOffApplication">
                                <span class="sb-ic"><i class="bx bx-time"></i></span>
                                <span class="sb-label">Comp Off Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/CompOffApplication/CompOffApproval" class="sb-link essCompOffMenu essCompOffApproval">
                                <span class="sb-ic"><i class="bx bx-time"></i></span>
                                <span class="sb-label">Comp Off Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/AttendanceRegularizationApproval" class="sb-link essAttedenceRegularization">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Attendance Regularization Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/Attendance" class="sb-link essAddAttedenceRegularization">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Add Attendance Regularization</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/ReportingWiseLeavecancellationReport" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Cancellation Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/Leave/EmpLeavecancellationReport" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Add Leave Cancellation</span>
                            </a>
                        </div>
                    </div>

                    <!-- ── Salary Details ── -->
                    <div class="sb-group collapsed essSalaryDetailsMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-wallet"></i></span>
                            <span class="sb-group-hdr-txt">Salary Details</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/SalaryDetail/SalarySlip" class="sb-link essItDeclarationForm">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Salary Slip</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/SalaryDetail/EmpLoanApproval" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Loan Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/SalaryDetail/LoanApproval" class="sb-link">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Loan Approval</span>
                            </a>
                        </div>
                    </div>

                    <!-- ── My Team ── -->
                    <div class="sb-group collapsed essMyTeamMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-group"></i></span>
                            <span class="sb-group-hdr-txt">My Team</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyTeam/MemberInOutRecord" class="sb-link essMemberInOutRecord">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Member In Out Record</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyTeam/MemberDetails" class="sb-link essMemberDetails">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Member Details</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/Index" class="sb-link essMyReports">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">My Reports</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyTeam/ManPowerRequisitionReport" class="sb-link essMyReports essManpowerMenu" style="display:none;">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">ManPower Requisition</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyTeam/EmployeeJoiningEntryEss" class="sb-link essMyReports essJoiningMenu" style="display:none;">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Employee Joining Entry</span>
                            </a>
                        </div>
                    </div>

                    <!-- ── My Reports ── -->
                    <div class="sb-group collapsed essMyReportMenu">
                        <div class="sb-group-hdr" onclick="sbToggleGroup(this.parentElement)">
                            <span class="sb-group-hdr-ic"><i class="bx bx-bar-chart-square"></i></span>
                            <span class="sb-group-hdr-txt">My Reports</span>
                            <i class="bx bx-chevron-down sb-group-chevron"></i>
                        </div>
                        <div class="sb-group-body">
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/AttendanceRegister" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Attendance Register</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/LeaveApproval" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Approval</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/LeaveBalance" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Balance</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/YearlyLeave" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Yearly Leave Balance</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/leaveapplicationreport" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Leave Application</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/SalarySlipReport" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Salary Slip Report</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/YearlySalarySummary" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Yearly Salary Report</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/Compoffavailbalance" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">CompOff Available Balance</span>
                            </a>
                            <a href="@UIBaseUrlLayout/EmployeePanel/MyReports/Compoffleaveadjustment" class="sb-link essAttedanceRegister">
                                <span class="sb-ic"><i class="bx bx-right-arrow-alt"></i></span>
                                <span class="sb-label">Compoff Leave Adjustment</span>
                            </a>
                        </div>
                    </div>

                </div><!-- #sidebar-link -->
            </aside>

            <!-- ── Floating collapse toggle ── -->
            <div class="sb-toggle-btn" id="sb-toggle-btn" onclick="sbToggleCollapse()" title="Toggle sidebar">
                <i class="bx bx-chevrons-left" id="sb-toggle-icon"></i>
            </div>

            <!-- ══ MAIN CONTENT AREA ════════════════════════════════════ -->
            <main class="main-area" id="main-area">

                <!-- ══ BREADCRUMB ═══════════════════════════════════════════ -->
                <!-- Filled in by markActiveSidebarLink() in hrms-shell.js (Home / <sidebar group> / <page>) —
                     driven by the sidebar's own active-link detection, not the top module tabs, since that's
                     the one system already proven reliable (it also drives group expand/collapse).
                     Lives inline in the scrollable page content (not a fixed shell row), so it just scrolls
                     away with the page like the rest of the content — no extra shell height bookkeeping. -->
                <nav class="as-breadcrumb-bar" id="as-breadcrumb-bar" aria-label="Breadcrumb">
                    <a href="@UIBaseUrlLayout/EmployeePanel/Home/index" title="Home"><i class="bx bx-home-alt"></i></a>
                    <span class="as-breadcrumb-sep" id="as-breadcrumb-sep" style="display:none">/</span>
                    <span id="as-breadcrumb-group" class="as-breadcrumb-group"></span>
                    <span class="as-breadcrumb-sep" id="as-breadcrumb-sep2" style="display:none">/</span>
                    <span id="as-breadcrumb-current" class="as-breadcrumb-current"></span>
                </nav>

                @RenderBody()

                <footer class="app-footer">
                    <span class="app-footer-copy">© @DateTime.Now.Year <strong>HRMS</strong> · All rights reserved</span>
                    <span class="app-footer-divider">|</span>
                    <span class="app-footer-brand">
                        <i class="bx bx-code-alt" style="font-size:13px;vertical-align:-2px"></i>
                        Developed &amp; Maintained by&nbsp;<strong>SKYLINE WEB SOLUTIONS</strong>
                    </span>
                </footer>

            </main>

        </div><!-- .app-shell -->
    </div><!-- #app-shell-wrap -->

    <!-- ══ SIDEBAR OVERLAY (mobile) ══ -->
    <div class="sidebar-overlay" id="sidebar-overlay" onclick="closeMobSidebar()"></div>

    <!-- ══ HRMS Containers / Modals ══ -->
    <div id="companyModalContainer"></div>
    <div id="sessionTimmerContainer"></div>
    <audio id="notificationSound" src="@baseDomainUrl/notification/notification-remainder-tone.mp3" preload="auto"></audio>
    <div id="toast-container" class="toast-container"></div>

    <!-- Comp-Off / Leave Balance Modal -->
    <div class="leave-balance-modal-container">
        <div class="modal fade" id="leaveBalanceModal" data-bs-backdrop="true" data-bs-keyboard="true" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl custom-modal-dialog">
                <div class="modal-content custom-modal-content">
                    <div class="modal-header modal-header-gradient custom-modal-header">
                        <div class="container-fluid px-0">
                            <div class="d-flex align-items-center">
                                <div class="header-icon me-2"><i class="bx bx-award"></i></div>
                                <div>
                                    <h5 class="mb-0 fw-bold">Welcome Back!</h5>
                                    <small class="opacity-75">Your Notification Summary</small>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="hrms-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="bx bx-x"></i></button>
                    </div>
                    <div class="modal-body p-3 custom-modal-body">
                        <ul class="nav nav-tabs mb-3 custom-nav-tabs" id="reportTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="compOffTab" data-bs-toggle="tab" data-bs-target="#compOff" type="button" role="tab">
                                    <span class="tab-loader" id="compOffLoader"><span class="hrms-tab-spinner"></span></span>
                                    Comp-Off <span class="balance-badge ms-2" id="compOffTotal">0</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="upCommingProbationTab" data-bs-toggle="tab" data-bs-target="#upCommingProbation" type="button" role="tab">
                                    <span class="tab-loader" id="upcomingProbationLoader"><span class="hrms-tab-spinner"></span></span>
                                    Upcoming Probation <span class="balance-badge ms-2" id="upcomingProbationTotal">0</span>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="pendingProbationTab" data-bs-toggle="tab" data-bs-target="#pendingProbation" type="button" role="tab">
                                    <span class="tab-loader" id="pendingProbationLoader"><span class="hrms-tab-spinner"></span></span>
                                    Pending Approval Probation <span class="balance-badge ms-2" id="pendingProbationTotal">0</span>
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content custom-tab-content" id="reportTabsContent">
                            <div id="noRecordsMessage" style="display:none">
                                <div class="text-center py-4">
                                    <i class="bx bx-info-circle" style="font-size:2rem;color:#9ca3af"></i>
                                    <p class="mt-2" style="color:#6b7280">No records found</p>
                                </div>
                            </div>
                            <div class="tab-pane fade show active" id="compOff" role="tabpanel">
                                <div class="loading-placeholder" id="compOffLoading">
                                    <div class="wg-dot-spinner hrms-modal-spinner"></div>
                                    <p>Loading Comp-Off records…</p>
                                </div>
                                <div id="compOffContent" style="display:none">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="employee-card flex-grow-1 me-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bx bxs-user-circle text-primary fs-4 me-2"></i>
                                                <div>
                                                    <h6 class="mb-0 fw-bold" id="employeeName">-</h6>
                                                    <small class="text-muted">Code: <span class="fw-semibold" id="employeeCode">-</span></small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-2"><i class="bx bx-trending-up text-primary me-1"></i>Comp-Off Leave Records</h6>
                                    <div class="leave-records-container" id="compOffRecordsContainer"></div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="upCommingProbation" role="tabpanel">
                                <div class="loading-placeholder" id="upcomingProbationLoading">
                                    <div class="wg-dot-spinner hrms-modal-spinner"></div>
                                    <p>Loading Upcoming Probation records…</p>
                                </div>
                                <div id="upcomingProbationContent" style="display:none">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bx bx-trending-up text-primary me-1"></i>Upcoming Probation Records</h6>
                                    <div class="leave-records-container" id="upCommingProbationRecordsContainer"></div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="pendingProbation" role="tabpanel">
                                <div class="loading-placeholder" id="pendingProbationLoading">
                                    <div class="wg-dot-spinner hrms-modal-spinner"></div>
                                    <p>Loading Pending Probation records…</p>
                                </div>
                                <div id="pendingProbationContent" style="display:none">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bx bx-trending-up text-primary me-1"></i>Pending Approval Probation Records</h6>
                                    <div>&nbsp;&nbsp;<a href="/EmployeePanel/ManageProbation/Probation"><i>Go for Approval</i></a></div>
                                    <div class="leave-records-container" id="pendingProbationRecordsContainer"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-3 pb-3 custom-modal-footer">
                        <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">
                            <i class="bx bx-check-circle me-1"></i>Got it, Thanks!
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll-to-top button -->
    <!-- bottom:60px keeps this clear of the fixed .app-footer bar (~35px tall,
         pinned to bottom:0 with z-index:99) -- at bottom:28px the two overlapped. -->
    <button id="scroll-to-top" title="Go to top" aria-label="Scroll to top"
            style="display:none;position:fixed;bottom:60px;right:28px;z-index:9999;width:42px;height:42px;
                   border-radius:50%;border:none;background:linear-gradient(135deg,#1e3a5f,#2d7ab5);
                   color:#fff;font-size:18px;cursor:pointer;box-shadow:0 4px 14px rgba(45,122,181,.40);
                   transition:opacity .25s,transform .25s;opacity:0;pointer-events:none;
                   align-items:center;justify-content:center;">
        <i class="bx bx-chevron-up" style="line-height:1"></i>
    </button>

    <!-- ══ SCRIPTS ══ -->
    <script src="~/assets/js/searchableselect.js"></script>
    <script src="~/assets/js/signalr.js"></script>
    <script src="~/assets/plugins/perfect-scrollbar/js/perfect-scrollbar.js"></script>
    <script src="~/assets/plugins/notifications/js/lobibox.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notifications.min.js"></script>
    <script src="~/assets/plugins/notifications/js/notification-custom-script.js"></script>
    <script src="~/assets/js/dx.all.js"></script>
    <script src="~/assets/js/hrms-wms-dropdown.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>

    <script>
        var uiBaseUrlLayout = '@UIBaseUrlLayout';
        var BaseUrlLayout   = '@baseUrlLayout';
        var BaseDomainUrl   = '@baseDomainUrl';

        document.getElementById("loader").style.display = "flex";
        window.addEventListener("load", function () {
            document.getElementById("loader").style.display = "none";
        });

        document.addEventListener('click', function (e) {
            var dd = document.getElementById('notificationDropdown');
            var bell = document.getElementById('notif-bell-btn');
            if (dd && !dd.contains(e.target) && bell && !bell.contains(e.target)) {
                dd.classList.remove('show');
            }
        });
    </script>

    <script src="~/assets/js/companymodalloader.js"></script>
    <script src="~/assets/js/logout.js"></script>
    <script src="~/assets/js/permissions.js"></script>
    <script src="~/assets/js/logindetails.js"></script>
    <script src="~/assets/js/common-input-handler.js"></script>
    <script src="~/assets/js/notification-remainder.js"></script>
    <script src="~/assets/js/compoffleavemodal.js"></script>

    <script src="~/assets/js/app-shell.js"></script>
    <script src="~/assets/js/hrms-shell.js"></script>

    <script>
        $(document).ready(function () {
            $('.sb-link, .sb-dash-link').click(function () {
                localStorage.removeItem("PreviousPageUrl");
                localStorage.setItem("PreviousPageUrl", window.location.href);
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
