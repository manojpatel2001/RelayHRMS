@{
    ViewData["Title"] = "Leave Approval";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string apiBase = ViewBag.BaseUrlAPI;
}

<title>Leave Approval</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Leave Approval</h6>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div class="fg" style="flex:1 1 170px;min-width:150px;">
                    <label for="Leavetypeid">Search By</label>
                    <select id="Leavetypeid">
                        <option value="0">-- Select --</option>
                        <option value="1">Employee Code</option>
                        <option value="2">Employee Name</option>
                        <option value="3">Leave Name</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="input1">Search For</label>
                    <input type="text" id="input1" placeholder="Search text" disabled>
                    <span class="field-validation-error" id="spnSearchFor" style="display:none;">Please enter search text</span>
                </div>

                <div style="flex-shrink:0;">
                    <div class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);">Status</div>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="radioPending" value="Pending" checked>
                            <label class="form-check-label" for="radioPending">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="radioApproved" value="Approved">
                            <label class="form-check-label" for="radioApproved">Approved</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="radioRejected" value="Rejected">
                            <label class="form-check-label" for="radioRejected">Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="goButtonId">
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearButtonId">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card" id="recordDetails" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Leave Applications</h6>
            <div class="d-flex gap-2">
                <div id="btnApproveWrap" style="display:none;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnApprove">
                        <i class="bx bx-check"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Approve</span>
                    </button>
                </div>
                <div id="btnRejectWrap" style="display:none;">
                    <button type="button" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1" id="btnReject">
                        <i class="bx bx-x"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Reject</span>
                    </button>
                </div>
                <div id="btnDeleteWrap" style="display:none;">
                    <button type="button" class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1" id="btnDelete">
                        <i class="bx bx-trash"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Delete</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div id="attendanceGrid"></div>
        </div>
    </div>

</div>

<script>
    /* ── Globals ─────────────────────────────────── */
    var allData          = [];
    var leaveDataCache    = {};
    var selectedLeaveIds  = {};
    var leaveGrid         = null;
    var isLoadingLeave    = false;
    var isProcessingLeave = false;

    var Empid          = parseInt(localStorage.getItem("EmployeeId"));
    var savedCompany   = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany || '{}');
    var Compid         = parseInt(companyDetails.CompanyId);
    var Token          = localStorage.getItem("authToken");

    function getSelectedStatus() {
        return $('input[name="leaveStatus"]:checked').val() || 'Pending';
    }

    function fmtDate(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear();
    }

    $(document).ready(function () {
        loadLeaveApplications();

        $('#goButtonId').click(function () {
            if (isLoadingLeave) return;
            if (!validateSearchForm()) return;
            loadLeaveApplications();
        });

        $('#clearButtonId').click(function () {
            if (isLoadingLeave) return;
            $('#Leavetypeid').val('0');
            $('#input1').val('').prop('disabled', true).attr('placeholder', 'Search text');
            $('#spnSearchFor').hide();
            $('#radioPending').prop('checked', true);
            allData = [];
            leaveDataCache = {};
            selectedLeaveIds = {};
            loadLeaveApplications();
        });

        $('#Leavetypeid').change(function () {
            var val = $(this).val();
            var placeholders = { '1': 'Enter Employee Code', '2': 'Enter Employee Name', '3': 'Enter Leave Name' };
            $('#input1').prop('disabled', val === '0').attr('placeholder', placeholders[val] || 'Search text');
            if (val === '0') { $('#input1').val(''); $('#spnSearchFor').hide(); }
        });

        $('#input1').on('input', function () { $('#spnSearchFor').hide(); });

        $('input[name="leaveStatus"]').change(function () {
            selectedLeaveIds = {};
            loadLeaveApplications();
        });

        $('#btnApprove').click(function () { updateLeaveStatus('Approved'); });
        $('#btnReject').click(function ()  { updateLeaveStatus('Rejected'); });
        $('#btnDelete').click(function ()  { deleteLeaveApplications(); });
    });

    function validateSearchForm() {
        var searchTypeValue = $('#Leavetypeid').val();
        var searchFor = $('#input1').val().trim();
        if (searchTypeValue !== '0' && !searchFor) {
            $('#spnSearchFor').show();
            return false;
        }
        $('#spnSearchFor').hide();
        return true;
    }

    /* ── Load Leave Applications (manager's own team only) ───────── */
    function loadLeaveApplications() {
        if (isLoadingLeave) return;
        isLoadingLeave = true;
        setBtnLoading('#goButtonId', 'Loading...');
        if (leaveGrid) leaveGrid.showLoader();

        selectedLeaveIds = {};

        var searchTypeValue = $('#Leavetypeid').val();
        var searchFor        = $('#input1').val().trim();
        var selectedStatus    = getSelectedStatus();

        var searchTypeText = '';
        if      (searchTypeValue == '1') searchTypeText = 'Employee Code';
        else if (searchTypeValue == '2') searchTypeText = 'Employee Name';
        else if (searchTypeValue == '3') searchTypeText = 'Leave Name';

        var payload = {
            SearchType  : searchTypeText,
            SearchFor   : searchFor,
            CompId      : Compid,
            Status      : selectedStatus,
            Emplooyeid  : Empid
        };

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/GetLeaveApplicationsforApprove',
            type        : 'POST',
            contentType : 'application/json',
            headers     : { 'Authorization': 'Bearer ' + Token },
            data        : JSON.stringify(payload),
            success : function (data) {
                isLoadingLeave = false;
                setBtnNormal('#goButtonId', 'Go');

                if (data.isSuccess && data.data && data.data.length > 0) {
                    allData = data.data;
                    leaveDataCache = {};
                    allData.forEach(function (row) { leaveDataCache[row.leaveApplicationid] = row; });
                    renderGrid(allData);
                    $('#recordDetails').show();
                } else {
                    allData = [];
                    leaveDataCache = {};
                    renderGrid([]);
                    $('#recordDetails').show();
                }
            },
            error : function () {
                isLoadingLeave = false;
                setBtnNormal('#goButtonId', 'Go');
                if (leaveGrid) leaveGrid.hideLoader();
                showToast('Error fetching leave applications.', 'error');
            }
        });
    }

    function leaveToggleRow(id, checked) {
        if (checked) selectedLeaveIds[id] = true;
        else delete selectedLeaveIds[id];
    }

    /* ── Render Grid ──────────────────────────────── */
    function renderGrid(data) {
        var selectedStatus = getSelectedStatus();

        if (selectedStatus === 'Pending') {
            $('#btnApproveWrap, #btnRejectWrap').show();
            $('#btnDeleteWrap').hide();
        } else {
            $('#btnApproveWrap, #btnRejectWrap').hide();
            $('#btnDeleteWrap').show();
        }

        var columns = [
            {
                header: '', sortable: false, width: '40px', align: 'center',
                render: function (v, row) {
                    var checked = !!selectedLeaveIds[row.leaveApplicationid];
                    return '<input type="checkbox" ' + (checked ? 'checked' : '') + ' onchange="leaveToggleRow(' + row.leaveApplicationid + ', this.checked)">';
                }
            },
            { field: 'leaveTypeName', header: 'Leave Type', width: '120px' },
            { field: 'employeeName', header: 'Employee Name', width: '160px' },
            { field: 'employeeCode', header: 'Employee Code', width: '120px' },
            { field: 'branchName', header: 'Branch Name', width: '120px' },
            { field: 'fromDate', header: 'From Date', width: '110px', align: 'center', render: function (v) { return fmtDate(v); } },
            { field: 'todate', header: 'To Date', width: '110px', align: 'center', render: function (v) { return fmtDate(v); } },
            { field: 'no_Of_Date', header: 'Period', width: '80px', align: 'center' },
            { field: 'reason', header: 'Reason', width: '180px' },
            { field: 'applicationType', header: 'Application Type', width: '140px' },
            { field: 'reportingPersonName', header: 'Reporting Person', width: '150px' },
            { field: 'leaveStatus', header: 'Leave Status', width: '110px', align: 'center' },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '100px', align: 'center',
                render: function (v, row) {
                    if (getSelectedStatus() === 'Pending') {
                        return '<button type="button" class="wg-btn wg-btn-outline" title="Approve" onclick="RowApprove(' + row.leaveApplicationid + ')"><i class="bx bx-check"></i></button> ' +
                               '<button type="button" class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Reject" onclick="RowReject(' + row.leaveApplicationid + ')"><i class="bx bx-x"></i></button>';
                    }
                    return '<button type="button" class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Delete" onclick="RowDelete(' + row.leaveApplicationid + ')"><i class="bx bx-trash"></i></button>';
                }
            }
        ];

        if (!leaveGrid) {
            leaveGrid = WMSGrid.create({
                container: 'attendanceGrid',
                title: 'Leave Applications',
                icon: 'bx-calendar-check',
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false },
                data: data,
                extraButtons: [
                    {
                        id: 'leaveSelectAll',
                        label: 'Select All',
                        icon: 'bx-check-square',
                        onClick: function (e, gridData) {
                            var allSelected = gridData.length > 0 && gridData.every(function (r) { return !!selectedLeaveIds[r.leaveApplicationid]; });
                            if (allSelected) {
                                gridData.forEach(function (r) { delete selectedLeaveIds[r.leaveApplicationid]; });
                            } else {
                                gridData.forEach(function (r) { selectedLeaveIds[r.leaveApplicationid] = true; });
                            }
                            leaveGrid.refresh();
                        }
                    },
                    {
                        id: 'leaveExportExcel',
                        label: 'Export to Excel',
                        icon: 'bx-download',
                        onClick: function (e, gridData) { exportLeaveToExcel(gridData); }
                    }
                ],
                columns: columns
            });
        } else {
            leaveGrid.setData(data);
            leaveGrid.hideLoader();
            // Actions column depends on the current status filter, which can change between loads
            leaveGrid.getColumns().length = 0;
            columns.forEach(function (c) { leaveGrid.getColumns().push(c); });
            leaveGrid.reset();
            leaveGrid.setData(data);
        }
    }

    /* ── Approve / Reject ────────────────────────── */
    function RowApprove(id) { updateLeaveStatus('Approved', [id]); }
    function RowReject(id)  { updateLeaveStatus('Rejected', [id]); }

    function updateLeaveStatus(status, ids) {
        if (isProcessingLeave) return;

        var targetIds = ids || Object.keys(selectedLeaveIds).map(Number);
        if (targetIds.length === 0) {
            showToast('Please select at least one application.', 'warn');
            return;
        }

        if (status === 'Approved') {
            var rowsToApprove = targetIds.map(function (id) { return leaveDataCache[id]; }).filter(Boolean);
            var firstFromDate = rowsToApprove.length ? rowsToApprove[0].fromDate : null;

            checkSalaryProcessed(firstFromDate, rowsToApprove).then(function (result) {
                if (result.isProcessed) {
                    showToast('Leave applications not allowed for periods where the previous month\'s salary has already been processed. Please contact HR for assistance if needed.', 'warn');
                    return;
                }
                proceedWithStatusUpdate(status, targetIds);
            }).catch(function (error) {
                console.error('Error checking salary processed status: ', error);
                showToast('Failed to check salary status.', 'error');
            });
        } else {
            proceedWithStatusUpdate(status, targetIds);
        }
    }

    function checkSalaryProcessed(fromDate, selectedRowsData) {
        return new Promise(function (resolve, reject) {
            if (!fromDate) { resolve({ isProcessed: false }); return; }

            var leaveDate = new Date(fromDate);
            var month = leaveDate.getMonth() + 1;
            var year = leaveDate.getFullYear();

            var employeeCodes = selectedRowsData.map(function (row) { return row.employeeCode; }).join(',');

            var requestData = {
                Month: parseInt(month),
                Year: parseInt(year),
                EmployeeCodes: employeeCodes || "",
                BranchId: 0
            };

            $.ajax({
                url: apiBase + '/MonthlySalaryDetailsAPI/GetAll',
                type: 'POST',
                data: JSON.stringify(requestData),
                contentType: 'application/json',
                success: function (response) {
                    resolve({
                        isProcessed: response.isSuccess && response.data && response.data.length > 0,
                        month: month,
                        year: year
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Salary check error:', status, error, xhr.responseText);
                    reject(error);
                }
            });
        });
    }

    function proceedWithStatusUpdate(status, targetIds) {
        var btnSel = status === 'Approved' ? '#btnApprove' : '#btnReject';
        isProcessingLeave = true;
        setBtnLoading(btnSel, status === 'Approved' ? 'Approving...' : 'Rejecting...');

        var payload = {
            Ids        : targetIds,
            Status     : status,
            EmployeeId : Empid
        };

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/LeaveapplicationApproveorReject',
            type        : 'POST',
            contentType : 'application/json',
            headers     : { 'Authorization': 'Bearer ' + Token },
            data        : JSON.stringify(payload),
            success     : function (res) {
                isProcessingLeave = false;
                setBtnNormal(btnSel, status === 'Approved' ? 'Approve' : 'Reject');
                if (res.isSuccess) {
                    showToast(res.message || (status + ' successfully.'), 'success');
                    selectedLeaveIds = {};
                    loadLeaveApplications();
                } else {
                    showToast(res.message || 'Something went wrong.', 'error');
                }
            },
            error : function () {
                isProcessingLeave = false;
                setBtnNormal(btnSel, status === 'Approved' ? 'Approve' : 'Reject');
                showToast('Failed to update status.', 'error');
            }
        });
    }

    /* ── Delete Leave Applications ───────────────── */
    function RowDelete(id) { deleteLeaveApplications([id]); }

    function deleteLeaveApplications(ids) {
        if (isProcessingLeave) return;

        var targetIds = ids || Object.keys(selectedLeaveIds).map(Number);
        if (targetIds.length === 0) {
            showToast('Please select at least one application to delete.', 'warn');
            return;
        }

        var selectedRows = targetIds.map(function (id) { return leaveDataCache[id]; }).filter(Boolean);
        var approvedRows = selectedRows.filter(function (row) { return row.leaveStatus === 'Approved'; });

        if (approvedRows.length > 0) {
            showToast('Approved applications cannot be deleted.', 'warn');
            return;
        }

        wmsConfirm(targetIds.length + ' application(s) will be deleted permanently. Are you sure?', function () {
            isProcessingLeave = true;
            setBtnLoading('#btnDelete', 'Deleting...');

            var payload = {
                Id        : targetIds,
                DeletedBy : String(Empid)
            };

            $.ajax({
                url         : '@(apiBase)/LeaveApplication/Delete',
                type        : 'DELETE',
                contentType : 'application/json',
                headers     : { 'Authorization': 'Bearer ' + Token },
                data        : JSON.stringify(payload),
                success     : function (res) {
                    isProcessingLeave = false;
                    setBtnNormal('#btnDelete', 'Delete');
                    if (res.isSuccess) {
                        showToast(res.message || 'Applications deleted successfully.', 'success');
                        selectedLeaveIds = {};
                        loadLeaveApplications();
                    } else {
                        showToast(res.message || 'Something went wrong.', 'error');
                    }
                },
                error : function () {
                    isProcessingLeave = false;
                    setBtnNormal('#btnDelete', 'Delete');
                    showToast('Failed to delete applications.', 'error');
                }
            });
        }, { title: 'Delete Leave Application(s)', confirmText: 'Delete' });
    }

    /* ── Export to Excel ──────────────────────────── */
    function exportLeaveToExcel(gridData) {
        var selectedIds = Object.keys(selectedLeaveIds).map(Number);
        var selectedRows = selectedIds.length > 0
            ? selectedIds.map(function (id) { return leaveDataCache[id]; }).filter(Boolean)
            : (gridData || allData);

        if (!selectedRows || selectedRows.length === 0) {
            showToast('No data available to export.', 'warn');
            return;
        }

        if (typeof ExcelJS === 'undefined') {
            showToast('ExcelJS library not loaded. Please refresh the page.', 'error');
            return;
        }

        var workbook  = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet('Leave Applications');

        worksheet.columns = [
            { header: 'Leave Type',       key: 'leaveTypeName',        width: 18 },
            { header: 'Employee Name',     key: 'employeeName',         width: 25 },
            { header: 'Employee Code',     key: 'employeeCode',         width: 15 },
            { header: 'Branch Name',       key: 'branchName',           width: 18 },
            { header: 'From Date',         key: 'fromDate',             width: 14 },
            { header: 'To Date',           key: 'todate',               width: 14 },
            { header: 'Period',            key: 'no_Of_Date',           width: 10 },
            { header: 'Reason',            key: 'reason',               width: 25 },
            { header: 'Application Type',  key: 'applicationType',      width: 18 },
            { header: 'Reporting Person',  key: 'reportingPersonName',  width: 22 },
            { header: 'Leave Status',      key: 'leaveStatus',          width: 15 }
        ];

        var headerRow = worksheet.getRow(1);
        headerRow.eachCell(function (cell) {
            cell.font      = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
            cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF2D4159' } };
            cell.alignment = { vertical: 'middle', horizontal: 'center' };
            cell.border    = {
                top    : { style: 'thin' },
                left   : { style: 'thin' },
                bottom : { style: 'thin' },
                right  : { style: 'thin' }
            };
        });
        headerRow.height = 25;

        function safe(val) { return (val === null || val === undefined) ? '' : String(val); }

        selectedRows.forEach(function (row) {
            if (!row) return;
            var dataRow = worksheet.addRow({
                leaveTypeName      : safe(row.leaveTypeName),
                employeeName       : safe(row.employeeName),
                employeeCode       : safe(row.employeeCode),
                branchName         : safe(row.branchName),
                fromDate           : fmtDate(row.fromDate),
                todate             : fmtDate(row.todate),
                no_Of_Date         : safe(row.no_Of_Date),
                reason             : safe(row.reason),
                applicationType    : safe(row.applicationType),
                reportingPersonName: safe(row.reportingPersonName),
                leaveStatus        : safe(row.leaveStatus)
            });

            dataRow.eachCell(function (cell) {
                cell.border = {
                    top    : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    left   : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    bottom : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    right  : { style: 'thin', color: { argb: 'FFD3D3D3' } }
                };
                cell.alignment = { horizontal: 'left', vertical: 'middle' };
            });
        });

        var status   = getSelectedStatus();
        var today    = new Date();
        var dateStr  = String(today.getDate()).padStart(2, '0') + '-' +
                       String(today.getMonth() + 1).padStart(2, '0') + '-' +
                       today.getFullYear();
        var fileName = 'LeaveApplications_' + status + '_' + dateStr + '.xlsx';

        workbook.xlsx.writeBuffer()
            .then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
                showToast(selectedRows.length + ' record(s) exported successfully.', 'success');
            })
            .catch(function (err) {
                console.error('Export error:', err);
                showToast('Export failed: ' + err.message, 'error');
            });
    }
</script>
