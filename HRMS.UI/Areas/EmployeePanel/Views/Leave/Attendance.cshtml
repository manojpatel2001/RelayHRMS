@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Attendance Regularization";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
    string baseUrls = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrls);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<title>Attendance Request</title>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Attendance Request</h6>
            <div class="d-flex gap-2">
                <a href="/EmployeePanel/Leave/AttendanceRequest" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-plus"></i> Add
                </a>
                <button type="button" class="btn btn-secondary btn-sm" onclick="goBack()">Back</button>
            </div>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 150px;min-width:140px;">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate">
                </div>

                <div class="fg" style="flex:1 1 150px;min-width:140px;">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate">
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="type" id="r2">
                            <label class="form-check-label" for="r2">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="type" id="r3">
                            <label class="form-check-label" for="r3">Approved</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="type" id="r4">
                            <label class="form-check-label" for="r4">Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="actionButtons" class="d-flex justify-content-end gap-2 mb-3" style="display:none;">
                <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="btnDelete">
                    <i class="bx bx-trash"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Delete</span>
                </button>
            </div>

            <div id="gridContainerAttendance"></div>
        </div>
    </div>

</div>

<div id="grid-loader"
     class="grid-loader justify-content-center align-items-center flex-column"
     style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(3px); z-index: 9999;">
    <img src="@baseDomainUrl/loders/loder.png"
         class="grid-logo-spinner"
         style="width: 40px; height: 40px; animation: spin 1s linear infinite;" />
    <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
</div>

<script>
    const EmployeeId = localStorage.getItem('EmployeeId');
    const apiBase = '@apiBase';

    let selectedIds = {};
    let currentRows = [];
    let grid = null;
    let isLoadingAttReg = false;
    let isDeletingAttReg = false;
    let isUpdatingAttReg = false;

    function goBack() {
        window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
    }

    async function showLoder() {
        $('#grid-loader').addClass('d-flex').show();
    }

    async function hideLoder() {
        $('#grid-loader').removeClass('d-flex').hide();
    }

    function fmtDate(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        return day + '/' + month + '/' + d.getFullYear();
    }

    function fmtDateTime(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const hours = String(d.getHours()).padStart(2, '0');
        const mins = String(d.getMinutes()).padStart(2, '0');
        return day + '/' + month + '/' + d.getFullYear() + ' ' + hours + ':' + mins;
    }

    function statusOf(row) {
        if (row.isApproved === true) return 'Approved';
        if (row.isRejected === true) return 'Rejected';
        if (row.isPending === true) return 'Pending';
        return '';
    }

    function statusPill(row) {
        const s = statusOf(row);
        if (s === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
        if (s === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
        if (s === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
        return '-';
    }

    $(document).ready(function () {
        $('#r2').prop('checked', true); // Default to Pending
        $('#btnGo').click(); // Trigger initial load
    });

    function getStatus() {
        if ($('#r2').is(':checked')) return 'Pending';
        if ($('#r3').is(':checked')) return 'Approved';
        if ($('#r4').is(':checked')) return 'Rejected';
        return null;
    }

    window._toggleAttRow = function (id, checked) {
        if (checked) selectedIds[id] = true;
        else delete selectedIds[id];
    };

    function getSelectedRows() {
        return currentRows.filter(function (r) { return !!selectedIds[r.attendanceRegularizationId]; });
    }

    function renderGrid(data) {
        const columns = [
            {
                header: '', sortable: false, width: '40px',
                render: function (v, row) {
                    const checked = selectedIds[row.attendanceRegularizationId] ? ' checked' : '';
                    return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="event.stopPropagation(); _toggleAttRow(' + row.attendanceRegularizationId + ', this.checked)">';
                }
            },
            { field: 'employeeCode', header: 'Code', width: '100px' },
            { field: 'fullName', header: 'Name', width: '180px' },
            { header: 'Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.forDate); } },
            { header: 'App Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.createdDate); } },
            { header: 'In Time', sortable: false, width: '150px', render: function (v, row) { return fmtDateTime(row.inTime); } },
            { header: 'Out Time', sortable: false, width: '150px', render: function (v, row) { return fmtDateTime(row.outTime); } },
            { field: 'duration', header: 'Duration', width: '80px' },
            { field: 'reason', header: 'Reason', width: '150px' },
            { field: 'remark', header: 'Remark', width: '150px' },
            { field: 'day', header: 'Day', width: '100px' },
            { header: 'Status', sortable: false, width: '100px', render: function (v, row) { return statusPill(row); } },
            { header: 'Approved By', sortable: false, width: '150px', render: function (v, row) { return row.updatedBy ? row.updatedBy : '-'; } },
            { header: 'Approved Date', sortable: false, width: '130px', render: function (v, row) { return row.updatedDate ? fmtDate(row.updatedDate) : '-'; } }
        ];

        if (!grid) {
            grid = WMSGrid.create({
                container: 'gridContainerAttendance',
                title: 'Employee Regularization',
                icon: 'bx-time-five',
                exportName: 'AttendanceRegularization',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false },
                onRowClick: function (row) {
                    window.location.href = '/EmployeePanel/Leave/AttendanceRequest?id=' + row.attendanceRegularizationId;
                }
            });
        } else {
            grid.setData(data);
        }
    }

    $('#btnGo').on('click', function () {
        if (isLoadingAttReg) return;

        let model = {
            FromDate: $('#fromdate').val() || null,
            ToDate: $('#todate').val() || null,
            Status: getStatus(),
            LoggedInUserId: EmployeeId
        };

        isLoadingAttReg = true;
        setBtnLoading('#btnGo', 'Go');
        selectedIds = {};

        $.ajax({
            url: apiBase + "/AttendanceRegularizationAPI/GetAttendanceRegularization",
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json',
            success: function (res) {
                if (res.isSuccess && res.data && res.data.length > 0) {
                    currentRows = res.data;
                    renderGrid(currentRows);
                    $('#actionButtons').show();
                } else {
                    currentRows = [];
                    grid = null;
                    $('#gridContainerAttendance').empty();
                    $('#actionButtons').hide();
                    showToast(res.responseMessage || 'No Data', 'info');
                }
            },
            error: function () {
                currentRows = [];
                grid = null;
                $('#gridContainerAttendance').empty();
                $('#actionButtons').hide();
                showToast('Error loading data', 'error');
            },
            complete: function () {
                isLoadingAttReg = false;
                setBtnNormal('#btnGo', 'Go');
            }
        });
    });

    $('#btnDelete').on('click', function () {
        if (isDeletingAttReg) return;

        const selectedRows = getSelectedRows();

        if (selectedRows.length === 0) {
            showToast("Please select at least one record.", 'warn');
            return;
        }
        const approvedRecords = selectedRows.filter(row => row.isApproved);
        if (approvedRecords.length > 0) {
            showToast("Approved records cannot be deleted.", 'error');
            return;
        }

        const rejectedRecords = selectedRows.filter(row => row.isRejected);
        if (rejectedRecords.length > 0) {
            showToast("Rejected records cannot be deleted.", 'error');
            return;
        }

        const selectedIdsArr = selectedRows.map(row => row.attendanceRegularizationId);

        const deletePayload = {
            Id: selectedIdsArr,
            DeletedBy: EmployeeId
        };

        isDeletingAttReg = true;
        setBtnLoading('#btnDelete', 'Delete');
        showLoder();

        $.ajax({
            url: apiBase + "/AttendanceRegularizationAPI/Delete",
            type: 'DELETE',
            contentType: 'application/json',
            data: JSON.stringify(deletePayload),
            success: function (res) {
                if (res.isSuccess) {
                    showToast(res.responseMessage || "Deleted successfully.", 'success');
                    selectedIds = {};
                    $('#btnGo').click();
                } else {
                    showToast(res.responseMessage || "Deletion failed.", 'error');
                }
            },
            error: function () {
                showToast("Something went wrong during deletion.", 'error');
            },
            complete: function () {
                isDeletingAttReg = false;
                setBtnNormal('#btnDelete', 'Delete');
                hideLoder();
            }
        });
    });

    $("#btnClear").click(function () {
        $('#fromdate').val('');
        $('#todate').val('');
        $("input[name='type']").prop('checked', false);
        $('#r2').prop('checked', true);

        selectedIds = {};
        currentRows = [];
        grid = null;
        $('#gridContainerAttendance').empty();
        $("#actionButtons").hide();
    });
</script>
