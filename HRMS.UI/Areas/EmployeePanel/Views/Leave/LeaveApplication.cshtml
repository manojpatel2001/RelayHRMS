@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<title>Leave Application</title>

<style>
    /* #actionButtons also carries Bootstrap's .d-flex utility, which is
       display:flex !important — jQuery's .hide()/.toggle(false) only ever
       sets a plain (non-important) inline display:none, which always loses
       to that !important rule, so the bar never actually hid no matter what
       the JS condition was. This class wins because it's declared later in
       the document than bootstrap.min.css, not because of specificity. */
    #actionButtons.wms-force-hide {
        display: none !important;
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Leave Application</h6>
            <a href="@Url.Action("AddLeave", "Leave", new { area = "EmployeePanel" })" id="btnAddLeaveApplication" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-plus"></i> Add
            </a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 170px;min-width:150px;">
                    <label for="Leavetypeid">Leave Type</label>
                    <select id="Leavetypeid">
                        <option value="0">-- Select --</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 220px;min-width:200px;">
                    <label for="input1">Search For</label>
                    <input type="text" id="input1" placeholder="Search Employee code or Name" disabled>
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="allleaveid" value="" checked>
                            <label class="form-check-label" for="allleaveid">All</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="pendingleaveid" value="Pending">
                            <label class="form-check-label" for="pendingleaveid">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" name="leaveStatus" id="Approveid" value="ApprovedRejected">
                            <label class="form-check-label" for="Approveid">Approved/Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="gobutoonid">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearbuttonid">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="actionButtons" class="d-flex justify-content-end gap-2 mb-3 wms-force-hide">
                <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="btnDelete">
                    <i class="bx bx-trash"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Delete</span>
                </button>
            </div>

            <div id="gridContainerLeaveApplication"></div>
            <div id="recordSummary" class="text-center mt-2 text-muted"></div>
        </div>
    </div>

</div>

<script>
    const apiBase = '@apiBase';
    const Empid = parseInt(localStorage.getItem("EmployeeId"));
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compid = parseInt(companyDetails.CompanyId);

    let selectedIds = {};
    let currentRows = [];
    let grid = null;
    let isLoadingLeaveApp = false;
    let isDeletingLeaveApp = false;
    let hasUserSearched = false;

    function fmtDate(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        return day + '/' + month + '/' + d.getFullYear();
    }

    function statusPill(status) {
        if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
        if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
        if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
        return status || '-';
    }

    $(document).ready(function () {
        fetchLeaveData();
        loadSearchByOptions();

        $('#gobutoonid').on('click', function () {
            hasUserSearched = true;
            fetchLeaveData();
        });

        $('input[name="leaveStatus"]').on('change', function () {
            hasUserSearched = true;
            fetchLeaveData();
        });

        $('#Leavetypeid').change(function () {
            $('#input1').prop('disabled', $(this).val() === '0');
        });

        $('#clearbuttonid').on('click', function () {
            $('#Leavetypeid').val('0');
            $('#input1').val('').prop('disabled', true);
            $('#allleaveid').prop('checked', true);
            selectedIds = {};
            hasUserSearched = true;
            fetchLeaveData();
        });

        $('#btnDelete').on('click', function () {
            handleDelete();
        });

        PermGuard.applyActions('ess-leave-leaveapplication', { create: '#btnAddLeaveApplication', delete: '#btnDelete' });
    });

    function loadSearchByOptions() {
        $.ajax({
            url: apiBase + '/LeaveMasterAPI/LeaveType?Compid=' + Compid,
            type: "GET",
            success: function (res) {
                const dropdown = $('#Leavetypeid');
                dropdown.empty().append(`<option value="0">-- Select --</option>`);

                if (res.isSuccess && res.data) {
                    $.each(res.data, function (i, item) {
                        dropdown.append(`<option value="${item.leavtypeid}">${item.leaveName}</option>`);
                    });
                }
            },
            error: function () {
                console.error("Failed to load leave type options.");
            }
        });
    }

    function fetchLeaveData() {
        if (isLoadingLeaveApp) return;

        const searchFor = $('#input1').val().trim();
        const leaveTypeRaw = $('#Leavetypeid').val();
        let filter = {
            LeaveType: leaveTypeRaw === "0" || !leaveTypeRaw ? 0 : parseInt(leaveTypeRaw),
            Status: $('input[name="leaveStatus"]:checked').val() || null,
            SearchFor: searchFor,
            Emplooyeid: Empid,
            CompId: Compid
        };

        isLoadingLeaveApp = true;
        setBtnLoading('#gobutoonid', 'Go');
        selectedIds = {};
        $('#actionButtons').addClass('wms-force-hide');

        $.ajax({
            url: apiBase + '/LeaveApplication/GetLeaveApplications',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(filter),
            success: function (data) {
                if (data.isSuccess && data.data && data.data.length > 0) {
                    currentRows = data.data;
                    renderGrid(currentRows);
                    $('#actionButtons').toggleClass('wms-force-hide', !(hasUserSearched && filter.Status === 'Pending'));
                    $('#recordSummary').text(currentRows.length + ' record(s) found.');
                } else {
                    currentRows = [];
                    grid = null;
                    $('#gridContainerLeaveApplication').empty();
                    $('#recordSummary').text('');
                    $('#actionButtons').addClass('wms-force-hide');
                }
            },
            error: function (xhr) {
                console.error("AJAX error:", xhr);
                currentRows = [];
                grid = null;
                $('#gridContainerLeaveApplication').empty();
                $('#recordSummary').text('');
                $('#actionButtons').addClass('wms-force-hide');
                showToast(xhr.responseText || 'Something went wrong.', 'error');
            },
            complete: function () {
                isLoadingLeaveApp = false;
                setBtnNormal('#gobutoonid', 'Go');
            }
        });
    }

    window._toggleLeaveRow = function (id, checked) {
        if (checked) selectedIds[id] = true;
        else delete selectedIds[id];
    };

    function renderGrid(data) {
        const columns = [
            {
                header: '', sortable: false, width: '40px',
                render: function (v, row) {
                    const checked = selectedIds[row.leaveApplicationId] ? ' checked' : '';
                    return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="_toggleLeaveRow(' + row.leaveApplicationId + ', this.checked)">';
                }
            },
            { field: 'employeeName', header: 'Employee Name', width: '180px' },
            { field: 'leaveTypeName', header: 'Leave Type', width: '130px' },
            { field: 'reportingPersonName', header: 'Reporting Person', width: '160px' },
            { header: 'From Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.fromDate); } },
            { header: 'To Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.todate); } },
            { field: 'no_Of_Date', header: 'Days', width: '70px' },
            { field: 'reason', header: 'Reason', width: '200px' },
            { header: 'Status', sortable: false, width: '110px', render: function (v, row) { return statusPill(row.leaveStatus); } },
            { header: 'Approved By', sortable: false, width: '150px', render: function (v, row) { return row.approvedBy ? row.approvedBy : '-'; } },
            { header: 'Approved Date', sortable: false, width: '120px', render: function (v, row) { return row.approvedDate ? fmtDate(row.approvedDate) : '-'; } }
        ];

        if (!grid) {
            grid = WMSGrid.create({
                container: 'gridContainerLeaveApplication',
                title: 'Leave Applications',
                icon: 'bx-calendar-event',
                exportName: 'LeaveApplications',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            grid.setData(data);
        }
    }

    function getSelectedRows() {
        return currentRows.filter(function (r) { return !!selectedIds[r.leaveApplicationId]; });
    }

    function handleDelete() {
        if (isDeletingLeaveApp) return;

        const selectedRows = getSelectedRows();

        if (selectedRows.length === 0) {
            showToast('Please select at least one record to delete.', 'warn');
            return;
        }

        const nonPendingRecords = selectedRows.filter(row => {
            const status = row.leaveStatus;
            return status && status.trim().toLowerCase() !== "pending";
        });

        if (nonPendingRecords.length > 0) {
            const approvedCount = nonPendingRecords.filter(row => row.leaveStatus.trim().toLowerCase() === "approved").length;
            const rejectedCount = nonPendingRecords.filter(row => row.leaveStatus.trim().toLowerCase() === "rejected").length;

            let message = `Cannot delete records: `;
            let parts = [];
            if (approvedCount > 0) parts.push(`${approvedCount} approved`);
            if (rejectedCount > 0) parts.push(`${rejectedCount} rejected`);
            message += parts.join(' and ') + ". Only pending records can be deleted.";

            showToast(message, 'error');
            return;
        }

        const selectedIdsArr = selectedRows.map(row => row.leaveApplicationId);
        const deletePayload = {
            Id: selectedIdsArr,
            DeletedBy: Empid.toString()
        };

        Swal.fire({
            title: 'Are you sure?',
            text: `Delete ${selectedRows.length} pending record(s)?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                isDeletingLeaveApp = true;
                setBtnLoading('#btnDelete', 'Delete');

                $.ajax({
                    url: apiBase + "/LeaveApplication/Delete",
                    type: 'DELETE',
                    contentType: 'application/json',
                    data: JSON.stringify(deletePayload),
                    success: function (res) {
                        if (res.isSuccess) {
                            showToast(res.responseMessage || 'Records deleted successfully.', 'success');
                            selectedIds = {};
                            $('#actionButtons').addClass('wms-force-hide');
                            fetchLeaveData();
                        } else {
                            showToast(res.responseMessage || 'Deletion failed.', 'error');
                        }
                    },
                    error: function (xhr) {
                        console.error("Delete error:", xhr);
                        showToast('Something went wrong during deletion.', 'error');
                    },
                    complete: function () {
                        isDeletingLeaveApp = false;
                        setBtnNormal('#btnDelete', 'Delete');
                    }
                });
            }
        });
    }
</script>
