@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Attendance Regularization Approval";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
    string baseUrls = Configuration["BaseUrlSettings:baseUrl"];
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrls);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<title>Attendance Regularization Approval</title>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #ffffff;
    }

    /* ── Tab Toggle Buttons ── */
    .tab-toggle-wrapper {
        display: flex;
        gap: 0;
        margin-bottom: 18px;
        border-radius: 6px;
        overflow: hidden;
        border: 2px solid #3e4b6d;
        width: fit-content;
    }

    .tab-toggle-btn {
        padding: 9px 28px;
        font-size: 13.5px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        letter-spacing: 0.02em;
        background-color: #fff;
        color: #3e4b6d;
    }

        .tab-toggle-btn.active {
            background-color: #3e4b6d;
            color: #fff;
        }

        .tab-toggle-btn:not(.active):hover {
            background-color: #eef0f5;
        }

    /* ── Search Panel ── */
    .search-panel-wrapper {
        max-width: 100%;
        margin: auto;
    }

    .search-panel-container {
        background-color: #3e4b6d;
        padding: 6px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
    }

    /* HRD panel — same color as emp panel */
    .search-panel-container.hrd-accent {
        background-color: #3e4b6d;
    }

    /* ── Form ── */
    .form-section {
        padding: 15px;
        border: 1px solid #ccc;
        width: 100%;
        max-width: 100%;
        margin: 0;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .form-control-sm, .form-select-sm {
        height: calc(1.5em + .5rem + 2px);
        font-size: 0.875rem;
        padding: .25rem .5rem;
    }

    /* ── Buttons ── */
    .btn-custom {
        background-color: #3e4b6d;
        color: white;
        border: none;
        padding: 4px 12px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 4px;
        transition: none;
        box-shadow: none;
    }

        .btn-custom:hover,
        .btn-custom:focus,
        .btn-custom:active {
            background-color: #3e4b6d;
            color: white;
            outline: none;
            box-shadow: none;
        }

    /* HRD-specific action buttons */
    .btn-hrd-proceed {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 4px 12px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 4px;
    }

        .btn-hrd-proceed:hover {
            background-color: #218838;
            color: white;
        }

    .btn-hrd-reject {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 4px 12px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 4px;
    }

        .btn-hrd-reject:hover {
            background-color: #c82333;
            color: white;
        }

    /* ── Grid ── */
    .container {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 15px;
        padding-right: 15px;
    }

    .grid-container {
        width: 100% !important;
        overflow-x: auto;
        margin: 0;
        padding: 0;
    }

    #attendanceGrid, #hrdGrid {
        width: 100% !important;
        min-width: 100% !important;
    }

    .custom-action-buttons {
        width: 100%;
        margin-bottom: 10px;
    }

    /* ── Tab Content ── */
    .tab-content-panel {
        display: none;
    }

        .tab-content-panel.active {
            display: block;
        }
</style>

<!-- ══ TAB TOGGLE ══ -->
<div class="tab-toggle-wrapper">
    <button class="tab-toggle-btn active" id="tabBtnEmp" onclick="switchTab('emp')">
        Employee Regularization
    </button>
    <button class="tab-toggle-btn" id="tabBtnHrd" onclick="switchTab('hrd')">
        Employee Regularization for HRD Approval
    </button>
</div>

<!-- ════════════════════════════════════════════
     TAB 1 — EMPLOYEE REGULARIZATION
     ════════════════════════════════════════════ -->
<div class="tab-content-panel active" id="panelEmp">

    <!-- Search Panel Header -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">Search Panel</div>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="form-section">
        <div class="row justify-content-center mb-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">Search By<span class="text-danger">*</span>:</label>
                <select class="form-select form-select-sm" id="emp_searchby" style="width:180px;">
                    <option value="1">Emp Name</option>
                    <option value="2">Emp Code</option>
                    <option value="3">Reason</option>
                    <option value="4">Manager Name</option>
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">Search for<span class="text-danger">*</span>:</label>
                <input type="text" class="form-control form-control-sm" id="emp_searchfor" style="width:180px;" />
            </div>
        </div>
        <div class="row justify-content-center mb-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">From Date:</label>
                <input type="date" class="form-control form-control-sm" id="emp_fromdate" style="width:180px;" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">To Date:</label>
                <input type="date" class="form-control form-control-sm" id="emp_todate" style="width:180px;" />
            </div>
        </div>
        <div class="row justify-content-center align-items-center mb-3">
            <div class="col-md-10">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div class="d-flex align-items-center flex-wrap">
                        <div class="form-check me-4">
                            <input class="form-check-input" type="radio" name="emp_type" id="emp_r2">
                            <label class="form-check-label" for="emp_r2">Pending</label>
                        </div>
                        <div class="form-check me-4">
                            <input class="form-check-input" type="radio" name="emp_type" id="emp_r3">
                            <label class="form-check-label" for="emp_r3">Approved</label>
                        </div>
                        <div class="form-check me-4">
                            <input class="form-check-input" type="radio" name="emp_type" id="emp_r4">
                            <label class="form-check-label" for="emp_r4">Rejected</label>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mt-2 mt-md-0">
                        <button class="btn btn-custom me-2" id="emp_btnGo">Go</button>
                        <button class="btn btn-custom me-2" id="emp_btnClear">Clear</button>
                        <button onclick="goBack()" class="btn btn-custom">Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- EMPLOYEE REGULARIZATION Heading -->
    <div class="search-panel-wrapper mt-2" id="emp_gridHeading" style="display:none;">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">EMPLOYEE REGULARIZATION</div>
            </div>
        </div>
    </div>

    <!-- Loader -->
    <div id="emp_loader"
         style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh;
                background:rgba(255,255,255,0.6); backdrop-filter:blur(3px); z-index:9999;
                justify-content:center; align-items:center; flex-direction:column;">
        <img src="@baseDomainUrl/loders/loder.png" style="width:40px;height:40px;animation:spin 1s linear infinite;" />
        <div style="font-size:16px;">Loading...</div>
    </div>

    <div class="container mt-3">
        <div id="emp_actionButtons" class="custom-action-buttons text-end mb-2" style="display:none;">
            <button id="emp_btnDelete" class="btn btn-custom me-1">Delete</button>
            <button id="emp_btnApprove" class="btn btn-custom me-1">Approve</button>
            <button id="emp_btnReject" class="btn btn-custom">Reject</button>
        </div>
        <div class="grid-container">
            <div id="attendanceGrid"></div>
        </div>
    </div>
</div>


<!-- ════════════════════════════════════════════
     TAB 2 — HRD APPROVAL
     ════════════════════════════════════════════ -->
<div class="tab-content-panel" id="panelHrd">

    <!-- Search Panel Header -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container hrd-accent">
            <div class="search-panel-row">
                <div class="search-heading">Search Panel</div>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="form-section">
        <div class="row justify-content-center mb-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">Search By<span class="text-danger">*</span>:</label>
                <select class="form-select form-select-sm" id="hrd_searchby" style="width:180px;">
                    <option value="1">Emp Name</option>
                    <option value="2">Emp Code</option>
                    <option value="3">Reason</option>
                    <option value="4">Manager Name</option>
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">Search for<span class="text-danger">*</span>:</label>
                <input type="text" class="form-control form-control-sm" id="hrd_searchfor" style="width:180px;" />
            </div>
        </div>
        <div class="row justify-content-center mb-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">From Date:</label>
                <input type="date" class="form-control form-control-sm" id="hrd_fromdate" style="width:180px;" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="form-label mb-0 me-2" style="width:120px;">To Date:</label>
                <input type="date" class="form-control form-control-sm" id="hrd_todate" style="width:180px;" />
            </div>
        </div>
        <div class="row justify-content-center align-items-center mb-3">
            <div class="col-md-10">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div class="d-flex align-items-center flex-wrap">
                        <div class="form-check me-4">
                            <input class="form-check-input" type="radio" name="hrd_type" id="hrd_r2">
                            <label class="form-check-label" for="hrd_r2">Pending</label>
                        </div>
                        <div class="form-check me-4">
                            <input class="form-check-input" type="radio" name="hrd_type" id="hrd_r4">
                            <label class="form-check-label" for="hrd_r4">Rejected</label>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mt-2 mt-md-0">
                        <button class="btn btn-custom me-2" id="hrd_btnGo">Go</button>
                        <button class="btn btn-custom me-2" id="hrd_btnClear">Clear</button>
                        <button onclick="goBack()" class="btn btn-custom">Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HRD ATTENDANCE APPROVAL Heading -->
    <div class="search-panel-wrapper mt-2" id="hrd_gridHeading" style="display:none;">
        <div class="search-panel-container hrd-accent">
            <div class="search-panel-row">
                <div class="search-heading">HRD ATTENDANCE APPROVAL</div>
            </div>
        </div>
    </div>

    <!-- Loader -->
    <div id="hrd_loader"
         style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh;
                background:rgba(255,255,255,0.6); backdrop-filter:blur(3px); z-index:9999;
                justify-content:center; align-items:center; flex-direction:column;">
        <img src="@baseDomainUrl/loders/loder.png" style="width:40px;height:40px;animation:spin 1s linear infinite;" />
        <div style="font-size:16px;">Loading...</div>
    </div>

    <div class="container mt-3">
        <div id="hrd_actionButtons" class="custom-action-buttons text-end mb-2" style="display:none;">
            <button id="hrd_btnProceed" class="btn btn-hrd-proceed me-1">Proceed to HRD</button>
            <button id="hrd_btnReject" class="btn btn-hrd-reject">Rejected</button>
        </div>
        <div class="grid-container">
            <div id="hrdGrid"></div>
        </div>
    </div>
</div>


<script>
    const EmployeeId = localStorage.getItem('EmployeeId');
    const apiBase = '@apiBase';

    /* ══ TAB SWITCHING ══ */
    function switchTab(tab) {
        document.querySelectorAll('.tab-content-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-toggle-btn').forEach(b => b.classList.remove('active'));

        if (tab === 'emp') {
            document.getElementById('panelEmp').classList.add('active');
            document.getElementById('tabBtnEmp').classList.add('active');
        } else {
            document.getElementById('panelHrd').classList.add('active');
            document.getElementById('tabBtnHrd').classList.add('active');
        }
    }

    /* ══ UTILITY ══ */
    function goBack() {
        window.location.href = '@UIBaseUrl/EmployeePanel/Home/index';
    }

    function getSearchByText(value) {
        const map = { '1': 'EmpName', '2': 'EmpCode', '3': 'Reason', '4': 'ManagerName' };
        return map[value] || null;
    }

    function safeDisposeGrid(gridId) {
        try {
            var gi = $('#' + gridId).data('dxDataGrid');
            if (gi) gi.dispose();
        } catch (e) {}
        $('#' + gridId).empty();
    }

    /* ══════════════════════════════════════
       TAB 1 — EMPLOYEE REGULARIZATION
       ══════════════════════════════════════ */

    let emp_selectedKeys = [];

    function emp_getStatus() {
        if ($('#emp_r2').is(':checked')) return 'Pending';
        if ($('#emp_r3').is(':checked')) return 'Approved';
        if ($('#emp_r4').is(':checked')) return 'Rejected';
        return null;
    }

    function emp_showLoader() { $('#emp_loader').addClass('d-flex').show(); }
    function emp_hideLoader() { $('#emp_loader').removeClass('d-flex').hide(); }

    function emp_loadGrid(data) {
        safeDisposeGrid('attendanceGrid');

        if (!data || data.length === 0) {
            $('#emp_actionButtons').hide();
            $('#emp_gridHeading').hide();
            return;
        }

        $('#emp_gridHeading').show();

        $('#attendanceGrid').dxDataGrid({
            dataSource: data,
            keyExpr: 'attendanceRegularizationId',
            showBorders: true,
            width: '100%',
            height: 400,
            columnAutoWidth: true,
            paging: { enabled: false },
            scrolling: { mode: 'standard', useNative: true, showScrollbar: 'always' },
            selection: { mode: 'multiple', showCheckBoxesMode: 'always' },
            filterRow: { visible: false },
            searchPanel: { visible: false },
            onSelectionChanged: function (e) { emp_selectedKeys = e.selectedRowKeys; },
            columns: [
                { dataField: 'employeeCode', caption: 'Code', width: 80 },
                { dataField: 'empId', visible: false },
                { dataField: 'fullName', caption: 'Name', width: 250 },
                { dataField: 'forDate', caption: 'Date', dataType: 'date', format: 'dd/MM/yyyy', width: 100 },
                { dataField: 'createdDate', caption: 'App Date', dataType: 'date', format: 'dd/MM/yyyy', width: 100 },
                { dataField: 'inTime', caption: 'In Time', dataType: 'datetime', format: 'dd/MM/yyyy HH:mm', width: 140 },
                { dataField: 'outTime', caption: 'Out Time', dataType: 'datetime', format: 'dd/MM/yyyy HH:mm', width: 140 },
                { dataField: 'duration', caption: 'Duration', width: 80 },
                { dataField: 'day', caption: 'Day', width: 100 },
                { dataField: 'reason', caption: 'Reason', width: 150 },
                { dataField: 'remark', caption: 'Remark', width: 150 },
                {
                    caption: 'Status', width: 80, alignment: 'center',
                    allowFiltering: false, allowSorting: false,
                    cellTemplate: function (container, options) {
                        const row = options.data;
                        let statusText = row.isApproved ? 'Approved' : row.isRejected ? 'Rejected' : row.isPending ? 'Pending' : '';
                        $('<div>').text(statusText).appendTo(container);
                    }
                },
                {
                    dataField: 'updatedBy', caption: 'Approved By', width: 150,
                    calculateCellValue: function (r) { return r.updatedBy || '-'; }
                },
                {
                    dataField: 'updatedDate', caption: 'Approved Date', dataType: 'date', format: 'dd/MM/yyyy', width: 120,
                    calculateCellValue: function (r) {
                        if (!r.updatedDate) return '-';
                        const d = new Date(r.updatedDate);
                        return String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + d.getFullYear();
                    }
                }
            ]
        });

        $('#emp_actionButtons').show();
    }

    $('#emp_btnGo').on('click', function () {
        const model = {
            SearchBy: getSearchByText($('#emp_searchby').val()),
            SearchValue: $('#emp_searchfor').val(),
            FromDate: $('#emp_fromdate').val() || null,
            ToDate: $('#emp_todate').val() || null,
            Status: emp_getStatus(),
            LoggedInUserId: EmployeeId
        };

        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/GetAttendanceRegularizationApproval',
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json',
            success: function (res) {
                if (res.isSuccess && res.data && res.data.length > 0) {
                    emp_loadGrid(res.data);
                } else {
                    $('#emp_actionButtons').hide();
                    $('#emp_gridHeading').hide();
                    safeDisposeGrid('attendanceGrid');
                    round_error_noti(res.responseMessage || 'No Data Found');
                }
            },
            error: function (xhr, status, error) {
                $('#emp_actionButtons').hide();
                $('#emp_gridHeading').hide();
                safeDisposeGrid('attendanceGrid');
                round_error_noti('Error loading data: ' + error);
            }
        });
    });

    $('#emp_btnClear').click(function () {
        $('#emp_searchby').val('1');
        $('#emp_searchfor').val('');
        $('#emp_fromdate').val('');
        $('#emp_todate').val('');
        $("input[name='emp_type']").prop('checked', false);
        $('#emp_r2').prop('checked', true);
        safeDisposeGrid('attendanceGrid');
        $('#emp_actionButtons').hide();
        $('#emp_gridHeading').hide();
    });

    $('#emp_btnDelete').on('click', function () {
        var grid = $('#attendanceGrid').dxDataGrid('instance');
        var selectedRows = grid.getSelectedRowsData();
        if (selectedRows.length === 0) { round_error_noti('Please select at least one record.'); return; }
        if (selectedRows.some(r => r.isApproved)) { Swal.fire({ title:'Not Allowed', text:'Approved records cannot be deleted.', icon:'error' }); return; }
        if (selectedRows.some(r => r.isRejected)) { Swal.fire({ title:'Not Allowed', text:'Rejected records cannot be deleted.', icon:'error' }); return; }

        emp_showLoader();
        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/Delete',
            type: 'DELETE',
            contentType: 'application/json',
            data: JSON.stringify({ Id: selectedRows.map(r => r.attendanceRegularizationId), DeletedBy: EmployeeId }),
            success: function (res) {
                if (res.isSuccess) { round_success_noti(res.responseMessage || 'Deleted successfully.'); $('#emp_btnGo').click(); }
                else { round_error_noti(res.responseMessage || 'Deletion failed.'); }
            },
            error: function () { round_error_noti('Something went wrong during deletion.'); },
            complete: function () { emp_hideLoader(); }
        });
    });

    $('#emp_btnApprove').click(function () { emp_updateStatus('Approved'); });
    $('#emp_btnReject').click(function () { emp_updateStatus('Rejected'); });

    function emp_updateStatus(status) {
        var grid = $('#attendanceGrid').dxDataGrid('instance');
        var selectedRows = grid.getSelectedRowsData();
        if (selectedRows.length === 0) { round_error_noti('Please select at least one record.'); return; }
        if (status === 'Approved' && selectedRows.some(r => r.isApproved)) { Swal.fire({ title:'Not Allowed', text:'Already Approved.', icon:'error' }); return; }
        if (status === 'Rejected' && selectedRows.some(r => r.isApproved)) { Swal.fire({ title:'Not Allowed', text:'Approved records cannot be rejected.', icon:'error' }); return; }
        if (status === 'Rejected' && selectedRows.some(r => r.isRejected)) { Swal.fire({ title:'Not Allowed', text:'Already Rejected.', icon:'error' }); return; }

        selectedRows.forEach(r => { r.status = status; r.createdBy = EmployeeId; });
        emp_showLoader();
        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/UpdateAttendanceRegularization',
            type: 'PUT',
            data: JSON.stringify(selectedRows),
            contentType: 'application/json',
            success: function (res) {
                emp_hideLoader();
                if (res.isSuccess) { round_success_noti(res.responseMessage || 'Status updated.'); $('#emp_btnGo').click(); }
                else { round_error_noti(res.responseMessage || 'Update failed.'); }
            },
            error: function () { emp_hideLoader(); round_error_noti('Something went wrong during update.'); }
        });
    }


    /* ══════════════════════════════════════
       TAB 2 — HRD APPROVAL
       ══════════════════════════════════════ */

    let hrd_selectedKeys = [];

    function hrd_getStatus() {
        if ($('#hrd_r2').is(':checked')) return 'Pending';
        if ($('#hrd_r4').is(':checked')) return 'Rejected';
        return null;
    }

    function hrd_showLoader() { $('#hrd_loader').addClass('d-flex').show(); }
    function hrd_hideLoader() { $('#hrd_loader').removeClass('d-flex').hide(); }

    function hrd_loadGrid(data) {
        safeDisposeGrid('hrdGrid');

        if (!data || data.length === 0) {
            $('#hrd_actionButtons').hide();
            $('#hrd_gridHeading').hide();
            return;
        }

        $('#hrd_gridHeading').show();

        $('#hrdGrid').dxDataGrid({
            dataSource: data,
            keyExpr: 'attendanceRegularizationId',
            showBorders: true,
            width: '100%',
            height: 400,
            columnAutoWidth: true,
            paging: { enabled: false },
            scrolling: { mode: 'standard', useNative: true, showScrollbar: 'always' },
            selection: { mode: 'multiple', showCheckBoxesMode: 'always' },
            filterRow: { visible: false },
            searchPanel: { visible: false },
            onSelectionChanged: function (e) { hrd_selectedKeys = e.selectedRowKeys; },
            columns: [
                { dataField: 'employeeCode', caption: 'Code', width: 80 },
                { dataField: 'empId', visible: false },
                { dataField: 'fullName', caption: 'Name', width: 250 },
                { dataField: 'forDate', caption: 'Date', dataType: 'date', format: 'dd/MM/yyyy', width: 100 },
                { dataField: 'createdDate', caption: 'App Date', dataType: 'date', format: 'dd/MM/yyyy', width: 100 },
                { dataField: 'inTime', caption: 'In Time', dataType: 'datetime', format: 'dd/MM/yyyy HH:mm', width: 140 },
                { dataField: 'outTime', caption: 'Out Time', dataType: 'datetime', format: 'dd/MM/yyyy HH:mm', width: 140 },
                { dataField: 'duration', caption: 'Duration', width: 80 },
                { dataField: 'day', caption: 'Day', width: 100 },
                { dataField: 'reason', caption: 'Reason', width: 150 },
                { dataField: 'remark', caption: 'Remark', width: 150 },
                {
                    caption: 'Status', width: 80, alignment: 'center',
                    allowFiltering: false, allowSorting: false,
                    cellTemplate: function (container, options) {
                        const row = options.data;
                        let statusText = row.isApproved ? 'Approved' : row.isRejected ? 'Rejected' : row.isPending ? 'Pending' : '';
                        $('<div>').text(statusText).appendTo(container);
                    }
                },
                {
                    dataField: 'updatedBy', caption: 'Approved By', width: 150,
                    calculateCellValue: function (r) { return r.updatedBy || '-'; }
                },
                {
                    dataField: 'updatedDate', caption: 'Approved Date', dataType: 'date', format: 'dd/MM/yyyy', width: 120,
                    calculateCellValue: function (r) {
                        if (!r.updatedDate) return '-';
                        const d = new Date(r.updatedDate);
                        return String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + d.getFullYear();
                    }
                }
            ]
        });

        $('#hrd_actionButtons').show();
    }

    $('#hrd_btnGo').on('click', function () {
        const model = {
            SearchBy: getSearchByText($('#hrd_searchby').val()),
            SearchValue: $('#hrd_searchfor').val(),
            FromDate: $('#hrd_fromdate').val() || null,
            ToDate: $('#hrd_todate').val() || null,
            Status: hrd_getStatus(),
            LoggedInUserId: EmployeeId
        };

        $.ajax({
            // ── Replace this with your actual HRD API endpoint ──
            url: apiBase + '/AttendanceRegularizationAPI/GetHRDAttendanceApproval',
            type: 'POST',
            data: JSON.stringify(model),
            contentType: 'application/json',
            success: function (res) {
                if (res.isSuccess && res.data && res.data.length > 0) {
                    hrd_loadGrid(res.data);
                } else {
                    $('#hrd_actionButtons').hide();
                    $('#hrd_gridHeading').hide();
                    safeDisposeGrid('hrdGrid');
                    round_error_noti(res.responseMessage || 'No Data Found');
                }
            },
            error: function (xhr, status, error) {
                $('#hrd_actionButtons').hide();
                $('#hrd_gridHeading').hide();
                safeDisposeGrid('hrdGrid');
                round_error_noti('Error loading data: ' + error);
            }
        });
    });

    $('#hrd_btnClear').click(function () {
        $('#hrd_searchby').val('1');
        $('#hrd_searchfor').val('');
        $('#hrd_fromdate').val('');
        $('#hrd_todate').val('');
        $("input[name='hrd_type']").prop('checked', false);
        $('#hrd_r2').prop('checked', true);
        safeDisposeGrid('hrdGrid');
        $('#hrd_actionButtons').hide();
        $('#hrd_gridHeading').hide();
    });

    $('#hrd_btnProceed').on('click', function () {
        hrd_updateStatus('ProceedToHRD');
    });

    $('#hrd_btnReject').on('click', function () {
        hrd_updateStatus('Rejected');
    });

    function hrd_updateStatus(status) {
        var grid = $('#hrdGrid').dxDataGrid('instance');
        var selectedRows = grid.getSelectedRowsData();
        if (selectedRows.length === 0) { round_error_noti('Please select at least one record.'); return; }

        if (status === 'ProceedToHRD' && selectedRows.some(r => r.isApproved)) {
            Swal.fire({ title: 'Not Allowed', text: 'Already Approved records cannot be proceeded.', icon: 'error' });
            return;
        }
        if (status === 'Rejected' && selectedRows.some(r => r.isRejected)) {
            Swal.fire({ title: 'Not Allowed', text: 'Already Rejected.', icon: 'error' });
            return;
        }
        if (status === 'Rejected' && selectedRows.some(r => r.isApproved)) {
            Swal.fire({ title: 'Not Allowed', text: 'Approved records cannot be rejected.', icon: 'error' });
            return;
        }

        selectedRows.forEach(r => { r.status = status; r.createdBy = EmployeeId; });
        hrd_showLoader();
        $.ajax({
            // ── Replace this with your actual HRD update API endpoint ──
            url: apiBase + '/AttendanceRegularizationAPI/UpdateHRDAttendanceRegularization',
            type: 'PUT',
            data: JSON.stringify(selectedRows),
            contentType: 'application/json',
            success: function (res) {
                hrd_hideLoader();
                if (res.isSuccess) { round_success_noti(res.responseMessage || 'Status updated.'); $('#hrd_btnGo').click(); }
                else { round_error_noti(res.responseMessage || 'Update failed.'); }
            },
            error: function () { hrd_hideLoader(); round_error_noti('Something went wrong during update.'); }
        });
    }


    $(document).ready(function () {
        $('#emp_r2').prop('checked', true);
        $('#hrd_r2').prop('checked', true);
        $('#emp_btnGo').click();
    });

    $(window).on('resize', function () {
        ['attendanceGrid', 'hrdGrid'].forEach(function (id) {
            var gi = $('#' + id).data('dxDataGrid');
            if (gi) setTimeout(function () { gi.updateDimensions(); }, 100);
        });
    });
</script>
