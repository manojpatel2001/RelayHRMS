@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Attendance Request";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string apiBase = ViewBag.BaseUrlAPI;
    int? requestId = ViewBag.RequestId;
}

<title>Attendance Request</title>

<style>
    /* ── Status bar: submit action + monthly limit balance ─────────── */
    .ar-statusbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid var(--border, #D0DCE8);
        border-radius: 8px;
        padding: 8px 16px;
        margin-bottom: 12px;
    }

    .ar-limit-info {
        font-size: 12.5px;
        font-weight: 600;
        color: #3B5068;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ar-limit-badge {
        font-size: 12.5px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        background: #E1ECF4;
        color: #2F6F8E;
    }

    .ar-limit-badge.warn {
        background: #FFF3E0;
        color: #E65100;
    }

    .ar-limit-badge.exceeded {
        background: #FFEBEE;
        color: #C62828;
    }

    /* ── Three-column readonly-style info grid ─────────────────────── */
    .ar-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0 32px;
    }

    .ar-field {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 12px;
    }

    .ar-field label {
        font-size: 12.5px;
        font-weight: 600;
        color: #3B5068;
    }

    .ar-field .ar-static {
        font-size: 13.5px;
        color: var(--text, #1A1A1A);
        padding: 6px 0;
    }

    .ar-field input, .ar-field select, .ar-field textarea {
        border: 1px solid #B8C4CC;
        border-radius: var(--r-sm, 6px);
        padding: 6px 10px;
        font-size: 13.5px;
        font-family: inherit;
    }

    .ar-field textarea { resize: vertical; min-height: 54px; }

    .ar-radio-row { display: flex; gap: 18px; padding: 4px 0; }
    .ar-radio-row label { font-size: 13.5px; font-weight: 400; color: var(--text, #1A1A1A); display: flex; align-items: center; gap: 6px; }

    @@media (max-width: 1200px) {
        .ar-info-grid { grid-template-columns: 1fr 1fr; }
    }

    @@media (max-width: 700px) {
        .ar-info-grid { grid-template-columns: 1fr; }
    }

    /* ── Attendance Records grid — Type / Check In / Check Out cells ── */
    .att-req-daytype, .att-req-checkin, .att-req-checkout {
        width: 100%;
        min-width: 110px;
        padding: 5px 6px;
        font-size: 12px;
        line-height: 1.4;
        border: 1px solid #CBD5E1;
        border-radius: 5px;
        font-family: inherit;
        color: var(--wg-text, #1A1A1A);
        background: #fff;
        box-sizing: border-box;
    }

    .att-req-daytype:focus, .att-req-checkin:focus, .att-req-checkout:focus {
        outline: none;
        border-color: #2F6F8E;
        box-shadow: 0 0 0 2px rgba(47, 111, 142, 0.15);
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Attendance Request</h6>
            <a href="@Url.Action("Attendance", "Leave", new { area = "EmployeePanel" })" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1">
                <i class="bx bx-arrow-back"></i> Back
            </a>
        </div>
        <div class="card-body">

            <div class="ar-statusbar">
                <div>
                    <button type="button" class="btn btn-primary btn-sm" id="btnSendToApprove" style="display:none;">Send to approve</button>
                </div>
                <div class="ar-limit-info">
                    Monthly Attendance Request Limit:
                    <span class="ar-limit-badge" id="txtLimitBalance">-</span>
                </div>
            </div>

            <div class="ar-info-grid">
                <div>
                    <div class="ar-field">
                        <label>Employee:</label>
                        <div class="ar-static" id="txtEmployeeName">-</div>
                    </div>

                    <div class="ar-field">
                        <label>Request Type:</label>
                        <div class="ar-radio-row">
                            <label><input type="radio" name="requestType" id="rtCreate" value="Create" checked> Create Attendance</label>
                            <label><input type="radio" name="requestType" id="rtUpdate" value="Update"> Update Existing Attendance</label>
                        </div>
                    </div>

                    <div class="ar-field">
                        <label for="dtAttendanceDate">Date of Attendance:</label>
                        <input type="date" id="dtAttendanceDate" max="@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")">
                        <span class="field-validation-error" id="spnDate" style="display:none;color:#C62828;font-size:12px;">Please select a date</span>
                        <span class="field-validation-error" id="spnDateFuture" style="display:none;color:#C62828;font-size:12px;">Today's date and future dates are not allowed</span>
                        <span class="field-validation-error" id="spnDateBeforeJoining" style="display:none;color:#C62828;font-size:12px;"></span>
                        <span class="field-validation-error" id="spnDateDuplicate" style="display:none;color:#C62828;font-size:12px;"></span>
                    </div>
                </div>

                <div>
                    <div class="ar-field">
                        <label>Company:</label>
                        <div class="ar-static" id="txtCompanyName">-</div>
                    </div>

                    <div class="ar-field">
                        <label for="ddlReason">Reason:</label>
                        <select id="ddlReason">
                            <option value="">-- Select Reason --</option>
                        </select>
                        <span class="field-validation-error" id="spnReason" style="display:none;color:#C62828;font-size:12px;">Please select a reason</span>
                    </div>

                    <div class="ar-field">
                        <label for="txtRemark">Remark:</label>
                        <textarea id="txtRemark" placeholder="Additional details (optional)"></textarea>
                    </div>
                </div>

                <div>
                    <div class="ar-field">
                        <label>Employee Code:</label>
                        <div class="ar-static" id="txtEmployeeCode">-</div>
                    </div>

                    <div class="ar-field">
                        <label>Work Location:</label>
                        <div class="ar-static" id="txtWorkLocation">-</div>
                    </div>

                    <div class="ar-field">
                        <label>Reporting Manager:</label>
                        <div class="ar-static" id="txtReportingManager">-</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h6 class="mb-0">Attendance Records</h6>
        </div>
        <div class="card-body">
            <div id="gridContainerAttendanceRecords"></div>
        </div>
    </div>

</div>

<script>
    const apiBase = '@apiBase';
    const requestId = @(requestId.HasValue ? requestId.Value.ToString() : "null");
    const Empid = parseInt(localStorage.getItem("EmployeeId"));
    const EmployeeName = localStorage.getItem("EmployeeName");
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compid = parseInt(companyDetails.CompanyId);
    const CompanyName = companyDetails.CompanyName || '';
    const Token = localStorage.getItem('authToken');

    var approvalReasons = [];
    var recordsGrid = null;
    var dayType = 'Full Day';
    var lookedUpShift = { shiftTime: '', attendanceStatus: '' };
    var isSubmitting = false;
    var viewOnly = false;
    var limitedReasonIds = [];
    var unlimitedReasonIds = [];
    var existingRequestId = null;
    var employeeJoiningDate = null;

    function loadReasonConfiguration() {
        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/GetAttendanceReasonsByLimitType',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                if (response.isSuccess && response.data && response.data.length > 0) {
                    limitedReasonIds = response.data.filter(function (r) { return r.reasonType === 'Limited'; }).map(function (r) { return r.reasonId.toString(); });
                    unlimitedReasonIds = response.data.filter(function (r) { return r.reasonType === 'Unlimited'; }).map(function (r) { return r.reasonId.toString(); });
                } else {
                    limitedReasonIds = [];
                    unlimitedReasonIds = [];
                }
            },
            error: function () { limitedReasonIds = []; unlimitedReasonIds = []; }
        });
    }

    /* Attendance Limit lives on the Employee Master page (AdditionalInformation.cshtml,
       "Attendance Limit" field) and is only enforced for reasons tagged "Limited" —
       Unlimited reasons (e.g. Working from Home) bypass this check entirely, matching
       the existing bulk Add Attendance tool's validateAttendanceRequestLimit logic. */
    async function validateAttendanceRequestLimit(reasonId, forDate) {
        if (limitedReasonIds.length === 0 && unlimitedReasonIds.length === 0) {
            await new Promise(function (resolve) { setTimeout(resolve, 1000); });
        }

        var reasonStr = (reasonId || '').toString();
        if (unlimitedReasonIds.includes(reasonStr)) return true;
        if (!limitedReasonIds.includes(reasonStr)) return true; // unconfigured reason — let backend decide

        var d = new Date(forDate);
        var month = d.getMonth() + 1;
        var year = d.getFullYear();

        try {
            var employeeDetails = await $.ajax({
                type: 'GET',
                url: apiBase + '/AttendanceRegularizationAPI/GetEmployeeDetails?EmpId=' + Empid,
                headers: { 'Authorization': 'Bearer ' + Token }
            });
            var currentMonthCount = await $.ajax({
                type: 'GET',
                url: apiBase + '/AttendanceRegularizationAPI/GetEmployeeAttendanceRequestsCountForCurrentMonth?EmpId=' + Empid + '&month=' + month + '&year=' + year,
                headers: { 'Authorization': 'Bearer ' + Token }
            });

            if (!employeeDetails?.isSuccess || !currentMonthCount?.isSuccess) {
                showToast('Unable to fetch your attendance limit details.', 'error');
                return false;
            }

            var monthlyLimit = employeeDetails.data?.[0]?.attendanceLimit || 0;
            var currentLimitedRequests = currentMonthCount.data?.[0]?.limitedRequestsCount || 0;

            if (monthlyLimit === 0) {
                showToast('No monthly attendance limit is set for your account. Please contact HR to configure it on your Employee Master record.', 'error');
                return false;
            }

            if (currentLimitedRequests + 1 > monthlyLimit) {
                showToast('Monthly attendance request limit exceeded. Limit: ' + monthlyLimit + ', already submitted: ' + currentLimitedRequests + '.', 'error');
                return false;
            }

            return true;
        } catch (e) {
            showToast('Unable to validate attendance limit. Please try again.', 'error');
            return false;
        }
    }

    function fmtDateTime(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        var day = String(d.getDate()).padStart(2, '0');
        var month = String(d.getMonth() + 1).padStart(2, '0');
        var hh = String(d.getHours()).padStart(2, '0');
        var mm = String(d.getMinutes()).padStart(2, '0');
        return day + '/' + month + '/' + d.getFullYear() + ' ' + hh + ':' + mm;
    }

    /* Shows how many "Limited"-reason attendance requests are left this month
       against the Attendance Limit configured on the Employee Master page.
       Defaults to the current calendar month; re-fetched for whichever
       month the selected Date of Attendance falls in, since that's the
       month the request would actually be counted against on submit. */
    function loadAttendanceLimitBalance(forDate) {
        var d = forDate ? new Date(forDate) : new Date();
        var month = d.getMonth() + 1;
        var year = d.getFullYear();

        $.when(
            $.ajax({ type: 'GET', url: apiBase + '/AttendanceRegularizationAPI/GetEmployeeDetails?EmpId=' + Empid, headers: { 'Authorization': 'Bearer ' + Token } }),
            $.ajax({ type: 'GET', url: apiBase + '/AttendanceRegularizationAPI/GetEmployeeAttendanceRequestsCountForCurrentMonth?EmpId=' + Empid + '&month=' + month + '&year=' + year, headers: { 'Authorization': 'Bearer ' + Token } })
        ).done(function (employeeDetailsResp, currentMonthCountResp) {
            var employeeDetails = employeeDetailsResp[0];
            var currentMonthCount = currentMonthCountResp[0];
            var $badge = $('#txtLimitBalance');

            if (!employeeDetails?.isSuccess || !currentMonthCount?.isSuccess) {
                $badge.text('Unavailable').removeClass('warn exceeded');
                return;
            }

            var monthlyLimit = employeeDetails.data?.[0]?.attendanceLimit || 0;
            var used = currentMonthCount.data?.[0]?.limitedRequestsCount || 0;

            if (monthlyLimit === 0) {
                $badge.text('Not configured').removeClass('warn exceeded');
                return;
            }

            var remaining = Math.max(0, monthlyLimit - used);
            $badge.text('Remaining: ' + remaining + ' / ' + monthlyLimit + ' (Used: ' + used + ')');
            $badge.removeClass('warn exceeded');
            if (remaining === 0) $badge.addClass('exceeded');
            else if (remaining <= Math.ceil(monthlyLimit * 0.2)) $badge.addClass('warn');
        }).fail(function () {
            $('#txtLimitBalance').text('Unavailable').removeClass('warn exceeded');
        });
    }

    // Today is blocked here too, so the ceiling is the end of yesterday
    // (23:59) — any moment on today's date or later compares greater than
    // that and gets rejected, not just moments after the current time.
    function maxAllowedDateTimeLocal() {
        var d = new Date();
        d.setDate(d.getDate() - 1);
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T23:59';
    }

    function renderRecordsGrid(row) {
        var data = [{
            type: dayType,
            checkIn: row && row.inTime ? row.inTime : null,
            checkOut: row && row.outTime ? row.outTime : null
        }];

        var maxDt = maxAllowedDateTimeLocal();

        var columns = [
            {
                header: 'Type', width: '160px',
                render: function () {
                    if (viewOnly) return dayType;
                    var opts = ['Full Day', 'First Half', 'Second Half'];
                    var html = '<select class="att-req-daytype" onchange="_onDayTypeChange(this)">';
                    opts.forEach(function (o) {
                        html += '<option value="' + o + '"' + (o === dayType ? ' selected' : '') + '>' + o + '</option>';
                    });
                    html += '</select>';
                    return html;
                }
            },
            {
                header: 'Check In', width: '220px',
                render: function (v, r) {
                    if (viewOnly) return fmtDateTime(r.checkIn);
                    return '<input type="datetime-local" class="att-req-checkin" max="' + maxDt + '" value="' + (r.checkIn ? toLocalInputValue(r.checkIn) : '') + '">';
                }
            },
            {
                header: 'Check Out', width: '220px',
                render: function (v, r) {
                    if (viewOnly) return fmtDateTime(r.checkOut);
                    return '<input type="datetime-local" class="att-req-checkout" max="' + maxDt + '" value="' + (r.checkOut ? toLocalInputValue(r.checkOut) : '') + '">';
                }
            }
        ];

        if (!recordsGrid) {
            recordsGrid = WMSGrid.create({
                container: 'gridContainerAttendanceRecords',
                title: 'Attendance Records',
                icon: 'bx-time-five',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false, search: false, toolbar: false }
            });
        } else {
            recordsGrid.setData(data);
        }
    }

    // The `max` attribute blocks the picker UI from future date/time, but a
    // manually-typed future value isn't reliably rejected by every browser —
    // enforce it here too, delegated since these inputs are re-created by the grid.
    $(document).on('change', '.att-req-checkin, .att-req-checkout', function () {
        var v = $(this).val();
        if (v && v > maxAllowedDateTimeLocal()) {
            $(this).val('');
            showToast("Today's date and future date/time are not allowed for Check In / Check Out.", 'warn');
        }
    });

    window._onDayTypeChange = function (sel) { dayType = sel.value; };

    function toLocalInputValue(v) {
        var d = new Date(v);
        if (isNaN(d.getTime())) return '';
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function loadReasons(selectedId) {
        $.ajax({
            url: apiBase + '/CommonReasonsAPI/GetcancellationReasons',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (response) {
                approvalReasons = (response.isSuccess && response.data) ? response.data : [];
                var $dd = $('#ddlReason');
                $dd.empty().append('<option value="">-- Select Reason --</option>');
                approvalReasons.forEach(function (r) {
                    $dd.append('<option value="' + r.reasonId + '">' + r.reason + '</option>');
                });
                if (selectedId) $dd.val(selectedId);
            },
            error: function () { approvalReasons = []; }
        });
    }

    function loadEmployeeProfile() {
        $('#txtEmployeeName').text(EmployeeName || '-');
        $('#txtCompanyName').text(CompanyName || '-');

        $.ajax({
            url: apiBase + '/EmployeeMasterAPI/GetEmployeeById/' + Empid,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess && res.data) {
                    $('#txtEmployeeCode').text(res.data.employeeCode || '-');
                    $('#txtWorkLocation').text(res.data.branchName || '-');
                    employeeJoiningDate = res.data.dateOfJoining ? new Date(res.data.dateOfJoining) : null;
                }
            }
        });

        $.ajax({
            url: apiBase + '/LeaveApplication/GetReportingperson?Empid=' + Empid,
            method: 'POST',
            dataType: 'json',
            success: function (response) {
                if (response.isSuccess && response.data) {
                    $('#txtReportingManager').text(response.data.fullName || '-');
                }
            }
        });
    }

    function lookupDayAttendance(dateStr) {
        var formData = new FormData();
        formData.append('EmpId', Empid);
        formData.append('StartDate', dateStr);
        formData.append('EndDate', dateStr);
        formData.append('RecordType', 'All');

        $.ajax({
            url: apiBase + '/EmployeeInOut/GetEmployeeInOutReport',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                var row = (response && response.isSuccess && response.data && response.data.length > 0) ? response.data[0] : null;
                lookedUpShift.shiftTime = row ? (row.shiftTime || '') : '';
                lookedUpShift.attendanceStatus = row ? (row.attendanceStatus || '') : '';
                renderRecordsGrid(row);
            },
            error: function () { renderRecordsGrid(null); }
        });
    }

    function lookupExistingRequest(dateStr) {
        existingRequestId = null;
        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/GetSelfServiceRequestByEmpAndDate?EmpId=' + Empid + '&ForDate=' + dateStr,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess && res.data) {
                    var d = res.data;
                    existingRequestId = d.attendanceRegularizationId;
                    dayType = d.day || 'Full Day';
                    lookedUpShift.shiftTime = d.shiftTime || '';
                    lookedUpShift.attendanceStatus = d.status || '';
                    loadReasons(d.reason);
                    $('#txtRemark').val(d.remark || '');
                    renderRecordsGrid({ inTime: d.inTime, outTime: d.outTime });
                } else {
                    renderRecordsGrid(null);
                    showToast(res.responseMessage || 'No existing attendance request found for this date. Use "Create Attendance" to add one.', 'error');
                }
            },
            error: function () {
                renderRecordsGrid(null);
                showToast('Unable to look up existing attendance request.', 'error');
            }
        });
    }

    /* Once a request is raised for a date, the employee shouldn't be able to keep
       raising more for the same date while it's still Pending or already Approved —
       only a Rejected request should be re-raiseable. Only applies to "Create
       Attendance" mode; "Update Existing Attendance" is specifically for editing
       that same still-open request, not a duplicate. */
    var createBlockedByExisting = false;

    function checkDuplicateRequestForCreate(dateStr) {
        createBlockedByExisting = false;
        $('#spnDateDuplicate').hide();

        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/GetSelfServiceRequestByEmpAndDate?EmpId=' + Empid + '&ForDate=' + dateStr,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess && res.data && !res.data.isRejected) {
                    createBlockedByExisting = true;
                    var statusLabel = res.data.isApproved ? 'already approved' : 'pending approval';
                    $('#spnDateDuplicate')
                        .text('An attendance request for this date is ' + statusLabel + '. Use "Update Existing Attendance" to modify it instead of raising a new one.')
                        .show();
                }
            }
            // No matching request (isSuccess:false) is the normal case — nothing to block.
        });
    }

    function handleDateChange(dateStr) {
        createBlockedByExisting = false;
        $('#spnDateDuplicate').hide();

        if ($('#rtUpdate').is(':checked')) {
            lookupExistingRequest(dateStr);
        } else {
            existingRequestId = null;
            checkDuplicateRequestForCreate(dateStr);
            lookupDayAttendance(dateStr);
        }
        loadAttendanceLimitBalance(dateStr);
    }

    // Today itself is blocked too (attendance requests are only for past days,
    // since today's punch may still be in progress) — so the latest allowed
    // date is yesterday, not today.
    function maxAllowedDateStr() {
        var d = new Date();
        d.setDate(d.getDate() - 1);
        var pad = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    // An employee can't have attendance before they even joined — dateVal
    // ("YYYY-MM-DD") is compared against the joining date fetched in
    // loadEmployeeProfile(). Returns false (and lets the caller proceed) if
    // the joining date hasn't loaded yet rather than blocking everything.
    function isBeforeJoiningDate(dateStr) {
        if (!employeeJoiningDate || isNaN(employeeJoiningDate.getTime())) return false;
        var d = new Date(dateStr);
        d.setHours(0, 0, 0, 0);
        var joining = new Date(employeeJoiningDate);
        joining.setHours(0, 0, 0, 0);
        return d < joining;
    }

    function joiningDateLabel() {
        return employeeJoiningDate ? employeeJoiningDate.toLocaleDateString('en-GB') : '';
    }

    $('#dtAttendanceDate').on('change', function () {
        var v = $(this).val();
        if (!v) return;

        // The `max` attribute blocks the calendar picker from future dates, but a
        // manually-typed future date isn't reliably rejected by every browser —
        // enforce it here too so both entry paths are actually blocked.
        if (v > maxAllowedDateStr()) {
            $(this).val('');
            $('#spnDateFuture').show();
            showToast("Today's date and future dates are not allowed for Date of Attendance.", 'warn');
            return;
        }

        if (isBeforeJoiningDate(v)) {
            $(this).val('');
            $('#spnDateBeforeJoining').text('Attendance requests are only allowed from your joining date, ' + joiningDateLabel() + '.').show();
            showToast('Attendance requests are only allowed from your joining date, ' + joiningDateLabel() + '.', 'warn');
            return;
        }

        $('#spnDate, #spnDateFuture, #spnDateBeforeJoining').hide();
        handleDateChange(v);
    });

    $('input[name="requestType"]').on('change', function () {
        var v = $('#dtAttendanceDate').val();
        if (v) handleDateChange(v);
    });

    function loadExistingRequest(id) {
        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/GetById/' + id,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (!res.isSuccess || !res.data) { showToast('Record not found.', 'error'); return; }
                var d = res.data;
                viewOnly = true;

                $('#dtAttendanceDate').val(d.forDate ? d.forDate.substring(0, 10) : '').prop('disabled', true);
                $('input[name="requestType"]').prop('disabled', true);
                $('#ddlReason').prop('disabled', true);
                $('#txtRemark').val(d.remark || '').prop('disabled', true);
                dayType = d.day || 'Full Day';

                loadReasons(d.reason);
                loadAttendanceLimitBalance(d.forDate);

                $('#btnSendToApprove').hide();

                renderRecordsGrid({ inTime: d.inTime, outTime: d.outTime });
            },
            error: function () { showToast('Unable to load the request.', 'error'); }
        });
    }

    $('#btnSendToApprove').on('click', async function () {
        if (isSubmitting) return;

        var isUpdateMode = $('#rtUpdate').is(':checked');
        var dateVal = $('#dtAttendanceDate').val();
        var reasonId = $('#ddlReason').val();
        var hasError = false;

        if (!dateVal) { $('#spnDate').show(); hasError = true; } else { $('#spnDate').hide(); }
        if (dateVal && dateVal > maxAllowedDateStr()) { $('#spnDateFuture').show(); hasError = true; } else { $('#spnDateFuture').hide(); }
        if (dateVal && isBeforeJoiningDate(dateVal)) {
            $('#spnDateBeforeJoining').text('Attendance requests are only allowed from your joining date, ' + joiningDateLabel() + '.').show();
            hasError = true;
        } else {
            $('#spnDateBeforeJoining').hide();
        }
        if (!reasonId) { $('#spnReason').show(); hasError = true; } else { $('#spnReason').hide(); }
        if (isUpdateMode && !existingRequestId) {
            showToast('No existing attendance request found for this date to update. Switch to "Create Attendance" instead.', 'error');
            hasError = true;
        }
        if (!isUpdateMode && createBlockedByExisting) {
            $('#spnDateDuplicate').show();
            showToast('A request for this date already exists and is not rejected. Use "Update Existing Attendance" instead of raising a new one.', 'error');
            hasError = true;
        }
        var maxDt = maxAllowedDateTimeLocal();
        if (($('.att-req-checkin').val() && $('.att-req-checkin').val() > maxDt) ||
            ($('.att-req-checkout').val() && $('.att-req-checkout').val() > maxDt)) {
            showToast("Today's date and future date/time are not allowed for Check In / Check Out.", 'warn');
            hasError = true;
        }
        if (hasError) return;

        isSubmitting = true;
        setBtnLoading('#btnSendToApprove', 'Send to approve');
        var isLimitValid = await validateAttendanceRequestLimit(reasonId, dateVal);
        if (!isLimitValid) {
            isSubmitting = false;
            setBtnNormal('#btnSendToApprove', 'Send to approve');
            return;
        }

        var checkInVal = $('.att-req-checkin').val();
        var checkOutVal = $('.att-req-checkout').val();

        // datetime-local gives "YYYY-MM-DDTHH:mm" in the browser's local wall-clock
        // time with no timezone info. Passing that through `new Date(...).toISOString()`
        // converts it to UTC (e.g. 09:00 IST -> "03:30:00.000Z"), but the rest of this
        // app — including the list page that displays these values — stores and reads
        // InTime/OutTime as naive local wall-clock strings with no UTC conversion at
        // all, so that conversion silently shifted times by the IST offset (-5:30) once
        // displayed back. Send the naive local value through unchanged instead.
        var toNaiveLocalIso = function (v) { return v ? (v.length === 16 ? v + ':00' : v) : null; };
        var inIso = toNaiveLocalIso(checkInVal);
        var outIso = toNaiveLocalIso(checkOutVal);

        var payload = [{
            AttendanceRegularizationId: isUpdateMode ? existingRequestId : 0,
            EmpId: Empid,
            FullName: EmployeeName || '',
            BranchName: $('#txtWorkLocation').text() || '',
            ForDate: dateVal,
            ShiftTime: lookedUpShift.shiftTime || '',
            InTime: inIso,
            OutTime: outIso,
            Day: dayType,
            Reason: reasonId.toString(),
            Remark: $('#txtRemark').val() || null,
            CreatedBy: Empid.toString(),
            UpdatedBy: Empid.toString()
        }];

        $.ajax({
            url: apiBase + '/AttendanceRegularizationAPI/' + (isUpdateMode ? 'UpdateAttendanceSelfServiceRequest' : 'CreateAttendanceSelfServiceRequest'),
            method: isUpdateMode ? 'PUT' : 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.isSuccess) {
                    showToast(res.responseMessage || 'Sent for approval.', 'success');
                    setTimeout(function () {
                        window.location.href = '@Url.Action("Attendance", "Leave", new { area = "EmployeePanel" })';
                    }, 900);
                } else {
                    showToast(res.responseMessage || 'Unable to submit request.', 'error');
                }
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.responseMessage) || 'Something went wrong.';
                showToast(msg, 'error');
            },
            complete: function () {
                isSubmitting = false;
                setBtnNormal('#btnSendToApprove', 'Send to approve');
            }
        });
    });

    $(document).ready(function () {
        loadEmployeeProfile();
        loadReasonConfiguration();

        if (requestId) {
            loadExistingRequest(requestId);
        } else {
            loadReasons();
            loadAttendanceLimitBalance();
            $('#btnSendToApprove').show();
            renderRecordsGrid(null);
        }

        // "Send to approve" submits either a create or an update depending on the
        // Request Type radio above it — hide it outright if the role has neither
        // permission, since a request with only View access shouldn't be able to
        // raise or edit attendance requests at all.
        PermGuard.onReady(function () {
            if (!PermGuard.has('create-ess-leave-attendance') && !PermGuard.has('edit-ess-leave-attendance')) {
                $('#btnSendToApprove').hide();
            }
        });
    });
</script>
