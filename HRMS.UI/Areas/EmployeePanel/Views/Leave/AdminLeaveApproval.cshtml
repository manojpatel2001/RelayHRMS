@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<title>Search Panel</title>
<link href="~/commoncss.css" rel="stylesheet" />

<!-- jQuery + SweetAlert -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.all.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #ffffff;
    }

    .form-section {
        padding: 15px;
        border: 1px solid #ccc;
        max-width: 100%;
    }

    /* ── Buttons ── */
    .btn-custom {
        background-color: #3e4b6d;
        color: white;
        font-weight: 600;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-custom:hover {
            background-color: #2c3a57;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
        font-weight: 600;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-delete:hover {
            background-color: #c82333;
        }

    /* ── Search panel header bar ── */
    .search-panel-container {
        background-color: #3e4b6d;
        padding: 6px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
    }

    /* ── Form controls ── */
    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .form-control-sm,
    .form-select-sm {
        height: calc(1.5em + .5rem + 2px);
        font-size: 0.875rem;
        padding: .25rem .5rem;
    }

    /* ── Grid cell alignment ── */
    .text-center-cell {
        text-align: center !important;
    }

        .text-center-cell > div {
            text-align: center !important;
        }

    /* ── Layout ── */
    .container {
        max-width: 100% !important;
        padding-left: 15px;
        padding-right: 15px;
    }

    .grid-container {
        width: 100%;
        overflow-x: auto;
    }

    /* ── Action buttons row (right-aligned) ── */
    .action-buttons-right {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        justify-content: flex-end;
        align-items: center;
        padding: 10px 0;
    }

    /* ── Radio button status filter ── */
    .status-filter-wrapper {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

        .status-filter-wrapper label {
            font-size: 13px;
            font-weight: 500;
            margin: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            color: #333;
        }

        .status-filter-wrapper input[type="radio"] {
            cursor: pointer;
            accent-color: #3e4b6d;
            width: 15px;
            height: 15px;
        }

    /* ── GO / Clear buttons (reuse panel style) ── */
    .btn-go-clear {
        background-color: #3e4b6d;
        color: white;
        font-size: 13px;
        font-weight: 600;
        padding: 5px 14px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-go-clear:hover {
            background-color: #2c3a57;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .action-buttons-right {
            flex-direction: row;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn-custom,
        .btn-delete,
        .btn-go-clear {
            padding: 6px 10px;
            font-size: 12px;
        }

        .status-filter-wrapper {
            gap: 10px;
        }
    }
</style>

<!-- ══════════════════════════════════════════
     SEARCH PANEL HEADER
════════════════════════════════════════════ -->
<div class="search-panel-wrapper">
    <div class="search-panel-container">
        <div class="search-panel-row">
            <div class="search-heading">Search Panel</div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════
     FORM SECTION
════════════════════════════════════════════ -->
<div class="form-section">

    <!-- Row 1 : Search By + Search For -->
    <div class="row justify-content-center mb-3">
        <div class="col-md-4 d-flex align-items-center">
            <label for="Leavetypeid" class="form-label me-2">Search By:</label>
            <select class="form-control form-control-sm" id="Leavetypeid">
                <option value="0">-- Select --</option>
                <option value="1">Employee Code</option>
                <option value="2">Employee Name</option>
                <option value="3">Leave Name</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <label for="input1" class="form-label me-2">Search For:</label>
            <input type="text" class="form-control form-control-sm" id="input1" disabled />
        </div>
    </div>

    <!-- Row 2 : By Branch + Radio Buttons + GO / Clear -->
    <div class="row justify-content-center mb-3">

        <div class="col-md-4 d-flex align-items-center">
            <label for="branchid" class="form-label me-2">By Branch:</label>
            <select class="form-control form-control-sm" id="branchid">
                <option value="0">-- Select --</option>
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-center flex-wrap gap-2">

            <!-- Status radio buttons -->
            <div class="status-filter-wrapper me-2">
                <label>
                    <input type="radio" name="leaveStatus" id="radioPending" value="Pending" checked />
                    Pending
                </label>
                <label>
                    <input type="radio" name="leaveStatus" id="radioApproved" value="Approved" />
                    Approved
                </label>
                <label>
                    <input type="radio" name="leaveStatus" id="radioRejected" value="Rejected" />
                    Rejected
                </label>
            </div>

            <!-- GO / Clear -->
            <button type="button" class="btn-go-clear" id="goButtonId">GO</button>
            <button type="button" class="btn-go-clear" id="clearButtonId">Clear</button>
        </div>
    </div>

    <!-- ── Admin Leave Approval sub-header ── -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">Admin Leave Approval</div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         GRID + ACTION BUTTONS
    ═══════════════════════════════════════ -->
    <div class="container-fluid mt-3">

        <!-- Action buttons – shown only when data loads -->
        <div class="action-buttons-right" id="actionButtons" style="display: none;">

            <!-- Delete (Approved / Rejected view) -->
            <button id="btnDelete" class="btn-delete" style="display:none;">
                <i class="fas fa-trash"></i> Delete
            </button>

            <!-- Approve / Reject (Pending view) -->
            <button id="btnApprove" class="btn-custom" value="Approved">
                <i class="fas fa-check"></i> Approve
            </button>
            <button id="btnReject" class="btn-custom" value="Rejected">
                <i class="fas fa-times"></i> Reject
            </button>
        </div>

        <!-- DevExtreme DataGrid -->
        <div class="grid-container">
            <div id="attendanceGrid">Loading...</div>
        </div>

        <div id="recordSummary" class="text-center mt-2 text-muted"></div>
    </div>
</div>


<!-- ══════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════ -->
<script>
    /* ── Globals ─────────────────────────────────── */
    let allData      = [];
    let selectedKeys = [];

    const Empid          = parseInt(localStorage.getItem("EmployeeId"));
    const savedCompany   = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compid         = parseInt(companyDetails.CompanyId);
    const Token          = localStorage.getItem("authToken");

    /* ── Helpers ─────────────────────────────────── */
    function getSelectedStatus() {
        return $('input[name="leaveStatus"]:checked').val() || 'Pending';
    }

    /* ── Document Ready ──────────────────────────── */
    $(document).ready(function () {

        loadLeaveApplications();
        GetBranch();

        /* Button events */
        $('#btnApprove').click(function () { updateLeaveStatus($(this).val()); });
        $('#btnReject').click(function ()  { updateLeaveStatus($(this).val()); });
        $('#btnDelete').click(function ()  { deleteLeaveApplications(); });

        /* GO / Clear */
        $('#goButtonId').click(function () { loadLeaveApplications(); });

        $('#clearButtonId').click(function () {
            $('#Leavetypeid').val('0');
            $('#input1').val('').prop('disabled', true);
            $('#branchid').val('0');
            $('#radioPending').prop('checked', true);   // reset to Pending
            $('#attendanceGrid').html('');
            $('#recordSummary').text('');
            $('#actionButtons').hide();
            loadLeaveApplications();
        });

        /* Enable / disable text input based on search-by selection */
        $('#Leavetypeid').change(function () {
            $('#input1').prop('disabled', $(this).val() === '0');
        });

        /* Auto-reload when radio changes */
        $('input[name="leaveStatus"]').change(function () {
            loadLeaveApplications();
        });
    });

    /* ── Load Leave Applications ─────────────────── */
    function loadLeaveApplications() {
        $('#actionButtons').hide();

        // Dispose existing grid
        if ($("#attendanceGrid").data("dxDataGrid")) {
            $("#attendanceGrid").dxDataGrid("dispose");
            $("#attendanceGrid").empty();
        }

        const searchTypeValue  = $('#Leavetypeid').val();
        const searchFor        = $('#input1').val().trim();
        const branchId         = $('#branchid').val();
        const selectedStatus   = getSelectedStatus();   // ← Pending / Approved / Rejected

        let searchTypeText = '';
        if (searchTypeValue == '1') searchTypeText = 'Employee Code';
        else if (searchTypeValue == '2') searchTypeText = 'Employee Name';
        else if (searchTypeValue == '3') searchTypeText = 'Leave Name';

        const payload = {
            SearchType : searchTypeText,
            SearchFor  : searchFor,
            BranchId   : branchId,
            CompId     : Compid,
            Status     : selectedStatus          // ← sent to backend
        };

        $('#attendanceGrid').html('<div class="text-center">Loading...</div>');

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/GetLeaveApplicationsforApproveAdmin',
            type        : 'POST',
            contentType : 'application/json',
            data        : JSON.stringify(payload),
            success     : function (data) {
                if (data.isSuccess && data.data && data.data.length > 0) {
                    allData = data.data;
                    renderTable(allData);
                    $('#actionButtons').css('display', 'flex');
                } else {
                    $('#attendanceGrid').html('<div class="text-center text-muted">No records found.</div>');
                    $('#recordSummary').text('');
                    $('#actionButtons').hide();
                }
            },
            error : function () {
                $('#attendanceGrid').html('<div class="text-center text-danger">Error fetching data.</div>');
                $('#recordSummary').text('');
                $('#actionButtons').hide();
            }
        });
    }

    /* ── Render DevExtreme Grid ──────────────────── */
    function renderTable(data) {
        const selectedStatus = getSelectedStatus();

        // Show / hide buttons based on active status tab
       if (selectedStatus === 'Pending') {
        $('#btnApprove').show();
        $('#btnReject').show();
        $('#btnDelete').hide();
    } else if (selectedStatus === 'Rejected') {
        // ← sirf Rejected pe Delete dikhega
        $('#btnApprove').hide();
        $('#btnReject').hide();
        $('#btnDelete').show();
    } else {
        // Approved → koi bhi button nahi
        $('#btnApprove').hide();
        $('#btnReject').hide();
        $('#btnDelete').hide();
    }

        $("#attendanceGrid").dxDataGrid({
            dataSource      : data,
            keyExpr         : "leaveApplicationid",
            showBorders     : true,
            columnAutoWidth : true,
            width           : '100%',
            selection       : {
                mode                : "multiple",
                showCheckBoxesMode  : "always"
            },
            onSelectionChanged : function (e) {
                selectedKeys = e.selectedRowKeys;
                console.log("Selected items:", selectedKeys.length);
            },
            columns : [
                { dataField: "leaveApplicationId",   caption: "ApplicationId",     visible: false },
                { dataField: "leaveTypeName",         caption: "Leave Type",         cssClass: "text-center-cell", width: 120 },
                { dataField: "employeeName",          caption: "Employee Name",      cssClass: "text-center-cell", width: 150 },
                { dataField: "employeeCode",          caption: "Employee Code",      cssClass: "text-center-cell", width: 120 },
                { dataField: "branchName",            caption: "Branch Name",        cssClass: "text-center-cell", width: 120 },
                { dataField: "fromDate",              caption: "From Date",          dataType: "date", format: "dd/MM/yyyy", cssClass: "text-center-cell", width: 110 },
                { dataField: "todate",                caption: "To Date",            dataType: "date", format: "dd/MM/yyyy", cssClass: "text-center-cell", width: 110 },
                { dataField: "no_Of_Date",            caption: "Period",             cssClass: "text-center-cell", width:  80 },
                { dataField: "reason",                caption: "Reason",             cssClass: "text-center-cell", width: 150 },
                { dataField: "applicationType",       caption: "Application Type",   cssClass: "text-center-cell", width: 130 },
                { dataField: "reportingPersonName",   caption: "Reporting Person",   cssClass: "text-center-cell", width: 150 },
                { dataField: "leaveStatus",           caption: "Leave Status",       cssClass: "text-center-cell", width: 120 },
            ]
        });
    }

    /* ── Load Branches ───────────────────────────── */
    function GetBranch() {
        $.ajax({
            url     : '@(apiBase)/BranchAPI/GetAllBranchesListByCompanyId/' + Compid,
            type    : 'GET',
            headers : { 'Authorization': 'Bearer ' + Token },
            contentType : 'application/json',
            success : function (data) {
                if (data.isSuccess && data.data && data.data.length > 0) {
                    const $branchDropdown = $('#branchid');
                    $branchDropdown.empty().append('<option value="0">-- Select --</option>');
                    data.data.forEach(branch => {
                        $branchDropdown.append(
                            `<option value="${branch.branchId}">${branch.branchName}</option>`
                        );
                    });
                }
            },
            error : function () {
                console.error("Error loading branch data.");
            }
        });
    }

    /* ── Approve / Reject ────────────────────────── */
    function updateLeaveStatus(status) {
        if (selectedKeys.length === 0) {
            Swal.fire('Warning', 'Please select at least one application.', 'warning');
            return;
        }

        const payload = {
            Ids        : selectedKeys,
            Status     : status,
            EmployeeId : Empid
        };

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/LeaveapplicationApproveorReject',
            type        : 'POST',
            contentType : 'application/json',
            data        : JSON.stringify(payload),
            success     : function (res) {
                if (res.isSuccess) {
                    Swal.fire('Success', res.message, 'success');
                    selectedKeys = [];
                    loadLeaveApplications();
                } else {
                    Swal.fire('Error', res.message || 'Something went wrong.', 'error');
                }
            },
            error : function () {
                Swal.fire('Error', 'Failed to update status.', 'error');
            }
        });
    }

      function deleteLeaveApplications() {
        if (selectedKeys.length === 0) {
            Swal.fire('Warning', 'Please select at least one application to delete.', 'warning');
            return;
        }

        // ── Validation: Approved records delete nahi honge ──
        const selectedRows = allData.filter(row => selectedKeys.includes(row.leaveApplicationid));
        const approvedRows = selectedRows.filter(row => row.leaveStatus === 'Approved');

        if (approvedRows.length > 0) {
            Swal.fire('Not Allowed', 'Approved applications cannot be deleted.', 'warning');
            return;
        }

        const payload = {
            Id        : selectedKeys,
            DeletedBy : String(Empid)
        };

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/Delete',
            type        : 'DELETE',
            contentType : 'application/json',
            data        : JSON.stringify(payload),
            success     : function (res) {
                if (res.isSuccess) {
                    Swal.fire('Deleted!', res.message || 'Applications deleted successfully.', 'success');
                    selectedKeys = [];
                    loadLeaveApplications();
                } else {
                    Swal.fire('Error', res.message || 'Something went wrong.', 'error');
                }
            },
            error : function (xhr) {
                console.log(xhr.responseText);
                Swal.fire('Error', 'Failed to delete applications.', 'error');
            }
        });
    }
</script>
