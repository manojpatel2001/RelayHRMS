@{
    ViewData["Title"] = "Admin Leave Approval";
    Layout = "~/Areas/AdminPanel/Views/Shared/_AdminLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<title>Admin Leave Approval</title>
<link href="~/commoncss.css" rel="stylesheet" />

<!-- ✅ jQuery + SweetAlert + ExcelJS + FileSaver -->
<!-- ❌ xlsx.full.min.js (SheetJS) is REMOVED — was conflicting with ExcelJS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #ffffff;
    }

    /* ── Panel Header ── */
    .search-panel-container {
        background-color: #3e4b6d;
        padding: 6px 15px;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .search-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .search-heading {
        font-size: 15px;
        color: white;
        margin: 0;
        font-weight: 600;
    }

    /* ── Form Section ── */
    .form-section {
        padding: 15px;
        border: 1px solid #ccc;
        max-width: 100%;
    }

    .form-label {
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    .form-control-sm,
    .form-select-sm {
        height: calc(1.5em + .5rem + 2px);
        font-size: 0.875rem;
        padding: .25rem .5rem;
    }

    /* ── Buttons ── */
    .btn-custom {
        background-color: #3e4b6d;
        color: white;
        font-weight: 600;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-custom:hover {
            background-color: #2c3a57;
        }

    .btn-delete {
        background-color: #dc3545;
        color: white;
        font-weight: 600;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-delete:hover {
            background-color: #c82333;
        }

    .btn-excel {
        background-color: #1e7e34;
        color: white;
        font-weight: 600;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn-excel:hover {
            background-color: #155724;
        }

    .btn-go-clear {
        background-color: #3e4b6d;
        color: white;
        font-size: 13px;
        font-weight: 600;
        padding: 5px 14px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-go-clear:hover {
            background-color: #2c3a57;
        }

    /* ── Status Radio Buttons ── */
    .status-filter-wrapper {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

        .status-filter-wrapper label {
            font-size: 13px;
            font-weight: 500;
            margin: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            color: #333;
        }

        .status-filter-wrapper input[type="radio"] {
            cursor: pointer;
            accent-color: #3e4b6d;
            width: 15px;
            height: 15px;
        }

    /* ── Action Buttons Row ── */
    .action-buttons-right {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        justify-content: flex-end;
        align-items: center;
        padding: 10px 0;
        flex-wrap: wrap;
    }

    /* ── Grid ── */
    .container {
        max-width: 100% !important;
        padding-left: 15px;
        padding-right: 15px;
    }

    .grid-container {
        width: 100%;
        overflow-x: auto;
    }

    .text-center-cell {
        text-align: center !important;
    }

        .text-center-cell > div {
            text-align: center !important;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .action-buttons-right {
            justify-content: flex-end;
            gap: 8px;
        }

        .btn-custom,
        .btn-delete,
        .btn-go-clear,
        .btn-excel {
            padding: 6px 10px;
            font-size: 12px;
        }

        .status-filter-wrapper {
            gap: 10px;
        }
    }
</style>

<!-- ══════════════════════════════════════════
     SEARCH PANEL HEADER
════════════════════════════════════════════ -->
<div class="search-panel-wrapper">
    <div class="search-panel-container">
        <div class="search-panel-row">
            <div class="search-heading">Search Panel</div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════
     FORM SECTION
════════════════════════════════════════════ -->
<div class="form-section">

    <!-- Row 1 : Search By + Search For -->
    <div class="row justify-content-center mb-3">
        <div class="col-md-4 d-flex align-items-center">
            <label for="Leavetypeid" class="form-label me-2">Search By:</label>
            <select class="form-control form-control-sm" id="Leavetypeid">
                <option value="0">-- Select --</option>
                <option value="1">Employee Code</option>
                <option value="2">Employee Name</option>
                <option value="3">Leave Name</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-center">
            <label for="input1" class="form-label me-2">Search For:</label>
            <input type="text" class="form-control form-control-sm" id="input1" disabled />
        </div>
    </div>

    <!-- Row 2 : By Branch + Radio Buttons + GO / Clear -->
    <div class="row justify-content-center mb-3">

        <div class="col-md-4 d-flex align-items-center">
            <label for="branchid" class="form-label me-2">By Branch:</label>
            <select class="form-control form-control-sm" id="branchid">
                <option value="0">-- Select --</option>
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-center flex-wrap gap-2">

            <!-- Status radio buttons -->
            <div class="status-filter-wrapper me-2">
                <label>
                    <input type="radio" name="leaveStatus" id="radioPending" value="Pending" checked />
                    Pending
                </label>
                <label>
                    <input type="radio" name="leaveStatus" id="radioApproved" value="Approved" />
                    Approved
                </label>
                <label>
                    <input type="radio" name="leaveStatus" id="radioRejected" value="Rejected" />
                    Rejected
                </label>
            </div>

            <!-- GO / Clear -->
            <button type="button" class="btn-go-clear" id="goButtonId">GO</button>
            <button type="button" class="btn-go-clear" id="clearButtonId">Clear</button>
        </div>
    </div>

    <!-- ── Admin Leave Approval sub-header ── -->
    <div class="search-panel-wrapper">
        <div class="search-panel-container">
            <div class="search-panel-row">
                <div class="search-heading">Admin Leave Approval</div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════
         GRID + ACTION BUTTONS
    ═══════════════════════════════════════ -->
    <div class="container-fluid mt-3">

        <!-- Action buttons – shown only when data loads -->
        <div class="action-buttons-right" id="actionButtons" style="display: none;">

            <!-- Export to Excel
                 onclick calls exportLeaveToExcel() — a unique name that
                 cannot be overwritten by any shared export-data.js -->
            <button id="btnExportExcel" class="btn-excel" onclick="exportLeaveToExcel()">
                <i class="fas fa-file-excel"></i> Export to Excel
            </button>

            <!-- Delete – shown on Approved + Rejected -->
            <button id="btnDelete" class="btn-delete" style="display:none;">
                <i class="fas fa-trash"></i> Delete
            </button>

            <!-- Approve / Reject – shown on Pending only -->
            <button id="btnApprove" class="btn-custom" value="Approved" style="display:none;">
                <i class="fas fa-check"></i> Approve
            </button>
            <button id="btnReject" class="btn-custom" value="Rejected" style="display:none;">
                <i class="fas fa-times"></i> Reject
            </button>
        </div>

        <!-- DevExtreme DataGrid -->
        <div class="grid-container">
            <div id="attendanceGrid">Loading...</div>
        </div>

        <div id="recordSummary" class="text-center mt-2 text-muted"></div>
    </div>
</div>


<!-- ══════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════ -->
<script>
    /* ── Globals ─────────────────────────────────── */
    var allData      = [];
    var selectedKeys = [];

    var Empid          = parseInt(localStorage.getItem("EmployeeId"));
    var savedCompany   = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany || '{}');
    var Compid         = parseInt(companyDetails.CompanyId);
    var Token          = localStorage.getItem("authToken");

    /* ── Helper: get selected radio value ───────── */
    function getSelectedStatus() {
        return $('input[name="leaveStatus"]:checked').val() || 'Pending';
    }

    /* ══════════════════════════════════════════════════════════
       exportLeaveToExcel()
       Unique name so shared export-data.js cannot overwrite it.
       Uses ExcelJS only — SheetJS (xlsx.full.min.js) removed.
    ══════════════════════════════════════════════════════════ */
    function exportLeaveToExcel() {
        var $grid = $("#attendanceGrid");

        if (!$grid.length || !$grid.data("dxDataGrid")) {
            Swal.fire('Warning', 'Grid not initialized.', 'warning');
            return;
        }

        var grid         = $grid.dxDataGrid("instance");
        var selectedRows = grid.getSelectedRowsData();

        /* If nothing selected → get all visible DATA rows safely */
        if (!selectedRows || selectedRows.length === 0) {
            selectedRows = grid.getVisibleRows()
                .filter(function (r) { return r && r.data && r.rowType === 'data'; })
                .map(function (r) { return r.data; });

            if (!selectedRows || selectedRows.length === 0) {
                Swal.fire('Warning', 'No data available to export.', 'warning');
                return;
            }
        }

        /* Safety check — ExcelJS must be loaded */
        if (typeof ExcelJS === 'undefined') {
            Swal.fire('Error', 'ExcelJS library not loaded. Please refresh the page.', 'error');
            return;
        }

        var workbook  = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet('Leave Applications');

        /* Column definitions */
        worksheet.columns = [
            { header: 'Leave Type',       key: 'leaveTypeName',        width: 18 },
            { header: 'Employee Name',     key: 'employeeName',         width: 25 },
            { header: 'Employee Code',     key: 'employeeCode',         width: 15 },
            { header: 'Branch Name',       key: 'branchName',           width: 18 },
            { header: 'From Date',         key: 'fromDate',             width: 14 },
            { header: 'To Date',           key: 'todate',               width: 14 },
            { header: 'Period',            key: 'no_Of_Date',           width: 10 },
            { header: 'Reason',            key: 'reason',               width: 25 },
            { header: 'Application Type',  key: 'applicationType',      width: 18 },
            { header: 'Reporting Person',  key: 'reportingPersonName',  width: 22 },
            { header: 'Leave Status',      key: 'leaveStatus',          width: 15 }
        ];

        /* Header row styling */
        var headerRow = worksheet.getRow(1);
        headerRow.eachCell(function (cell) {
            cell.font      = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
            cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF3E4B6D' } };
            cell.alignment = { vertical: 'middle', horizontal: 'center' };
            cell.border    = {
                top    : { style: 'thin' },
                left   : { style: 'thin' },
                bottom : { style: 'thin' },
                right  : { style: 'thin' }
            };
        });
        headerRow.height = 25;

        /* Helpers */
        function fmtDate(val) {
            if (!val) return '-';
            var d = new Date(val);
            if (isNaN(d.getTime())) return String(val);
            return String(d.getDate()).padStart(2, '0') + '/' +
                   String(d.getMonth() + 1).padStart(2, '0') + '/' +
                   d.getFullYear();
        }

        function safe(val) {
            return (val === null || val === undefined) ? '' : String(val);
        }

        /* Data rows */
        selectedRows.forEach(function (row) {
            if (!row) return;

            var dataRow = worksheet.addRow({
                leaveTypeName      : safe(row.leaveTypeName),
                employeeName       : safe(row.employeeName),
                employeeCode       : safe(row.employeeCode),
                branchName         : safe(row.branchName),
                fromDate           : fmtDate(row.fromDate),
                todate             : fmtDate(row.todate),
                no_Of_Date         : safe(row.no_Of_Date),
                reason             : safe(row.reason),
                applicationType    : safe(row.applicationType),
                reportingPersonName: safe(row.reportingPersonName),
                leaveStatus        : safe(row.leaveStatus)
            });

            dataRow.eachCell(function (cell) {
                cell.border = {
                    top    : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    left   : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    bottom : { style: 'thin', color: { argb: 'FFD3D3D3' } },
                    right  : { style: 'thin', color: { argb: 'FFD3D3D3' } }
                };
                cell.alignment = { horizontal: 'left', vertical: 'middle' };
            });
        });

        /* Build filename */
        var status   = getSelectedStatus();
        var today    = new Date();
        var dateStr  = String(today.getDate()).padStart(2, '0') + '-' +
                       String(today.getMonth() + 1).padStart(2, '0') + '-' +
                       today.getFullYear();
        var fileName = 'LeaveApplications_' + status + '_' + dateStr + '.xlsx';

        /* Download */
        workbook.xlsx.writeBuffer()
            .then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
                Swal.fire({
                    icon              : 'success',
                    title             : 'Exported!',
                    text              : selectedRows.length + ' record(s) exported successfully.',
                    timer             : 2000,
                    showConfirmButton : false
                });
            })
            .catch(function (err) {
                console.error('Export error:', err);
                Swal.fire('Error', 'Export failed: ' + err.message, 'error');
            });
    }

    /* ── Document Ready ──────────────────────────── */
    $(document).ready(function () {

        loadLeaveApplications();
        GetBranch();

        /* Approve / Reject / Delete */
        $('#btnApprove').click(function () { updateLeaveStatus($(this).val()); });
        $('#btnReject').click(function ()  { updateLeaveStatus($(this).val()); });
        $('#btnDelete').click(function ()  { deleteLeaveApplications(); });

        /* GO / Clear */
        $('#goButtonId').click(function () { loadLeaveApplications(); });

        $('#clearButtonId').click(function () {
            $('#Leavetypeid').val('0');
            $('#input1').val('').prop('disabled', true);
            $('#branchid').val('0');
            $('#radioPending').prop('checked', true);
            $('#attendanceGrid').html('');
            $('#recordSummary').text('');
            $('#actionButtons').hide();
            allData      = [];
            selectedKeys = [];
            loadLeaveApplications();
        });

        /* Enable / disable text input */
        $('#Leavetypeid').change(function () {
            $('#input1').prop('disabled', $(this).val() === '0');
        });

        /* Auto-reload when radio changes */
        $('input[name="leaveStatus"]').change(function () {
            loadLeaveApplications();
        });
    });

    /* ── Load Leave Applications ─────────────────── */
    function loadLeaveApplications() {
        $('#actionButtons').hide();
        selectedKeys = [];

        /* Dispose existing grid */
        if ($("#attendanceGrid").data("dxDataGrid")) {
            $("#attendanceGrid").dxDataGrid("dispose");
            $("#attendanceGrid").empty();
        }

        var searchTypeValue = $('#Leavetypeid').val();
        var searchFor       = $('#input1').val().trim();
        var branchId        = $('#branchid').val();
        var selectedStatus  = getSelectedStatus();

        var searchTypeText = '';
        if      (searchTypeValue == '1') searchTypeText = 'Employee Code';
        else if (searchTypeValue == '2') searchTypeText = 'Employee Name';
        else if (searchTypeValue == '3') searchTypeText = 'Leave Name';

        var payload = {
            SearchType : searchTypeText,
            SearchFor  : searchFor,
            BranchId   : branchId,
            CompId     : Compid,
            Status     : selectedStatus
        };

        $('#attendanceGrid').html('<div class="text-center">Loading...</div>');

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/GetLeaveApplicationsforApproveAdmin',
            type        : 'POST',
            contentType : 'application/json',
            data        : JSON.stringify(payload),
            success     : function (data) {
                if (data.isSuccess && data.data && data.data.length > 0) {
                    allData = data.data;
                    renderTable(allData);
                    $('#actionButtons').css('display', 'flex');
                    $('#recordSummary').text('Total Records: ' + allData.length);
                } else {
                    allData = [];
                    $('#attendanceGrid').html('<div class="text-center text-muted py-3">No records found.</div>');
                    $('#recordSummary').text('');
                    $('#actionButtons').hide();
                }
            },
            error : function () {
                allData = [];
                $('#attendanceGrid').html('<div class="text-center text-danger py-3">Error fetching data.</div>');
                $('#recordSummary').text('');
                $('#actionButtons').hide();
            }
        });
    }

    /* ── Render DevExtreme Grid ──────────────────── */
    function renderTable(data) {
        var selectedStatus = getSelectedStatus();

        /* Button visibility per status */
        if (selectedStatus === 'Pending') {
            $('#btnApprove').show();
            $('#btnReject').show();
            $('#btnDelete').hide();
        } else {
            $('#btnApprove').hide();
            $('#btnReject').hide();
            $('#btnDelete').show();
        }

        $('#btnExportExcel').show();

        $("#attendanceGrid").dxDataGrid({
            dataSource      : data,
            keyExpr         : "leaveApplicationid",
            showBorders     : true,
            columnAutoWidth : true,
            width           : '100%',
            selection       : {
                mode               : "multiple",
                showCheckBoxesMode : "always"
            },
            onSelectionChanged : function (e) {
                selectedKeys = e.selectedRowKeys;
                console.log("Selected:", selectedKeys.length, "rows");
            },
            columns : [
                { dataField: "leaveApplicationId",  caption: "ApplicationId",    visible: false },
                { dataField: "leaveTypeName",        caption: "Leave Type",        cssClass: "text-center-cell", width: 120 },
                { dataField: "employeeName",         caption: "Employee Name",     cssClass: "text-center-cell", width: 150 },
                { dataField: "employeeCode",         caption: "Employee Code",     cssClass: "text-center-cell", width: 120 },
                { dataField: "branchName",           caption: "Branch Name",       cssClass: "text-center-cell", width: 120 },
                { dataField: "fromDate",             caption: "From Date",         dataType: "date", format: "dd/MM/yyyy", cssClass: "text-center-cell", width: 110 },
                { dataField: "todate",               caption: "To Date",           dataType: "date", format: "dd/MM/yyyy", cssClass: "text-center-cell", width: 110 },
                { dataField: "no_Of_Date",           caption: "Period",            cssClass: "text-center-cell", width:  80 },
                { dataField: "reason",               caption: "Reason",            cssClass: "text-center-cell", width: 150 },
                { dataField: "applicationType",      caption: "Application Type",  cssClass: "text-center-cell", width: 130 },
                { dataField: "reportingPersonName",  caption: "Reporting Person",  cssClass: "text-center-cell", width: 150 },
                { dataField: "leaveStatus",          caption: "Leave Status",      cssClass: "text-center-cell", width: 120 }
            ]
        });
    }

    /* ── Load Branches ───────────────────────────── */
    function GetBranch() {
        $.ajax({
            url         : '@(apiBase)/BranchAPI/GetAllBranchesListByCompanyId/' + Compid,
            type        : 'GET',
            headers     : { 'Authorization': 'Bearer ' + Token },
            contentType : 'application/json',
            success     : function (data) {
                if (data.isSuccess && data.data && data.data.length > 0) {
                    var $dd = $('#branchid');
                    $dd.empty().append('<option value="0">-- Select --</option>');
                    data.data.forEach(function (b) {
                        $dd.append('<option value="' + b.branchId + '">' + b.branchName + '</option>');
                    });
                }
            },
            error : function () {
                console.error("Error loading branch data.");
            }
        });
    }

    /* ── Approve / Reject ────────────────────────── */
    function updateLeaveStatus(status) {
        if (selectedKeys.length === 0) {
            Swal.fire('Warning', 'Please select at least one application.', 'warning');
            return;
        }

        var payload = {
            Ids        : selectedKeys,
            Status     : status,
            EmployeeId : Empid
        };

        $.ajax({
            url         : '@(apiBase)/LeaveApplication/LeaveapplicationApproveorReject',
            type        : 'POST',
            contentType : 'application/json',
            data        : JSON.stringify(payload),
            success     : function (res) {
                if (res.isSuccess) {
                    Swal.fire('Success', res.message, 'success');
                    selectedKeys = [];
                    loadLeaveApplications();
                } else {
                    Swal.fire('Error', res.message || 'Something went wrong.', 'error');
                }
            },
            error : function () {
                Swal.fire('Error', 'Failed to update status.', 'error');
            }
        });
    }

    /* ── Delete Leave Applications ───────────────── */
    function deleteLeaveApplications() {
        if (selectedKeys.length === 0) {
            Swal.fire('Warning', 'Please select at least one application to delete.', 'warning');
            return;
        }

        /* Approved records delete nahi honge */
        var selectedRows = allData.filter(function (row) {
            return selectedKeys.includes(row.leaveApplicationid);
        });
        var approvedRows = selectedRows.filter(function (row) {
            return row.leaveStatus === 'Approved';
        });

        if (approvedRows.length > 0) {
            Swal.fire('Not Allowed', 'Approved applications cannot be deleted.', 'warning');
            return;
        }

        Swal.fire({
            title              : 'Are you sure?',
            text               : selectedKeys.length + ' application(s) will be deleted permanently.',
            icon               : 'warning',
            showCancelButton   : true,
            confirmButtonColor : '#dc3545',
            cancelButtonColor  : '#6c757d',
            confirmButtonText  : 'Yes, Delete!'
        }).then(function (result) {
            if (!result.isConfirmed) return;

            var payload = {
                Id        : selectedKeys,
                DeletedBy : String(Empid)
            };

            $.ajax({
                url         : '@(apiBase)/LeaveApplication/Delete',
                type        : 'DELETE',
                contentType : 'application/json',
                data        : JSON.stringify(payload),
                success     : function (res) {
                    if (res.isSuccess) {
                        Swal.fire('Deleted!', res.message || 'Applications deleted successfully.', 'success');
                        selectedKeys = [];
                        loadLeaveApplications();
                    } else {
                        Swal.fire('Error', res.message || 'Something went wrong.', 'error');
                    }
                },
                error : function (xhr) {
                    console.log(xhr.responseText);
                    Swal.fire('Error', 'Failed to delete applications.', 'error');
                }
            });
        });
    }
</script>
