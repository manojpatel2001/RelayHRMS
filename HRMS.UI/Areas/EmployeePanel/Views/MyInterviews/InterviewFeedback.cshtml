@inject IConfiguration Configuration
@{
    ViewData["Title"] = "My Interviews";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
    .star-rating { display: inline-flex; flex-direction: row-reverse; margin: 0 10px; }
    .star-rating input[type="radio"] { display: none; }
    .star-rating label { font-size: 1.5rem; color: #ccc; cursor: pointer; transition: color 0.2s; padding: 0 2px; }
    .star-rating input[type="radio"]:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label { color: #ffc107; }
</style>

<div class="card">
    <div class="card-header bg-transparent py-2">
        <h6 class="mb-0">My Interview Panels</h6>
    </div>
    <div class="card-body">
        <div id="myInterviewGridContainer"></div>
    </div>
</div>

<!-- ===== Feedback Modal ===== -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Interview Feedback</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-4 text-center">
                        <label class="d-block">Technical</label>
                        <div class="star-rating" id="ratingTechnical">
                            <input type="radio" id="tech-5" name="tech" value="5" /><label for="tech-5">★</label>
                            <input type="radio" id="tech-4" name="tech" value="4" /><label for="tech-4">★</label>
                            <input type="radio" id="tech-3" name="tech" value="3" /><label for="tech-3">★</label>
                            <input type="radio" id="tech-2" name="tech" value="2" /><label for="tech-2">★</label>
                            <input type="radio" id="tech-1" name="tech" value="1" /><label for="tech-1">★</label>
                        </div>
                        <input type="hidden" id="hdnTechnical" value="0" />
                    </div>
                    <div class="col-md-4 text-center">
                        <label class="d-block">Communication</label>
                        <div class="star-rating" id="ratingCommunication">
                            <input type="radio" id="comm-5" name="comm" value="5" /><label for="comm-5">★</label>
                            <input type="radio" id="comm-4" name="comm" value="4" /><label for="comm-4">★</label>
                            <input type="radio" id="comm-3" name="comm" value="3" /><label for="comm-3">★</label>
                            <input type="radio" id="comm-2" name="comm" value="2" /><label for="comm-2">★</label>
                            <input type="radio" id="comm-1" name="comm" value="1" /><label for="comm-1">★</label>
                        </div>
                        <input type="hidden" id="hdnCommunication" value="0" />
                    </div>
                    <div class="col-md-4 text-center">
                        <label class="d-block">Problem Solving</label>
                        <div class="star-rating" id="ratingProblemSolving">
                            <input type="radio" id="ps-5" name="ps" value="5" /><label for="ps-5">★</label>
                            <input type="radio" id="ps-4" name="ps" value="4" /><label for="ps-4">★</label>
                            <input type="radio" id="ps-3" name="ps" value="3" /><label for="ps-3">★</label>
                            <input type="radio" id="ps-2" name="ps" value="2" /><label for="ps-2">★</label>
                            <input type="radio" id="ps-1" name="ps" value="1" /><label for="ps-1">★</label>
                        </div>
                        <input type="hidden" id="hdnProblemSolving" value="0" />
                    </div>

                    <div class="col-md-12">
                        <label>Strengths</label>
                        <textarea id="txtStrengths" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-12">
                        <label>Weaknesses</label>
                        <textarea id="txtWeaknesses" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="fg-req">Overall Recommendation</label>
                        <select id="ddlRecommendation" class="form-select">
                            <option value="">Select</option>
                            <option value="Hire">Hire</option>
                            <option value="Hold">Hold</option>
                            <option value="Reject">Reject</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label>Remarks</label>
                        <textarea id="txtFeedbackRemarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveFeedback" class="btn btn-outline-primary btn-sm">Save Draft</button>
                <button type="button" id="btnSubmitFeedback" class="btn btn-primary btn-sm">Submit Feedback</button>
            </div>
        </div>
    </div>
</div>

<script>
    const Token = localStorage.getItem("authToken");
    const EmployeeId = localStorage.getItem("EmployeeId");
    var currentInterviewId = 0;

    $(document).ready(function () {
        // Deferred until permissions are loaded so the very first render of
        // the per-row Feedback button (gated below) reflects the real list,
        // not the pre-load default of "hidden".
        PermGuard.onReady(function () { loadMyInterviews(); });
        $('.star-rating input[type="radio"]').change(function () {
            var hiddenId = '#hdn' + $(this).closest('.star-rating').attr('id').replace('rating', '');
            $(hiddenId).val($(this).val());
        });
    });

    function fmtDateTime(v) {
        if (!v) return '';
        var d = new Date(v);
        if (isNaN(d)) return '';
        return ('0' + d.getDate()).slice(-2) + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + d.getFullYear() + ' ' +
               ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
    }

    var myInterviewGrid = WMSGrid.create({
        container: 'myInterviewGridContainer',
        title: 'My Assigned Interviews',
        icon: 'bx-calendar-check',
        columns: [
            { field: 'FullName', header: 'Candidate', width: '160px' },
            { field: 'PositionTitle', header: 'Job Position', width: '160px' },
            { field: 'RoundName', header: 'Round', width: '160px' },
            { field: 'ScheduledDate', header: 'Scheduled', width: '150px', render: function (v) { return fmtDateTime(v); } },
            { field: 'Mode', header: 'Mode', width: '90px' },
            { field: 'HasFeedback', header: 'Feedback', width: '100px', render: function (v) { return v ? '<span class="badge bg-success">Submitted</span>' : '<span class="badge bg-warning">Pending</span>'; } },
            {
                header: 'Actions', sortable: false, stickyRight: true, width: '110px',
                render: function (v, row) {
                    // The Feedback button both creates a new feedback record and edits
                    // an existing draft/submission, depending on whether "mine" already
                    // exists — so it's gated on either permission being present.
                    if (!(PermGuard.has('create-ess-myinterviews-interviewfeedback') || PermGuard.has('edit-ess-myinterviews-interviewfeedback'))) return '';
                    return '<button class="wg-btn wg-btn-primary" title="Give Feedback" onclick="_openFeedback(' + row.InterviewId + ')"><i class="bx bx-star"></i> Feedback</button>';
                }
            }
        ]
    });

    function loadMyInterviews() {
        myInterviewGrid.showLoader();
        $.ajax({
            url: '@baseUrl/InterviewAPI/GetInterviewsByPanelistEmployeeId/' + EmployeeId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) { myInterviewGrid.setData(res.data || []); myInterviewGrid.hideLoader(); },
            error: function () { myInterviewGrid.hideLoader(); showToast('Failed to load interviews.', 'error'); }
        });
    }

    window._openFeedback = function (interviewId) {
        currentInterviewId = interviewId;
        $('#feedbackModal .star-rating input[type=radio]').prop('checked', false);
        $('#feedbackModal input[type=hidden]').val(0);
        $('#txtStrengths, #txtWeaknesses, #txtFeedbackRemarks, #ddlRecommendation').val('');

        $.ajax({
            url: '@baseUrl/InterviewFeedbackAPI/GetFeedbackByInterviewId/' + interviewId,
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                var mine = (res.data || []).find(function (f) { return f.panelistEmployeeId == EmployeeId; });
                if (mine) {
                    $('#hdnTechnical').val(mine.technicalRating || 0);
                    $('#hdnCommunication').val(mine.communicationRating || 0);
                    $('#hdnProblemSolving').val(mine.problemSolvingRating || 0);
                    $('#tech-' + mine.technicalRating).prop('checked', true);
                    $('#comm-' + mine.communicationRating).prop('checked', true);
                    $('#ps-' + mine.problemSolvingRating).prop('checked', true);
                    $('#txtStrengths').val(mine.strengths);
                    $('#txtWeaknesses').val(mine.weaknesses);
                    $('#ddlRecommendation').val(mine.recommendation);
                    $('#txtFeedbackRemarks').val(mine.remarks);
                }
                $('#feedbackModal').modal('show');
            },
            error: function () { $('#feedbackModal').modal('show'); }
        });
    };

    function submitFeedback(isSubmitted) {
        if (isSubmitted && !$('#ddlRecommendation').val()) {
            showToast('Overall recommendation is required to submit.', 'error');
            return;
        }

        var payload = {
            InterviewId: currentInterviewId,
            PanelistEmployeeId: parseInt(EmployeeId),
            TechnicalRating: parseInt($('#hdnTechnical').val()) || null,
            CommunicationRating: parseInt($('#hdnCommunication').val()) || null,
            ProblemSolvingRating: parseInt($('#hdnProblemSolving').val()) || null,
            Strengths: $('#txtStrengths').val(),
            Weaknesses: $('#txtWeaknesses').val(),
            Recommendation: $('#ddlRecommendation').val(),
            Remarks: $('#txtFeedbackRemarks').val(),
            IsSubmitted: isSubmitted,
            CreatedBy: EmployeeId
        };

        $.ajax({
            type: 'POST', url: '@baseUrl/InterviewFeedbackAPI/SubmitFeedback',
            data: JSON.stringify(payload), contentType: 'application/json',
            headers: { 'Authorization': 'Bearer ' + Token },
            success: function (res) {
                if (res.isSuccess) {
                    showToast(isSubmitted ? 'Feedback submitted successfully.' : 'Draft saved.', 'success');
                    if (isSubmitted) $('#feedbackModal').modal('hide');
                    loadMyInterviews();
                } else {
                    showToast(res.responseMessage || 'Failed to save feedback.', 'error');
                }
            },
            error: function () { showToast('Failed to save feedback.', 'error'); }
        });
    }

    $('#btnSaveFeedback').click(function () { submitFeedback(false); });
    $('#btnSubmitFeedback').click(function () { submitFeedback(true); });
</script>
