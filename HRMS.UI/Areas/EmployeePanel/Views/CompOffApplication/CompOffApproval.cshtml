@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Comp-Off Approval</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 170px;min-width:160px;">
                    <label for="searchtypeid">Search Type</label>
                    <select id="searchtypeid">
                        <option value="0">--Select--</option>
                        <option value="Employee Name">Employee Name</option>
                        <option value="Employee Code">Emp Code</option>
                    </select>
                </div>

                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="searchforid">Search For</label>
                    <input type="text" id="searchforid" placeholder="Enter search text" />
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="pendingid" name="Status" value="Pending" checked>
                            <label class="form-check-label" for="pendingid">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="approvedid" name="Status" value="Approved">
                            <label class="form-check-label" for="approvedid">Approved</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="rejectedid" name="Status" value="Rejected">
                            <label class="form-check-label" for="rejectedid">Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="goid">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">GO</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearid">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="actionButtons" style="display:none;">
                <div class="d-flex justify-content-end gap-2 mb-3">
                    <button type="button" class="btn btn-outline btn-sm d-inline-flex align-items-center gap-1" id="btnSelectAllCoApp">
                        <i class="bx bx-check-square"></i> Select All
                    </button>
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="approveid">
                        <i class="bx bx-check"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Approve</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-1" id="rejectid">
                        <i class="bx bx-x"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Reject</span>
                    </button>
                </div>
            </div>

            <div id="gridContainerCoApproval"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        const apiBase = '@apiBase';
        const Empid = parseInt(localStorage.getItem("EmployeeId"));
        var token = localStorage.getItem("authToken");
        const savedCompany = localStorage.getItem('selectedCompany');
        const companyDetails = JSON.parse(savedCompany || '{}');
        const Compid = parseInt(companyDetails.CompanyId);

        var selectedIds = {};
        var currentRows = [];
        var grid = null;
        var isLoadingCoApproval = false;
        var isProcessingCoApproval = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function statusPill(status) {
            if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return status || '-';
        }

        $(document).ready(function () {
            loadAllApplications($('#searchtypeid').val(), $('#searchforid').val());

            $('input[name="Status"]').on('change', function () {
                selectedIds = {};
                loadAllApplications($('#searchtypeid').val(), $('#searchforid').val());
            });

            $('#goid').on('click', function () {
                loadAllApplications($('#searchtypeid').val(), $('#searchforid').val());
            });

            $('#clearid').on('click', function () {
                $('#searchtypeid').val("0");
                $('#searchforid').val("");
                $('#pendingid').prop('checked', true);

                currentRows = [];
                grid = null;
                selectedIds = {};
                $('#gridContainerCoApproval').empty();
                $('#actionButtons').hide();

                loadAllApplications("0", "");
            });

            $('#approveid').on('click', function () { handleApprovalOrRejection("Approved"); });
            $('#rejectid').on('click', function () { handleApprovalOrRejection("Rejected"); });

            $('#btnSelectAllCoApp').on('click', function () {
                var allSelected = currentRows.length > 0 && currentRows.every(function (r) { return !!selectedIds[r.comp_Off_Detailsid]; });
                selectedIds = {};
                if (!allSelected) { currentRows.forEach(function (r) { selectedIds[r.comp_Off_Detailsid] = true; }); }
                if (grid) grid.refresh();
            });
        });

        function loadAllApplications(searchtype, searchfor) {
            if (isLoadingCoApproval) return;

            var selectedStatus = $('input[name="Status"]:checked').val();

            isLoadingCoApproval = true;
            setBtnLoading('#goid', 'GO');

            var payload = {
                SearchType: searchtype || "0",
                SearchFor: searchfor || "",
                Status: selectedStatus,
                CompId: Compid,
                Emplooyeid: Empid
            };

            selectedIds = {};

            $.ajax({
                url: apiBase + '/CompOffAPI/GetCompOffApplicationsAdmin',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + token },
                data: JSON.stringify(payload),
                success: function (data) {
                    isLoadingCoApproval = false;
                    setBtnNormal('#goid', 'GO');

                    if (data.isSuccess && data.data && data.data.length > 0) {
                        currentRows = data.data;
                        renderGrid(currentRows, selectedStatus);
                        if (selectedStatus === "Pending") {
                            $('#actionButtons').show();
                        } else {
                            $('#actionButtons').hide();
                        }
                    } else {
                        currentRows = [];
                        grid = null;
                        $('#gridContainerCoApproval').empty();
                        showToast('No records found.', 'info');
                        $('#actionButtons').hide();
                    }
                },
                error: function (xhr) {
                    isLoadingCoApproval = false;
                    setBtnNormal('#goid', 'GO');
                    console.error('API Error:', xhr);
                    currentRows = [];
                    grid = null;
                    $('#gridContainerCoApproval').empty();
                    showToast('Unable to load data.', 'error');
                    $('#actionButtons').hide();
                }
            });
        }

        window._toggleCoApprovalRow = function (id, checked) {
            if (checked) selectedIds[id] = true;
            else delete selectedIds[id];
        };

        window._rowApproveCoApproval = function (id) { handleApprovalOrRejection('Approved', [id]); };
        window._rowRejectCoApproval = function (id) { handleApprovalOrRejection('Rejected', [id]); };

        function renderGrid(data, selectedStatus) {
            var isPending = selectedStatus === "Pending";

            var columns = [];

            if (isPending) {
                columns.push({
                    header: '', sortable: false, width: '40px',
                    render: function (v, row) {
                        var checked = selectedIds[row.comp_Off_Detailsid] ? ' checked' : '';
                        return '<input type="checkbox" class="form-check-input"' + checked + ' onclick="_toggleCoApprovalRow(' + row.comp_Off_Detailsid + ', this.checked)">';
                    }
                });
            }

            columns.push(
                { field: 'comp_Off_Detailsid', header: 'Application Id', width: '110px' },
                { field: 'emp_Code', header: 'Employee Code', width: '130px' },
                { field: 'fullName', header: 'Employee Name', width: '180px' },
                { field: 'branchName', header: 'Branch Name', width: '150px' },
                { header: 'Extra Work Day', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.extra_Work_Day); } },
                {
                    field: 'extra_Work_Hours', header: 'Extra Hours', width: '100px',
                    render: function (v) { return (v !== null && v !== undefined) ? parseFloat(v).toFixed(2) : '-'; }
                },
                { field: 'comoffReason', header: 'Reason', width: '200px' },
                {
                    header: 'Status', sortable: false, width: '110px',
                    render: function (v, row) { return statusPill(row.application_Status); }
                }
            );

            if (isPending) {
                columns.push({
                    header: 'Action', sortable: false, width: '90px', stickyRight: true,
                    render: function (v, row) {
                        return '<div class="d-flex gap-1">' +
                            '<button class="wg-btn wg-btn-outline" title="Approve" onclick="_rowApproveCoApproval(' + row.comp_Off_Detailsid + ')"><i class="bx bx-check"></i></button>' +
                            '<button class="wg-btn wg-btn-outline" style="color:#C62828;border-color:#EF9A9A" title="Reject" onclick="_rowRejectCoApproval(' + row.comp_Off_Detailsid + ')"><i class="bx bx-x"></i></button>' +
                            '</div>';
                    }
                });
            }

            grid = WMSGrid.create({
                container: 'gridContainerCoApproval',
                title: 'Comp Off Applications',
                icon: 'bx-calendar-check',
                exportName: 'CompOffApprovals',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        }

        function handleApprovalOrRejection(status, ids) {
            if (isProcessingCoApproval) return;

            var targetIds = ids || Object.keys(selectedIds).map(function (k) { return parseInt(k); });

            if (!targetIds || targetIds.length === 0) {
                showToast('Please select at least one application.', 'warn');
                return;
            }

            isProcessingCoApproval = true;
            var btnSel = status === 'Approved' ? '#approveid' : '#rejectid';
            setBtnLoading(btnSel, status === 'Approved' ? 'Approving...' : 'Rejecting...');

            var payload = {
                CompoffIds: targetIds,
                status: status,
                EmployeeId: Empid
            };

            $.ajax({
                url: apiBase + '/CompOffAPI/CompOffDetailsApproveorReject',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + token },
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.isSuccess) {
                        showToast(res.responseMessage || 'Updated successfully.', 'success');
                        selectedIds = {};
                        loadAllApplications($('#searchtypeid').val(), $('#searchforid').val());
                    } else {
                        showToast(res.responseMessage || 'Failed to update.', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Approval/Rejection error:', xhr);
                    showToast('Unable to process request.', 'error');
                },
                complete: function () {
                    isProcessingCoApproval = false;
                    setBtnNormal(btnSel, status === 'Approved' ? 'Approve' : 'Reject');
                }
            });
        }
    })();
</script>
