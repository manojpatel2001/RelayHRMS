@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
    string apiBase = ViewBag.BaseUrlAPI;
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Comp Off Application</h6>
            <a href="@Url.Action("AddCompOffApplication", "CompOffApplication", new { area = "EmployeePanel" })" class="btn btn-primary btn-sm">Add</a>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg" style="flex:1 1 200px;min-width:180px;">
                    <label for="searchforid">Extra Work Date</label>
                    <input type="date" id="searchforid" />
                </div>

                <div style="flex:0 0 auto;">
                    <span class="sec-lbl" style="margin-top:0;margin-bottom:6px;font-size:var(--fs-xs);display:block;">Status</span>
                    <div class="d-flex gap-3">
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="allleaveid" name="leaveStatus" value="" checked>
                            <label class="form-check-label" for="allleaveid">All</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="pendingleaveid" name="leaveStatus" value="Pending">
                            <label class="form-check-label" for="pendingleaveid">Pending</label>
                        </div>
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" id="Approveid" name="leaveStatus" value="Approved">
                            <label class="form-check-label" for="Approveid">Approved/Rejected</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="gobutoonid">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">GO</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="clearbuttonid">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerCompOffApp"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        const apiBase = '@apiBase';
        const Empid = parseInt(localStorage.getItem("EmployeeId"));
        const savedCompany = localStorage.getItem('selectedCompany');
        const companyDetails = JSON.parse(savedCompany || '{}');
        const Compid = parseInt(companyDetails.CompanyId);

        var grid = null;
        var isLoadingCoApp = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function statusPill(status) {
            if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return status || '-';
        }

        $(document).ready(function () {
            loadAllApplications("", "");

            $('#gobutoonid').on('click', function () {
                var selectedStatus = $('input[name="leaveStatus"]:checked').val();
                var selectedDate = $('#searchforid').val();
                loadAllApplications(selectedDate, selectedStatus);
            });

            $('#clearbuttonid').on('click', function () {
                $('#searchforid').val("");
                $('input[name="leaveStatus"]').prop('checked', false);
                $('#allleaveid').prop('checked', true);
                loadAllApplications("", "");
            });

            $('input[name="leaveStatus"]').on('change', function () {
                var selectedStatus = $(this).val();
                var selectedDate = $('#searchforid').val();
                loadAllApplications(selectedDate, selectedStatus);
            });
        });

        function loadAllApplications(date, status) {
            if (isLoadingCoApp) return;
            isLoadingCoApp = true;
            setBtnLoading('#gobutoonid', 'GO');

            var payload = {
                SearchType: "Extra_Work_Day",
                SearchFor: date || "",
                Status: status,
                CompId: Compid,
                Emplooyeid: Empid
            };

            $.ajax({
                url: apiBase + '/CompOffAPI/GetCompOffApplications',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (data) {
                    isLoadingCoApp = false;
                    setBtnNormal('#gobutoonid', 'GO');

                    if (data.isSuccess && data.data && data.data.length > 0) {
                        renderGrid(data.data);
                    } else {
                        grid = null;
                        $('#gridContainerCompOffApp').empty();
                        showToast('No records found.', 'info');
                    }
                },
                error: function (xhr) {
                    isLoadingCoApp = false;
                    setBtnNormal('#gobutoonid', 'GO');
                    console.error("Error loading data:", xhr);
                    grid = null;
                    $('#gridContainerCompOffApp').empty();
                    showToast('Unable to load data.', 'error');
                }
            });
        }

        function renderGrid(data) {
            var columns = [
                { field: 'comp_Off_Detailsid', header: 'Application Id', width: '110px' },
                { field: 'emp_Code', header: 'Employee Code', width: '130px' },
                { field: 'fullName', header: 'Employee Name', width: '180px' },
                { field: 'branchName', header: 'Branch Name', width: '150px' },
                { header: 'Extra Work Day', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.extra_Work_Day); } },
                {
                    field: 'extra_Work_Hours', header: 'Extra Hours', width: '100px',
                    render: function (v) { return (v !== null && v !== undefined) ? parseFloat(v).toFixed(2) : '-'; }
                },
                { field: 'comoffReason', header: 'Reason', width: '200px' },
                {
                    header: 'Application Status', sortable: false, width: '130px',
                    render: function (v, row) { return statusPill(row.application_Status); }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerCompOffApp',
                    title: 'Comp Off Applications',
                    icon: 'bx-calendar-plus',
                    exportName: 'CompOffApplications',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
            }
        }
    })();
</script>
