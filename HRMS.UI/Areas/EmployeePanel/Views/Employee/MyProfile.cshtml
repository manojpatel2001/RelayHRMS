     function formatToDDMMYYYY(dateInput) {
        const date = new Date(dateInput);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0'); // Months are 0-based
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }

    // Tab -> partial view URL map (same /EmployeePanel/PartialView/{action}
    // endpoints the old openForm() switch used).
    const mpTabMap = {
        'personal-form': '/EmployeePanel/PartialView/PersonalInfo',
        'contact-form-section': '/EmployeePanel/PartialView/Contact',
        'emergency-form': '/EmployeePanel/PartialView/EmergencyContact',
        'reporting-contract-form': '/EmployeePanel/PartialView/Reporting',
        'Skill-form': '/EmployeePanel/PartialView/Skills',
        'Attachments-form': '/EmployeePanel/PartialView/Attachments',
        'allowance-form': '/EmployeePanel/PartialView/Allowance',
        'salary-form': '/EmployeePanel/PartialView/Salary'
    };

    $(document).ready(function () {
        // "Basic Info" is the default tab. Unlike the others it's not an
        // AJAX-loaded partial -- it's the always-inline form (see
        // loadEmployeeProfile()) -- so it needs no loadPartialView() call and
        // is already visible (no d-none) in the markup; the remaining tabs
        // stay lazy-loaded on first click.

        // Handle tab click
        $('#myProfileDetailTabs .nav-link').on('click', function (e) {
            e.preventDefault();
            $('#myProfileDetailTabs .nav-link').removeClass('active');
            $(this).addClass('active');

            let targetId = $(this).data('tabname');
            if (!targetId) return;

            $('.partial-section').addClass('d-none');
            $('#' + targetId).removeClass('d-none');

            // Load the partial view if not already loaded
            if ($('#' + targetId).html().trim() === '') {
                loadPartialView(targetId);
            }

            // Switching tabs doesn't reset scroll position. If the user had
            // scrolled down while viewing a taller tab (e.g. Basic Info,
            // which has a 3-column layout with the profile photo), a
            // shorter tab's content would otherwise render mostly/fully
            // above the still-scrolled-down viewport -- looking like a
            // blank page with the data "missing" rather than just needing
            // to scroll back up. Reset scroll on every tab switch instead.
            // #myProfileCard is the actual scroll container (see its
            // overflow-y:auto in this page's <style> block) -- #main-area
            // itself no longer scrolls once .card fits within it.
            var scroller = document.getElementById('myProfileCard') || document.getElementById('main-area');
            if (scroller) { scroller.scrollTop = 0; }
        });

        // ‹ › buttons scroll the tab strip so tabs that don't fit the
        // visible width are still reachable without a native scrollbar.
        $('#mpTabsPrev').on('click', function () {
            document.getElementById('myProfileDetailTabs').scrollBy({ left: -160, behavior: 'smooth' });
        });
        $('#mpTabsNext').on('click', function () {
            document.getElementById('myProfileDetailTabs').scrollBy({ left: 160, behavior: 'smooth' });
        });
    });

    function loadPartialView(targetId) {
        var url = mpTabMap[targetId];
        if (!url) {
            console.error("❌ No matching partial view URL found for", targetId);
            return;
        }

        $('#' + targetId).html('<div class="text-center p-3"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');

        $.ajax({
            url: url,
            method: 'GET',
            success: function (data) {
                $('#' + targetId).html(data).removeClass('d-none');
            },
            error: function (xhr) {
                console.error('AJAX failed:', xhr.status, xhr.statusText);
            }
        });
    }

</script>

<script>
        let cropper;
    let selectedFile;
    let profileFile = null;
    let currentCropTarget = 'profile'; // default target

    // Trigger file input
    $('#profileImage').click(() => {
        // Changing the profile photo is an edit action -- block it at the
        // entry point rather than only hiding the (dynamically shown/hidden)
        // Upload button further down the flow, since that button is
        // re-shown by the crop-confirm handler regardless of permission.
        if (!PermGuard.has('edit-ess-employee-myprofile')) return;
        currentCropTarget = 'profile';
        $('#profileInput').click();
    });

    // File selected
    $('#profileInput').change(function () {
        const file = this.files[0];
        if (!file || !file.name.toLowerCase().endsWith(".jpg")) {
            alert("Only JPG files are allowed.");
            return;
        }

        selectedFile = file;
        const reader = new FileReader();
        reader.onload = function (e) {
            $('#cropImagePreview').attr('src', e.target.result);
            $('#cropImagePreview').on('load', function () {
                initCropper();
            });

            const modal = new bootstrap.Modal(document.getElementById('cropModal'));
            modal.show();
        };
        reader.readAsDataURL(file);
    });

    // Initialize Cropper
    function initCropper() {
        const image = document.getElementById('cropImagePreview');
        if (cropper) cropper.destroy();

        cropper = new Cropper(image, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1
        });
    }

    // Destroy cropper on modal close
    $('#cropModal').on('hidden.bs.modal', function () {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        
    });

    // Confirm Crop
    $('#cropConfirmBtn').click(function () {
        if (!cropper) {
            alert("Cropper not initialized.");
            return;
        }

        const canvas = cropper.getCroppedCanvas({ width: 150, height: 150 });

        canvas.toBlob(function (blob) {
            const croppedFile = new File([blob], selectedFile.name, {
                type: "image/jpeg",
                lastModified: Date.now()
            });

            const previewURL = URL.createObjectURL(croppedFile);
            $('#profileImage').attr('src', previewURL);
            profileFile = croppedFile;
            $("#uploadBtnTag").show();
            bootstrap.Modal.getInstance(document.getElementById('cropModal')).hide();
        }, "image/jpeg");
    });

    // Upload Cropped Image
    $("#btnUpload").click(() => {
        if (!PermGuard.has('edit-ess-employee-myprofile')) return;

        $("#btnUpload").prop("disabled", true);

        if (!profileFile) {
            round_error_noti("Please select and crop an image first!");
            $("#btnUpload").prop("disabled", false);
            return;
        }

        const profileFormdata = new FormData();
        profileFormdata.append("EmployeeId", employeeId); // Make sure employeeId is defined
        profileFormdata.append("EmployeeProfileFile", profileFile);

        $.ajax({
            url: '@baseUrl/ProfileManageAPI/UpdateProfilePic', // Replace with your actual endpoint
            type: 'POST',
            data: profileFormdata,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.isSuccess) {
                    const employee = response.data;
                    const imageUrl = employee.employeeProfileUrl ;
                    if(imageUrl){
                        $('#profileImage').attr('src', imageUrl);
                        $("#uploadBtnTag").hide();
                    
                       round_success_noti(response.responseMessage);
                      $('.profileImage').attr('src', imageUrl);
                    }
                } else {
                    round_error_noti(response.responseMessage);
                }
                $("#btnUpload").prop("disabled", false);
            },
            error: function (xhr, status, error) {
                $("#btnUpload").prop("disabled", false);
            }
        });
    });


</script>


