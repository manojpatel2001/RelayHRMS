<style>
       .card {
        margin: 20px;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        /* wms-site.css's shared .card rule sets overflow:hidden (needed on
           most pages to clip rounded card-header banners). .card here is a
           flex child of #main-area (display:flex; flex-direction:column;
           fixed height), so by default flexbox is free to shrink it below
           its natural content height to fit -- with overflow:hidden that
           shrunk-away content was simply clipped with no way to reach it
           (no scrollbar can ever appear on an overflow:hidden box). Override
           to auto (scoped to this page only) so it scrolls instead. */
        overflow-y: auto;
        min-height: 0;
    }
    .form-label-fixed {
        width: 150px;
    }
    /* #myProfileCard (the .card above) is the actual scroll container now
       (see its overflow-y:auto), not #main-area -- give it a clearly
       visible scrollbar instead of the default thin 5px one. */
    #myProfileCard::-webkit-scrollbar {
        width: 10px;
    }
    #myProfileCard::-webkit-scrollbar-track {
        background: #EEF3F7;
    }
    #myProfileCard::-webkit-scrollbar-thumb {
        background: #A9B8C4;
        border-radius: 5px;
        border: 2px solid #EEF3F7;
    }
    #myProfileCard::-webkit-scrollbar-thumb:hover {
        background: #8AA0B0;
    }
    /* Employee Detail Tabs — same pattern/CSS as AdminPanel's Edit Employee
       Master page (AdditionalInformation.cshtml's .emp-tabs-bar), scoped to
       this page's own class/IDs so it can't leak into other pages. */
    .mp-tabs-bar {
        position: sticky;
        top: 0;
        z-index: 12;
        display: flex;
        align-items: center;
        gap: 2px;
        background: #fff;
        padding: 8px 12px 0;
        margin-bottom: 4px;
    }
    /* Each AJAX-loaded partial (_PersonalInfo, _Contact, etc.) starts with
       its own .card-header, whose default top padding already provides
       enough breathing room below the tab strip -- so the wrapper here
       doesn't need extra top spacing on top of that. */
    #partialViewContainer .card-body {
        padding-top: 0 !important;
    }
    /* .card-header itself still carries hrms-premium.css's global 16px
       top/bottom padding -- tighten that too so the gap under the tab
       strip stays small end-to-end, not just at the card-body boundary. */
    #partialViewContainer .card-header {
        padding-top: 8px !important;
        padding-bottom: 8px !important;
        /* hrms-premium.css's shared ".card-header { background: var(--hp-surface)
           !important }" rule (meant for plain white page-title bars) wins over
           these partials' own "bg-primary text-white" classes, since both use
           !important -- leaving WHITE TEXT ON A WHITE BACKGROUND, i.e. an
           invisible heading that reads as a blank gap instead of a title bar.
           Restore the navy banner these partials were actually built for
           (matches the #394867 used by their own table headers). */
        background: #394867 !important;
    }
    #partialViewContainer .card-header,
    #partialViewContainer .card-header * {
        color: #fff !important;
    }
    .mp-tabs-nav-btn {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 5px;
        background: transparent;
        color: #667;
        cursor: pointer;
        font-size: 15px;
    }
    .mp-tabs-nav-btn:hover {
        background: #eef4fa;
        color: #2F6F8E;
    }
    #myProfileDetailTabs {
        flex: 1 1 auto;
        min-width: 0;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 0;
        scrollbar-width: none;
        /* Bootstrap's .nav-tabs default gives the whole strip a full-width
           grey bottom border, which sits right where the active tab's own
           colored underline needs to stand out -- drop it so the colored
           underline below isn't visually diluted by a grey line running
           under every tab. */
        border-bottom: none !important;
    }
    #myProfileDetailTabs::-webkit-scrollbar { display: none; }
    #myProfileDetailTabs .nav-item { flex-shrink: 0; }
    #myProfileDetailTabs .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
        font-size: 12px;
        padding: 7px 8px;
        border: none !important;
        border-bottom: 3px solid transparent !important;
    }
    #myProfileDetailTabs .nav-link i { font-size: 13px; }
    #myProfileDetailTabs .nav-link.active {
        background: #EAF1F8 !important;
        border-radius: 6px 6px 0 0;
        border-bottom-color: #2F6F8E !important;
        color: #1a4a6b;
    }

    h4.text-center {
        background-color: #f8f9fa;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }
    .inp-width{
        width:230px;
    }

    #profileImage {
       border:1px solid grey;
        object-fit: cover;
        cursor: pointer;
    }

    #cropModal .modal-dialog {
        max-width: 600px; /* Optional: limit modal width */
    }

    #cropModal .modal-body {
        max-height: 70vh;
        overflow: auto;
    }

    #cropImagePreview {
        max-width: 100%;
        max-height: 60vh;
        display: block;
        margin: 0 auto;
    }


</style>

