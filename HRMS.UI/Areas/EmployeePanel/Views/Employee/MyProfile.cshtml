<script>

    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    let companyId = companyDetails.CompanyId;
    let employeeId = localStorage.getItem('EmployeeId');
    const token = localStorage.getItem("authToken");
        // Get the encrypted ID from the URL
    const urlParams = new URLSearchParams(window.location.search);
    const encryptedId = urlParams.get("EmpId"); 
    const encryptedCompId = urlParams.get("CompId"); 
    if(encryptedId)
    {
        employeeId=atob(encryptedId);
    }
    
    if(encryptedCompId)
    {
        companyId=atob(encryptedCompId);
    }
    

    $(document).ready(async function () {
        await loadEmployeeRecords();
        $('#btnShowMore').click(function () {
            var $moreDetailsForm = $('#more-details-form');
            var $btnSubmitPersonal = $('#submit-personal');
            var $btnSubmitMore = $('#submit-more');

            if ($moreDetailsForm.is(':visible')) {
                $moreDetailsForm.hide();
                $(this).text('Show');
                $btnSubmitPersonal.show();
            } else {
                $moreDetailsForm.show();
                $(this).text('Hide');
                $btnSubmitPersonal.hide();
            }
        });
          loadEmployeeProfile();
        CheckReportingPerson();
    });


            async function loadEmployeeRecords() {
                var parameter={
                    CompanyId:companyId,
                    EmployeeId:employeeId
                }
                try {
                    const response = await new Promise((resolve, reject) => {
                        $.ajax({
                            url: '@baseUrl/EmployeeMasterAPI/GetRecordsForUpdate' ,
                            method: 'POST',
                            contentType: 'application/json',
                              data: JSON.stringify(parameter),
                            success: function(response) {
                                resolve(response);
                            },
                            error: function(error) {
                                reject(error);
                            }
                        });
                    });

                      
                        bindDepartment(response.data.departments||[]);
                        bindShift(response.data.shifts||[]);


                } catch (error) {
                    console.error('Error fetching data:', error);
                } 
            }

         async function bindShift(data)
        {

             $('#ddlShift').searchableSelect({
                data: data||[],
                valueKey: 'shiftId',
                textKey: 'shiftName',
                placeholder:'Shift',
                searchPlaceholder: 'Search shift...',
                onChange: function(item) {

                }
              });
            $('#ddlShift').prop('disabled', true).prop('readonly', true);


        }

            async  function bindDepartment(data)
            {

                $('#ddlDepartment').searchableSelect({
                    data: data||[],
                    valueKey: 'departmentId',
                    textKey: 'departmentName',
                    placeholder:'Department',
                    searchPlaceholder: 'Search department...',
                    onChange: function(item) {

                    }
                });
