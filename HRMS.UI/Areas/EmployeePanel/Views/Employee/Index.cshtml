@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<style>
/* ── Current Status card (Clock In / Clock Out) ──────────────────
   "Last Clock In"/"Last Clock Out"/status here are NOT the same as the
   AttendanceDetails.InTime/OutTime used by payroll (those only track the
   day's first and last punch). This card treats today's punches as an
   alternating in/out/in/out sequence instead, via the additive
   GetEmployeeTodayInOutStatus proc, so multi-segment days (e.g. a lunch
   break) show a correct current status rather than going stale between
   the day's first and last punch. See HRMS_Infrastructure/SQL/StoredProcedures. */
.eio-status-card { padding: 14px 18px; margin-bottom: 16px; }
.eio-status-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.eio-status-kicker { font-size: 9.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: #7c93ad; margin-bottom: 5px; }
.eio-status-badge { display: inline-flex; align-items: center; gap: 6px; background: #eef1f5; color: #46586b; font-size: 11.5px; font-weight: 600; padding: 4px 11px; border-radius: 20px; }
.eio-status-dot { width: 6px; height: 6px; border-radius: 50%; background: #94a3b8; flex-shrink: 0; }
.eio-status-badge.is-in { background: #e3f9ec; color: #15803d; }
.eio-status-badge.is-in .eio-status-dot { background: #22c55e; }

.eio-status-actions { display: flex; gap: 8px; }
.eio-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 100px; border: none; border-radius: 6px; padding: 6px 12px;
    font-size: 11.5px; font-weight: 700; color: #fff; cursor: pointer;
    transition: opacity .15s, transform .15s, box-shadow .15s;
    box-shadow: 0 2px 8px rgba(0,0,0,.10);
}
.eio-btn i { font-size: 13px; }
.eio-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.16); }
.eio-btn:disabled { cursor: not-allowed; box-shadow: none; transform: none; }
.eio-btn-in { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); }
.eio-btn-in:disabled { background: #bdeccd; color: #eafbf1; }
.eio-btn-out { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
.eio-btn-out:disabled { background: #fbdcdc; color: #fdf1f1; }

.eio-divider { height: 1px; background: #e4edf4; margin: 12px 0; }

.eio-info-row { display: flex; }
.eio-info-col { flex: 1; padding: 0 14px; border-right: 1px solid #e4edf4; }
.eio-info-col:first-child { padding-left: 0; }
.eio-info-col:last-child { border-right: none; }
.eio-info-label { font-size: 9.5px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: #8da0b3; margin-bottom: 6px; }
.eio-info-icon { display: block; font-size: 12px; color: #c8d9e6; margin-bottom: 6px; }
.eio-info-value { font-size: 15px; font-weight: 700; color: #1e3a5f; }
.eio-mono { font-family: Consolas, 'SFMono-Regular', monospace; }

.eio-total-bar {
    display: flex; align-items: center; justify-content: space-between;
    background: #f6f9fc; border-radius: 8px; padding: 10px 14px; margin-top: 14px;
}
.eio-total-bar span:first-child { font-size: 12px; color: #5a7088; font-weight: 600; }
.eio-total-bar .eio-mono { font-size: 16px; font-weight: 800; color: #1e3a5f; }

@@media (max-width: 700px) {
    .eio-info-row { flex-direction: column; gap: 12px; }
    .eio-info-col { border-right: none; padding: 0 0 12px; border-bottom: 1px solid #e4edf4; }
    .eio-info-col:last-child { border-bottom: none; padding-bottom: 0; }
}
</style>

<div class="wms-form-page">

    <div class="card eio-status-card" id="eioStatusCard" style="display:none;">
        <div class="eio-status-top">
            <div>
                <div class="eio-status-kicker">Current Status</div>
                <div class="eio-status-badge" id="eioStatusBadge">
                    <span class="eio-status-dot"></span>
                    <span id="eioStatusText">Clocked Out</span>
                </div>
            </div>
            <div class="eio-status-actions">
                <button type="button" class="eio-btn eio-btn-in" id="btnClockIn" disabled>
                    <i class="bx bx-log-in-circle"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Clock In</span>
                </button>
                <button type="button" class="eio-btn eio-btn-out" id="btnClockOut" disabled>
                    <i class="bx bx-log-out-circle"></i>
                    <span class="btn-spinner-icon"></span>
                    <span class="btn-label-text">Clock Out</span>
                </button>
            </div>
        </div>

        <div class="eio-divider"></div>

        <div class="eio-info-row">
            <div class="eio-info-col">
                <div class="eio-info-label">Last Clock In</div>
                <i class="bx bx-log-in-circle eio-info-icon"></i>
                <div class="eio-info-value" id="eioLastClockIn">-</div>
            </div>
            <div class="eio-info-col">
                <div class="eio-info-label">Last Clock Out</div>
                <i class="bx bx-log-out-circle eio-info-icon"></i>
                <div class="eio-info-value" id="eioLastClockOut">-</div>
            </div>
            <div class="eio-info-col">
                <div class="eio-info-label">Today's Worked Hours</div>
                <i class="bx bx-time-five eio-info-icon"></i>
                <div class="eio-info-value eio-mono" id="eioWorkedHours">0h 00m 00s</div>
            </div>
        </div>

        <div class="eio-total-bar">
            <span>Total today</span>
            <span class="eio-mono" id="eioTotalToday">0h 00m 00s</span>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Employee In Out</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 170px;min-width:160px;">
                    <label for="dropdownmonth">Month</label>
                    <select id="dropdownmonth">
                        <option value="" disabled>Select Month</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            var selected = (i == DateTime.Now.Month) ? "selected" : "";
                            <option value="@i" @selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>

                <div class="fg fg-req" style="flex:1 1 130px;min-width:120px;">
                    <label for="dropdownyear">Year</label>
                    <select id="dropdownyear">
                        @for (int y = 2024; y <= DateTime.Now.Year; y++)
                        {
                            var selected = (y == DateTime.Now.Year) ? "selected" : "";
                            <option value="@y" @selected>@y</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                </div>
            </div>

            <div class="divider"></div>

            <ul class="nav nav-tabs" id="attendanceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="firstLast-tab" data-bs-toggle="tab" data-bs-target="#firstLast" type="button" role="tab">
                        <i class="bx bx-list-ul me-1"></i>First In and Last Out
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="multiplePunches-tab" data-bs-toggle="tab" data-bs-target="#multiplePunches" type="button" role="tab">
                        <i class="bx bx-time-five me-1"></i>Multiple Punches
                    </button>
                </li>
            </ul>

            <div class="tab-content mt-3" id="attendanceTabContent">
                <div class="tab-pane fade show active" id="firstLast" role="tabpanel">
                    <div id="attendanceGridFirst"></div>
                </div>
                <div class="tab-pane fade" id="multiplePunches" role="tabpanel">
                    <div id="attendanceGridMultiple"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- JavaScript -->
<script>
    const apiBase = '@baseUrl';
    const empid = parseInt(localStorage.getItem("EmployeeId"));
    const savedCompany = localStorage.getItem('selectedCompany');
    const companyDetails = JSON.parse(savedCompany || '{}');
    const Compid = parseInt(companyDetails.CompanyId);
    const Token = localStorage.getItem("authToken");

    var firstGrid = null;
    var multipleGrid = null;
    var isLoadingInOut = false;
    var tickTimer = null;

    function fmtTime(v) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        var hours = d.getHours();
        var ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12 || 12;
        var mins = String(d.getMinutes()).padStart(2, '0');
        return String(hours).padStart(2, '0') + ':' + mins + ' ' + ampm;
    }

    function fmtHMS(totalSeconds) {
        totalSeconds = Math.max(0, Math.floor(totalSeconds || 0));
        var h = Math.floor(totalSeconds / 3600);
        var m = Math.floor((totalSeconds % 3600) / 60);
        var s = totalSeconds % 60;
        return h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(s).padStart(2, '0') + 's';
    }

    function fmtDate(v, withTime) {
        if (!v) return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return '-';
        var day = String(d.getDate()).padStart(2, '0');
        var month = String(d.getMonth() + 1).padStart(2, '0');
        return day + '-' + month + '-' + d.getFullYear();
    }

    function fmtNumber(v) {
        return (v !== null && v !== undefined && v !== '') ? parseFloat(v).toFixed(2) : '-';
    }

    function convertUTCtoIST(utcInput) {
        const utcDate = new Date(utcInput);
        const istOffsetMs = 5.5 * 60 * 60 * 1000; // IST is UTC+5:30
        const istDate = new Date(utcDate.getTime() + istOffsetMs);
        return istDate;
    }

    function renderFirstGrid(data) {
        var columns = [
            { field: 'employeeCode', header: 'Employee Code', width: '110px', render: function (v) { return v || '-'; } },
            { field: 'fullName', header: 'Full Name', width: '160px', render: function (v) { return v || '-'; } },
            { field: 'branchName', header: 'Branch', width: '130px', render: function (v) { return v || '-'; } },
            { header: 'Shift Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.shiftDate); } },
            { field: 'inTime', header: 'In Time', width: '90px', render: function (v) { return v || '-'; } },
            { field: 'outTime', header: 'Out Time', width: '90px', render: function (v) { return v || '-'; } },
            { field: 'workingHours', header: 'Working Hours', width: '110px', render: function (v) { return fmtNumber(v); } },
            { field: 'attendanceStatus', header: 'Attendance Status', width: '140px', render: function (v) { return v || '-'; } }
        ];

        if (!firstGrid) {
            firstGrid = WMSGrid.create({
                container: 'attendanceGridFirst',
                title: 'First In and Last Out',
                icon: 'bx-log-in-circle',
                exportName: 'EmpInOutReport_FirstLast',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            firstGrid.setData(data);
        }
    }

    function renderMultipleGrid(data) {
        var columns = [
            { field: 'employeeCode', header: 'Employee Code', width: '110px', render: function (v) { return v || '-'; } },
            { field: 'fullName', header: 'Full Name', width: '160px', render: function (v) { return v || '-'; } },
            { field: 'branchName', header: 'Branch', width: '130px', render: function (v) { return v || '-'; } },
            { field: 'companyName', header: 'Company Name', width: '140px', render: function (v) { return v || '-'; } },
            { header: 'Punch Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.punchDateTime); } },
            { field: 'punchTime', header: 'Punch Time', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'mode', header: 'Mode', width: '90px', render: function (v) { return v || '-'; } }
        ];

        if (!multipleGrid) {
            multipleGrid = WMSGrid.create({
                container: 'attendanceGridMultiple',
                title: 'Multiple Punches',
                icon: 'bx-time-five',
                exportName: 'EmpInOutReport_MultiplePunches',
                data: data,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            multipleGrid.setData(data);
        }
    }

    function renderTodayStatus(status) {
        if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }

        var isClockedIn = !!(status && status.isClockedIn);

        $('#eioStatusBadge').toggleClass('is-in', isClockedIn);
        $('#eioStatusText').text(isClockedIn ? 'Clocked In' : 'Clocked Out');
        $('#eioLastClockIn').text(fmtTime(status && status.lastClockIn));
        $('#eioLastClockOut').text(fmtTime(status && status.lastClockOut));

        $('#btnClockIn').prop('disabled', isClockedIn);
        $('#btnClockOut').prop('disabled', !isClockedIn);

        var baseSeconds = (status && status.workedSeconds) || 0;
        var fetchedAt = Date.now();

        function paintWorkedTime() {
            var elapsed = isClockedIn ? Math.floor((Date.now() - fetchedAt) / 1000) : 0;
            var text = fmtHMS(baseSeconds + elapsed);
            $('#eioWorkedHours').text(text);
            $('#eioTotalToday').text(text);
        }

        paintWorkedTime();
        if (isClockedIn) {
            tickTimer = setInterval(paintWorkedTime, 1000);
        }
    }

    async function loadTodayStatus() {
        try {
            const response = await fetch(`${apiBase}/EmployeeInOut/GetTodayInOutStatus/${empid}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Authorization': `Bearer ${Token}`
                }
            });

            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);

            const data = await response.json();
            renderTodayStatus(data.isSuccess ? data.data : null);
        } catch (error) {
            console.error('Failed to load today\'s in/out status:', error);
            renderTodayStatus(null);
        }
    }

    function submitPunch(btnSelector, label) {
        if (isLoadingInOut) return;
        isLoadingInOut = true;
        setBtnLoading(btnSelector, label);

        try {
            const utcNow = new Date();

            const payload = {
                EmployeeId: empid,
                PunchDateTime: convertUTCtoIST(utcNow),
                CreatedBy: empid.toString(),
                Mode: "Web",
                CompanyId: Compid
            };

            $.ajax({
                url: apiBase + '/EmployeeInOut/CreateEmpINOut',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.isSuccess) {
                        showToast(response.responseMessage, 'success');
                        loadTodayStatus();
                        reloadGrids();
                    } else {
                        showToast(response.responseMessage, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                    showToast('Failed to punch in/out. Please try again.', 'error');
                },
                complete: function () {
                    isLoadingInOut = false;
                    setBtnNormal(btnSelector, label);
                }
            });

        } catch (err) {
            console.error("Unexpected error:", err);
            isLoadingInOut = false;
            setBtnNormal(btnSelector, label);
            showToast('Something went wrong. Please try again.', 'error');
        }
    }

    $(document).ready(async function () {
        $('#eioStatusCard').hide();

        await checkPermissionInOut();
        reloadGrids();

        $('#btnClockIn').click(function () { submitPunch('#btnClockIn', 'Clock In'); });
        $('#btnClockOut').click(function () { submitPunch('#btnClockOut', 'Clock Out'); });

        $('#btnGo').click(function () {
            const month = $('#dropdownmonth').val();
            const year = $('#dropdownyear').val();
            if (!month || !year) { showToast('Please select Month and Year', 'warn'); return; }

            setBtnLoading('#btnGo', 'Go');

            const activeTab = $('#attendanceTabs .nav-link.active');
            const tab = activeTab.attr("data-bs-target");

            function onDone() { setBtnNormal('#btnGo', 'Go'); }

            if (tab === "#firstLast") {
                loadFirstLast(empid, Compid, month, year, onDone);
            } else if (tab === "#multiplePunches") {
                loadMultiple(empid, Compid, month, year, onDone);
            } else {
                onDone();
                showToast('Unknown tab selected', 'error');
            }
        });

        $('button[data-bs-toggle="tab"]').on('shown.bs.tab', async function (e) {
            const target = $(e.target).attr("data-bs-target");
            const month = $('#dropdownmonth').val();
            const year = $('#dropdownyear').val();

            if (!month || !year) return;

            if (target === "#firstLast") {
                await loadFirstLast(empid, Compid, month, year);
            }
            else if (target === "#multiplePunches") {
                await loadMultiple(empid, Compid, month, year);
            }
        });
    });

    function reloadGrids() {
        const month = $('#dropdownmonth').val() || (new Date().getMonth() + 1);
        const year = $('#dropdownyear').val() || new Date().getFullYear();
        loadFirstLast(empid, Compid, month, year);
        loadMultiple(empid, Compid, month, year);
    }

    async function checkPermissionInOut() {
        try {
            const response = await fetch(`${apiBase}/EmployeeMasterAPI/GetEmployeeById/${empid}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Authorization': `Bearer ${Token}`
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();
            if (data.isSuccess) {
                if (data.data.isPermissionPunchInOut == true) {
                    $('#eioStatusCard').show();
                    await loadTodayStatus();
                }
            }

        } catch (error) {
            console.error('Failed to load check permission', error);
        }
    }

    async function loadFirstLast(empid, Compid, month, year, onComplete) {
        try {
            const response = await fetch(`${apiBase}/EmployeeInOut/GetMonthlyAttendanceDetails`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Authorization': `Bearer ${Token}`
                },
                body: JSON.stringify({
                    employeeId: empid,
                    companyId: Compid,
                    monthNumber: month,
                    year: year
                })
            });

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();

            if (data.isSuccess && Array.isArray(data.data)) {
                renderFirstGrid(data.data);
            } else {
                renderFirstGrid([]);
            }
        } catch (error) {
            console.error('Failed to load First In/Out records:', error);
            showToast('Failed to load First In/Out records.', 'error');
            renderFirstGrid([]);
        } finally {
            if (onComplete) onComplete();
        }
    }

    async function loadMultiple(empid, Compid, month, year, onComplete) {
        try {
            const response = await fetch(`${apiBase}/EmployeeInOut/GetMonthlyAttendanceLog`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Authorization': `Bearer ${Token}`
                },
                body: JSON.stringify({
                    employeeId: empid,
                    companyId: Compid,
                    monthNumber: month,
                    year: year
                })
            });

            if (!response.ok) {
                showToast('Something went wrong!', 'error');
                renderMultipleGrid([]);
                return;
            }

            const data = await response.json();

            if (data.isSuccess && Array.isArray(data.data)) {
                renderMultipleGrid(data.data);
            } else {
                renderMultipleGrid([]);
            }

        } catch (error) {
            console.error('Failed to load Multiple Punches records:', error);
            showToast('Failed to load Multiple Punches records.', 'error');
            renderMultipleGrid([]);
        } finally {
            if (onComplete) onComplete();
        }
    }
</script>
