@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Leave Application Report";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>Leave Application Report</title>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Leave Application Report</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate" />
                    <span class="field-validation-error" id="spnfromdate" style="display:none;">Please Select From Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate" />
                    <span class="field-validation-error" id="spntodate" style="display:none;">Please Select To Date</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerLeaveApplication"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        var Compid = (function () {
            var savedCompany = localStorage.getItem('selectedCompany');
            var companyDetails = JSON.parse(savedCompany || '{}');
            return companyDetails.CompanyId;
        })();
        var EmployeeId = localStorage.getItem('EmployeeId');
        var Token = localStorage.getItem("authToken");

        var grid = null;
        var currentRows = [];
        var isLoadingLa = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function statusPill(status) {
            if (status === 'Approved') return '<span class="wg-pill wg-pill-green">Approved</span>';
            if (status === 'Rejected') return '<span class="wg-pill wg-pill-red">Rejected</span>';
            if (status === 'Pending') return '<span class="wg-pill wg-pill-amber">Pending</span>';
            return status || '-';
        }

        /* ── Render WMSGrid ───────────────────────────── */
        function renderGrid(data) {
            var columns = [
                { field: 'employeeName', header: 'Employee Name', width: '180px' },
                { field: 'employeeCode', header: 'Employee Code', width: '130px' },
                { field: 'leaveTypeName', header: 'Leave Type', width: '130px' },
                { field: 'reportingPersonName', header: 'Reporting Person', width: '160px' },
                { header: 'From Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.fromDate); } },
                { header: 'To Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.toDate); } },
                { field: 'noOfDays', header: 'Days', width: '70px' },
                { field: 'reason', header: 'Reason', width: '200px' },
                { header: 'Leave Status', sortable: false, width: '120px', render: function (v, row) { return statusPill(row.leaveStatus); } }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerLeaveApplication',
                    title: 'Leave Application Report',
                    icon: 'bx-calendar-week',
                    exportName: 'LeaveApplicationReport',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
            }
        }

        /* ── GO Button ──────────────────────────────── */
        $('#btnGo').off('click').on('click', function () {
            if (isLoadingLa) return;

            var txtFromDate = $('#fromdate').val();
            var txtToDate = $('#todate').val();
            var isValid = true;

            if (txtFromDate === '') { $('#spnfromdate').show(); isValid = false; } else { $('#spnfromdate').hide(); }
            if (txtToDate === '') { $('#spntodate').show(); isValid = false; } else { $('#spntodate').hide(); }

            if (txtFromDate && txtToDate && new Date(txtFromDate) > new Date(txtToDate)) {
                $('#spntodate').text('To Date must be greater than or equal to From Date').show();
                isValid = false;
            }

            if (!isValid) return;

            isLoadingLa = true;
            setBtnLoading('#btnGo', 'Go');

            var model = {
                EmpId: parseInt(EmployeeId),
                StartDate: txtFromDate,
                EndDate: txtToDate
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/LeaveApplication/GetLeaveApplicationsReport")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (res) {
                    if (res.isSuccess) {
                        currentRows = res.data || [];
                        renderGrid(currentRows);
                        if (currentRows.length === 0) showToast('No Data', 'info');
                    } else {
                        currentRows = [];
                        grid = null;
                        $('#gridContainerLeaveApplication').empty();
                        showToast(res.responseMessage || 'No Data', 'info');
                    }
                },
                error: function (xhr) {
                    console.error('Error:', xhr);
                    currentRows = [];
                    grid = null;
                    $('#gridContainerLeaveApplication').empty();
                    showToast((xhr.responseJSON && xhr.responseJSON.responseMessage) || 'An error occurred. Please try again.', 'error');
                },
                complete: function () {
                    isLoadingLa = false;
                    setBtnNormal('#btnGo', 'Go');
                }
            });
        });

        /* ── Clear Button ───────────────────────────── */
        $('#btnClear').off('click').on('click', function () {
            $('#fromdate').val('');
            $('#todate').val('');
            $('#spnfromdate').hide();
            $('#spntodate').hide();

            currentRows = [];
            grid = null;
            $('#gridContainerLeaveApplication').empty();
        });
    })();
</script>
