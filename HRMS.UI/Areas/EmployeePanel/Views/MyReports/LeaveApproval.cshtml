@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Leave Approval";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>Leave Approval</title>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Leave Approval</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate" />
                    <span class="field-validation-error" id="spnfromdate" style="display:none;">Please Select From Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate" />
                    <span class="field-validation-error" id="spntodate" style="display:none;">Please Select To Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 170px;min-width:160px;">
                    <label for="statusid">Leave Status</label>
                    <select id="statusid">
                        <option value="">SELECT</option>
                        <option value="Approve">APPROVE</option>
                        <option value="Rejected">REJECT</option>
                    </select>
                    <span class="field-validation-error" id="spnstatusid" style="display:none;">Please Select Status</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerLeaveApproval"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        var savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = JSON.parse(savedCompany || '{}');
        var CompanyId = companyDetails.CompanyId;
        var EmployeeId = localStorage.getItem('EmployeeId');
        var Token = localStorage.getItem('authToken');

        var grid = null;
        var currentRows = [];
        var isLoadingLa = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function statusPill(status) {
            if (!status) return '-';
            var s = String(status).toLowerCase();
            if (s.indexOf('approve') !== -1) return '<span class="wg-pill wg-pill-green">' + status + '</span>';
            if (s.indexOf('reject') !== -1) return '<span class="wg-pill wg-pill-red">' + status + '</span>';
            if (s.indexOf('pending') !== -1) return '<span class="wg-pill wg-pill-amber">' + status + '</span>';
            return status;
        }

        /* ── GO Button ──────────────────────────────── */
        $('#btnGo').on('click', function () {
            if (isLoadingLa) return;

            var txtformdate = $('#fromdate').val();
            var txttodate = $('#todate').val();
            var txtStatus = $('#statusid').val();

            var isValid = true;

            if (txtformdate === '') {
                $('#spnfromdate').show();
                isValid = false;
            } else {
                $('#spnfromdate').hide();
            }

            if (txttodate === '') {
                $('#spntodate').show();
                isValid = false;
            } else {
                $('#spntodate').hide();
            }

            if (txtformdate && txttodate && new Date(txtformdate) > new Date(txttodate)) {
                $('#spntodate').text('To Date must be greater than or equal to From Date').show();
                isValid = false;
            }

            if (txtStatus === '' || txtStatus === 'SELECT') {
                $('#spnstatusid').show();
                isValid = false;
            } else {
                $('#spnstatusid').hide();
            }

            if (!isValid) return;

            isLoadingLa = true;
            setBtnLoading('#btnGo', 'Go');

            var model = {
                StartDate: txtformdate,
                EndDate: txttodate,
                Status: txtStatus,
                Empid: EmployeeId,
                CompId: CompanyId
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/LeaveApplication/GetLeaveApproval")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                success: function (res) {
                    if (res.isSuccess && res.data && res.data.length > 0) {
                        currentRows = res.data;
                        renderGrid(currentRows);
                    } else {
                        currentRows = [];
                        renderGrid([]);
                        if (!res.isSuccess) {
                            showToast(res.responseMessage || 'No Data Found', 'info');
                        }
                    }
                },
                error: function (xhr) {
                    console.error('AJAX Error:', xhr);
                    currentRows = [];
                    renderGrid([]);
                    showToast((xhr.responseJSON && xhr.responseJSON.responseMessage) || 'An error occurred. Please try again.', 'error');
                },
                complete: function () {
                    isLoadingLa = false;
                    setBtnNormal('#btnGo', 'Go');
                }
            });
        });

        /* ── Clear Button ───────────────────────────── */
        $('#btnClear').click(function () {
            $('#fromdate').val('');
            $('#todate').val('');
            $('#statusid').val('');
            $('#spnfromdate').hide();
            $('#spntodate').hide();
            $('#spnstatusid').hide();
            currentRows = [];
            grid = null;
            $('#gridContainerLeaveApproval').empty();
        });

        /* ── Render WMSGrid ───────────────────────────── */
        function renderGrid(data) {
            var columns = [
                { field: 'companyName', header: 'Company Name', width: '150px' },
                { field: 'employeeCode', header: 'Code', width: '90px' },
                { field: 'employeeName', header: 'Employee Name', width: '170px' },
                { field: 'leaveTypeName', header: 'Leave Name', width: '130px' },
                { header: 'Application Date', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.createdDate); } },
                { header: 'Approval Date', sortable: false, width: '130px', render: function (v, row) { return fmtDate(row.approvalDate); } },
                { header: 'From Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.fromDate); } },
                { header: 'To Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.toDate); } },
                { field: 'no_Of_Date', header: 'Period', width: '80px' },
                { field: 'reason', header: 'Reason', width: '180px' },
                { header: 'Status', sortable: false, width: '110px', render: function (v, row) { return statusPill(row.leaveStatus); } }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerLeaveApproval',
                    title: 'Leave Approval',
                    icon: 'bx-calendar-check',
                    exportName: 'LeaveApproval',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
            } else {
                grid.setData(data);
            }
        }
    })();
</script>
