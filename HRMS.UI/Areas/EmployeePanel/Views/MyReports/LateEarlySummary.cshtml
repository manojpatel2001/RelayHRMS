@{
    ViewData["Title"] = "Shift Changes Details";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Employee Latemark Detail</h6>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-3">
            <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                <label for="fromid">From Date</label>
                <input type="date" id="fromid" />
            </div>
            <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                <label for="toid">To Date</label>
                <input type="date" id="toid" />
            </div>
            <div class="fg" style="flex:1 1 200px;min-width:180px;">
                <label for="formateid">Format</label>
                <select id="formateid">
                    <option value="1">Default</option>
                    <option value="2">Formate1</option>
                    <option value="3">Formate2</option>
                    <option value="4">Late</option>
                    <option value="5">Early</option>
                    <option value="6">Scenario-2(Percentage)</option>
                    <option value="7">Scenario-3</option>
                    <option value="8">Late-Early</option>
                </select>
            </div>
            <div class="fg" style="flex:1 1 160px;min-width:150px;">
                <label for="tyepid">Report Type</label>
                <select id="tyepid">
                    <option value="1">Select</option>
                    <option value="2">Summary</option>
                </select>
            </div>
            <div class="d-flex gap-2" style="flex-shrink:0;">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-show"></i> View
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
            </div>
        </div>
    </div>
</div>

</div>
