@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>Shift Report Panel</title>

<style>
    /* Status color coding for shift day cells (kept — used inside WMSGrid render()) */
    .shift-status-1 { background-color: #e3f2fd !important; }
    .shift-status-2 { background-color: #f3e5f5 !important; }
    .shift-status-3 { background-color: #e8f5e8 !important; }
    .shift-status-4 { background-color: #fff3e0 !important; }
    .shift-status-5 { background-color: #fce4ec !important; }
    .shift-status-W { background-color: #f5f5f5 !important; color: #666 !important; }
    .shift-status-H { background-color: #ffebee !important; color: #d32f2f !important; }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Shift Report</h6>
            <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">
                <i class="bx bx-arrow-back"></i> Back
            </button>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="fromDate">From Date</label>
                    <input type="date" id="fromDate" />
                    <span class="field-validation-error" id="spnFromDate" style="display:none;">Please Select From Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="toDate">To Date</label>
                    <input type="date" id="toDate" />
                    <span class="field-validation-error" id="spnToDate" style="display:none;">Please Select To Date</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="gridContainerShiftReport"></div>

            <div id="shiftLegendWrap" class="mt-3 p-3 border rounded" style="display:none;">
                <h6>Legend:</h6>
                <div class="d-flex flex-wrap gap-3">
                    <span class="badge" style="background-color: #e3f2fd; color: #000;">1 - Shift 1</span>
                    <span class="badge" style="background-color: #f3e5f5; color: #000;">2 - Shift 2</span>
                    <span class="badge" style="background-color: #e8f5e8; color: #000;">3 - Shift 3</span>
                    <span class="badge" style="background-color: #fff3e0; color: #000;">4 - Shift 4</span>
                    <span class="badge" style="background-color: #fce4ec; color: #000;">5 - Shift 5</span>
                    <span class="badge" style="background-color: #f5f5f5; color: #666;">W - Week Off</span>
                    <span class="badge" style="background-color: #ffebee; color: #d32f2f;">H - Holiday</span>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    (function () {
        const savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = JSON.parse(savedCompany || '{}');
        const Compid = companyDetails.CompanyId;
        const EmployeeId = localStorage.getItem('EmployeeId');
        const Token = localStorage.getItem("authToken");

        var grid = null;
        var isLoadingShift = false;

        $(document).ready(function () {
            setDefaultDates();
        });

        function setDefaultDates() {
            const currentDate = new Date();
            const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            const lastDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);

            $('#fromDate').val(firstDayOfMonth.toISOString().split('T')[0]);
            $('#toDate').val(lastDayOfMonth.toISOString().split('T')[0]);
        }

        function renderShiftTable(data) {
            // Filter out the header row (where EmployeeCode is null)
            var filteredData = (data || []).filter(function (item) { return item.EmployeeCode !== null; });

            // Get dynamic day columns from data
            var dayColumns = [];
            if (filteredData.length > 0 && filteredData[0].Days) {
                var dayKeys = Object.keys(filteredData[0].Days).filter(function (key) { return /^\d{2}$/.test(key); }).sort();
                dayColumns = dayKeys.map(function (day) {
                    return {
                        header: day,
                        sortable: false,
                        width: '40px',
                        render: function (v, row) {
                            var value = (row.Days && row.Days[day]) || '';
                            var className = '';
                            if (value === 'W') { className = 'shift-status-W'; }
                            else if (value === 'H') { className = 'shift-status-H'; }
                            else if (!isNaN(value) && value !== '') { className = 'shift-status-' + value; }
                            return '<span class="' + className + '" style="display:inline-block;width:100%;text-align:center;">' + (value || '') + '</span>';
                        }
                    };
                });
            }

            var columns = [
                { field: 'EmployeeCode', header: 'Emp Code', width: '100px' },
                { field: 'FullName', header: 'Employee Name', width: '200px' }
            ].concat(dayColumns);

            // Day columns can differ month-to-month, so the grid is always rebuilt
            // from scratch rather than reusing setData() (which keeps old columns).
            $('#gridContainerShiftReport').empty();
            grid = WMSGrid.create({
                container: 'gridContainerShiftReport',
                title: 'Shift Report',
                icon: 'bx-calendar',
                exportName: 'ShiftReport',
                data: filteredData,
                columns: columns,
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });

            $('#shiftLegendWrap').toggle(filteredData.length > 0);
        }

        $('#btnGo').off('click').on('click', function () {
            if (isLoadingShift) return;

            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            var isValid = true;

            if (fromDate === "") { $("#spnFromDate").show(); isValid = false; } else { $("#spnFromDate").hide(); }
            if (toDate === "") { $("#spnToDate").show(); isValid = false; } else { $("#spnToDate").hide(); }

            if (fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
                showToast('From Date cannot be greater than To Date.', 'warn');
                return;
            }

            if (!isValid) return;

            isLoadingShift = true;
            setBtnLoading('#btnGo', 'Go');

            let model = {
                StartDate: fromDate,
                EndDate: toDate,
                EmployeeIds: [parseInt(EmployeeId)]
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/EmployeeReportAPI/ShiftReport")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (res) {
                    if (res.isSuccess) {
                        renderShiftTable(res.data);
                    } else {
                        showToast(res.responseMessage || 'No Data', 'info');
                        renderShiftTable([]);
                    }
                },
                error: function (xhr) {
                    console.error("Error:", xhr);
                    showToast(xhr.responseJSON?.responseMessage || 'An error occurred. Please try again.', 'error');
                    renderShiftTable([]);
                },
                complete: function () {
                    isLoadingShift = false;
                    setBtnNormal('#btnGo', 'Go');
                }
            });
        });

        $("#btnClear").off('click').on('click', function () {
            $('#fromDate').val('');
            $('#toDate').val('');

            grid = null;
            $('#gridContainerShiftReport').empty();
            $('#shiftLegendWrap').hide();

            $("#spnFromDate").hide();
            $("#spnToDate").hide();
        });
    })();
</script>
