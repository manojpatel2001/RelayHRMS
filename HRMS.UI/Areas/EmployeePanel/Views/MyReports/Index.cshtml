@{
    ViewData["Title"] = "Shift Changes Details";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Report Dashboard</h6>
    </div>
    <div class="card-body">
        <div class="accordion" id="reportAccordion">

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAttendance">
                        <i class="bx bx-time-five me-2"></i> Attendance Reports
                    </button>
                </h2>
                <div id="collapseAttendance" class="accordion-collapse collapse show" data-bs-parent="#reportAccordion">
                    <div class="accordion-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="@baseUrl/EmployeePanel/MyReports/AttendanceRegister" class="list-group-item list-group-item-action">Attendance Register</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLeave">
                        <i class="bx bx-calendar-check me-2"></i> Leave Reports
                    </button>
                </h2>
                <div id="collapseLeave" class="accordion-collapse collapse" data-bs-parent="#reportAccordion">
                    <div class="accordion-body p-0">
                        <div class="list-group list-group-flush">
                            <a href="@baseUrl/EmployeePanel/MyReports/LeaveApproval" class="list-group-item list-group-item-action">Leave Approval</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/LeaveBalance" class="list-group-item list-group-item-action">Leave Balance</a>
                            <a href="@baseUrl/EmployeePanel/MyReports/leaveapplicationreport" class="list-group-item list-group-item-action">Leave Application Report</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

</div>
