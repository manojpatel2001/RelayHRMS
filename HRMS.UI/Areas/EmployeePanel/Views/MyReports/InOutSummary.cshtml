@{
    ViewData["Title"] = "Shift Changes Details";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = ViewBag.BaseUrl;
}

<div class="wms-form-page">

<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Employee In-Out Summary</h6>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-3">
            <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                <label for="fromid">From Date</label>
                <input type="date" id="fromid" />
            </div>
            <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                <label for="toid">To Date</label>
                <input type="date" id="toid" />
            </div>
            <div class="d-flex gap-2" style="flex-shrink:0;">
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                    <i class="bx bx-show"></i> View
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
            </div>
        </div>
    </div>
</div>

</div>
