@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Yearly Leave";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
}

<style>
    /* Custom Table Styling — kept because the data is a calendar/matrix layout
       (employee x leave-type x row-type x 12 months with rowspan merging),
       which does not map onto a row-per-record WMSGrid. */
    .yearly-leave-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-top: 10px;
    }

        .yearly-leave-table thead {
            background-color: #1e3a5f;
            color: white;
        }

            .yearly-leave-table thead th {
                padding: 10px 8px;
                text-align: center;
                font-weight: bold;
                border: 1px solid #16304d;
            }

        .yearly-leave-table tbody td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: center;
            vertical-align: middle;
        }

            .yearly-leave-table tbody td.text-left {
                text-align: left;
            }

        .yearly-leave-table tbody tr.employee-row {
            border-top: 3px solid #000;
        }

        .yearly-leave-table tbody tr.closing-row {
            background-color: #fff9e6;
        }

            .yearly-leave-table tbody tr.closing-row td {
                font-weight: 600;
            }

        .yearly-leave-table tbody td.merged-cell {
            background-color: #f8f9fa;
            font-weight: 500;
        }

    .table-container {
        overflow-x: auto;
        width: 100%;
        display: none; /* Hidden by default */
    }

        .table-container.show {
            display: block;
        }

    .leave-cell-clickable {
        cursor: pointer;
        color: #1e3a5f;
        text-decoration: underline dotted;
        text-underline-offset: 3px;
    }

        .leave-cell-clickable:hover {
            background-color: #eaf1fb;
        }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Yearly Leave Balance</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate" />
                    <span class="field-validation-error" id="spnfromdate" style="display:none;">Please Select From Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate" />
                    <span class="field-validation-error" id="spntodate" style="display:none;">Please Select To Date</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="grid-loader"
                 class="grid-loader justify-content-center align-items-center flex-column"
                 style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
                    background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(3px); z-index: 9999;">
                <img src="@baseDomainUrl/loders/loder.png"
                     class="grid-logo-spinner"
                     style="width: 40px; height: 40px; animation: spin 1s linear infinite;" />
                <div class="grid-loading-text text-dark" style="font-size: 16px;">Loading...</div>
            </div>

            <div class="table-container">
                <table class="yearly-leave-table" id="yearlyLeaveTable">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Name</th>
                            <th>DOJ</th>
                            <th>Leave</th>
                            <th>Opening</th>
                            <th>Type</th>
                            <th>Jan</th>
                            <th>Feb</th>
                            <th>Mar</th>
                            <th>Apr</th>
                            <th>May</th>
                            <th>Jun</th>
                            <th>Jul</th>
                            <th>Aug</th>
                            <th>Sep</th>
                            <th>Oct</th>
                            <th>Nov</th>
                            <th>Dec</th>
                            <th>Closing</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Data will be inserted here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="leaveTxnDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="leaveTxnDetailModalTitle">Transaction Details</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="leaveTxnDetailBody"></div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        initializePage();
    });

    const savedCompany = localStorage.getItem('selectedCompany');
    var companyDetails = JSON.parse(savedCompany);
    const Compid = companyDetails.CompanyId;
    const EmployeeId = localStorage.getItem('EmployeeId');
    const Token = localStorage.getItem("authToken");

    var isLoadingYearlyLeave = false;

    function showLoder() {
        $('#grid-loader').addClass('d-flex').show();
    }

    function hideLoder() {
        $('#grid-loader').removeClass('d-flex').hide();
    }

    function setDefaultDates() {
        const currentYear = new Date().getFullYear();
        const startDate = `${currentYear}-01-01`;
        const endDate = `${currentYear}-12-31`;
        $("#fromdate").val(startDate);
        $("#todate").val(endDate);
    }

    function formatDate(dateStr) {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        const day = String(date.getDate()).padStart(2, '0');
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const month = months[date.getMonth()];
        const year = String(date.getFullYear()).substr(-2);
        return `${day}-${month}-${year}`;
    }

    function formatValue(val) {
        return (val !== null && val !== undefined) ? val : '-';
    }

    var reportYear = new Date().getFullYear();
    const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function escapeHtmlAttr(str) {
        return String(str == null ? '' : str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function monthCell(row, monthNo, monthKey) {
        const val = row[monthKey];
        const isDrillable = (row.rowType === 'Credit' || row.rowType === 'Debit') && val !== null && val !== undefined;
        if (isDrillable) {
            return `<td class="leave-cell-clickable" data-leavetype="${escapeHtmlAttr(row.leaveType)}" data-rowtype="${escapeHtmlAttr(row.rowType)}" data-month="${monthNo}" title="Click to view transaction details">${formatValue(val)}</td>`;
        }
        return `<td>${formatValue(val)}</td>`;
    }

    function buildTable(apiData) {
        if (!apiData || !Array.isArray(apiData) || apiData.length === 0) {
            $('#tableBody').html('<tr><td colspan="19" style="text-align:center; padding:20px;">No data available</td></tr>');
            $('.table-container').addClass('show'); // Show table even for no data
            return;
        }

        // Group data by employee
        const employeeGroups = new Map();

        apiData.forEach(item => {
            const empKey = `${item.name.trim()}_${item.location || 'NA'}`;

            if (!employeeGroups.has(empKey)) {
                employeeGroups.set(empKey, {
                    location: item.location,
                    name: item.name,
                    doj: item.doj,
                    leaveTypes: new Map()
                });
            }

            const emp = employeeGroups.get(empKey);
            const leaveType = item.leaveType;

            if (!emp.leaveTypes.has(leaveType)) {
                emp.leaveTypes.set(leaveType, []);
            }

            emp.leaveTypes.get(leaveType).push(item);
        });

        // Build HTML
        let html = '';
        const rowTypeOrder = ['Credit', 'Debit', 'Laps', 'Closing'];

        employeeGroups.forEach((empData) => {
            // Calculate total rows for this employee
            let totalRows = 0;
            empData.leaveTypes.forEach((leaveRows) => {
                totalRows += leaveRows.length;
            });

            let isFirstEmployeeRow = true;

            empData.leaveTypes.forEach((leaveRows, leaveType) => {
                // Get opening value
                let openingValue = null;
                for (let row of leaveRows) {
                    if (row.opening !== null && row.opening !== undefined) {
                        openingValue = row.opening;
                        break;
                    }
                }

                // Sort rows
                const sortedRows = leaveRows.sort((a, b) => {
                    return rowTypeOrder.indexOf(a.rowType) - rowTypeOrder.indexOf(b.rowType);
                });

                const leaveRowCount = sortedRows.length;
                let isFirstLeaveRow = true;

                sortedRows.forEach((row, idx) => {
                    const rowClass = row.rowType === 'Closing' ? 'closing-row' : '';
                    const empRowClass = isFirstEmployeeRow ? 'employee-row' : '';

                    html += `<tr class="${empRowClass} ${rowClass}">`;

                    // Location (rowspan for entire employee)
                    if (isFirstEmployeeRow) {
                        html += `<td rowspan="${totalRows}" class="text-left merged-cell">${empData.location || '-'}</td>`;
                    }

                    // Name (rowspan for entire employee)
                    if (isFirstEmployeeRow) {
                        html += `<td rowspan="${totalRows}" class="text-left merged-cell">${empData.name || '-'}</td>`;
                    }

                    // DOJ (rowspan for entire employee)
                    if (isFirstEmployeeRow) {
                        html += `<td rowspan="${totalRows}" class="merged-cell">${formatDate(empData.doj)}</td>`;
                    }

                    // Leave Type (rowspan for leave type group)
                    if (isFirstLeaveRow) {
                        html += `<td rowspan="${leaveRowCount}" style="font-weight:600;">${leaveType}</td>`;
                    }

                    // Opening (rowspan for leave type group)
                    if (isFirstLeaveRow) {
                        html += `<td rowspan="${leaveRowCount}" style="font-weight:500;">${formatValue(openingValue)}</td>`;
                    }

                    // Type column
                    html += `<td>${row.rowType}</td>`;

                    // Month columns — Credit/Debit cells are clickable to drill into
                    // the individual LeaveTransactions rows behind that monthly total.
                    html += monthCell(row, 1, 'jan');
                    html += monthCell(row, 2, 'feb');
                    html += monthCell(row, 3, 'mar');
                    html += monthCell(row, 4, 'apr');
                    html += monthCell(row, 5, 'may');
                    html += monthCell(row, 6, 'jun');
                    html += monthCell(row, 7, 'jul');
                    html += monthCell(row, 8, 'aug');
                    html += monthCell(row, 9, 'sep');
                    html += monthCell(row, 10, 'oct');
                    html += monthCell(row, 11, 'nov');
                    html += monthCell(row, 12, 'dec');

                    // Closing
                    html += `<td>${formatValue(row.closing)}</td>`;

                    html += '</tr>';

                    isFirstEmployeeRow = false;
                    isFirstLeaveRow = false;
                });
            });
        });

        $('#tableBody').html(html);
        $('.table-container').addClass('show'); // Show table after data is loaded
    }

    function initializePage() {
        setDefaultDates();

        $('#btnGo').off('click').on('click', function () {
            if (isLoadingYearlyLeave) return;

            var txtformdate = $("#fromdate").val();
            var txttodate = $("#todate").val();
            var isValid = true;

            if (txtformdate === "") {
                $("#spnfromdate").show();
                isValid = false;
            } else {
                $("#spnfromdate").hide();
            }

            if (txttodate === "") {
                $("#spntodate").show();
                isValid = false;
            } else {
                $("#spntodate").hide();
            }

            if (txtformdate && txttodate && new Date(txtformdate) > new Date(txttodate)) {
                $("#spntodate").text("To Date must be greater than or equal to From Date").show();
                isValid = false;
            }

            if (!isValid) {
                return;
            }

            isLoadingYearlyLeave = true;
            setBtnLoading('#btnGo', 'Go');
            showLoder();

            let model = {
                EmpId: parseInt(EmployeeId),
                StartDate: txtformdate,
                EndDate: txttodate
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/LeaveApplication/GetYearlyLeaveReport")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (res) {

                    if (res.isSuccess) {
                        reportYear = new Date(txtformdate).getFullYear();
                        buildTable(res.data);
                    } else {
                        showToast(res.responseMessage || 'No Data', 'info');
                    }
                },
                error: function (xhr) {
                    console.error("Error:", xhr);
                    showToast(xhr.responseJSON?.responseMessage || 'An error occurred. Please try again.', 'error');
                },
                complete: function () {
                    isLoadingYearlyLeave = false;
                    setBtnNormal('#btnGo', 'Go');
                    hideLoder();
                }
            });
        });

        $("#btnClear").off('click').on('click', function () {
            $('#fromdate').val('');
            $('#todate').val('');
            $('#tableBody').html('');
            $('.table-container').removeClass('show'); // Hide table on clear
            $("#spnfromdate").hide();
            $("#spntodate").hide();
        });

        $(document).on('click', '.leave-cell-clickable', function () {
            const leaveType = $(this).data('leavetype');
            const rowType = $(this).data('rowtype');
            const monthNo = parseInt($(this).data('month'));

            $('#leaveTxnDetailModalTitle').text(rowType + ' Details — ' + leaveType + ' — ' + monthNames[monthNo - 1] + ' ' + reportYear);
            $('#leaveTxnDetailBody').html('<div class="text-center text-muted py-3">Loading...</div>');
            const modal = new bootstrap.Modal(document.getElementById('leaveTxnDetailModal'));
            modal.show();

            $.ajax({
                url: '@(baseDomainUrl + "/api/LeaveApplication/GetLeaveTransactionDetail")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    EmpId: parseInt(EmployeeId),
                    LeaveType: leaveType,
                    TransactionType: rowType,
                    Year: reportYear,
                    Month: monthNo
                }),
                headers: { 'Authorization': 'Bearer ' + Token },
                success: function (res) {
                    if (res.isSuccess && res.data && res.data.length) {
                        renderTxnDetailTable(res.data, rowType);
                    } else {
                        $('#leaveTxnDetailBody').html('<div class="text-center text-muted py-3">No transaction details found.</div>');
                    }
                },
                error: function () {
                    $('#leaveTxnDetailBody').html('<div class="text-center text-danger py-3">Unable to load transaction details.</div>');
                }
            });
        });
    }

    function renderTxnDetailTable(rows, rowType) {
        const isDebit = rowType === 'Debit';
        let html = '<div class="table-responsive"><table class="table table-sm table-bordered mb-0"><thead><tr>';
        if (isDebit) html += '<th>Application ID</th>';
        html += '<th>Date</th><th>Days</th>';
        if (isDebit) html += '<th>From</th><th>To</th><th>Status</th>';
        html += '<th>Reason</th></tr></thead><tbody>';
        rows.forEach(function (r) {
            html += '<tr>';
            if (isDebit) html += `<td>${r.leaveApplicationId || '-'}</td>`;
            html += `<td>${formatDate(r.transactionDate)}</td>`;
            html += `<td>${formatValue(r.days)}</td>`;
            if (isDebit) {
                html += `<td>${formatDate(r.fromDate)}</td>`;
                html += `<td>${formatDate(r.toDate)}</td>`;
                html += `<td>${r.leaveStatus || '-'}</td>`;
            }
            html += `<td>${r.applicationReason || r.transactionReason || '-'}</td>`;
            html += '</tr>';
        });
        html += '</tbody></table></div>';
        $('#leaveTxnDetailBody').html(html);
    }
</script>
