@inject IConfiguration Configuration
@{
    ViewData["Title"] = "CompOff Available Balance Report";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>CompOff Available Balance Report</title>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">CompOff Available Balance Report</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                    <label for="fromdate">From Date</label>
                    <input type="date" id="fromdate" />
                    <span class="field-validation-error" id="spnfromdate" style="display:none;">Please Select From Date</span>
                </div>

                <div class="fg fg-req" style="flex:1 1 150px;min-width:140px;">
                    <label for="todate">To Date</label>
                    <input type="date" id="todate" />
                    <span class="field-validation-error" id="spntodate" style="display:none;">Please Select To Date</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
                </div>
            </div>

            <div class="divider"></div>

            <div id="leaveBalanceGrid"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        var savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = JSON.parse(savedCompany || '{}');
        var Compid = companyDetails.CompanyId;
        var EmployeeId = localStorage.getItem('EmployeeId');
        var Token = localStorage.getItem("authToken");

        var grid = null;
        var currentRows = [];
        var isLoadingCb = false;

        function fmtDate(v) {
            if (!v) return '-';
            var d = new Date(v);
            if (isNaN(d.getTime())) return '-';
            var day = String(d.getDate()).padStart(2, '0');
            var month = String(d.getMonth() + 1).padStart(2, '0');
            return day + '/' + month + '/' + d.getFullYear();
        }

        function renderGrid(data) {
            var columns = [
                { field: 'companyName', header: 'Company Name', width: '160px' },
                { field: 'companyAddress', header: 'Company Address', width: '200px' },
                { header: 'As On Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.asOnDate); } },
                { field: 'employeeCode', header: 'Employee Code', width: '120px' },
                { field: 'employeeName', header: 'Employee Name', width: '160px' },
                { field: 'availBalance', header: 'Avail Balance', width: '110px' },
                { field: 'used', header: 'Used', width: '80px' },
                { field: 'totalBalance', header: 'Total Balance', width: '110px' },
                { field: 'availDays', header: 'Avail Days', width: '90px' },
                { field: 'limit', header: 'Limit', width: '80px' },
                { field: 'compOffType', header: 'Comp-Off Type', width: '130px' },
                { field: 'remainingDays', header: 'Remaining Days', width: '120px' },
                { header: 'For Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.forDate); } }
            ];

            currentRows = data;

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'leaveBalanceGrid',
                    title: 'CompOff Available Balance',
                    icon: 'bx-calendar-check',
                    exportName: 'CompOffAvailableBalance_Report',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
                PermGuard.onReady(function () {
                    if (!PermGuard.has('export-ess-myreports-compoffavailbalance')) grid.setFeature('export', false);
                });
            } else {
                grid.setData(data);
            }
        }

        $('#btnGo').on('click', function () {
            if (isLoadingCb) return;

            var txtformdate = $("#fromdate").val();
            var txttodate = $("#todate").val();
            var isValid = true;

            if (txtformdate === "") {
                $("#spnfromdate").show();
                isValid = false;
            } else {
                $("#spnfromdate").hide();
            }

            if (txttodate === "") {
                $("#spntodate").text("Please Select To Date").show();
                isValid = false;
            } else {
                $("#spntodate").hide();
            }

            if (txtformdate && txttodate && new Date(txtformdate) > new Date(txttodate)) {
                $("#spntodate").text("To Date must be greater than or equal to From Date").show();
                isValid = false;
            }

            if (!isValid) return;

            isLoadingCb = true;
            setBtnLoading('#btnGo', 'Go');

            var model = {
                StartDate: txtformdate,
                EndDate: txttodate,
                Empid: EmployeeId,
                CompId: Compid,
                AsOnDate: new Date().toISOString().split('T')[0] // Pass current date as AsOnDate
            };

            $.ajax({
                url: '@(baseDomainUrl + "/api/CompOffAPI/GetCompOffAvailableBalanceReport")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                success: function (res) {
                    isLoadingCb = false;
                    setBtnNormal('#btnGo', 'Go');

                    if (res.isSuccess && res.data && res.data.length > 0) {
                        renderGrid(res.data);
                    } else {
                        currentRows = [];
                        grid = null;
                        $('#leaveBalanceGrid').empty();
                        showToast(res.responseMessage || 'No Data', 'info');
                    }
                },
                error: function (xhr) {
                    isLoadingCb = false;
                    setBtnNormal('#btnGo', 'Go');
                    showToast(xhr.responseJSON?.responseMessage || 'An error occurred. Please try again.', 'error');
                }
            });
        });

        $("#btnClear").click(function () {
            $('#fromdate').val('');
            $('#todate').val('');

            currentRows = [];
            grid = null;
            $('#leaveBalanceGrid').empty();

            $("#spnfromdate").hide();
            $("#spntodate").hide();
        });
    })();
</script>
