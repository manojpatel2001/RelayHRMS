@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
    var uri = new Uri(baseUrl);
    string baseDomainUrl = $"{uri.Scheme}://{uri.Host}:{uri.Port}";
    string UIBaseUrl = Configuration["UIBaseUrlSettings:baseUrl"];
}
<title>Yearly Salary Report</title>

<style>
    /* Employee Details Section Styles */
    .employee-details-wrapper {
        margin-bottom: 15px;
    }

    .employee-details-container {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 10px 15px;
    }

    .employee-info-row {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .employee-info-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .employee-info-label {
        font-size: 13px;
        font-weight: 600;
        color: #495057;
    }

    .employee-info-value {
        font-size: 13px;
        font-weight: 500;
        color: #212529;
    }
</style>

<div class="wms-form-page">

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Yearly Salary Report</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 160px;min-width:150px;">
                    <label for="year">Year</label>
                    <select id="year">
                        <option value="">Select Year</option>
                    </select>
                    <span id="spnyear" class="field-validation-error" style="display:none;">Please Select Year</span>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnClear">Clear</button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="window.location.href='@Url.Action("Index", "MyReports")'">Back</button>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Employee Details Section -->
            <div class="employee-details-wrapper" id="employeeDetailsSection" style="display: none;">
                <div class="employee-details-container">
                    <div id="employeeDetailsContent">
                        <!-- Employee details will be populated here -->
                    </div>
                </div>
            </div>

            <div id="gridContainerYearlySalary"></div>
        </div>
    </div>

</div>

<script>
    (function () {
        const savedCompany = localStorage.getItem('selectedCompany');
        var companyDetails = savedCompany ? JSON.parse(savedCompany) : null;
        const Compid = companyDetails ? companyDetails.CompanyId : null;
        const EmployeeId = localStorage.getItem('EmployeeId');
        const Token = localStorage.getItem("authToken");

        var grid = null;
        var isLoadingYearlySalary = false;

        $(document).ready(function () {
            loadYears();
            setCurrentYear();
        });

        function loadYears() {
            const currentYear = new Date().getFullYear();
            const yearSelect = $('#year');

            yearSelect.empty();
            yearSelect.append(`<option value="">Select Year</option>`);
            yearSelect.append(`<option value="${currentYear}">${currentYear}</option>`);

            const pastYear = currentYear - 1;
            yearSelect.append(`<option value="${pastYear}">${pastYear}</option>`);
        }

        function setCurrentYear() {
            const currentYear = new Date().getFullYear();
            $('#year').val(currentYear);
        }

        // Function to load employee details when Go button is clicked
        function loadEmployeeDetailsOnGo() {
            if (!EmployeeId) {
                console.log("No EmployeeId found");
                return;
            }

            $.ajax({
                url: '@(baseDomainUrl + "/api/EmployeeDashboardAPI/GetEmployeeDetails")',
                type: 'GET',
                data: {
                    EmployeeId: EmployeeId
                },
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (res) {
                    if (res.isSuccess && res.data && res.data.length > 0) {
                        // Since data is an array, take the first element
                        displayEmployeeDetails(res.data[0]);
                    } else {
                        console.log("Unable to load employee details");
                    }
                },
                error: function (xhr) {
                    console.error("Employee Details AJAX Error:", xhr);
                }
            });
        }

        // Function to display employee details
        function displayEmployeeDetails(data) {
            const employeeDetailsHtml = `
                <div class="employee-info-row">
                    <div class="employee-info-item">
                        <span class="employee-info-label">Name:</span>
                        <span class="employee-info-value">${data.fullName || 'N/A'}</span>
                    </div>
                    <div class="employee-info-item">
                        <span class="employee-info-label">Emp Code:</span>
                        <span class="employee-info-value">${data.employeeCode || 'N/A'}</span>
                    </div>
                    <div class="employee-info-item">
                        <span class="employee-info-label">Branch:</span>
                        <span class="employee-info-value">${data.branchName || 'N/A'}</span>
                    </div>
                    <div class="employee-info-item">
                        <span class="employee-info-label">Company:</span>
                        <span class="employee-info-value">${data.companyName || 'N/A'}</span>
                    </div>
                </div>
            `;

            $('#employeeDetailsContent').html(employeeDetailsHtml);
            $('#employeeDetailsSection').show();
        }

        function moneyCell(v) {
            var n = (v === null || v === undefined || v === '') ? 0 : parseFloat(v);
            if (isNaN(n)) return '<span class="d-block text-end">0.00</span>';
            return '<span class="d-block text-end">' + n.toFixed(2) + '</span>';
        }

        function renderGrid(data) {
            var columns = [
                {
                    field: 'salaryHead', header: 'Salary Head', width: '160px',
                    render: function (v) { return '<span style="font-weight:700;background-color:#f8f9fa;display:block;padding:2px 4px;">' + (v || '-') + '</span>'; }
                },
                { header: 'Jan', width: '90px', render: function (v, row) { return moneyCell(row.jan); } },
                { header: 'Feb', width: '90px', render: function (v, row) { return moneyCell(row.feb); } },
                { header: 'Mar', width: '90px', render: function (v, row) { return moneyCell(row.mar); } },
                { header: 'Apr', width: '90px', render: function (v, row) { return moneyCell(row.apr); } },
                { header: 'May', width: '90px', render: function (v, row) { return moneyCell(row.may); } },
                { header: 'Jun', width: '90px', render: function (v, row) { return moneyCell(row.jun); } },
                { header: 'Jul', width: '90px', render: function (v, row) { return moneyCell(row.jul); } },
                { header: 'Aug', width: '90px', render: function (v, row) { return moneyCell(row.aug); } },
                { header: 'Sep', width: '90px', render: function (v, row) { return moneyCell(row.sep); } },
                { header: 'Oct', width: '90px', render: function (v, row) { return moneyCell(row.oct); } },
                { header: 'Nov', width: '90px', render: function (v, row) { return moneyCell(row.nov); } },
                { header: 'Dec', width: '90px', render: function (v, row) { return moneyCell(row.dec); } },
                {
                    header: 'Total', width: '100px',
                    render: function (v, row) {
                        var n = (row.total === null || row.total === undefined || row.total === '') ? 0 : parseFloat(row.total);
                        if (isNaN(n)) n = 0;
                        return '<span style="font-weight:700;background-color:#e3f2fd;display:block;padding:2px 4px;text-align:right;">' + n.toFixed(2) + '</span>';
                    }
                }
            ];

            if (!grid) {
                grid = WMSGrid.create({
                    container: 'gridContainerYearlySalary',
                    title: 'Yearly Salary Report',
                    icon: 'bx-calendar-week',
                    exportName: 'YearlySalaryReport',
                    data: data,
                    columns: columns,
                    perPage: 100000,
                    features: { pagination: false, perPage: false, paginationInfo: false }
                });
                PermGuard.onReady(function () {
                    if (!PermGuard.has('export-ess-myreports-yearlysalarysummary')) grid.setFeature('export', false);
                });
            } else {
                grid.setData(data);
            }
        }

        $('#btnGo').off('click').on('click', function () {
            if (isLoadingYearlySalary) return;

            var selectedYear = $("#year").val();
            var isValid = true;

            if (selectedYear === "" || selectedYear === null) {
                $("#spnyear").show();
                isValid = false;
            } else {
                $("#spnyear").hide();
            }

            if (!isValid) {
                return;
            }

            isLoadingYearlySalary = true;
            setBtnLoading('#btnGo', 'Go');

            $.ajax({
                url: '@(baseDomainUrl + "/api/MonthlySalaryDetailsAPI/GetYearlySalaryReport")',
                type: 'GET',
                data: {
                    year: parseInt(selectedYear),
                    EmployeeId: EmployeeId
                },
                contentType: 'application/json',
                headers: {
                    'Authorization': 'Bearer ' + Token
                },
                success: function (res) {
                    console.log("res", res);
                    if (res.isSuccess) {
                        // Load employee details first, then show grid
                        loadEmployeeDetailsOnGo();
                        renderGrid(res.data);
                    } else {
                        showToast(res.responseMessage || 'No Data Found', 'info');
                        grid = null;
                        $("#gridContainerYearlySalary").empty();
                        $('#employeeDetailsSection').hide();
                    }
                },
                error: function (xhr) {
                    console.error("AJAX Error:", xhr);
                    showToast(xhr.responseJSON?.responseMessage || 'An error occurred. Please try again.', 'error');
                    grid = null;
                    $("#gridContainerYearlySalary").empty();
                    $('#employeeDetailsSection').hide();
                },
                complete: function () {
                    isLoadingYearlySalary = false;
                    setBtnNormal('#btnGo', 'Go');
                }
            });
        });

        $("#btnClear").off('click').on('click', function () {
            $('#year').val('');

            grid = null;
            $("#gridContainerYearlySalary").empty();

            $("#spnyear").hide();

            $('#employeeDetailsSection').hide();
        });
    })();
</script>
