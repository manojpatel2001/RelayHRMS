@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Employee Panel";
    Layout = "~/Areas/EmployeePanel/Views/Shared/_EmployeeLayout.cshtml";
    string baseUrl = Configuration["BaseUrlSettings:baseUrl"];
}

<div class="wms-form-page">

    <div class="card">
        <div class="card-header">
            <h6 class="mb-0">Employee In Out</h6>
        </div>
        <div class="card-body">
            <div class="sec-lbl" style="margin-top:0">Search Panel</div>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="fg fg-req" style="flex:1 1 170px;min-width:160px;">
                    <label for="dropdownmonth">Month</label>
                    <select id="dropdownmonth">
                        <option value="">Select Month</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            var selected = (i == DateTime.Now.Month) ? "selected" : "";
                            <option value="@i" @selected>
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                            </option>
                        }
                    </select>
                </div>

                <div class="fg fg-req" style="flex:1 1 130px;min-width:120px;">
                    <label for="dropdownyear">Year</label>
                    <select id="dropdownyear">
                        @for (int y = 2024; y <= 2026; y++)
                        {
                            var selected = (y == DateTime.Now.Year) ? "selected" : "";
                            <option value="@y" @selected>@y</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2" style="flex-shrink:0;">
                    <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" id="btnGo">
                        <i class="bx bx-search"></i>
                        <span class="btn-spinner-icon"></span>
                        <span class="btn-label-text">Go</span>
                    </button>
                </div>
            </div>

            <div class="divider"></div>

            <ul class="nav nav-tabs" id="attendanceTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#firstLast" role="tab">First In and Last Out</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#multiplePunches" role="tab">Multiple Punches</a>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="firstLast" role="tabpanel">
                    <div id="gridContainerFirstLast"></div>
                </div>
                <div class="tab-pane fade" id="multiplePunches" role="tabpanel">
                    <div id="gridContainerMultiple"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    const baseUrl = '@baseUrl';
    const empid = 1;

    var firstLastGrid = null;
    var multipleGrid = null;
    var isLoadingInOut = false;

    function fmtDate(dateStr) {
        if (!dateStr) return '-';
        var date = new Date(dateStr);
        return isNaN(date) ? '-' : date.toLocaleDateString('en-GB'); // dd/MM/yyyy
    }

    function renderInOutColumns() {
        return [
            { field: 'branchName', header: 'Branch Name', width: '150px', render: function (v) { return v || '-'; } },
            { field: 'employeeCode', header: 'Employee Code', width: '130px', render: function (v) { return v || '-'; } },
            { field: 'fullName', header: 'Employee Name', width: '180px', render: function (v) { return v || '-'; } },
            { header: 'Date', sortable: false, width: '110px', render: function (v, row) { return fmtDate(row.for_Date); } },
            { field: 'day_Name', header: 'Day', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'in_Time', header: 'In Time', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'out_Time', header: 'Out Time', width: '100px', render: function (v) { return v || '-'; } },
            { field: 'duration', header: 'Duration', width: '100px', render: function (v) { return v || '-'; } }
        ];
    }

    function renderFirstLastGrid(data) {
        if (!firstLastGrid) {
            firstLastGrid = WMSGrid.create({
                container: 'gridContainerFirstLast',
                title: 'First In and Last Out',
                icon: 'bx-log-in-circle',
                exportName: 'FirstInLastOutReport',
                data: data,
                columns: renderInOutColumns(),
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            firstLastGrid.setData(data);
        }
    }

    function renderMultipleGrid(data) {
        if (!multipleGrid) {
            multipleGrid = WMSGrid.create({
                container: 'gridContainerMultiple',
                title: 'Multiple Punches',
                icon: 'bx-time-five',
                exportName: 'MultiplePunchesReport',
                data: data,
                columns: renderInOutColumns(),
                perPage: 100000,
                features: { pagination: false, perPage: false, paginationInfo: false }
            });
        } else {
            multipleGrid.setData(data);
        }
    }

    function loadFirstLast(empid, month, year, onComplete) {
        $.ajax({
            url: baseUrl + "/EmployeeInOut/AttendanceFirstInOutReport",
            type: "POST",
            data: { empid, month, year },
            success: function (response) {
                renderFirstLastGrid(response.data || []);
            },
            error: function () {
                showToast('Failed to load First In/Out records.', 'error');
                renderFirstLastGrid([]);
            },
            complete: function () {
                if (onComplete) onComplete();
            }
        });
    }

    function loadMultiple(empid, month, year, onComplete) {
        $.ajax({
            url: baseUrl + "/EmployeeInOut/AttendanceInOutReport",
            type: "POST",
            data: { empid, month, year },
            success: function (response) {
                renderMultipleGrid(response.data || []);
            },
            error: function () {
                showToast('Failed to load Multiple In/Out records.', 'error');
                renderMultipleGrid([]);
            },
            complete: function () {
                if (onComplete) onComplete();
            }
        });
    }

    $(document).ready(function () {
        $('#btnGo').click(function () {
            if (isLoadingInOut) return;

            const month = $('#dropdownmonth').val();
            const year = $('#dropdownyear').val();

            if (!month || !year) {
                showToast('Please select both Month and Year.', 'warn');
                return;
            }

            isLoadingInOut = true;
            setBtnLoading('#btnGo', 'Go');

            function onDone() {
                isLoadingInOut = false;
                setBtnNormal('#btnGo', 'Go');
            }

            const activeTab = $(".nav-link.active").attr("href");
            if (activeTab === "#firstLast") {
                loadFirstLast(empid, month, year, onDone);
            } else {
                loadMultiple(empid, month, year, onDone);
            }
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            const target = $(e.target).attr("href");
            const month = $('#dropdownmonth').val();
            const year = $('#dropdownyear').val();

            if (!month || !year) return;

            if (target === "#firstLast") {
                loadFirstLast(empid, month, year);
            } else {
                loadMultiple(empid, month, year);
            }
        });
    });
</script>
